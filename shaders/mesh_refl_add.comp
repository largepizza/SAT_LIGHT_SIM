#version 450
layout(local_size_x = 16, local_size_y = 16) in;
// ── mesh_refl_add.comp — sharp mesh reflections into the mesh radiance (2026-09-25) ──────────────
// sat_sky.frag's SKY_REFL pass rendered the sky along the reflected rays of the mirror-smooth mesh
// pixels (already × their Fresnel, tint and fade) into its own target; this adds that into the scene
// mesh radiance every later pass reads (sat_sky.frag's composite, mesh_bloom.frag). The alpha keeps
// its slot and rescales the photometric share of the pixel's light (sat_mesh.frag), since a
// reflection is not in the photometric model the bloom is normalised by. Over the union of the
// instances' rectangles only.

layout(set = 0, binding = 0, rgba32f) uniform image2D meshColorImg;          // rgb radiance, a = slot + 1 + share
layout(set = 0, binding = 1, rgba16f) uniform readonly image2D reflRadianceImg;
layout(push_constant) uniform PC {
    ivec2 origin;
    ivec2 size;
} pc;

void main()
{
    if (any(greaterThanEqual(gl_GlobalInvocationID.xy, uvec2(pc.size)))) return;
    ivec2 p = pc.origin + ivec2(gl_GlobalInvocationID.xy);
    vec3 r = imageLoad(reflRadianceImg, p).rgb;
    if (r.r + r.g + r.b <= 0.0) return;
    vec4 m = imageLoad(meshColorImg, p);
    if (m.a < 0.5) return;
    const vec3 kLum = vec3(0.2126, 0.7152, 0.0722);
    float l0 = dot(m.rgb, kLum), l1 = dot(m.rgb + r, kLum);
    float share = clamp(fract(m.a) * l0 / max(l1, 1e-12), 0.0, 0.999);
    imageStore(meshColorImg, p, vec4(m.rgb + r, floor(m.a) + share));
}
