#version 450

// ── Clouds v2: temporal resolve (.plans/CLOUDS_V2_PLAN.md, phase 2) ──────────────────────────────
// Half resolution. cloud_v2_march.comp marched one pixel of each 2x2 block this frame; this pass
// produces every pixel:
//   this frame's pixel   the new sample blended over the reprojected, clamped history
//   the other three      the reprojected history, clamped to the 3x3 neighbourhood of new samples
//   no valid history     a bilinear upsample of the new samples (first frame, after a jump, off-screen)
//
// Reprojection is exact geometry, not motion vectors: the camera is a rotation about a known eye.
// A pixel's point is its ray at the block's mean cloud distance (a sky pixel is a direction at
// infinity), moved into the previous frame's frame by the eye's displacement (ECEF metres, formed
// in double on the CPU) and projected with the previous rotation and field of view. Clouds are
// translucent, so one distance per pixel is an approximation; the neighbourhood clamp absorbs it.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {        // == CloudMarchPC
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#include "common.glsl"
#define CV2_PARAMS_ONLY
#define CV2_PARAMS_BINDING 0
#include "clouds_v2.glsl"

layout(set = 0, binding = 1) uniform sampler2D newColorTex;    // quarter grid, linear/clamp
layout(set = 0, binding = 2) uniform sampler2D newDepthTex;    // quarter grid (texelFetch)
layout(set = 0, binding = 3) uniform sampler2D histColorTex;   // half grid, last frame's result
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outColor;
layout(set = 0, binding = 5, rg32f)   uniform writeonly image2D outDepth;

void enuOf(vec3 up, out mat3 m)
{
    vec3 z = normalize(up);
    vec3 x = normalize(cross(vec3(0.0, 0.0, 1.0), z));
    m = mat3(x, cross(z, x), z);
}

void main()
{
    ivec2 halfSize = imageSize(outColor);
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= halfSize.x || c.y >= halfSize.y) return;

    // The new samples: a quarter grid in the targets' top-left (sparse), or every pixel (full rate).
    bool  full = cv2.misc.z > 0.5;
    ivec2 qs   = full ? halfSize : (halfSize + 1) / 2;
    ivec2 off  = full ? ivec2(0) : ivec2(cv2.frame.zw);
    ivec2 b    = full ? c : min(c >> 1, qs - 1);
    bool  isNew = full || all(equal(c & 1, off));

    vec4 nc = texelFetch(newColorTex, b, 0);
    vec2 nd = texelFetch(newDepthTex, b, 0).xy;

    vec4 mn = nc, mx = nc;
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx) {
        vec4 s = texelFetch(newColorTex, clamp(b + ivec2(dx, dy), ivec2(0), qs - 1), 0);
        mn = min(mn, s); mx = max(mx, s);
    }

    // Where this pixel sits among the new samples (sample q sits at half pixel 2q + off), in the
    // targets' own texels, kept inside the filled region.
    vec2 posQ    = clamp((vec2(c) - vec2(off)) * 0.5 + 0.5, vec2(0.5), vec2(qs) - 0.5);
    vec4 spatial = full ? nc : textureLod(newColorTex, posQ / vec2(textureSize(newColorTex, 0)), 0.0);

    // Reproject.
    float tanHalf = tan(pc.fovYRad * 0.5);
    vec2  ndcNow  = ((vec2(c) + 0.5) / vec2(halfSize)) * 2.0 - 1.0;
    vec3  dirENU  = normalize(mat3(transpose(pc.skyView))
                              * vec3(ndcNow.x * tanHalf * pc.aspect, -ndcNow.y * tanHalf, -1.0));
    mat3 mNow, mPrev;
    enuOf(pc.obsECEFDir.xyz, mNow);
    enuOf(cv2.prevObs.xyz, mPrev);
    vec3 vE = mNow * dirENU;
    // The point, from the previous eye, where the clouds were: they drift with the map, so the
    // point that shows this cloud now showed it at Rz(drift delta) p last frame (obsDelta already
    // holds Rz(delta) eye - prevEye). Without it, time warp tore far clouds into 2x2 squares.
    if (nd.x > 0.0) {
        vec3 v = vE * nd.x;
        vE = vec3(v.x * cv2.extra.z - v.y * cv2.extra.w, v.x * cv2.extra.w + v.y * cv2.extra.z, v.z)
           + cv2.obsDelta.xyz;
    }
    vec3 cam = mat3(cv2.prevSkyView) * (transpose(mPrev) * vE);
    bool valid = cv2.frame.y > 0.5 && cam.z < 0.0;
    vec2 ndcPrev = vec2(cam.x / (-cam.z) / (cv2.prevObs.w * cv2.obsDelta.w),
                        -cam.y / (-cam.z) / cv2.prevObs.w);
    vec2 uvPrev = ndcPrev * 0.5 + 0.5;
    valid = valid && all(greaterThanEqual(uvPrev, vec2(0.0))) && all(lessThanEqual(uvPrev, vec2(1.0)));

    vec4 outC;
    if (valid) {
        vec4 hist = textureLod(histColorTex, uvPrev, 0.0);
        // New-sample weight: look2.w for a still view (low: an exponential blend at weight a keeps
        // sqrt(a / (2 - a)) of the per-sample noise — 38% at 0.25, which showed as grain on
        // sharp-edged surfaces), rising with the reprojection's motion so a moving view doesn't smear.
        vec2  uvNow    = (vec2(c) + 0.5) / vec2(halfSize);
        float motionPx = length((uvPrev - uvNow) * vec2(halfSize));
        // Plus the evolution the reprojection cannot follow (the noise volumes sliding against each
        // other — km per second under time warp), in pixels at this cloud's distance.
        if (nd.x > 0.0)
            motionPx = max(motionPx, cv2.motion.x / (nd.x * 2.0 * tanHalf / float(halfSize.y)));
        float wNew     = mix(cv2.look2.w, max(cv2.look2.w, 0.35), smoothstep(0.5, 4.0, motionPx));
        // A little slack on the box: the clamp is against samples up to two pixels away.
        // A still view has nothing to reject, and the box (from the quarter-grid samples around
        // this pixel, not its own rays) pulled every far pixel toward its neighbours: blocky 2x2
        // squares. So the box widens when the reprojection barely moves, and is tight in motion.
        vec4 slack = (mx - mn) * mix(1.0, 0.1, smoothstep(0.3, 2.0, motionPx)) + vec4(1e-4);
        vec4 hc = clamp(hist, mn - slack, mx + slack);
        // The other three pixels of the block also take a share of the interpolated new samples.
        // Without it the one pixel refreshed each frame stood out from the three that were not,
        // and noisy (shaded, grazing) surfaces showed a 2x2 dot grid. In motion the shares
        // converge: the refreshed pixel took 35% of one noisy sample while its neighbours took 5%
        // of the smooth estimate, and a pan or a fly-through drew the 2x2 lattice as a cross-hatch
        // over every cloud (harness_runs/cloud_v2_x, x_pan). So in motion all four take nearly the
        // same weight, and the refreshed pixel's own sample is pulled halfway to the estimate.
        float mk    = smoothstep(0.5, 4.0, motionPx);
        vec4  fresh = isNew ? mix(nc, spatial, 0.5 * mk) : spatial;
        float w     = isNew ? wNew : wNew * mix(0.15, 0.85, mk);
        outC = mix(hc, fresh, w);
    } else {
        outC = isNew ? nc : spatial;
    }
    imageStore(outColor, c, outC);
    imageStore(outDepth, c, vec4(nd, 0.0, 0.0));
}
