#version 450
#extension GL_EXT_control_flow_attributes : enable

// ── Clouds v2: temporal resolve (.plans/CLOUDS_V2_PLAN.md, phase 2) ──────────────────────────────
// Half resolution. cloud_v2_march.comp marched one pixel of each 2x2 block this frame; this pass
// produces every pixel:
//   this frame's pixel   the new sample blended over the reprojected, clamped history
//   the other three      the reprojected history, clamped to the 3x3 neighbourhood of new samples
//   no valid history     a bilinear upsample of the new samples (first frame, after a jump, off-screen)
//
// Reprojection is exact geometry, not motion vectors: the camera is a rotation about a known eye.
// A pixel's point is its ray at the block's mean cloud distance (a sky pixel is a direction at
// infinity), moved into the previous frame's frame by the eye's displacement (ECEF metres, formed
// in double on the CPU) and projected with the previous rotation and field of view. Clouds are
// translucent, so one distance per pixel is an approximation; the neighbourhood clamp absorbs it.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {        // == CloudMarchPC
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#include "common.glsl"
#define CV2_PARAMS_ONLY
#define CV2_PARAMS_BINDING 0
#include "clouds_v2.glsl"

layout(set = 0, binding = 1) uniform sampler2D newColorTex;    // quarter grid, linear/clamp
layout(set = 0, binding = 2) uniform sampler2D newDepthTex;    // quarter grid (texelFetch)
layout(set = 0, binding = 3) uniform sampler2D histColorTex;   // half grid, last frame's result
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outColor;
layout(set = 0, binding = 5, rg32f)   uniform image2D outDepth;   // read back at this texel: the distance history (review 12)
// Adaptive rate (misc.z = 3): tiles of 32x32 half-res pixels listed by the march's pass A were marched
// at full rate into these (pass B); the rest are the sparse grid, which pass B also kept complete.
layout(set = 0, binding = 6) uniform sampler2D fullColorTex;
layout(set = 0, binding = 7) uniform sampler2D fullDepthTex;
// 2026-10-11: each pixel's AGE, the number of samples its history holds (reprojected with it). A pixel whose history
// is young (uncovered by a pan, disoccluded, rejected by the clamp) takes the running mean 1 / (age + 1) instead of
// the fixed history weight, and its first samples are the smooth estimate of its neighbourhood, not single rays:
// at the still weight (0.04-0.05, one visit in four frames on the sparse grid) a newly shown cloud kept its first
// noisy, mostly self-shadowed rays for seconds (the user: "dark pixelation on newly exposed clouds before they settle").
layout(set = 0, binding = 9, r32f) uniform writeonly image2D outAge;
layout(set = 0, binding = 10) uniform sampler2D histAgeTex;
layout(std430, set = 0, binding = 8) readonly buffer TileBuf { uint tPad, tDispX, tDispY, tDispZ; uint tList[4096]; uint tFlag[4096]; };

ivec2 gHalf, gQs;
const int   kWideColorRadius   = 2;      // the motion colour box: 5x5 new samples ...
const float kWideColorDepthTol = 0.25;   // ... at this pixel's distance +-25%
const float kWideColorPx0      = 1.0;    // ... faded out over 1-3 px a frame of the neighbourhood's parallax
const float kWideColorPx1      = 3.0;
bool  gAdaptive = false;
// Review 20: the history is read Catmull-Rom (9 bilinear taps, sky_taa.comp's form), not bilinear. Rising or
// sliding slowly, far clouds move a fraction of a pixel a frame and keep the still weight (95% history), and a
// bilinear read at a fractional offset is a small blur that compounds every frame: horizon clouds went soft and
// smeared vertically while climbing (user snapshot 4, beside the Reflect beams), sharp again once still.
vec4 sampleHistory(vec2 uv, vec2 size)
{
    vec2 sp  = uv * size;
    vec2 tp1 = floor(sp - 0.5) + 0.5;
    vec2 f   = sp - tp1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 tp0 = (tp1 - 1.0) / size, tp3 = (tp1 + 2.0) / size, tp12 = (tp1 + w2 / w12) / size;
    vec4 r = textureLod(histColorTex, vec2(tp0.x,  tp0.y),  0.0) * (w0.x  * w0.y)
           + textureLod(histColorTex, vec2(tp12.x, tp0.y),  0.0) * (w12.x * w0.y)
           + textureLod(histColorTex, vec2(tp3.x,  tp0.y),  0.0) * (w3.x  * w0.y)
           + textureLod(histColorTex, vec2(tp0.x,  tp12.y), 0.0) * (w0.x  * w12.y)
           + textureLod(histColorTex, vec2(tp12.x, tp12.y), 0.0) * (w12.x * w12.y)
           + textureLod(histColorTex, vec2(tp3.x,  tp12.y), 0.0) * (w3.x  * w12.y)
           + textureLod(histColorTex, vec2(tp0.x,  tp3.y),  0.0) * (w0.x  * w3.y)
           + textureLod(histColorTex, vec2(tp12.x, tp3.y),  0.0) * (w12.x * w3.y)
           + textureLod(histColorTex, vec2(tp3.x,  tp3.y),  0.0) * (w3.x  * w3.y);
    return vec4(max(r.rgb, vec3(0.0)), clamp(r.a, 0.0, 1.0));
}

bool tileFull(ivec2 p)
{
    if (!gAdaptive) return false;
    p = clamp(p, ivec2(0), gHalf - 1);
    return tFlag[(p.x >> 5) + (p.y >> 5) * ((gHalf.x + 31) / 32)] != 0u;
}
// This frame's sample for pixel p in adaptive mode: its own full-rate ray in a listed tile, else its
// block's sparse-grid sample.
vec4 freshAt(ivec2 p)
{
    p = clamp(p, ivec2(0), gHalf - 1);
    return tileFull(p) ? texelFetch(fullColorTex, p, 0) : texelFetch(newColorTex, min(p >> 1, gQs - 1), 0);
}

// Review 9: the clamp works on the cloud's MEAN COLOUR (rgb / opacity) and its transmittance, not on the
// premultiplied colour and T independently. Clamped separately an edge texel's history could keep a low T
// with a darkened rgb — an opaque, unlit patch: dark flickering 2x2 specks along cloud edges over the sea
// (review 9, once the march's own airlight, which used to dominate both, moved to the sky pass).
vec4 cv2ToMean(vec4 v)   { return vec4(v.rgb / max(1.0 - v.a, 0.02), v.a); }
vec4 cv2FromMean(vec4 v) { return vec4(v.rgb * max(1.0 - v.a, 0.02), v.a); }

void enuOf(vec3 up, out mat3 m)
{
    vec3 z = normalize(up);
    vec3 x = normalize(cross(vec3(0.0, 0.0, 1.0), z));
    m = mat3(x, cross(z, x), z);
}

void main()
{
    ivec2 halfSize = imageSize(outColor);
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x >= halfSize.x || c.y >= halfSize.y) return;

    // The new samples: a quarter grid in the targets' top-left (sparse, rate 0), every pixel (full,
    // 1), or a checkerboard in place alternating each frame (half, 2: the march's "Half rate while
    // moving" — every stale pixel's four neighbours are this frame's).
    int   rate  = int(cv2.misc.z + 0.5);
    bool  full  = rate == 1;
    bool  halfR = rate == 2;
    ivec2 qs    = (full || halfR) ? halfSize : (halfSize + 1) / 2;
    ivec2 off   = (rate == 0 || rate == 3) ? ivec2(cv2.frame.zw) : ivec2(0);
    ivec2 b     = (full || halfR) ? c : min(c >> 1, qs - 1);
    int   par   = int(cv2.frame.x) & 1;
    bool  isNew = full || (halfR ? ((c.x + c.y + par) & 1) == 0 : all(equal(c & 1, off)));
    gHalf = halfSize; gQs = qs; gAdaptive = rate == 3;
    bool  tFull = tileFull(c);             // adaptive: this pixel was marched at full rate

    vec4 nc = texelFetch(newColorTex, b, 0);
    vec2 nd = texelFetch(newDepthTex, b, 0).xy;
    if (tFull) {
        isNew = true;
        nc = texelFetch(fullColorTex, c, 0);
        nd = texelFetch(fullDepthTex, c, 0).xy;
    }

    // The clamp box: the 3x3 of new samples around this pixel (at half rate only this frame's: the
    // others are two frames old).
    vec4 mn = vec4(1e30), mx = vec4(-1e30), m1 = vec4(0.0), m2 = vec4(0.0), ax = vec4(0.0);
    float nBox = 0.0;
    float dNear = 1e30;   // the nearest cloud distance among the new samples (review 19, below)
    vec3  rMn = vec3(1e30), rMx = vec3(-1e30);   // the same box in plain radiance (review 20b, below)
    float dW = 0.0, dWs = 0.0;                    // the box's opacity-weighted mean distance (review 20c, below)
    for (int dy = -1; dy <= 1; ++dy)
    for (int dx = -1; dx <= 1; ++dx) {
        ivec2 pq = clamp(b + ivec2(dx, dy), ivec2(0), qs - 1);
        if (halfR && ((pq.x + pq.y + par) & 1) != 0) continue;
        vec4 s = tFull ? freshAt(c + ivec2(dx, dy)) : texelFetch(newColorTex, pq, 0);
        float dq = tFull ? texelFetch(fullDepthTex, clamp(c + ivec2(dx, dy), ivec2(0), gHalf - 1), 0).x
                         : texelFetch(newDepthTex, pq, 0).x;
        if (dq > 0.0) { dNear = min(dNear, dq); float op = 1.0 - s.a; dW += op * dq; dWs += op; }
        if ((dx == 0) != (dy == 0)) ax += s;   // the four axial neighbours (the sparse grid's smoothing)
        rMn = min(rMn, s.rgb); rMx = max(rMx, s.rgb);
        s = cv2ToMean(s);
        mn = min(mn, s); mx = max(mx, s);
        m1 += s; m2 += s * s; nBox += 1.0;
    }
    m1 /= max(nBox, 1.0);
    vec4 sdBox = sqrt(max(m2 / max(nBox, 1.0) - m1 * m1, vec4(0.0)));

    // Where this pixel sits among the new samples (sample q sits at half pixel 2q + off), in the
    // targets' own texels, kept inside the filled region. At half rate: its four neighbours' mean
    // (their depth too: its own is two frames old).
    // At full rate, a 3x3 tent of this frame's samples: what the pixel falls back to where the history
    // cannot help (fast flight — WASD moves ~500 km/s, ~17 km a frame — or a jump). A single ray's
    // start jitter is interleaved gradient noise, whose diagonal stripes the history normally averages
    // away; alone, they drew corduroy over every cloud and the clouds lost their form (user, 2026-09-29).
    vec4 blur = nc;
    if (tFull) {
        blur = nc * 4.0;
        [[dont_unroll]] for (int k = 0; k < 8; ++k) {
            ivec2 o = ivec2(k < 3 ? k - 1 : (k < 5 ? (k == 3 ? -1 : 1) : k - 6), k < 3 ? -1 : (k < 5 ? 0 : 1));
            blur += ((o.x == 0 || o.y == 0) ? 2.0 : 1.0) * freshAt(c + o);
        }
        blur *= 1.0 / 16.0;
    } else if (full) {
        blur = nc * 4.0;
        [[dont_unroll]] for (int k = 0; k < 8; ++k) {
            ivec2 o = ivec2(k < 3 ? k - 1 : (k < 5 ? (k == 3 ? -1 : 1) : k - 6), k < 3 ? -1 : (k < 5 ? 0 : 1));
            float wk = (o.x == 0 || o.y == 0) ? 2.0 : 1.0;
            blur += wk * texelFetch(newColorTex, clamp(c + o, ivec2(0), qs - 1), 0);
        }
        blur *= 1.0 / 16.0;
    }
    vec4 spatial;
    if (full || tFull) spatial = nc;
    else if (halfR) {
        // A fresh pixel's smooth estimate: itself and its four diagonal neighbours (fresh too), which
        // motion pulls it halfway toward, as the sparse grid's bilinear estimate does (below). Its raw
        // single sample left the surfaces grainy in motion.
        if (isNew) {
            spatial = 0.5 * nc + 0.125 * (texelFetch(newColorTex, clamp(c + ivec2(1, 1), ivec2(0), qs - 1), 0)
                                        + texelFetch(newColorTex, clamp(c + ivec2(-1, 1), ivec2(0), qs - 1), 0)
                                        + texelFetch(newColorTex, clamp(c + ivec2(1, -1), ivec2(0), qs - 1), 0)
                                        + texelFetch(newColorTex, clamp(c + ivec2(-1, -1), ivec2(0), qs - 1), 0));
        } else {
            ivec2 n0 = clamp(c + ivec2(1, 0), ivec2(0), qs - 1), n1 = clamp(c - ivec2(1, 0), ivec2(0), qs - 1);
            ivec2 n2 = clamp(c + ivec2(0, 1), ivec2(0), qs - 1), n3 = clamp(c - ivec2(0, 1), ivec2(0), qs - 1);
            spatial = 0.25 * (texelFetch(newColorTex, n0, 0) + texelFetch(newColorTex, n1, 0)
                            + texelFetch(newColorTex, n2, 0) + texelFetch(newColorTex, n3, 0));
            vec2 d0 = texelFetch(newDepthTex, n0, 0).xy, d1 = texelFetch(newDepthTex, n1, 0).xy;
            vec2 d2 = texelFetch(newDepthTex, n2, 0).xy, d3 = texelFetch(newDepthTex, n3, 0).xy;
            float wd = float(d0.x > 0.0) + float(d1.x > 0.0) + float(d2.x > 0.0) + float(d3.x > 0.0);
            nd = vec2(wd > 0.0 ? (max(d0.x, 0.0) + max(d1.x, 0.0) + max(d2.x, 0.0) + max(d3.x, 0.0)) / wd : 0.0,
                      max(max(d0.y, d1.y), max(d2.y, d3.y)));
        }
    } else if (isNew) {
        // Review 7: the refreshed pixel's own ray, pulled halfway to its four axial neighbours — about the
        // noise of the three interpolated pixels of its block (a raw ray has ~1.4-2x theirs). Taken in
        // motion (below); raw beside smooth, moving to another pixel of the block each frame, was a 2x2
        // checkerboard once "History weight moving" let this frame through.
        spatial = mix(nc, 0.25 * ax, 0.5);
    } else {
        vec2 posQ = clamp((vec2(c) - vec2(off)) * 0.5 + 0.5, vec2(0.5), vec2(qs) - 0.5);
        spatial = textureLod(newColorTex, posQ / vec2(textureSize(newColorTex, 0)), 0.0);
    }
    // On the sparse grid what fast motion leans on is the smooth estimate, not the block's one sample: blur
    // was nc there, so past ~16 px of parallax every 2x2 block went flat (4x4-pixel squares all over a
    // fast flight — the "blocky" clouds and horizon, review 15).
    if (!(full || tFull)) blur = spatial;

    // Reproject.
    float tanHalf = tan(pc.fovYRad * 0.5);
    vec2  ndcNow  = ((vec2(c) + 0.5) / vec2(halfSize)) * 2.0 - 1.0;
    vec3  dirENU  = normalize(mat3(transpose(pc.skyView))
                              * vec3(ndcNow.x * tanHalf * pc.aspect, -ndcNow.y * tanHalf, -1.0));
    mat3 mNow, mPrev;
    enuOf(pc.obsECEFDir.xyz, mNow);
    enuOf(cv2.prevObs.xyz, mPrev);
    vec3 vE = mNow * dirENU;
    vec3 vE0 = vE;   // the view direction, kept (vE becomes the reprojected point below)
    // The same ray as a direction at infinity: a rotation of the view moves it exactly as it moves
    // the cloud, so only the difference between the two (PARALLAX, from the eye's translation) and the
    // clouds' own evolution make history unreliable.
    vec3 camInf = mat3(cv2.prevSkyView) * (transpose(mPrev) * vE);
    // The point, from the previous eye, where the clouds were: they drift with the map, so the
    // point that shows this cloud now showed it at Rz(drift delta) p last frame (obsDelta already
    // holds Rz(delta) eye - prevEye). Without it, time warp tore far clouds into 2x2 squares.
    // Review 19: a pixel with NO cloud of its own (clear sea between small puffs) reprojects at the nearest
    // cloud distance of its 3x3 neighbourhood (closest-depth dilation), not at infinity. At infinity, in a
    // moving view low over the clouds, its history came from where a puff had been, and the parallax floor
    // below took it as 50 km away: nearly still, so the still weight and the wide box kept that ghost — every
    // small puff smeared into a streak behind itself and faded (the user's snapshot 2, 7.5 km over trade
    // cumulus: "small clouds get filtered out when moving or changing altitude").
    float ndR = nd.x > 0.0 ? nd.x : (dNear < 1e29 ? dNear : 0.0);
    if (ndR > 0.0) {
        vec3 v = vE * ndR;
        vE = vec3(v.x * cv2.extra.z - v.y * cv2.extra.w, v.x * cv2.extra.w + v.y * cv2.extra.z, v.z)
           + cv2.obsDelta.xyz;
    }
    vec3 cam = mat3(cv2.prevSkyView) * (transpose(mPrev) * vE);
    bool valid = cv2.frame.y > 0.5 && cam.z < 0.0;
    vec2 ndcPrev = vec2(cam.x / (-cam.z) / (cv2.prevObs.w * cv2.obsDelta.w),
                        -cam.y / (-cam.z) / cv2.prevObs.w);
    vec2 uvPrev = ndcPrev * 0.5 + 0.5;
    valid = valid && all(greaterThanEqual(uvPrev, vec2(0.0))) && all(lessThanEqual(uvPrev, vec2(1.0)));

    vec4 outC;
    float ageOut = isNew ? 1.0 : 0.5;
    float motionPx = 1e9;
    // The texel's whole move since last frame, rotation included (motionPx below is PARALLAX only).
    float shiftPx = valid ? length((uvPrev - (vec2(c) + 0.5) / vec2(halfSize)) * vec2(halfSize)) : 1e9;
    if (valid) {
        vec4 hist = sampleHistory(uvPrev, vec2(halfSize));
        // New-sample weight: look2.w for a still view (low: an exponential blend at weight a keeps
        // sqrt(a / (2 - a)) of the per-sample noise — 38% at 0.25, which showed as grain on
        // sharp-edged surfaces), rising with the reprojection's motion so a moving view doesn't smear.
        // Parallax, not total motion: a pan reprojects exactly (the rotation is known), and raising
        // the new-sample weight during a pan swapped the accumulated image for the quarter-grid's
        // single noisy samples — a knitted texture over every cloud (cloud_v2_z, z_pan).
        vec2  uvInf    = vec2(camInf.x / (-camInf.z) / (cv2.prevObs.w * cv2.obsDelta.w),
                              -camInf.y / (-camInf.z) / cv2.prevObs.w) * 0.5 + 0.5;
        motionPx = (camInf.z < 0.0) ? length((uvPrev - uvInf) * vec2(halfSize)) : 8.0;
        // Plus the evolution the reprojection cannot follow (the noise volumes sliding against each
        // other — km per second under time warp), in pixels at this cloud's distance.
        if (ndR > 0.0)
            motionPx = max(motionPx, cv2.motion.x / (ndR * 2.0 * tanHalf / float(halfSize.y)));
        // Review 12: while the EYE moves, at least the parallax of a point 50 km away. A pixel's distance is
        // the opacity-weighted mean of what it shows; a near beam shaft (or haze) in front of a far deck
        // reprojected at the deck's distance kept the still view's weight and wide box, and the shaft left
        // ghost copies behind it climbing or descending (user, a 10-25 km strafe up and down).
        float eyePx;   // the eye's move across this ray, in pixels per metre of distance
        {
            vec3  od    = cv2.obsDelta.xyz;
            float perp  = length(od - vE0 * dot(od, vE0));
            eyePx    = perp / (2.0 * tanHalf / float(halfSize.y));
            motionPx = max(motionPx, eyePx / min(ndR > 0.0 ? ndR : 1e9, 50000.0));
        }
        // Still: look2.w ("History weight", low: the history averages the quarter grid's noise away —
        // at 1 each pixel alternated between its own ray and its neighbours' estimate, a checkerboard
        // flicker). Moving: motion.y ("History weight moving"), reached from a quarter pixel of parallax:
        // a fixed 0.35 from 0.5-4 px left small clouds ghosting behind themselves (user snapshot 4).
        // (The weight and the slack are set after the wide box below, which may raise motionPx.)
        // A little slack on the box: the clamp is against samples up to two pixels away.
        // A still view has nothing to reject, and the box (from the quarter-grid samples around
        // this pixel, not its own rays) pulled every far pixel toward its neighbours: blocky 2x2
        // squares. So the box widens when the reprojection barely moves, and is tight in motion.
        vec4 box3 = mx - mn;
        // A still view takes the box over 7x7 new samples, not 3x3 (2026-10-12). Where the samples are
        // all-or-nothing (a point sample lit or self-shadowed under a grazing Sun), a frame whose nine samples AGREE
        // has a box of zero width, and the history's mean of both was clamped to that one value. Which frames agree
        // is a function of the blue-noise tile around the pixel, so the tile itself was drawn over every
        // half-shadowed surface: the same glyph every 128 px, 9 levels of grain, and 16 levels darker than the
        // mean (user issue 20261012_202341). Forty-nine blue-noise samples nearly always hold both: 0.4 levels of
        // grain, as with no clamp at all (5x5: 1.8); cost within noise. The clamp stays, for light that changes in
        // a still view (a beam's shaft moving on).
        // 2026-10-13: a pixel with no cloud in its 3x3 (reprojected at infinity, its parallax floored at 50 km: "still"
        // at any flying speed) but with cloud in the 7x7 takes that cloud's distance for its parallax. Otherwise, in
        // the band 2-6 pixels behind a cloud's trailing edge, the wide box (which holds the cloud) passed the cloud
        // the pixel showed a frame ago at the still weight: every cloud dragged a granulated copy of its edge behind
        // it over the sea, in blocks of the sparse grid (user issue 20261013_184710, 2.5 km/s low over cumulus).
        // Issue 20261013_202117 (climbing / descending at ~700 m/s over cumulus, low Sun): the still box (and the slack
        // and variance clipping below) follow the parallax of the NEAREST cloud in the neighbourhood (3x3 dNear, 7x7
        // dWide), not this pixel's own, scaled by the history's memory (1 / the still weight). A far horizon cloud
        // moves ~0.1 px a frame climbing at 700 m/s: "still" by its own parallax, so it kept the wide 7x7 box and the
        // still weight (0.02: a 50-frame memory, i.e. ~5 px of lag): the horizon smeared into vertical blocks and a
        // stale rectangle hung over it; and where a near cloud's edge swept over far ones, the far pixels' history
        // (the near cloud) passed the wide box: ghosts of the near cloud over the background. A truly still eye has
        // eyePx 0, so still views are unchanged.
        float lagK   = 1.0 / max(cv2.look2.w, 0.01);
        float mNb    = max(motionPx, (eyePx / min(min(dNear, ndR > 0.0 ? ndR : 1e30), 50000.0)) * lagK);
        float stillW = 1.0 - smoothstep(0.05, 0.5, mNb);
        // The wide neighbourhood is read in motion too (2026-10-13, issue 20261013_214939: the colour box below).
        vec3 cMn = mn.rgb, cMx = mx.rgb, rMnC = rMn, rMxC = rMx;
        float dRef = ndR > 0.0 ? ndR : -1.0;
        float dWide = 1e30;
        {
            vec4 mnW = mn, mxW = mx; vec3 rMnW = rMn, rMxW = rMx;
            [[dont_unroll]] for (int dy = -3; dy <= 3; ++dy)
            [[dont_unroll]] for (int dx = -3; dx <= 3; ++dx) {
                if (abs(dx) < 2 && abs(dy) < 2) continue;
                ivec2 pq = clamp(b + ivec2(dx, dy), ivec2(0), qs - 1);
                if (halfR && ((pq.x + pq.y + par) & 1) != 0) continue;
                vec4 s = tFull ? freshAt(c + ivec2(dx, dy)) : texelFetch(newColorTex, pq, 0);
                float dq = tFull ? texelFetch(fullDepthTex, clamp(c + ivec2(dx, dy), ivec2(0), gHalf - 1), 0).x
                                 : texelFetch(newDepthTex, pq, 0).x;
                if (dq > 0.0) dWide = min(dWide, dq);
                bool sameD = (dRef > 0.0) ? (dq > 0.0 && abs(dq - dRef) < kWideColorDepthTol * dRef) : (dq <= 0.0);
                bool inC   = sameD && max(abs(dx), abs(dy)) <= kWideColorRadius;
                if (inC) { rMnC = min(rMnC, s.rgb); rMxC = max(rMxC, s.rgb); }
                rMnW = min(rMnW, s.rgb); rMxW = max(rMxW, s.rgb);
                s = cv2ToMean(s);
                if (inC) { cMn = min(cMn, s.rgb); cMx = max(cMx, s.rgb); }
                mnW = min(mnW, s); mxW = max(mxW, s);
            }
            if (stillW > 0.0 && dWide < 1e29) {
                if (ndR <= 0.0) motionPx = max(motionPx, eyePx / min(dWide, 50000.0));
                mNb    = max(mNb, max(motionPx, (eyePx / min(dWide, 50000.0)) * lagK));
                stillW = 1.0 - smoothstep(0.05, 0.5, mNb);
            }
            mn = mix(mn, mnW, stillW); mx = mix(mx, mxW, stillW);
            rMn = mix(rMn, rMnW, stillW); rMx = mix(rMx, rMxW, stillW);
        }
        float wNew  = mix(cv2.look2.w, max(cv2.look2.w, cv2.motion.y), smoothstep(0.05, 1.0, motionPx));
        vec4  slack = box3 * mix(1.0, 0.1, smoothstep(0.05, 1.0, mNb)) + vec4(1e-4);
        slack = max(slack, (mx - mn) * stillW);
        // In motion the box is the neighbourhood's mean +- 1.25 sd (variance clipping), inside min/max:
        // a small cloud next to clear sky made a min/max box spanning both, so its ghost passed.
        float mv  = smoothstep(0.1, 1.5, mNb);
        vec4  bLo = mix(mn - slack, max(mn, m1 - cv2.samp.z * sdBox), mv);
        vec4  bHi = mix(mx + slack, min(mx, m1 + cv2.samp.z * sdBox + vec4(1e-4)), mv);
        // Issue 20261013_214939 ("noise on moving clouds"): in motion the box above is the 3x3 of new samples, and a new
        // sample's KEY LIGHT is all-or-nothing (the light march's far steps are point samples standing for 0.5-3 km:
        // lit or self-shadowed by its jitter; raw per-sample std ~24 levels at the user's 8-km light march). Nine of
        // them often agree, the box collapses onto one of the two values and the history's mean is clipped to it:
        // every lit cumulus turned to a blocky speckle of the sparse grid with dark L-shaped fragments whenever the
        // eye or the view moved, and the speckle took the still weight's ~50 frames to fade after stopping.
        // So the box's COLOUR (the mean colour; opacity keeps the tight box, which is what rejects a ghost of another
        // cloud or of clear sky) also spans the 5x5 samples at this pixel's distance (+-25%: a near cloud's samples
        // never widen a far pixel's box), while the neighbourhood's parallax (dNear / dWide, not x lagK) is under
        // ~1-3 px a frame: past that the history is replaced quickly anyway, and a wide colour box let a climb's near
        // clouds smear (issue 20261013_202117's path). Shot 1's walk, 1 s after stopping: mean error vs settled
        // 7.6 -> 2.5 levels, pixels past 16 levels 13.7% -> 0.2%; the still view is unchanged.
        float wideK = 1.0 - smoothstep(kWideColorPx0, kWideColorPx1,
                                       max(motionPx, eyePx / min(min(dNear, dWide), 50000.0)));
        bLo.rgb = mix(bLo.rgb, min(bLo.rgb, cMn), wideK); bHi.rgb = mix(bHi.rgb, max(bHi.rgb, cMx), wideK);
        vec4 hc = cv2FromMean(clamp(cv2ToMean(hist), bLo, bHi));
        // Review 20b: and never brighter (or darker) than the new samples' own RADIANCE box. The mean colour divides
        // by the opacity (floor 0.02): a near-clear pixel carrying light of its own — a beam shaft's air, seen from
        // inside the Reflect beams — is x50 there, and a cloud-edge history texel clamped up to it and multiplied back
        // by its own opacity came out as bright blue-white 2x2 blocks along every cloud edge in motion (user snapshot,
        // 5 km over the Anchorage beam site: "chunkiness" and "bluish effects").
        vec3 rSl = (rMx - rMn) * mix(1.0, 0.1, smoothstep(0.05, 1.0, mNb)) + vec3(1e-4);
        hc.rgb = clamp(hc.rgb, mix(rMn, min(rMn, rMnC), wideK) - rSl, mix(rMx, max(rMx, rMxC), wideK) + rSl);
        // The other three pixels of the block also take a share of the interpolated new samples.
        // Without it the one pixel refreshed each frame stood out from the three that were not,
        // and noisy (shaded, grazing) surfaces showed a 2x2 dot grid. In motion the shares
        // converge: the refreshed pixel took 35% of one noisy sample while its neighbours took 5%
        // of the smooth estimate, and a pan or a fly-through drew the 2x2 lattice as a cross-hatch
        // over every cloud (harness_runs/cloud_v2_x, x_pan). So in motion all four take nearly the
        // same weight, and the refreshed pixel's own sample is pulled halfway to the estimate.
        // Review 7: the four also converge as the moving weight rises. At "History weight moving" 1 and a
        // slow move (1-2 px), the refreshed pixel took all of this frame and its three neighbours ~15%: one
        // pixel in four jumped each frame, a checkerboard "even moving slowly" (user snapshot 4).
        float mk    = max(smoothstep(0.5, 4.0, motionPx), smoothstep(0.25, 0.9, wNew));
        vec4  fresh = isNew ? mix(nc, spatial, (halfR ? 0.5 : 1.0) * mk) : spatial;
        float w     = isNew ? wNew : wNew * mix(0.15, 0.85, mk);
        // Past ~16 px of parallax a frame the history is someone else's cloud: lean on this frame,
        // filtered (the corduroy otherwise, see blur).
        if (cv2.samp.x > 0.0) {
            // What the clamps took out of the history is not this pixel's: that share of its age goes too.
            float hAge = textureLod(histAgeTex, uvPrev, 0.0).r;
            float rej  = clamp(2.0 * length(hist.rgb - hc.rgb) / (dot(hist.rgb + hc.rgb, vec3(0.5)) + 1e-3)
                               + 3.0 * abs(hist.a - hc.a), 0.0, 1.0);
            // (Still views too: without it a pixel's first unlucky samples stayed frozen in its mean as a speck.)
            hAge *= 1.0 - rej;
            float young = 1.0 - smoothstep(2.0, 10.0, hAge);
            fresh  = mix(fresh, (full || tFull) ? blur : spatial, cv2.samp.y * young);
            w      = max(w, 1.0 / (hAge + 1.0));
            ageOut = min(hAge + (isNew ? 1.0 : 0.5), cv2.samp.x);
        }
        float mf = smoothstep(6.0, 24.0, motionPx);
        // Review 7: a full-rate pixel in motion leans on the tent by how much of this frame it takes (the
        // single ray's jitter grain; blur is the pixel itself on the sparse grid, where the axial mix does it).
        fresh = mix(fresh, blur, max(0.8 * mf, (full || tFull) ? 0.4 * mk * w : 0.0));
        w     = mix(w, 0.7, mf);
        outC = mix(hc, fresh, w);
    } else {
        outC = isNew ? mix(nc, blur, 0.8) : spatial;
    }
    if (cv2.fog2.z > 0.5 && tFull)          // debug view 11 (fog2.z): the adaptive rate's full-rate tiles
        outC.rgb = outC.rgb * vec3(1.3, 0.7, 0.7) + vec3(0.05, 0.0, 0.0);
    // A non-finite value (from any input) would live on in the history and spread through the neighbourhood
    // reads into a growing block (black squares at the Earth's limb, user snapshot 2026-10-04): no cloud.
    if (any(isnan(outC)) || any(isinf(outC))) outC = vec4(0.0, 0.0, 0.0, 1.0);
    imageStore(outColor, c, outC);
    imageStore(outAge, c, vec4(ageOut, 0.0, 0.0, 0.0));
    // Review 12: the DISTANCE gets a history too, in a still view: it was this frame's sample's (a sparse
    // block takes its one sample's distance, and the sample moves through the block every frame), and the sky
    // pass splits the air in front of the cloud at it — from orbit, where that air is a large share near the
    // limb, the clouds flickered on the 4-frame sparse cycle while their colour history was perfectly still.
    // Read back at THIS texel only (no other invocation writes it), so only while the view is still — still
    // as in NOT TURNING too (review 15): it was gated on the parallax alone, which a pure rotation leaves at
    // 0, so while the camera pitched each texel took 90% of the distance of the texel that had been there,
    // a different direction (sky above the horizon, a cloud 300 km out below it), and the sky pass split the
    // air at it: horizontal streaks and dark shapes along the horizon whenever the view tilted.
    // Review 20c: the opacity-weighted mean of the 3x3 new samples' distances instead of this block's one
    // sample. A translucent haze's mean distance is a noisy per-ray estimate (where along a long thin path its few
    // samples fell); still, the history above averages it, but in motion each 2x2 block took one sample, the sky
    // pass split the air in front of the haze tens of km too near, and along distant cloud edges dark 2x2 blocks
    // came and went (user snapshot 2, walking at 11 km). This frame's samples: nothing to reproject (review 15).
    if (nd.x > 0.0 && dWs > 1e-3) nd.x = dW / dWs;   // and into the still history below: the same noise, slower
    if (motionPx < 0.5 && shiftPx < 0.5) {
        vec2  hd = imageLoad(outDepth, c).xy;
        float wD = 0.1;
        if (hd.x > 0.0 && nd.x > 0.0) nd.x = mix(hd.x, nd.x, wD);
        else if (hd.x > 0.0 && outC.a < 0.999) nd.x = hd.x;
        if (hd.y > 0.0 && nd.y > 0.0) nd.y = mix(hd.y, nd.y, wD);
    }
    imageStore(outDepth, c, vec4(nd, 0.0, 0.0));
}
