#version 450
#extension GL_EXT_control_flow_attributes : enable

// ── Clouds v2: the sparse march (.plans/CLOUDS_V2_PLAN.md, phases 1+2) ──────────────────────────
// Marches ONE pixel of every 2x2 block of the half-resolution cloud grid per frame (the pixel given
// by cv2.frame.zw, rotating over four frames); cloud_v2_resolve.comp fills in the rest from the
// reprojected history. Output per marched pixel:
//   outColor  rgb = cloud radiance after aerial perspective (the B of color*A + B), a = transmittance
//   outDepth  x = transmittance-weighted mean distance (0 = no cloud on this ray)
//             y = distance where transmittance fell below 0.5, if the ray ended < 0.1 (else -1) —
//                 the v1 `tCloudOcclude` meaning, which sat_sky.frag and the beam ray still read
//
// The march: the ray's in-shell segments (clouds_v2.glsl), steps growing with distance
// (march.x + march.y * t, capped), COARSE steps on the cheap field until it finds cloud, then a
// step back and FINE steps on the full field until several are empty. Interleaved-gradient-noise
// jitter on the start, different every frame, so the temporal resolve averages it away.
//
// Lighting per in-cloud sample: a short light march toward the Sun (the first two samples with
// detail — the lumps that make cauliflower), plus one long coarse sample for tall towers;
// two single-scattering lobes; multiple scattering as Wrenninge octaves; sky light from above
// (shape-aware: one cheap sample 250 m up); ground bounce from below; moon, city up-light and the
// Reflect-Orbital beam lights (the v1 list, tile cull and function) at night.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {        // == CloudMarchPC (cloud_march.comp)
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#define CLOUD_PARAMS_BINDING 0
#include "cloud_params.glsl"
#include "common.glsl"

#define CV2_PARAMS_BINDING  1
#define CV2_WEATHER_BINDING 2
#define CV2_SHAPE_BINDING   3
#define CV2_DETAIL_BINDING  4
#define CV2_MESO_BINDING    5
#include "clouds_v2.glsl"

layout(set = 0, binding = 6) uniform sampler2D sceneDepthTex;   // half-res, metres (kNoSurfaceT = sky)
layout(set = 0, binding = 7) uniform sampler2D earthNightTex;
layout(std430, set = 0, binding = 8) readonly buffer TerrainFrame { vec4 terrainFrame; };
#define BEAM_CLOUD_LIGHTS_BINDING 9
#include "beam_cloud_lights.glsl"
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D outColor;
layout(set = 0, binding = 11, rg32f)   uniform writeonly image2D outDepth;

const int N_LIGHT = 12;
vec2 optDepth(vec3 p, vec3 d, float segTotal) {
    float sLen = segTotal / float(N_LIGHT);
    float odR = 0.0, odM = 0.0;
    for (int i = 0; i < N_LIGHT; ++i) {
        float h = max(0.0, length(p + d * (float(i) + 0.5) * sLen) - R_EARTH);
        odR += exp(-h / H_R);
        odM += exp(-h / H_M);
    }
    return vec2(odR, odM) * sLen;
}

const float kCityUpwellStrength = 0.004;
const float kNightFloor         = 0.002;
const float kCityCompressK      = 0.08;
float cityBrightness(float lum) { float raw = max(0.0, lum - kNightFloor); return raw / (raw + kCityCompressK); }

vec3 rayDirAt(vec2 texel, ivec2 size, float tanHalfFov, mat3 camToENU) {
    vec2 ndc = (texel / vec2(size)) * 2.0 - 1.0;
    return normalize(camToENU * vec3(ndc.x * tanHalfFov * pc.aspect, -ndc.y * tanHalfFov, -1.0));
}

float ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

// The Sun's colour arriving at a point, through the atmosphere, 0 in the Earth's shadow.
vec3 sunColorAt(vec3 p, vec3 sunDir, vec3 BETA_R, float BETA_M) {
    vec2 tSE = raySphere(p, sunDir, R_EARTH);
    if (tSE.x > 0.0 && tSE.y > 0.0) return vec3(0.0);
    vec2 tSA = raySphere(p, sunDir, R_ATMOS);
    if (tSA.y <= 0.0) return vec3(SUN_INTENSITY);
    vec2 od = optDepth(p, sunDir, tSA.y);
    return SUN_INTENSITY * exp(-(BETA_R * od.x + BETA_M * 1.1 * od.y));
}

// Zenith sky radiance at a point: v1's skyAmbientBase (single-scattering integral up the local
// vertical). Unlike v1 it is used by DAY as well — v1 applied it only in twilight, so daytime
// clouds had no sky light at all and their shadowed sides came out sun-coloured white.
vec3 skyZenithAt(vec3 p, vec3 sunDir, vec3 BETA_R, float BETA_M) {
    vec3 zen = normalize(p);
    vec2 tSA = raySphere(p, zen, R_ATMOS);
    if (tSA.y <= 0.0) return vec3(0.0);
    const int N_Z = 6;
    float seg = tSA.y / float(N_Z);
    float cosUp = dot(zen, sunDir);
    float odR = 0.0, odM = 0.0, accM = 0.0;
    vec3  accR = vec3(0.0);
    for (int i = 0; i < N_Z; ++i) {
        vec3  sp = p + zen * ((float(i) + 0.5) * seg);
        float h  = max(0.0, length(sp) - R_EARTH);
        float dR = exp(-h / H_R) * seg, dM = exp(-h / H_M) * seg;
        odR += dR; odM += dM;
        vec2 tSE = raySphere(sp, sunDir, R_EARTH);
        if (tSE.x > 0.0 && tSE.y > 0.0) continue;
        vec2 tSun = raySphere(sp, sunDir, R_ATMOS);
        vec2 sOD  = (tSun.y > 0.0) ? optDepth(sp, sunDir, tSun.y) : vec2(0.0);
        vec3 att  = exp(-(BETA_R * (odR + sOD.x) + BETA_M * 1.1 * (odM + sOD.y)));
        accR += att * dR;
        accM += dot(att, vec3(1.0 / 3.0)) * dM;
    }
    return SUN_INTENSITY * (phaseR(cosUp) * BETA_R * accR + vec3(phaseM(cosUp) * BETA_M * accM));
}

// Light-march geometry: a geometric series of nL steps summing to light.x.
const float kLightRatio = 1.6;
const vec3  kMoonColor  = vec3(0.92, 0.95, 1.0);

// Optical depth from a cloud sample toward a light: the light march (the first two samples with
// detail — the lumps that make cauliflower) plus one long coarse sample, the far side of a tower.
float lightOD(vec3 rel, vec3 ldir, float eyeH, mat3 enuToEcef, int nL, float lSeg0, float jitter,
              float detailAmt, float fp)
{
    float od = 0.0, s = 0.0, lSeg = lSeg0;
    for (int k = 0; k < nL; ++k) {
        float sm = s + lSeg * (0.5 + (jitter - 0.5) * 0.5);
        // The view sample's footprint, not the step's: a longer footprint would turn the gaps
        // between cells into haze and shadow everything.
        CV2Field lf = cv2Field(cv2Pos(rel + ldir * sm, eyeH, enuToEcef), k < 2 ? detailAmt : 0.0, fp);
        od += lf.sigma * lSeg;
        s += lSeg; lSeg *= kLightRatio;
    }
    CV2Field ff = cv2Field(cv2Pos(rel + ldir * (cv2.light.x * 1.6), eyeH, enuToEcef), 0.0, fp);
    return od + ff.sigma * cv2.light.x * 0.8;
}

// Multiple scattering (Wrenninge octaves): each octave sees a fraction of the optical depth.
float msOctaves(float od)
{
    float ms = 0.0, a = 1.0, b = 1.0;
    for (int k = 1; k <= 2; ++k) { a *= cv2.light.z; b *= cv2.light.w; ms += b * exp(-od * a); }
    return ms;
}

void main()
{
    // Sparse: one pixel per 2x2 block, written to the quarter-size top-left of the targets.
    // Full rate (cv2.misc.z, from altitude): every half-res pixel, written in place.
    bool  full     = cv2.misc.z > 0.5;
    ivec2 halfSize = textureSize(sceneDepthTex, 0);
    ivec2 qSize    = full ? halfSize : (halfSize + 1) / 2;
    ivec2 q        = ivec2(gl_GlobalInvocationID.xy);
    ivec2 pix      = full ? min(q, halfSize - 1) : min(q * 2 + ivec2(cv2.frame.zw), halfSize - 1);

    float tanHalfFov = tan(pc.fovYRad * 0.5);
    mat3  camToENU   = mat3(transpose(pc.skyView));
    vec3  enuZ = normalize(pc.obsECEFDir.xyz);
    vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    vec3  enuY = cross(enuZ, enuX);
    mat3  enuToEcef = mat3(enuX, enuY, enuZ);
    float eyeH = terrainFrame.x + 2.0;               // == observerPos(obsEffH).z - R_EARTH
    vec3  eye  = vec3(0.0, 0.0, R_EARTH + eyeH);
    vec3  sunDir = normalize(pc.sunDirENU.xyz);

    // Beam-light tile cull. This workgroup owns half-res pixels [wg*32, wg*32+32) (16 at full
    // rate); its cone is computed from those corners (the cull only needs an axis and a half-angle).
    {
        float tile = full ? 16.0 : 32.0;
        vec2 tMin = vec2(gl_WorkGroupID.xy) * tile, tMax = tMin + tile;
        vec3 d00 = rayDirAt(tMin, halfSize, tanHalfFov, camToENU);
        vec3 d10 = rayDirAt(vec2(tMax.x, tMin.y), halfSize, tanHalfFov, camToENU);
        vec3 d01 = rayDirAt(vec2(tMin.x, tMax.y), halfSize, tanHalfFov, camToENU);
        vec3 d11 = rayDirAt(tMax, halfSize, tanHalfFov, camToENU);
        vec3 ax  = normalize(d00 + d10 + d01 + d11);
        float ch = min(min(dot(ax, d00), dot(ax, d10)), min(dot(ax, d01), dot(ax, d11)));
        cullCloudLightsForTile(ax, acos(clamp(ch, -1.0, 1.0)), eye, R_EARTH + cv2.shell.y);
    }
    if (q.x >= qSize.x || q.y >= qSize.y) return;

    vec3  dir    = rayDirAt(vec2(pix) + 0.5, halfSize, tanHalfFov, camToENU);
    float tScene = texelFetch(sceneDepthTex, pix, 0).r;

    vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
    float BETA_M = BETA_M_BASE * cloud.atmosMieGain;

    vec2 seg[2];
    int  nSeg = cv2ShellSegments(eye, dir, seg[0], seg[1]);

    // Knockout 32768 (volumetric cloud march) also covers v2.
    if ((cloud.dbgDisableMask & 32768u) != 0u || cv2.look.x <= 0.0) nSeg = 0;

    float cosSun = dot(dir, sunDir);
    float phSS   = cv2.phase.y * cv2HG(cosSun, cv2.phase.x) + cv2.phase.w * cv2HG(cosSun, cv2.phase.z);
    float phMS   = 0.85 * cv2HG(cosSun, 0.2) + 0.15 * cv2HG(cosSun, -0.4);
    vec3  moonDir  = normalize(pc.moonDirENU.xyz);
    float cosMoon  = dot(dir, moonDir);
    float phMoonSS = cv2.phase.y * cv2HG(cosMoon, cv2.phase.x) + cv2.phase.w * cv2HG(cosMoon, cv2.phase.z);
    float phMoonMS = 0.85 * cv2HG(cosMoon, 0.2) + 0.15 * cv2HG(cosMoon, -0.4);
    // Per-ray phases of ice (the high layer: a forward lobe + halos, sundogs, parhelic circle,
    // circumzenithal arc) and rain (a forward lobe + the bows), for either key light. Per RAY, so
    // the optics are as sharp as a pixel. (.plans/ATMOS_OPTICS_AND_STORMS.md)
    float og = cv2.rain.y;
    // Ice: a narrow forward (diffraction) peak on a broad, low lobe. One wide lobe (g 0.75) whited
    // out 30 degrees around the Sun and buried the 22 degree halo and the sundogs in it.
    vec3  phIceSun   = vec3(0.45 * cv2HG(cosSun, 0.93) + 0.55 * cv2HG(cosSun, 0.3))  + og * cv2IceOptics(dir, sunDir);
    vec3  phIceMoon  = vec3(0.45 * cv2HG(cosMoon, 0.93) + 0.55 * cv2HG(cosMoon, 0.3)) + og * cv2IceOptics(dir, moonDir);
    vec3  phRainSun  = vec3(0.85 * cv2HG(cosSun, 0.8))  + og * 0.5 * cv2RainOptics(dir, sunDir);
    vec3  phRainMoon = vec3(0.85 * cv2HG(cosMoon, 0.8)) + og * 0.5 * cv2RainOptics(dir, moonDir);
    vec3  moonKey  = kMoonColor * pc.moonDirENU.w * cloud.moonGain * cv2.misc.y;

    int   nL    = int(cv2.light.y);
    float lSeg0 = cv2.light.x * (kLightRatio - 1.0) / max(pow(kLightRatio, float(nL)) - 1.0, 1e-4);

    // Spatially IGN, temporally a golden-ratio sequence per pixel: IGN alone, read on one pixel of
    // each 2x2 block per frame, is correlated between neighbours and left a screen-door pattern.
    // The sequence advances per VISIT of this pixel, not per frame: a sparse pixel is marched every
    // fourth frame, and 4 x 0.618 stepped the offset by ~0.47 per visit, so each pixel of a 2x2
    // block sat on its own two clusters of offsets for hundreds of frames. Each slot kept its own
    // sampling bias, and far clouds (long steps) broke into 2x2 squares.
    float visit  = full ? cv2.frame.x : floor(cv2.frame.x * 0.25);
    float jitter = fract(ign(vec2(pix)) + 0.6180340 * visit);
    // Angular size of one half-res pixel: a sample at distance t stands for t * pixAng metres.
    float pixAng = 2.0 * tanHalfFov / float(halfSize.y);

    vec3  L = vec3(0.0);
    float T = 1.0;
    float dAcc = 0.0, wAcc = 0.0, tHalf = -1.0;
    float odRain = 0.0;                               // debug view 5

    // Per-ray lighting caches, refreshed every 25 km along the ray (the Sun's elevation and the
    // sky's colour change across a long horizon ray).
    vec3  sunCol = vec3(0.0), skyZen = vec3(0.0);
    float cacheT = -1e30;

    int   iters = 0;
    int   kMaxIters = int(cv2.misc.x);
    float pathLen = 0.0, odPath = 0.0, remLen = 0.0;   // for filling what the budget leaves
    // The distance limit is measured from where the ray enters the shell, not from the eye: from
    // orbit the Earth itself is further than the limit, and the far half of the clouds was cut off.
    float tLimit = seg[0].x + cv2.march.w;
    for (int si = 0; si < nSeg; ++si) {
        float t    = seg[si].x;
        float tEnd = min(min(seg[si].y, tScene), tLimit);
        if (t >= tEnd) continue;
        if (iters >= kMaxIters) { remLen += tEnd - t; continue; }
        bool fine = false;
        int  empty = 0;
        t += (cv2.march.x + cv2.march.y * (t - seg[0].x)) * jitter;
        while (t < tEnd && iters < kMaxIters && T > 0.01) {
            ++iters;
            // Steps grow with distance (the noise is read at the pixel footprint there anyway, so
            // shorter steps would only resample the same mip). 0.6% growth ran a horizon ray out of
            // its budget ~50 km out, and a broken field there came out half transparent. Measured
            // from the shell entry, like the limit (from orbit the eye is hundreds of km away).
            float tr    = t - seg[0].x;
            float stepF = min(cv2.march.x + cv2.march.y * tr, max(cv2.march.z, tr * 0.012));
            // ...and at most kMaxVertStep of altitude per step, measured against the vertical AT
            // THE SAMPLE (not the observer's). From orbit a distance-grown step crossed a 900 m
            // stratus deck in one stride and drew it as scattered dots.
            const float kMaxVertStep = 200.0;
            float dz = abs(dot(dir, normalize(eye + dir * t)));
            stepF = min(stepF, kMaxVertStep / max(dz, 0.01));
            vec3  rel   = dir * t;
            CV2Pos p    = cv2Pos(rel, eyeH, enuToEcef);
            float fp = t * pixAng;
            if (!fine) {
                CV2Field c = cv2Field(p, -1.0, fp);
                // Back two steps and on to a JITTERED fine lattice: the start jitter covers only the
                // first (shortest) step, so without this every fine sample sat on the coarse grid and
                // a flat, sharp deck top drew contour rings around the nadir.
                if (c.sigma > 0.0) { fine = true; empty = 0; t = max(seg[si].x, t - (2.0 - jitter) * stepF); continue; }
                t += 2.0 * stepF;
                pathLen += 2.0 * stepF;
                continue;
            }
            float detailAmt = 1.0 - smoothstep(cv2.shell.w, cv2.shell.w * 4.0, t);
            CV2Field f = cv2Field(p, detailAmt, fp);
            pathLen += stepF;
            if (f.sigma <= 0.0) {
                if (++empty > 5) fine = false;
                t += stepF;
                continue;
            }
            empty = 0;
            odPath += f.sigma * stepF;
            odRain += f.sigma * f.rain * stepF;

            vec3  pW   = eye + rel;                        // world point, ENU about the observer
            vec3  up   = normalize(pW);
            float sunUp = dot(up, sunDir);
            if (t - cacheT > 25000.0) {
                sunCol = sunColorAt(pW, sunDir, BETA_R, BETA_M);
                skyZen = skyZenithAt(normalize(pW) * (R_EARTH + clamp(p.h, 0.0, 60000.0)), sunDir, BETA_R, BETA_M);
                cacheT = t;
            }
            // Earth's shadow at THIS sample (the cached colour is for a point up to 25 km back).
            float rP     = R_EARTH + p.h;
            float horizS = -sqrt(max(1.0 - (R_EARTH / rP) * (R_EARTH / rP), 0.0));
            float sunVis = smoothstep(horizS - 0.004, horizS + 0.004, sunUp);

            float dayness = clamp((sunUp + 0.2) / 0.5, 0.0, 1.0);
            float nightK  = 1.0 - min(dayness * 3.0, 1.0);

            // ── Key light: the Sun by day; at night the Moon, through the SAME light march. v1 and
            // the first v2 lit night cloud with a flat moon term: black bases, grey tops, no form. ──
            vec3  keyCol = vec3(0.0);
            vec3  keyDir = sunDir;
            float pSS = phSS, pMS = phMS, cosK = cosSun;
            bool  moonIsKey = false;
            if (sunVis > 0.0 && dot(sunCol, sunCol) > 0.0) {
                keyCol = sunCol * sunVis * cv2.look2.y;
            } else if (nightK > 0.0) {
                float moonUp = dot(up, moonDir);
                keyCol = moonKey * nightK * smoothstep(-0.05, 0.1, moonUp);
                keyDir = moonDir; pSS = phMoonSS; pMS = phMoonMS; cosK = cosMoon; moonIsKey = true;
            }
            // The high layer is optically thin ice: a light march through it buys nothing, and it
            // spans the whole sky, so every sample there paid seven field evaluations. Its
            // self-shadow is its own density over a few hundred metres; its sky light is unoccluded.
            bool thin = f.thin > 0.5;
            vec3 keyS = vec3(0.0);
            if (dot(keyCol, keyCol) > 0.0) {
                float od = thin ? f.sigma * 400.0
                                : lightOD(rel, keyDir, eyeH, enuToEcef, nL, lSeg0, jitter, detailAmt, fp);
                // A deck lit at a grazing angle is shadowed by the rest of the deck, tens of km
                // beyond the light march: the path to the deck's top along the light. Without it
                // a deck's interior was lit through a few km of cloud, and the whole band along the
                // terminator glowed red from orbit instead of fading to black.
                if (f.deck > 0.0) {
                    float odDeck = f.sigma * max(f.topH - p.h, 0.0) / max(dot(up, keyDir), 0.03);
                    od = max(od, odDeck * f.deck * 0.5);
                }
                float powder = 1.0 - cv2.look2.z * exp(-f.sigma * 300.0) * (0.5 - 0.5 * cosK);
                vec3 pSSv = vec3(pSS);
                if (f.thin > 0.0 || f.rain > 0.0) {
                    pSSv = mix(pSSv, moonIsKey ? phIceMoon : phIceSun, f.thin);
                    pSSv = mix(pSSv, moonIsKey ? phRainMoon : phRainSun, f.rain);
                }
                keyS = keyCol * powder * (pSSv * exp(-od) + pMS * msOctaves(od) * f.msBright);
            }

            // ── Sky light from above, occluded by the cloud 250 m up, and by the sample's own
            // density: deep inside a cloud less sky reaches it than at its surface. Without that
            // the shaded side of a cloud was one flat grey, whatever the surface did. ──
            float ambVis = 1.0;
            if (!thin) {
                CV2Field fu = cv2Field(cv2Pos(rel + up * 250.0, eyeH, enuToEcef), 0.0, fp);
                ambVis = exp(-fu.sigma * 250.0) * mix(0.55, 1.0, f.hf) * mix(1.0, exp(-f.sigma * 150.0), 0.5);
            }
            // The night sky: the moonlit sky's share of the moon, for the cloud's shaded side.
            vec3  skyAmb = skyZen * cv2.look.w + moonKey * nightK * 0.03 * max(dot(up, moonDir), 0.0);
            vec3  ambS   = skyAmb * ambVis * f.ambient;

            // ── Ground bounce from below: the key light, reflected by the ground under the cloud ──
            vec3 bounceS = keyCol * max(dot(up, keyDir), 0.0) * 0.15 * cv2.look2.x
                         * (1.0 - f.hf) * (1.0 - f.hf);

            // ── Night: city up-light, beams ──
            vec3 nightS = vec3(0.0);
            if (dayness < 0.9) {
                if (f.hf < 0.45) {
                    vec3  dE  = p.dirE;
                    vec2  uv  = vec2((atan(dE.y, dE.x) + PI) / (2.0 * PI), (0.5 * PI - asin(clamp(dE.z, -1.0, 1.0))) / PI);
                    vec3  cr  = textureLod(earthNightTex, uv, 3.0).rgb;
                    float lum = dot(cr, vec3(0.2126, 0.7152, 0.0722));
                    nightS += (cr / max(lum, 0.001)) * cityBrightness(lum) * smoothstep(0.45, 0.0, f.hf)
                            * (1.0 - dayness) * kCityUpwellStrength * cloud.ambientGain;
                }
                nightS += beamCloudLighting(pW, p.h, dir, eye, dayness);
            }

            vec3  S     = keyS + ambS + bounceS + nightS;
            float Tstep = exp(-f.sigma * stepF);
            float w     = T * (1.0 - Tstep);
            L    += w * S;
            wAcc += w;
            dAcc += w * t;
            T    *= Tstep;
            if (tHalf < 0.0 && T < 0.5) tHalf = t;
            t += stepF;
        }
        if (iters >= kMaxIters && t < tEnd) remLen += tEnd - t;
    }

    // What the budget left unmarched (long horizon rays through a broken field) is filled with the
    // path's mean extinction and the cloud's mean colour so far, instead of being left transparent:
    // a ray that ran out used to draw the horizon through the clouds in front of it.
    if (remLen > 0.0 && T > 0.01 && wAcc > 1e-4 && pathLen > 0.0) {
        float Trem = exp(-odPath / pathLen * remLen);
        float w    = T * (1.0 - Trem);
        L    += w * (L / wAcc);
        dAcc += w * (dAcc / wAcc + remLen * 0.5);
        wAcc += w;
        T    *= Trem;
    }

    float meanT = (wAcc > 1e-4) ? dAcc / wAcc : 0.0;
    vec3  outRgb = vec3(0.0);
    if (wAcc > 1e-4) {
        // Aerial perspective between the eye and the cloud (v1's camPathInscatter, same physics),
        // integrated only over the part of the path inside the atmosphere: from orbit, uniform
        // steps from the eye spent almost all of themselves in vacuum and missed the dense air
        // just above the cloud, so clouds seen from space came out darker than the haze around them.
        vec2  tAtm = raySphere(eye, dir, R_ATMOS);
        float t0   = clamp(tAtm.x, 0.0, max(meanT, 0.001));
        vec3  e0   = eye + dir * t0;
        float span = max(meanT - t0, 0.001);
        vec2 odC  = optDepth(e0, dir, span);
        vec3 attn = exp(-(BETA_R * odC.x + BETA_M * 1.1 * odC.y));
        vec3 air  = vec3(0.0);
        {
            const int kAir = 8;
            float sg = span / float(kAir);
            float pR = phaseR(cosSun), pM = phaseM(cosSun);
            float oR = 0.0, oM = 0.0, aM = 0.0;
            vec3  aR = vec3(0.0);
            for (int i = 0; i < kAir; ++i) {
                vec3  ap = e0 + dir * ((float(i) + 0.5) * sg);
                float ah = max(0.0, length(ap) - R_EARTH);
                float dR = exp(-ah / H_R) * sg, dM = exp(-ah / H_M) * sg;
                oR += dR; oM += dM;
                vec2 tSE = raySphere(ap, sunDir, R_EARTH);
                if (tSE.x > 0.0 && tSE.y > 0.0) continue;
                vec2 tSun = raySphere(ap, sunDir, R_ATMOS);
                vec2 sOD  = (tSun.y > 0.0) ? optDepth(ap, sunDir, tSun.y) : vec2(0.0);
                vec3 at   = exp(-(BETA_R * (oR + sOD.x) + BETA_M * 1.1 * (oM + sOD.y)));
                aR += at * dR;
                aM += dot(at, vec3(1.0 / 3.0)) * dM;
            }
            air = SUN_INTENSITY * (pR * BETA_R * aR + vec3(pM * BETA_M * aM));
        }
        outRgb = attn * L + air * (1.0 - attn) * (1.0 - T);
    }

    // Debug views (cv2.shell.z): 1 = march iterations, 2 = transmittance, 3 = mean depth / 50 km,
    // 4 = the weather cube where the ray enters the shell (r coverage, g type, b precipitation).
    int dbg = int(cv2.shell.z + 0.5);
    if (dbg == 4 && nSeg > 0) {
        CV2Pos pe = cv2Pos(dir * seg[0].x, eyeH, enuToEcef);
        outRgb = textureLod(cv2WeatherTex, cv2WeatherDir(pe.dirE), 0.0).rgb * 0.05;
    }
    if (dbg == 1) outRgb = mix(vec3(0.0, 0.2, 1.0), vec3(1.0, 0.1, 0.0), float(iters) / float(kMaxIters)) * 0.05;
    else if (dbg == 2) outRgb = vec3(1.0 - T) * 0.05;
    else if (dbg == 3) outRgb = vec3(fract(meanT / 50000.0)) * 0.05;
    else if (dbg == 5) outRgb = vec3(1.0 - exp(-odRain), 0.0, (wAcc > 1e-4) ? 0.3 : 0.0) * 0.05;
    float Tout = (dbg != 0) ? 0.0 : T;

    imageStore(outColor, q, vec4(outRgb, Tout));
    imageStore(outDepth, q, vec4(meanT, (T < 0.1 && tHalf > 0.0) ? tHalf : -1.0, 0.0, 0.0));
}
