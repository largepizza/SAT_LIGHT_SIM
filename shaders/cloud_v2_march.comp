#version 450
#extension GL_EXT_control_flow_attributes : enable

// ── Clouds v2: the sparse march (.plans/CLOUDS_V2_PLAN.md, phases 1+2) ──────────────────────────
// Marches ONE pixel of every 2x2 block of the half-resolution cloud grid per frame (the pixel given
// by cv2.frame.zw, rotating over four frames); cloud_v2_resolve.comp fills in the rest from the
// reprojected history. Output per marched pixel:
//   outColor  rgb = cloud radiance after aerial perspective (the B of color*A + B), a = transmittance
//   outDepth  x = transmittance-weighted mean distance (0 = no cloud on this ray)
//             y = distance where transmittance fell below 0.5, if the ray ended < 0.1 (else -1) —
//                 the v1 `tCloudOcclude` meaning, which sat_sky.frag and the beam ray still read
//
// The march: the ray's in-shell segments (clouds_v2.glsl), steps growing with distance
// (march.x + march.y * t, capped), COARSE steps on the cheap field until it finds cloud, then a
// step back and FINE steps on the full field until several are empty. Interleaved-gradient-noise
// jitter on the start, different every frame, so the temporal resolve averages it away.
//
// Lighting per in-cloud sample: a short light march toward the Sun (the first two samples with
// detail — the lumps that make cauliflower), plus one long coarse sample for tall towers;
// two single-scattering lobes; multiple scattering as Wrenninge octaves; sky light from above
// (shape-aware: one cheap sample 250 m up); ground bounce from below; moon, city up-light and the
// Reflect-Orbital beam lights (the v1 list, tile cull and function) at night.

// The workgroup size is a specialization constant (ids 0/1, default 16 x 16; SatelliteSim::cv2MarchWg):
// it bounds the registers the driver may give a thread (65536 per SM / the group's threads), which is
// this shader's occupancy (perf sprint 2026-09-29).
layout(local_size_x_id = 0, local_size_y_id = 1, local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {        // == CloudMarchPC (cloud_march.comp)
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

