layout(set = 0, binding = 6) uniform sampler2D sceneDepthTex;   // half-res, metres (kNoSurfaceT = sky)
layout(set = 0, binding = 7) uniform sampler2D earthNightTex;
// x the observer's ground (scene_depth.comp); w written here: the rain rate at the eye (0..1), which
// the host reads a frame later for the rain ambience (terrainFrameMapped[3]).
layout(std430, set = 0, binding = 8) buffer TerrainFrame { vec4 terrainFrame; };
#define BEAM_CLOUD_LIGHTS_BINDING 9
#include "beam_cloud_lights.glsl"
// The Sun transmittance volume (cv2Stv, S3) and the flash list, written by cloud_v2_lightning.comp before this pass.
#define CV2_FLASH_BINDING 12
#define CV2_SUN_CASC_FN       // the STV / froxel lookups (need the cv2 UBO)
#include "cloud_lightning.glsl"
// The cloud density clipmap (2026-10-21, EXPERIMENT): coarse steps skip the field where it is known empty.
#define CV2_CDC_BINDING 23
#include "cv2_cdc.glsl"
// A high sheet's light from below (the ground bounce, 2026-10-24): the share of the UNSHADOWED Sun it takes, and the
// albedo below it (cloud tops), from ~4 to 9 km up. (Macros: a variant is compiled with -D to A/B them.)
#ifndef CV2_BOUNCE_OPEN
#define CV2_BOUNCE_OPEN 0.6
#endif
#ifndef CV2_BOUNCE_ALB_HIGH
#define CV2_BOUNCE_ALB_HIGH 0.3
#endif
const float kBounceOpen    = CV2_BOUNCE_OPEN;
// A FAINT sample (2026-10-26): its optical depth over the light march's length is under this. No light march and no sky
// probe (as thin ice): the Sun's shadow is read at the sample itself from the Sun transmittance volume (which holds every
// other cloud's shadow), the far side for the diffuse field is the column estimate, and the field is ~0 there anyway
// (cv2DiffuseField -> 0 as tau -> 0). From 6 km over a stratocumulus field the mid layer's faint haze made ~27 lit samples
// a ray (7M a frame, 9 field reads each): 20 of the cloud march's 26 ms, for a band at the horizon.
#ifndef CV2_FAINT_OD
#define CV2_FAINT_OD 0.02
#endif
// 0: a faint sample takes no light march at all (and no multiple scattering: with no optical depth toward the light it
// read as the lit face of a thick slab, and haze under a cumulus glowed); 1: a 2-step light march (the light LOD's), no far
// side, no sky probe saved.
#ifndef CV2_FAINT_MODE
#define CV2_FAINT_MODE 0
#endif
const float kBounceAlbHigh = CV2_BOUNCE_ALB_HIGH;
// The cloud droplets' Mie phase (2026-10-22, tools/make_mie_lut.py): 4 pi p(theta) / 8 per angle (x) and effective radius
// (y, cv2.mie.y), linear sRGB. A texel per 0.088 deg: the corona's rings, the cloudbow, the glory.
layout(set = 0, binding = 24) uniform sampler2D cv2MieTex;
vec3 cv2MiePhaseAt(float cosT)
{
    return 8.0 * textureLod(cv2MieTex, vec2(acos(clamp(cosT, -1.0, 1.0)) * (1.0 / PI), cv2.mie.y), 0.0).rgb;
}
layout(set = 0, binding = 10, rgba16f) uniform writeonly image2D outColor;
// Adaptive rate (misc.z = 3): pass A (this shader, kPassB = 0) marches the sparse grid, skipping the
// 32x32 tiles cloud_v2_tiles.comp listed in TileBuf (parallax past misc2.w px a frame, or history from off
// screen); pass B (kPassB = 1,
// dispatched indirectly, 4 workgroups per listed tile) marches those tiles at full rate into the full
// targets, and writes their sparse-grid samples too, so the quarter grid stays complete for the resolve.
layout(constant_id = 2) const int kPassB = 0;
layout(set = 0, binding = 16) uniform sampler2D prevResDepthTex;               // last frame's resolved depth (m)
layout(set = 0, binding = 17, rgba16f) uniform writeonly image2D outFullColor;
layout(set = 0, binding = 18, rg32f)   uniform writeonly image2D outFullDepth;
layout(std430, set = 0, binding = 19) buffer TileBuf { uint tPad, tDispX, tDispY, tDispZ; uint tList[4096]; uint tFlag[4096]; };
layout(std430, set = 0, binding = 15) readonly buffer BlueNoise { uint cv2BlueNoise[1024]; };   // 64x64, 8-bit ranks
layout(set = 0, binding = 14) uniform sampler2DArray cv2SunLutTex;   // layer 0 the Sun's colour, 1 the zenith sky's
layout(set = 0, binding = 11, rg32f)   uniform writeonly image2D outDepth;

const int N_LIGHT = 12;
vec2 optDepth(vec3 p, vec3 d, float segTotal) {
    float sLen = segTotal / float(N_LIGHT);
    float odR = 0.0, odM = 0.0;
    [[dont_unroll]] for (int i = 0; i < N_LIGHT; ++i) {
        float h = max(0.0, length(p + d * (float(i) + 0.5) * sLen) - R_EARTH);
        odR += exp(-h / H_R);
        odM += exp(-h / H_M);
    }
    return vec2(odR, odM) * sLen;
}

const float kCityUpwellStrength = 0.004;
const float kNightFloor         = 0.002;
const float kDustCityK          = 1.0;     // dust's share of the fog's city glow (review 20)
const float kCityCompressK      = 0.08;
float cityBrightness(float lum) { float raw = max(0.0, lum - kNightFloor); return raw / (raw + kCityCompressK); }

vec3 rayDirAt(vec2 texel, ivec2 size, float tanHalfFov, mat3 camToENU) {
    vec2 ndc = (texel / vec2(size)) * 2.0 - 1.0;
    return normalize(camToENU * vec3(ndc.x * tanHalfFov * pc.aspect, -ndc.y * tanHalfFov, -1.0));
}

float ign(vec2 p) { return fract(52.9829189 * fract(dot(p, vec2(0.06711056, 0.00583715)))); }

// The Sun's colour arriving at a point and the zenith sky's radiance there come from a table (cv2SunLutTex,
// include/cv2_sunlut.glsl, baked by cloud_v2_sunlut.comp where sunColorAt / skyZenithAt now live).

// Light-march geometry: nL EQUAL steps summing to light.x (2026-10-14; kLightRatio 1 = uniform). It was a geometric
// series at ratio 1.6: at 7 steps over 8 km, 186 m .. 3.1 km, and the last three steps (1.2 / 2.0 / 3.1 km) were each
// ONE point sample standing for kilometres of cloud. exp(-od) of such a sample is either ~1 (a gap) or ~0, and the
// history converges on the MEAN of exp(-od), which is far brighter than exp(-mean od) (Jensen): under a low Sun the
// clouds in another cloud's shadow settled 30-60 levels too bright against a 128-step reference
// (harness_runs/fb17/jitter: issue 20261013_214939 shot 1, 201800), and every frame's raw sample was the noise the
// history then had to average (raw std 26.5 -> 9.0 levels). Equal steps give the same 7 field reads the least
// variance; same cost, 128 registers. The near surface's self-shadow is read at 1.1 km steps instead of 186 m: no
// visible loss at the high-Sun view (bias vs the reference +0.4 levels).
const float kLightRatio = 1.0;
const vec3  kMoonColor  = vec3(0.92, 0.95, 1.0);
const float kCv2MoonMieCap = 40.0;   // the Mie table's 8 P past ~3 deg; see the key light's single scattering

// Optical depth from a cloud sample toward a light: the light march (the first two samples with
// detail — the lumps that make cauliflower) plus one long coarse sample, the far side of a tower;
// and the sky-light probe 250 m up (sigUp). ONE call site of cv2Field for all of them: the field is
// inlined at every call, and five copies of it in this shader (coarse, fine, light, far, probe) cost
// registers and instruction cache on every sample (perf sprint, 2026-09-29). wantLight = false runs
// the probe alone.
void lightAmbOD(vec3 rel, vec3 ldir, vec3 up, float eyeH, mat3 enuToEcef, int nL, float lSeg0,
                float jitter, float detailAmt, float fp, bool wantLight, out float od, out float sigUp,
                bool wantBeam, vec3 bdir, out float odBeam, bool lod, bool wantBack, out float odBack)
{
    od = 0.0; sigUp = 0.0; odBeam = 0.0; odBack = 0.0;
    CV2_CNT(7);
    float s = 0.0, lSeg = lSeg0, sb = 0.0, sg = 150.0;
    // The light samples read the field at a footprint of samp.w x the march's length ("Light march footprint",
    // 0.04 = 320 m of an 8-km march): a POINT sample standing for kilometres of path is in a cloud or in a gap, so
    // each view sample came back sunlit or black by chance, the grain on every lit / shadowed boundary (raw
    // frame-to-frame std 0.93 -> 0.6 levels, pixels past 4 levels 3.6% -> 0.3%, same mean). ONE footprint for every
    // call: a per-step one (the step's own length) put the march at 221-224 registers.
    float fpFar = max(fp, cv2.light.x * cv2.samp.w);
    // Light steps shorter than the pixel merge in PAIRS (2026-10-13): where the view sample's footprint is past
    // twice the first light step (from ~100 km of eye altitude at the defaults: a 1.1-km pixel at 388 km against
    // steps of 186 / 298 / 477 m ...), the field is read at that footprint's mip, and two steps inside it resample
    // the same texels. One sample then stands for each pair (7 steps -> 4 samples, the same lengths): orbit storm
    // 79 -> 65 ms at full rate, nothing below ~60 km, day cumulus within run-to-run noise. Anvil lids under a
    // grazing Sun read ~2 levels lighter, as they do with a 25-m view step; twelve light steps read darker
    // (harness_runs/perf13: the lid's brightness is the light march's own discretisation either way).
    // Not the old "Light LOD" (above): that put ONE sample on the last 7.5 km and drew grain.
    // (The threshold is the old geometric series' first step, 2 x 186 m at 7 steps over 8 km: with equal steps, 2 x
    // lSeg0 would keep orbit views from merging at all.)
    bool  lodN  = !lod && fp > 2.0 * cv2.light.x * 0.6 / max(pow(1.6, float(nL)) - 1.0, 1e-4);
    // k: [0, nL) the light march, nL its far sample, nL + 1 the sky probe, nL + 2..4 the beams, nL + 5..6 the march AWAY
    // from the light (the far side of the multiple-scattering slab, cv2DiffuseField: a quarter of cv2.ms.w, then the rest).
    for (int k = wantLight ? 0 : nL + 1; k <= (wantBack ? nL + 6 : wantBeam ? nL + 4 : nL + 1); ++k) {
        if (!wantBeam && k >= nL + 2 && k <= nL + 4) continue;
        // Jittered over the WHOLE segment: at +-25% of it the optical depth to the light came in
        // steps across a smooth surface, and the big smooth storm domes showed contour ripples (pass 13).
        // Light LOD: two steps spanning the same length (the loop's bounds stay uniform).
        if (lod && k >= 2 && k < nL) continue;
        if (lodN && k < nL && (k & 1) == 1) continue;
        // Each step at its OWN offset (golden-ratio steps from the shared jitter, 2026-10-14): one offset for all of them
        // moved every sample forward or back together, and their errors added (raw std 26.5 -> 18.8 levels alone).
        vec3  off = (k < nL) ? ldir * (s + ((lodN && k + 1 < nL) ? lSeg * (1.0 + kLightRatio) : lSeg) * fract(jitter + 0.6180340 * float(k)))
                  : (k == nL) ? ldir * (cv2.light.x * 1.6)
                  : (k == nL + 1) ? up * 250.0
                  : (k <= nL + 4) ? bdir * (sb + sg * 0.5)
                  : ldir * (-cv2.ms.w * ((k == nL + 5) ? 0.25 * fract(jitter + 0.3819660) : 0.25 + 0.75 * fract(jitter + 0.7639320)));
        // The view sample's footprint, not the step's: a longer footprint would turn the gaps
        // between cells into haze and shadow everything.
        // S2 ("cdc_light"): beyond the first two steps (which keep the detail: the lobes' self-shadow) and for the far
        // sample, the clipmap's mean light extinction over the cell where it is valid: optical depth conserved, no point
        // sample standing for hundreds of metres (the lit / shadowed grain).
        CV2Field lf;
        float mC;
        // (And the march away from the light, nL + 5..6: in a storm each field read there walks the towers and shields.)
        if (cv2.cdcC.x > 0.5 && ((k >= 2 && k <= nL) || k >= nL + 5)
            && cv2CdcMeanAt(rel + off, R_EARTH + eyeH,
                            (k < nL) ? ((lodN && k + 1 < nL) ? lSeg * (1.0 + kLightRatio) : lSeg)
                            : (k == nL) ? cv2.light.x * 0.8 : cv2.ms.w * ((k == nL + 5) ? 0.25 : 0.75), mC)) {
            lf.sigma = mC; lf.thin = 0.0; lf.soft = 0.0;
        } else
            lf = cv2Field(cv2Pos(rel + off, eyeH, enuToEcef), k < 2 ? detailAmt : 0.0, fpFar);
        CV2_CNT(k < nL ? 3 : k == nL ? 4 : k == nL + 1 ? 5 : 6);
        if (k < nL) {
            // Ice delta-scaled, and harder for the SHADOW (2026-09-30): what reaches a cloud below through a
            // cirrus veil includes the light its ice scatters within a few degrees (g ~0.8), so the direct
            // beam loses ~tau (1 - g), not tau (1 - 0.45). Real cirrus barely dims the clouds under it.
            // (This sample's length, a pair's under lodN. Written out at both uses: hoisted into one variable above the
            // field call, the march went to 220 registers.)
            float lS = (lodN && k + 1 < nL) ? lSeg * (1.0 + kLightRatio) : lSeg;
            od += lf.sigma * (1.0 - 0.8 * lf.thin - cv2.mid2.z * max(lf.soft, 0.0)) * lS;
            s += lS; lSeg = (lod && k == 0) ? cv2.light.x - lSeg : lSeg * (lodN ? kLightRatio * kLightRatio : kLightRatio);
        } else if (k == nL) {
            od += lf.sigma * (1.0 - cv2.mid2.z * max(lf.soft, 0.0)) * cv2.light.x * 0.8;
        } else if (k == nL + 1) {
            sigUp = lf.sigma;
        } else if (k <= nL + 4) {
            odBeam += lf.sigma * (1.0 - 0.45 * lf.thin) * sg;
            sb += sg; sg *= 3.0;
        } else {
            odBack += lf.sigma * (1.0 - 0.8 * lf.thin - cv2.mid2.z * max(lf.soft, 0.0)) * cv2.ms.w * ((k == nL + 5) ? 0.25 : 0.75);
        }
    }
}

// Multiple scattering as the DIFFUSE FIELD of a conservative delta-Eddington slab (2026-10-26). Most of a cloud's light has
// scattered many times, and that light builds up deep in a cloud and leaks out of every face: thick cores are bright, wisps
// and the parts near a surface are dark. The octaves below know only the depth toward the light, so every sunlit sample, a
// 50-m wisp or a 5-km tower, took the same multiple scattering: against a path-traced reference they lit thin cloud 4-13x too
// brightly and drew a front-lit cloud as a flat disc out to its rim.
//   The slab is the light's line through the sample: tauT the optical depth toward the light (the light march), tauB away
// from it (a short march, cv2.ms.w); its normal is along the light (mu0 = 1). Delta scaling moves the droplets' forward peak
// (f = g^2) into the beam: t = (1 - f) tau, g' = g / (1 + g). Eddington, I = I0 + mu I1, Marshak boundaries, in units of
// F / 4 pi (the march's phase functions have a mean of 1):
//   I1 = C1 - 3 e^-t,  I0 = 5 - (2/3) C1 - (1 - g') C1 t - 3 e^-t,  C1 = (5 - e^-t*) / ((1 - g') t* + 4/3).
// Toward the eye: I0 + a g mu I1 (mu = cosK) + the light the forward peak carried past the unscattered beam, scattered once more.
// Three corrections for a finite 3D cloud, fitted to the reference (a soft sphere, a hard one and a lumpy blob, lit from
// above, the front and behind, one gain for all): a = 0.3 (the field is nearly isotropic); x e^(-0.05 t) (light escapes
// sideways before it reaches the far side, which a slab holds in); x (1 - e^-(1 - f) tauV) (it leaks out of the face the eye
// looks at, hV: the march's bH, averaged over the sample's step). x 1.6: ~ the octaves' energy over a thick cloud at the defaults;
// the path-traced level is ~1.6x that (cv2.ms.z; tools/cloud_ms_reference.py).
float cv2DiffuseField(float tauT, float tauB, float hV, float cosK)
{
    float g  = cv2.ms.y, f = g * g, gp = g / (1.0 + g);
    float t  = (1.0 - f) * tauT, ts = t + (1.0 - f) * tauB;
    float et = exp(-t);
    float C1 = (5.0 - exp(-ts)) / ((1.0 - gp) * ts + 4.0 / 3.0);
    float I1 = C1 - 3.0 * et;
    float I0 = 5.0 - (2.0 / 3.0) * C1 - (1.0 - gp) * C1 * t - 3.0 * et;
    float J  = max(I0 + 0.3 * g * cosK * I1, 0.0) + (1.0 - f) * max(1.0 + 3.0 * gp * cosK, 0.0) * max(et - exp(-tauT), 0.0);
    return 1.6 * J * exp(-0.05 * t) * hV;
}

// Multiple scattering (Wrenninge octaves): each octave sees a fraction of the optical depth.
float msOctaves(float od)
{
    // "Multi-scatter octaves" (mid3.y, 2-8): with two, the light inside a cloud has two depths (od ~1 / a and
    // ~1 / a^2) and nothing between: raised until a grazing-lit top was bright, the second octave lit the whole
    // interior and the lobes' relief went flat white. A series at a = b ~ 0.5 falls off about as 1 / od.
    float ms = 0.0, a = 1.0, b = 1.0;
    int   n  = int(cv2.mid3.y);
    [[dont_unroll]] for (int k = 0; k < n; ++k) { a *= cv2.light.z; b *= cv2.light.w; ms += b * exp(-od * a); }
    return ms;
}


// ── Reflect-Orbital beams as LIGHT (.plans/BEAMS_V2_PLAN.md) ──────────────────────────────────────
// A beam is a column of sunlight a few km wide (the Sun's 0.53 deg spread over the mirror's range),
// reflected down from a satellite. It lights a cloud the way the Moon does — through the same light
// path, phase lobes and optics (a halo in ice, a "beam-bow" in rain opposite the satellite) — and it is
// visible in clear air only by what scatters it: air a little, aerosol (haze, dust) far more, so a
// shaft glows low down and in dusty air and fades above ~15 km. Both come from the tile's culled
// cloud-light list (one entry per cluster of converged beams).

// A beam's footprint across its axis: the Sun's limb-darkened disk (u = 0.6) seen in the mirror,
// radius R = the Sun's cone at this range, its edge blurred over the mirror's width. Normalised to a
// MEAN of 1 over the disk (peak 1.25). Until 2026-09-28 a Gaussian of sigma = the footprint, cut at
// 4 sigma: a glow ~4x too wide around a very bright core, ending in a hard circle ("blobby beams with
// sharp blob edges"), and every beam reached ~16x the area it lights (the cost).
// Pass 13: a soft dome, not the physical flat disk: 1 - smoothstep(0.25 R, 1.15 R), mean 1 over the
// unit disk's area (x 1.885, the same energy). The 2%-edged disk read as huge, hard-edged spotlights
// (user snap, 24 km up); the Sun's disk in a real mirror is blurred by the mirror's figure and the air.
// sat_sky.frag's ground spot uses the same profile.
float beamDisk(float d2, float R)
{
    return (1.0 - smoothstep(0.25 * R, 1.15 * R, sqrt(d2))) * 1.885;
}

// A beam's MEAN irradiance over its disk, in Suns: its reflecting area (intensity x beam.w) spread over
// the disk. A 55 m mirror at 600 km: ~1.4e-4 Sun (~60 full moons); dozens converge on one site.
float beamIrradiance(uint bli, float R)
{
    return beamLights[bli].intensity * cv2.beam.w / (PI * R * R);
}

// The beams' light at a cloud sample. The lights are summed first (irradiance, its mean direction and
// the cloud phase), then ONE occlusion march toward the satellites along that mean direction: the
// beams converged on a site come from within a few degrees of each other. The first cut marched
// three field samples PER BEAM: dozens of beams over a busy site cost dozens x 3 field evaluations
// per cloud sample (350 ms frames over Anchorage).
// Split in two around the occlusion march (it runs in lightAmbOD, the shader's one field call site for
// lighting): beamGather sums the lights, beamFinish shades with the optical depth marched along dirS.
bool beamGather(vec3 pW, float h, vec3 dir, vec3 eye, out float Esum, out vec3 dirSOut, out float phSum)
{
    Esum = 0.0; phSum = 0.0; dirSOut = vec3(0.0, 0.0, 1.0);
    if ((cloud.dbgDisableMask & 128u) != 0u || cv2.beam.z <= 0.0 || beamLightCount == 0u)
        return false;
    bool ovf = (sTileLightOverflow != 0u);
    uint n = ovf ? min(beamLightCount, kMaxCloudBeamLights) : min(sTileLightCount, kTileCloudLightMax);
    vec3  dSum = vec3(0.0);
    for (uint li = 0u; li < n; ++li) {
        uint  bli  = ovf ? li : sTileLightIdx[li];
        vec3  dirS = beamLights[bli].dirToSource;
        vec3  toP  = pW - (eye + beamLights[bli].posENU);
        vec3  perp = toP - dirS * dot(toP, dirS);
        float R    = max(beamLights[bli].footprintRadM, 100.0);
        float d2   = dot(perp, perp);
        if (d2 > R * R * (kBeamDiskCut * kBeamDiskCut)) continue;
        float E = beamIrradiance(bli, R) * beamDisk(d2, R)
                * mix(1.0, smoothstep(beamLights[bli].blockAltM - 500.0, beamLights[bli].blockAltM, h),
                      beamLights[bli].blockOpacity);
        if (E <= 0.0) continue;
        float cosB = dot(dir, dirS);
        Esum  += E;
        dSum  += E * dirS;
        phSum += E * (cv2.phase.y * cv2HG(cosB, cv2.phase.x) + cv2.phase.w * cv2HG(cosB, cv2.phase.z));
    }
    if (Esum <= 0.0) return false;
    dirSOut = normalize(dSum);
    return true;
}

// odMarch: the cloud between this sample and the satellites, three coarse steps up the beam (150, 450,
// 1350 m, lightAmbOD), with the depth to the column's top as a floor (a deck lit from above).
vec3 beamFinish(vec3 pW, float h, vec3 dir, CV2Field f, float dayness, float og, vec4 hab,
                float Esum, vec3 dirS, float phSum, float odMarch)
{
    float od;
    if (f.thin > 0.5) od = f.sigma * (1.0 - 0.45 * f.thin) * 400.0;
    else od = max(odMarch, 0.5 * f.sigma * max(f.topH - h, 0.0) / max(dot(normalize(pW), dirS), 0.15));
    float cosB = dot(dir, dirS);
    vec3  ph   = vec3(phSum / Esum);
    if (f.thin > 0.0)   // ice, delta-scaled (see the march)
        ph = mix(ph, vec3(cv2HG(cosB, 0.3)) + og * cv2IceOptics(dir, dirS, hab) / 0.55, f.thin);
    // Precipitation: rain (the bows opposite the satellites) or, where the shafts' air is below freezing (cv2.precip.w,
    // the march's liqR for the Sun and Moon), snow: broad lobes, a faint halo and sundogs around the satellites, no bow.
    // Until 2026-10-06 the beams lit every shaft as rain: a "satbow" in Antarctic snow at -23 C.
    if (f.rain > 0.0) {
        float liq = cv2.precip.w;
        vec3  phR = vec3(0.3 * cv2HG(cosB, 0.97) + 0.55 * cv2HG(cosB, 0.35));
        if (liq > 0.0) phR += og * liq * 0.5 * cv2RainOptics(dir, dirS);
        if (liq < 1.0) phR += og * (1.0 - liq) * (0.25 * cv2IceOptics(dir, dirS, vec4(0.2, 0.35, 0.0, 0.0))
                                                  + vec3(0.15 * cv2PillarOptics(dir, dirS)));
        ph = mix(ph, phR, f.rain);
    }
    float pMS = 0.85 * cv2HG(cosB, 0.2) + 0.15 * cv2HG(cosB, -0.4);
    return Esum * (ph * exp(-od) + pMS * msOctaves(od) * f.msBright)
         * SUN_INTENSITY * cv2.beam.z * vec3(1.0, 0.97, 0.92) * (1.0 - dayness);
}

// The cloud transmittance along this ray at distance t, from the march's checkpoints (where T fell
// below 0.8 / 0.5 / 0.2 / 0.05).
float cv2TAt(float t, vec4 tq)
{
    if (t < tq.x) return 1.0;
    if (t < tq.y) return mix(0.8, 0.5, clamp((t - tq.x) / max(tq.y - tq.x, 1.0), 0.0, 1.0));
    if (t < tq.z) return mix(0.5, 0.2, clamp((t - tq.y) / max(tq.z - tq.y, 1.0), 0.0, 1.0));
    if (t < tq.w) return mix(0.2, 0.05, clamp((t - tq.z) / max(tq.w - tq.z, 1.0), 0.0, 1.0));
    return 0.05;
}

// The air's density integrated along a straight segment from altitude h0 to h1 (length len), for a
// scale height H: exact for an altitude linear along the segment.
float beamColumn(float h0, float h1, float len, float H)
{
    float a = exp(-max(h0, 0.0) / H), c = exp(-max(h1, 0.0) / H);
    float dh = (h1 - h0) / H;
    return abs(dh) < 1e-3 ? len * 0.5 * (a + c) : len * (a - c) / dh;
}

// The shafts in clear air, per view ray: the stretch of the ray INSIDE each beam's column (a ray -
// cylinder intersection, clipped to the eye, the scene depth, the beam's ground point and ~60 km of
// altitude), times the air's and the aerosol's density integrated along that stretch, their phase at
// the angle to the beam (a bright aureole looking up a beam, faint from the side), the air's
// extinction to the eye and the cloud's transmittance there. The column's edge is widened to ~1.5
// pixel footprints (energy kept), so a beam narrower than a pixel is not a jagged line.
// The first cut evaluated everything at the closest point of the view ray to the beam's axis, with
// the chord 2 sqrt(R^2 - d^2) / sin(angle): standing INSIDE a beam, that chord and point depend only on
// the view angle, so the shaft turned with the camera like a billboard.
int gShaftHits = 0;   // debug view 8: beams this ray's interval found
vec3 beamShafts(vec3 eye, vec3 dir, float tMax, vec4 tq, vec3 sunDir, vec3 BETA_R, float BETA_M, float pixAng,
                out float tShaft)
{
    bool ovf = (sTileLightOverflow != 0u);
    uint n = ovf ? min(beamLightCount, kMaxCloudBeamLights) : min(sTileLightCount, kTileCloudLightMax);
    vec3 acc = vec3(0.0);
    float wT = 0.0, wSum = 0.0;
    for (uint li = 0u; li < n; ++li) {
        uint  bli = ovf ? li : sTileLightIdx[li];
        vec3  lp  = beamLights[bli].posENU;       // the beam's ground point, observer-relative
        vec3  S   = beamLights[bli].dirToSource;
        float R   = max(beamLights[bli].footprintRadM, 100.0);
        // Distance from the axis along the ray: |t a + c0|, a = dir - S b, c0 = -lp + S (lp . S).
        float b   = dot(dir, S);
        float eL  = dot(lp, S);
        vec3  a   = dir - S * b;
        vec3  c0  = -lp + S * eL;
        float A   = dot(a, a), B = dot(a, c0), C = dot(c0, c0);
        float tC  = (A > 1e-8) ? max(-B / A, 0.0) : 0.0;
        float d2  = (A > 1e-8) ? max(C - B * B / A, 0.0) : C;
        float Ro  = R + max(max(0.02 * R, 40.0), 1.5 * tC * pixAng);
        if (d2 > Ro * Ro) continue;
        float t0 = 0.0, t1 = tMax;
        if (A > 1e-8) {
            float hw = sqrt((Ro * Ro - d2) / A);
            t0 = max(-B / A - hw, 0.0);
            t1 = min(-B / A + hw, tMax);
        }
        // Above the ground point only (s = t b - eL >= 0), and below ~60 km of altitude.
        float sTop = 60000.0 / max(dot(S, normalize(eye + lp)), 0.1);
        if (b > 1e-6)       { t0 = max(t0, eL / b); t1 = min(t1, (sTop + eL) / b); }
        else if (b < -1e-6) { t1 = min(t1, eL / b); t0 = max(t0, (sTop + eL) / b); }
        else if (eL > 0.0) continue;
        t1 = min(t1, t0 + 80000.0);
        if (t1 <= t0) continue;
        ++gShaftHits;
        float h0  = length(eye + dir * t0) - R_EARTH;
        float h1  = length(eye + dir * t1) - R_EARTH;
        float tm  = 0.5 * (t0 + t1);
        vec3  X   = eye + dir * tm;
        float h   = length(X) - R_EARTH;
        float lit = mix(1.0, smoothstep(beamLights[bli].blockAltM - 500.0, beamLights[bli].blockAltM, h),
                        beamLights[bli].blockOpacity);
        float dayP = clamp((dot(normalize(X), sunDir) + 0.2) / 0.5, 0.0, 1.0);
        float len  = t1 - t0;
        vec3  sc   = BETA_R * beamColumn(h0, h1, len, H_R) * phaseR(b)
                   + vec3(BETA_M * cv2.beam.y * beamColumn(h0, h1, len, H_M) * phaseM(b));
        vec3  tAir = exp(-(BETA_R * (atmColumn(eye, dir, tm, H_R) * H_R)
                          + BETA_M * 1.1 * (atmColumn(eye, dir, tm, H_M) * H_M)));
        // (R / Ro)^2: the widened column carries the beam's own power.
        vec3 add = beamIrradiance(bli, R) * (R * R) / (Ro * Ro) * sc * lit * (1.0 - dayP) * tAir * cv2TAt(tm, tq);
        acc += add;
        float wl = dot(add, vec3(0.33));
        wT += wl * tm; wSum += wl;
    }
    tShaft = (wSum > 0.0) ? wT / wSum : 0.0;
    return acc * vec3(1.0, 0.97, 0.92) * SUN_INTENSITY * cv2.beam.x * cv2.beam.z;
}

void main()
{
    // cv2.misc.z, the rate: 0 sparse (one pixel per 2x2 block, written to the quarter-size top-left of
    // the targets); 1 full (every half-res pixel, in place); 2 half (a checkerboard alternating each
    // frame, in place: "Half rate while moving").
    int   rate     = int(cv2.misc.z + 0.5);
    bool  passB    = kPassB == 1;
    bool  passF    = kPassB == 2;          // smooth tiles (cloud_v2_tiles.comp kMode 1): a quarter of the sparse grid
    bool  full     = rate == 1 || passB;
    bool  halfR    = rate == 2 && !passB;
    ivec2 halfSize = ivec2(cv2.grid.xy);   // the cloud grid (S9: may be twice the scene depth's)
    ivec2 qSize    = full ? halfSize : halfR ? ivec2((halfSize.x + 1) / 2, halfSize.y) : (halfSize + 1) / 2;
    ivec2 q        = ivec2(gl_GlobalInvocationID.xy);
    ivec2 tileO    = ivec2(0);
    if (passB) {
        uint  tileId = tList[gl_WorkGroupID.x >> 2u], sub = gl_WorkGroupID.x & 3u;
        int   tilesX = (halfSize.x + 31) / 32;
        tileO = ivec2(int(tileId) % tilesX, int(tileId) / tilesX) * 32 + ivec2(int(sub & 1u), int(sub >> 1u)) * 16;
        q     = tileO + ivec2(gl_LocalInvocationID.xy);
    }
    // Pass F: four smooth tiles a workgroup, 64 threads each, one sparse-grid slot of each 2x2 (the phase steps every
    // four frames; the same slot and ray pass A would have taken there). The rest is cloud_v2_tiles.comp's fill.
    if (passF) {
        uint  slot = gl_WorkGroupID.x * 4u + (gl_LocalInvocationIndex >> 6u), li = gl_LocalInvocationIndex & 63u;
        int   ph   = (int(cv2.frame.x) >> 2) & 3;
        int   tilesX = (qSize.x + 15) / 16;
        uint  tileId = tList[min(slot, 4095u)];
        q = (slot < tPad) ? ivec2(int(tileId) % tilesX, int(tileId) / tilesX) * 16 + ivec2(int(li & 7u), int(li >> 3u)) * 2
                            + ivec2((ph == 1 || ph == 2) ? 1 : 0, (ph == 1 || ph == 3) ? 1 : 0)
                          : qSize;
    }
    ivec2 pix      = full ? min(q, halfSize - 1)
                   : halfR ? min(ivec2(q.x * 2 + ((q.y + int(cv2.frame.x)) & 1), q.y), halfSize - 1)
                           : min(q * 2 + ivec2(cv2.frame.zw), halfSize - 1);
    ivec2 outPix   = halfR ? pix : q;

    float tanHalfFov = tan(pc.fovYRad * 0.5);
    mat3  camToENU   = mat3(transpose(pc.skyView));
    vec3  enuZ = normalize(pc.obsECEFDir.xyz);
    vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    vec3  enuY = cross(enuZ, enuX);
    mat3  enuToEcef = mat3(enuX, enuY, enuZ);
    float eyeH = terrainFrame.x + 2.0;               // == observerPos(obsEffH).z - R_EARTH
    vec3  eye  = vec3(0.0, 0.0, R_EARTH + eyeH);
    vec3  sunDir = normalize(pc.sunDirENU.xyz);

    // Adaptive rate, pass A: a tile the classify pass (cloud_v2_tiles.comp) listed is pass B's. (The
    // vote used to be here: that code flipped this shader from 128 registers to ~224, +19%.)
    if (rate == 3 && !passB && tFlag[gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x] != 0u) return;
    // Smooth tiles (cv2.perf.w > 0, the full-res grid): pass F's.
    if (rate == 0 && cv2.perf.w > 0.0 && !passF && tFlag[gl_WorkGroupID.x + gl_WorkGroupID.y * gl_NumWorkGroups.x] == 2u) return;
    // Beam-light tile cull. This workgroup owns half-res pixels [wg*32, wg*32+32) (16 at full
    // rate); its cone is computed from those corners (the cull only needs an axis and a half-angle).
    {
        vec2 tile = vec2(gl_WorkGroupSize.xy) * (full ? vec2(1.0) : halfR ? vec2(2.0, 1.0) : vec2(2.0));
        vec2 tMin = passB ? vec2(tileO) : vec2(gl_WorkGroupID.xy) * tile, tMax = tMin + tile;
        if (passF) { tMin = vec2(0.0); tMax = vec2(halfSize); }   // (four tiles anywhere on screen: the whole view's cone)
        vec3 d00 = rayDirAt(tMin, halfSize, tanHalfFov, camToENU);
        vec3 d10 = rayDirAt(vec2(tMax.x, tMin.y), halfSize, tanHalfFov, camToENU);
        vec3 d01 = rayDirAt(vec2(tMin.x, tMax.y), halfSize, tanHalfFov, camToENU);
        vec3 d11 = rayDirAt(tMax, halfSize, tanHalfFov, camToENU);
        vec3 ax  = normalize(d00 + d10 + d01 + d11);
        float ch = min(min(dot(ax, d00), dot(ax, d10)), min(dot(ax, d01), dot(ax, d11)));
        // Up to 60 km, not the cloud shell's top: the shafts (beamShafts) reach that high, and a beam
        // seen above ~15 km was culled away in whole tiles.
        cullCloudLightsForTile(ax, acos(clamp(ch, -1.0, 1.0)), eye, R_EARTH + max(cv2.shell.y, 60000.0));
    }
    // (The rain rate at the eye for the host's rain ambience was written here into terrainFrame.w until review 22:
    // the host now reads the rain map around the eye, cloud_v2_lightning.comp, from the flash buffer.)
    if (q.x >= qSize.x || q.y >= qSize.y) return;
    CV2_CNT(0);

    // Review 13: the ray goes through a different point of its texel each visit (an R2 sequence,
    // offset per pixel), so the history integrates the texel's footprint: a ray fixed at the centre
    // drew far, thin clouds at the horizon as hard 2-3 texel stairs that no history could smooth.
    // Fast flight (no history) keeps the centre.
    vec2  subPx = vec2(0.5);
    if (cv2.misc2.z <= 0.5) {
        float vj = full ? cv2.frame.x : floor(cv2.frame.x * (halfR ? 0.5 : 0.25));
        vec2  h  = fract(vec2(ign(vec2(pix)), ign(vec2(pix) + vec2(47.0, 17.0))) + vj * vec2(0.8566749, 0.7338919));   // R4 with the two march jitters below
        subPx = h;
    }
    vec3  dir    = rayDirAt(vec2(pix) + subPx, halfSize, tanHalfFov, camToENU);
    float tScene = texelFetch(sceneDepthTex, pix >> int(cv2.grid.z), 0).r;
    // S9: on the full-res grid the depth is the half-res texel's, traced through its centre, half a full-res pixel
    // off this ray. Near the limb from orbit the ground's distance changes by tens of km over that half pixel, so
    // every ray of one row parity (the even rows: higher) stopped at the lower ray's ground, short of the cloud: whole
    // cloud systems vanished on the frames sampling those rows (period-2 flicker in motion, the "lost far masses";
    // issue 20261022_210358, harness_runs/rc1022e: held at an even row the mass never showed). Corrected by the
    // parallax between the two rays on the sphere through the depth's own hit (exact for flat ground at any height),
    // bounded so a ridge silhouette bleeds at most a quarter of its distance on the half pixel it straddles.
    if (cv2.grid.z > 0.5 && tScene < 0.5 * kNoSurfaceT) {
        vec3  dD = rayDirAt((vec2(pix >> int(cv2.grid.z)) + 0.5) * exp2(cv2.grid.z), halfSize, tanHalfFov, camToENU);
        float rS = length(eye + dD * tScene);
        if (rS < eye.z - 1.0) {
            float sD = raySphere(eye, dD, rS).x, sO = raySphere(eye, dir, rS).x;
            if (sD > 0.0) tScene += sO > 0.0 ? clamp(sO - sD, -0.25 * tScene, 0.25 * tScene) : 0.25 * tScene;
        }
    }

    vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
    float BETA_M = BETA_M_BASE * cloud.atmosMieGain;

    vec2 seg[2];
    int  nSeg = cv2ShellSegments(eye, dir, seg[0], seg[1]);

    // Knockout 32768 (volumetric cloud march) also covers v2.
    if ((cloud.dbgDisableMask & 32768u) != 0u || cv2.look.x <= 0.0) nSeg = 0;

    float cosSun = dot(dir, sunDir);
    // "Silver lining" (cu2.z): sunlight scattered FORWARD through thin cloud: the droplets' narrow peak (g ~0.92) plus
    // a wider lobe (g 0.8: a few forward scatterings), attenuated at 0.3 of the optical depth toward the Sun (forward
    // scattering is not loss). The rim of a cloud in front of the Sun glows, and light leaks through its thin parts.
    // The first cut was the narrow peak alone at full extinction: 0 -> 3 moved a backlit rim by ~6 levels (the
    // user: "does nothing", issue 20261013_181252).
    // (Water cloud only: on the mid layer's sheets and the ice veils, which lie across the Sun over tens of degrees,
    // it was a blown-out glare many times the Sun's own.)
    float phSilvS = cv2.cu2.z * (0.12 * cv2HG(cosSun, 0.92) + 0.5 * cv2HG(cosSun, 0.8));
    float phSS   = cv2.phase.y * cv2HG(cosSun, cv2.phase.x) + cv2.phase.w * cv2HG(cosSun, cv2.phase.z);
    float phMS   = 0.85 * cv2HG(cosSun, 0.2) + 0.15 * cv2HG(cosSun, -0.4);
    vec3  moonDir  = normalize(pc.moonDirENU.xyz);
    float cosMoon  = dot(dir, moonDir);
    float phMoonSS = cv2.phase.y * cv2HG(cosMoon, cv2.phase.x) + cv2.phase.w * cv2HG(cosMoon, cv2.phase.z);
    float phMoonMS = 0.85 * cv2HG(cosMoon, 0.2) + 0.15 * cv2HG(cosMoon, -0.4);
    float phSilvM  = cv2.cu2.z * (0.12 * cv2HG(cosMoon, 0.92) + 0.5 * cv2HG(cosMoon, 0.8));
    // Per-ray phases of ice (the high layer: a forward lobe + halos, sundogs, parhelic circle,
    // circumzenithal arc) and rain (a forward lobe + the bows), for either key light. Per RAY, so
    // the optics are as sharp as a pixel. (.plans/ATMOS_OPTICS_AND_STORMS.md)
    float og = cv2.rain.y;
    // Ice: a narrow forward (diffraction) peak on a broad, low lobe. One wide lobe (g 0.75) whited
    // out 30 degrees around the Sun and buried the 22 degree halo and the sundogs in it.
    // The optics are added at the ray's first ice sample, with that region's crystal habit
    // (cv2IceHabit: most cirrus shows no halo at all).
    // DELTA-SCALED (2026-09-28): the narrow forward peak (0.45 of the ice's scattering) is light that
    // carries on almost undeviated, so it is taken out of the extinction (sigma x (1 - 0.45 thin)) and
    // the phase is the broad lobe alone (renormalised; the optics / 0.55 likewise). Full extinction plus
    // the peak in the phase dimmed whatever lay behind the cirrus as if the peak were lost: from orbit
    // the high layer cut dark bands through the bright clouds under it.
    vec3  phIceSun   = vec3(cv2HG(cosSun, 0.3));
    vec3  phIceMoon  = vec3(cv2HG(cosMoon, 0.3));
    bool  iceHabitSet = og <= 0.0;
    vec4  habRay = vec4(0.0);                         // the region's crystal habit (beams reuse it)
    vec4  tq = vec4(1e30);                            // where T fell below 0.8 / 0.5 / 0.2 / 0.05
    // Rain: drops are millimetres, so their forward light is a diffraction spike well under a degree
    // wide plus a broad refracted lobe. One HG(0.8) (~20 deg) lit shafts toward the Sun as white walls.
    vec3  phRainSun  = vec3(0.3 * cv2HG(cosSun, 0.97) + 0.55 * cv2HG(cosSun, 0.35))
                     + og * 0.5 * cv2RainOptics(dir, sunDir);
    vec3  phRainMoon = vec3(0.3 * cv2HG(cosMoon, 0.97) + 0.55 * cv2HG(cosMoon, 0.35))
                     + og * 0.5 * cv2RainOptics(dir, moonDir);
    // SNOW shafts (review 5: "snow produces rainbows"): a bow needs liquid drops. Where the shafts'
    // air (~500 m above the ground; the eye's temperature, 6.5 C/km) is below freezing they are snow, and a snow shower
    // in sunshine shows no bow: its big aggregates scatter broadly, and the few plate crystals falling
    // with it give faint sundogs, a weak 22 degree halo and a pillar under a low Sun. Per ray (one
    // temperature for the view): the eye's rain lattice uses the same model (cv2.precip.x).
    // The shafts' air: 500 m over the GROUND under the eye (terrainFrame.y), not over sea level: on
    // the 3 km Antarctic plateau that was 2.5 km too low, warm enough for a rainbow (review 6).
    float liqR = smoothstep(-1.0, 3.0, cv2.precip.x + 0.0065 * (eyeH - terrainFrame.y - 500.0));
    if (liqR < 1.0) {
        vec4 habSnow = vec4(0.2, 0.35, 0.0, 0.0);
        [[dont_unroll]] for (int li = 0; li < 2; ++li) {
            vec3  sL  = (li == 0) ? sunDir : moonDir;
            float cS  = (li == 0) ? cosSun : cosMoon;
            vec3  phS = vec3(0.3 * cv2HG(cS, 0.97) + 0.55 * cv2HG(cS, 0.35))
                      + og * (0.25 * cv2IceOptics(dir, sL, habSnow) + 0.15 * cv2PillarOptics(dir, sL));
            if (li == 0) phRainSun = mix(phS, phRainSun, liqR); else phRainMoon = mix(phS, phRainMoon, liqR);
        }
    }
    vec3  moonKey  = kMoonColor * pc.moonDirENU.w * cloud.moonGain * cv2.misc.y;

    int   nL    = int(cv2.light.y);
    float lSeg0 = cv2.light.x / float(max(nL, 1));   // equal steps (kLightRatio 1)

    // Spatially IGN, temporally a golden-ratio sequence per pixel: IGN alone, read on one pixel of
    // each 2x2 block per frame, is correlated between neighbours and left a screen-door pattern.
    // The sequence advances per VISIT of this pixel, not per frame: a sparse pixel is marched every
    // fourth frame, and 4 x 0.618 stepped the offset by ~0.47 per visit, so each pixel of a 2x2
    // block sat on its own two clusters of offsets for hundreds of frames. Each slot kept its own
    // sampling bias, and far clouds (long steps) broke into 2x2 squares.
    float visit  = full ? cv2.frame.x : floor(cv2.frame.x * (halfR ? 0.5 : 0.25));
    float jitter = fract(ign(vec2(pix)) + 0.6287067 * visit);
    // Any eye motion (> 1 m a frame; > 150 m until review 7, when a slow strafe's moving history weight
    // showed IGN as a dotted honeycomb on lit tops). Fast flight: no history to average IGN's
    // structure away, and its smooth diagonal gradient kept neighbouring rays in step, so the march's
    // steps lined up into bands across every cloud top (corduroy, "clouds lose their form"). Blue noise
    // (a 64x64 void-and-cluster tile, a golden-ratio step per frame) leaves only fine grain, at the high
    // frequencies the resolve's 3x3 motion filter removes; white noise left clumps.
    // Review 8: blue noise always, the golden step per VISIT (as IGN's): in a still view the history's
    // residual of IGN (weight 0.15, ~13 visits) is its regular structure, a fine crosshatch over every cloud.
    {
        uint  bi = uint(pix.x & 63) + 64u * uint(pix.y & 63);
        float bn = (float((cv2BlueNoise[bi >> 2u] >> (8u * (bi & 3u))) & 0xFFu) + 0.5) / 256.0;
        // 2026-10-13: the four per-visit offsets (the ray's sub-texel point x 2, this start jitter, the light march's jL)
        // step by the four R4 constants (1 / phi4^k, phi4 = 1.16730398). They were (0.7549, 0.5698), 0.618 and 0.7549:
        // the light jitter and the sub-texel x advanced by the SAME step, i.e. stayed locked together for ever, and
        // on a sloping surface the sub-texel point is the surface's depth phase. The light a smooth, dense surface
        // received then depended on its slope in every pixel the same way (part of the fringes on anvil heads; the
        // rings themselves were the coarse lattice, below).
        jitter = fract(bn + 0.6287067 * (cv2.misc2.z > 0.5 ? cv2.frame.x : visit));
    }
    // Review 22: the fine lattice's own jitter, decorrelated from the coarse one (fract(1.618 jitter + 0.5)). The fine
    // lattice restarts a fraction of a step behind where the coarse lattice found cloud, and the coarse lattice is
    // offset by `jitter` x the BASE step only: with the same `jitter` for both, the fine samples' phase within a
    // (grown) step covered part of the step twice and the rest once, so the converged cloud kept a bias that
    // depended on the lattice — concentric rings carved into the clouds round the nadir, moving with the eye's
    // height (user snap 8; changing "Step base" by 30% moved +-16-level bands across every cloud).
    // (A function of `jitter`, computed where it is used: a second blue-noise read kept live across the loop
    // flipped the march to ~222 registers.)
    // Angular size of one half-res pixel: a sample at distance t stands for t * pixAng metres.
    float pixAng = 2.0 * tanHalfFov / float(halfSize.y);

    vec3  L = vec3(0.0);
    float T = 1.0;
    // T where the ray entered the cloud it is in now (-1 after an empty step): the lighting's view depth is measured from
    // there (cv2DiffuseField's leak through the face the eye looks at). From the eye, a ray that crossed one lobe, a gap
    // and then the next lobe's face took that face for the inside of a cloud: bright veins along every lobe's outline on
    // cloud bases.
    float Tent = -1.0;
    float dAcc = 0.0, wAcc = 0.0, tHalf = -1.0;
    float odRain = 0.0;                               // debug view 5
    vec4  odLayer = vec4(0.0);                        // debug view 7: low, mid, anvil, high
    bool  dbgLayers = int(cv2.shell.z + 0.5) == 7;

    vec3  sunCol = vec3(0.0), skyZen = vec3(0.0), skyUpH = vec3(0.0), skyDnH = vec3(0.0);

    int   iters = 0;
    // The batch (below): each kept sample's field, distance, the transmittance in front of it, the map's cover
    // under thin ice and its weight in the ray's light.
    const int kBatch = 32;
    int   nB = 0;
    CV2Field bF[kBatch];
    float bT[kBatch], bTr[kBatch], bCov[kBatch], bW[kBatch], bH[kBatch];
    int   kMaxIters = int(cv2.misc.x);
    float pathLen = 0.0, odPath = 0.0, remLen = 0.0;   // for filling what the budget leaves
    // The distance limit is measured from where the ray enters the shell, not from the eye: from
    // orbit the Earth itself is further than the limit, and the far half of the clouds was cut off.
    float tLimit = seg[0].x + cv2.march.w;
    for (int si = 0; si < nSeg; ++si) {
        float t    = seg[si].x;
        float tEnd = min(min(seg[si].y, tScene), tLimit);
        if (t >= tEnd) continue;
        if (iters >= kMaxIters) { remLen += tEnd - t; continue; }
        bool fine = false;
        int  empty = 0;
        // Surface refinement (2026-10-10, below): the last fine sample that was not opaque over a step, the
        // opaque one found after it, and the bisections left (-1 = accept the next sample).
        float tLo = -1.0, tHi = 0.0;
        int   refN = 0;
        // Review 22: over the whole COARSE interval (two steps). Over one step the coarse lattice, two steps apart
        // (up to 400 m of altitude), took only half its phases: a thin deck seen from above was skipped at some
        // and found at others — concentric rings in the clouds round the nadir that moved with the eye's height
        // (user snap 8). Steps grow linearly with distance, so the offset keeps its share of the spacing.
        t += 2.0 * (cv2.march.x + cv2.march.y * (t - seg[0].x)) * jitter;
        // DENSITY FIRST, THEN LIGHT, in batches of kBatch samples (2026-10-13). The loop below walks the ray on the
        // field alone (coarse steps, the fine lattice, the surface refinement, the transmittance) and keeps each
        // sample that has cloud; the loop after it lights the kept samples (the light march: nine more field
        // evaluations each). The samples, their order and their weights are what they were: the image is the same
        // within run-to-run noise at ten views (harness_runs/perf13).
        // WHY: a group of rays (32 on this GPU) executes in lockstep, so an iteration costs what its most
        // expensive ray costs. In one loop, a ray stepping through empty air (one field evaluation) waited out
        // the light march of every neighbour that was in cloud, and advanced ONE step per ~ten evaluations: the
        // march's time was (the longest ray's steps) x (a lit sample's cost), whatever the others did. Now the
        // empty steps cost one evaluation each for the whole group, and the light march runs only for samples
        // that need it. Cloud march at 1920x1009: cumulus from 6 km 15.1 -> 9.3 ms, anvils at sunset 13.9 -> 9.1,
        // 58 km 32.6 -> 21.7, orbit storm 54.3 -> 38.7, under a snowing storm 13.0 -> 10.5; 128 registers.
        // Batches of 4 gained nothing from orbit, 16 most of it, 24-64 the same: 32. (One sample per batch --
        // "search, then light" -- was slower on overcast: every lit ray waited on the slowest search each time.)
        do {
        nB = 0;
        [[dont_unroll]] while (t < tEnd && iters < kMaxIters && T > 0.01 && nB < kBatch) {
            ++iters;
            // Steps grow with distance (the noise is read at the pixel footprint there anyway, so
            // shorter steps would only resample the same mip). 0.6% growth ran a horizon ray out of
            // its budget ~50 km out, and a broken field there came out half transparent. Measured
            // from the shell entry, like the limit (from orbit the eye is hundreds of km away).
            float tr    = t - seg[0].x;
            float stepF = min(cv2.march.x + cv2.march.y * tr, max(cv2.march.z, tr * 0.012));
            // ...and at most kMaxVertStep of altitude per step, measured against the vertical AT
            // THE SAMPLE (not the observer's). From orbit a distance-grown step crossed a 900 m
            // stratus deck in one stride and drew it as scattered dots.
            const float kMaxVertStep = 200.0;
            float dzS = dot(dir, normalize(eye + dir * t));
            float dz  = abs(dzS);
            stepF = min(stepF, kMaxVertStep / max(dz, 0.01));
            vec3  rel   = dir * t;
            CV2Pos p    = cv2Pos(rel, eyeH, enuToEcef);
            float fp = t * pixAng * cv2.motion.w; // LOD at the 100%-scale pixel (motion.w)
            float detailAmt = 1.0 - smoothstep(cv2.shell.w, cv2.shell.w * 4.0, t);
            // One call for the coarse (no erosion, the upper bound) and the fine sample.
            // Known-empty air (the clipmap, EXPERIMENT): the coarse step's stride without the field.
            if (!fine && cv2.cdcA.w > 0.5 && t > cv2.cdcC.z && cv2CdcEmpty(rel, R_EARTH + eyeH)) {
                CV2_CNT(15);
#ifdef CV2_EVAL_COUNT
                // Conservativeness check: what the skipped step would have read ([18] misses, [19] their optical depth x 1e4).
                CV2Field fm = cv2Field(p, -1.0, fp);
                if (fm.sigma > 0.0) {
                    CV2_CNT(18); atomicAdd(cv2EvalCount[19], uint(fm.sigma * stepF * 1e4 + 0.5));
                    CV2_CNT(20 + min(cv2CdcLevel(rel, R_EARTH + eyeH), 7));   // [20..27] misses by level
                    if (fm.sigma * stepF > 0.1) CV2_CNT(28);                 // [28] misses with od > 0.1 over the step
                }
#endif
                float cj = 2.0 * stepF * (0.75 + 0.5 * fract(jitter + 0.6180340 * float(iters)));
                t += cj; pathLen += cj;
                continue;
            }
            gCv2DbgWant = dbgLayers && fine;
            gCv2Stretch = 1.0 / max(dz, 0.25);
            CV2Field f = cv2Field(p, fine ? detailAmt : -1.0, fp);
            CV2_CNT(fine ? 2 : 1);
            gCv2DbgWant = false;
            // The thin ice's bounce light (below) reads the map where the field did. Its flow is still in
            // gCv2FlowD (cv2Field sets it; cv2FlowWeatherDirAt ignores its second argument): recomputing the
            // eight waves per cirrus sample was ~2 ms of a view from inside the high layer (2026-10-04, 11 km).
            float covB = 0.0;
            if (f.thin > 0.0) {
                vec3 wdB = cv2Drift(p.dirE);
                covB = clamp((textureLod(cv2WeatherTex, cv2FlowWeatherDir(wdB, gCv2FlowD), CV2_WX_LOD(2.0)).r * cv2.look.x - cv2.cover.x)
                             / max(cv2.cover.y - cv2.cover.x, 1e-3), 0.0, 1.0);
            }
            // Thin ice alone (the cirrus veil, lit without a light march): shaded at the coarse step
            // itself, as one sample of two steps, instead of dropping into fine steps. The high layer
            // spans the sky and its fine steps were a large share of the march from altitude (perf
            // sprint 2026-09-29). Its density has no erosion, so the coarse read is its fine one.
            // Review 22: rain alone (the shafts below a base) likewise: a near-uniform medium with weak structure.
            // Its fine steps were ~70% of the march standing under a storm (record 10: 22 -> 6.5 ms without rain).
            bool coarseThin = !fine && f.sigma > 0.0 && (f.thin > 0.9 || f.rain > 0.9);
            if (!fine && !coarseThin) {
                // Back two steps and on to a JITTERED fine lattice: the start jitter covers only the
                // first (shortest) step, so without this every fine sample sat on the coarse grid and
                // a flat, sharp deck top drew contour rings around the nadir.
                // Backing up past the segment start restarts it jittered: clamped to the start itself,
                // every ray from INSIDE a cloud or rain (the first sample already dense) stepped the same
                // lattice from the eye — contour rings of the cloud base looking up through rain (review 3,
                // snapshot 5).
                if (f.sigma > 0.0) {
                    fine = true; empty = 0; tLo = -1.0; refN = 0;
                    float tb = t - (2.0 - fract(jitter * 1.6180340 + 0.5)) * stepF;
                    t = tb > seg[si].x ? tb : seg[si].x + jitter * cv2.march.x;
                    continue;
                }
                // Each coarse stride is 1.5-2.5 steps (2 on average), by a per-step golden sequence off the ray's
                // jitter (2026-10-13). On a lattice offset once at the segment's start, the depth at which a ray's
                // first samples met a smooth, dense surface still followed the surface's height with the lattice's
                // period -- whatever the start jitter's sequence, white noise included -- and so did the light
                // they got: evenly spaced contour rings on every anvil head and tower wall (the "wood grain", open
                // since pass 14; user issue 20261012_235712 shot 6). A stride of its own length per step turns the
                // lattice into a random walk within a few steps of the entry.
                Tent = -1.0;
                { float cj = 2.0 * stepF * (0.75 + 0.5 * fract(jitter + 0.6180340 * float(iters)));
                  t += cj; pathLen += cj; }
                continue;
            }
            // Rain alone (a shaft below a base) stands for FOUR steps (2026-10-04): each rain sample runs a light march,
            // and every light step evaluates the whole field, towers included. Under a snowing storm at night (user
            // snapshot, Dushanbe) the shafts were ~14 of 40 ms of cloud march; x4 saved 13 ms there and 1.5 ms in the
            // review-22 daytime storm, where a shaft's edge reads ~3 levels brighter (a step carries its density a
            // little past the edge).
            float rK = (coarseThin && f.rain > 0.9) ? 4.0 : 2.0;
            if (coarseThin) pathLen += rK * stepF;
            else {
                // Surface refinement (2026-10-10): far from the eye a step is hundreds of metres (1.2% of the
                // distance) and a dense cloud's lit skin tens: the first sample inside a tower landed at a random
                // depth under its surface, so each ray came back sunlit or self-shadowed by chance -- the grain
                // "grid" on distant anvils that the history never averaged out, and ~17% too dark on average
                // against a 25-m-step reference (user snaps 3-4). When a sample is opaque over its step (sigma x
                // step >= 1) and the one before it was not, the crossing is bisected three times (unlit field
                // reads, to 1/8 step ~ a pixel's footprint) and the sample shaded is the bracket's inner end.
                // Only where a step is well past the base step (from ~7-14 km at the defaults, dithered so the
                // switch is no line): near the eye the steps are already skin-sized, and refining every lump of
                // a close cumulus field cost 3.4 ms looking down into one for no visible gain.
                // Tried: two bisections for the shorter steps (a hard-edged darker oval on the tower where they
                // gave way to three), and shading where the view ray's optical depth reaches ~0.7 from the
                // density's slope across the bracket (corduroy stripes, and 222 registers).
                float tauS = f.sigma * stepF;
                if (refN > 0) {
                    if (tauS >= 1.0) tHi = t; else tLo = t;
                    if (--refN > 0) { t = 0.5 * (tLo + tHi); continue; }
                    if (tauS < 1.0) { refN = -1; t = tHi; continue; }
                } else if (refN < 0) {
                    refN = 0;
                } else if (tauS >= 1.0 && tLo >= 0.0 && T > 0.1 && stepF > (2.0 + 1.5 * jitter) * cv2.march.x) {
                    tHi = t; refN = 3; t = 0.5 * (tLo + tHi);
                    continue;
                }
                tLo = (tauS < 1.0) ? t : -1.0;
                pathLen += stepF;
                if (f.sigma <= 0.0) {
                    if (++empty > 5) fine = false;
                    Tent = -1.0;
                    t += stepF;
                    continue;
                }
                empty = 0;
            }
            // Ice: the forward peak is not extinction (delta scaling, see phIceSun).
            f.sigma *= 1.0 - 0.45 * f.thin;
            // Soft contact with the ground: the last few pixel footprints before the surface thin out.
            // The march stops at the half-res scene depth, so a dense cloud meeting a slope ended on a
            // hard line that the half-res grid stair-stepped (and real cloud thins against the ground).
            if (tScene < kNoSurfaceT)
                f.sigma *= smoothstep(0.0, clamp(3.0 * fp, 40.0, 600.0), tScene - t);
            odPath += f.sigma * stepF;
            odRain += f.sigma * f.rain * stepF;
            if (dbgLayers) odLayer += gCv2Dbg * stepF * T;   // low, mid, anvil + Cb columns, high

            // Thin ice (the cirrus veil): one sample stands for two steps — where a pixel spans > 60 m (the
            // perf win is from altitude). Near the eye, inside or just above the layer (review 9: 9 km at
            // 62 N), two-step samples caught its fibres on some frames and missed them on others: crisp
            // flickering specks over the low clouds' edges.
            float stepW = ((f.thin > 0.9 && fp > 60.0) || (f.rain > 0.9 && !fine)) ? rK * stepF : stepF;
            // "Near cirrus stride" (perf.x, 2026-10-24; 1 = off): with the eye inside the high layer every ray runs through
            // its soft haze (cv2HighSigma's nearK) in ~60-120 m steps, each a field evaluation and a lit sample: two thirds
            // of the cloud march under an anvil at 12.4 km (issue 20261023_230322). There a pure thin-ice sample stands for
            // perf.x steps. Opt-in: a dense cloud starting inside the stride is entered up to ~2 steps late.
            if (f.thin > 0.9 && !fine && fp < cv2.perf.y) stepW = max(stepW, cv2.perf.x * stepF);
            float Tstep = exp(-f.sigma * stepW);
            float w     = T * (1.0 - Tstep);
            // Its light is added in the batch's second half, below.
            if (Tent < 0.0) Tent = T;
            // The multiple scattering's leak through the face the eye looks at (cv2DiffuseField): 1 - e^(-a x), x the view's
            // optical depth into this cloud, AVERAGED over the step as the step's light is (weight e^-x): a cloud's first
            // sample is often several optical depths thick, and taken at the step's start (x = 0) it got none at all.
            float aV = 1.0 - cv2.ms.y * cv2.ms.y, tS = f.sigma * stepW;
            float hV = 1.0 - pow(max(T / Tent, 1e-6), aV)
                       * (1.0 - exp(-(1.0 + aV) * tS)) / ((1.0 + aV) * max(1.0 - exp(-tS), 1e-6));
            bF[nB] = f; bT[nB] = t; bTr[nB] = T / Tent; bCov[nB] = covB; bW[nB] = w; bH[nB] = hV; ++nB;
            wAcc += w;
            dAcc += w * t;
            T    *= Tstep;
            if (tHalf < 0.0 && T < 0.5) tHalf = t;
            if (tq.x > 1e29 && T < 0.8)  tq.x = t;
            if (tq.y > 1e29 && T < 0.5)  tq.y = t;
            if (tq.z > 1e29 && T < 0.2)  tq.z = t;
            if (tq.w > 1e29 && T < 0.05) tq.w = t;
            t += stepW;
        }
        // The batch's light.
        [[dont_unroll]] for (int bj = 0; bj < nB; ++bj) {
            float t = bT[bj];                               // (these shadow the march's own: this sample's)
            float T = bTr[bj];                              // (within the cloud the ray is in: see Tent)
            CV2Field f = bF[bj];
            float covB = bCov[bj];
            vec3  rel = dir * t;
            CV2Pos p  = cv2Pos(rel, eyeH, enuToEcef);
            float fp  = t * pixAng * cv2.motion.w;
            float detailAmt = 1.0 - smoothstep(cv2.shell.w, cv2.shell.w * 4.0, t);
            vec3  pW   = eye + rel;                        // world point, ENU about the observer
            vec3  up   = normalize(pW);
            float sunUp = dot(up, sunDir);
            // The Sun's colour and the zenith sky's light at THIS sample, from the table (2026-10-13). They were a
            // per-ray cache at the two 800 m levels around the sample, recomputed at every level crossed and every
            // 25 km (pass 14: by distance alone a ray from inside the anvil lit the cumulus 10 km below with the
            // 12 km sunlight; pass 16: at fixed levels, or the colour stepped at another depth on every ray and
            // drew rings round the nadir). The table's rows are those levels.
            {
                vec3 uvL = vec3(cv2SunLutUV(sunUp, p.h), 0.0);
                sunCol = textureLod(cv2SunLutTex, uvL, 0.0).rgb;
                uvL.z  = 1.0;
                skyZen = textureLod(cv2SunLutTex, uvL, 0.0).rgb;
                // The hemispheres' mean radiance with multiple scattering (2026-10-26, cv2.amb.x; layers 2-3).
                if (cv2.amb.x > 0.5) {
                    uvL.z = 2.0; skyUpH = textureLod(cv2SunLutTex, uvL, 0.0).rgb;
                    uvL.z = 3.0; skyDnH = textureLod(cv2SunLutTex, uvL, 0.0).rgb;
                }
                // A solar eclipse: the sky light here, from the sunlit air around the point (eclipse.glsl).
                if (cloud.moonMisc.y > 0.5) {
                    vec3 eC = eclipseSkyLight(pW * 1e-3, sunDir, p.h);
                    skyZen *= eC; skyUpH *= eC; skyDnH *= eC;
                }
            }
            // Earth's shadow at THIS sample.
            float rP     = R_EARTH + p.h;
            float horizS = -sqrt(max(1.0 - (R_EARTH / rP) * (R_EARTH / rP), 0.0));
            float sunVis = smoothstep(horizS - 0.004, horizS + 0.004, sunUp);

            float dayness = clamp((sunUp + 0.2) / 0.5, 0.0, 1.0);
            float nightK  = 1.0 - min(dayness * 3.0, 1.0);

            // ── Key light: the Sun by day; at night the Moon, through the SAME light march. v1 and
            // the first v2 lit night cloud with a flat moon term: black bases, grey tops, no form. ──
            vec3  keyCol = vec3(0.0);
            vec3  keyDir = sunDir;
            float pSS = phSS, pMS = phMS, cosK = cosSun;
            bool  moonIsKey = false;
            if (sunVis > 0.0 && dot(sunCol, sunCol) > 0.0) {
                // Review 22: rain near the eye sees the Sun along about the eye's own path to it: x the eye's Sun
                // transmittance through the clouds (cloud.sunCloudT, 400 km), fading out by ~100 km. The light
                // march (2 steps for rain) misses a storm blocking a low Sun beyond its reach, and the rain's sharp
                // forward lobe drew the Sun's disc in the shafts under the storm (user snap 2).
                keyCol = sunCol * sunVis * cv2.look2.y
                       * mix(1.0, cloud.sunCloudT, f.rain * exp(-t / 100000.0));
                // A solar eclipse: the Moon's shadow on THIS sample's sunlight (eclipse.glsl; 2026-10-03). It was the
                // Sun the eye saw, on every cloud in view: no lit clouds beyond the umbra, no orange horizon.
                if (cloud.moonMisc.y > 0.5) keyCol *= eclipseSunVis((eye + rel) * 1e-3, sunDir, 0.0);
#ifdef CV2_SUN_REF
                // REFERENCE (S3 validation, compiled by hand with -DCV2_SUN_REF): the Sun's transmittance beyond where the
                // light march ends, marched through the field to the shell's top in fine growing steps (100 m + 1% of
                // the distance, a 50-m footprint), thin layers weighted as the bakes weight them. Slow; stills only.
                {
                    float lLr = 2.0 * cv2.light.x * (1.0 - f.thin);
                    float hTr = (f.thin > 0.5) ? (f.topH - p.h) * (1.0 - 0.5 / max(1.0 - f.hf, 0.15)) : 0.0;
                    vec3  oR  = rel + up * hTr + sunDir * lLr;
                    float odR = 0.0, sR = 0.0;
                    for (int i = 0; i < 600; ++i) {
                        float dsR = 100.0 + 0.01 * sR;
                        CV2Pos qR = cv2Pos(oR + sunDir * (sR + 0.5 * dsR), eyeH, enuToEcef);
                        if (qR.h > cv2.shell.y + 2500.0) break;
                        if (qR.h < -300.0) { odR = 1e4; break; }
                        CV2Field fR = cv2Field(qR, 0.0, 50.0);
                        odR += fR.sigma * max(1.0 - 0.8 * fR.thin - cv2.mid2.z * max(fR.soft, 0.0), 0.0) * mix(1.0, 0.15, clamp(fR.rain, 0.0, 1.0)) * dsR;
                        sR += dsR;
                    }
                    keyCol *= exp(-odR);
                }
#else
                // The Sun's shadow beyond the light march (S3, 2026-10-22): the Sun transmittance volume (cv2Stv, baked by
                // cloud_v2_lightning.comp), read where this sample's light march ENDS (~2 x cv2.light.x sunward) and half a
                // knot up (the knot holds the sample's own cloud). Thin ice is read at the MIDDLE of its layer (at a jittered
                // height in it a grazing Sun's shadow speckled). It replaced four structures that each covered part of the
                // range (the fine grid, the shaft rings, the cascade, the layer map; .plans/CLOUD_REBUILD_PLAN.md).
                if (cv2.stvH.z > 0.5) {
                    float hT = (f.thin > 0.5) ? (f.topH - p.h) * (1.0 - 0.5 / max(1.0 - f.hf, 0.15)) : 0.0;
                    float lL = (CV2_FAINT_MODE == 0 && f.sigma * cv2.light.x < CV2_FAINT_OD) ? 0.0 : 2.0 * cv2.light.x * (1.0 - f.thin);
                    keyCol *= cv2StvT(rel + up * hT + sunDir * lL,
                                      p.h + hT + dot(up, sunDir) * lL + 0.5 * (cv2.stvH.y - cv2.stvH.x) / float(kCv2StvK - 1));
                }
#endif
            } else if (nightK > 0.0) {
                float moonUp = dot(up, moonDir);
                keyCol = moonKey * nightK * smoothstep(-0.05, 0.1, moonUp);
                keyDir = moonDir; pSS = phMoonSS; pMS = phMoonMS; cosK = cosMoon; moonIsKey = true;
            }
            // The high layer is optically thin ice: a light march through it buys nothing, and it
            // spans the whole sky, so every sample there paid seven field evaluations. Its
            // self-shadow is its own density over a few hundred metres; its sky light is unoccluded.
            bool thin = f.thin > 0.5;
            // (Faint: see CV2_FAINT_OD. By the Sun only: the volume is the Sun's.)
            bool faint = !thin && !moonIsKey && f.sigma * cv2.light.x < CV2_FAINT_OD;
            if (f.thin > 0.0 && !iceHabitSet) {
                habRay = cv2IceHabit(p);
                phIceSun  += og * cv2IceOptics(dir, sunDir, habRay) / 0.55;
                phIceMoon += og * cv2IceOptics(dir, moonDir, habRay) / 0.55;
                iceHabitSet = true;
            }
            vec3 keyS = vec3(0.0);
            bool  wantL = dot(keyCol, keyCol) > 0.0;
            float odL = 0.0, sigUp = 0.0, odB = 0.0;
            float bE = 0.0, bPh = 0.0;
            vec3  bDir = vec3(0.0, 0.0, 1.0);
            bool  wantB = dayness < 0.9 && beamGather(pW, p.h, dir, eye, bE, bDir, bPh);
            // The optical depth away from the light (the slab's far side): marched (lightAmbOD) near; past a 150-m pixel (from
            // ~80 km up) the path to the column's base along the light (no field reads: the march cost 1.4 ms of an orbit view,
            // where no wisp is resolved).
            bool  wantBk = wantL && !thin && cv2.ms.x > 0.5 && fp < 150.0;
            float odBk = 0.0;
            // Light LOD (cv2.column3.y, "Light LOD footprint", m; 0 = off): a sample the ray sees
            // through little of (T < 0.5), or whose pixel footprint is past the setting, gets a 2-step
            // light march over the same length, its first step kept (the surface's self-shadowing):
            // ~10% of the march (perf sprint 2026-09-29).
            bool lodL = cv2.column3.y > 0.0 && nL > 2 && (T < 0.5 || fp > cv2.column3.y || f.rain > 0.9);
            // The light march's own jitter (review 16): it took the VIEW march's, so a sample's depth inside a
            // flat cloud top and its light steps' positions moved together, and their product did not average
            // out over the visits — contour rings round the nadir on the Cb heads' lids, at the view step's
            // period (4 light steps over 2.5 km). Another cell of the blue-noise tile, its own golden step.
            float jL;
            {
                uint  bj = uint((pix.x + 32) & 63) + 64u * uint((pix.y + 21) & 63);
                float vL = full ? cv2.frame.x : floor(cv2.frame.x * (halfR ? 0.5 : 0.25));
                jL = fract((float((cv2BlueNoise[bj >> 2u] >> (8u * (bj & 3u))) & 0xFFu) + 0.5) / 256.0
                           + 0.5385973 * (cv2.misc2.z > 0.5 ? cv2.frame.x : vL));
            }
            bool skipL = thin || (CV2_FAINT_MODE == 0 && faint && !wantB);
            if (!skipL)
                lightAmbOD(rel, keyDir, up, eyeH, enuToEcef, nL, lSeg0,
                           jL, detailAmt, fp, wantL, odL, sigUp, wantB, bDir, odB, lodL || faint, wantBk && !faint, odBk);
            if (!wantBk || skipL || faint) odBk = f.sigma * f.hf * max(f.topH - p.h, 0.0) / max(1.0 - f.hf, 0.05) / max(dot(up, keyDir), 0.1);
            if (wantL) {
                float od = thin ? f.sigma * 400.0 : odL;
                // A deck lit at a grazing angle is shadowed by the rest of the deck, tens of km
                // beyond the light march: the path to the deck's top along the light. Without it
                // a deck's interior was lit through a few km of cloud, and the whole band along the
                // terminator glowed red from orbit instead of fading to black.
                // Only the part of that path BEYOND the light march (which reads the real field over its
                // first ~2 x its length: the steps, then the far sample at 1.6x): within it the march has
                // already counted what is there. Taken over the whole path, the layer's nominal top a few
                // hundred metres above a lumpy top's actual surface became kilometres of cloud under a low
                // Sun (x 1 / sin 4 deg = 13.5): od ~15 where the march found ~1, every sunlit top grey-brown
                // (issue 20261013_193122: "There is direct sunlight on these clouds. They should be white").
                // (The mid layer's own sheet is the Sun transmittance volume's: its share leaves the term.)
                float deckK = f.deck * (1.0 - max(f.soft, 0.0));
                if (deckK > 0.0) {
                    float odDeck = f.sigma * max(max(f.topH - p.h, 0.0) / max(dot(up, keyDir), 0.03)
                                                 - 2.0 * cv2.light.x, 0.0);
                    od = max(od, odDeck * deckK * 0.5);
                }
                // ("Powder" darkened thin, sun-facing samples, a stand-in for the diffuse field's build-up: the old model's only.)
                float powder = (cv2.ms.x > 0.5) ? 1.0 : 1.0 - cv2.look2.z * exp(-f.sigma * 300.0) * (0.5 - 0.5 * cosK);
                vec3 pSSv = vec3(pSS);
                // "Mie optics" (mie.z): the tuned phase x the table's structure (its corona rings, cloudbow and glory
                // relative to its own smoothed shape), keeping the tuned energy. Applied to the TUNED share only
                // (issue round 2026-10-22): it multiplied the mix below, so the physical share's corona / bow / glory took
                // the structure a second time (x3.3 on the forward peak at 0.33).
                if (cv2.mie.z > 0.0)
                    pSSv *= mix(vec3(1.0), textureLod(cv2MieTex, vec2(acos(clamp(cosK, -1.0, 1.0)) * (1.0 / PI), cv2.mie.w), 0.0).rgb,
                                cv2.mie.z);
                // The droplets' Mie phase ("Mie phase", 2026-10-22): water cloud's single scattering from the Lorenz-Mie
                // table (forward diffraction peak, cloudbow, glory) in place of the two Henyey-Greenstein lobes.
                // For the MOON its diffraction peak is capped (kCv2MoonMieCap, the table's value ~3 deg out): moonlit cloud
                // carries the night view's ~2600x lift and the drawn Moon disc does not, so the aureole (physically a few %
                // of the disc's surface brightness) drew a bright blue disc over a crescent (issue 20261022_180130).
                if (cv2.mie.x > 0.0)
                    pSSv = mix(pSSv, min(cv2MiePhaseAt(cosK), vec3(moonIsKey ? kCv2MoonMieCap : 1e9)), cv2.mie.x);
                if (f.thin > 0.0 || f.rain > 0.0) {
                    pSSv = mix(pSSv, moonIsKey ? phIceMoon : phIceSun, f.thin);
                    pSSv = mix(pSSv, moonIsKey ? phRainMoon : phRainSun, f.rain);
                }
                float pSilv = (moonIsKey ? phSilvM : phSilvS) * (1.0 - f.thin) * (1.0 - f.rain) * (1.0 - abs(f.soft));
                // (Thin ice keeps the octaves: it has no light march, and its sheet is lit as it was tuned.)
                // (A faint sample without its light march has no optical depth toward the light: none of the diffuse field.)
                float msK = (cv2.ms.x > 0.5 && !thin)
                          ? (skipL ? 0.0 : cv2.ms.z * cv2DiffuseField(od, odBk, bH[bj], cosK)) : pMS * msOctaves(od);
                keyS = keyCol * powder * (pSSv * exp(-od) + pSilv * exp(-0.3 * od) + msK * f.msBright);
            }

            // ── Sky light from above, through the cloud above the sample, plus light from below. ──
            // Through the cloud: DIFFUSE transmission of its optical depth (two-stream, conservative
            // scattering, g ~0.85: 1 / (1 + 0.75 (1 - g) tau)), tau from the probe 250 m up or the
            // column to the top, whichever is deeper. From below: the ground and the horizon sky (the
            // lower hemisphere), which the cloud above does not shade — what lights a cumulus base.
            // Until 2026-09-28 it was exp(-sigma_up x 250 m), a straight-line Beer's law: inside a
            // cumulus (sigma ~0.03-0.05 /m) that is ~0, so everything more than ~250 m under the top
            // surface went black and the bases of every large cloud were one flat dark grey, cut off
            // from the sky-lit tops by a hard line (worst near sunset, when the key light is gone from
            // the bases and the twilight boost lifts only the tops).
            float ambVis = 1.0, ambLow = 0.0, ambHue = 1.0;
            if (!thin) {
                float tauUp = max(sigUp * 250.0, 0.6 * f.sigma * max(f.topH - p.h, 0.0));
                // Sky light that has diffused down through thick cloud arrives mixed with everything else that
                // entered the cloud (the Sun on its top and sides, which this term does not carry): white, not the
                // zenith's blue. Its hue is kept by the share that got through unscattered-ish (the diffuse
                // transmission). With the zenith's colour all the way down, the underside of an overcast was
                // sky-blue wherever the ambient was strongest and warm in the creases between (the lobe
                // occlusion): a sky-coloured noise pattern on cloud bottoms (issue 20261012_235159).
                ambHue = 1.0 / (1.0 + 0.11 * tauUp);
                ambVis = mix(0.7, 1.0, f.hf) / (1.0 + 0.11 * tauUp) * mix(1.0, exp(-f.sigma * 150.0), 0.3);
                // The light from below is the GROUND's (and the horizon haze's), and the ground under a cloud is
                // lit through that cloud: 30% from the open country around (gaps, the horizon), the rest x the
                // column's diffuse transmission. Unshaded and in the zenith's colour (until 2026-10-12), the base
                // of an overcast glowed as blue and nearly as bright as clear sky, and any modulation of the
                // ambient (the lobe occlusion) drew sky-coloured blobs on it (user record 41).
                ambLow = 0.35 * (1.0 - f.hf) * (0.3 + 0.7 / (1.0 + 0.11 * tauUp));
            }
            // The night sky: the moonlit sky's share of the moon, for the cloud's shaded side.
            // Twilight (cv2.atmo.y): with the Sun low or just set at the sample, the zenith alone badly
            // under-counts the sky that lights a cloud (the bright dome toward the Sun, the whole lit
            // upper atmosphere). Boosted from ~7 deg below the sample's horizon to ~14 deg above it,
            // it whitens the orange of the grazing sunlight, and past the terminator the zenith's colour
            // (blue, the ozone's Chappuis band) turns the last red light purple before night.
            float twi = smoothstep(horizS - 0.12, horizS, sunUp)
                      * (1.0 - smoothstep(horizS + 0.05, horizS + 0.25, sunUp));
            // Past the sample's horizon the sky above it darkens fast (the zenith at -6 deg is ~1% of
            // sunset's), but skyZenithAt's six midpoint samples count the lit air 16-33 km up at the
            // density of 25 km: clouds past the terminator glowed blue-purple on a planet whose drawn
            // sky was already black (user snaps from 69 km, pass 13). Faded over the first ~5 deg of
            // the Sun's depression, so a cloud is no brighter than the sky drawn around it.
            float skyDusk = smoothstep(horizS - 0.09, horizS + 0.04, sunUp);
            // + the moonless night sky (starlight, airglow): the terrain's "Night sky light"
            // (terrainErosion.z, a fraction of the full Moon overhead) on the moonlit sky's scale (0.03
            // here is the terrain's 0.15). Without it a night cloud was lit by the Moon alone, and on a
            // moonless night the clouds along the horizon were a black band in front of the airglow, darker
            // than the ground under them (review 5, snapshot 6). Ungated, like the terrain's (negligible by
            // day): gated by night it missed the twilight gap, where the sky light has faded (skyDusk)
            // and the night has not begun.
            vec3  skyDay = skyZen * skyDusk * cv2.look.w * (1.0 + cv2.atmo.y * twi);
            vec3  skyNgt = moonKey * nightK * 0.03 * max(dot(up, moonDir), 0.0)
                         + kMoonColor * cloud.moonGain * cv2.misc.y * (0.2 * cloud.terrainErosion.z);
            // From below, the day's light is mostly neutral (ground albedo, horizon haze): 30% of the sky's hue.
            float skyLum = dot(skyDay, vec3(0.2126, 0.7152, 0.0722));
            vec3  ambS   = (mix(vec3(skyLum), skyDay, ambHue) * ambVis + skyDay * (ambLow * 0.3 * ambHue)
                         + vec3(skyLum * ambLow * (1.0 - 0.3 * ambHue))
                         + skyNgt * (ambVis + ambLow)) * f.ambient;
            // The hemispheres (2026-10-26, cv2.amb.x): the sky's light as it is, physical units. Each hemisphere is half the
            // sphere a sample scatters from (the phase's mean, 1, so x 0.5); the upper reaches it through the cloud above
            // (ambVis), the lower as far as the cloud below and the ground's shading let it (ambLow / 0.35). Twilight and
            // dusk need no terms of their own ("Twilight sky light", the fade past the horizon): the whole dome's light,
            // scattered once and many times, is in the table. With the zenith alone the dome was undercounted by day and
            // by a different share at every Sun elevation.
            if (cv2.amb.x > 0.5) {
                vec3  hU = (0.5 * cv2.amb.y) * skyUpH, hD = (0.5 * cv2.amb.y) * skyDnH;
                float lU = dot(hU, vec3(0.2126, 0.7152, 0.0722)), lD = dot(hD, vec3(0.2126, 0.7152, 0.0722));
                ambS = (mix(vec3(lU), hU, ambHue) * ambVis + mix(vec3(lD), hD, ambHue) * (ambLow / 0.35)
                        + skyNgt * (ambVis + ambLow)) * f.ambient;
            }

            // ── Ground bounce from below: the key light, reflected by the ground under the cloud ──
            // The light on the ground is not the light at the sample (2026-10-24, issue 20261023_230636 "Anvil
            // darkness"): keyCol carries the clouds' shadow at the SAMPLE (the Sun transmittance volume), and under an
            // anvil the anvil itself shadows every sample of its underside, so the light reflected up to it was 0 and the
            // underside took the zenith sky through ~3 km of ice alone: near black, far darker than the towers beside it.
            // A HIGH sheet's underside sees the ground and the cloud tops far out round it, mostly outside its own shadow
            // (which falls h / tan(Sun elevation) away, ~20 km at 12 km and 30 deg): from ~4 to 9 km up its bounce takes
            // kBounceOpen of the UNSHADOWED Sun, over an albedo rising to kBounceAlbHigh (cloud tops below). A low deck's
            // base sees only the ground it shades (unchanged).
            float hiK  = smoothstep(4000.0, 9000.0, p.h);
            vec3  keyB = keyCol;
            if (!moonIsKey && cloud.moonMisc.y < 0.5) keyB += (sunCol * sunVis * cv2.look2.y - keyCol) * (kBounceOpen * hiK);
            vec3 bounceS = keyB * max(dot(up, keyDir), 0.0) * mix(0.15, kBounceAlbHigh, hiK) * cv2.look2.x
                         * (1.0 - f.hf) * (1.0 - f.hf);
            // Ice high above other cloud is lit from below by it: the clouds under cirrus reflect
            // 60-80% of the light. Without it cirrus seen from orbit at a backscattering angle was lit
            // only by its weak phase there, and read dark orange over white cloud. The albedo below is
            // the map's coverage over ~20 km (mip 2); the Sun must reach down there too.
            if (f.thin > 0.0) {
                bounceS += keyCol * max(dot(up, keyDir), 0.0) * (0.08 + 0.6 * covB) * 0.25 * cv2.look2.x
                         * smoothstep(-0.03, 0.02, dot(up, keyDir)) * f.thin;
            }

            // ── Night: city up-light, beams ──
            vec3 nightS = vec3(0.0);
            if (dayness < 0.9) {
                if (f.hf < 0.45) {
                    vec3  dE  = p.dirE;
                    vec2  uv  = vec2((atan(dE.y, dE.x) + PI) / (2.0 * PI), (0.5 * PI - asin(clamp(dE.z, -1.0, 1.0))) / PI);
                    vec3  cr  = textureLod(earthNightTex, uv, 3.0).rgb;
                    float lum = dot(cr, vec3(0.2126, 0.7152, 0.0722));
                    nightS += (cr / max(lum, 0.001)) * cityBrightness(lum) * smoothstep(0.45, 0.0, f.hf)
                            * (1.0 - dayness) * kCityUpwellStrength * cloud.ambientGain;
                }
                if (wantB) nightS += beamFinish(pW, p.h, dir, f, dayness, og, habRay, bE, bDir, bPh, odB);
            }

            vec3  S     = keyS + ambS + bounceS + nightS;
            // A haboob's dust (cv2DustWallSigma: its share of the sample as a negative soft): mineral dust absorbs in the
            // blue, so the light it scatters, multiply scattered as in a cloud, comes out beige.
            // (The sky light, scattered many times in a thick wall, takes the tint twice.)
            float dK = max(-f.soft, 0.0);
            if (kCv2DustOn != 0 && dK > 0.0) S = mix(S, (S - ambS) * kCv2DustTint + ambS * (kCv2DustTint * kCv2DustTint), dK);
            L += bW[bj] * S;
        }
        } while (nB >= kBatch);
        if (iters >= kMaxIters && t < tEnd) remLen += tEnd - t;
    }

    // What the budget left unmarched (long horizon rays through a broken field) is filled with the
    // path's mean extinction and the cloud's mean colour so far, instead of being left transparent:
    // a ray that ran out used to draw the horizon through the clouds in front of it.
    if (remLen > 0.0 && T > 0.01 && wAcc > 1e-4 && pathLen > 0.0) {
        float Trem = exp(-odPath / pathLen * remLen);
        float w    = T * (1.0 - Trem);
        L    += w * (L / wAcc);
        dAcc += w * (dAcc / wAcc + remLen * 0.5);
        wAcc += w;
        T    *= Trem;
    }

    // ── Fog and dust (cv2FogDust): a short march of their own, after the clouds' ──
    // 20 steps through the band they live in (up to 5 km over the highest ground + their own depth),
    // denser near the eye (u^2), cut at the scene depth and 150 km. Lit cheaply: the key light at the
    // band's middle, dimmed by the map's cover overhead and by the path to the fog's top (dust: its
    // scale height); the sky's zenith light; city light and the Moon at night. Composited by distance:
    // the part nearer than the clouds' mean depth in front of them, the rest behind.
    if (cv2.fog.x > 0.0 || cv2.fog.w > 0.0 || cv2.fog2.w > 0.0) {
        float band = max(max((cv2.fog.x > 0.0) ? 1.6 * cv2.fog.y : 0.0, (cv2.fog.w > 0.0) ? 4.0 * cv2.fog2.x : 0.0),
                         (cv2.fog2.w > 0.0) ? 6.0 * kIceFogH : 0.0) + 5000.0;
        vec2  tbS  = raySphere(eye, dir, R_EARTH + band);
        float ta   = max(tbS.x, 0.0);
        float tb   = min(tbS.y, tScene);
        // At most 150 km of it: from the eye inside the band, the far end beyond; from above, the part
        // nearest the ground (the dense end).
        // With no surface in the scene depth, tb was the band's exit on the far side of the Earth: end at
        // the sea-level sphere instead (review 14).
        bool fogNoSurf = tScene >= 0.5 * kNoSurfaceT;
        if (fogNoSurf) {
            vec2 tg = raySphere(eye, dir, R_EARTH);
            if (tg.x > 0.0) tb = min(tb, tg.x);
        }
        if (tbS.x > 0.0) ta = max(ta, tb - 150000.0);
        else             tb = min(tb, ta + 150000.0);
        // From above the band, under a cloud that hides what is behind it (T ~ 0), nothing of the fog and
        // dust shows: they lie below the cloud (the part above it is thin dust, x0.25 seen from above). The
        // march ran its 20 steps there anyway: ~3.7 ms of an orbit storm view (2026-10-04, user snap 1).
        if (tbS.x > 0.0 && T < 0.01) tb = ta;
        if (tb > ta) {
            float mcT  = (wAcc > 1e-4) ? dAcc / wAcc : 1e30;
            vec3  pm   = eye + dir * (0.5 * (ta + tb));
            float sUpF = dot(normalize(pm), sunDir);
            float rPm  = length(pm);
            float hzF  = -sqrt(max(1.0 - (R_EARTH / rPm) * (R_EARTH / rPm), 0.0));
            vec3  uvF  = vec3(cv2SunLutUV(sUpF, rPm - R_EARTH), 0.0);
            vec3  sunF = textureLod(cv2SunLutTex, uvF, 0.0).rgb * cv2.look2.y
                       * smoothstep(hzF - 0.004, hzF + 0.004, sUpF);
            uvF.z = 1.0;
            vec3  skyF = textureLod(cv2SunLutTex, uvF, 0.0).rgb * cv2.look.w
                       * smoothstep(hzF - 0.09, hzF + 0.04, sUpF);
            // The sky's light as the clouds take it (2026-10-26, cv2.amb.x): the mean of both hemispheres (the phase's mean, 1:
            // the haze scatters from the whole sphere), single + multiple scattering, at the sky's own gain. It was the zenith x
            // "Sky ambient" (2 at the user's), too blue by day and faded out past the horizon by a gate of its own.
            if (cv2.amb.x > 0.5) {
                uvF.z = 2.0; vec3 hUF = textureLod(cv2SunLutTex, uvF, 0.0).rgb;
                uvF.z = 3.0; vec3 hDF = textureLod(cv2SunLutTex, uvF, 0.0).rgb;
                skyF = 0.5 * cv2.amb.y * (hUF + hDF);
            }
            // A solar eclipse: the fog and dust see the Sun and sky the eye does (2026-10-03: the desert dust
            // stayed sunlit at totality, a bright tan sky over central Australia).
            if (cloud.moonMisc.y > 0.5) {
                sunF *= eclipseSunVis(pm * 1e-3, sunDir, 0.0);
                skyF *= eclipseSkyLight(pm * 1e-3, sunDir, rPm - R_EARTH);
            }
            float nightF = 1.0 - smoothstep(-0.1, 0.05, sUpF);
            vec3  moonF  = moonKey * nightF * smoothstep(-0.05, 0.1, dot(normalize(pm), moonDir));
            float phD  = 0.85 * cv2HG(cosSun, 0.65) + 0.15 * cv2HG(cosSun, -0.2);
            // Diamond dust: the ice's broad lobe plus its optics with a halo-rich habit (low plate and
            // column crystals: the 22 degree halo, sundogs, the arcs, the pillar), for the Sun or Moon.
            vec3  phI  = vec3(cv2HG(cosSun, 0.3)), phIM = vec3(cv2HG(cosMoon, 0.3));
            if (cv2.fog2.w > 0.0) {
                const vec4 habDD = vec4(1.0, 0.8, 0.5, 0.25);
                float ogI = max(og, 0.5);
                phI  += ogI * (cv2IceOptics(dir, sunDir, habDD) / 0.55 + cv2PillarOptics(dir, sunDir));
                phIM += ogI * (cv2IceOptics(dir, moonDir, habDD) / 0.55 + cv2PillarOptics(dir, moonDir));
            }
            vec3  L1 = vec3(0.0), L2 = vec3(0.0);
            float T1 = 1.0, T2 = 1.0, dF = 0.0, wF = 0.0;
            const int kFog = 20;
            float span = tb - ta;
            // Steps crowd toward the eye from inside the band (u^2), toward the far end (the ground) when
            // the eye is above it: looking down from altitude, u^2 put the coarse steps in the dense air at
            // the bottom — concentric bands around the nadir (user snapshot 8).
            bool  above = tbS.x > 0.0;
            // Dust is mostly a terrestrial effect: seen from above it fades (user snapshot 1: a dusty veil
            // over the whole view from 290 km). 2026-10-06: to 8% by 60 km (was 25% by 80 km): from orbit at
            // night its city-lit glow (the night map at ~40-80 km) drew soft tan blobs round every desert and
            // Mediterranean city (the release cinematic's pull-out). Aircraft heights are unchanged.
            float dustEye = mix(1.0, 0.08, smoothstep(15000.0, 60000.0, eyeH));
            float dH = max(cv2.fog2.x, 1.0);
            [[dont_unroll]] for (int i = 0; i < kFog; ++i) {
                float u0 = float(i) / float(kFog), u1 = float(i + 1) / float(kFog);
                float uj = mix(u0, u1, jitter);
                float g0 = above ? 1.0 - (1.0 - u0) * (1.0 - u0) : u0 * u0;
                float g1 = above ? 1.0 - (1.0 - u1) * (1.0 - u1) : u1 * u1;
                float gj = above ? 1.0 - (1.0 - uj) * (1.0 - uj) : uj * uj;
                float tS = ta + span * gj;
                float dt = span * (g1 - g0);
                CV2Pos pp = cv2Pos(dir * tS, eyeH, enuToEcef);
                float ds, ftH, fhf, dAgl, si;
                float sf = cv2FogDust(pp, tS * pixAng, ds, ftH, fhf, dAgl, si);
                // Review 14: no dust or ice fog under the ground. Their height terms come back clamped at 0
                // (dAgl), so a sample below the surface read the densest, ground-level value — and where the
                // scene depth lands below the real surface (past the detailed terrain march's range, ~550 km
                // out from 180 km over the Ronne ice shelf) the ice fog whitened everything beyond a hard ring
                // (user snapshot 3). Not the radiation fog: it pools in valleys below the smoothed ground.
                if (pp.h < cv2Ground(pp.dirE) - 30.0) { ds = 0.0; si = 0.0; }
                if (ds > 0.0 || si > 0.0) {
                    // The dust's exponential height profile integrated exactly over the step (the rest of
                    // its field is smooth over a step): a sample at one height per step drew the step
                    // pattern as rings on the ground.
                    float gnd = pp.h - dAgl;                             // the ground under the sample
                    float a0  = max(length(eye + dir * (ta + span * g0)) - R_EARTH - gnd, 0.0);
                    float a1  = max(length(eye + dir * (ta + span * g1)) - R_EARTH - gnd, 0.0);
                    float amp = ds * exp(dAgl / dH);
                    float mean = abs(a1 - a0) > 1.0 ? dH * abs(exp(-a0 / dH) - exp(-a1 / dH)) / abs(a1 - a0)
                                                    : exp(-0.5 * (a0 + a1) / dH);
                    ds = amp * mean * dustEye;
                    float ampI  = si * exp(dAgl / kIceFogH);
                    float meanI = abs(a1 - a0) > 1.0 ? kIceFogH * abs(exp(-a0 / kIceFogH) - exp(-a1 / kIceFogH)) / abs(a1 - a0)
                                                     : exp(-0.5 * (a0 + a1) / kIceFogH);
                    si = ampI * meanI;
                }
                float sg = sf + ds + si;
                if (sg <= 0.0) continue;
                float covA = clamp((textureLod(cv2WeatherTex, cv2FlowWeatherDirAt(pp), CV2_WX_LOD(2.0)).r * cv2.look.x - cv2.cover.x)
                                   / max(cv2.cover.y - cv2.cover.x, 1e-3), 0.0, 1.0);
                float od   = (sf * max(ftH - pp.h, 0.0) + ds * cv2.fog2.x + si * kIceFogH) / max(sUpF, 0.04);
                float fs   = sf / sg;                              // the fog's share
                float fi   = si / sg;                              // the ice fog's
                float fd   = max(1.0 - fs - fi, 0.0);              // the dust's
                vec3  alb  = mix(vec3(1.0), vec3(0.93, 0.76, 0.55), fd);
                // Dust's own multiple scattering: a hazy sky stays pale even away from the Sun (single
                // scattering alone drew a grey veil over the whole sky, 1/(4 pi) of the diffuse light).
                // The clouds' shadows IN the fog and dust: the Sun transmittance volume at the sample, so sunlight through a
                // gap draws a lit shaft in the haze (these are the forward scatterers). It replaces the map-cover dimming
                // while it is up (both would count the cloud twice). The diffuse (multiple-scattering) share takes 70% of the
                // shadow: it is lit from all around.
                bool  stvOn = cv2.stvH.z > 0.5;
                float sunC  = (stvOn ? cv2StvT(dir * tS, pp.h) : 1.0) * cv2TerrSunT(dir * tS);   // + the terrain's shadow
                float covK  = stvOn ? 1.0 : 1.0 - 0.8 * covA;
                // The fog's multiple scattering as the clouds' (cv2.ms.x: the delta-Eddington slab along the light, the fog
                // below the sample as the far side; no finite-cloud leak terms: a fog bank is a slab). The octaves lit thin
                // fog like a thick cloud.
                float msFog = (cv2.ms.x > 0.5)
                            ? cv2.ms.z * cv2DiffuseField(od, sf * dAgl / max(sUpF, 0.04), 1.0, cosSun) * exp(0.05 * (1.0 - cv2.ms.y * cv2.ms.y) * od)
                            : phMS * msOctaves(od);
                vec3  S    = sunF * covK * ((vec3(fd * phD + fs * phSS) + fi * phI) * exp(-od) * sunC
                                            + (msFog * fs + 0.9 * fd + 0.3 * fi) * mix(1.0, sunC, 0.7))
                           + moonF * ((vec3(phMoonSS * (1.0 - fi)) + fi * phIM) * exp(-od) + phMoonMS * 0.5 * fs)
                           + skyF * mix(0.9, 0.5, covA);
                if (nightF > 0.0) {
                    // City light glowing in the fog and the dust. Review 20: the dust had only the Moon by
                    // night, so from inside its band (a long horizontal path) it hid the city-lit sky behind it
                    // and gave nothing back: a near-black band along every night horizon, gone once the eye
                    // climbed out of the band (user snapshot 3), and where a cloud's half-res silhouette hid the
                    // dust behind it, a pale blocky band (snapshot 1). Dust is lit by the cities over a wider
                    // area (it is km thick; the map at ~80 km), and like everything at night by the moonless sky.
                    vec3  dE  = pp.dirE;
                    vec2  uv  = vec2((atan(dE.y, dE.x) + PI) / (2.0 * PI), (0.5 * PI - asin(clamp(dE.z, -1.0, 1.0))) / PI);
                    vec3  cr  = textureLod(earthNightTex, uv, mix(3.0, 4.0, fd)).rgb;
                    float lum = dot(cr, vec3(0.2126, 0.7152, 0.0722));
                    // In proportion to the lights (a full core at ~0.2): cityBrightness saturates by a small
                    // town, so any fog patch near a city glowed at full strength — from altitude a bright tan
                    // slab over Denver read as a dust storm (user review 2, snapshot 2).
                    float cb  = clamp(max(lum - kNightFloor, 0.0) / 0.2, 0.0, 1.0);
                    S += (cr / max(lum, 0.001)) * cb * nightF * (fs + kDustCityK * fd) * kCityUpwellStrength * cloud.ambientGain
                       + kMoonColor * cloud.moonGain * cv2.misc.y * (0.2 * cloud.terrainErosion.z) * nightF * (fd + fi);
                }
                S *= alb;
                float Ts = exp(-sg * dt);
                if (tS < mcT) { L1 += T1 * (1.0 - Ts) * S; dF += T1 * (1.0 - Ts) * tS; wF += T1 * (1.0 - Ts); T1 *= Ts; }
                else          { L2 += T2 * (1.0 - Ts) * S; dF += T * T2 * (1.0 - Ts) * tS; wF += T * T2 * (1.0 - Ts); T2 *= Ts; }
            }
            L = L1 + T1 * (L + T * L2);
            T = T1 * T * T2;
            dAcc += dF; wAcc += wF;
        }
    }

    float meanT = (wAcc > 1e-4) ? dAcc / wAcc : 0.0;
    vec3  outRgb = vec3(0.0);
    if (wAcc > 1e-4) {
        // Aerial perspective between the eye and the cloud (v1's camPathInscatter, same physics),
        // integrated only over the part of the path inside the atmosphere: from orbit, uniform
        // steps from the eye spent almost all of themselves in vacuum and missed the dense air
        // just above the cloud, so clouds seen from space came out darker than the haze around them.
        vec2  tAtm = raySphere(eye, dir, R_ATMOS);
        float t0   = clamp(tAtm.x, 0.0, max(meanT, 0.001));
        vec3  e0   = eye + dir * t0;
        float span = max(meanT - t0, 0.001);
        vec2 odC  = optDepth(e0, dir, span);
        vec3 attn = exp(-(BETA_R * odC.x + BETA_M * 1.1 * odC.y));
        // The air IN FRONT of the cloud is the sky pass's (review 8b: sat_sky.frag airFront, from its own
        // atmosphere loop, composited as airFront x (1 - T)): one atmosphere for the cloud and the clear sky
        // beside it. This march's 8-step airlight read far darker than the sky's at a grazing Sun (distant
        // clouds were dark silhouettes on the horizon), and a split between the two by distance (review 8)
        // disagreed at cloud edges: dark specks and flicker along every silhouette.
        outRgb = attn * L;
    }
    // (Godrays: the SKY PASS shadows its own air samples by the Sun shadow cascade since 2026-10-10 (sat_sky.frag,
    //  SKY_SUN_SHADOW). The march used to scale this pixel's transmittance by the shadowed share of its airlight;
    //  the sky pass dims only the air BEHIND a pixel's cloud distance, so clear pixels were never dimmed and any
    //  pixel with the faintest veil was, in full: a sheet with the stair-stepped outline of "some cloud here".)
    // REGISTER NOTE: godT must stay a runtime value. As the constant 1.0 (the first cut of the removal) the driver gave
    // the march 220 registers; with this never-true test ("God rays" is 0..1) it gets 128. Check `shaders reload`
    // after touching it.
    float godT = (cv2.lightVol.w > 1.5) ? 0.0 : 1.0;

    // The beams in clear air, occluded by this ray's clouds through the transmittance checkpoints —
    // inside the march, so the temporal resolve anti-aliases them like cloud (the drawn line it
    // replaces was cut at the cloud's mean distance in half-res steps).
    vec3 shaftRgb = vec3(0.0);
    float tShaft = 0.0;
    if (cv2.beam.x > 0.0 && cloud.showBeamDebugRays != 0u && (cloud.dbgDisableMask & 128u) == 0u
        && cv2.beam.z > 0.0 && beamLightCount > 0u)
        shaftRgb = beamShafts(eye, dir, tScene, tq, sunDir, BETA_R, BETA_M, pixAng, tShaft);
    outRgb += shaftRgb;
    // A shaft in clear sky reprojects at ITS distance, not at infinity: the resolve's parallax at the
    // pixel's depth is what keeps a moving camera's history on the shaft (it smeared while walking).
    if (wAcc <= 1e-4 && tShaft > 0.0) meanT = tShaft;

    // Debug views (cv2.shell.z): 1 = march iterations, 2 = transmittance, 3 = mean depth / 50 km,
    // 4 = the weather cube where the ray enters the shell (r coverage, g type, b precipitation).
    int dbg = int(cv2.shell.z + 0.5);
    if (dbg == 4 && nSeg > 0) {
        CV2Pos pe = cv2Pos(dir * seg[0].x, eyeH, enuToEcef);
        outRgb = textureLod(cv2WeatherTex, cv2WeatherDir(pe.dirE), 0.0).rgb * 0.05;
    }
    if (dbg == 1) outRgb = mix(vec3(0.0, 0.2, 1.0), vec3(1.0, 0.1, 0.0), float(iters) / float(kMaxIters)) * 0.05;
    else if (dbg == 2) outRgb = vec3(1.0 - T) * 0.05;
    else if (dbg == 3) outRgb = vec3(fract(meanT / 50000.0)) * 0.05;
    // 10: the godrays' shadowed share of the airlight (1 - godT), x4.
    else if (dbg == 10) outRgb = vec3(clamp((1.0 - godT) * 4.0, 0.0, 1.0)) * 0.05;
    else if (dbg == 5) outRgb = vec3(1.0 - exp(-odRain), 0.0, (wAcc > 1e-4) ? 0.3 : 0.0) * 0.05;
    // 8: the beam shafts — r the tile's light count / 64 (1 = overflow, all lights), g the beams this
    // ray's interval found / 8, b the shaft radiance (log scale), plus a faint grey when any light exists.
    else if (dbg == 8) {
        float nL = (sTileLightOverflow != 0u) ? 1.0 : float(sTileLightCount) / 64.0;
        float lum = dot(shaftRgb, vec3(0.33));
        outRgb = vec3(nL, float(gShaftHits) / 8.0,
                      clamp((log2(max(lum, 1e-12)) + 30.0) / 30.0, 0.0, 1.0)) * 0.05
               + ((beamLightCount > 0u) ? vec3(0.004) : vec3(0.0));
    }
    // 7: which layer: red = low (incl. rain), green = mid, blue = anvil + Cb columns, white = high.
    else if (dbg == 7) outRgb = (vec3(1.0) - exp(-odLayer.xyz) + vec3(0.6) * (1.0 - exp(-odLayer.w))) * 0.05;
    // (Debug view 11, the adaptive tiles, is the resolve's overlay: the CPU sends the march view 0. An
    // exemption here, (dbg != 0 && dbg != 11), flipped this shader to ~224 registers: +19%.)
    float Tout = (dbg != 0) ? 0.0 : T * godT;

    vec4 oD = vec4(meanT, (T < 0.1 && tHalf > 0.0) ? tHalf : -1.0, 0.0, 0.0);
    if (passB) {
        // The full targets, and this tile's sparse-grid samples (the quarter grid stays complete).
        imageStore(outFullColor, pix, vec4(outRgb, Tout));
        imageStore(outFullDepth, pix, oD);
        if (all(equal(pix & 1, ivec2(cv2.frame.zw)))) {
            imageStore(outColor, pix >> 1, vec4(outRgb, Tout));
            imageStore(outDepth, pix >> 1, oD);
        }
    } else {
        imageStore(outColor, outPix, vec4(outRgb, Tout));
        imageStore(outDepth, outPix, oD);
    }
}
