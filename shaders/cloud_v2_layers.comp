#version 450
#extension GL_EXT_control_flow_attributes : enable
// ── Clouds v2: the layer shadow map's bakes (2026-10-14; include/cv2_layer_map.glsl, .plans/LAYER_SHADOW_MAP_PLAN.md) ──
// Same descriptor set and push constants as cloud_v2_march.comp; run after the lightning pass, before the march.
// Specialization constant 2 picks the pass:
//   0  COLUMNS: 32 workgroups of 256 cells a frame (both levels, 131072 cells: each every 16 frames). Each cell takes
//      a jittered point and integrates the mid and high layers' vertical optical depth there, into its running mean.
//   1  SLANT: 128 workgroups, a quarter of each level's cells a frame. Per cell X on each layer's reference sphere, the
//      Sun's transmittance through that layer along the Sun ray through X, from the columns the ray crosses.
layout(local_size_x = 256) in;
layout(constant_id = 2) const uint kMode = 0u;

layout(push_constant) uniform PC {        // == CloudMarchPC (cloud_v2_march.comp)
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#define CLOUD_PARAMS_BINDING 0
#include "cloud_params.glsl"
#include "common.glsl"
#define CV2_PARAMS_BINDING  1
#define CV2_WEATHER_BINDING 2
#define CV2_SHAPE_BINDING   3
#define CV2_MESO_BINDING    5
#define CV2_MORPH_BINDING   20
#include "clouds_v2.glsl"
layout(std430, set = 0, binding = 8) buffer TerrainFrame { vec4 terrainFrame; };
#define CV2_LAYER_BINDING 22
#define CV2_LAYER_WRITE
#define CV2_LAYER_BAKE
#define CV2_LAYER_LOOKUP     // (the harness probe)
#include "cv2_layer_map.glsl"
#define CV2_FLASH_BINDING 12
#define CV2_FLASH_WRITE
#include "cloud_lightning.glsl"   // cv2SunProf's spare slots: the probe

uint layHash(uvec2 v)
{
    uint h = v.x * 0x9E3779B1u ^ (v.y + 0x7F4A7C15u) * 0x85EBCA77u;
    h ^= h >> 15; h *= 0x2C1B3C6Du; h ^= h >> 12;
    return h;
}

// The absolute cell a slot holds now: the one of its residues inside the window centred on the eye's cell.
ivec2 cellOfSlot(int slot, int lv)
{
    ivec2 s  = ivec2(slot & (kCv2LayN - 1), slot >> 8);
    ivec2 c0 = ivec2(floor(cv2LayEyeC(lv))) - kCv2LayN / 2;
    return c0 + ((s - c0) & (kCv2LayN - 1));
}
// The cell's centre (plus an offset in cells) as a direction from the Earth's centre, observer ENU (not normalised).
vec3 cellDir(vec2 c, int lv)
{
    float cell = cv2LayCell(lv);
    return cv2.layA.xyz * kCv2LayR + (cv2.layE.xyz * c.x + cv2.layN.xyz * c.y) * cell;
}

void bakeColumn(uint gi)
{
    int   lv   = int(gi >> 16u);
    int   slot = int(gi & 0xFFFFu);
    ivec2 cell = cellOfSlot(slot, lv);
    uint  st   = cv2LayStamp(cell);
    int   idx  = (lv * kCv2LayCells + slot) * 2;
    uvec4 meta = cv2LayCol[idx + 1];
    bool  ok   = (meta.x & 0xFFFFu) == st;
    uint  cnt  = ok ? (meta.x >> 16u) : 0u;
    vec3  enuZ = normalize(pc.obsECEFDir.xyz);
    vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    mat3  enuToEcef = mat3(enuX, cross(enuZ, enuX), enuZ);
    float eyeH = terrainFrame.x + 2.0;
    const float kFp = 100.0;   // a fine read: coarse ones do not conserve the layers' optical depth (plan F2)
    // Jittered points of the cell, new ones each bake (R2 from the bake count and a per-cell hash): 4 on a cell's first
    // bakes, so a fresh map starts near its cells' means (from 1 a bake, one view settled twice differed by ~1.3 levels
    // after 200 frames), then 1.
    uint  hh   = layHash(uvec2(cell + kCv2LayOff));
    uint  nSub = (cnt < 16u) ? 4u : 1u;
    vec2  n0 = vec2(0.0), n1 = vec2(0.0), n2 = vec2(0.0), n3 = vec2(0.0);
    [[dont_unroll]] for (uint i = 0u; i < nSub; ++i) {
        float n  = float(cnt + i) + float(hh & 1023u);
        vec2  j  = fract(vec2(0.5) + n * vec2(0.7548777, 0.5698403));
        float jz = fract(0.5 + n * 0.6180340 + float((hh >> 10u) & 255u) / 256.0);
        vec3  d  = normalize(cellDir(vec2(cell) + j, lv));
        // The flow and the ground once for the column (cv2Field does the same per sample).
        CV2Pos q0 = cv2Pos(d * (kCv2LayR + 5000.0) - vec3(0.0, 0.0, kCv2LayR + eyeH), eyeH, enuToEcef);
        gCv2FlowSet = false;
        gCv2FlowD   = cv2FlowDisp(cv2Drift(q0.dirE), vec3(0.0));
        gCv2FlowSet = true;
        gCv2GroundSet = false;
        gCv2Ground    = cv2Ground(q0.dirE);
        gCv2GroundSet = true;
        CV2LayCol m = cv2MidColumn(d, eyeH, enuToEcef, jz, kFp);
        CV2LayCol h = cv2HighColumn(d, eyeH, enuToEcef, fract(jz + 0.5), kFp);
        n0 += vec2(m.tau, m.tau * m.tau); n1 += vec2(h.tau, h.tau * h.tau);
        n2 += vec2(m.th, m.th2);          n3 += vec2(h.th, h.th2);
    }
    float inv = 1.0 / float(nSub);
    n0 *= inv; n1 *= inv; n2 *= inv; n3 *= inv;

    // The running mean: 1 / bakes (converging on the cell's mean over 64 points), at least cv2.layBake.y = the sim time since
    // the cell's last bake over the time the clouds take to move on (the layers evolve and slide with the wind): 0 while
    // paused, so a still view's map is still.
    float w = ok ? max(float(nSub) / float(min(cnt, 63u) + nSub), cv2.layBake.y) : 1.0;
    uvec4 old = cv2LayCol[idx];
    vec2  a0 = unpackHalf2x16(old.x), a1 = unpackHalf2x16(old.y), a2 = unpackHalf2x16(old.z), a3 = unpackHalf2x16(old.w);
    if (!ok) { a0 = n0; a1 = n1; a2 = n2; a3 = n3; }
    cv2LayCol[idx]     = uvec4(packHalf2x16(mix(a0, n0, w)), packHalf2x16(mix(a1, n1, w)),
                               packHalf2x16(mix(a2, n2, w)), packHalf2x16(mix(a3, n3, w)));
    cv2LayCol[idx + 1] = uvec4(st | (min(cnt + nSub, 4095u) << 16u), 0u, 0u, 0u);
}

// A column's layer L at an absolute direction: x E[tau], y Var[tau], z the layer's band bottom, w top (km from the
// reference height); x = 0 when the cell holds nothing (or is not baked).
vec4 columnAt(vec3 d, int L, out float cellM)
{
    int lv = 0;
    vec2 c = cv2LayCoord(d, 0);
    vec2 ge = abs(c - cv2LayEyeC(0));
    if (max(ge.x, ge.y) > 126.0) { lv = 1; c = cv2LayCoord(d, 1); ge = abs(c - cv2LayEyeC(1)); }
    cellM = cv2LayCell(lv);
    if (max(ge.x, ge.y) > 126.0) return vec4(0.0);
    ivec2 cc = ivec2(floor(c));
    int   idx = (lv * kCv2LayCells + cv2LaySlot(cc)) * 2;
    if ((cv2LayCol[idx + 1].x & 0xFFFFu) != cv2LayStamp(cc)) return vec4(0.0);
    uvec4 e  = cv2LayCol[idx];
    vec2  t  = unpackHalf2x16(L == 0 ? e.x : e.y);
    vec2  hm = unpackHalf2x16(L == 0 ? e.z : e.w);
    if (t.x <= 1e-5) return vec4(0.0);
    float cen = hm.x / t.x;
    float th  = max(sqrt(max(12.0 * (hm.y / t.x - cen * cen), 0.0)), 0.15);   // a uniform slab of that variance
    return vec4(t.x, max(t.y - t.x * t.x, 0.0), cen - 0.5 * th, cen + 0.5 * th);
}

// The height of a point X + s t (|X| = R + href) above sea level, without cancellation.
float hAlong(float href, float b, float t)
{
    float r2m = href * (2.0 * kCv2LayR + href) + 2.0 * b * t + t * t;   // |X + s t|^2 - R^2
    float len = sqrt(max(kCv2LayR * kCv2LayR + r2m, 1.0));
    return r2m / (len + kCv2LayR);
}

// The Sun's transmittance through layer L along the Sun ray through the reference-sphere point in direction d (unit,
// observer ENU), s the Sun (ENU), jt the taps' jitter; M / V the slant optical depth's mean and variance (shadow share in).
float slantT(vec3 d, int L, vec3 s, float jt, out float M, out float V)
{
    M = 0.0; V = 0.0;
    float sinX = dot(d, s);
    if (sinX <= 0.0) return 1.0;   // past the ray's lowest point: a lookup never lands here
    const int kTaps = 16;
    float href = cv2LayRefH(L);
    vec2  band = cv2LayBand(L);
    float r  = kCv2LayR + href;
    float b  = r * sinX;           // dot(X, s)
    // [t0, t1]: from where the ray rises out of the band's floor (or its lowest point) to where it leaves the band's top.
    // (The NEAR root of the floor, -b + sqrt(b^2 - c), behind X on the Sun's side of the lowest point; no cancellation.)
    float cLo = (href - band.x) * (2.0 * kCv2LayR + href + band.x);
    float dLo = b * b - cLo;
    float t0  = max(dLo > 0.0 ? -cLo / (b + sqrt(dLo)) : -b, -b);
    float cHi = (href - band.y) * (2.0 * kCv2LayR + href + band.y);
    float t1  = -cHi / (b + sqrt(b * b - cHi));   // = -b + sqrt(b^2 - cHi) (b > 0)
    float dt  = (t1 - t0) / float(kTaps);
    float cosX = sqrt(max(1.0 - sinX * sinX, 0.0));
    [[dont_unroll]] for (int k = 0; k < kTaps; ++k) {
        float ta = t0 + dt * float(k), tb = ta + dt;
        float tm = ta + dt * fract(jt + 0.618034 * float(k));
        vec3  Y  = d * r + s * tm;
        float cellY;
        vec4  col = columnAt(Y, L, cellY);
        if (col.x <= 0.0) continue;
        // The stretch of this tap's segment inside the column's band: the ray's height is monotonic here.
        float ha = hAlong(href, b, ta) - href, hb = hAlong(href, b, tb) - href;   // m from href
        float lo = col.z * 1000.0, hi = col.w * 1000.0;
        float h0 = min(ha, hb), h1 = max(ha, hb);
        float inS = (h1 - h0 > 1e-3) ? max(min(h1, hi) - max(h0, lo), 0.0) / (h1 - h0)
                                     : ((h0 >= lo && h0 <= hi) ? 1.0 : 0.0);
        float mk = dt * inS / max(hi - lo, 150.0);       // slant path per unit of the layer's vertical depth
        // Taps closer than a cell read the same column: their variances add coherently.
        float corr = max(cellY / max(dt * cosX, 1.0), 1.0);
        M += mk * col.x;
        V += mk * mk * col.y * min(corr, float(kTaps));
    }
    float wS = (L == 0) ? cv2.layRef.z : cv2.layRef.w;   // the shadow's share of the extinction (delta scaling)
    M *= wS; V *= wS * wS;
    return (V > 1e-6 * M * M + 1e-9) ? pow(1.0 + V / max(M, 1e-6), -M * M / V) : exp(-M);
}

mat3 enuFrame()
{
    vec3 enuZ = normalize(pc.obsECEFDir.xyz);
    vec3 enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    return mat3(enuX, cross(enuZ, enuX), enuZ);
}

void bakeSlant(uint gi)
{
    int   lv   = int(gi >> 16u);
    int   slot = int(gi & 0xFFFFu);
    ivec2 cell = cellOfSlot(slot, lv);
    vec3  d    = normalize(cellDir(vec2(cell) + 0.5, lv));
    vec3  s    = transpose(enuFrame()) * cv2.sunE.xyz;
    // Fixed tap positions per cell: re-jittered every pass, the slant cells flickered under a still view (the history then
    // took seconds to settle after a move).
    float jt   = float(layHash(uvec2(cell + kCv2LayOff)) & 1023u) / 1024.0;
    vec2  T, own0, own1;
    float M, V, cM;
    T.x = slantT(d, 0, s, jt, M, V);
    T.y = slantT(d, 1, s, fract(jt + 0.5), M, V);
    vec4 c0 = columnAt(d, 0, cM), c1 = columnAt(d, 1, cM);
    own0 = c0.x > 0.0 ? c0.zw : vec2(0.0);
    own1 = c1.x > 0.0 ? c1.zw : vec2(0.0);
    cv2LaySlant[lv * kCv2LayCells + slot] = uvec4(packHalf2x16(T), packHalf2x16(own0), packHalf2x16(own1), cv2LayStamp(cell));
}

// A probe for the harness (`state` -> clouds_v2.layer_map): the map at the point 1.5 km above sea level under the eye,
// written into cv2SunProf's spare slots [8..19] (host-visible).
void probe()
{
    mat3  e2e  = enuFrame();
    vec3  s    = transpose(e2e) * cv2.sunE.xyz;
    float eyeH = terrainFrame.x + 2.0;
    float hq   = min(1500.0, eyeH);
    vec3  rel  = vec3(0.0, 0.0, hq - eyeH);
    float cM, M0, V0, M1, V1;
    vec3  dq   = normalize(rel + vec3(0.0, 0.0, kCv2LayR + eyeH));
    vec4  c0   = columnAt(dq, 0, cM), c1 = columnAt(dq, 1, cM);
    // The mid layer's crossing of its reference sphere along the Sun ray from the probe point, and its slant there.
    vec3  P    = rel + vec3(0.0, 0.0, kCv2LayR + eyeH);
    float b    = dot(P, s), c = (hq - cv2.layRef.x) * (2.0 * kCv2LayR + hq + cv2.layRef.x);
    float sq   = sqrt(max(b * b - c, 0.0));
    vec3  X    = normalize(P + s * ((b > 0.0) ? -c / (b + sq) : sq - b));
    float T0   = slantT(X, 0, s, 0.5, M0, V0);
    float T1   = slantT(X, 1, s, 0.5, M1, V1);
    cv2SunProf[8]  = cv2LayerShadowT(rel, hq, s, eyeH, 1.0);
    cv2SunProf[9]  = c0.x;  cv2SunProf[10] = c0.y; cv2SunProf[11] = c0.z; cv2SunProf[12] = c0.w;
    cv2SunProf[13] = c1.x;  cv2SunProf[14] = c1.z; cv2SunProf[15] = c1.w;
    cv2SunProf[16] = T0;    cv2SunProf[17] = M0;   cv2SunProf[18] = T1; cv2SunProf[19] = dot(X, s);
}

void main()
{
    if (cv2.layN.w <= 0.0) return;
    uint li = gl_LocalInvocationID.x;
    if (kMode == 0u) {
        uint gi = ((uint(cv2.layBake.x) * 32u + gl_WorkGroupID.x) * 256u + li) & 0x1FFFFu;
        bakeColumn(gi);
    } else {
        // A quarter of each level a frame: slots interleaved by 4 so every part of the window refreshes together.
        uint q  = uint(cv2.layBake.x) & 3u;
        uint k  = gl_WorkGroupID.x * 256u + li;                 // 0 .. 32767
        uint gi = (k * 4u + q) & 0x1FFFFu;
        bakeSlant(gi);
        if (gl_WorkGroupID.x == 0u && li == 0u) probe();
    }
}
