// ── sat_orbit.comp ────────────────────────────────────────────────────────────
// Compute shader: per-satellite orbital mechanics + attitude normals + reflectance model.
// Runs before sat_flare.comp each frame; replaces the CPU updatePositions() loop.
//
// Lighting overhaul Phase 1 (.plans/SAT_LIGHTING_PLAN.md): the reflectance model (shadow,
// earthshine, specular/mirror/diffuse) moved here from sat_flare.comp, and the per-type fields
// moved out of every satellite's orbit record into satTypeBuf. That deleted GpuSatInput — an
// 80-byte-per-satellite record this shader wrote only for sat_flare.comp to read straight back.
// sat_flare.comp still runs as a separate dispatch because its photometry reads beamGlowDome,
// which THIS dispatch builds with atomicMax across every TargetedReflector satellite; it can't be
// read until the whole dispatch is done.
//
// Reads:
//   binding 0  satOrbitBuf     — GpuSatOrbit array (64 B), uploaded once at init
//   binding 2  reflectorTargetsECEFBuf — static per-target ECEF direction + ground radius,
//                                uploaded once at target-generation time (TargetedReflector
//                                target search — this shader is now the buffer's only reader)
//   binding 5  satTypeBuf      — GpuSatTypeHeader (brightnessScale, mirrorBoost) + GpuSatType[]
//
// Writes:
//   binding 1  SatVisibleBuf   — COMPACT list of pre-photometry GpuSatVisible records, one per
//                                satellite that survives the horizon/enable cull; sat_flare.comp
//                                finishes them in place. See GpuSatVisible in SatelliteSim.h.
//   binding 6  SatVisibleIdxBuf — satellite index per compact slot (picking, selection tracking)
//   binding 7  SatListBuf      — GpuSatListHeader: append counter + the indirect dispatch/draw
//                                args every downstream satellite pass runs from
//
// Phase 1b (visible-list compaction): only ~5-10% of satellites are above the horizon, but
// sat_flare.comp and the three point draws used to process every one of them. Culled satellites
// now write nothing at all; everything downstream scales with the VISIBLE count.
//   binding 3  reflectBeamsBuf — Reflect-Orbital ground beams (C12), capped atomic-append, no arbitration;
//                                zeroed each frame by vkCmdFillBuffer, consumed by
//                                cloud_march.comp (volumetric in-scatter) and sat_sky.frag
//                                (ground-spot direct lighting). blockAltM/blockOpacity are left
//                                unwritten here (2026-08-09) — beam_self_march.comp, dispatched
//                                right after this shader, overwrites them with a real per-beam
//                                slant march. See that file's header for the full design.
//
// Below-horizon and disabled satellites are simply not appended.
//
// 2026-08-06 reversibility rework: TargetedReflector target selection and mirror orientation used
// to be persistent, history-dependent GPU state (mirrorNormalsBuf: a lock with acquire/release
// hysteresis, plus rate-limited slew integrated frame-by-frame) — which meant the result was a
// function of the PATH taken to reach a given sim time, not of sim time itself, so playing forward
// to T and playing backward to T could land on different target/orientation pairs. That state is
// gone. Everything in the TargetedReflector block below is now a pure function of the current
// frame's push constants (which are themselves pure functions of absolute sim time, computed in
// double precision on the CPU) — see CLAUDE.md's TargetedReflector section for the full design.
// ─────────────────────────────────────────────────────────────────────────────

#version 450
layout(local_size_x = 64) in;

// ── GpuSatOrbit: all floats/uints, no vec3 (avoids std430 padding) ─────────
// 16 × 4-byte fields = 64 bytes (was 112 before the per-type fields moved to SatType below).
// Must match GpuSatOrbit in SatelliteSim.h.
struct SatOrbit {
    float raan;               // right ascension of ascending node at epoch
    float u0;                 // epoch-baked initial phase: fmod(orig_u0 + meanMot*epochT0, 2π)
    float R_sat;              // kEarthRadius + altM (meters)
    float meanMot;            // sqrt(GM/R³) (rad/s)

    float cosI;               // cos(inclination)
    float sinI;               // sin(inclination)
    float cosRaan;            // cos(raan) — used when alignTerminator < 0.5
    float sinRaan;            // sin(raan) — used when alignTerminator < 0.5

    float tumbleRate;         // rotation rate (rad/s); 0 = not tumbling
    float tumblePhase;        // epoch-baked tumble angle: fmod(phase + rate*epochT0, 2π)
    float tumbleAxisX;        // tumble axis unit vector x
    float tumbleAxisY;        // tumble axis unit vector y

    float tumbleAxisZ;        // tumble axis unit vector z
    float alignTerminator;    // 1.0 = SSO (RAAN precesses); 0.0 = fixed RAAN
    uint  typeIdx;            // index into types[] (SatTypeBuf)
    uint  constIdx;           // constellation index (for enabledMask/highlightMask)
};

layout(set = 0, binding = 0) readonly buffer SatOrbitBuf {
    SatOrbit orbits[];
};

// ── Per-type reflectance + attitude parameters (GpuSatType, 208 bytes) ─────────
// Shared by every satellite of a type — a few KB total, so it stays cache-resident instead of
// costing bandwidth per satellite. Must match GpuSatType / GpuAttGroup in SatelliteSim.h.
//
// Attitude (lighting overhaul Phase 2): each type is 1-2 RIGID GROUPS. A group's world frame is
// built from two target directions (TRIAD: t1 = primary target exactly, t2 = normalize(t1 ×
// secondary target), t3 = t1 × t2), then optionally rotated by a 1-DOF joint. Every body-frame
// vector (surface normals, joint axis/vector) arrives pre-expressed in that triad's coordinates,
// computed once per type on the CPU — so a world vector is just t1*v.x + t2*v.y + t3*v.z.
struct AttGroup {
    uint  law;                // ATT_LAW_*
    uint  primaryTarget;      // ATT_T_*
    uint  secondaryTarget;    // ATT_T_*
    uint  jointMode;          // JOINT_*
    vec3  jointAxisT;         // joint rotation axis (triad coordinates)
    uint  jointTarget;        // ATT_T_* — Track/EdgeOn objective direction
    vec3  jointVectorT;       // body vector the Track/EdgeOn objective applies to (triad coords)
    float jointLimitRad;      // |rotation| clamp for Track/EdgeOn
    float jointAngleRad;      // FixedAngle rotation
    uint  parent;             // parent group index (always lower), ATT_NO_PARENT = root
    float grpPad0, grpPad1;
};
struct SatType {
    float baseColorR;         // satellite tint (r)
    float baseColorG;         // satellite tint (g)
    float baseColorB;         // satellite tint (b)
    float crossSection;       // sqrt(area_m² / 10)

    float specExp0;           // primary specular exponent
    float specExp1;           // secondary specular exponent
    float w1;                 // secondary surface weight
    float diffuse;            // isotropic Lambertian floor

    float mirrorFrac;         // near-perfect mirror fraction
    uint  groupCount;         // 1..4 (parents before children)
    uint  firstLobe;          // Phase 3 geometry model: first entry in lobes[]
    uint  lobeCount;          // 0 = legacy two-surface reflectance

    vec3  surfNormalT0;       // primary surface normal (triad coordinates of its group)
    uint  surfGroup0;
    vec3  surfNormalT1;       // secondary surface normal
    uint  surfGroup1;

    AttGroup groups[4];       // kMaxAttitudeGroups — read straight from the buffer, never copied
                              // into a local (a dynamically indexed local array spills)
};
// Header block = GpuSatTypeHeader in SatelliteSim.h (rewritten by the CPU every frame).
layout(set = 0, binding = 5) readonly buffer SatTypeBuf {
    float   brightnessScale;  // global flux multiplier
    float   mirrorBoost;      // mirror peak multiplier
    float   typeHdrPad0;
    float   typeHdrPad1;
    SatType types[];
};

// ── Phase 3 geometry models: baked facet lobes (GpuSatLobe, 48 bytes) ──────────
// Each lobe is exact for a flat face (curved surfaces merge into a few lobes whose angular spread
// is folded into alpha2Mat). normalT is in the ROOT triad coordinates of the lobe's group tree —
// world normal = groupFrame * normalT. Must match GpuSatLobe in SatModel.h.
struct SatLobe {
    vec3  normalT;
    uint  group;
    float area;               // m², specular term
    float diffArea;           // m², diffuse term
    float albedoD;            // Lambertian albedo
    float f0;                 // Schlick F0
    float alpha2Mat;          // GGX α² of material + normal spread (source size added below)
    uint  visLayer;           // Phase 3b self-shadowing; 0xFFFFFFFF = unoccluded
    float lobePad0, lobePad1;
};
layout(set = 0, binding = 8) readonly buffer SatLobeBuf {
    SatLobe lobes[];
};

// ── Output: compact pre-photometry GpuSatVisible list, finished in place by sat_flare.comp ──
// Must match GpuSatVisible (32 bytes) in SatelliteSim.h. Appended here as:
//   highlight: flareIntensity < 0, angularSize = range (m)
//   lit:       flareIntensity = raw flux (before sky/extinction/pollution), angularSize = range (m),
//              baseColor already eclipse-tinted
struct SatVisible {
    vec3  skyDir;
    float flareIntensity;
    vec3  baseColor;
    float angularSize;
};
layout(set = 0, binding = 1) writeonly buffer SatVisibleBuf {
    SatVisible visible[];
};
layout(set = 0, binding = 6) writeonly buffer SatVisibleIdxBuf {
    uint visibleSatIdx[]; // satellite (dispatch) index of each compact slot
};
// GpuSatListHeader (80 bytes). Reset every frame by a vkCmdUpdateBuffer to {0, 0,1,1, 0,1,0,0,
// zeros}. The dispatch/draw args are maintained with atomicMax on each workgroup's append END:
// slots are handed out contiguously from 0, so the largest end IS the final count — no separate
// args-building pass needed.
layout(set = 0, binding = 7) buffer SatListBuf {
    uint listCount;           // append counter
    uint dispatchX;           // VkDispatchIndirectCommand for sat_flare.comp (local_size 64)
    uint dispatchY;
    uint dispatchZ;
    uint drawVertexCount;     // VkDrawIndirectCommand for the three satellite point draws
    uint drawInstanceCount;
    uint drawFirstVertex;
    uint drawFirstInstance;
    SatVisible selected;      // written by sat_flare.comp only
    float selectedRawFlux;    // written by sat_flare.comp only (GPU parity, benchmarking M2)
    float selectedRangeM;
    uint  selectedFound;
    uint  selectedPad;
};

// Workgroup-aggregated append: one global atomicAdd per 64 satellites instead of one per
// visible satellite (several hundred thousand same-address atomics at 10M). Shared memory +
// barrier() rather than subgroup ballot — core GLSL 450, so nothing to check on MoltenVK/GCN1.
shared uint sWgCount;
shared uint sWgBase;

// ── Reflector ground targets: static per-target ECEF direction + ground radius ────────────────
// Uploaded once at target-generation time and never rewritten per frame (unlike the old per-frame
// CPU-compacted ECI buffer this replaced). xyz = unit ECEF direction, w = ground radius (m, incl.
// terrain elevation). This shader is the only reader — beam_cloud_block.comp, the buffer's other
// former reader, was retired 2026-08-09; beam_self_march.comp doesn't need it (see its own header).
// sat_orbit.comp rotates entries to ECI itself, either at the CURRENT instant (pc.gmstNow, for the
// actual live aim/beam position) or at an extrapolated window-boundary instant (see the
// TargetedReflector block below) — there is no day/night pre-filtering here, every loaded entry
// [0, pc.targetCount) is a real target and is scanned every time.
layout(set = 0, binding = 2) readonly buffer TargetECEFBuf {
    vec4 targetsECEF[];  // xyz=ECEF dir, w=ground radius (m)
};

// ── Reflect-Orbital ground beams (C12): capped atomic-append, no arbitration ────────────────
// History: azimuth-sector-keyed, then target-identity-keyed (1 slot/site), then 4 sub-slots/site
// — all still had a fixed slot (or small set of slots) that satellites competed for, so a site
// serviced by "dozens" of satellites (user report, 2026-07-21) kept showing visible churn as
// whichever few satellites currently won the slots changed. **Current design: no site keying,
// no deduplication, no arbitration at all.** Every satellite reaching this branch with a real
// target (bestIdx >= 0) claims its OWN slot via a single global atomicAdd counter and writes
// unconditionally — nothing to compete over, so nothing to glitch between. BEAM_MAX_ACTIVE is a
// generous headroom cap, not a "keep the best N" limit: a satellite must already clear the
// OBSERVER's own orbital horizon to reach this code at all (~2000+ km radius, enforced earlier
// in this shader for an unrelated reason), which bounds how many can simultaneously be eligible
// to roughly a few hundred at most even for a 5,000-satellite constellation — see
// TERRAIN_PLAN.md C12 follow-up #9. Zeroed every frame by vkCmdFillBuffer (resets beamCount to 0
// too). Must match GpuReflectBeam/GpuReflectBeams in SatelliteSim.h exactly.
#include "reflect_beam.glsl"   // ReflectBeam + BEAM_MAX_ACTIVE
layout(set = 0, binding = 3) buffer ReflectBeamsBuf {
    uint         beamCount; // atomicAdd counter — may exceed BEAM_MAX_ACTIVE
    uint         beamPad0, beamPad1, beamPad2; // std430 alignment padding, see SatelliteSim.h
    ReflectBeam  beams[BEAM_MAX_ACTIVE];
};

// C12 follow-up #31: beam-driven sky-glow "pollution dome" — parallel to the (CPU-computed)
// Light Pollution Dome's 16-sector scheme, populated here by ACTIVE beams instead of a static
// night-lights texture, so satellites/stars/Milky Way dim near a bright beam the same way they
// already dim near real light pollution. Stored as raw atomicMax'd uint bit-patterns
// (floatBitsToUint), same idiom as GlowBuf's bins in sat_flare.comp — reinterpret via
// uintBitsToFloat on read. Zeroed every frame by vkCmdFillBuffer. Must match
// kNumBeamGlowSectors in SatelliteSim.h (16) — a power of 2, needed for the `&` sector mask below.
const uint NUM_BEAM_GLOW_SECTORS = 16u;
layout(set = 0, binding = 4) buffer BeamGlowDomeBuf {
    uint beamGlowDome[NUM_BEAM_GLOW_SECTORS];
};

// ── Push constants ────────────────────────────────────────────────────────────
// Offsets verified against SatOrbitPC in SatelliteSim.h.
layout(push_constant) uniform PC {
    vec4  enuX;          // East  basis in ECI (w unused) — offset 0
    vec4  enuY;          // North basis in ECI (w unused) — offset 16
    vec4  enuZ;          // Up    basis in ECI (w unused) — offset 32
    vec3  sunDirECI;     // unit vector toward sun — offset 48
    float deltaT;        // simTime - epochT0 (float) — offset 60
    vec3  obsECI;        // observer ECI position (meters) — offset 64
    uint  satCount;      // total satellite count — offset 76
    uint  highlightMask; // bit i set = constellation i in highlight mode — offset 80
    uint  enabledMask;   // bit i set = constellation i is enabled — offset 84
    float simDt;         // simulated seconds this frame — offset 88
    float elevCutoff;    // sin(Earth-limb angle); horizon cull threshold (≤ -0.01) — offset 92
    float beamGain;          // Reflect-Orbital ground-beam intensity multiplier — offset 96
    float reflectorLockWindowS; // offset 100 — 2026-08-06: fixed-width sim-time window (seconds) a
                             // TargetedReflector satellite commits to one target for; also the
                             // extrapolation step used to reach a window's start instant from
                             // deltaT/gmstNow (see the TargetedReflector block below). Replaces the
                             // old rate-limited mirrorSlewDegPerSec.
    uint  targetCount;      // offset 104 — total loaded reflector targets (reflectorTargetCount).
                             // Replaces the old activeTargetCount / per-frame night-side compaction
                             // — this shader now scans every loaded target itself each frame.
    float minBeamElevSin;   // offset 108 — sin(minimum acceptable local elevation angle at a
                             // candidate target) — see the TargetedReflector block below. The only
                             // floor now; the old separate release floor/hysteresis is gone.
    float gmstNow;           // offset 112 — current-frame GMST (rad), for rotating a target's static
                             // ECEF entry to its LIVE ECI position. Replaces the old mirrorSnap flag.
    float windowFrac;        // offset 116 — fract(simTimeAbs / reflectorLockWindowS): fractional
                             // position within the current lock window, in [0,1). Replaces the old
                             // minBeamElevSinRelease.
    float mirrorMaxRateDegPerSec; // offset 120 — real angular-rate cap for the rate-limited ease in
                             // the TargetedReflector block (2026-08-06 same-day follow-up — the
                             // original crossfade wasn't derived from actual angular distance and
                             // didn't cover every transition case, which read as satellites
                             // snapping to target).
    float flareMitigationTiltRad; // offset 124 — was pad2. Global tilt read by JOINT_FLARE_TILT
                             // joints (flare mitigation for space datacenters) — see groupNormal() and
                             // AttitudeMode::SunTrackingTilted's comment in SatelliteSim.h.
} pc;

// ── Constants ─────────────────────────────────────────────────────────────────
const float PI            = 3.14159265358979;
const float TWO_PI        = 6.28318530717959;
const float SSO_PREC_RATE = TWO_PI / (365.25 * 86400.0); // rad/s
const float K_OMEGA_EARTH   = 7.2921150e-5; // rad/s, Earth sidereal rotation — matches CPU's kOmegaEarth

// Reflectance-model constants (moved from sat_flare.comp with the model itself — see that file's
// history for the reasoning behind each).
const float R_EARTH      = 6371000.0;   // Earth radius (meters)
const float REF_RANGE    = 500000.0;    // 500 km reference distance for 1/r² normalisation
// Eclipse cones: umbra/penumbra half-angles from the Sun's and Earth's real sizes. At LEO this
// reproduces the old fixed ±1% R_EARTH band (~64 km); at GEO the penumbra is ~400 km wide.
const float R_SUN         = 6.96e8;     // Sun radius (meters)
const float D_SUN         = 1.496e11;   // Earth-Sun distance, 1 AU (meters)
const float kTanUmbra     = (R_SUN - R_EARTH) / D_SUN;  // umbra cone narrows with distance
const float kTanPenumbra  = (R_SUN + R_EARTH) / D_SUN;  // penumbra cone widens with distance

// Attitude enums — must match AttTarget / AttLaw / JointMode in SatelliteSim.h.
const uint ATT_T_NADIR             = 0u;
const uint ATT_T_ZENITH            = 1u;
const uint ATT_T_SUN               = 2u;
const uint ATT_T_ANTI_SUN          = 3u;
const uint ATT_T_VELOCITY          = 4u;
const uint ATT_T_ANTI_VELOCITY     = 5u;
const uint ATT_T_ORBIT_NORMAL      = 6u;
const uint ATT_T_ANTI_ORBIT_NORMAL = 7u;
const uint ATT_T_SUN_REFLECT_NADIR = 8u;
const uint ATT_T_SUN_REFLECT_SITE  = 9u;

const uint ATT_LAW_TWO_VECTOR = 0u;
const uint ATT_LAW_TUMBLE     = 1u;

const uint JOINT_NONE       = 0u;
const uint JOINT_TRACK      = 1u;
const uint JOINT_EDGE_ON    = 2u;
const uint JOINT_FIXED      = 3u;
const uint JOINT_FLARE_TILT = 4u;

const uint ATT_NO_PARENT = 0xFFFFFFFFu;

// Phase 3 photometry. Radiant intensity I (m² per unit solar irradiance) at range r gives
// m = −26.74 − 2.5·log10(I/r²); the display chain's anchor is effectFlare 0.008 ↔ mag 6, so
// flare = 0.008·10^(0.4·(6 + 26.74))·I/r² = K_FLUX·I/r².
const float K_FLUX    = 9.979e10;
const float SUN_ALPHA = 0.0023;   // solar disk as a GGX half-vector α (kSunAlpha in SatModel.h)

// ── Integer hash for TargetedReflector target scoring ──────────────────────────
// 2026-08-06: replaces a float-magnitude-sensitive hash11(float) that silently collapsed to a
// constant 0.0 for every candidate once the satellite's global dispatch index exceeded ~15,000
// (verified: `x*0.1031` inside the old hash exceeded float32's 24-bit mantissa range at that
// magnitude, so `fract()` always returned exactly 0.0). Reflect Orbital satellites sit at global
// index ~57,000+ given the constellation upload order, so EVERY score was tied at 0.0 — argmax
// degenerated to "first eligible candidate in scan order," meaning only the lowest-original-index
// site among a satellite's simultaneously-eligible set ever won, and other co-eligible sites were
// never picked. All-integer arithmetic here is immune to that: no float precision to lose
// regardless of how large the indices get.
uint hashU(uint x) {
    x ^= x >> 16u; x *= 0x7feb352du;
    x ^= x >> 15u; x *= 0x846ca68bu;
    x ^= x >> 16u;
    return x;
}
// Pure function of the (satellite, target) pair — a satellite's preference ordering over sites,
// independent of scan order and of how many other candidates exist this frame.
float pairScore(uint a, uint b) {
    return float(hashU(a * 0x9E3779B9u ^ hashU(b))) * (1.0 / 4294967296.0);
}

// ── Data-driven attitude (lighting overhaul Phase 2) ──────────────────────────
// Replaces the hardcoded AttitudeMode switch (computeNormal). Every legacy mode is now data —
// see resolveAttitude()'s table in SatelliteSim.cpp for the exact mapping, which reproduces each
// legacy normal to float rounding (SunTracking/NadirPointing/AntiNadir/SunPerp/FlatMirror45/
// TargetedReflector/Tumbling exactly; KnifeEdge's roll and SunTrackingTilted's tilt via the same
// closed-form joint formulas the old code used).

// A direction an attitude law or joint aims at. `siteIdeal` is the TargetedReflector lock-window
// result (only computed when some group of this type targets ATT_T_SUN_REFLECT_SITE).
vec3 attTargetDir(uint t, vec3 nadir, vec3 vel, vec3 siteIdeal)
{
    switch (t) {
    case ATT_T_NADIR:         return nadir;
    case ATT_T_ZENITH:        return -nadir;
    case ATT_T_SUN:           return pc.sunDirECI;
    case ATT_T_ANTI_SUN:      return -pc.sunDirECI;
    case ATT_T_VELOCITY:      return vel;
    case ATT_T_ANTI_VELOCITY: return -vel;
    case ATT_T_ORBIT_NORMAL:      return normalize(cross(-nadir, vel));
    case ATT_T_ANTI_ORBIT_NORMAL: return -normalize(cross(-nadir, vel));
    case ATT_T_SUN_REFLECT_NADIR: {
        // The normal that reflects sunlight straight down (legacy FlatMirror45).
        vec3  n   = pc.sunDirECI + nadir;
        float len = length(n);
        return (len > 1e-5) ? n / len : nadir;
    }
    case ATT_T_SUN_REFLECT_SITE: return siteIdeal;
    }
    return nadir;
}

// Rotate v about unit axis k by theta (Rodrigues).
vec3 rotateAboutAxis(vec3 v, vec3 k, float theta)
{
    float c = cos(theta), s = sin(theta);
    return v * c + cross(k, v) * s + k * (dot(k, v) * (1.0 - c));
}

// World frame of group `g`: its columns are the world images of the ROOT's body-triad axes, so a
// body vector in root triad coordinates vT maps to world as F * vT. A root builds the frame from
// its attitude law; a child starts from its parent's frame (`parentF`). Either may then turn by its
// 1-DOF joint. Hand-mirrored on the CPU by evalGroupPoses() (SatModel.cpp) — keep them in step.
mat3 groupFrame(AttGroup g, mat3 parentF, SatOrbit orb, vec3 nadir, vec3 vel, vec3 siteIdeal)
{
    mat3 F;
    if (g.parent != ATT_NO_PARENT) {
        F = parentF;
    } else if (g.law == ATT_LAW_TUMBLE) {
        // Uncontrolled spin about this satellite's own axis (GpuSatOrbit tumble*). t1 sweeps the
        // plane perpendicular to the axis — exactly the legacy Tumbling normal for body +X.
        float angle = orb.tumblePhase + orb.tumbleRate * pc.deltaT;
        vec3  ax    = vec3(orb.tumbleAxisX, orb.tumbleAxisY, orb.tumbleAxisZ);
        vec3  ref   = (abs(ax.z) < 0.9) ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        vec3  axA   = normalize(cross(ax, ref));
        vec3  axB   = cross(ax, axA); // already unit length
        vec3  t1    = cos(angle) * axA + sin(angle) * axB;
        F = mat3(t1, cross(ax, t1), ax);
    } else {
        vec3  t1  = attTargetDir(g.primaryTarget, nadir, vel, siteIdeal);
        vec3  c   = cross(t1, attTargetDir(g.secondaryTarget, nadir, vel, siteIdeal));
        float len = length(c);
        if (len < 1e-5) {
            // Secondary target parallel to the primary (e.g. sun exactly along nadir): the roll
            // about t1 is undefined for an instant — pick any perpendicular.
            c   = cross(t1, (abs(t1.z) < 0.9) ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0));
            len = length(c);
        }
        vec3 t2 = c / len;
        F = mat3(t1, t2, cross(t1, t2));
    }
    if (g.jointMode == JOINT_NONE) return F;

    // ── 1-DOF joint: rotate the whole frame about the joint/hinge axis k ────
    vec3  k = normalize(F * g.jointAxisT);
    float theta;
    if (g.jointMode == JOINT_FIXED) {
        theta = g.jointAngleRad;
    } else if (g.jointMode == JOINT_FLARE_TILT) {
        // Legacy SunTrackingTilted: joint axis −Y on a sun/nadir group, so this pitches the sun-
        // facing normal toward zenith and dot(result, sun) == cos(tilt) exactly — the power-loss
        // readout in formatSelectedSatInfo() relies on that.
        theta = pc.flareMitigationTiltRad;
    } else {
        // Rotating body vector jv (⊥ k) by θ: jv(θ)·tgt = a·cosθ + b·sinθ.
        vec3  jv  = F * g.jointVectorT;
        vec3  tgt = attTargetDir(g.jointTarget, nadir, vel, siteIdeal);
        float a   = dot(tgt, jv);
        float b   = dot(tgt, cross(k, jv));
        if (g.jointMode == JOINT_TRACK) {
            theta = atan(b, a); // maximises jv·tgt
        } else {
            // JOINT_EDGE_ON (legacy KnifeEdge): jv ⊥ tgt has two solutions π apart — take the
            // smaller rotation, exactly as the old roll solver did.
            float th1 = atan(-a, b);
            float th2 = th1 + (th1 < 0.0 ? PI : -PI);
            theta = (abs(th1) <= abs(th2)) ? th1 : th2;
        }
        theta = clamp(theta, -g.jointLimitRad, g.jointLimitRad);
    }
    return mat3(rotateAboutAxis(F[0], k, theta), rotateAboutAxis(F[1], k, theta),
                rotateAboutAxis(F[2], k, theta));
}

// A child's parent is always a lower index, so frames are built in order into four fixed
// registers — explicit selects instead of a dynamically indexed local array, which would spill.
mat3 pickFrame(uint i, mat3 F0, mat3 F1, mat3 F2, mat3 F3)
{
    return (i == 0u) ? F0 : (i == 1u) ? F1 : (i == 2u) ? F2 : F3;
}

void typeFrames(uint ti, SatOrbit orb, vec3 nadir, vec3 vel, vec3 siteIdeal,
                out mat3 F0, out mat3 F1, out mat3 F2, out mat3 F3)
{
    uint n = types[ti].groupCount;
    F0 = groupFrame(types[ti].groups[0], mat3(1.0), orb, nadir, vel, siteIdeal);
    F1 = F0; F2 = F0; F3 = F0;
    if (n > 1u) F1 = groupFrame(types[ti].groups[1], F0, orb, nadir, vel, siteIdeal);
    if (n > 2u) F2 = groupFrame(types[ti].groups[2], pickFrame(types[ti].groups[2].parent, F0, F1, F1, F1),
                                orb, nadir, vel, siteIdeal);
    if (n > 3u) F3 = groupFrame(types[ti].groups[3], pickFrame(types[ti].groups[3].parent, F0, F1, F2, F2),
                                orb, nadir, vel, siteIdeal);
}

// True when any of this type's groups aims at a ground site — the only case that needs the
// TargetedReflector lock-window search. Uniform per type, so no divergence within a constellation.
bool typeUsesGroundSite(uint typeIdx)
{
    for (uint gi = 0u; gi < types[typeIdx].groupCount; ++gi) {
        AttGroup g = types[typeIdx].groups[gi];
        if (g.law != ATT_LAW_TWO_VECTOR) continue;
        if (g.primaryTarget == ATT_T_SUN_REFLECT_SITE || g.secondaryTarget == ATT_T_SUN_REFLECT_SITE)
            return true;
        if ((g.jointMode == JOINT_TRACK || g.jointMode == JOINT_EDGE_ON) &&
            g.jointTarget == ATT_T_SUN_REFLECT_SITE)
            return true;
    }
    return false;
}

// ── TargetedReflector helpers ───────────────────────────────────────────────────
// All pure functions of their arguments — no persisted state anywhere in this file.

// Satellite's own ECI position at an arbitrary evalDeltaT, using the same closed-form math main()
// uses for the real position. Exact (not approximate): orbital phase and RAAN precession are both
// modeled as exactly linear in time, so evaluating at a different deltaT is algebraically
// equivalent to the CPU having computed deltaT relative to a different reference instant.
vec3 satEciAt(SatOrbit orb, float evalDeltaT)
{
    float u    = mod(orb.u0 + orb.meanMot * evalDeltaT, TWO_PI);
    float cosU = cos(u);
    float sinU = sin(u);
    float cosR, sinR;
    if (orb.alignTerminator > 0.5) {
        float liveRaan = mod(orb.raan + SSO_PREC_RATE * evalDeltaT, TWO_PI);
        cosR = cos(liveRaan);
        sinR = sin(liveRaan);
    } else {
        cosR = orb.cosRaan;
        sinR = orb.sinRaan;
    }
    float ex = cosR * cosU - sinR * sinU * orb.cosI;
    float ey = sinR * cosU + cosR * sinU * orb.cosI;
    float ez = sinU * orb.sinI;
    return vec3(ex, ey, ez) * orb.R_sat;
}

// Rotates a unit ECEF direction to ECI by Earth's rotation angle gmst (rad). Length-preserving.
vec3 rotateEcefToEci(vec3 ecefDir, float gmst)
{
    float c = cos(gmst), s = sin(gmst);
    return vec3(c * ecefDir.x - s * ecefDir.y, s * ecefDir.x + c * ecefDir.y, ecefDir.z);
}

// A target's ECI position at an arbitrary gmst — O(1), no scan.
vec3 targetPosAt(int oi, float gmst)
{
    vec4 ecefR = targetsECEF[oi];
    return ecefR.w * rotateEcefToEci(ecefR.xyz, gmst);
}

// A target's LIVE (current-frame, unquantized) ECI position.
vec3 targetLivePos(int oi)
{
    return targetPosAt(oi, pc.gmstNow);
}

// Ideal mirror half-vector aiming reflected sunlight at targetPos.
vec3 idealTowards(vec3 satEci, vec3 targetPos, vec3 fallback)
{
    vec3  toTarget = normalize(targetPos - satEci);
    vec3  n        = pc.sunDirECI + toTarget;
    float len      = length(n);
    return (len > 1e-5) ? n / len : fallback;
}

// Winning target (ORIGINAL index, or -1) for satellite satIdx at the given eval instant: argmax of
// pairScore among night-side (at that instant), elevation-eligible candidates. A pure function of
// its arguments — called once for the current lock window's own start instant and once for the
// PREVIOUS window's, so temporal stability comes from the window boundaries themselves, not from
// any persisted choice. (pairScore itself doesn't depend on the eval instant at all, only on the
// eligible SET — so as long as a satellite's top-scoring target stays eligible across consecutive
// windows, findWinner keeps returning it unprompted; a window boundary only actually changes the
// winner when the incumbent drops out of eligibility.)
int findWinner(uint satIdx, vec3 satEciEval, float gmstEval)
{
    int   best      = -1;
    float bestScore = -1.0;
    for (uint k = 0u; k < pc.targetCount; ++k) {
        vec4 ecefR = targetsECEF[k];
        vec3 tDir  = rotateEcefToEci(ecefR.xyz, gmstEval); // unit
        if (dot(tDir, pc.sunDirECI) >= 0.0) continue;       // day-side at this eval instant
        vec3  tPos    = ecefR.w * tDir;
        float sinElev = dot(tDir, normalize(satEciEval - tPos));
        if (sinElev < pc.minBeamElevSin) continue;
        float score = pairScore(satIdx, k);
        if (score > bestScore) { bestScore = score; best = int(k); }
    }
    return best;
}

// Nearest night-valid target's ideal aim direction, no elevation gate — the "there's nothing
// beam-worthy right now, but don't do anything jarring" pre-aim fallback. Evaluated at an
// arbitrary (satellite position, gmst) instant so it can serve both a live lookup and a
// window-start lookup with the same function.
vec3 nearFallbackIdeal(vec3 satEciEval, float gmstEval)
{
    vec3  nadirEval  = -normalize(satEciEval);
    vec3  zenithEval = -nadirEval;
    int   nearIdx = -1;
    float nearCos = -2.0;
    for (uint k = 0u; k < pc.targetCount; ++k) {
        vec4 ecefR = targetsECEF[k];
        vec3 tDir  = rotateEcefToEci(ecefR.xyz, gmstEval);
        if (dot(tDir, pc.sunDirECI) >= 0.0) continue;
        float c = dot(zenithEval, tDir);
        if (c > nearCos) { nearCos = c; nearIdx = int(k); }
    }
    if (nearIdx >= 0)
        return idealTowards(satEciEval, targetPosAt(nearIdx, gmstEval), nadirEval);
    vec3  n   = pc.sunDirECI + nadirEval;
    float len = length(n);
    return (len > 1e-5) ? n / len : nadirEval;
}

// ── Legacy two-surface reflectance (types without a geometry model) ────────────
// The pre-Phase-3 model, verbatim: two Phong-lobed surfaces + mirror spike + diffuse floor, in the
// tuned effectFlare units anchored at "Starlink ≈ mag 6". Kept so legacy/modded types render
// exactly as before; geometry-model types use modelFlux() instead.
float legacyFlux(vec3 surfN0, vec3 surfN1, vec3 satNadir, vec3 satToObs, float litFactor,
                 float earthIrr, float distFactor, float specExp0, float specExp1, float w1,
                 float diffuse, float mirrorFrac, float crossSection)
{
    // ── Multi-surface specular model ──────────────────────────────────────────
    // spec0 (primary surface) + spec1*w1 (secondary) + an isotropic diffuse floor. specExp == 0
    // uses the Lambertian phase (cos of sun–observer angle) instead of the specular pow().
    // Irradiance-weighted: a surface can only reflect what it receives, so each lobe is scaled by
    // irr = |dot(sun, normal)| (two-sided panels — whichever face is lit). Perpendicular/SunPerp
    // radiators are edge-on to the sun by construction, so irr ≈ 0 suppresses them automatically.

    // Primary surface
    float irr0   = abs(dot(pc.sunDirECI, surfN0));
    vec3  n0     = (dot(pc.sunDirECI, surfN0) >= 0.0) ? surfN0 : -surfN0;
    vec3  refl0  = reflect(-pc.sunDirECI, n0);
    // clamp (not just max(0,...)) is required: float rounding can push this dot a hair above 1.0,
    // and at mirrorExp's tens of thousands even a ~0.01% overshoot in the pow() base blows up to
    // +Infinity — which renders as a black hole exactly at the flare's peak.
    float spec0  = irr0 * ((specExp0 < 0.01)
                    ? max(0.0, dot(pc.sunDirECI, satToObs))
                    : pow(clamp(dot(refl0, satToObs), 0.0, 1.0), specExp0));

    // Secondary surface — irr1 = 0 for edge-on surfaces (e.g. Perpendicular radiators)
    float irr1   = abs(dot(pc.sunDirECI, surfN1));
    vec3  n1     = (dot(pc.sunDirECI, surfN1) >= 0.0) ? surfN1 : -surfN1;
    vec3  refl1  = reflect(-pc.sunDirECI, n1);
    float spec1  = irr1 * ((specExp1 < 0.01)
                    ? max(0.0, dot(pc.sunDirECI, satToObs))
                    : pow(clamp(dot(refl1, satToObs), 0.0, 1.0), specExp1));

    // ── Mirror peak: ultra-narrow specular spike ──────────────────────────────
    // Added on top of spec0 (primary Phong lobe); fires only when the sun-satellite-observer
    // triangle is almost perfectly aligned. mirrorExp ≫ specExp0 → sub-degree angular width.
    float mirrorExp  = max(specExp0 * mirrorBoost, 8000.0);
    float mirrorDot  = clamp(dot(refl0, satToObs), 0.0, 1.0);
    float mirrorPeak = irr0 * pow(mirrorDot, mirrorExp) * mirrorBoost;
    spec0 += mirrorPeak * mirrorFrac;

    // ── Earthshine BRDF — Earth illuminates from nadir direction ─────────────
    // Not multiplied by litFactor: eclipsed satellites still receive earthshine
    // from the illuminated hemisphere below (the dominant source of residual
    // brightness for satellites crossing into shadow near the terminator).
    float irrE0        = max(0.0, dot(satNadir, surfN0));
    vec3  nE0          = (dot(satNadir, surfN0) >= 0.0) ? surfN0 : -surfN0;
    vec3  reflE0       = reflect(-satNadir, nE0);
    float specE0       = irrE0 * ((specExp0 < 0.01)
                         ? max(0.0, dot(satNadir, satToObs))
                         : pow(max(0.0, dot(reflE0, satToObs)), specExp0));
    float irrE0b       = max(0.0, dot(satNadir, -surfN0)); // back face: diffuse only
    float specE0b      = irrE0b * diffuse;
    float irrE1        = max(0.0, dot(satNadir, surfN1));
    float specE1_earth = irrE1 * w1 * diffuse;
    float earthSpecular = specE0 + specE0b + specE1_earth;
    float earthFlare    = earthSpecular * earthIrr * distFactor * crossSection * brightnessScale;

    // crossSection = sqrt(area_m² / 10): larger structures reflect proportionally more flux.
    float specular   = spec0 + spec1 * w1 + diffuse;
    float solarFlare = specular * litFactor * distFactor * crossSection * brightnessScale;
    return solarFlare + earthFlare;
}

// ── Phase 3 geometry-model reflectance ────────────────────────────────────────
// Intensity of one facet lobe per unit irradiance from direction s, seen from o — Lambertian
// diffuse plus GGX/Schlick/Smith specular, the exact formula SatModel.cpp's validator uses.
// `srcA2` widens the lobe by the light source's size (SUN_ALPHA² for the sun; far larger for the
// Earth). sin²θh comes from the cross product, not 1−cos², so sub-degree mirror lobes stay precise
// in float.
float lobeIntensity(vec3 n, SatLobe L, vec3 s, vec3 o, float srcA2)
{
    float ns = dot(n, s), no = dot(n, o);
    if (ns <= 0.0 || no <= 0.0) return 0.0;
    float diffuseI = L.albedoD * (1.0 / PI) * L.diffArea * ns * no;
    vec3  h    = normalize(s + o);
    float nh   = dot(n, h);
    vec3  nxh  = cross(n, h);
    float a2   = L.alpha2Mat + srcA2;
    float den  = nh * nh * a2 + dot(nxh, nxh);
    float D    = a2 / (PI * den * den);
    float F    = L.f0 + (1.0 - L.f0) * pow(1.0 - clamp(dot(s, h), 0.0, 1.0), 5.0);
    float G1s  = 2.0 * ns / (ns + sqrt(a2 + (1.0 - a2) * ns * ns));
    float G1o  = 2.0 * no / (no + sqrt(a2 + (1.0 - a2) * no * no));
    return diffuseI + L.area * D * F * G1s * G1o * 0.25;
}

float modelIntensity(uint ti, mat3 F0, mat3 F1, mat3 F2, mat3 F3, vec3 s, vec3 o, float srcA2)
{
    float I = 0.0;
    uint first = types[ti].firstLobe;
    uint count = types[ti].lobeCount;
    for (uint li = first; li < first + count; ++li) {
        SatLobe L = lobes[li];
        vec3 n = pickFrame(L.group, F0, F1, F2, F3) * L.normalT;
        I += lobeIntensity(n, L, s, o, srcA2);
    }
    return I;
}

// Physical flux in effectFlare units: sunlight (× Earth-shadow factor) plus earthshine, where the
// lit Earth is a Lambertian disc of albedo 0.3 seen from the satellite. Its irradiance on a plate
// facing it is albedo · (R/d)² · (lit fraction) — the full view factor, ~0.25 of sunlight at LEO
// under a lit Earth. (The legacy model's (1 − R/d)/2 term is ~20× smaller; it stays as-is in
// legacyFlux so legacy types don't change.) Earth's angular radius ρ (sin ρ = R/d) widens every
// lobe's response to it: α ≈ tan(ρ/2).
float modelFlux(uint ti, mat3 F0, mat3 F1, mat3 F2, mat3 F3, vec3 satNadir, vec3 satToObs,
                float litFactor, float range, float rOverD, float illumFrac)
{
    float Isun = (litFactor > 0.0)
        ? modelIntensity(ti, F0, F1, F2, F3, pc.sunDirECI, satToObs, SUN_ALPHA * SUN_ALPHA) : 0.0;
    float earthE  = 0.3 * rOverD * rOverD * illumFrac;
    float cosRho  = sqrt(max(0.0, 1.0 - rOverD * rOverD));
    float alphaE  = rOverD / (1.0 + cosRho);  // tan(ρ/2)
    float Iearth = (earthE > 0.0)
        ? modelIntensity(ti, F0, F1, F2, F3, satNadir, satToObs, alphaE * alphaE) : 0.0;
    return K_FLUX * (Isun * litFactor + Iearth * earthE) / (range * range) * brightnessScale;
}

// Everything per-satellite. Returns false when the satellite is culled (nothing is appended);
// otherwise fills `rec` with its pre-photometry record. A function rather than main()'s body so
// main() can reach its workgroup barriers in uniform control flow — the early exits live here.
bool processSatellite(uint i, out SatVisible rec)
{
    SatOrbit orb = orbits[i];
    SatType  ty  = types[orb.typeIdx];

    // ── Disabled constellation: not appended ──────────────────────────────────
    if (((pc.enabledMask >> orb.constIdx) & 1u) == 0u)
        return false;

    // ── Orbital phase (epoch-delta trick for float precision) ─────────────────
    // orb.u0 = fmod(original_u0 + meanMot*epochT0, 2π), so phase = u0 + meanMot*deltaT.
    // Float precision of deltaT limits accuracy; re-upload GpuSatOrbit to reset when needed.
    float u    = mod(orb.u0 + orb.meanMot * pc.deltaT, TWO_PI);
    float cosU = cos(u);
    float sinU = sin(u);

    // ── RAAN ──────────────────────────────────────────────────────────────────
    float cosR, sinR;
    if (orb.alignTerminator > 0.5) {
        float liveRaan = mod(orb.raan + SSO_PREC_RATE * pc.deltaT, TWO_PI);
        cosR = cos(liveRaan);
        sinR = sin(liveRaan);
    } else {
        cosR = orb.cosRaan;
        sinR = orb.sinRaan;
    }

    // ── Satellite ECI position (Rz(RAAN) · Rx(incl) · perifocal) ─────────────
    float ex = cosR * cosU - sinR * sinU * orb.cosI;
    float ey = sinR * cosU + cosR * sinU * orb.cosI;
    float ez = sinU * orb.sinI;
    vec3 satECI = vec3(ex, ey, ez) * orb.R_sat;
    vec3 relPos = satECI - pc.obsECI;

    // ── Earth occultation cull ────────────────────────────────────────────────
    // When sinEl < elevCutoff the infinite line of sight passes through Earth
    // (follows from the limb-angle definition). The satellite is still visible if
    // it lies BETWEEN the observer and Earth (e.g. observer at 500 km looking down
    // at a satellite at 400 km). That case has the closest-approach point beyond
    // the satellite: t_min = obsR·|sinEl| ≥ range  ↔  obsR²·dotUp² ≥ lenSq²
    // Squaring avoids a sqrt while remaining exact.
    vec3  up    = pc.enuZ.xyz;
    float dotUp = dot(relPos, up);
    float lenSq = dot(relPos, relPos);

    if (dotUp < 0.0) {
        float ecutSq = pc.elevCutoff * pc.elevCutoff;
        if (dotUp * dotUp > ecutSq * lenSq) {
            // sinEl < elevCutoff: the infinite ray passes inside Earth.
            // Cull only if the closest approach is before the satellite (t_min < range).
            float obsR2 = dot(pc.obsECI, pc.obsECI);
            if (obsR2 * dotUp * dotUp < lenSq * lenSq) {
                return false; // occulted by Earth — not appended
            }
            // Closest approach is beyond the satellite: satellite is between
            // observer and Earth, not behind it. Fall through and render it.
        }
    }

    // (An elevation angle — asin of dotUp/range — used to be computed here purely so sat_flare.comp
    // could re-run the horizon cull on it. That cull now lives only above, so it's gone.)
    float range = sqrt(lenSq);

    // ── Attitude vectors ──────────────────────────────────────────────────────
    vec3 satNadir = -normalize(satECI);
    // Along-track velocity direction — derivative of ECI position w.r.t. mean anomaly.
    // Already unit length for circular orbits; used by KnifeEdge attitude.
    vec3 velHat = vec3(
        -sinU * cosR - cosU * orb.cosI * sinR,
        -sinU * sinR + cosU * orb.cosI * cosR,
         cosU * orb.sinI
    );

    // ── Ground-site mirror aim (TargetedReflector machinery) ──────────────────
    // Produces siteIdeal — the mirror normal that reflects sunlight onto this satellite's chosen
    // ground site — for any type with a group targeting ATT_T_SUN_REFLECT_SITE. The surface
    // normals themselves are resolved from the attitude groups further below.
    vec3  siteIdeal   = satNadir;
    int   bestIdx     = -1; // resolved ground-target ORIGINAL index; -1 = no beam-quality target
    float aimErrorRad = 0.0;
    bool  usesSite    = typeUsesGroundSite(orb.typeIdx);
    if (usesSite) {
        // 2026-08-06 reversibility rework, refined same day — see this file's header comment and
        // CLAUDE.md's TargetedReflector section for the full design. Summary: target IDENTITY is
        // chosen per fixed-width sim-time window (pc.reflectorLockWindowS), not by a persisted
        // per-satellite lock — the winner for a window is a pure function of that window's own
        // START instant, found by extrapolating this frame's deltaT/gmstNow back to it. That
        // extrapolation is EXACT (not approximate) for both quantities in this sim's model
        // (orbital phase and GMST are both exactly linear in time), so it is algebraically
        // identical to recomputing them from scratch relative to the window's start — no precision
        // or physical approximation beyond what deltaT/gmstNow already carry.
        //
        // Orientation is a rate-limited EASE, computed in closed form rather than integrated
        // frame-by-frame — accumulating a persisted "current attitude" is exactly what made the
        // old design history-dependent and irreversible. Instead, the mirror eases from a
        // deterministic "start-of-window" anchor toward the LIVE current ideal, over a duration
        // derived from the real angle to cover and pc.mirrorMaxRateDegPerSec — an actual rate cap,
        // not a fixed fraction of the window. The anchor is the ideal direction toward the
        // PREVIOUS window's own winner (itself just as deterministic as the current window's — one
        // window of lookback, not unbounded history), evaluated at THIS window's start instant so
        // it's directly comparable to the current window's own start-instant ideal. Every quantity
        // here is a pure function of the current frame's push constants, so the whole thing is
        // still reversible by construction: playing the same instant forward or backward yields
        // the identical ease.
        //
        // Per-satellite phase offset (2026-08-06 same-day follow-up): pc.windowFrac is a single
        // GLOBAL value, the same for every satellite this frame — without an offset, EVERY
        // TargetedReflector satellite hits its window boundary at the exact same sim-time instant,
        // so all of them ease toward a new target simultaneously, reading as one large synchronized
        // wave of motion no matter how the lock window or slew rate are tuned. Shifting each
        // satellite's own window schedule by a hash of its dispatch index desynchronizes that wave
        // while staying a pure function of (sim time, satellite index) — still fully reversible,
        // and cheap: fract(globalWindowFrac + perSatOffset) is exactly the fractional part of
        // ((simTimeAbs + offsetSeconds) / W), i.e. this satellite's OWN window fraction, with no
        // extra CPU-side work or push-constant fields needed.
        float phaseOffsetFrac = float(hashU(i * 0x2545F491u)) * (1.0 / 4294967296.0);
        float windowFracI     = fract(pc.windowFrac + phaseOffsetFrac);

        float toWinStart     = -windowFracI * pc.reflectorLockWindowS; // <=0: back to this window's start
        float toPrevWinStart = toWinStart - pc.reflectorLockWindowS;     // back to the PREVIOUS window's start

        float evalDeltaTCur  = pc.deltaT + toWinStart;
        float evalDeltaTPrev = pc.deltaT + toPrevWinStart;
        float gmstEvalCur    = pc.gmstNow + K_OMEGA_EARTH * toWinStart;
        float gmstEvalPrev   = pc.gmstNow + K_OMEGA_EARTH * toPrevWinStart;

        vec3 satEciCur  = satEciAt(orb, evalDeltaTCur);
        vec3 satEciPrev = satEciAt(orb, evalDeltaTPrev);

        bestIdx         = findWinner(i, satEciCur,  gmstEvalCur);  // THIS window's identity
        int bestIdxPrev = findWinner(i, satEciPrev, gmstEvalPrev); // PREVIOUS window's identity

        // Where the mirror was, right as this window began (previous window's target, evaluated at
        // THIS window's start instant) — and where it needs to end up, both at window start (to
        // size the ease duration off a stable, per-window angle) and live right now (the actual
        // blend target, so the mirror keeps tracking exactly once the ease completes).
        vec3 startAim = (bestIdxPrev >= 0)
            ? idealTowards(satEciCur, targetPosAt(bestIdxPrev, gmstEvalCur), -normalize(satEciCur))
            : nearFallbackIdeal(satEciCur, gmstEvalCur);
        vec3 destAtStart = (bestIdx >= 0)
            ? idealTowards(satEciCur, targetPosAt(bestIdx, gmstEvalCur), -normalize(satEciCur))
            : nearFallbackIdeal(satEciCur, gmstEvalCur);
        vec3 liveIdeal = (bestIdx >= 0)
            ? idealTowards(satECI, targetLivePos(bestIdx), satNadir)
            : nearFallbackIdeal(satECI, pc.gmstNow);

        float angle0       = acos(clamp(dot(startAim, destAtStart), -1.0, 1.0));
        float slewDuration = clamp(angle0 / radians(max(0.01, pc.mirrorMaxRateDegPerSec)),
                                    0.001, pc.reflectorLockWindowS);
        float tSinceStart  = windowFracI * pc.reflectorLockWindowS;
        float blend        = smoothstep(0.0, slewDuration, tSinceStart);

        vec3  mixedN   = mix(startAim, liveIdeal, blend);
        float mixedLen = length(mixedN);
        vec3  ideal    = (mixedLen > 1e-5) ? mixedN / mixedLen : liveIdeal;
        aimErrorRad    = acos(clamp(dot(ideal, liveIdeal), -1.0, 1.0));

        siteIdeal = ideal;
    }

    // ── Attitude: every group's world frame, parents first (Phase 2/3) ─────────
    mat3 F0, F1, F2, F3;
    typeFrames(orb.typeIdx, orb, satNadir, velHat, siteIdeal, F0, F1, F2, F3);
    // Legacy two-surface normals (also the mirror normal for ground-site beams).
    vec3 surfN0 = pickFrame(ty.surfGroup0, F0, F1, F2, F3) * ty.surfNormalT0;
    vec3 surfN1 = pickFrame(ty.surfGroup1, F0, F1, F2, F3) * ty.surfNormalT1;

    if (usesSite) {
        // The mirror is whichever surface is mounted on the site-aimed group (surface 0 for every
        // legacy TargetedReflector type, where it equals siteIdeal exactly).
        vec3 mirrorN = (types[orb.typeIdx].groups[ty.surfGroup0].primaryTarget == ATT_T_SUN_REFLECT_SITE ||
                        types[orb.typeIdx].groups[ty.surfGroup1].primaryTarget != ATT_T_SUN_REFLECT_SITE)
                           ? surfN0 : surfN1;

        // ── Ground beam (C12): write into reflectBeamsBuf if a real target is locked ──
        // Only meaningful when a beam-QUALITY target was actually found (bestIdx >= 0, elevation-
        // gated) — pre-aiming at the nearest night-valid target (above) has no real ground target
        // worth illuminating, by design.
        //
        // SITE-referenced, not OBSERVER-referenced (revised 2026-07-21): this used to also
        // require the TARGET to clear the observer's own local horizon (targetSinEl >
        // elevCutoff) before writing anything. That coupled beam existence to the observer's
        // exact position/altitude via a razor-thin geometric threshold — small movements (even
        // ~300m of altitude) could cross it and make every beam vanish, and because so few
        // satellites' targets ever happened to pass it, competing satellites fighting over the
        // rare passing slot could flip the displayed beam to the wrong satellite frame to frame.
        // The satellite itself already had to clear the OBSERVER's horizon to reach this code at
        // all (the occultation cull at the top of main() returns early otherwise) — LEO horizon
        // distance (~2000+ km) is generously larger than any range this feature could render
        // anything useful at, so that's a sufficient outer bound on its own. Every satellite that
        // reaches here with a real target now registers unconditionally; how close the OBSERVER
        // needs to be to actually see it is a render-time distance check in the consumer shaders
        // (cloud_march.comp / sat_sky.frag) instead, using a smooth cutoff rather than a fragile
        // horizon test — see TERRAIN_PLAN.md C12 follow-up #5 for the full rationale.
        if (bestIdx >= 0) {
            vec3 targetECI    = targetLivePos(bestIdx);
            vec3 targetRelPos = targetECI - pc.obsECI;
            vec3 targetENU    = vec3(dot(targetRelPos, pc.enuX.xyz),
                                      dot(targetRelPos, pc.enuY.xyz),
                                      dot(targetRelPos, pc.enuZ.xyz));
            vec3 satENU = vec3(dot(relPos, pc.enuX.xyz),
                                dot(relPos, pc.enuY.xyz),
                                dot(relPos, pc.enuZ.xyz));

            // Debug-only: the mirror's ACTUAL current reflected-sunlight direction — may differ
            // from normalize(targetECI-satECI) while the rate-limited ease (see aimErrorRad above)
            // is still catching up after a target change. A direction, not a position, so it
            // projects onto the ENU basis
            // directly (no obsECI subtraction needed).
            vec3 reflectDirECI = reflect(-pc.sunDirECI, mirrorN);
            vec3 reflectDirENU = vec3(dot(reflectDirECI, pc.enuX.xyz),
                                       dot(reflectDirECI, pc.enuY.xyz),
                                       dot(reflectDirECI, pc.enuZ.xyz));

            // Ground irradiance delivered by the mirror — a physically different quantity
            // from the view-dependent specular mirrorPeak term in sat_flare.comp (that
            // answers "how bright does the mirror look to the OBSERVER"; this answers "how
            // much sunlight lands on the ground target", independent of view angle). The
            // irradiance itself does NOT fall off with range for an idealized collimated flat
            // reflector — but the FOOTPRINT's SIZE still grows with range (C12 follow-up #34,
            // see mirrorRadiusM/footprintRadM below): the two are separate physical facts, and an
            // earlier version of this comment conflated them into "footprint tracks the mirror's
            // own size," which was never actually implemented that way and isn't correct — the
            // sun's own finite angular size means the reflected cone widens with distance
            // regardless of how collimated the mirror itself is.
            const float SOLAR_CONSTANT = 1361.0; // W/m^2 at Earth distance
            float mirrorAreaM2   = ty.crossSection * ty.crossSection * 10.0;
            float cosIncidence   = max(0.0, dot(mirrorN, pc.sunDirECI));
            float groundIrradiance = SOLAR_CONSTANT * mirrorAreaM2 * ty.mirrorFrac * cosIncidence;
            float intensity = groundIrradiance * pc.beamGain;

            if (intensity > 0.0) {
                // C12 follow-up #31: contribute to the directional sky-glow suppression dome —
                // independent of whether this beam's own entry makes it into BEAM_MAX_ACTIVE
                // below (the dome has no list/capacity to overflow). `intensity` does NOT fall
                // off with observer distance by physical design (see groundIrradiance's own
                // comment above) — correct for the ground target's OWN illumination, but wrong
                // for how far this beam should suppress background objects AS SEEN FROM THE
                // OBSERVER, so add an explicit distance falloff here specifically for the dome (a
                // beam on the far side of the planet at the same azimuth as a star must not
                // suppress it).
                float targetDist        = length(targetENU);
                const float kBeamDomeRangeM    = 80000.0;  // first-pass guess, tunable
                // C12 follow-up #32: 3e-8 was WAY too small — for a well-aligned Reflect Mirror
                // (crossSectionM2=2376, mirrorFrac=0.97), intensity peaks around ~3.1e6, giving
                // domeRaw ~ 0.09 and domeVal ~ 0.086 even at point-blank range — nowhere near
                // enough to visibly compete against kBeamDomeCompressK=1.0's denominator, which is
                // why the Milky Way (and likely satellites/stars too, just less noticeably against
                // a point source) weren't visibly dimming near a beam. Retuned so a well-aligned
                // close mirror reaches domeRaw ~ 6 (domeVal ~ 0.86) instead.
                const float kBeamDomeScale     = 2e-3;
                const float kBeamDomeCompressK = 1.0;      // Reinhard-style, keeps domeVal in [0,1)
                float distFade = exp(-targetDist / kBeamDomeRangeM);
                float domeRaw  = intensity * distFade * kBeamDomeScale;
                float domeVal  = domeRaw / (domeRaw + kBeamDomeCompressK);
                if (domeVal > 0.0) {
                    float az     = mod(atan(targetENU.x, targetENU.y) + TWO_PI, TWO_PI);
                    uint  sector = uint(az * (float(NUM_BEAM_GLOW_SECTORS) / TWO_PI)) & (NUM_BEAM_GLOW_SECTORS - 1u);
                    atomicMax(beamGlowDome[sector], floatBitsToUint(domeVal));
                }

                // C12 follow-up #34: physically-derived footprint radius, replacing the old flat
                // pc.beamFootprintRadM constant. The dominant spreading mechanism for a large flat
                // mirror reflecting sunlight isn't diffraction off the mirror's own aperture
                // (~1e-8 rad for a ~48m mirror — utterly negligible) — it's that the SUN isn't a
                // point source: its mean angular radius means even a perfectly flat mirror
                // reflects a cone of that half-angle, so the beam widens with distance regardless
                // of how collimated the mirror itself is. mirrorRadiusM (the mirror's own
                // equivalent-circle size) is also stored per-beam — cloud_march.comp's sky tube
                // and sat_sky.frag's ground-spot core both need it downstream.
                float mirrorRadiusM = sqrt(mirrorAreaM2 / PI);
                float slantRangeM   = length(satENU - targetENU); // true 3D mirror->target distance
                const float kSunAngularRadiusRad = 0.0046505; // sun's mean angular radius, ~0.2665 deg
                float footprintRadM = mirrorRadiusM + slantRangeM * tan(kSunAngularRadiusRad);

                // No site keying, no arbitration (C12 follow-up #9) — every satellite that
                // reaches here claims its own unique slot and writes unconditionally.
                uint slot = atomicAdd(beamCount, 1u);
                if (slot < BEAM_MAX_ACTIVE) {
                    beams[slot].satENU        = satENU;
                    beams[slot].intensity      = intensity;
                    beams[slot].targetENU      = targetENU;
                    beams[slot].footprintRadM  = footprintRadM;
                    beams[slot].reflectDirENU  = reflectDirENU;
                    // Repurposed (C12 follow-up #20): was pure std430 padding, unused. Carries
                    // this satellite's own stable dispatch index `i` — NOT the atomic-append slot
                    // `slot` itself, which races across satellites and isn't stable frame-to-frame.
                    // cloud_march.comp's sky glow uses this to downsample by a STABLE subset of
                    // satellites (mod(debugPad, stride)==0) instead of by slot index, which would
                    // show a different random subset each frame (visible flicker).
                    beams[slot].debugPad       = float(i);
                    // blockAltM/blockOpacity are intentionally left unwritten here (2026-08-09 —
                    // was: copied from beam_cloud_block.comp's per-TARGET vertical-column result).
                    // beam_self_march.comp now runs immediately after this shader, dispatched over
                    // this exact same [0, beamCount) range, and unconditionally overwrites both
                    // fields for every slot with a real per-BEAM slant march — see that file's own
                    // header for why. No read-before-write hazard: nothing reads these fields
                    // between this shader finishing and beam_self_march.comp's own write.
                    beams[slot].mirrorRadiusM  = mirrorRadiusM;
                    beams[slot].aimErrorRad    = aimErrorRad;
                    // 2026-08-12: the resolved target's ORIGINAL index. Guaranteed >= 0 here —
                    // this whole block is inside `if (bestIdx >= 0)`. Costs nothing to write and
                    // gives the CPU cloud-light build a stable integer cluster key, replacing the
                    // seed-dependent targetENU epsilon match. See reflect_beam.glsl's field comment.
                    beams[slot].targetIdx      = uint(bestIdx);
                    beams[slot].pad0 = 0u;
                    beams[slot].pad1 = 0u;
                    beams[slot].pad2 = 0u;
                }
            }
        }
    }

    // ── ECI-relative position → local ENU sky direction ───────────────────────
    vec3 enu = vec3(dot(relPos, pc.enuX.xyz), dot(relPos, pc.enuY.xyz), dot(relPos, pc.enuZ.xyz));
    vec3 skyDir    = normalize(enu);
    vec3 baseColor = vec3(ty.baseColorR, ty.baseColorG, ty.baseColorB);

    // ── Highlight mode: fixed-brightness census view ──────────────────────────
    // Every above-horizon satellite of a highlighted constellation is drawn at a fixed intensity,
    // bypassing all lighting — sat_flare.comp sees the negative flareIntensity and emits the fixed
    // dot. (Was signalled by a diffuse=2.0 sentinel through GpuSatInput.) The beam bookkeeping
    // above still ran: highlight is a display mode and must not change what the mirrors do.
    if (bool((pc.highlightMask >> orb.constIdx) & 1u)) {
        rec = SatVisible(skyDir, -1.0, baseColor, range);
        return true;
    }

    // ── Distance falloff (inverse-square law, normalised to REF_RANGE) ──────────
    // Physically: reflected flux ∝ 1/r². Clamped at 1.0 so sats closer than
    // REF_RANGE don't over-brighten. GEO at 35 786 km ≈ 0.02% of LEO brightness.
    float distFactor = REF_RANGE / max(range, REF_RANGE);
    distFactor *= distFactor;  // 1/r²

    // ── Soft Earth shadow (umbra/penumbra cones) ──────────────────────────────
    // Project the satellite onto the shadow axis and measure how far its cross-sectional radius
    // is from the umbra/penumbra cone radii AT THAT DISTANCE — not a fixed-width band.
    // smoothstep between the two cone radii gives a penumbra whose width scales with altitude.
    vec3  shadowDir = -pc.sunDirECI;               // points away from sun
    float proj      = dot(satECI, shadowDir);       // + = on the night side
    vec3  perpVec   = satECI - proj * shadowDir;    // component ⊥ shadow axis
    float perpLen   = length(perpVec);
    float dShadow   = max(proj, 0.0);                        // distance behind Earth center
    float rUmbra    = max(0.0, R_EARTH - dShadow * kTanUmbra);
    float rPenumbra = R_EARTH + dShadow * kTanPenumbra;
    float litFactor = (proj > 0.0)
        ? smoothstep(rUmbra, rPenumbra, perpLen)
        : 1.0;

    // ── Earthshine irradiance (analytical horizon correction) ─────────────────
    // illumFrac: fraction of the visible Earth cap that lies on the lit side.
    // Transitions in cosAlpha space over the angular width of the cap (2×sinEta),
    // replacing the naive sinusoid that treats Earth as a point source.
    const float EARTH_ALBEDO = 0.3;
    float cosAlpha      = dot(-satNadir, pc.sunDirECI); // cos(sat-zenith / sun angle)
    float cosEta        = R_EARTH / orb.R_sat;          // cos of Earth's angular radius
    float sinEta        = sqrt(max(0.0, 1.0 - cosEta * cosEta));
    float illumFrac     = clamp((cosAlpha + sinEta) / (2.0 * sinEta), 0.0, 1.0);
    float solidAngleFrac = (1.0 - cosEta) * 0.5;       // fraction of upward hemisphere
    float earthIrr      = EARTH_ALBEDO * solidAngleFrac * illumFrac;

    // ── Reflectance ─────────────────────────────────────────────────────────────
    vec3  satToObs = normalize(-relPos);
    float flare = (ty.lobeCount > 0u)
        ? modelFlux(orb.typeIdx, F0, F1, F2, F3, satNadir, satToObs, litFactor, range, cosEta, illumFrac)
        : legacyFlux(surfN0, surfN1, satNadir, satToObs, litFactor, earthIrr, distFactor,
                     ty.specExp0, ty.specExp1, ty.w1, ty.diffuse, ty.mirrorFrac, ty.crossSection);

    // ── Eclipse reddening ──────────────────────────────────────────────────────
    // Sunlight reaching a satellite deep in the penumbra grazes Earth's atmosphere along a long
    // slant path, so Rayleigh scattering strips blue/green out of it. Tint peaks mid-transition
    // (litFactor≈0.5) and vanishes at both ends.
    const vec3 kEclipseTint = vec3(1.0, 0.45, 0.15);      // grazing-path Rayleigh reddening
    float eclipseTintAmt    = 4.0 * litFactor * (1.0 - litFactor); // 0 at ends, 1 at litFactor=0.5
    vec3  outBaseColor      = mix(baseColor, baseColor * kEclipseTint, eclipseTintAmt);

    // Raw flux + range; sat_flare.comp applies sky/extinction/pollution, the ceiling, the
    // visibility cull and the sprite size.
    rec = SatVisible(skyDir, flare, outBaseColor, range);
    return true;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    SatVisible rec;
    bool vis = (i < pc.satCount) && processSatellite(i, rec);

    // ── Workgroup-aggregated append into the compact list ─────────────────────
    // Every barrier() below is reached by all 64 invocations (no early return above this point).
    if (gl_LocalInvocationIndex == 0u) sWgCount = 0u;
    memoryBarrierShared();
    barrier();

    uint localSlot = 0u;
    if (vis) localSlot = atomicAdd(sWgCount, 1u);
    memoryBarrierShared();
    barrier();

    if (gl_LocalInvocationIndex == 0u && sWgCount > 0u) {
        uint base = atomicAdd(listCount, sWgCount);
        uint end  = base + sWgCount;
        atomicMax(drawVertexCount, end);
        atomicMax(dispatchX, (end + 63u) / 64u);
        sWgBase = base;
    }
    memoryBarrierShared();
    barrier();

    if (vis) {
        uint slot = sWgBase + localSlot;
        visible[slot]       = rec;
        visibleSatIdx[slot] = i;
    }
}
