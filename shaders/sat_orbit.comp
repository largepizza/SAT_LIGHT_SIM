// ── sat_orbit.comp ────────────────────────────────────────────────────────────
// Compute shader: per-satellite orbital mechanics + attitude normals.
// Runs before sat_flare.comp each frame; replaces the CPU updatePositions() loop.
//
// Reads:
//   binding 0  satOrbitBuf     — GpuSatOrbit array, uploaded once at init
//   binding 2  mirrorNormalsBuf — persistent mirror slew state (TargetedReflector)
//   binding 3  reflectorTargetBuf — valid night-side ground targets, updated each frame
//
// Writes:
//   binding 1  SatInputBuf     — GpuSatInput array consumed by sat_flare.comp
//   binding 2  mirrorNormalsBuf — updated slew state written back in-place
//   binding 4  reflectBeamsBuf — Reflect-Orbital ground beams (C12), capped atomic-append, no arbitration;
//                                zeroed each frame by vkCmdFillBuffer, consumed by
//                                cloud_march.comp (volumetric in-scatter) and sat_sky.frag
//                                (ground-spot direct lighting)
//   binding 6  beamCloudBlockBuf — per-target cloud occlusion (C12 follow-up #33), written by
//                                beam_cloud_block.comp earlier this frame; read here to bake
//                                blockAltM/blockOpacity into each beam
//
// Below-horizon and disabled satellites write elevation = -π/2 and return early.
// sat_flare.comp's existing horizon cull (elevation < -0.01 rad) discards them.
// ─────────────────────────────────────────────────────────────────────────────

#version 450
layout(local_size_x = 64) in;

// ── GpuSatOrbit: all floats/uints, no vec3 (avoids std430 padding) ─────────
// 28 × 4-byte fields = 112 bytes. Must match GpuSatOrbit in SatelliteSim.h.
struct SatOrbit {
    float raan;               // right ascension of ascending node at epoch
    float u0;                 // epoch-baked initial phase: fmod(orig_u0 + meanMot*epochT0, 2π)
    float R_sat;              // kEarthRadius + altM (meters)
    float meanMot;            // sqrt(GM/R³) (rad/s)

    float cosI;               // cos(inclination)
    float sinI;               // sin(inclination)
    float cosRaan;            // cos(raan) — used when alignTerminator < 0.5
    float sinRaan;            // sin(raan) — used when alignTerminator < 0.5

    float tumbleRate;         // rotation rate (rad/s); 0 = not tumbling
    float tumblePhase;        // epoch-baked tumble angle: fmod(phase + rate*epochT0, 2π)
    float alignTerminator;    // 1.0 = SSO (RAAN precesses); 0.0 = fixed RAAN
    float tumbleAxisX;        // tumble axis unit vector x

    float tumbleAxisY;        // tumble axis unit vector y
    float tumbleAxisZ;        // tumble axis unit vector z
    uint  primaryAttitude;    // AttitudeMode enum value (see constants below)
    uint  secondaryAttitude;  // AttitudeMode enum value

    float baseColorR;         // satellite tint (r)
    float baseColorG;         // satellite tint (g)
    float baseColorB;         // satellite tint (b)
    float crossSection;       // sqrt(area_m² / 10)

    float specExp0;           // primary specular exponent
    float specExp1;           // secondary specular exponent
    float w1;                 // secondary surface weight
    float diffuse;            // isotropic Lambertian floor

    float mirrorFrac;         // near-perfect mirror fraction
    uint  constIdx;           // constellation index (for enabledMask/highlightMask)
    uint  pad0;               // padding
    uint  pad1;               // padding
};

layout(set = 0, binding = 0) readonly buffer SatOrbitBuf {
    SatOrbit orbits[];
};

// ── GpuSatInput output: consumed by sat_flare.comp ───────────────────────────
// std430 layout: each vec3+float pair packs into one 16-byte block.
// Must match GpuSatInput (80 bytes) in SatelliteSim.h and sat_flare.comp.
struct SatInput {
    vec3  eciRelPos;    // observer-relative ECI position (meters)
    float range;
    vec3  surfN0;       // primary surface normal (ECI)
    float elevation;    // radians; -π/2 = below-horizon sentinel
    vec3  surfN1;       // secondary surface normal (ECI)
    float specExp0;
    vec3  baseColor;
    float specExp1;
    float crossSection;
    float w1;
    float diffuse;
    float mirrorFrac;
};
layout(set = 0, binding = 1) buffer SatInputBuf {
    SatInput satellites[];
};

// ── Mirror normals: persistent slew state for TargetedReflector ──────────────
// xyz = current mirror normal in ECI, w = 0 (uninitialized) or 1 (active).
layout(set = 0, binding = 2) buffer MirrorNormalBuf {
    vec4 mirrorNormals[];
};

// ── Reflector ground targets: updated each frame by CPU ───────────────────────
// xyz = ECI position (Earth-radius-scaled), w = 1.0 valid / 0.0 invalid.
layout(set = 0, binding = 3) readonly buffer ReflectorTargetBuf {
    vec4 reflTargets[];  // xyz=posECI, w=valid
};

// ── Reflect-Orbital ground beams (C12): capped atomic-append, no arbitration ────────────────
// History: azimuth-sector-keyed, then target-identity-keyed (1 slot/site), then 4 sub-slots/site
// — all still had a fixed slot (or small set of slots) that satellites competed for, so a site
// serviced by "dozens" of satellites (user report, 2026-07-21) kept showing visible churn as
// whichever few satellites currently won the slots changed. **Current design: no site keying,
// no deduplication, no arbitration at all.** Every satellite reaching this branch with a real
// target (bestIdx >= 0) claims its OWN slot via a single global atomicAdd counter and writes
// unconditionally — nothing to compete over, so nothing to glitch between. BEAM_MAX_ACTIVE is a
// generous headroom cap, not a "keep the best N" limit: a satellite must already clear the
// OBSERVER's own orbital horizon to reach this code at all (~2000+ km radius, enforced earlier
// in this shader for an unrelated reason), which bounds how many can simultaneously be eligible
// to roughly a few hundred at most even for a 5,000-satellite constellation — see
// TERRAIN_PLAN.md C12 follow-up #9. Zeroed every frame by vkCmdFillBuffer (resets beamCount to 0
// too). Must match GpuReflectBeam/GpuReflectBeams in SatelliteSim.h exactly.
#include "reflect_beam.glsl"   // ReflectBeam + BEAM_MAX_ACTIVE
layout(set = 0, binding = 4) buffer ReflectBeamsBuf {
    uint         beamCount; // atomicAdd counter — may exceed BEAM_MAX_ACTIVE
    uint         beamPad0, beamPad1, beamPad2; // std430 alignment padding, see SatelliteSim.h
    ReflectBeam  beams[BEAM_MAX_ACTIVE];
};

// C12 follow-up #31: beam-driven sky-glow "pollution dome" — parallel to the (CPU-computed)
// Light Pollution Dome's 16-sector scheme, populated here by ACTIVE beams instead of a static
// night-lights texture, so satellites/stars/Milky Way dim near a bright beam the same way they
// already dim near real light pollution. Stored as raw atomicMax'd uint bit-patterns
// (floatBitsToUint), same idiom as GlowBuf's bins in sat_flare.comp — reinterpret via
// uintBitsToFloat on read. Zeroed every frame by vkCmdFillBuffer. Must match
// kNumBeamGlowSectors in SatelliteSim.h (16) — a power of 2, needed for the `&` sector mask below.
const uint NUM_BEAM_GLOW_SECTORS = 16u;
layout(set = 0, binding = 5) buffer BeamGlowDomeBuf {
    uint beamGlowDome[NUM_BEAM_GLOW_SECTORS];
};

// C12 follow-up #33: per-target cloud occlusion, written by beam_cloud_block.comp EARLIER this
// same frame (dispatched before this shader in recordCompute(), with a barrier in between).
// x = blockAltM, y = blockOpacity — indexed directly by bestIdx (0..200), copied straight into
// each beam's own ReflectBeam entry below. Must match kNumReflectorTargets in SatelliteSim.h.
layout(set = 0, binding = 6) readonly buffer BeamCloudBlockBuf {
    vec2 beamCloudBlock[];
};

// ── Push constants ────────────────────────────────────────────────────────────
// Offsets verified against SatOrbitPC in SatelliteSim.h.
layout(push_constant) uniform PC {
    vec4  enuX;          // East  basis in ECI (w unused) — offset 0
    vec4  enuY;          // North basis in ECI (w unused) — offset 16
    vec4  enuZ;          // Up    basis in ECI (w unused) — offset 32
    vec3  sunDirECI;     // unit vector toward sun — offset 48
    float deltaT;        // simTime - epochT0 (float) — offset 60
    vec3  obsECI;        // observer ECI position (meters) — offset 64
    uint  satCount;      // total satellite count — offset 76
    uint  highlightMask; // bit i set = constellation i in highlight mode — offset 80
    uint  enabledMask;   // bit i set = constellation i is enabled — offset 84
    float simDt;         // simulated seconds this frame (mirror slew) — offset 88
    float elevCutoff;    // sin(Earth-limb angle); horizon cull threshold (≤ -0.01) — offset 92
    float beamGain;          // Reflect-Orbital ground-beam intensity multiplier — offset 96
    float mirrorSlewDegPerSec; // offset 100 — C12 follow-up #20: settings-tunable mirror slew rate
                             // (was a hardcoded 1 deg/sec constant, MIRROR_ROT_RATE). C12 follow-up
                             // #34: was offset 104 — beamFootprintRadM (the old flat-constant
                             // footprint override) removed entirely; footprint is now physically
                             // derived from mirror area + range at the write site below.
} pc;

// ── Constants ─────────────────────────────────────────────────────────────────
const float PI            = 3.14159265358979;
const float TWO_PI        = 6.28318530717959;
const float SSO_PREC_RATE = TWO_PI / (365.25 * 86400.0); // rad/s
const float KNIFE_MAX_ROLL  = TWO_PI * (10.0/360.0); // 10 deg

// AttitudeMode enum values — must match C++ enum in SatelliteSim.h.
const uint AM_NADIR_POINTING     = 0u;
const uint AM_SUN_TRACKING       = 1u;
const uint AM_TUMBLING           = 2u;
const uint AM_PERPENDICULAR      = 3u;
const uint AM_ANTI_NADIR         = 4u;
const uint AM_FLAT_MIRROR_45     = 5u;
const uint AM_TARGETED_REFLECTOR = 6u;
const uint AM_KNIFE_EDGE         = 7u;
const uint AM_SUN_PERP           = 8u;  // cross(sunDir, satNadir) — thermal radiator edge-on to sun

// Number of reflector targets — must match kNumReflectorTargets in SatelliteSim.h.
const int NUM_TARGETS = 201;

// ── Compute a surface normal for non-TargetedReflector attitude modes ─────────
vec3 computeNormal(uint mode, SatOrbit orb, vec3 satNadir, vec3 velHat, vec3 primary)
{
    if (mode == AM_NADIR_POINTING)  return satNadir;
    if (mode == AM_ANTI_NADIR)      return -satNadir;
    if (mode == AM_SUN_TRACKING)    return pc.sunDirECI;

    if (mode == AM_TUMBLING) {
        float angle = orb.tumblePhase + orb.tumbleRate * pc.deltaT;
        vec3  ax    = vec3(orb.tumbleAxisX, orb.tumbleAxisY, orb.tumbleAxisZ);
        vec3  ref   = (abs(ax.z) < 0.9) ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
        vec3  axA   = normalize(cross(ax, ref));
        vec3  axB   = cross(ax, axA); // already unit length
        return cos(angle) * axA + sin(angle) * axB;
    }

    if (mode == AM_PERPENDICULAR) {
        vec3  perp = cross(primary, satNadir);
        float len  = length(perp);
        return (len > 1e-5) ? perp / len : satNadir;
    }

    if (mode == AM_FLAT_MIRROR_45) {
        vec3  n   = pc.sunDirECI + satNadir;
        float len = length(n);
        return (len > 1e-5) ? n / len : satNadir;
    }

    if (mode == AM_KNIFE_EDGE) {
        vec3  ct     = cross(velHat, satNadir); // unit: velHat ⊥ satNadir for circular orbits
        float a      = dot(pc.sunDirECI, satNadir);
        float b      = dot(pc.sunDirECI, ct);
        float theta1 = atan(-a, b);
        float theta2 = theta1 + (theta1 < 0.0 ? PI : -PI);
        float theta  = (abs(theta1) <= abs(theta2)) ? theta1 : theta2;
        theta = clamp(theta, -KNIFE_MAX_ROLL, KNIFE_MAX_ROLL);
        return cos(theta) * satNadir + sin(theta) * ct;
    }

    if (mode == AM_SUN_PERP) {
        // Thermal radiator panel on a nadir-locked bus whose yaw is constrained by
        // sun-tracking solar wings.  Normal is perpendicular to both sun and nadir,
        // so the panel is always edge-on to the sun (dot(sun, normal) = 0 exactly).
        // Falls back to satNadir when sun is nearly parallel to nadir (subsolar point).
        vec3  n   = cross(pc.sunDirECI, satNadir);
        float len = length(n);
        return (len > 1e-5) ? n / len : satNadir;
    }

    // Default / AM_SUN_TRACKING fallback
    return pc.sunDirECI;
}

void main()
{
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.satCount) return;

    SatOrbit orb = orbits[i];

    // ── Disabled constellation: write sentinel and skip ───────────────────────
    if (((pc.enabledMask >> orb.constIdx) & 1u) == 0u) {
        satellites[i].elevation = -1.5708; // -π/2 sentinel
        return;
    }

    // ── Orbital phase (epoch-delta trick for float precision) ─────────────────
    // orb.u0 = fmod(original_u0 + meanMot*epochT0, 2π), so phase = u0 + meanMot*deltaT.
    // Float precision of deltaT limits accuracy; re-upload GpuSatOrbit to reset when needed.
    float u    = mod(orb.u0 + orb.meanMot * pc.deltaT, TWO_PI);
    float cosU = cos(u);
    float sinU = sin(u);

    // ── RAAN ──────────────────────────────────────────────────────────────────
    float cosR, sinR;
    if (orb.alignTerminator > 0.5) {
        float liveRaan = mod(orb.raan + SSO_PREC_RATE * pc.deltaT, TWO_PI);
        cosR = cos(liveRaan);
        sinR = sin(liveRaan);
    } else {
        cosR = orb.cosRaan;
        sinR = orb.sinRaan;
    }

    // ── Satellite ECI position (Rz(RAAN) · Rx(incl) · perifocal) ─────────────
    float ex = cosR * cosU - sinR * sinU * orb.cosI;
    float ey = sinR * cosU + cosR * sinU * orb.cosI;
    float ez = sinU * orb.sinI;
    vec3 satECI = vec3(ex, ey, ez) * orb.R_sat;
    vec3 relPos = satECI - pc.obsECI;

    // ── Earth occultation cull ────────────────────────────────────────────────
    // When sinEl < elevCutoff the infinite line of sight passes through Earth
    // (follows from the limb-angle definition). The satellite is still visible if
    // it lies BETWEEN the observer and Earth (e.g. observer at 500 km looking down
    // at a satellite at 400 km). That case has the closest-approach point beyond
    // the satellite: t_min = obsR·|sinEl| ≥ range  ↔  obsR²·dotUp² ≥ lenSq²
    // Squaring avoids a sqrt while remaining exact.
    vec3  up    = pc.enuZ.xyz;
    float dotUp = dot(relPos, up);
    float lenSq = dot(relPos, relPos);

    if (dotUp < 0.0) {
        float ecutSq = pc.elevCutoff * pc.elevCutoff;
        if (dotUp * dotUp > ecutSq * lenSq) {
            // sinEl < elevCutoff: the infinite ray passes inside Earth.
            // Cull only if the closest approach is before the satellite (t_min < range).
            float obsR2 = dot(pc.obsECI, pc.obsECI);
            if (obsR2 * dotUp * dotUp < lenSq * lenSq) {
                satellites[i].elevation = -1.5708; // occulted by Earth
                return;
            }
            // Closest approach is beyond the satellite: satellite is between
            // observer and Earth, not behind it. Fall through and render it.
        }
    }

    float range = sqrt(lenSq);
    float sinEl = dotUp / range;
    float el    = asin(clamp(sinEl, -1.0, 1.0));
    if (el < pc.elevCutoff) {
        // Passed the occultation test: satellite is between observer and Earth.
        // Bump elevation just above the threshold so sat_flare.comp renders it too.
        el = pc.elevCutoff + 0.001;
    }

    // ── Attitude vectors ──────────────────────────────────────────────────────
    vec3 satNadir = -normalize(satECI);
    // Along-track velocity direction — derivative of ECI position w.r.t. mean anomaly.
    // Already unit length for circular orbits; used by KnifeEdge attitude.
    vec3 velHat = vec3(
        -sinU * cosR - cosU * orb.cosI * sinR,
        -sinU * sinR + cosU * orb.cosI * cosR,
         cosU * orb.sinI
    );

    // ── Primary surface normal ────────────────────────────────────────────────
    vec3 surfN0;
    if (orb.primaryAttitude == AM_TARGETED_REFLECTOR) {
        // Scan all valid night-side targets; pick nearest by dot(satZenith, targetDir).
        int   bestIdx = -1;
        float bestCos = -2.0;
        vec3  satZenith = -satNadir; // from Earth center toward satellite
        for (int ti = 0; ti < NUM_TARGETS; ++ti) {
            vec4 td = reflTargets[ti];
            if (td.w < 0.5) continue;
            float c = dot(satZenith, normalize(td.xyz));
            if (c > bestCos) { bestCos = c; bestIdx = ti; }
        }

        vec3 ideal;
        if (bestIdx < 0) {
            // No valid targets: fall back to FlatMirror45 (reflect straight down).
            vec3  n   = pc.sunDirECI + satNadir;
            float len = length(n);
            ideal = (len > 1e-5) ? n / len : satNadir;
        } else {
            vec3 toTarget = normalize(reflTargets[bestIdx].xyz - satECI);
            vec3 n   = pc.sunDirECI + toTarget;
            float nl = length(n);
            ideal = (nl > 1e-5) ? n / nl : satNadir;
        }

        // Rate-limit mirror slew toward ideal direction.
        vec4 state = mirrorNormals[i];
        if (state.w < 0.5) {
            // Uninitialized: snap to ideal on first frame.
            surfN0 = ideal;
        } else {
            vec3  cur      = state.xyz;
            float maxAngle = radians(pc.mirrorSlewDegPerSec) * pc.simDt;
            float cosA     = clamp(dot(cur, ideal), -1.0, 1.0);
            float angle    = acos(cosA);
            if (angle <= maxAngle) {
                surfN0 = ideal;
            } else {
                surfN0 = normalize(mix(cur, ideal, maxAngle / angle));
            }
        }
        mirrorNormals[i] = vec4(surfN0, 1.0);

        // ── Ground beam (C12): write into reflectBeamsBuf if a real target is locked ──
        // Only meaningful when a valid night-side target was actually found (bestIdx >= 0);
        // the FlatMirror45 fallback above has no real ground target to illuminate.
        //
        // SITE-referenced, not OBSERVER-referenced (revised 2026-07-21): this used to also
        // require the TARGET to clear the observer's own local horizon (targetSinEl >
        // elevCutoff) before writing anything. That coupled beam existence to the observer's
        // exact position/altitude via a razor-thin geometric threshold — small movements (even
        // ~300m of altitude) could cross it and make every beam vanish, and because so few
        // satellites' targets ever happened to pass it, competing satellites fighting over the
        // rare passing slot could flip the displayed beam to the wrong satellite frame to frame.
        // The satellite itself already had to clear the OBSERVER's horizon to reach this code at
        // all (the occultation cull at the top of main() returns early otherwise) — LEO horizon
        // distance (~2000+ km) is generously larger than any range this feature could render
        // anything useful at, so that's a sufficient outer bound on its own. Every satellite that
        // reaches here with a real target now registers unconditionally; how close the OBSERVER
        // needs to be to actually see it is a render-time distance check in the consumer shaders
        // (cloud_march.comp / sat_sky.frag) instead, using a smooth cutoff rather than a fragile
        // horizon test — see TERRAIN_PLAN.md C12 follow-up #5 for the full rationale.
        if (bestIdx >= 0) {
            vec3 targetECI    = reflTargets[bestIdx].xyz;
            vec3 targetRelPos = targetECI - pc.obsECI;
            vec3 targetENU    = vec3(dot(targetRelPos, pc.enuX.xyz),
                                      dot(targetRelPos, pc.enuY.xyz),
                                      dot(targetRelPos, pc.enuZ.xyz));
            vec3 satENU = vec3(dot(relPos, pc.enuX.xyz),
                                dot(relPos, pc.enuY.xyz),
                                dot(relPos, pc.enuZ.xyz));

            // Debug-only (C12 follow-up #12): the mirror's ACTUAL current reflected-sunlight
            // direction — may differ from normalize(targetECI-satECI) while MIRROR_ROT_RATE-
            // limited slewing is still catching up to bestIdx's target. A direction, not a
            // position, so it projects onto the ENU basis directly (no obsECI subtraction needed).
            vec3 reflectDirECI = reflect(-pc.sunDirECI, surfN0);
            vec3 reflectDirENU = vec3(dot(reflectDirECI, pc.enuX.xyz),
                                       dot(reflectDirECI, pc.enuY.xyz),
                                       dot(reflectDirECI, pc.enuZ.xyz));

            // Ground irradiance delivered by the mirror — a physically different quantity
            // from the view-dependent specular mirrorPeak term in sat_flare.comp (that
            // answers "how bright does the mirror look to the OBSERVER"; this answers "how
            // much sunlight lands on the ground target", independent of view angle). The
            // irradiance itself does NOT fall off with range for an idealized collimated flat
            // reflector — but the FOOTPRINT's SIZE still grows with range (C12 follow-up #34,
            // see mirrorRadiusM/footprintRadM below): the two are separate physical facts, and an
            // earlier version of this comment conflated them into "footprint tracks the mirror's
            // own size," which was never actually implemented that way and isn't correct — the
            // sun's own finite angular size means the reflected cone widens with distance
            // regardless of how collimated the mirror itself is.
            const float SOLAR_CONSTANT = 1361.0; // W/m^2 at Earth distance
            float mirrorAreaM2   = orb.crossSection * orb.crossSection * 10.0;
            float cosIncidence   = max(0.0, dot(surfN0, pc.sunDirECI));
            float groundIrradiance = SOLAR_CONSTANT * mirrorAreaM2 * orb.mirrorFrac * cosIncidence;
            float intensity = groundIrradiance * pc.beamGain;

            if (intensity > 0.0) {
                // C12 follow-up #31: contribute to the directional sky-glow suppression dome —
                // independent of whether this beam's own entry makes it into BEAM_MAX_ACTIVE
                // below (the dome has no list/capacity to overflow). `intensity` does NOT fall
                // off with observer distance by physical design (see groundIrradiance's own
                // comment above) — correct for the ground target's OWN illumination, but wrong
                // for how far this beam should suppress background objects AS SEEN FROM THE
                // OBSERVER, so add an explicit distance falloff here specifically for the dome (a
                // beam on the far side of the planet at the same azimuth as a star must not
                // suppress it).
                float targetDist        = length(targetENU);
                const float kBeamDomeRangeM    = 80000.0;  // first-pass guess, tunable
                // C12 follow-up #32: 3e-8 was WAY too small — for a well-aligned Reflect Mirror
                // (crossSectionM2=2376, mirrorFrac=0.97), intensity peaks around ~3.1e6, giving
                // domeRaw ~ 0.09 and domeVal ~ 0.086 even at point-blank range — nowhere near
                // enough to visibly compete against kBeamDomeCompressK=1.0's denominator, which is
                // why the Milky Way (and likely satellites/stars too, just less noticeably against
                // a point source) weren't visibly dimming near a beam. Retuned so a well-aligned
                // close mirror reaches domeRaw ~ 6 (domeVal ~ 0.86) instead.
                const float kBeamDomeScale     = 2e-3;
                const float kBeamDomeCompressK = 1.0;      // Reinhard-style, keeps domeVal in [0,1)
                float distFade = exp(-targetDist / kBeamDomeRangeM);
                float domeRaw  = intensity * distFade * kBeamDomeScale;
                float domeVal  = domeRaw / (domeRaw + kBeamDomeCompressK);
                if (domeVal > 0.0) {
                    float az     = mod(atan(targetENU.x, targetENU.y) + TWO_PI, TWO_PI);
                    uint  sector = uint(az * (float(NUM_BEAM_GLOW_SECTORS) / TWO_PI)) & (NUM_BEAM_GLOW_SECTORS - 1u);
                    atomicMax(beamGlowDome[sector], floatBitsToUint(domeVal));
                }

                // C12 follow-up #34: physically-derived footprint radius, replacing the old flat
                // pc.beamFootprintRadM constant. The dominant spreading mechanism for a large flat
                // mirror reflecting sunlight isn't diffraction off the mirror's own aperture
                // (~1e-8 rad for a ~48m mirror — utterly negligible) — it's that the SUN isn't a
                // point source: its mean angular radius means even a perfectly flat mirror
                // reflects a cone of that half-angle, so the beam widens with distance regardless
                // of how collimated the mirror itself is. mirrorRadiusM (the mirror's own
                // equivalent-circle size) is also stored per-beam — cloud_march.comp's sky tube
                // and sat_sky.frag's ground-spot core both need it downstream.
                float mirrorRadiusM = sqrt(mirrorAreaM2 / PI);
                float slantRangeM   = length(satENU - targetENU); // true 3D mirror->target distance
                const float kSunAngularRadiusRad = 0.0046505; // sun's mean angular radius, ~0.2665 deg
                float footprintRadM = mirrorRadiusM + slantRangeM * tan(kSunAngularRadiusRad);

                // No site keying, no arbitration (C12 follow-up #9) — every satellite that
                // reaches here claims its own unique slot and writes unconditionally.
                uint slot = atomicAdd(beamCount, 1u);
                if (slot < BEAM_MAX_ACTIVE) {
                    beams[slot].satENU        = satENU;
                    beams[slot].intensity      = intensity;
                    beams[slot].targetENU      = targetENU;
                    beams[slot].footprintRadM  = footprintRadM;
                    beams[slot].reflectDirENU  = reflectDirENU;
                    // Repurposed (C12 follow-up #20): was pure std430 padding, unused. Carries
                    // this satellite's own stable dispatch index `i` — NOT the atomic-append slot
                    // `slot` itself, which races across satellites and isn't stable frame-to-frame.
                    // cloud_march.comp's sky glow uses this to downsample by a STABLE subset of
                    // satellites (mod(debugPad, stride)==0) instead of by slot index, which would
                    // show a different random subset each frame (visible flicker).
                    beams[slot].debugPad       = float(i);
                    // C12 follow-up #33: bake this target's precomputed vertical cloud-column
                    // result directly into the beam entry — cloud_march.comp/sat_sky.frag then
                    // read it straight off beams[bi], no bestIdx indirection needed downstream.
                    vec2 cloudBlock = beamCloudBlock[bestIdx];
                    beams[slot].blockAltM      = cloudBlock.x;
                    beams[slot].blockOpacity   = cloudBlock.y;
                    beams[slot].mirrorRadiusM  = mirrorRadiusM;
                }
            }
        }
    } else {
        surfN0 = computeNormal(orb.primaryAttitude, orb, satNadir, velHat, vec3(0.0));
    }

    // ── Secondary surface normal ──────────────────────────────────────────────
    vec3 surfN1 = computeNormal(orb.secondaryAttitude, orb, satNadir, velHat, surfN0);

    // ── Highlight mode sentinel ───────────────────────────────────────────────
    bool  highlight = bool((pc.highlightMask >> orb.constIdx) & 1u);
    float diffuse   = highlight ? 2.0 : orb.diffuse;

    // ── Write GpuSatInput ─────────────────────────────────────────────────────
    satellites[i].eciRelPos    = relPos;
    satellites[i].range        = range;
    satellites[i].surfN0       = surfN0;
    satellites[i].elevation    = el;
    satellites[i].surfN1       = surfN1;
    satellites[i].specExp0     = orb.specExp0;
    satellites[i].baseColor    = vec3(orb.baseColorR, orb.baseColorG, orb.baseColorB);
    satellites[i].specExp1     = orb.specExp1;
    satellites[i].crossSection = orb.crossSection;
    satellites[i].w1           = orb.w1;
    satellites[i].diffuse      = diffuse;
    satellites[i].mirrorFrac   = orb.mirrorFrac;
}
