#version 450

// ── Shared scene-depth pass ───────────────────────────────────────────────────────────────────
//
// Writes, per half-resolution texel, the LINEAR distance in metres along that pixel's view ray to
// the first terrain or ocean surface — or kNoSurfaceT when the ray reaches space. This is the one
// buffer every later pass tests against, replacing a family of ad-hoc per-feature occlusion
// mechanisms that each existed only because cloud_march.comp had no terrain data of its own:
//
//   * beamTerrainVisibility()  — a per-beam, per-pixel line-of-sight terrain march (8-32 samples
//                                x 2 mip-0 fetches into the 21600x10800 DEM, inside a loop over
//                                up to 2048 beams). By far the largest cost this pass removes.
//   * tEnterCombined           — one shared "nearest entry distance" scalar fused across cirrus +
//                                cloud + beam + aurora, so the four could never be occluded
//                                independently. It was also stored in an RGBA16F alpha channel,
//                                whose 65504 ceiling every near-horizon cloud entry overflowed.
//   * tCloudOcclude            — only ever valid for >=90%-opaque cloud.
//
// Deliberately NOT a depth attachment: this is an R32_SFLOAT COLOUR image used as STORAGE|SAMPLED.
// That keeps VulkanContext::imageBarrier (which hardcodes the colour aspect, 1 mip, 1 layer)
// usable as-is, and sidesteps the depth-format blit portability problem that made the render-scale
// path give up on depth entirely.
//
// R32, not R16: distances reach tCap = 3.6e6 m from LEO. Half-float saturates at 65504 — that is
// exactly the bug this pass is retiring, so do not "optimise" the format down.
//
// Resolution is half of ctx.swapExtent and INDEPENDENT of renderScale, matching cloudMarchTargetA/B
// byte for byte. That is what lets cloud_march.comp (which dispatches on the same grid) read this
// with a plain texelFetch at its own gl_GlobalInvocationID — no UV math, no filtering, no
// resampling error — while fragment consumers use gl_FragCoord.xy / pc.screenSizePx, the rule
// that is already correct at every render scale.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    mat4  skyView;          // ENU → camera space                        — offset 0
    float fovYRad;          //                                            — offset 64
    float aspect;           // ALWAYS the true swapchain aspect           — offset 68
    uint  debugDisableMask; // bit 1 = skip terrain, bit 1024 = skip pass — offset 72
    float pad0;             //                                            — offset 76
    vec4  obsECEFDir;       // xyz = observer ECEF unit vec, w = height   — offset 80
} pc;

layout(set = 0, binding = 0) uniform sampler2D earthElevTex;
layout(set = 0, binding = 1) uniform sampler2D earthSpecTex;
layout(set = 0, binding = 2, r32f) uniform writeonly image2D sceneDepth;
// Phase 4c: satellite meshes (SatMeshRenderer's scene pass, full swap extent, 0 = no mesh). They are
// surfaces like terrain, so the shared depth is the nearest of the two — every volumetric march
// then stops at a satellite exactly as it stops at a mountain.
layout(set = 0, binding = 3, r32f) uniform readonly image2D meshDistImg;
// The frame's CloudParams UBO — for the procedural terrain detail (terrain_detail.glsl), so this
// pass marches exactly the surface sat_sky.frag draws.
#define CLOUD_PARAMS_BINDING 4
#include "cloud_params.glsl"
// x = the observer's eye ground height with terrain detail, for sat_sky.frag (binding 26 there).
layout(set = 0, binding = 5, std430) writeonly buffer TerrainFrame { vec4 terrainFrame; };
// The DEM max-mip chain (terrain_detail.glsl tdMaxMipH): empty-space skipping in the march.
layout(set = 0, binding = 6) uniform sampler2D earthElevMaxTex;


#include "common.glsl"
#include "terrain.glsl"
#include "terrain_detail.glsl"


// Nearest mesh distance over the full-resolution texels this half-resolution texel covers.
float meshDistAt(ivec2 halfCoord, ivec2 halfSize)
{
    ivec2 full = imageSize(meshDistImg);
    vec2  k    = vec2(full) / vec2(halfSize);
    ivec2 a    = ivec2(vec2(halfCoord) * k);
    ivec2 b    = min(ivec2(vec2(halfCoord + 1) * k), full) - 1;
    float t    = kNoSurfaceT;
    for (int y = a.y; y <= max(b.y, a.y); ++y)
        for (int x = a.x; x <= max(b.x, a.x); ++x) {
            float d = imageLoad(meshDistImg, min(ivec2(x, y), full - 1)).r;
            if (d > 0.0) t = min(t, d);
        }
    return t;
}

void main() {
    ivec2 size  = imageSize(sceneDepth);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    // The observer's detailed ground height, once for sat_sky.frag (it would otherwise evaluate the
    // detail octaves in every pixel). Written before the knockout early-out below so it is always
    // this frame's value.
    if (coord == ivec2(0))
        terrainFrame = vec4(observerEffHeightDetailed(earthElevTex, earthSpecTex, pc.obsECEFDir), 0.0, 0.0, 0.0);

    // Knockout: fill with "nothing anywhere". Every consumer's operation is min()/>= against this,
    // so a uniform kNoSurfaceT reproduces the pre-unification behaviour (volumetrics and beams
    // unoccluded by terrain) — making the whole architecture a single A/B checkbox.
    if ((pc.debugDisableMask & 1024u) != 0u) {
        imageStore(sceneDepth, coord, vec4(meshDistAt(coord, size)));
        return;
    }

    // Same view ray sat_sky.vert/frag build, evaluated directly at this texel instead of via
    // vertex interpolation — identical affine transform, coarser sampling grid. pc.aspect is the
    // true screen aspect at every render scale, so the ray direction is the same function of
    // normalized screen UV everywhere; that is what makes this buffer well-defined for consumers
    // rendering at a different resolution than this pass.
    vec2 uv  = (vec2(coord) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    float tanHalfFov = tan(pc.fovYRad * 0.5);
    vec3  camDir = vec3(ndc.x * tanHalfFov * pc.aspect, -ndc.y * tanHalfFov, -1.0);
    vec3  dir    = normalize(mat3(transpose(pc.skyView)) * camDir);

    vec3 enuX, enuY, enuZ;
    enuBasis(pc.obsECEFDir.xyz, enuX, enuY, enuZ);

    // GPU-resolved observer height — the SAME shared helper sat_sky.frag and cloud_march.comp now
    // use. They previously disagreed (one CPU value, one GPU lookup), which was harmless while
    // each only compared against itself but is not once one produces distances the other consumes.
    float obsEffH = observerEffHeightDetailed(earthElevTex, earthSpecTex, pc.obsECEFDir);
    vec3  obsPos  = observerPos(obsEffH);

    vec2 tBase  = raySphere(obsPos, dir, R_EARTH);
    vec2 tShell = raySphere(obsPos, dir, R_EARTH + kMaxTerrain);

    float tHit    = -1.0;
    float tSeaLvl = (tBase.x > 0.0) ? tBase.x : -1.0;

    // Terrain march: terrain_detail.glsl's terrainMarchDetailed, the one sat_sky.frag draws with —
    // same gate, same tCap and reach cut-off, same height function and geometry LOD. The LOD's
    // floor (1% of the distance) dominates the pixel footprint at any normal FOV, so this
    // half-resolution pass sees the same octaves as the full-resolution one. No screen jitter:
    // this buffer feeds occlusion tests, where per-texel jitter would make silhouettes shimmer.
    if ((pc.debugDisableMask & 1u) == 0u && dir.z < 0.7 && tShell.y > 0.0) {
        float tExit = (tBase.x > 0.0) ? tBase.x
                    : (tShell.y > 0.0  ? tShell.y : 0.0);
        float tCap  = mix(250000.0, 3600000.0, clamp(obsEffH / 400000.0, 0.0, 1.0));
        tExit = min(tExit, tCap);
        if (tExit < cloud.terrainDistFadeEndM) {
            int steps;
            float pixAngle = pc.fovYRad / float(size.y);
            tHit = terrainMarchDetailed(earthElevTex, earthSpecTex, earthElevMaxTex, true, obsEffH + 2.0, dir, enuX, enuY, enuZ,
                                        2.0, tExit, pixAngle, 192, 1.0, false, kTdCoarseOctaves, steps);
        }
    }

    // Same "effective surface distance" definition as sat_sky.frag's tSurface: terrain if the
    // march found any, else the sea-level sphere. Converted to the large-finite sentinel so every
    // consumer can use a branch-free min()/>= without its own "did we hit anything" guard.
    float tSurface = (tHit > 0.0) ? tHit : tSeaLvl;
    imageStore(sceneDepth, coord, vec4(min(tSurface > 0.0 ? tSurface : kNoSurfaceT, meshDistAt(coord, size))));
}
