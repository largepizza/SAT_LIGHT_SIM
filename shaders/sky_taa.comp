#version 450
// Temporal anti-aliasing of the sky / terrain / ocean background (2026-09-30, the user: "terrain anti
// aliasing"). sat_sky.frag -DSKY_TAA renders the background each frame with a sub-pixel jitter (a Halton
// (2,3) sequence, cloud.taaJitter) into an RGBA16F colour + an R32F copy of its unified depth; this pass
// reprojects the previous RESOLVED frame into this one and blends:
//   - reprojection is exact for a static world: the pixel's ray (unjittered), its distance from the depth,
//     the eye's motion since last frame and last frame's camera (both in THIS frame's ENU, from the CPU in
//     double); sky pixels (depth 1) reproject by rotation alone
//   - history is sampled with a 9-tap Catmull-Rom (bilinear alone blurs a little more every frame)
//   - rejected where last frame's depth at the reprojected point disagrees (a surface uncovered)
//   - clamped to the 3x3 neighbourhood of this frame's samples in YCoCg (variance clip), so anything that
//     moves on its own — waves, clouds, beams, twinkling lights — cannot ghost
// The resolved frame is blitted into the swapchain; the main pass restores the depth from the R32F copy
// (taa_depth_restore.frag), so stars, planets and satellites are drawn over it sharp and occluded.
// TEMPORAL UPSCALING (2026-10-04): below render scale 100% the input is the top-left input extent
// (c2e2.w x e2p0.w) of the input images and the output is full size: this frame's estimate at an output
// pixel is a Gaussian (sigma 0.6 OUTPUT px) of the 3x3 input samples at their jittered positions
// (c2e0.w, c2e1.w, input px), and its blend weight scales with how close the nearest sample landed, so
// over the 16 jitter phases every output pixel converges to its own value. At 100% the path is unchanged.
layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D curColor;    // this frame, jittered
layout(set = 0, binding = 1) uniform sampler2D curDepth;    // this frame's unified depth (log)
layout(set = 0, binding = 2) uniform sampler2D histColor;   // last frame's resolved colour (linear filter)
layout(set = 0, binding = 3) uniform sampler2D histDepth;   // last frame's depth (nearest)
layout(set = 0, binding = 4, rgba16f) uniform writeonly image2D outColor;
layout(set = 0, binding = 5, r32f)    uniform writeonly image2D outDepth;

layout(push_constant) uniform PC {
    vec4 c2e0, c2e1, c2e2;   // camera -> ENU (this frame), rows; w: jitter x, jitter y (input px), input width
    vec4 e2p0, e2p1, e2p2;   // this frame's ENU -> last frame's camera, rows; e2p0.w input height, e2p1.w the eye-parallax floor's distance (m, 0 off), e2p2.w debug mode (display.sky_taa_debug)
    vec4 eyeDelta;           // xyz: this eye - last eye, in this frame's ENU (m); w: 0 none, 1 history, 2 history + nothing moved, 3 + time paused
    vec4 cam;                // x tan(fovY/2), y aspect, z new-sample weight when still, w weight in motion
} pc;

const float kDepthNearM = 0.01;
const float kDepthFarM  = 1.0e9;
float distanceFromDepth(float d) { return kDepthNearM * exp2(d * log2(kDepthFarM / kDepthNearM)); }
float depthFromDistance(float t) {
    return clamp(log2(max(t, kDepthNearM) / kDepthNearM) / log2(kDepthFarM / kDepthNearM), 0.0, 0.99999);
}

// Non-finite -> black (2026-10-04): a NaN in the history spreads through the Catmull-Rom taps into a growing
// black block (the user's snapshot at the Earth's limb); dropped here it costs one pixel for one frame.
vec3 fin(vec3 c) { return (any(isnan(c)) || any(isinf(c))) ? vec3(0.0) : c; }

vec3 toYCoCg(vec3 c) { return vec3(0.25 * c.r + 0.5 * c.g + 0.25 * c.b, 0.5 * c.r - 0.5 * c.b, -0.25 * c.r + 0.5 * c.g - 0.25 * c.b); }
vec3 fromYCoCg(vec3 y) { return vec3(y.x + y.y - y.z, y.x + y.z, y.x - y.y - y.z); }

// Catmull-Rom history sample from 9 bilinear taps (the standard form, weights exact at any position).
vec3 sampleHistory(vec2 uv, vec2 size) {
    vec2 sp  = uv * size;
    vec2 tp1 = floor(sp - 0.5) + 0.5;
    vec2 f   = sp - tp1;
    vec2 w0 = f * (-0.5 + f * (1.0 - 0.5 * f));
    vec2 w1 = 1.0 + f * f * (-2.5 + 1.5 * f);
    vec2 w2 = f * (0.5 + f * (2.0 - 1.5 * f));
    vec2 w3 = f * f * (-0.5 + 0.5 * f);
    vec2 w12 = w1 + w2;
    vec2 tp0 = (tp1 - 1.0) / size, tp3 = (tp1 + 2.0) / size, tp12 = (tp1 + w2 / w12) / size;
    vec3 r = vec3(0.0);
    r += textureLod(histColor, vec2(tp0.x,  tp0.y),  0.0).rgb * w0.x  * w0.y;
    r += textureLod(histColor, vec2(tp12.x, tp0.y),  0.0).rgb * w12.x * w0.y;
    r += textureLod(histColor, vec2(tp3.x,  tp0.y),  0.0).rgb * w3.x  * w0.y;
    r += textureLod(histColor, vec2(tp0.x,  tp12.y), 0.0).rgb * w0.x  * w12.y;
    r += textureLod(histColor, vec2(tp12.x, tp12.y), 0.0).rgb * w12.x * w12.y;
    r += textureLod(histColor, vec2(tp3.x,  tp12.y), 0.0).rgb * w3.x  * w12.y;
    r += textureLod(histColor, vec2(tp0.x,  tp3.y),  0.0).rgb * w0.x  * w3.y;
    r += textureLod(histColor, vec2(tp12.x, tp3.y),  0.0).rgb * w12.x * w3.y;
    r += textureLod(histColor, vec2(tp3.x,  tp3.y),  0.0).rgb * w3.x  * w3.y;
    return max(r, vec3(0.0));
}

void main() {
    ivec2 sz = imageSize(outColor);
    ivec2 p  = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= sz.x || p.y >= sz.y) return;
    vec2  size = vec2(sz);
    ivec2 isz  = ivec2(pc.c2e2.w + 0.5, pc.e2p0.w + 0.5);
    bool  up   = isz != sz;            // uniform: temporal upscaling
    vec3  cur;
    float d;
    float conf = 1.0;                  // how close this frame's nearest sample landed (upscaling)
    float yMax = 0.0, y2nd = 0.0;      // the 3x3's largest and second-largest luma
    float seaA = 1.0;                  // sat_sky.frag's sea marker: 1 not sea, else 0.5 x (1 - storm trail share)
    vec3 m1 = vec3(0.0), m2 = vec3(0.0);
    float dLo3 = 1.0, dHi3 = 0.0;      // this frame's 3x3 depth range (the still-view disocclusion test)
    // Something in the 3x3 that moves on its own (sat_sky.frag's alpha marker 0.875: a mesh, or plume / flame light):
    // reprojection assumes a static world, so there the still view's exemptions (no clip, the widened depth test)
    // would keep a moving rocket's history where it was — trails behind every model (issue 20261021_174219 shot 3).
    bool dynNb = false, dynC = false;
    if (!up) {
        vec4 c4 = texelFetch(curColor, p, 0);
        cur  = fin(c4.rgb);
        seaA = c4.a;
        dynC = c4.a > 0.85 && c4.a < 0.95;
        d    = texelFetch(curDepth, p, 0).r;
        // The neighbourhood of this frame's samples (YCoCg mean and deviation).
        for (int k = 0; k < 9; ++k) {
            ivec2 q = clamp(p + ivec2(k % 3 - 1, k / 3 - 1), ivec2(0), sz - 1);
            vec4  cq4 = texelFetch(curColor, q, 0);
            vec3  y = toYCoCg(fin(cq4.rgb));
            m1 += y; m2 += y * y; y2nd = max(y2nd, min(yMax, y.x)); yMax = max(yMax, y.x);
            dynNb = dynNb || (cq4.a > 0.85 && cq4.a < 0.95);
            float dq = texelFetch(curDepth, q, 0).r;
            dLo3 = min(dLo3, dq); dHi3 = max(dHi3, dq);
        }
    } else {
        vec2  k2o = size / vec2(isz);                         // output px per input px
        vec2  ip  = (vec2(p) + 0.5) / k2o;                    // this pixel's centre in input px
        ivec2 c   = clamp(ivec2(floor(ip)), ivec2(0), isz - 1);
        vec2  jit = vec2(pc.c2e0.w, pc.c2e1.w);
        vec3  acc = vec3(0.0);
        float ws  = 0.0, wMax = 0.0;
        for (int k = 0; k < 9; ++k) {
            ivec2 q  = clamp(c + ivec2(k % 3 - 1, k / 3 - 1), ivec2(0), isz - 1);
            vec4  cq4 = texelFetch(curColor, q, 0);
            vec3  cq = fin(cq4.rgb);
            dynNb = dynNb || (cq4.a > 0.85 && cq4.a < 0.95);
            vec2  dO = (vec2(q) + 0.5 + jit - ip) * k2o;      // sample -> pixel, OUTPUT px
            float w  = exp(-dot(dO, dO) * (1.0 / (2.0 * 0.6 * 0.6)));
            acc += cq * w; ws += w; wMax = max(wMax, w);
            vec3  y = toYCoCg(cq);
            m1 += y; m2 += y * y; y2nd = max(y2nd, min(yMax, y.x)); yMax = max(yMax, y.x);
            float dq = texelFetch(curDepth, q, 0).r;
            dLo3 = min(dLo3, dq); dHi3 = max(dHi3, dq);
        }
        cur  = acc / max(ws, 1e-6);
        conf = wMax;
        seaA = texelFetch(curColor, c, 0).a;
        dynC = seaA > 0.85 && seaA < 0.95;
        d    = texelFetch(curDepth, c, 0).r;
    }
    // The neighbourhood's mean luma WITHOUT its brightest sample, for the flash rule: lightning raises all nine,
    // a lone spark (a glint on a wave facet, a far light caught by one jitter phase in 16) does not, and it used
    // to take its frame raw — white specks on the sea (user snapshot, SF Bay, 2026-10-04).
    const float mRob = (m1.x - yMax) / 8.0;
    m1 /= 9.0; m2 /= 9.0;
    vec3 sd = sqrt(max(m2 - m1 * m1, vec3(0.0)));

    // A lone spark on the SEA while the eye moves (2026-10-22, the matrix suite: alt3km-fast, a white speckle over the
    // whole sea while moving, the settled sea smooth): a glint on a sub-pixel wave facet caught by one jitter phase is a
    // single bright sample, and in motion the history (clipped, at the moving weight) no longer averages it away. Where
    // this pixel is the 3x3's strict maximum it is capped at the second-largest luma (an isolated spark only: a glitter
    // path or a lit crest spans neighbours). Not in a still view (the history averages the phases there).
    // (0.6 = a Sun-glint sparkle sat_sky.frag drew on purpose (gSeaSpark, 2026-10-27): not a jitter spark, kept.)
    const bool spark = seaA > 0.55 && seaA < 0.65;
    if (seaA < 0.75 && !spark && pc.eyeDelta.w < 1.5) {
        float yc = toYCoCg(cur).x;
        if (yc > y2nd && yc > 1e-6) cur *= y2nd / yc;
    }
    vec3 res = cur;
    // Debug (display.sky_taa_debug, 2026-10-22, issue 20261022_174155; diagnostics only). Modes 1-2 write the debug
    // colour INTO the history, so they show only what does not depend on the colour history (the depth history is
    // kept): 1 = R the new-sample weight from motion (before the flash rule), G the floor's share (floorK), B the depth
    // class (0 sky, 0.5 opaque cloud, 1 surface); white = no history (depth-rejected / off screen). 2 = R the reprojection's parallax / 8 px, G the eye-parallax
    // floor's / 8, B the total motion / 8. 3 = no colour clip (normal output otherwise). 4 = the reprojected history
    // only (weight 0, no clip): where the reprojection is right the image stays aligned while moving.
    // Written linear into an sRGB swapchain: a capture's value^2.2 / 255 is the number.
    const int dbg = int(pc.e2p2.w + 0.5);
    float dW = -1.0, dClip = 0.0, dCls = 0.0, dPar = 0.0, dParF = 0.0, dMv = 0.0;
    if (pc.eyeDelta.w > 0.5) {
        // This pixel's (unjittered) ray in ENU.
        vec2  ndc = (vec2(p) + 0.5) / size * 2.0 - 1.0;
        vec3  cd  = vec3(ndc.x * pc.cam.x * pc.cam.y, -ndc.y * pc.cam.x, -1.0);
        vec3  dir = normalize(vec3(dot(pc.c2e0.xyz, cd), dot(pc.c2e1.xyz, cd), dot(pc.c2e2.xyz, cd)));
        bool  sky = d >= 0.99998;
        dCls = sky ? 0.0 : ((seaA > 0.77 && seaA < 0.83) ? 0.5 : 1.0);
        vec3  P   = sky ? dir : dir * distanceFromDepth(d) + pc.eyeDelta.xyz;   // from last frame's eye
        vec3  pcv = vec3(dot(pc.e2p0.xyz, P), dot(pc.e2p1.xyz, P), dot(pc.e2p2.xyz, P));
        bool  ok  = pcv.z < -1e-6;
        vec2  uvP = vec2(0.0);
        if (ok) {
            vec2 ndcP = vec2(pcv.x / (-pcv.z * pc.cam.x * pc.cam.y), -pcv.y / (-pcv.z * pc.cam.x));
            uvP = ndcP * 0.5 + 0.5;
            ok  = all(greaterThanEqual(uvP, vec2(0.0))) && all(lessThanEqual(uvP, vec2(1.0)));
        }
        if (ok) {
            // Disocclusion: the depth this point should have, against the RANGE of last frame's depths in the
            // 2x2 texels around where it was. At a silhouette the jittered samples alternate sky and ground, so
            // a test against one texel rejected every edge pixel every frame (no anti-aliasing at all); a
            // surface newly uncovered fits none of them.
            // The history's depth is NEGATIVE where it was a moving thing (written below): abs for the test.
            vec4  dHr = textureGather(histDepth, uvP, 0);
            dynNb = dynNb || any(lessThan(dHr, vec4(0.0)));
            vec4  dH  = abs(dHr);
            float dE  = sky ? 1.0 : depthFromDistance(length(P));
            float lo4 = min(min(dH.x, dH.y), min(dH.z, dH.w)), hi4 = max(max(dH.x, dH.y), max(dH.z, dH.w));
            // Nothing moved this frame (eyeDelta.w >= 2): no surface can have been uncovered, and the 2x2 of LAST
            // frame's jittered depths need not hold the depth THIS phase's sample hit. A pixel on a crest seen at a
            // low angle (a ridge in front of a far city) hits the ridge in some of the 16 phases and the city in
            // others; the test rejected the history on every switch, so the pixel showed its raw samples,
            // alternating ~240 / ~37 levels frame to frame — the "z-fighting" of far city lights at low angles
            // (user report, 2026-10-06; Irvine horizon r35: the worst pixels' series). Still, the range also takes
            // this frame's 3x3 depths, which hold both surfaces of an edge. ONLY when still: widening it by the 3x3
            // spread in motion (2026-10-04) let history ghost through cloud edges while climbing.
            if (pc.eyeDelta.w > 1.5 && !dynNb) { lo4 = min(lo4, dLo3); hi4 = max(hi4, dHi3); }
            if (dE < lo4 - 0.004 || dE > hi4 + 0.004) ok = false;
        }
        if (ok) {
            vec3  h  = toYCoCg(fin(sampleHistory(uvP, size)));
            // Variance clip toward the mean (a box of 1.25 sd): a colour history cannot hold does not ghost.
            vec3  lo = m1 - 1.25 * sd, hi = m1 + 1.25 * sd;
            vec3  c  = 0.5 * (lo + hi), e = 0.5 * (hi - lo) + 1e-5;
            vec3  v  = h - c;
            vec3  a  = abs(v / e);
            float mx = max(a.x, max(a.y, a.z));
            // Nothing moved this frame (CPU: eyeDelta.w = 2), so nothing can ghost: no clip. A light smaller than a
            // pixel is caught by only some jitter phases, and in the others the all-dark 3x3 box clipped its
            // accumulated light away — far city lights blinked on the jitter cycle (user snapshots, 2026-10-04).
            // NOT on the sea (2026-10-04, user snapshot): its waves move while the camera is still, and unclipped
            // the crests smeared into long trails until the camera moved. On a stormy sea the user liked that
            // look, so it is kept there on purpose ("Storm sea trails", sat_sky.frag's marker): the history is
            // blended toward unclipped by the trail share and held at the still weight, moving or not.
            // Motion (in pixels) raises the new sample's weight: a moving view keeps its detail.
            float mv = length((uvP - (vec2(p) + 0.5) / size) * size);
            // The PARALLAX (the eye's own move, past the rotation) ramps the weight from 0.1 px (2026-10-06): every frame
            // resamples the history at a fractional offset, and at the still weight (0.1) ~10 frames of that resampling
            // stacked up. Climbing over a city at night (Q, ~60 m/s, looking 20 deg down) the ground's reprojection is
            // 0.1-0.5 px a frame and the 1-px city lights smeared into blotches (user snapshot, Glasgow; tstab rise 5.4).
            // Rotation alone keeps the old ramp (0.5 -> 4 px): it reprojects exactly, and the far ground in a slow
            // drift (the release cinematic's LA shot) would otherwise trade the history for jittered sub-pixel lights.
            float par = 0.0;
            {
                vec3 pI = vec3(dot(pc.e2p0.xyz, dir), dot(pc.e2p1.xyz, dir), dot(pc.e2p2.xyz, dir));
                if (pI.z < -1e-6) {
                    vec2 uvI = vec2(pI.x / (-pI.z * pc.cam.x * pc.cam.y), -pI.y / (-pI.z * pc.cam.x)) * 0.5 + 0.5;
                    par = length((uvP - uvI) * size);
                }
            }
            // The trails are for a view that moves little: flying (parallax past ~1-4 px a frame) the unclipped history
            // was whatever stood over this water a frame ago, and clouds were dragged across the sea in stepped copies
            // (issue 20261012_235712 shot 7, boosting at 22 km/s over a storm).
            // Issue 20261022_174155 (climbing ~300-500 m/s under a cumulus deck, time paused): translucent cloud and haze
            // carry SKY depth (the unified depth holds a cloud only where it is >= 90% opaque), so they reproject by
            // rotation alone, with no parallax, and an opaque cloud's depth is its light's MEAN distance, often far
            // past its surface. Both kept the still weight (0.1) while the deck moved 2-10 px a frame, and the 3x3
            // clip, spanning the edge's gradient, let each frame's edge through: stacked serrated copies of every cloud
            // edge and vertical smears below the deck (run 1: gone with the sky TAA off, the cloud resolve's own output
            // clean). So while the EYE moves, every pixel takes at least the eye's parallax at a stand-in distance
            // (e2p1.w, CPU "display.sky_taa_parallax_floor_m", 1500 m; 0 = off) for its WEIGHT and clip only (the
            // reprojection is unchanged): nearer surfaces keep their own parallax, a still eye changes nothing.
            // Run 2 (2026-10-22): the floor on sky-depth pixels alone changed 0.4% of the climb's pixels; the copies were
            // on OPAQUE-CLOUD pixels (sat_sky.frag alpha 0.8), whose depth is the cloud light's mean distance. Those take
            // the eye's parallax at min(their distance, the floor) and the sky-depth treatment below (UNVERIFIED).
            const bool cloudPx = seaA > 0.77 && seaA < 0.83;
            float parF = 0.0;
            if (pc.e2p1.w > 0.0 && (sky || cloudPx || distanceFromDepth(d) > pc.e2p1.w)) {
                vec3  ed   = pc.eyeDelta.xyz;
                float perp = length(ed - dir * dot(ed, dir));
                float dF   = sky ? pc.e2p1.w : min(distanceFromDepth(d), pc.e2p1.w);
                parF = perp / dF * (size.y / (2.0 * pc.cam.x));   // px (fovY: 2 tan(fovY/2) spans size.y)
            }
            // SKY-depth pixels past a few px of it also take most of this frame and a tighter clip: nothing at sky depth
            // can be reprojected along the eye's move. A far surface (true depth) only takes the moving weight from it.
            // Large parallax at a DEPTH EDGE or on cloud (2026-10-22, the orbit matrix: fast100 2.52% / +1.91 signed with
            // the TAA vs 1.79% / +1.41 off): clouds' depth is their light's mean distance and a translucent edge carries the
            // ground's, so where the reprojection moves things 4-16+ px a frame a few % of depth error is several px of
            // misplaced history, and the 3x3 box at an edge (cloud + ground) is wide enough to pass it: every cloud got a
            // bright, fat fringe. There the history goes like the sky-depth case (weight 0.8, tighter clip). The interior of
            // a surface (3x3 depth spread under ~1%) keeps its history at any parallax (its reprojection is exact).
            const float edgeK  = cloudPx ? 1.0 : smoothstep(0.0003, 0.0012, dHi3 - dLo3);   // log2 units: ~0.8-3% of distance
            const float floorK = max((sky || cloudPx) ? smoothstep(1.0, 6.0, parF) : 0.0, smoothstep(4.0, 16.0, par) * edgeK * float(pc.e2p1.w > 0.0));   // off with the floor (A/B)
            const bool  sea    = seaA < 0.75;
            const float trail  = sea ? clamp(1.0 - 2.0 * seaA, 0.0, 1.0) * (1.0 - smoothstep(1.0, 4.0, par)) : 0.0;
            const bool  still  = pc.eyeDelta.w > 1.5 && !dynNb;
            const bool  noClip = still && (!sea || pc.eyeDelta.w > 2.5);   // paused: the waves are frozen too
            // The floor's clip is tighter (1.25 -> 0.75 sd as it ramps): a ghost on a smooth gradient sits inside 1.25.
            const float mxF = mx / mix(1.0, 0.6, floorK);
            if (mxF > 1.0 && !noClip && dbg != 3 && dbg != 4) h = mix(c + v / mxF, h, trail);
            const float ramp = max(max(smoothstep(0.5, 4.0, mv), smoothstep(0.1, 1.0, par)), smoothstep(0.1, 1.0, parF));
            float w  = mix(pc.cam.z, pc.cam.w, ramp * (1.0 - trail));
            w = mix(w, max(w, 0.8), floorK * (1.0 - trail));
            dW = w; dClip = floorK;
            // A flash (lightning, a sprite, a glint): when the whole NEIGHBOURHOOD brightens past the history,
            // take the new frame at once — at weight 0.1 a flash lasting a few frames came out ~10x dimmer.
            // Jitter alternating across an edge leaves the 3x3 mean where it was, so edges still accumulate.
            // The spark-proof mean only when nothing moved: in motion it fired less often and the history lagged
            // (+3% on the climb benchmark), and the specks it removes are a still-view problem.
            w = max(w, smoothstep(0.3, 1.2, (((still || sea) ? mRob : m1.x) - h.x) / max(h.x, 0.02)));   // sea: spark-proof in motion too (glints took their frame raw)
            if (spark) w = max(w, 0.9);   // a glint sparkle: its flash at once (the history would average it ~10x down)
            w *= conf;   // upscaling: a sample far from this pixel moves it less (1 at 100%)
            if (dbg == 4) w = 0.0;
            dPar = par; dParF = parF; dMv = mv;
            res = fromYCoCg(mix(h, toYCoCg(cur), w));
        }
    }
    if (dbg == 1) res = dW < 0.0 ? vec3(1.0) : vec3(dW, dClip, dCls);
    if (dbg == 2) res = vec3(dPar, dParF, dMv) / 8.0;
    imageStore(outColor, p, vec4(max(fin(res), vec3(0.0)), 1.0));
    // A moving thing's depth is stored negated (the next frame's dynNb); taa_depth_restore.frag takes abs().
    imageStore(outDepth, p, vec4(dynC ? -max(d, 1e-7) : d, 0.0, 0.0, 0.0));
}
