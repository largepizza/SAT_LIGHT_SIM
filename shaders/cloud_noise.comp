#version 450

// Bake a 192³ RGBA noise volume for the Nubis cloud model.
// R = Perlin-Worley FBM (base cloud macrostructure / vertical presence).
// G = erosion FBM — three inverted Worley F1 octaves PRE-SUMMED at fixed 0.625/0.25/0.125 weights.
// B = R shifted +54 texels in Z    } the two extra vertical presence slices cloudDensity() blends,
// A = R shifted +108 texels in Z   } baked so all three come from ONE .rba fetch (see common.glsl).
// All channels tile seamlessly at the volume boundary.
// Dispatch (24,24,24) with local_size (8,8,8) → 192³ threads.
// Resolution bumped from 128³ so the higher erosion frequencies below (up to 36
// cells/axis) don't alias in the bake itself — need ~192/36=5.3 texels/cell minimum.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba8, set = 0, binding = 0) writeonly uniform image3D cloudNoiseTex;

// ── Domain-seam isolation test (see CLOUD_SEAM_BUG.md #13/#0) ───────────────
// A confirmed real (not RenderDoc-export-artifact) discontinuity exists at the bake's own
// u,v,w≡0 domain edge, worst in the N=37 (alpha) octave, absent in the N=8 (green) octave —
// the only octave whose N evenly divides the 192 bake resolution. Set to 1, rebuild, and
// RenderDoc-inspect texel(0,96,*) vs texel(191,96,*) to separate "N doesn't evenly divide
// texSize" from "just a high/undersampled frequency" as the deciding factor:
// ROUND 2 (seam persisted after switching to divisor-only N: 4/8/16, 3/6, 12/24/32): the two
// confirmed-clean values from round 1 (N=8, N=32) were BOTH powers of 2, and the two
// confirmed-broken values (N=5, N=37) were both non-divisors — "divides 192" and "is a power
// of 2" were never actually separated. The fix introduced non-power-of-2 divisors (3,6,12,24)
// that were never individually tested. Testing those directly now:
//   R = worleyTile(uvw, 3)   — divides 192 (192/3=64), NOT a power of 2
//   G = worleyTile(uvw, 6)   — divides 192 (192/6=32), NOT a power of 2
//   B = worleyTile(uvw, 12)  — divides 192 (192/12=16), NOT a power of 2
//   A = worleyTile(uvw, 24)  — divides 192 (192/24=8),  NOT a power of 2
// If these are all clean: divisibility really is sufficient, look elsewhere for the persisting
// seam (fix may be incomplete for another reason, or there's a second contributing source).
// If any of these are broken: refine to "must be a power of 2 divisor", not just "any divisor".
#define NOISE_BAKE_DEBUG 0

// --- helpers ----------------------------------------------------------------

// Integer bit-mixing hash (no trig) — replaces the classic fract(sin(dot(...))*C) hash.
// That sin-based hash loses precision (GPU sin() range reduction is only accurate over a
// limited input span) once the dot product against the large constants grows past a few
// thousand — which happens once wrapped cell indices approach the higher erosion frequencies
// used below (up to 36 per axis). The precision loss correlates with the integer cell index,
// so it doesn't look like random noise degrading — it looks like a periodic, grid-aligned
// artifact. Pure integer multiply/xor mixing has no such range limit.
uvec3 hashU(uvec3 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 hash3(ivec3 c)
{
    return vec3(hashU(uvec3(c))) * (1.0 / 4294967296.0);   // -> [0,1)
}

// Tiling gradient hash: wraps cell c within [0,N) before hashing so the
// noise is seamlessly periodic at the volume boundary.
vec3 gradHash(ivec3 c, int N)
{
    int x = c.x % N; if (x < 0) x += N;
    int y = c.y % N; if (y < 0) y += N;
    int z = c.z % N; if (z < 0) z += N;
    return normalize(-1.0 + 2.0 * hash3(ivec3(x, y, z)));
}

// 3D tiling Perlin noise with N gradient cells per axis.
// Returns values roughly in [-1, 1].
float perlinTile(vec3 uvw, int N)
{
    vec3 p = uvw * float(N);
    ivec3 i = ivec3(floor(p));
    vec3 f = fract(p);
    vec3 u = f * f * (3.0 - 2.0 * f);   // smoothstep

    float v000 = dot(gradHash(i,                   N), f               );
    float v100 = dot(gradHash(i + ivec3(1,0,0),    N), f - vec3(1,0,0) );
    float v010 = dot(gradHash(i + ivec3(0,1,0),    N), f - vec3(0,1,0) );
    float v110 = dot(gradHash(i + ivec3(1,1,0),    N), f - vec3(1,1,0) );
    float v001 = dot(gradHash(i + ivec3(0,0,1),    N), f - vec3(0,0,1) );
    float v101 = dot(gradHash(i + ivec3(1,0,1),    N), f - vec3(1,0,1) );
    float v011 = dot(gradHash(i + ivec3(0,1,1),    N), f - vec3(0,1,1) );
    float v111 = dot(gradHash(i + ivec3(1,1,1),    N), f - vec3(1,1,1) );

    return mix(mix(mix(v000, v100, u.x), mix(v010, v110, u.x), u.y),
               mix(mix(v001, v101, u.x), mix(v011, v111, u.x), u.y), u.z);
}

// 3D tiling Worley (cellular) F1 noise with N cells per axis.
// Returns the distance to the nearest point, clamped to [0, 1].
// Uses the unwrapped cell for distance computation but the wrapped cell for
// hashing so the random point pattern is seamlessly periodic.
float worleyTile(vec3 uvw, float N)
{
    vec3 p = uvw * N;
    ivec3 i = ivec3(floor(p));
    float minDist = 4.0;
    for (int dz = -1; dz <= 1; dz++)
    for (int dy = -1; dy <= 1; dy++)
    for (int dx = -1; dx <= 1; dx++) {
        ivec3 cell = i + ivec3(dx, dy, dz);
        // Wrapped cell for hash (tiling)
        int wx = cell.x % int(N); if (wx < 0) wx += int(N);
        int wy = cell.y % int(N); if (wy < 0) wy += int(N);
        int wz = cell.z % int(N); if (wz < 0) wz += int(N);
        // Hash to random point position within the cell [0, 1)
        vec3 h = hash3(ivec3(wx, wy, wz));
        // Distance uses the actual (unwrapped) cell position for correct geometry
        vec3 pt = vec3(cell) + h;
        minDist = min(minDist, length(p - pt));
    }
    return clamp(minDist, 0.0, 1.0);
}

// Remap v from [lo, hi] into [newLo, newHi].
float remap(float v, float lo, float hi, float newLo, float newHi)
{
    return newLo + clamp((v - lo) / max(hi - lo, 1e-6), 0.0, 1.0) * (newHi - newLo);
}

// R: Perlin-Worley FBM — large-scale cloud macrostructure.
// Three-octave Perlin FBM remapped by an inverted Worley field so the result has
// cauliflower-like bulges (the Nubis Perlin-Worley channel).
//
// Octave frequencies MUST be powers of 2 — see CLOUD_SEAM_BUG.md #13-#15. Confirmed via two
// rounds of RenderDoc pixel measurement: "divides 192 evenly" was NOT the real rule (N=3,6,
// 12,24 all divide 192 exactly and are all still badly broken); the actual rule is that N
// must be a power of 2, independent of the bake resolution entirely. Likely mechanism: the
// cell-wrap `cell.x % int(N)` (used for hash-lookup wrapping, only exercised with a NEGATIVE
// cell.x right at the domain edge, texel 0's dx=-1 neighbor) reduces to a correct bitmask
// for power-of-2 N even for negative two's-complement operands, but likely lowers to a
// multiply-by-reciprocal "magic number" division for non-power-of-2 constant N — a common
// place for signed/negative-operand compiler bugs to hide. Not independently verified via
// disassembly, but the empirical N-must-be-power-of-2 rule is airtight across 8 tested
// values (4 clean: 8,32 [round 1] + power-of-2 sanity; 6 broken: 5,37 [round 1], 3,6,12,24
// [round 2]). Do not introduce a non-power-of-2 octave frequency without re-reading this.
//
// Factored out of main() (T2.1, CLOUD_PERF_PLAN.md) so it can be evaluated at three Z offsets.
float perlinWorleyAt(vec3 uvw)
{
    float pln  = perlinTile(uvw, 4)  * 0.5 + 0.5;
    pln += (perlinTile(uvw, 8)  * 0.5 + 0.5) * 0.5;
    pln += (perlinTile(uvw, 16) * 0.5 + 0.5) * 0.25;
    pln /= 1.75;                                        // normalise octave sum → [0,1]
    // w0: TWO Worley octaves blended (was one) — a broad macro-blob shape (freq 2) plus a
    // secondary finer bumpiness (freq 4) gives the base silhouette organic structure instead
    // of the smoother single-scale blob the old single-octave floor produced.
    float w0a = 1.0 - worleyTile(uvw, 2.0);
    float w0b = 1.0 - worleyTile(uvw, 4.0);
    float w0  = w0a * 0.7 + w0b * 0.3;                 // inverted: high = far from cell centres
    return remap(pln, 0.0, 1.0, w0, 1.0);
}

// ── Channel packing (T2.1, CLOUD_PERF_PLAN.md) — MUST match common.glsl ───────────────────────
// Vertical presence slice offsets, in TEXELS. cloudDensity() reads all three presence slices from
// a single .rba fetch instead of three separate .r reads at Z + 0.28 / Z + 0.56.
//
// Integer texel counts are the whole point: a whole-texel shift commutes with trilinear
// interpolation, so B/A are bit-identical to what a Z-offset read of R returns. The old
// hand-written 0.28/0.56 are 53.76/107.52 texels — non-integer, so they could not be packed.
// Rounding to 54/108 moves each slice by under a quarter texel.
//
// These MUST equal common.glsl's kCloudPresenceZMid/kCloudPresenceZTop (expressed there as
// 54/192 and 108/192). The noise tiles seamlessly in Z and the sampler is REPEAT on W, so the
// wrap at the volume boundary is exact.
const int kPresenceMidTexels = 54;
const int kPresenceTopTexels = 108;

// --- main -------------------------------------------------------------------

void main()
{
    ivec3 texSize = imageSize(cloudNoiseTex);
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(coord, texSize))) return;

    // Normalised [0, 1] position, texel-centered
    vec3 uvw = (vec3(coord) + 0.5) / vec3(texSize);

#if NOISE_BAKE_DEBUG
    float dR = worleyTile(uvw, 3.0);
    float dG = worleyTile(uvw, 6.0);
    float dB = worleyTile(uvw, 12.0);
    float dA = worleyTile(uvw, 24.0);
    imageStore(cloudNoiseTex, coord, vec4(dR, dG, dB, dA));
    return;
#endif

    // R / B / A: the presence (Perlin-Worley) field at this texel and at two fixed Z offsets.
    // Baking the offsets means cloudDensity() gets its whole vertical presence blend from one
    // .rba fetch. Costs ~1.8x this bake's Worley work (5 octaves/texel -> 9), paid once at init.
    float presenceBase = perlinWorleyAt(uvw);
    float presenceMid  = perlinWorleyAt(uvw + vec3(0.0, 0.0, float(kPresenceMidTexels) / float(texSize.z)));
    float presenceTop  = perlinWorleyAt(uvw + vec3(0.0, 0.0, float(kPresenceTopTexels) / float(texSize.z)));

    // G: erosion FBM — inverted Worley at three increasing frequencies, PRE-SUMMED at the exact
    // weights cloudDensity() used to apply after reading them as three separate channels. Coarse
    // bites -> mid fraying -> fine wisps, same intent and same result; all three MUST be powers
    // of 2 (see perlinWorleyAt's comment and CLOUD_SEAM_BUG.md #13-#15).
    //
    // Weights sum to exactly 1.0, so the sum spans the same [0,1] the individual channels did and
    // suffers ONE round of RGBA8 quantization instead of three — marginally better precision, not
    // worse. This frees B and A for the presence slices above.
    float erosion = (1.0 - worleyTile(uvw,  8.0)) * 0.625
                  + (1.0 - worleyTile(uvw, 16.0)) * 0.25
                  + (1.0 - worleyTile(uvw, 32.0)) * 0.125;

    imageStore(cloudNoiseTex, coord, vec4(presenceBase, erosion, presenceMid, presenceTop));
}
