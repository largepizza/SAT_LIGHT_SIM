#version 450

// Bake a 1024x16x256 RGBA8 volume replacing three of aurora's live analytic warpPerlin3 calls
// (sat_sky.frag's auroraCurtainNoise base term + the two column-window colA/colB samples) with
// hardware texture reads — same "bake the static structure, warp the sample coordinate for
// animation" split cloud_noise.comp/cloudWarpOffset already use, and the direct answer to "why
// are clouds cheaper than aurora despite looking more complex": clouds' noise was already moved
// off the live shading path into a texture in a prior session; aurora's never was.
//
// R = curtain fold base (was auroraCurtainNoise's `base = warpPerlin3(p)`,
//     p = (az*kAuroraTangentFreq*(1+storm*0.8) + shimmerPhase, altM*kAuroraAltFreq, colat*kAuroraRadialFreq)).
//     shimmerPhase and the storm scale stay LIVE (cheap, 1 warpPerlin3 call, drives animation) —
//     only the static `base` lookup is baked. U wraps kCurtainTangentN times per full azimuth loop.
// G,B = column-window colA/colB (were 2 separate warpPerlin3 calls, (az*kAuroraColumnFreq,
//       colat*kAuroraColumnFreq*0.5, seed)) — no altitude dependence (matches the live comment:
//       "no altitude, no time... constant all the way up a given column"), so baked redundantly
//       across every V slice. U wraps kColumnTangentN times per loop — DIFFERENT from R's wrap
//       count, so R and G/B need separate texture fetches at runtime (different U mapping), not
//       one shared fetch — see sat_sky.frag's sampling code.
// A = unused (reserved).
//
// U (azimuth) axis WRAPS — R at kCurtainTangentN=256 cells/loop (nearest power-of-2 to the live
// kAuroraTangentFreq(40)*2*PI=251.3), G/B at kColumnTangentN=64 cells/loop (nearest power-of-2 to
// kAuroraColumnFreq(9)*2*PI=56.5). MUST be power-of-2 — cloud_noise.comp's own hard-won lesson
// (CLOUD_SEAM_BUG.md): a non-power-of-2 wrap modulus produces a real discontinuity at the domain
// seam (empirically confirmed there, not just theorized), not merely a resolution/quality issue.
// V (altitude, R only) and W (colatitude, R+G+B) do NOT wrap — sampled with CLAMP_TO_EDGE at
// runtime over the fixed ranges below, so any bake-edge value mismatch there is simply never
// read across (no seam possible).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 8) in;

layout(rgba8, set = 0, binding = 0) writeonly uniform image3D auroraNoiseTex;

uvec3 hashU(uvec3 v)
{
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 hash3(ivec3 c) { return vec3(hashU(uvec3(c))) * (1.0 / 4294967296.0); }

// Tiling gradient hash: wraps only the U (x) cell index mod Nu — V/W pass through unwrapped
// (correct: they're never sampled across their own bake-volume edge at runtime).
vec3 gradHashWrapU(ivec3 c, int Nu)
{
    int x = c.x % Nu; if (x < 0) x += Nu;
    return normalize(-1.0 + 2.0 * hash3(ivec3(x, c.y, c.z)));
}

float perlinWrapU(vec3 p, int Nu)
{
    ivec3 i = ivec3(floor(p));
    vec3  f = fract(p);
    vec3  u = f * f * (3.0 - 2.0 * f);
    float v000 = dot(gradHashWrapU(i,                 Nu), f              );
    float v100 = dot(gradHashWrapU(i + ivec3(1,0,0), Nu), f - vec3(1,0,0));
    float v010 = dot(gradHashWrapU(i + ivec3(0,1,0), Nu), f - vec3(0,1,0));
    float v110 = dot(gradHashWrapU(i + ivec3(1,1,0), Nu), f - vec3(1,1,0));
    float v001 = dot(gradHashWrapU(i + ivec3(0,0,1), Nu), f - vec3(0,0,1));
    float v101 = dot(gradHashWrapU(i + ivec3(1,0,1), Nu), f - vec3(1,0,1));
    float v011 = dot(gradHashWrapU(i + ivec3(0,1,1), Nu), f - vec3(0,1,1));
    float v111 = dot(gradHashWrapU(i + ivec3(1,1,1), Nu), f - vec3(1,1,1));
    return mix(mix(mix(v000, v100, u.x), mix(v010, v110, u.x), u.y),
               mix(mix(v001, v101, u.x), mix(v011, v111, u.x), u.y), u.z);
}

const int   kCurtainTangentN = 256;
const int   kColumnTangentN  = 64;
// V-axis (altitude) cell count across the baked p.y range [0.24, 2.46] (= [kAuroraMarchInnerM,
// kAuroraMarchOuterM] * kAuroraAltFreq from sat_sky.frag — see that file for the derivation of
// those bounds). ~2.2 true cells span this range; a bit of headroom keeps the smoothstep corners
// from looking undersampled.
const float kAltCellsBake = 6.0;
// W-axis (colatitude) cell counts across the baked range [0deg, 75deg] (radians: [0, 1.309]).
// Curtain: colat*kAuroraRadialFreq(70) -> 1.309*70 = 91.6 cells. Column: colat*kAuroraColumnFreq
// (9)*0.5 -> 1.309*4.5 = 5.9 cells.
const float kRadialCellsBakeCurtain = 91.6;
const float kRadialCellsBakeColumn  = 5.9;

void main()
{
    ivec3 texSize = imageSize(auroraNoiseTex);
    ivec3 coord = ivec3(gl_GlobalInvocationID);
    if (any(greaterThanEqual(coord, texSize))) return;

    vec3 uvw = (vec3(coord) + 0.5) / vec3(texSize);

    float base = perlinWrapU(vec3(uvw.x * float(kCurtainTangentN),
                                   uvw.y * kAltCellsBake,
                                   uvw.z * kRadialCellsBakeCurtain),
                              kCurtainTangentN);

    // Seeds (11.3/47.9) match the live decorrelation constants — folded in as an additive offset
    // on the W input (2D-effective noise: U=azimuth, W=colatitude) rather than a true third axis,
    // since altitude (V) is already spoken for by the curtain channel and colA/colB never varied
    // with altitude live either way.
    float colA = perlinWrapU(vec3(uvw.x * float(kColumnTangentN),
                                   uvw.z * kRadialCellsBakeColumn + 11.3, 0.0),
                              kColumnTangentN);
    float colB = perlinWrapU(vec3(uvw.x * float(kColumnTangentN),
                                   uvw.z * kRadialCellsBakeColumn + 47.9, 0.0),
                              kColumnTangentN);

    imageStore(auroraNoiseTex, coord, vec4(base * 0.5 + 0.5, colA * 0.5 + 0.5, colB * 0.5 + 0.5, 1.0));
}
