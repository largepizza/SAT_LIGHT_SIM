#version 450
#extension GL_EXT_control_flow_attributes : enable

// Clouds v2 (.plans/CLOUDS_V2_PLAN.md): bakes the WEATHER CUBE from the real-Earth 8K cloud map,
// once at init, one dispatch per mip level. A cube, not the equirect source, so the march never
// pays an atan/asin per sample, and there is no longitude seam and no pinching at the poles.
//
//   R  coverage       the map's brightness (thin cloud reads grey, deep cloud white)
//   G  cloud type     0..1 over the type table in clouds_v2.glsl, in order of vertical
//                     development: stratus, stratocumulus, cumulus, congestus, cumulonimbus
//   B  precipitation  0..1 (deep, bright cloud; darkens bases, and later drives rain/lightning)
//   A  ground         the DEM height / 8 km, smoothed at this mip's scale (cloud bases follow the
//                     terrain). Read at the EARTH-FIXED direction, unlike the rest (the map drifts).
//                     Was the tropopause, a function of latitude only (now clouds_v2.glsl cv2Tropo).
//
// The type is CLASSIFIED, since the imagery carries no type: broken, high-variance brightness is
// convective (cumulus fields), smooth bright fields are stratiform decks, very bright convective
// cloud is deep (congestus/Cb) and more so in the tropics, and smooth cloud over cold ocean is
// stratus. Rough by construction, and why a type is always interpolated rather than switched.
//
// Face orientation is Vulkan's cube-map rule (spec, "Cube Map Face Selection"), inverted:
//   +X (1,-b,-a)  -X (-1,-b,a)  +Y (a,1,b)  -Y (a,-1,-b)  +Z (a,-b,1)  -Z (-a,-b,-1),  a,b in [-1,1].

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D earthCloudsTex;   // equirect, R8, full mip chain
layout(set = 0, binding = 1) uniform sampler2D earthSpecTex;     // equirect ocean mask (1 = water)
layout(rgba8, set = 0, binding = 2) writeonly uniform image2DArray outWeather;
layout(set = 0, binding = 3) uniform sampler2D earthElevTex;     // equirect R8 DEM (terrain.glsl encoding)
// Binding 5 (2026-10-25): level 1 of this cube (10 km), baked before level 0 (2048, 5 km), which takes its type, rain and
// ground from it and computes only the coverage at its own resolution (pc.pad 2 marks level 0).
layout(set = 0, binding = 5) uniform sampler2DArray wxLevel1;
// Binding 4: the storm objects' towers and their bins (cv2_storms.glsl, 2026-10-22): each storm brings its own cloud
// field into the map (stormStamp below).
#define CV2_STORM_BINDING 4
#define CV2_STORM_ENV
#include "cv2_storms.glsl"

// face: -1 = all six (the dispatch's z), else only that one (the incremental re-bake).
// EVOLUTION (decision A, .plans/CLOUDS_V2_PLAN.md; 2026-09-29): the map is read through two copies
// advected by a slow curl wind (evo1.x m/s), each over its own window of sim time — evo0.xy their ages
// (s), evo0.zw their weights (sin^2, 0 at each copy's reset) — so the map moves locally and never drifts
// from itself (a displacement of at most wind x the window), and its coverage grows and decays under a
// smooth field (evo1.y, sim time evo1.z). SatelliteSim re-bakes one face per frame as sim time moves.
// evo2: xyz the Sun's direction three hours ago in the map's frame, w "Afternoon land convection".
// remap (review 18): x "Coverage" (the map brightness multiplier, look.x), y the clear and z the full threshold
// (cover.xy), w this level's mip.
// wx (2026-10-22): xy cos / sin of the map's drift: d is in the MAP frame, and the land / sea mask is Earth-fixed;
// z the first row (2026-10-25: a face re-baked over several frames, a slice of rows each).
// storm: the flow warp (x rms displacement m, y its phase in cycles, z 1 / its period 1/m: wxFlowDisp); storm2 unused.
layout(push_constant) uniform PC { int faceSize; float srcLod; int face; float pad /* ring scale */; vec4 evo0; vec4 evo1; vec4 evo2;
                                   vec4 remap; vec4 wx; vec4 storm; vec4 storm2; } pc;

const float PI = 3.14159265359;
const float R_EARTH_W = 6371000.0;

// ── Weather v2 (2026-11-06, .plans/WEATHER_V2_PLAN.md): the weather is SYNTHESISED, not read from the satellite map ──
// coverage = a climatology (the ITCZ, the dry subtropics, the mid-latitude storm tracks, polar cloud, the cold-sea
// stratocumulus decks; following the Sun) + the Rossby waves' lift (poleward flow at 5 km: the warm conveyor's cloud
// bands, clear cold air behind them; Eulerian, so the bands move with the waves while the air moves through them) +
// moisture fBm ADVECTED by the steering wind (wind_field.glsl) through a two-phase flow map (both phases evaluated
// and blended variance-preservingly here, each renewal a fresh field). Storms are still the old stamps (step 3 makes
// every system a writer into these fields).
// Push constants (repurposed from the map's evolution): evo0 = the wind's state (wind_field.glsl ws); evo1.x the macro
// flow map's window count mod 1024, z its window (s); wx.x the sim time within the window (s).
#include "wind_field.glsl"

float wxHash(vec3 p)
{
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
}
vec3 wxGradV(vec3 c) { return normalize(vec3(wxHash(c), wxHash(c + 17.17), wxHash(c + 41.31)) - 0.5); }
// Gradient noise, ~[-1, 1] (std ~0.3).
float wxNoise(vec3 p)
{
    vec3 i = floor(p), f = p - i, u = f * f * (3.0 - 2.0 * f);
    float n000 = dot(wxGradV(i), f);
    float n100 = dot(wxGradV(i + vec3(1, 0, 0)), f - vec3(1, 0, 0));
    float n010 = dot(wxGradV(i + vec3(0, 1, 0)), f - vec3(0, 1, 0));
    float n110 = dot(wxGradV(i + vec3(1, 1, 0)), f - vec3(1, 1, 0));
    float n001 = dot(wxGradV(i + vec3(0, 0, 1)), f - vec3(0, 0, 1));
    float n101 = dot(wxGradV(i + vec3(1, 0, 1)), f - vec3(1, 0, 1));
    float n011 = dot(wxGradV(i + vec3(0, 1, 1)), f - vec3(0, 1, 1));
    float n111 = dot(wxGradV(i + vec3(1, 1, 1)), f - vec3(1, 1, 1));
    return 2.0 * mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                     mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
}
const float kWxL0   = 1.2e6;   // the moisture fBm's largest wavelength (m)
const float kWxGain = 0.7;   // (GMGSI: real cloud fields keep ~0.7 of the variance an octave down to ~30 km; 0.6 drew
                              // continent-sized blobs with little inside them)
float wxStagger(vec3 d) { return 0.31 * sin(dot(d, vec3(3.3, -2.1, 1.7)) + 1.3) + 0.21 * sin(dot(d, vec3(-2.6, 1.4, 3.9)) + 0.4); }
// One phase of octave o's flow map: its material position (in kWxL0 units, with the window's fresh-field offset) and
// weight. nW: the octave's windows per evo1.z; c: the phase (half a window apart).
vec3 wxPhase(vec3 d, vec3 W0, int o, float nW, float fT, int c, out float w)
{
    float fc  = fT + 0.5 * float(c);
    float f   = fract(fc);
    w = sin(PI * f);
    float age = f * pc.evo1.z / nW;
    // Back along the steering wind (a midpoint step for the day-long windows of the two largest octaves).
    vec3  Wm  = o < 2 ? wfWind(normalize(d - W0 * (0.5 * age / R_EARTH_W)), 3000.0, pc.evo0) : W0;
    vec3  dc  = normalize(d - Wm * (age / R_EARTH_W));
    float k   = pc.evo1.x * nW + floor(fc) + 0.5 * float(c);
    vec3  sd  = fract(sin(vec3(k * 12.9898 + float(o) * 3.7, k * 78.233 + float(o) * 1.3, k * 37.719)) * 43758.5453) * 97.0;
    return dc * (R_EARTH_W / kWxL0) + sd;
}
// The moisture fBm through a flow map PER OCTAVE (2026-11-06, benchmarked against NOAA GMGSI's hourly global IR mosaic:
// a cloud pattern's Lagrangian lifetime grows ~linearly with its size, ~4.5 h at 512 km, ~9 h at 1000 km, ~1 day at
// 2000 km; one window for every scale renewed the continents' weather every few hours). Octave o (wavelength
// kWxL0 / 2.03^o) renews over its own window evo1.z / 2^o (>= 1/32 of it): two phases half a window apart, each carried
// back along the steering wind by its age with a fresh field per window, weighted sin / cos (their squares sum to 1: the
// variance is kept). A two-phase window of P decorrelates (1/e) in ~0.45 P. The domain warp (fronts and comma shapes,
// not round blobs) is the largest octave's, applied to every octave. varOut: the variance of the octaves under minL.
float wxMoistureNoise(vec3 d, float minL, float maxL, out float varOut)
{
    float st = wxStagger(d);
    vec3  W0 = wfWind(d, 3000.0, pc.evo0);
    float fT0 = pc.wx.x / pc.evo1.z + st;
    float wA, wB;
    vec3  pA = wxPhase(d, W0, 0, 1.0, fT0, 0, wA);
    vec3  pB = wxPhase(d, W0, 0, 1.0, fT0, 1, wB);
    vec3  warp = 0.35 * (wA * vec3(wxNoise(pA * 0.7 + 3.1), wxNoise(pA * 0.7 + 7.9), wxNoise(pA * 0.7 + 12.4))
                       + wB * vec3(wxNoise(pB * 0.7 + 3.1), wxNoise(pB * 0.7 + 7.9), wxNoise(pB * 0.7 + 12.4)));
    float n = 0.0, a = 1.0, L = kWxL0, v = 0.0, fq = 1.0;
    for (int o = 0; o < 9; ++o) {
        if (L < minL) v += a * a;
        else if (L <= maxL) {
            float nW = float(1 << min(o, 5));
            float fT = pc.wx.x / pc.evo1.z * nW + st + 0.618034 * float(o);
            if (o > 0) {
                pA = wxPhase(d, W0, o, nW, fT, 0, wA);
                pB = wxPhase(d, W0, o, nW, fT, 1, wB);
            }
            n += a * (wA * wxNoise(pA * fq + warp * fq) + wB * wxNoise(pB * fq + warp * fq));
        }
        a *= kWxGain; L *= 0.4926; fq *= 2.03;
    }
    varOut = v * 0.09 * 0.55 * 0.55;   // (gradient noise's variance ~0.09 a unit amplitude)
    return n * 0.55;                   // (0.62 at gain 0.6: the same total variance)
}
// Expected value of clamp(x + N(0, s^2), 0, 1): the true mean coverage of a field whose finer octaves were left out.
float wxPos(float z) { return z / (1.0 + exp(-1.702 * z)) + exp(-0.5 * z * z) * 0.3989; }
float wxExpectedCover(float x, float s)
{
    if (s < 1e-3) return clamp(x, 0.0, 1.0);
    return clamp(s * (wxPos(x / s) - wxPos((x - 1.0) / s)), 0.0, 1.0);
}
// Cold-upwelling stratocumulus decks off the subtropical west coasts (lat, lon of each centre, deg).
float wxScDecks(vec3 d)
{
    const vec2 c[5] = vec2[5](vec2(28.0, -126.0), vec2(-18.0, -82.0), vec2(-19.0, 6.0), vec2(24.0, -22.0), vec2(-28.0, 106.0));
    float s = 0.0;
    for (int i = 0; i < 5; ++i) {
        float la = radians(c[i].x), lo = radians(c[i].y);
        vec3  a  = vec3(cos(la) * cos(lo), cos(la) * sin(lo), sin(la));
        float r  = acos(clamp(dot(a, d), -1.0, 1.0)) * R_EARTH_W;
        s = max(s, exp(-(r * r) / (1.3e6 * 1.3e6)));
    }
    return s;
}
// The climatology and the waves' lift at d (Eulerian). raw: coverage before the noise; strat / conv / deep 0..1.
struct WxClim { float raw; float strat; float conv; float deep; float lift; };
const float kWxContrast = 0.9;   // coverage per unit of moisture potential
const float kWxNoise    = 1.5;   // the moisture fBm's weight in the potential
WxClim wxClimate(vec3 d, float ocean)
{
    WxClim o;
    float lat  = asin(clamp(d.z, -1.0, 1.0));
    float latS = lat - 0.35 * pc.evo0.y;
    float a    = abs(latS) * (180.0 / PI);
    float land = 1.0 - ocean;
    float itcz = wfG(a, 0.0, 4.5);
    float dry  = wfG(a, 25.0, 8.0);
    float mid  = wfG(a, 52.0, 10.0);
    float pol  = wfG(a, 75.0, 10.0);
    float sc   = wxScDecks(d) * ocean;
    // The MOISTURE POTENTIAL (coverage = 0.5 + kWxContrast x it, main): > ~0.55 overcast, < ~-0.55 clear.
    float raw  = -0.05 + 0.45 * itcz - (0.75 + 0.45 * land) * dry + (0.3 + 0.2 * ocean) * mid + 0.25 * pol + 0.9 * sc;
    // The Rossby waves' lift: poleward flow at 5 km (the warm conveyor, ahead of a trough) clouds over; equatorward
    // (the cold air behind it) clears into open cumulus.
    vec3  w5    = wfWind(d, 5000.0, pc.evo0);
    vec3  east  = normalize(vec3(-d.y, d.x, 0.0) + vec3(1e-6, 0.0, 0.0));
    vec3  north = cross(d, east);
    float pole  = dot(w5, north) * (lat >= 0.0 ? 1.0 : -1.0);
    float lift  = clamp(pole / 10.0, -1.5, 1.5) * smoothstep(20.0, 35.0, a);
    raw += 0.5 * lift;   // (the long frontal bands are the extratropical systems' own; this is the waves' background)
    o.raw   = raw;
    o.lift  = lift;
    o.strat = clamp(smoothstep(0.15, 0.8, lift) + sc + 0.6 * pol, 0.0, 1.0);
    o.conv  = clamp(0.75 * wfG(a, 15.0, 9.0) * ocean + itcz + smoothstep(0.1, 0.9, -lift) * 0.8 + 0.3 * land * (1.0 - pol), 0.0, 1.0)
            * (1.0 - 0.7 * o.strat);
    o.deep  = clamp(itcz * (0.6 + 0.4 * land) + 0.35 * wfG(a, 12.0, 8.0), 0.0, 1.0);
    return o;
}

// Growth and decay: a smooth field (~1500 km) whose waves drift through their phases over 10-30 h.
float evoGrowth(vec3 d)
{
    const vec3 kd[6] = vec3[6](vec3( 0.73,  0.21, -0.65), vec3(-0.25,  0.91,  0.33), vec3( 0.47, -0.58,  0.66),
                               vec3(-0.81, -0.44, -0.39), vec3( 0.05, -0.29, -0.96), vec3(-0.52,  0.63,  0.58));
    const float T[6] = float[6](2592000.0 / 72.0, 2592000.0 / 50.0, 2592000.0 / 36.0, 2592000.0 / 58.0, 2592000.0 / 26.0, 2592000.0 / 41.0);
    float k1 = 2.0 * PI * R_EARTH_W / 1.5e6;
    float g  = 0.0;
    [[unroll]] for (int i = 0; i < 6; ++i)
        g += cos(dot(normalize(kd[i]) * k1, d) + float(i) * 1.7 + pc.evo0.x * (2.0 * PI / T[i]));   // (the wind clock)
    return g / 1.73;                                     // ~unit rms
}

vec3 faceDir(int face, vec2 st)
{
    float a = st.x * 2.0 - 1.0, b = st.y * 2.0 - 1.0;
    vec3 d;
    if      (face == 0) d = vec3( 1.0, -b, -a);
    else if (face == 1) d = vec3(-1.0, -b,  a);
    else if (face == 2) d = vec3(  a, 1.0,  b);
    else if (face == 3) d = vec3(  a,-1.0, -b);
    else if (face == 4) d = vec3(  a, -b, 1.0);
    else                d = vec3( -a, -b,-1.0);
    return normalize(d);
}

// Same equirect convention as cloud_march.comp / sat_sky.frag (pUVGeo): u from -180 deg, v from the north pole.
vec2 equirectUV(vec3 d)
{
    float lon = atan(d.y, d.x);
    float lat = asin(clamp(d.z, -1.0, 1.0));
    return vec2((lon + PI) / (2.0 * PI), (0.5 * PI - lat) / PI);
}

// The equirect UV of a tap dc + tx o.x + ty o.y, from dc's own UV and latitude (one exact conversion) and a first-order
// step: exact in latitude, the longitude step / cos(lat) at the tap's latitude. Valid while tx / ty are the local east /
// north and the offset small (gEqLin, set per texel). At 2048 an atan and an asin per tap (~37 a texel) were most of
// the bake's cost: all six faces 16-20 ms a frame in time warp (2026-10-25).
bool gEqLin = false;
vec2 eqTap(vec3 dc, vec2 uvc, float latc, vec3 tx, vec3 ty, vec2 o)
{
    if (!gEqLin) return equirectUV(normalize(dc + tx * o.x + ty * o.y));
    float lat = latc + o.y;
    return uvc + vec2(o.x / (2.0 * PI * max(cos(lat), 1e-3)), -o.y / PI);
}

// ── Weather v2 convection: the convection cube (layers 6-11 of this image, binding 6) ──
// x  convective intensity: the cells (catalog towers) as Gaussian cores, soft-unioned
// y  the column's top as a share of the way to the lid (the strongest core's here)
// z  the ANVIL: what the storms detrained at the lid, integrated over the time since each reached it along its
//    storm-relative upper wind, spreading as it goes and decaying over its linger. So an anvil grows out of the column
//    as the column reaches the lid, streams downwind, outlives its storm and fades; neighbours' anvils sum in one field
//    (no props to intersect).
// w  the MID-LEVEL outflow: the same integral at the steering level (~0.4 of the storm-relative upper wind) with a longer
//    life (1.5 x): the trailing stratiform deck and its rain (a line system's especially)
// env (out): the storms' ENVIRONMENT, the cells widened ~2.5x: the cumulus field round a storm (coverage, not stored)
layout(rgba8, set = 0, binding = 6) writeonly uniform image2DArray outConv;
// A line system's GUST FRONT (wxConvection's out globals): its cold pool runs ahead of the line and lifts the moist inflow
// over it into a SHELF CLOUD, a low, flat-based wedge rising from the front back to the towers' bases, with the clear air
// the outflow pushes ahead of it. gShelf the shelf's share, gShelfH where in it (0 at the front, 1 at the towers),
// gAhead the clear band ahead.
float gShelf = 0.0, gShelfH = 0.0, gAhead = 0.0;
vec4 wxConvection(vec3 d, out float env, bool cellsOnly)
{
    float lat = asin(clamp(d.z, -1.0, 1.0)) * (180.0 / PI), lon = atan(d.y, d.x) * (180.0 / PI);
    uint  la  = uint(clamp(floor((lat + 90.0) * 0.5), 0.0, float(kCv2ConvGridLat - 1u)));
    uint  lo  = uint(clamp(floor((lon + 180.0) * 0.5), 0.0, float(kCv2ConvGridLon - 1u)));
    uvec2 g   = cv2ConvGrid[la * kCv2ConvGridLon + lo];
    float notC = 1.0, top = 0.0, anv = 0.0, mid = 0.0, notE = 1.0;
    float dIn = -20000.0, drop = 10000.0;   // the cells' COLUMN as distance fields (level 0's z / w): see below
    for (uint k = 0u; k < g.y; ++k) {
        uint e = cv2ConvList[g.x + k];
        if ((e & 0x80000000u) == 0u) {
            CV2Cell c = cv2Cells[e];
            float r  = acos(clamp(dot(d, c.a.xyz), -1.0, 1.0)) * R_EARTH_W;
            float ci = c.b.x * exp(-(r * r) / (c.a.w * c.a.w));
            notC *= 1.0 - ci;
            notE *= 1.0 - c.b.x * exp(-(r * r) / (6.25 * c.a.w * c.a.w));
            // Its column ANALYTICALLY: the radius where this cell alone passes the march's contour (0.35) and, inside it, how
            // far its round head drops below its top (a cap as round as the column, <= 5 km). From the intensity alone a
            // weaker cell came out narrower AND lower, and a ~5-km core sampled at 5-km texels lost a third of its peak: a
            // squall line's towers stood as stubs half-way to the lid.
            if (c.b.x > 0.36) {
                float rc = c.a.w * sqrt(log(c.b.x / 0.35));
                float di = rc - r;
                if (di > dIn) {
                    dIn = di;
                    float rh = min(rc, 5000.0), dh = clamp(rh - di, 0.0, rh);
                    drop = rh - sqrt(max(rh * rh - dh * dh, 0.0));
                }
            }
            top = max(top, c.b.y * smoothstep(0.02, 0.1, ci));   // (the cell's own top across its core: a falloff drew cones)
            if (c.c.w > 0.0) {
                // its gust front, c.c.w ahead of its column's edge along its forward c.c.xyz; across the line each cell's
                // share overlaps its neighbours' (~17 km apart), so the union traces the line's bow
                float rcS = c.a.w * sqrt(log(max(c.b.x, 0.36) / 0.35)) + 0.5 * c.a.w;
                float fS  = dot(d - c.a.xyz, c.c.xyz) * R_EARTH_W;
                float lS2 = max(r * r - fS * fS, 0.0);
                float fF  = rcS + c.c.w;
                float wL  = exp(-lS2 / (2.0 * 4.8 * c.a.w * c.a.w)) * smoothstep(0.3, 0.6, c.b.x);
                float sh  = wL * smoothstep(fF + 1500.0, fF - 1500.0, fS) * smoothstep(0.4 * rcS, 0.9 * rcS, fS);
                if (sh > gShelf) { gShelf = sh; gShelfH = clamp((fF - fS) / max(fF - 0.6 * rcS, 1.0), 0.0, 1.0); }
                gAhead = max(gAhead, wL * smoothstep(fF, fF + 3000.0, fS) * smoothstep(fF + 25000.0, fF + 8000.0, fS));
            }
        } else if (!cellsOnly) {
            CV2Anvil A = cv2Anvils[e & 0x7FFFFFFFu];
            float cd = dot(d, A.a.xyz);
            vec3  v  = d - A.a.xyz * cd;
            float sv = length(v);
            float kk = (sv > 1e-9 ? atan(sv, cd) / sv : 1.0) * R_EARTH_W;
            vec3  sd = cross(A.a.xyz, A.b.xyz);
            vec2  p  = vec2(dot(v, A.b.xyz), dot(v, sd)) * kk;          // (downwind, across) m
            vec2  ax = vec2(dot(A.d.yzw, A.b.xyz), dot(A.d.yzw, sd));   // the line's axis in that frame
            float tauL = A.c.z;
            float sMax = min(A.c.x, 4.0 * tauL), sMin = max(A.c.x - A.c.y, 0.0);
            if (sMin >= sMax) continue;
            float acc = 0.0, accM = 0.0, ds = (sMax - sMin) / 8.0;
            for (int j = 0; j < 8; ++j) {
                // (quadratic spacing, each tap weighted by its share 2u: dense on the young outflow at the tops it leaves.
                // Evenly spaced over hours, the youngest tap was ~30 min old and ~20 km downwind: a line's shield stood apart
                // from its towers with a gap between)
                float uq = (float(j) + 0.5) / 8.0;
                float s  = sMin + (sMax - sMin) * uq * uq;
                float wq = 2.0 * uq;
                // The outflow spreads at ~7 m/s for its first 2 h (a mature anvil ~100 km across); what it holds thins as it spreads (x r0 / r; (r0 / r)^2 at 3 m/s),
                // so the oldest outflow frays into cirrus. A compact disc, not a Gaussian: overlapping Gaussian tails of
                // neighbouring storms summed into one continent-sized plate.
                float rk = A.a.w + 7.0 * min(s, 7200.0);
                // Anisotropic: the outflow spreads mostly downwind (its centre a further 0.4 of the spread on), narrower
                // across the wind; upwind it overhangs only a little (a saucer round the column otherwise).
                vec2  q  = p - vec2(A.c.w * s + 0.4 * (rk - A.a.w), 0.0);
                if (A.d.x > 0.0) q -= ax * clamp(dot(q, ax), -A.d.x, A.d.x);   // to the line segment
                float dq = length(q * vec2(1.0, 1.25)) / rk;
                float rr = A.a.w / rk;
                acc += wq * exp(-s / tauL) * (1.0 - smoothstep(0.55, 1.1, dq)) * rr;   // (r0 / r: it thins as it spreads, vertically too)
                // the mid-level outflow: slower downwind, wider, longer-lived; it too spreads downwind (its upwind edge stays
                // near the source: spread evenly, a line's trailing stratiform reached ~35 km AHEAD of its towers as a
                // deck over the shelf and the clear air)
                float rkM = 1.3 * A.a.w + 2.0 * min(s, 7200.0);
                vec2  qm = p - vec2(0.4 * A.c.w * s + 0.85 * (rkM - 1.3 * A.a.w), 0.0);
                if (A.d.x > 0.0) qm -= ax * clamp(dot(qm, ax), -A.d.x, A.d.x);
                float rrM = 1.3 * A.a.w / rkM;
                accM += wq * exp(-s / (1.5 * tauL)) * (1.0 - smoothstep(0.5, 1.1, length(qm) / rkM)) * rrM * rrM;
            }
            // (/ 1200 s since 2026-11-06: at / 2400 a lone supercell's outflow in a 20 m/s upper wind integrated to ~0.15-0.5,
            // round the plate's 0.3 outline: the storm review's lab cell had no anvil at any age)
            anv += A.b.w * acc * ds / 1200.0;
            mid += A.b.w * accM * ds / 3600.0 * (A.d.x > 0.0 ? 2.0 : 1.0);
        }
    }
    env = 1.0 - notE;
    // (no shelf over any cell's core or the ground ahead of it: in a bow the flank cells' shelves reach forward over the
    // middle cells' columns, and typed as a deck there they flattened the line's towers)
    gShelf *= 1.0 - smoothstep(0.04, 0.2, 1.0 - notC);
    // The outflow is not a swept disc: its integral is modulated by two octaves of noise (~120 and ~40 km), so an anvil's or
    // a line's shield has a lobed, irregular outline and uneven thickness (a line source drew a perfect pill from orbit).
    float nA = 0.0;
    if (anv + mid > 0.0) {
        vec3 pn = d * (R_EARTH_W / 1.2e5);
        nA = 0.65 * wxNoise(pn + vec3(5.1, 2.7, 9.3)) + 0.35 * wxNoise(pn * 3.0 + vec3(1.3, 8.8, 4.2));
    }
    float kN = clamp(1.0 + 1.0 * nA, 0.5, 1.6);   // (0.25-1.8 split a lone storm's anvil in two)
    // (level 0, cellsOnly: z / w are the cells' column distance fields, encoded +-20 km and 0..10 km)
    if (cellsOnly) return vec4(1.0 - notC, top, clamp(0.5 + dIn / 40000.0, 0.0, 1.0), clamp(drop / 10000.0, 0.0, 1.0));
    return vec4(1.0 - notC, top, 1.0 - exp(-1.5 * anv * kN), 1.0 - exp(-1.5 * mid * kN));
}


// ── Weather v2 tropical cyclones (Phase 3, 2026-11-06): the catalog's cyclones (cv2Cyclones) as SYSTEMS that write fields ──
// In the storm's polar frame (r from the centre, th counter-clockwise looking down, the southern hemisphere mirrored so
// both wind up cyclonically), everything scaled by the radius of maximum wind (RMW) and the outer bands' reach:
//   eyewall  a ring of full-height convection at ~1.1 RMW (the convection cube's cores: its columns)
//   bands    n log-spiral rain bands (pitch ~15 deg) winding inward cyclonically from the outer reach to ~1.5 RMW, broken
//            into segments along their length (convective, shorter tops)
//   CDO      the upper outflow over the core out to the CDO radius (the anvil field: its plate), the eye punched through it,
//            and beyond it outflow cirrus in arms winding OUT anticyclonically
//   deck     stratiform rain between the bands (the mid outflow)
//   coverage the system owns its disc: overcast core, bands and stratiform, the eye clear, subsidence at its edge
// conv (out): x intensity, y top share, z anvil, w mid, to max into the convection cube. Returns (potential, strat, conv, own).
float cv2Sq(float x) { return x * x; }
float wxTcBand(float th, float lr, float n, float cotA, float ph, float sharp)
{
    float phi = n * (th + cotA * lr) + ph;
    return pow(0.5 + 0.5 * cos(phi), sharp);
}
float gTcRain = 0.0, gTcOwn = 0.0;   // wxCyclones: the cyclones' own rain and how much of this point they own
vec4 wxCyclones(vec3 d, out vec4 conv)
{
    conv = vec4(0.0);
    vec4 best = vec4(0.0);
#ifdef CV2_STORM_BINDING
    for (uint i = 0u; i < min(cv2CycHead.x, kCv2CycloneMax); ++i) {
        CV2Cyclone cy = cv2Cyclones[i];
        float outer = max(cy.c.z, 1.0e5);
        float cd = dot(d, cy.a.xyz);
        float r  = acos(clamp(cd, -1.0, 1.0)) * R_EARTH_W;
        if (r > 1.25 * outer) continue;
        float I    = cy.a.w;                               // 0..1 (17.5 .. 75 m/s)
        float rmw  = max(cy.d.x, 8000.0);
        float eyeR = cy.a.w >= 0.3 ? max(cy.c.x, 0.5 * rmw) : 0.0;   // (= the march's stadium, cv2StormGeom)
        float cdoR = max(cy.c.y, 1.5 * rmw);
        float hemi = cy.b.w;
        vec3  e  = normalize(cross(vec3(0.0, 0.0, 1.0), cy.a.xyz) + vec3(1e-6, 0.0, 0.0));
        vec3  nn = cross(cy.a.xyz, e);
        vec3  v  = d - cy.a.xyz * cd;
        float th = atan(dot(v, nn) * hemi, dot(v, e));     // (mirrored in the south: cyclonic = counter-clockwise here)
        float lr = log(max(r, 100.0) / rmw);
        const float cotA = 3.73;                            // cot(15 deg): the bands' pitch
        // The eyewall: a ring of cores just outside the RMW, full height from tropical-storm strength on.
        float eyw = exp(-cv2Sq((r - 1.1 * rmw) / (0.45 * rmw))) * smoothstep(0.05, 0.4, I);
        // The rain bands: n arms (continuous, from the catalog), segmented along their length.
        float nA   = max(cy.d.w, 2.0);
        float bnd  = wxTcBand(th, lr, floor(nA + 0.5), cotA, cy.c.w, 6.0);
        float seg  = smoothstep(-0.2, 0.5, sin(4.0 * lr * 2.3 + th * 1.0 + cy.c.w * 1.7) + 0.4 * sin(9.0 * lr + 2.0 * th));
        float band = bnd * seg * smoothstep(1.4 * rmw, 2.2 * rmw, r) * (1.0 - smoothstep(0.65 * outer, outer, r));
        // The CDO (upper outflow) and the outflow cirrus winding out anticyclonically beyond it; the eye through both.
        float eyeK = eyeR > 0.0 ? smoothstep(0.75 * eyeR, 1.15 * eyeR, r) : 1.0;
        // (soft, and streaked along the outflow's spiral: a hard disc stood as a lid with a cliff round it)
        // (its outline irregular: a smooth noise on the radius, not the spiral streaks, which drew a polygon)
        float rq   = r * (1.0 + 0.18 * wxNoise(d * (R_EARTH_W / 2.5e5) + vec3(cy.c.w, 3.1, 7.7)));
        // The CDO: one disc whose OUTLINE spirals out along the bands (its radius modulated by them) and FEATHERS over a
        // wide radius (the plate thins and its density falls with the field: a translucent edge). Arms of plate laid along
        // the bands stood as glossy tubes with walls and drop shadows over the decks (2026-11-06, the user: "out of place").
        float bndW = wxTcBand(th, lr, floor(nA + 0.5), cotA, cy.c.w, 1.5);
        float rS   = rq / (1.0 + 0.35 * bndW * smoothstep(0.5 * cdoR, 1.2 * cdoR, r));
        // (2026-11-06, the user: the CDO "looks super out of place ... morph it out of existing cloud layers"): the CDO is the
        // top of the core's deep convective MASS, not an anvil plate laid over the decks: the convection cube's intensity
        // and top cover the disc (the cumulus field draws it from its base to under the lid, with its own material, the
        // column's flare at its edge), its outline spiralling out with the bands.
        float cdo  = (1.0 - smoothstep(0.6 * cdoR, 1.15 * cdoR, rS)) * smoothstep(0.1, 0.5, I);
        // Its TOP slopes down over its outer half to meet the decks (full height it stood as a cake with vertical walls), and
        // reaches the decks' height (~0.1 of the way to the lid) where its intensity falls through the columns' threshold
        // (cdo ~0.38, rS ~0.9 cdoR): ending there at 0.38 it stood as a ~4-km cliff, a hard bright rim round the CDO from orbit.
        float cdoT = (1.0 - smoothstep(0.25 * cdoR, 0.92 * cdoR, rS)) * smoothstep(0.1, 0.5, I);
        float cdoB = 0.1 + 0.2 * (1.0 - smoothstep(0.55 * cdoR, 0.92 * cdoR, rS));
        float oc   = wxTcBand(-th, lr, 3.0, cotA * 0.8, cy.c.w * 0.7 + 1.0, 3.0) * smoothstep(0.9 * cdoR, 1.3 * cdoR, r)
                   * (1.0 - smoothstep(0.8 * outer, 1.2 * outer, r)) * smoothstep(0.3, 0.7, I);
        // (the outflow cirrus stays under the plate's threshold, 0.3: thin ice for the high layer, not lens-shaped plates
        // drawn as tubes)
        float anv  = 0.25 * oc * eyeK;   // (no plate: the outflow cirrus only, under the plate's threshold)
        // Stratiform between the bands (the mid outflow's deck) inside ~0.8 of the reach.
        float deck = 0.55 * (1.0 - bnd) * smoothstep(1.3 * rmw, 2.0 * rmw, r) * (1.0 - smoothstep(0.3 * outer, 0.55 * outer, r))
                   * smoothstep(0.1, 0.5, I);
        // The bands' convection stays under the columns' threshold (cv2StormGeom, 0.35): congestus lines of the cumulus field
        // (their coverage below), not domed columns (a continuous band of cores drew a smooth tube). The eyewall's are columns.
        float Cc   = max(max(eyw, 0.3 * band), 0.92 * cdo) * eyeK;
        // (the bands' convection under the columns' threshold: congestus lines of the cumulus field; the core's mass near the
        // lid, the eyewall part of it)
        vec4  cvI  = vec4(Cc, max(max(0.97 * eyw, cdoB + 0.67 * cdoT) * eyeK * step(0.01, Cc), 0.5 * band), anv, deck);
        // Its rain (the radar, the shafts): heavy in the eyewall and the bands, moderate stratiform under the rest of the core.
        gTcRain = max(gTcRain, max(max(0.95 * eyw * eyeK, 0.7 * band), max(0.45 * cdo * eyeK, 0.4 * deck)) * (1.0 - smoothstep(0.85 * outer, 1.2 * outer, r)));
        gTcOwn  = max(gTcOwn, 1.0 - smoothstep(0.85 * outer, 1.2 * outer, r));
        conv = max(conv, cvI);
        // The coverage: the system's potential (the climatology's units), owning its disc.
        // (the decks round the core near overcast: broken, they read grey with sea between them beside a white CDO)
        float M    = -0.3 + 1.9 * max(max(Cc, band), max(0.85 * cdo * eyeK, 1.35 * deck)) - 1.4 * (1.0 - eyeK);
        float own  = 1.0 - smoothstep(0.85 * outer, 1.2 * outer, r);
        if (own > best.w) best = vec4(M, max(cdo, deck), max(Cc, band), own);
    }
#endif
    return best;
}

// ── Weather v2 systems (cv2_storms.glsl CV2System, WeatherSystems.h) ──
// An extratropical cyclone's COMMA CLOUD in its own frame: X along its heading, Y poleward (so the southern
// hemisphere's clockwise rotation is the same counter-clockwise wind-up), both in head radii, the low at the origin.
//   comma head  a band spiralling inward and cyclonically from the warm front's root, wrapping further as it occludes
//   warm front  a broad stratiform shield poleward of a front running ahead (east-north-east) of the low
//   cold front  a long, narrow band trailing equatorward and curving back west (convective along its line)
//   dry slot    clear air wrapping into the low behind the cold front, wider as it occludes
//   cold air    open cumulus behind the cold front
// Between the features the system subsides (clear-ish). Returns x the moisture potential it sets (the climatology's
// units), y its stratiform share, z its convective share, w how much it owns this point (0..1).
vec4 wxEtc(float X, float Y, float occ)
{
    float r  = length(vec2(X, Y));
    float th = atan(Y, X);
    // Comma head: a log spiral from the warm front's root (th0, just south of east) wound cyclonically to thEnd.
    const float th0 = -0.35;
    float thEnd = 1.3 + 3.4 * occ;
    float head  = 0.0;
    for (int k = 0; k < 2; ++k) {
        float tw = th - th0;
        tw = tw - 6.2831853 * floor(tw / 6.2831853) + 6.2831853 * float(k);   // [0, 2pi) then the next turn
        if (tw > thEnd - th0) continue;
        float ra = 1.15 * exp(-0.30 * tw);                                    // the arm's radius at this angle
        float wd = mix(0.30, 0.20, tw / max(thEnd - th0, 1e-3));              // its width in ln r: broader at the root
        float lr = log(max(r, 1e-3) / ra);
        // Faded in from the warm front's root and out at its tip (a band starting at full strength on the th0 ray, ~3
        // head radii wide in ln r, drew hard arcs across the map).
        head = max(head, exp(-(lr * lr) / (wd * wd)) * smoothstep(0.0, 0.9, tw) * smoothstep(thEnd - th0, thEnd - th0 - 0.6, tw));
    }
    // The low's own cloud mass inside the head (a filled comma at first, opening into the occluded spiral).
    head = max(head, (1.0 - smoothstep(0.25, 0.75 + 0.2 * (1.0 - occ), r)) * (1.0 - 0.6 * occ));
    head *= 1.0 - smoothstep(1.5, 2.2, r);
    // Warm front: from the root ahead of the low; the shield lies poleward of it (overrunning warm air).
    // (The front curves poleward ahead of the low; its edges are soft: a straight, sharp front drew hard arcs on the map.)
    float yWf  = 0.12 * X + 0.10 * X * X;
    float aboveWf = Y - yWf;
    float warm = smoothstep(-0.35, 0.2, aboveWf) * (1.0 - smoothstep(0.4, 1.2, aboveWf))
               * smoothstep(-0.4, 0.3, X) * (1.0 - smoothstep(0.9 + 0.5 * (1.0 - occ), 2.1, X)) * (1.0 - 0.5 * occ);
    // Cold front: param t = -Y / Lc along it, its line curving back west.
    const float Lc = 3.4;
    float tc  = -Y / Lc;
    float xCf = Lc * (0.10 * tc - 0.50 * tc * tc) + 0.15 * (1.0 - occ);
    float wCf = mix(0.22, 0.10, clamp(tc, 0.0, 1.0));
    float dx  = X - xCf;
    float cold = exp(-(dx * dx) / (wCf * wCf)) * smoothstep(-0.05, 0.1, tc) * (1.0 - smoothstep(0.7, 1.0, tc));
    // A broader, weaker pre-frontal band in the warm sector.
    cold = max(cold, 0.45 * exp(-((dx - 0.3) * (dx - 0.3)) / 0.12) * smoothstep(0.0, 0.15, tc) * (1.0 - smoothstep(0.5, 0.85, tc)));
    // Dry slot: behind the cold front, wrapping toward the low.
    float dry = smoothstep(0.08, 0.35, -dx) * exp(-((Y + 0.45) * (Y + 0.45)) / 0.5) * (1.0 - smoothstep(0.9, 1.7, r))
              * (0.35 + 0.65 * occ);
    // Cold air behind the front: open cumulus.
    float coldAir = smoothstep(0.25, 0.8, -dx) * smoothstep(-3.2, -0.6, Y) * (1.0 - smoothstep(0.3, 1.3, Y))
                  * (1.0 - smoothstep(2.5, 3.6, -dx));
    float band = max(max(head, warm), cold);
    float M    = -0.55 + 1.75 * band - 1.0 * dry + 0.35 * coldAir * (1.0 - band);
    float strat = max(head, warm) * (1.0 - 0.5 * cold);
    float conv  = clamp(0.7 * cold + coldAir * (1.0 - band), 0.0, 1.0);
    // Ownership: the region the system organises (an ellipse stretched along the cold front's trail).
    float own = 1.0 - smoothstep(2.0, 3.2, length(vec2(X - 0.3, (Y + (Y < 0.0 ? 0.0 : 0.0)) * (Y < 0.0 ? 0.55 : 1.0))));
    return vec4(M, strat, conv, own);
}

vec4 wxSystems(vec3 d)
{
    float m = 0.0, st = 0.0, cv = 0.0, ws = 0.0, own = 0.0;
    uint n = min(cv2SysHead.x, kCv2SystemMax);
    for (uint i = 0u; i < n; ++i) {
        CV2System S = cv2Systems[i];
        float cd = dot(d, S.a.xyz);
        if (cd < S.d.w) continue;
        vec3  e2 = cross(S.a.xyz, S.b.xyz) * S.c.y;          // poleward
        // Azimuthal equidistant about the centre (true distances: a tangent-plane projection compressed the far points
        // inside the ownership region, which the reach test then cut in hard arcs).
        vec3  v  = d - S.a.xyz * cd;
        float sv = length(v);
        float k  = (sv > 1e-7 ? atan(sv, cd) / sv : 1.0) * R_EARTH_W / S.a.w;
        float X  = dot(v, S.b.xyz) * k;
        float Y  = dot(v, e2) * k;
        vec4  e  = wxEtc(X, Y, S.c.x);
        float w  = e.w * S.b.w;
        if (w <= 0.0) continue;
        m += w * e.x; st += w * e.y; cv += w * e.z; ws += w;
        own = max(own, w);
    }
    if (ws <= 0.0) return vec4(0.0);
    return vec4(m / ws, st / ws, cv / ws, own);
}

// The FLOW WARP (= clouds_v2.glsl cv2FlowDisp, the curl of eight smooth waves): bends the BACKGROUND field (climatology,
// moisture) into curved bands and swirls. Applied here, not in the march's map read: read through it there, the whole
// map sat ~100 km (its rms) from the convection cube, so a storm's cumulus, its trailing stratiform and a line's shelf
// stood apart from its columns ("two blobs" from above), the CDO off its eye, and the radar off the towers.
vec3 wxFlowDisp(vec3 d)
{
    if (pc.storm.x <= 0.0) return vec3(0.0);
    const vec3 kd[8] = vec3[8](vec3( 0.62,  0.48,  0.62), vec3(-0.71,  0.30,  0.64), vec3( 0.18, -0.93,  0.32),
                               vec3( 0.85,  0.21, -0.48), vec3(-0.34, -0.55, -0.76), vec3( 0.05,  0.77, -0.64),
                               vec3(-0.90, -0.40,  0.17), vec3( 0.44, -0.29,  0.85));
    const float ks[8] = float[8](1.0, 1.13, 0.87, 1.31, 0.74, 1.52, 0.93, 1.21);
    const float ph[8] = float[8](0.3, 2.1, 4.4, 1.7, 5.6, 3.2, 0.9, 2.7);
    float k0 = 6.2831853 * R_EARTH_W * pc.storm.z;
    vec3  g  = vec3(0.0);
    for (int i = 0; i < 8; ++i) {
        vec3 kv = normalize(kd[i]) * (k0 * ks[i]);
        g += kv * cos(dot(kv, d) + ph[i] + pc.storm.y * 6.2831853) / ks[i];
    }
    return cross(d, g) / (k0 * 2.0) * pc.storm.x;
}

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (pc.face >= 0) id.z = pc.face;
    else if (pc.evo1.w > 0.5) {   // a set of faces (bits of evo1.w): the dispatch's z is the n-th of them
        uint m = uint(pc.evo1.w + 0.5);
        int  n = id.z, f = 0;
        for (; f < 6; ++f)
            if (((m >> uint(f)) & 1u) != 0u) { if (n == 0) break; --n; }
        id.z = f;
    }
    id.y += int(pc.wx.z);   // (a slice of rows: SatelliteSim::recordWeatherBakeDispatches)
    id.x += int(pc.wx.w);   // (a rectangle's first column: the faces in view at time warp, weatherViewRect)
    if (id.x >= pc.faceSize || id.y >= pc.faceSize || id.z >= 6) return;
    const bool fine = pc.pad > 1.5;   // level 0

    vec2 st = (vec2(id.xy) + 0.5) / float(pc.faceSize);
    vec3 d  = faceDir(id.z, st);
    // Weather v2: the convection cube. Level 0 (5 km) holds the CELLS only (x, y: a core is ~10 km across, and at level 1's
    // ~12-km texels its peak was smoothed away); the anvil fields (z, w) are read from level 1.
    float envC = 0.0;
    vec4  cvx  = wxConvection(d, envC, fine);

    // Tangent frame for neighbourhood taps, ~one output texel apart.
    vec3  up    = abs(d.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3  tx    = normalize(cross(up, d));
    vec3  ty    = cross(d, tx);
    float texel = 2.0 / float(pc.faceSize);   // angular size of one output texel (rad, ~at face centre)
    gEqLin = abs(d.z) < 0.97 && texel * 16.0 * pc.pad < 0.04;   // (eqTap: the taps reach 8 x pad texels)

    // ── Weather v2: the coverage is synthesised (wxClimate + wxMoistureNoise above), Earth-fixed; the map is not read ──
    float latAbs  = abs(asin(clamp(d.z, -1.0, 1.0))) * (180.0 / PI);
    float ocean   = textureLod(earthSpecTex, equirectUV(d), pc.srcLod + 2.0).r;
    float tropics = 1.0 - smoothstep(18.0, 32.0, latAbs);
    float polar   = smoothstep(50.0, 70.0, latAbs);
    float texM    = texel * R_EARTH_W;               // this level's texel (m)
    float span    = max(pc.remap.z - pc.remap.y, 1e-3);
    // Level 0 adds only the octaves level 1 leaves out to level 1's field (stored as brightness: clear + raw x span).
    vec4  l1      = fine ? textureLod(wxLevel1, vec3(st, float(id.z)), 0.0) : vec4(0.0);
    float cutL    = 2.5 * texM;                       // the shortest wavelength a level holds
    float varLeft;
    vec3  dF      = normalize(d + wxFlowDisp(d) / R_EARTH_W);   // (the background's bent frame)
    float nz      = fine ? wxMoistureNoise(dF, cutL, 2.5 * texM * 2.0, varLeft)
                         : wxMoistureNoise(dF, cutL, 1e30, varLeft);
    WxClim cl     = wxClimate(dF, ocean);
    // The weather systems own their regions: their potential and shares replace the climatology's there, and the
    // background noise is calmed so their bands stay bands.
    vec4  sy      = fine ? vec4(0.0) : wxSystems(d);
    // Tropical cyclones (Phase 3): their fields into the convection cube (stored after this, max-combined) and their disc.
    vec4  tcCv;
    vec4  tc      = wxCyclones(d, tcCv);
    cvx = vec4(1.0 - (1.0 - cvx.x) * (1.0 - tcCv.x), max(cvx.y, tcCv.y), fine ? cvx.z : max(cvx.z, tcCv.z), fine ? cvx.w : max(cvx.w, tcCv.w));
    if (tc.w > sy.w) sy = tc;
    if (sy.w > 0.0) {
        cl.raw   = mix(cl.raw, sy.x, sy.w);
        cl.strat = mix(cl.strat, sy.y, sy.w);
        cl.conv  = mix(cl.conv, sy.z, sy.w);
        nz      *= 1.0 - 0.45 * sy.w;
    }

    // The storms' own cloud, from the convection cube's fields (2026-11-06; the per-tower stamps are gone): broken
    // cumulus over their environment, the cores themselves, the trailing stratiform deck (mid outflow), in coverage units.
    imageStore(outConv, id, cvx);   // (with the cyclones' fields)
    float cC = cvx.x, cMid = cvx.w;
    float stormAdd = 0.45 * smoothstep(0.02, 0.5, envC) + 0.6 * smoothstep(0.1, 0.5, cC) + 0.9 * smoothstep(0.05, 0.6, cMid);

    // Afternoon convection over land: the ground heats under the Sun of the last few hours.
    float heat = (pc.evo2.w > 0.0) ? smoothstep(0.15, 0.85, dot(d, pc.evo2.xyz)) : 0.0;
    float aft  = pc.evo2.w * heat * (1.0 - ocean) * smoothstep(0.2, 0.6, cl.raw);

    float raw;
    if (fine) raw = (l1.r - pc.remap.y) / span + kWxContrast * kWxNoise * nz;   // level 1's field + the finer octaves
    else {
        raw = 0.5 + kWxContrast * (cl.raw + kWxNoise * nz) + stormAdd + 0.2 * aft;
        // (evoGrowth, v1's growth and decay, is not added: its 1500-km waves swept the map at ~40 m/s and decorrelated the
        // large scales in hours; the moisture flow map's windows are the evolution now, GMGSI benchmark 2026-11-06)
    }
    if (!fine) {
        // The gust front: the shelf overcast, the air ahead of it cleared (level 0 sharpens the shelf, wedge and all). A
        // coarse level holds it as the share of its texel the ~10-km band covers (point-sampled into 25-50-km texels and
        // spread by the march's filter, it stood ~90 km wide from orbit).
        gShelf *= clamp(12000.0 / texM, 0.0, 1.0);
        gAhead *= clamp(25000.0 / texM, 0.0, 1.0);
        raw = min(raw, mix(raw, 0.3, 0.6 * gAhead * (1.0 - gShelf)));
        raw = mix(raw, max(raw, 1.05), gShelf);
    }
    float cov = clamp(raw, 0.0, 1.0);

    if (fine) {
        // Type and ground from level 1; the precipitation from this level's own coverage.
        float deepF = smoothstep(0.6, 1.0, cov);
        float pr = clamp(deepF * smoothstep(0.55, 0.9, l1.g) + deepF * smoothstep(0.35, 0.15, l1.g) * 0.35, 0.0, 1.0);
        pr = max(pr, l1.b);   // (the storms' stratiform rain: level 1's)
        // The convective cores' rain at this level's own resolution: a ~5-km core is diluted away in level 1's 12-km texels
        // (a squall line's radar was one even slab, no line of cores). Not a cyclone's (its CDO is its own, gTcRain).
        pr = max(pr, 0.95 * smoothstep(0.25, 0.6, cvx.x) * smoothstep(0.3, 0.8, cvx.y) * (1.0 - gTcOwn));
        // The shelf at this level's resolution (level 1's 12-km texels hold it ~1 texel deep): overcast, typed as a wedge.
        raw = mix(raw, max(raw, 1.05), gShelf);
        float tF = mix(l1.g, mix(0.08, 0.5, gShelfH), gShelf);
        pr *= 1.0 - gShelf * (1.0 - gShelfH);
        imageStore(outWeather, id, vec4(clamp(pc.remap.y + raw * span, 0.0, 1.0), tF, pr, l1.a));
        return;
    }

    float conv = max(cl.conv, 0.8 * aft);
    float deep = smoothstep(0.55, 0.95, cov) * max(cl.deep, aft);

    float t = 0.25;                                          // stratocumulus by default
    t += conv * 0.28;                                        // -> cumulus
    t += deep * conv * (0.22 + 0.25 * tropics);              // -> congestus (cumulonimbus only from storms)
    t -= cl.strat * (0.08 + 0.10 * ocean * (1.0 - tropics)); // decks: stratocumulus, stratus over cold sea
    t += 0.3 * aft * (0.5 + 0.5 * tropics);                  // afternoon: towering cumulus
    t  = min(t, 0.62);   // the map's own convection caps at congestus: cumulonimbus is the storms'
    // Toward congestus over a storm's environment and its cores (the cumulus field's own deepest type: the column itself
    // is the storm geometry's, clouds_v2.glsl cv2StormGeom; typed cumulonimbus here, the field drew its own tower as a
    // cone through it); the mid outflow's deck stratiform.
    t  = mix(t, max(t, mix(0.5, 0.62, smoothstep(0.3, 0.8, cC))), smoothstep(0.02, 0.4, envC));
    t  = mix(t, 0.15, smoothstep(0.1, 0.6, cMid) * (1.0 - smoothstep(0.1, 0.4, cC)));
    // The shelf: a deck at the front (near-stratus, flat) rising to cumulus at the towers' bases (a wedge ~3 km high).
    t  = mix(t, mix(0.08, 0.5, gShelfH), gShelf);
    t  = clamp(t, 0.0, 1.0);

    float precip = clamp(smoothstep(0.6, 1.0, cov) * (smoothstep(0.55, 0.9, t) + cl.strat * 0.35), 0.0, 1.0);
    // The storms' rain: the cores (heavy, once the column is tall) and the stratiform deck under the mid outflow (moderate);
    // the map's own rain gives way across their environment (the storm is the rain there).
    float envK = smoothstep(0.02, 0.3, envC);
    precip = max(precip * (1.0 - 0.8 * envK),
                 max(0.9 * smoothstep(0.3, 0.75, cC) * smoothstep(0.3, 0.8, cvx.y), 0.55 * smoothstep(0.15, 0.7, cMid)));
    precip = mix(precip, gTcRain, gTcOwn);   // (a cyclone's own: its core's intensity is its CDO, not one rain core)
    precip *= 1.0 - gShelf * (1.0 - gShelfH);  // (the shelf leads the rain)

    // Levels 0 and 1 hold the field itself (raw: below the clear threshold the brightness keeps the distance into clear
    // air); the coarse levels the TRUE mean coverage of the finer field (review 18: the far field reads mip 2 as a
    // fraction), from the variance of the octaves they leave out.
    float covStore = pc.remap.w > 0.5 ? pc.remap.y + wxExpectedCover(raw, kWxContrast * kWxNoise * sqrt(varLeft)) * span
                                      : pc.remap.y + raw * span;
    covStore = clamp(covStore, 0.0, 1.0);

    // Ground height (terrain.glsl's encoding: 15/255 is sea level, 255/255 ~8.5 km above it), a 2x2
    // supersample at this mip's scale (the DEM's 2.7 km texels, ~2 mips finer than the source map's).
    float gnd = 0.0;
    vec2  uvd = equirectUV(d);
    float latd = asin(clamp(d.z, -1.0, 1.0));
    for (int k = 0; k < 4; ++k) {
        vec2 o = (vec2(k & 1, k >> 1) - 0.5) * 0.5 * texel;
        float v = textureLod(earthElevTex, eqTap(d, uvd, latd, tx, ty, o), pc.srcLod + 1.0).r;
        gnd += max(0.0, v * 9000.0 - 15.0 / 255.0 * 9000.0);
    }
    gnd *= 0.25;

    imageStore(outWeather, id, vec4(covStore, t, precip, clamp(gnd / 8000.0, 0.0, 1.0)));
#ifdef WX_DEBUG_CONV
    imageStore(outWeather, id, vec4(cvx.y, cvx.x, cvx.z, 0.0));   // (wxtype: R intensity, G top, B anvil)
#endif
}
