#version 450
#extension GL_EXT_control_flow_attributes : enable

// Clouds v2 (.plans/CLOUDS_V2_PLAN.md): bakes the WEATHER CUBE from the real-Earth 8K cloud map,
// once at init, one dispatch per mip level. A cube, not the equirect source, so the march never
// pays an atan/asin per sample, and there is no longitude seam and no pinching at the poles.
//
//   R  coverage       the map's brightness (thin cloud reads grey, deep cloud white)
//   G  cloud type     0..1 over the type table in clouds_v2.glsl, in order of vertical
//                     development: stratus, stratocumulus, cumulus, congestus, cumulonimbus
//   B  precipitation  0..1 (deep, bright cloud; darkens bases, and later drives rain/lightning)
//   A  ground         the DEM height / 8 km, smoothed at this mip's scale (cloud bases follow the
//                     terrain). Read at the EARTH-FIXED direction, unlike the rest (the map drifts).
//                     Was the tropopause, a function of latitude only (now clouds_v2.glsl cv2Tropo).
//
// The type is CLASSIFIED, since the imagery carries no type: broken, high-variance brightness is
// convective (cumulus fields), smooth bright fields are stratiform decks, very bright convective
// cloud is deep (congestus/Cb) and more so in the tropics, and smooth cloud over cold ocean is
// stratus. Rough by construction, and why a type is always interpolated rather than switched.
//
// Face orientation is Vulkan's cube-map rule (spec, "Cube Map Face Selection"), inverted:
//   +X (1,-b,-a)  -X (-1,-b,a)  +Y (a,1,b)  -Y (a,-1,-b)  +Z (a,-b,1)  -Z (-a,-b,-1),  a,b in [-1,1].

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(set = 0, binding = 0) uniform sampler2D earthCloudsTex;   // equirect, R8, full mip chain
layout(set = 0, binding = 1) uniform sampler2D earthSpecTex;     // equirect ocean mask (1 = water)
layout(rgba8, set = 0, binding = 2) writeonly uniform image2DArray outWeather;
layout(set = 0, binding = 3) uniform sampler2D earthElevTex;     // equirect R8 DEM (terrain.glsl encoding)
// Binding 5 (2026-10-25): level 1 of this cube (10 km), baked before level 0 (2048, 5 km), which takes its type, rain and
// ground from it and computes only the coverage at its own resolution (pc.pad 2 marks level 0).
layout(set = 0, binding = 5) uniform sampler2DArray wxLevel1;
// Binding 4: the storm objects' towers and their bins (cv2_storms.glsl, 2026-10-22): each storm brings its own cloud
// field into the map (stormStamp below).
#define CV2_STORM_BINDING 4
#define CV2_STORM_ENV
#include "cv2_storms.glsl"

// face: -1 = all six (the dispatch's z), else only that one (the incremental re-bake).
// EVOLUTION (decision A, .plans/CLOUDS_V2_PLAN.md; 2026-09-29): the map is read through two copies
// advected by a slow curl wind (evo1.x m/s), each over its own window of sim time — evo0.xy their ages
// (s), evo0.zw their weights (sin^2, 0 at each copy's reset) — so the map moves locally and never drifts
// from itself (a displacement of at most wind x the window), and its coverage grows and decays under a
// smooth field (evo1.y, sim time evo1.z). SatelliteSim re-bakes one face per frame as sim time moves.
// evo2: xyz the Sun's direction three hours ago in the map's frame, w "Afternoon land convection".
// remap (review 18): x "Coverage" (the map brightness multiplier, look.x), y the clear and z the full threshold
// (cover.xy), w this level's mip.
// wx (2026-10-22): xy cos / sin of the map's drift: d is in the MAP frame, and the land / sea mask is Earth-fixed;
// z the first row (2026-10-25: a face re-baked over several frames, a slice of rows each).
// storm / storm2 (2026-10-22, stormStamp): storm x the tower radius (m, "Cb tower radius"), y "Storm cumulus reach" (m),
// z "Cb head drift" (m), w "Cb flare"; storm2 x "Storm cloud field" (0 = the map alone), y its clear moat's strength.
layout(push_constant) uniform PC { int faceSize; float srcLod; int face; float pad /* ring scale */; vec4 evo0; vec4 evo1; vec4 evo2;
                                   vec4 remap; vec4 wx; vec4 storm; vec4 storm2; } pc;

const float PI = 3.14159265359;
const float R_EARTH_W = 6371000.0;

// ── Weather v2 (2026-11-06, .plans/WEATHER_V2_PLAN.md): the weather is SYNTHESISED, not read from the satellite map ──
// coverage = a climatology (the ITCZ, the dry subtropics, the mid-latitude storm tracks, polar cloud, the cold-sea
// stratocumulus decks; following the Sun) + the Rossby waves' lift (poleward flow at 5 km: the warm conveyor's cloud
// bands, clear cold air behind them; Eulerian, so the bands move with the waves while the air moves through them) +
// moisture fBm ADVECTED by the steering wind (wind_field.glsl) through a two-phase flow map (both phases evaluated
// and blended variance-preservingly here, each renewal a fresh field). Storms are still the old stamps (step 3 makes
// every system a writer into these fields).
// Push constants (repurposed from the map's evolution): evo0 = the wind's state (wind_field.glsl ws); evo1.x the macro
// flow map's window count mod 1024, z its window (s); wx.x the sim time within the window (s).
#include "wind_field.glsl"

float wxHash(vec3 p)
{
    p = fract(p * vec3(0.1031, 0.1030, 0.0973));
    p += dot(p, p.yxz + 33.33);
    return fract((p.x + p.y) * p.z);
}
vec3 wxGradV(vec3 c) { return normalize(vec3(wxHash(c), wxHash(c + 17.17), wxHash(c + 41.31)) - 0.5); }
// Gradient noise, ~[-1, 1] (std ~0.3).
float wxNoise(vec3 p)
{
    vec3 i = floor(p), f = p - i, u = f * f * (3.0 - 2.0 * f);
    float n000 = dot(wxGradV(i), f);
    float n100 = dot(wxGradV(i + vec3(1, 0, 0)), f - vec3(1, 0, 0));
    float n010 = dot(wxGradV(i + vec3(0, 1, 0)), f - vec3(0, 1, 0));
    float n110 = dot(wxGradV(i + vec3(1, 1, 0)), f - vec3(1, 1, 0));
    float n001 = dot(wxGradV(i + vec3(0, 0, 1)), f - vec3(0, 0, 1));
    float n101 = dot(wxGradV(i + vec3(1, 0, 1)), f - vec3(1, 0, 1));
    float n011 = dot(wxGradV(i + vec3(0, 1, 1)), f - vec3(0, 1, 1));
    float n111 = dot(wxGradV(i + vec3(1, 1, 1)), f - vec3(1, 1, 1));
    return 2.0 * mix(mix(mix(n000, n100, u.x), mix(n010, n110, u.x), u.y),
                     mix(mix(n001, n101, u.x), mix(n011, n111, u.x), u.y), u.z);
}
const float kWxL0   = 1.2e6;   // the moisture fBm's largest wavelength (m)
const float kWxGain = 0.6;
// The moisture fBm at a material direction m: the octaves with wavelengths in [minL, maxL] (level 0 adds the ones
// below level 1's cut to level 1's field). varOut: the variance of the octaves under minL (left out).
float wxFbm(vec3 m, float minL, float maxL, vec3 seed, out float varOut)
{
    vec3  p  = m * (R_EARTH_W / kWxL0) + seed;
    // A domain warp at the two largest scales: fronts and comma shapes, not round blobs.
    vec3  wq = vec3(wxNoise(p * 0.7 + 3.1), wxNoise(p * 0.7 + 7.9), wxNoise(p * 0.7 + 12.4));
    p += wq * 0.35;
    float n = 0.0, a = 1.0, L = kWxL0, v = 0.0;
    for (int o = 0; o < 9; ++o) {
        if (L < minL) v += a * a;
        else if (L <= maxL) n += a * wxNoise(p);
        p = p * 2.03 + vec3(1.7, 9.2, 4.4);
        a *= kWxGain; L *= 0.4926;
    }
    varOut = v * 0.09 * 0.62 * 0.62;   // (gradient noise's variance ~0.09 a unit amplitude)
    return n * 0.62;
}
float wxStagger(vec3 d) { return 0.31 * sin(dot(d, vec3(3.3, -2.1, 1.7)) + 1.3) + 0.21 * sin(dot(d, vec3(-2.6, 1.4, 3.9)) + 0.4); }
// The moisture noise through the macro flow map: both phases, blended keeping the variance.
float wxMoistureNoise(vec3 d, float minL, float maxL, out float varOut)
{
    float P  = pc.evo1.z;
    float fT = pc.wx.x / P + wxStagger(d);
    float n = 0.0, wsum = 0.0;
    varOut = 0.0;
    vec3  W0 = wfWind(d, 3000.0, pc.evo0);
    for (int c = 0; c < 2; ++c) {
        float fc  = fT + 0.5 * float(c);
        float f   = fract(fc);
        float w   = sin(PI * f);
        float age = f * P;
        // Back along the steering wind (a midpoint step), then a fresh field per window (its index's hash).
        vec3  dm  = normalize(d - W0 * (0.5 * age / R_EARTH_W));
        vec3  dc  = normalize(d - wfWind(dm, 3000.0, pc.evo0) * (age / R_EARTH_W));
        float k   = pc.evo1.x + floor(fc) + 0.5 * float(c);
        vec3  sd  = fract(sin(vec3(k * 12.9898, k * 78.233, k * 37.719)) * 43758.5453) * 97.0;
        float vv;
        n    += w * wxFbm(dc, minL, maxL, sd, vv);
        wsum += w * w;
        varOut = vv;
    }
    return n / sqrt(max(wsum, 1e-4));
}
// Expected value of clamp(x + N(0, s^2), 0, 1): the true mean coverage of a field whose finer octaves were left out.
float wxPos(float z) { return z / (1.0 + exp(-1.702 * z)) + exp(-0.5 * z * z) * 0.3989; }
float wxExpectedCover(float x, float s)
{
    if (s < 1e-3) return clamp(x, 0.0, 1.0);
    return clamp(s * (wxPos(x / s) - wxPos((x - 1.0) / s)), 0.0, 1.0);
}
// Cold-upwelling stratocumulus decks off the subtropical west coasts (lat, lon of each centre, deg).
float wxScDecks(vec3 d)
{
    const vec2 c[5] = vec2[5](vec2(28.0, -126.0), vec2(-18.0, -82.0), vec2(-19.0, 6.0), vec2(24.0, -22.0), vec2(-28.0, 106.0));
    float s = 0.0;
    for (int i = 0; i < 5; ++i) {
        float la = radians(c[i].x), lo = radians(c[i].y);
        vec3  a  = vec3(cos(la) * cos(lo), cos(la) * sin(lo), sin(la));
        float r  = acos(clamp(dot(a, d), -1.0, 1.0)) * R_EARTH_W;
        s = max(s, exp(-(r * r) / (1.3e6 * 1.3e6)));
    }
    return s;
}
// The climatology and the waves' lift at d (Eulerian). raw: coverage before the noise; strat / conv / deep 0..1.
struct WxClim { float raw; float strat; float conv; float deep; float lift; };
const float kWxContrast = 0.9;   // coverage per unit of moisture potential
const float kWxNoise    = 1.5;   // the moisture fBm's weight in the potential
WxClim wxClimate(vec3 d, float ocean)
{
    WxClim o;
    float lat  = asin(clamp(d.z, -1.0, 1.0));
    float latS = lat - 0.35 * pc.evo0.y;
    float a    = abs(latS) * (180.0 / PI);
    float land = 1.0 - ocean;
    float itcz = wfG(a, 0.0, 4.5);
    float dry  = wfG(a, 25.0, 8.0);
    float mid  = wfG(a, 52.0, 10.0);
    float pol  = wfG(a, 75.0, 10.0);
    float sc   = wxScDecks(d) * ocean;
    // The MOISTURE POTENTIAL (coverage = 0.5 + kWxContrast x it, main): > ~0.55 overcast, < ~-0.55 clear.
    float raw  = -0.2 + 0.45 * itcz - (0.75 + 0.45 * land) * dry + (0.3 + 0.2 * ocean) * mid + 0.25 * pol + 0.9 * sc;
    // The Rossby waves' lift: poleward flow at 5 km (the warm conveyor, ahead of a trough) clouds over; equatorward
    // (the cold air behind it) clears into open cumulus.
    vec3  w5    = wfWind(d, 5000.0, pc.evo0);
    vec3  east  = normalize(vec3(-d.y, d.x, 0.0) + vec3(1e-6, 0.0, 0.0));
    vec3  north = cross(d, east);
    float pole  = dot(w5, north) * (lat >= 0.0 ? 1.0 : -1.0);
    float lift  = clamp(pole / 10.0, -1.5, 1.5) * smoothstep(20.0, 35.0, a);
    raw += 0.5 * lift;   // (the long frontal bands are the extratropical systems' own; this is the waves' background)
    o.raw   = raw;
    o.lift  = lift;
    o.strat = clamp(smoothstep(0.15, 0.8, lift) + sc + 0.6 * pol, 0.0, 1.0);
    o.conv  = clamp(0.75 * wfG(a, 15.0, 9.0) * ocean + itcz + smoothstep(0.1, 0.9, -lift) * 0.8 + 0.3 * land * (1.0 - pol), 0.0, 1.0)
            * (1.0 - 0.7 * o.strat);
    o.deep  = clamp(itcz * (0.6 + 0.4 * land) + 0.35 * wfG(a, 12.0, 8.0), 0.0, 1.0);
    return o;
}

// Growth and decay: a smooth field (~1500 km) whose waves drift through their phases over 10-30 h.
float evoGrowth(vec3 d)
{
    const vec3 kd[6] = vec3[6](vec3( 0.73,  0.21, -0.65), vec3(-0.25,  0.91,  0.33), vec3( 0.47, -0.58,  0.66),
                               vec3(-0.81, -0.44, -0.39), vec3( 0.05, -0.29, -0.96), vec3(-0.52,  0.63,  0.58));
    const float T[6] = float[6](2592000.0 / 72.0, 2592000.0 / 50.0, 2592000.0 / 36.0, 2592000.0 / 58.0, 2592000.0 / 26.0, 2592000.0 / 41.0);
    float k1 = 2.0 * PI * R_EARTH_W / 1.5e6;
    float g  = 0.0;
    [[unroll]] for (int i = 0; i < 6; ++i)
        g += cos(dot(normalize(kd[i]) * k1, d) + float(i) * 1.7 + pc.evo0.x * (2.0 * PI / T[i]));   // (the wind clock)
    return g / 1.73;                                     // ~unit rms
}

vec3 faceDir(int face, vec2 st)
{
    float a = st.x * 2.0 - 1.0, b = st.y * 2.0 - 1.0;
    vec3 d;
    if      (face == 0) d = vec3( 1.0, -b, -a);
    else if (face == 1) d = vec3(-1.0, -b,  a);
    else if (face == 2) d = vec3(  a, 1.0,  b);
    else if (face == 3) d = vec3(  a,-1.0, -b);
    else if (face == 4) d = vec3(  a, -b, 1.0);
    else                d = vec3( -a, -b,-1.0);
    return normalize(d);
}

// Same equirect convention as cloud_march.comp / sat_sky.frag (pUVGeo): u from -180 deg, v from the north pole.
vec2 equirectUV(vec3 d)
{
    float lon = atan(d.y, d.x);
    float lat = asin(clamp(d.z, -1.0, 1.0));
    return vec2((lon + PI) / (2.0 * PI), (0.5 * PI - lat) / PI);
}

// The equirect UV of a tap dc + tx o.x + ty o.y, from dc's own UV and latitude (one exact conversion) and a first-order
// step: exact in latitude, the longitude step / cos(lat) at the tap's latitude. Valid while tx / ty are the local east /
// north and the offset small (gEqLin, set per texel). At 2048 an atan and an asin per tap (~37 a texel) were most of
// the bake's cost: all six faces 16-20 ms a frame in time warp (2026-10-25).
bool gEqLin = false;
vec2 eqTap(vec3 dc, vec2 uvc, float latc, vec3 tx, vec3 ty, vec2 o)
{
    if (!gEqLin) return equirectUV(normalize(dc + tx * o.x + ty * o.y));
    float lat = latc + o.y;
    return uvc + vec2(o.x / (2.0 * PI * max(cos(lat), 1e-3)), -o.y / PI);
}

// A storm's own cloud field (2026-10-22, .plans/WEATHER_EVENTS_PLAN.md "the interface with the cloud distribution").
// The storms are objects placed by a climatology x the map's moisture; the map knows nothing of them, so a storm could
// stand in nearly clear air with its rain falling from nothing under its anvil (issue 20261022_233857), and seen from
// above it was an anvil on bare ground. Each tower whose ENVELOPE (cv2StormEnvRadius, ~1.8x its reach: past its anvil)
// covers d stamps, in coverage units:
//   x  CONVECTIVE: a field of cumulus over the envelope's inner part, denser toward the tower and congestus within
//      "Storm cumulus reach" of it (0.5 there, 1 at the tower: the coverage it adds is broken cloud, not a blob)
//   y  STRATIFORM: the forward flank, an ellipse under the anvil downwind (dominant, anvil-reaching towers): a thick,
//      raining deck (nimbostratus-like: the low layer thickens a raining stratiform deck)
//   z  RAIN under that deck, heaviest near the tower and thinning downwind
//   w  a clear MOAT at the envelope's edge (the subsiding air round a storm), so its region's cloud is partly moved,
//      not only added
// The envelope index lists every tower whose envelope reaches d (the march's own index stops at the reach).
// The map's own cloud round a tropical cyclone, wound into its spiral (2026-10-23): the bake reads the map through a
// DIFFERENTIAL rotation about each cyclone's centre (cyclonic, up to ~0.6-1.5 rad near the CDO by intensity, none past the
// outer bands), so cloud masses that happen to lie near a hurricane trail round it as spiral streaks instead of sitting
// there as unrelated blobs. Static in the storm's frame (it moves with the storm): a rotation growing with time would wind
// up without end. Read only here: the noise the march textures the clouds with does not swirl.
vec3 cycloneSwirl(vec3 d)
{
    vec3 o = d;
    for (uint i = 0u; i < min(cv2CycHead.x, kCv2CycloneMax); ++i) {
        CV2Cyclone cy = cv2Cyclones[i];
        vec3  a   = cy.b.xyz;
        float r   = acos(clamp(dot(o, a), -1.0, 1.0)) * R_EARTH_W;
        float outer = max(cy.c.z, 1000.0);
        if (r > outer) continue;
        float th  = -cy.b.w * mix(0.6, 1.5, cy.a.w) * smoothstep(12.0, 25.0, cy.d.y)
                  * (1.0 - smoothstep(0.3 * max(cy.c.y, 1000.0), outer, r));
        o = o * cos(th) + cross(a, o) * sin(th) + a * dot(a, o) * (1.0 - cos(th));
    }
    return normalize(o);
}

float gRainFree = 0.0;
float gCycDeck  = 0.0;   // stormStampFinish: 0..1, under a cyclone's central dense overcast (its deck: overcast)   // stormStamp: 0..1, a rear-flank rain-free base (the map's rain is cleared there)
// In two parts (2026-10-25): the towers' and lines' fields (smooth over tens of km: read once at a texel's centre), then
// the cyclones' and the final scaling (stormStampFinish: a hurricane's arms are a few km sharp, so main() averages it
// over the texel). stormStamp(d) = stormStampFinish(stormStampTowers(d), d).
vec4 stormStampTowers(vec3 d)
{
    vec4 o = vec4(0.0);
    if (pc.storm2.x <= 0.0) return o;
    uvec2 bin = cv2StormEnvBin(d);
    vec3 eastW0  = vec3(-d.y, d.x, 0.0) * inversesqrt(max(dot(d.xy, d.xy), 1e-6));
    vec3 northW0 = cross(d, eastW0);
    float Rb = pc.storm.x, cuR = pc.storm.y, drift = pc.storm.z, flare = max(pc.storm.w, 1.0);
    for (uint k = 0u; k < bin.y; ++k) {
        uint     ti = cv2StormEnvList[bin.x + k];
        CV2Tower tw = cv2EnvTowers[ti];
        float str = tw.a.w;
        if (str <= 0.05) continue;
        float role = tw.b.x;
        float E    = cv2StormEnvRadius(tw.c.x);
        vec3  dv   = (d - tw.a.xyz) * R_EARTH_W;   // in the cube's (flowed) frame
        vec3  dh   = dv - d * dot(dv, d);
        float dhL  = length(dh);
        if (dhL > E) continue;
        vec3  eastW = cos(tw.b.w) * eastW0 + sin(tw.b.w) * northW0;   // downwind (the anvil's way)
        float Rc  = Rb * mix(0.7, 1.3, tw.b.y) * mix(0.8, 1.0, smoothstep(0.1, 0.6, str)) * mix(0.75, 1.0, role);
        // (x the drawn climb squared, cv2TowerHeightCap, 2026-11-03: the cloud field round a young tower thickened from
        // scattered cumulus to a mass in ~2 sim min on the strength alone; issue 20261030_210137.)
        float capH = cv2TowerHeightCap(tw.c);
        float s1  = min(smoothstep(0.05, 0.4, str), capH * capH) * mix(0.5, 1.0, role);
        float Rf  = 1.15 * Rc + max(cuR, 0.5 * Rc);
        o.x = max(o.x, (0.5 * (1.0 - smoothstep(0.3 * E, 0.8 * E, dhL)) + 0.5 * (1.0 - smoothstep(0.6 * Rf, Rf, dhL)))
                       * s1);
        // The forward flank: under the anvil (half-width aw, blown L downwind), from the tower out to ~the anvil's end.
        float dom = smoothstep(0.35, 0.7, str) * smoothstep(0.9, 1.0, role);
        float aw  = Rc * flare * max(cv2TowerAnvilK(tw.c), 0.5);
        float L   = aw + drift * cv2TowerDriftK(tw.c);
        float al  = dot(dh, eastW);
        float cr  = length(dh - eastW * al);
        float qe  = length(vec2((al - 0.45 * L) / (0.6 * L), cr / (0.75 * aw)));
        float gF  = 1.0 - smoothstep(0.55, 1.0, qe);
        o.y = max(o.y, gF * dom);
        o.z = max(o.z, gF * dom * (1.0 - smoothstep(0.15 * L, 0.9 * L, al)) * smoothstep(-0.5 * Rc, 0.2 * Rc, al));
        // The REAR-FLANK rain-free base (2026-10-23): where the rear-flank downdraft clears the rain, behind and to
        // the right of the motion (left in the south), at SatelliteSim::tornadoOf's place for a tornado (-0.65 x the
        // shear + 0.7 x across it, x 1.1 the mature tower's radius: just past its rain core). Not under a cyclone's
        // towers (their anvil factor is exactly 1 / flare: they do not flare). The map's own rain there hid tornadoes.
        if (dom > 0.0 && cv2TowerAnvilK(tw.c) * flare > 1.05) {
            vec3  perp = cross(d, eastW) * (d.z >= 0.0 ? -1.0 : 1.0);
            float RcM  = Rb * mix(0.7, 1.3, tw.b.y);
            vec3  rf   = dh - (-0.65 * eastW + 0.7 * perp) * (1.1 * RcM);
            gRainFree  = max(gRainFree, dom * (1.0 - smoothstep(0.35 * RcM, 0.7 * RcM, length(rf))));
        }
        // The moat at the envelope's edge (none in line with the anvil).
        float ring = smoothstep(0.7 * E, 0.85 * E, dhL) * (1.0 - smoothstep(0.9 * E, E, dhL));
        o.w = max(o.w, ring * s1 * mix(1.0, smoothstep(1.0, 1.5, qe), dom));
    }
    // Line systems (squall lines, MCSs, 2026-10-23): the shield's TRAILING STRATIFORM region, a raining deck behind the
    // convective line (with the weaker "transition zone" 15-45 km behind it), and clear air ahead of the line (the
    // subsiding air in front of the gust front). From the shields' own (flowed) copy: cv2ShieldEnvBin.
    uvec2 sb = cv2ShieldEnvBin(d);
    for (uint k = 0u; k < sb.y; ++k) {
        CV2Shield s = cv2EnvShields[cv2ShieldEnvList[sb.x + k]];
        if (s.c.w <= 0.0) continue;
        vec3  ab  = s.b.xyz - s.a.xyz;
        float t   = clamp(dot(d - s.a.xyz, ab) / max(dot(ab, ab), 1e-14), 0.0, 1.0);
        // The line BOWS (2026-10-23): its middle towers stand ahead of its ends by bow x (1 - (2t - 1)^2) (c.w packs the
        // bow, whole km x 2, over the rain share): every distance is measured from the spine moved forward by it. A
        // straight spine put the shelf band, the clear air ahead and the trailing rain tens of km behind a bowed middle.
        float bowK  = floor(0.5 * s.c.w);
        float rainS = s.c.w - 2.0 * bowK;
        float bowAt = 1000.0 * bowK * (1.0 - (2.0 * t - 1.0) * (2.0 * t - 1.0));
        vec3  off = (d - (s.a.xyz + ab * t)) * R_EARTH_W + s.d.xyz * bowAt;
        float r   = mix(s.c.x, s.b.w, t);
        float u   = length(off) / max(r, 1.0);
        if (u >= 1.0 + 100000.0 / max(r, 1.0)) continue;   // (the clear air ahead reaches past the capsule)
        float sb2 = dot(off, s.d.xyz) + s.d.w;           // distance behind the convective line (m; < 0 ahead of it)
        // Ends of the line taper the region (t near 0 / 1 is the capsule's rounded end).
        float body = (1.0 - smoothstep(0.55, 1.0, u)) * smoothstep(-8000.0, 12000.0, sb2);
        float yS   = body * s.a.w;
        float tz   = smoothstep(12000.0, 22000.0, sb2) * (1.0 - smoothstep(35000.0, 55000.0, sb2));
        o.y = max(o.y, yS);
        o.z = max(o.z, yS * rainS * mix(0.75, 0.35, tz));
        // The SHELF cloud on the gust front: a low, continuous band 5-20 km ahead of the line (stratiform type: the
        // low layer draws it low, smooth-based and thin), along the line's length.
        float along = 1.0 - smoothstep(0.75, 1.0, abs(2.0 * t - 1.0));
        float shelf = smoothstep(-22000.0, -14000.0, sb2) * (1.0 - smoothstep(-6000.0, -1000.0, sb2)) * along;
        o.y = max(o.y, shelf * s.a.w * 0.9);
        gRainFree = max(gRainFree, min(shelf + (1.0 - smoothstep(-40000.0, -20000.0, sb2)) * along, 1.0) * s.a.w);   // (no rain ahead)
        // Ahead of that: subsidence (a moat) out to ~90 km, not where the towers' own cumulus stands.
        float ahead = (1.0 - smoothstep(-40000.0, -25000.0, sb2)) * smoothstep(-90000.0, -60000.0, sb2);
        o.w = max(o.w, ahead * (1.0 - smoothstep(0.8, 1.0, abs(2.0 * t - 1.0))) * s.a.w * 0.8);
    }
    return o;
}
vec4 stormStampFinish(vec4 o, vec3 d)
{
    if (pc.storm2.x <= 0.0) return o;
    vec3 eastW0  = vec3(-d.y, d.x, 0.0) * inversesqrt(max(dot(d.xy, d.xy), 1e-6));
    vec3 northW0 = cross(d, eastW0);
    // Tropical cyclones (2026-10-23): spiral rainbands (logarithmic spirals trailing the cyclonic rotation) beyond the
    // central dense overcast, the eyewall's ring of convection, the CDO's deck, heavy rain in the eyewall and bands,
    // subsidence between the bands, and the eye cleared outright.
    float eyeAcc = 0.0, deckC = 0.0;
    for (uint i = 0u; i < min(cv2CycHead.x, kCv2CycloneMax); ++i) {
        CV2Cyclone cy = cv2Cyclones[i];
        vec3  off = (d - cy.b.xyz) * R_EARTH_W;
        off -= d * dot(off, d);
        float r = length(off);
        if (r > cy.c.z * 1.2) continue;
        float rmw = max(cy.d.x, 2000.0), cdo = max(cy.c.y, 1000.0), outer = cy.c.z, I = cy.a.w, hemi = cy.b.w;
        float th  = atan(dot(off, northW0), dot(off, eastW0));
        float lr  = log(max(r, 1000.0) / rmw);
        // The main arms: d.w of them (wx::CycloneState::arms: 2 for a tropical storm, up to ~5 for a Category 5),
        // crossfaded between whole counts (a fractional count is not periodic in theta) just before the next, the pitch tighter as it
        // intensifies (30 -> 22 deg, the CPU's tanPitch: the inner band towers stand on these crests), turning by c.w.
        // They leave the central dense overcast (attached, wide near it) and taper and break up outward: spokes, not
        // rings (at 13-20 deg, detached from the CDO, they read as nested circles round a blob).
        // (2026-11-03, issue 20261030_205220: the count is "Hurricane main arms" (CPU applyCycloneShape; 2 by default, as
        // most hurricanes show two major bands), the pitch "Hurricane arm tightness" (d.z packs 1000 x tan pitch over the
        // land flag), the turn "Hurricane arm speed".)
        float nA  = max(cy.d.w, 1.0);
        float n0  = floor(nA), fA = nA - n0;
        float tanP = max(floor(cy.d.z * 0.5) * 0.001, 0.05);
        float ph  = hemi * th + lr / tanP + cy.c.w;
        float bA  = 0.5 + 0.5 * cos(n0 * ph);
        float bB  = 0.5 + 0.5 * cos((n0 + 1.0) * ph);
        // (Over the last 15% only: two counts mixed half and half interfere into rings.)
        float b2  = mix(bA, bB, smoothstep(0.85, 1.0, fA));
        // (An arm as wide in angle whatever the count: the thresholds below were tuned at ~4 arms; with 2, each covered
        // twice the angle, fat ribbons. b^p with p = (4 / n)^2 keeps the width of the n = 4 crest.)
        b2 = pow(b2, clamp(16.0 / (n0 * n0), 0.6, 16.0));
        float rf  = clamp(r / max(outer, 1.0), 0.0, 1.0);
        // MINOR SWIRLS between them ("Hurricane minor swirls", storm2.z): 2n + 1 finer bands, wound tighter than the main
        // arms, short and broken (their own gaps), weaker: the secondary bands and swirls a satellite image shows round
        // the two main arms. (Were three at a fixed 22 deg.)
        float nM  = 2.0 * n0 + 1.0;
        float phM = hemi * th + lr / (0.8 * tanP) + 0.7 * cy.c.w;
        float b3  = 0.5 + 0.5 * cos(nM * phM + 1.7);
        float iM  = floor(nM * phM * (0.5 / PI) + 0.5);
        float gM  = smoothstep(-0.3, 0.5, sin(2.3 * lr + 2.4 * iM + 0.5 * cy.c.w));
        // The main arms' GAPS (2026-11-03): an arm narrows to nothing and comes back, along its own length (a slow wave in
        // ln r with each arm's own phase: iA its crest's index), more often outward. They were a multiplier of (ln r,
        // theta) waves whose zero lines cross every arm at an angle: arms cut off square, "chopped in rectangular ways"
        // (shot 2 of the issue: every blunt arm end was one of those cuts; harness_runs c03 nobrk).
        float iA  = floor(n0 * ph * (0.5 / PI) + 0.5);
        float gap = smoothstep(0.3 - 0.6 * rf, 0.9, sin(1.7 * lr + 2.9 * iA + 0.3 * cy.c.w) * 0.6
                                                    + sin(3.3 * lr - 1.3 * iA + 1.1) * 0.4);
        // Ragged, cellular edges: the threshold moved by real cloud texture (the map read at a permuted direction:
        // unrelated cloud structure, ~5-40 km), so an arm's outline is a broken line of cells, not a painted arc.
        float tex = textureLod(earthCloudsTex, equirectUV(normalize(vec3(d.y, d.z, d.x))), pc.srcLod).r;
        // Thin, tapering arms (2026-10-23, the user: "a tad pudgy"): a narrow core (the threshold starts at 0.5 and rises
        // to ~0.9 outward, the ramp 0.12 wide), the ragged texture stronger outward, and (below) the coverage fading
        // outward so an arm's outer third draws as broken cumulus streaks — wisps — not a solid band.
        // Its width pinches and swells along the arm (a slow wave in the arm's own coordinate), and its edges FEATHER:
        // thin streaks parallel to it just outside the core (a fine harmonic of the arm's phase), so the outline is a
        // fringe of filaments, not a ribbon's two parallel edges.
        // (An arm covers the share of its period where cos > 2 thr - 1: at thr 0.6, ~44% — pudgy; at 0.85, ~23%.)
        // (Each arm its own width: the first, the principal band, the widest.)
        // (Every angle term a whole multiple of theta: atan's cut (theta = +-pi) is a jump of 2 pi, and 1.7 theta drew a
        // straight radial seam across the arms there.)
        float pinch = 0.04 * sin(4.0 * lr + 2.0 * hemi * th + 1.3 * cy.c.w + 2.1) - 0.03 * float(iA < 0.5)
                    + 0.03 * sin(5.1 * iA + 0.7);
        float thr = mix(0.8, 0.93, sqrt(rf)) + 0.015 * (nA - 2.0) + 0.25 * (1.0 + rf) * (tex - 0.35) + pinch
                  + 0.3 * gap;
        // (Not min(thr + 0.06, 0.995): once a gap lifts thr past ~0.94, edge0 > edge1 and smoothstep is undefined — on
        // NVIDIA inverted, filling the whole space between the arms on one side of a gap's edge: a straight-edged wedge.)
        float core = smoothstep(thr, thr + 0.06, b2);
        float fil  = smoothstep(0.55, 0.95, 0.5 + 0.5 * cos(7.0 * n0 * ph + 3.0 * tex))
                   * smoothstep(thr - 0.25, thr - 0.04, b2) * (1.0 - core) * 0.75;
        float mnr  = 1.4 * pc.storm2.z * gM * smoothstep(min(mix(0.76, 0.92, rf) + 0.25 * (tex - 0.35), 0.97), 0.99, b3);
        float band = max(max(core, fil), min(mnr, 1.0));
        float wisp = mix(1.0, 0.5, smoothstep(0.35, 0.9, rf));   // the arm's coverage, fading outward
        // (The deck's outline wound into the arms, 2026-11-03, "Hurricane deck spiral" storm2.w: reaching out along them,
        // receding between them, as the shield above it does (cv2CycSpiral): a round deck read as a glob.)
        // (Review 2026-11-03: the moat between an arm and the CDO is NARROW and runs deep, to ~half the CDO's radius, as
        // the feeder bands wrap in on visible imagery; a symmetric cos winding only moved the edge and left the CDO's outer
        // half a featureless disc. Trough: radius x (1 + 0.7 k) over the share bA < 0.35; crest: x (1 - 0.25 k) over
        // bA > 0.5. Its mean area is the round deck's (1.00 at k 0.8, 1.04 at 1): a larger overcast, raining deck costs
        // the march.)
        float dkS    = 1.0 + pc.storm2.w * (0.7 * (1.0 - smoothstep(0.0, 0.35, bA)) - 0.25 * smoothstep(0.5, 1.0, bA));
        float inner  = 1.0 - smoothstep(0.75 * cdo, 1.1 * cdo, r * dkS);
        float bandsK = smoothstep(0.35 * cdo, 0.8 * cdo, r) * (1.0 - smoothstep(0.6 * outer, outer, r));
        float wall   = exp(-((r - rmw) * (r - rmw)) / (0.16 * rmw * rmw));
        // (An arm's coverage: at 0.45 x a weak storm's band it added ~0.3 of coverage, which the low cloud draws as
        // scattered cumulus, not a band: weak storms showed no arms at all.)
        // (The CDO's deck: near overcast whatever the intensity (2026-10-27, issue 20261027_003307: a Category 1 typhoon
        // over Laos, I 0.29, took mix(0.55, 1, I) = 0.68, i.e. ~+0.35 of brightness: where the map itself was clear the
        // low cloud under the CDO was a broken field, and the rain (cv2FieldLow's shafts need a formed column, e > 0.3)
        // fell only within ~2 rmw of the eye; 77 km out, under tau ~230 of shield, it was dry.)
        o.y = max(o.y, max(inner * mix(0.9, 1.0, I), band * bandsK * mix(0.8, 1.0, I) * wisp));
        // (Typed convective: rainbands are lines of cumulonimbus; half-stratiform they drew as smooth painted arcs.)
        o.x = max(o.x, max(wall * smoothstep(0.05, 0.4, I), band * bandsK * wisp));
        // (The CDO's rain heavier toward the core, thinning to light stratiform rain at its edge: with the deck under the
        // whole CDO now overcast, a flat 0.55 drew one uniform 40-dBZ disc 400 km across on the radar.)
        o.z = max(o.z, max(wall * mix(0.6, 1.0, I), max(inner * mix(0.6, 0.25, smoothstep(rmw, cdo, r)), band * bandsK * 0.7)));
        o.w = max(o.w, (1.0 - band) * bandsK * 0.7);
        if (cy.c.x > 0.0) eyeAcc = max(eyeAcc, (1.0 - smoothstep(0.7 * cy.c.x, 1.15 * cy.c.x, r)) * smoothstep(0.15, 0.4, I));
        deckC = max(deckC, inner);
    }
    gCycDeck = max(gCycDeck, deckC * pc.storm2.x * (1.0 - eyeAcc));
    o.xyz *= pc.storm2.x;
    o.w   *= pc.storm2.x * pc.storm2.y * (1.0 - max(o.x, o.y));
    // The eye: clear (x4 the moat's weight: the full coverage span).
    o.xyz *= 1.0 - eyeAcc;
    o.w    = max(o.w, 4.0 * eyeAcc);
    return o;
}

// Can a cyclone's stamp reach this texel (its size hw, rad)? (stormStampFinish's own early outs, without its work.)
bool cycloneNear(vec3 d, float hw)
{
    if (pc.storm2.x <= 0.0) return false;
    for (uint i = 0u; i < min(cv2CycHead.x, kCv2CycloneMax); ++i) {
        CV2Cyclone cy = cv2Cyclones[i];
        if (acos(clamp(dot(d, cy.b.xyz), -1.0, 1.0)) * R_EARTH_W < cy.c.z * 1.2 + 1.5 * hw * R_EARTH_W) return true;
    }
    return false;
}

void main()
{
    ivec3 id = ivec3(gl_GlobalInvocationID);
    if (pc.face >= 0) id.z = pc.face;
    else if (pc.evo1.w > 0.5) {   // a set of faces (bits of evo1.w): the dispatch's z is the n-th of them
        uint m = uint(pc.evo1.w + 0.5);
        int  n = id.z, f = 0;
        for (; f < 6; ++f)
            if (((m >> uint(f)) & 1u) != 0u) { if (n == 0) break; --n; }
        id.z = f;
    }
    id.y += int(pc.wx.z);   // (a slice of rows: SatelliteSim::recordWeatherBakeDispatches)
    id.x += int(pc.wx.w);   // (a rectangle's first column: the faces in view at time warp, weatherViewRect)
    if (id.x >= pc.faceSize || id.y >= pc.faceSize || id.z >= 6) return;
    const bool fine = pc.pad > 1.5;   // level 0

    vec2 st = (vec2(id.xy) + 0.5) / float(pc.faceSize);
    vec3 d  = faceDir(id.z, st);

    // Tangent frame for neighbourhood taps, ~one output texel apart.
    vec3  up    = abs(d.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3  tx    = normalize(cross(up, d));
    vec3  ty    = cross(d, tx);
    float texel = 2.0 / float(pc.faceSize);   // angular size of one output texel (rad, ~at face centre)
    gEqLin = abs(d.z) < 0.97 && texel * 16.0 * pc.pad < 0.04;   // (eqTap: the taps reach 8 x pad texels)

    // ── Weather v2: the coverage is synthesised (wxClimate + wxMoistureNoise above), Earth-fixed; the map is not read ──
    float latAbs  = abs(asin(clamp(d.z, -1.0, 1.0))) * (180.0 / PI);
    float ocean   = textureLod(earthSpecTex, equirectUV(d), pc.srcLod + 2.0).r;
    float tropics = 1.0 - smoothstep(18.0, 32.0, latAbs);
    float polar   = smoothstep(50.0, 70.0, latAbs);
    float texM    = texel * R_EARTH_W;               // this level's texel (m)
    float span    = max(pc.remap.z - pc.remap.y, 1e-3);
    // Level 0 adds only the octaves level 1 leaves out to level 1's field (stored as brightness: clear + raw x span).
    vec4  l1      = fine ? textureLod(wxLevel1, vec3(st, float(id.z)), 0.0) : vec4(0.0);
    float cutL    = 2.5 * texM;                       // the shortest wavelength a level holds
    float varLeft;
    float nz      = fine ? wxMoistureNoise(d, cutL, 2.5 * texM * 2.0, varLeft)
                         : wxMoistureNoise(d, cutL, 1e30, varLeft);
    WxClim cl     = wxClimate(d, ocean);

    // The storms' own cloud (the old stamps until step 3), in coverage units.
    gRainFree = 0.0;
    gCycDeck  = 0.0;
    vec4  sT  = stormStampTowers(d);
    vec4  sst = vec4(0.0);
    if (cycloneNear(d, texel)) {
        for (int j = 0; j < 3; ++j)
            for (int i = 0; i < 3; ++i) {
                vec2 o = ((vec2(i, j) + 0.5) / 3.0 - 0.5) * texel;
                sst += stormStampFinish(sT, normalize(d + tx * o.x + ty * o.y));
            }
        sst /= 9.0;
    } else {
        sst = stormStampFinish(sT, d);
    }
    float stormAdd = 0.4 * sst.x + 0.5 * sst.y - 0.25 * sst.w;

    // Afternoon convection over land: the ground heats under the Sun of the last few hours.
    float heat = (pc.evo2.w > 0.0) ? smoothstep(0.15, 0.85, dot(d, pc.evo2.xyz)) : 0.0;
    float aft  = pc.evo2.w * heat * (1.0 - ocean) * smoothstep(0.2, 0.6, cl.raw);

    float raw;
    if (fine) raw = (l1.r - pc.remap.y) / span + kWxContrast * kWxNoise * nz;   // level 1's field + the finer octaves
    else {
        raw = 0.5 + kWxContrast * (cl.raw + kWxNoise * nz) + stormAdd + 0.2 * aft;
        if (pc.evo1.y > 0.0) raw += pc.evo1.y * evoGrowth(d);
        raw = max(raw, gCycDeck);
    }
    float cov = clamp(raw, 0.0, 1.0);

    if (fine) {
        // Type and ground from level 1; the precipitation from this level's own coverage.
        float deepF = smoothstep(0.6, 1.0, cov);
        float pr = clamp(deepF * smoothstep(0.55, 0.9, l1.g) + deepF * smoothstep(0.35, 0.15, l1.g) * 0.35, 0.0, 1.0);
        pr = max(pr * (1.0 - 0.95 * smoothstep(0.02, 0.2, sst.x)) * (1.0 - 0.9 * gRainFree), 0.85 * sst.z);
        imageStore(outWeather, id, vec4(clamp(pc.remap.y + raw * span, 0.0, 1.0), l1.g, pr, l1.a));
        return;
    }

    float conv = max(cl.conv, 0.8 * aft);
    float deep = smoothstep(0.55, 0.95, cov) * max(cl.deep, aft);

    float t = 0.25;                                          // stratocumulus by default
    t += conv * 0.28;                                        // -> cumulus
    t += deep * conv * (0.22 + 0.25 * tropics);              // -> congestus (cumulonimbus only from storms)
    t -= cl.strat * (0.08 + 0.10 * ocean * (1.0 - tropics)); // decks: stratocumulus, stratus over cold sea
    t += 0.3 * aft * (0.5 + 0.5 * tropics);                  // afternoon: towering cumulus
    if (pc.storm2.x > 0.0) t = min(t, 0.62);
    t  = mix(t, max(t, mix(0.55, 0.72, smoothstep(0.5, 1.0, sst.x))), min(sst.x * 2.0, 1.0));
    t  = mix(t, 0.15, sst.y * (1.0 - sst.x));
    t  = clamp(t, 0.0, 1.0);

    float precip = clamp(smoothstep(0.6, 1.0, cov) * (smoothstep(0.55, 0.9, t) + cl.strat * 0.35), 0.0, 1.0);
    float envK = smoothstep(0.02, 0.2, sst.x);
    precip = max(precip * (1.0 - 0.95 * envK) * (1.0 - 0.9 * gRainFree), 0.85 * sst.z);

    // Levels 0 and 1 hold the field itself (raw: below the clear threshold the brightness keeps the distance into clear
    // air); the coarse levels the TRUE mean coverage of the finer field (review 18: the far field reads mip 2 as a
    // fraction), from the variance of the octaves they leave out.
    float covStore = pc.remap.w > 0.5 ? pc.remap.y + wxExpectedCover(raw, kWxContrast * kWxNoise * sqrt(varLeft)) * span
                                      : pc.remap.y + raw * span;
    covStore = clamp(covStore, 0.0, 1.0);

    // Ground height (terrain.glsl's encoding: 15/255 is sea level, 255/255 ~8.5 km above it), a 2x2
    // supersample at this mip's scale (the DEM's 2.7 km texels, ~2 mips finer than the source map's).
    float gnd = 0.0;
    vec2  uvd = equirectUV(d);
    float latd = asin(clamp(d.z, -1.0, 1.0));
    for (int k = 0; k < 4; ++k) {
        vec2 o = (vec2(k & 1, k >> 1) - 0.5) * 0.5 * texel;
        float v = textureLod(earthElevTex, eqTap(d, uvd, latd, tx, ty, o), pc.srcLod + 1.0).r;
        gnd += max(0.0, v * 9000.0 - 15.0 / 255.0 * 9000.0);
    }
    gnd *= 0.25;

    imageStore(outWeather, id, vec4(covStore, t, precip, clamp(gnd / 8000.0, 0.0, 1.0)));
}
