#version 450
#extension GL_EXT_control_flow_attributes : enable
// ── Clouds v2: the god rays' froxel volume (2026-10-22, .plans/CLOUD_REBUILD_PLAN.md S-G) ─────────────────────────────
// EXPERIMENT ("godray_froxels"). The clouds' Sun shadow along the view, once per frame on a kCv2FroxX x kCv2FroxY x
// kCv2FroxZ frustum grid (screen tiles x log-spaced depths, cv2.frox), into cv2GodFrox at the end of the flash buffer
// (sat_sky.frag already binds it: the sky set is at its sampled- and storage-image floors). Each froxel = what the sky
// pass took per point, at a point of its cell that moves each frame (cv2FroxJitter, 2026-10-23: the sky TAA averages it): the cascade's transmittance, overridden by the
// shaft rings where they cover (mix(cascade, shaft.x, shaft.y)). The sky pass then reads a few trilinear values per
// atmosphere step instead of 3 cascade lookups + 24 shaft lookups (S0: god rays + haze were 3-8 ms of the sky pass).
// Same descriptor set and push constants as cloud_v2_march.comp; run after the lightning pass (the bakes).
layout(local_size_x = 8, local_size_y = 8, local_size_z = 4) in;

layout(push_constant) uniform PC {        // == CloudMarchPC (cloud_v2_march.comp)
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#define CLOUD_PARAMS_BINDING 0
#include "cloud_params.glsl"
#include "common.glsl"
#define CV2_PARAMS_BINDING  1
#define CV2_MORPH_BINDING   20
#define CV2_WEATHER_BINDING 2
#define CV2_SHAPE_BINDING   3
#define CV2_MESO_BINDING    5
#include "clouds_v2.glsl"
#define CV2_FLASH_BINDING 12
#define CV2_FLASH_WRITE
#define CV2_SUN_CASC_FN
#include "cloud_lightning.glsl"
layout(std430, set = 0, binding = 8) readonly buffer TerrainFrame { vec4 terrainFrame; };   // x the eye's ground height

void main()
{
    ivec3 g = ivec3(gl_GlobalInvocationID);
    if (g.x >= kCv2FroxX || g.y >= kCv2FroxY || g.z >= kCv2FroxZ) return;
    int idx = (g.z * kCv2FroxY + g.y) * kCv2FroxX + g.x;
    if (cv2.frox.x <= 0.5 || (cv2.stvH.z <= 0.5 && cv2.tsh0.w <= 0.5)) { cv2GodFrox[idx] = 1.0; return; }

    // The view ray through the froxel's sample point (cv2FroxJitter: it moves within the tile and the slice each frame
    // and the sky pass reconstructs from the same points; cloud_v2_march.comp's rayDirAt, in screen fractions), the Sun
    // transmittance volume at nSub depths through the slice from there: two when the samples move from frame to frame
    // (the sky TAA averages them; one read as grain in motion), four at fixed depths without it.
    vec3  jit = cv2FroxJitter();
    vec2  ndc = (vec2(g.xy) + jit.xy) / vec2(kCv2FroxX, kCv2FroxY) * 2.0 - 1.0;
    float th  = tan(pc.fovYRad * 0.5);
    vec3  dir = normalize(mat3(transpose(pc.skyView)) * vec3(ndc.x * th * pc.aspect, -ndc.y * th, -1.0));
    int nSub = (cv2.frox.w < 0.0) ? 4 : 2;
    // No sample below the sea (2026-11-24, issue_20261124_185624 "Concentric ring artifact", 53.7 km over the Gulf of
    // Thailand): a slice ~15% of its distance deep straddles the ray's end at the sea, and its samples past the surface
    // read the terrain map's shadow (the inside of the Earth: T 0). The sky pass reads the volume trilinearly at its
    // steps, all in front of the surface, so the air over the sea took a share of that underground darkness that grew
    // across each slice and dropped at the next: sawtooth rings of constant distance round the nadir, in the Mie (the
    // haze sits at the ray's low end; ~10% of it, 2-6 levels). A sample past the sea-level sphere takes the surface's
    // value instead (what the air just above it gets). Land above sea level can still put a slice's far samples inside a
    // hill (the volume has no surface of its own); the DEM is not bound here.
    vec3  eyeF = vec3(0.0, 0.0, R_EARTH + terrainFrame.x + 2.0);
    vec2  tSeaF = raySphere(eyeF, dir, R_EARTH);
    float tMaxF = (tSeaF.x > 0.0) ? tSeaF.x : 1e30;
    float T = 0.0;
    [[dont_unroll]] for (int k = 0; k < nSub; ++k) {
        float t  = min(cv2FroxDepth(float(g.z) + jit.z + (float(k) + 0.5) / float(nSub) - 0.5), tMaxF);
        vec3  pE = dir * t + eyeF;
        T += cv2StvTFine(dir * t, length(pE) - R_EARTH) * cv2TerrSunTFine(dir * t);   // the clouds' and the terrain's shadows
    }
    cv2GodFrox[idx] = T / float(nSub);
}
