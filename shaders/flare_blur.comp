#version 450
layout(local_size_x = 16, local_size_y = 16) in;

// ── flare_blur.comp ────────────────────────────────────────────────────────────
// Stage 2 of the flare architecture overhaul (see FlareSourcePC's comment in SatelliteSim.h).
// Post-processes the small (quarter-res) bright-source buffer flare_source.vert/.frag renders into a
// ROUND glow: a narrow separable Gaussian (the corona right around each source) plus a wide one
// (the broad glow a crowd of satellites, or a bright glint, spreads over the sky). Both are
// separable Gaussians, so the result is exactly isotropic with no truncation edge. The sharp spikes
// of a bright source are not made here: glare.vert/.frag draws them at full resolution.
//
// Until 2026-09-24 the last pass sampled 6, then 16, fixed directions: a bright point came out as a
// 6- (then 16-) armed starfish of dotted rays that stopped dead where the taps ran out.
//
// Ping-pongs between two same-sized storage images (flareA = the source, flareB = scratch). Four
// dispatches per frame, same pipeline, mode selected by push constants:
//   1: mode 0, narrow horizontal  A -> B
//   2: mode 1, narrow vertical    B -> A    (A = narrow glow)
//   3: mode 2, wide horizontal    A -> B
//   4: mode 3, wide vertical      B -> A, added to A's own texel (only that texel of A is read, so the
//      in-place write is race-free). Final result in flareA.

layout(set = 0, binding = 0, rgba16f) uniform image2D flareA;
layout(set = 0, binding = 1, rgba16f) uniform image2D flareB;

layout(push_constant) uniform PC {
    uint  direction;  // 0 = read flareA write flareB, 1 = read flareB write flareA
    uint  mode;       // 0/1 = narrow horizontal/vertical, 2/3 = wide horizontal/vertical
    float streakGain; // the wide glow's strength ("Flare streak" x the night eye-adaptation)
    float pad0;
} pc;

const float kGaussWeights[9] = float[9](0.028, 0.066, 0.123, 0.180, 0.206, 0.180, 0.123, 0.066, 0.028);

// The wide glow: sigma 10 texels of this buffer (~40 px on screen), sampled every 2 texels out to
// 3.6 sigma (the narrow pass has already smoothed the source to sigma ~2, so the stride cannot alias).
const float kWideSigma  = 10.0;
const int   kWideStride = 2;
const int   kWideTaps   = 18;
const float kWideGain   = 1.5;

vec4 loadSrc(bool readA, ivec2 c) { return readA ? imageLoad(flareA, c) : imageLoad(flareB, c); }

void main() {
    ivec2 size  = imageSize(flareA);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    bool readA = (pc.direction == 0u);
    ivec2 axis = (pc.mode == 0u || pc.mode == 2u) ? ivec2(1, 0) : ivec2(0, 1);

    if (pc.mode <= 1u) {
        vec4 sum = vec4(0.0);
        for (int i = -4; i <= 4; ++i)
            sum += loadSrc(readA, clamp(coord + axis * i, ivec2(0), size - 1)) * kGaussWeights[i + 4];
        if (readA) imageStore(flareB, coord, sum); else imageStore(flareA, coord, sum);
        return;
    }

    // Wide Gaussian, normalised (energy-preserving per axis); off-screen taps count as black.
    vec4  sum = vec4(0.0);
    float wsum = 0.0;
    for (int i = -kWideTaps; i <= kWideTaps; ++i) {
        float t = float(i * kWideStride);
        float w = exp(-t * t / (2.0 * kWideSigma * kWideSigma));
        wsum += w;
        ivec2 sc = coord + axis * (i * kWideStride);
        if (sc.x < 0 || sc.y < 0 || sc.x >= size.x || sc.y >= size.y) continue;
        sum += loadSrc(readA, sc) * w;
    }
    sum /= wsum;
    if (pc.mode == 2u) {
        if (readA) imageStore(flareB, coord, sum); else imageStore(flareA, coord, sum);
        return;
    }
    // mode 3: B's wide vertical pass, added onto the narrow glow already in A (this texel only).
    vec4 narrow = imageLoad(flareA, coord);
    imageStore(flareA, coord, narrow + sum * (kWideGain * pc.streakGain));
}
