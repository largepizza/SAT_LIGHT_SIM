#version 450
#extension GL_EXT_control_flow_attributes : enable
// ── Clouds v2: the lightning flash list (2026-09-29, include/cloud_lightning.glsl) ────────────────
// One workgroup, once per frame, before cloud_v2_march.comp (same descriptor set and push constants).
// Walks the Cb tower lattice (cv2ColumnSigma's cube-face cells) around the observer out to the
// horizon of the cloud tops, and for every tower strong enough to reach the anvil evaluates its flash
// schedule for this 2 s slot of sim time and the one before: a flash starts at a hashed moment, lasts
// 0.25-0.85 s, and flickers through 1-4 return strokes over a fading glow; about a quarter of the
// strongest towers' flashes are cloud-to-ground strokes. "Lightning rate" (cv2.lightning.x) is the
// flashes per minute of a tower at full strength.
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {        // == CloudMarchPC (cloud_v2_march.comp)
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#define CLOUD_PARAMS_BINDING 0
#include "cloud_params.glsl"
#include "common.glsl"
#define CV2_PARAMS_BINDING  1
#define CV2_WEATHER_BINDING 2
#define CV2_SHAPE_BINDING   3
#define CV2_MESO_BINDING    5
#define CV2_MORPH_BINDING   20   // the march set's (review 19: every consumer places clouds alike)
#define CV2_STORM_BINDING   26   // the storm objects' towers (cv2_storms.glsl)
#include "clouds_v2.glsl"
layout(std430, set = 0, binding = 8) buffer TerrainFrame { vec4 terrainFrame; };
#define CV2_FLASH_BINDING 12
#define CV2_FLASH_WRITE
#define CV2_SUN_CASC_FN       // cv2StvLat (the Sun transmittance volume's bake)
#include "cloud_lightning.glsl"
#include "atmosphere.glsl"
layout(set = 0, binding = 7) uniform sampler2D earthNightTex;   // the march set's (city light on the rain at the eye)

// ── The light on a rain drop at the eye (rain particles, 2026-10-04) ───────────────────────────────
// Copies of cloud_v2_march.comp's sunTransmit / sunColorAt / skyZenithAt (keep in step): the particles
// must be lit as the march lights a rain sample at the eye, or the drawn drops and the rain volume
// beyond them disagree.
vec3 rlSunTransmit(vec3 p, vec3 d, vec3 betaR, float betaM) {
    float r = length(p), c = dot(p, d) / r;
    float odR = atmColumnInf(r, c, H_R) * H_R;
    float odM = atmColumnInf(r, c, H_M) * H_M;
    const float rO = R_EARTH + 25000.0;
    float sin2 = (r / rO) * (r / rO) * (1.0 - c * c);
    float sec  = inversesqrt(max(1.0 - sin2, 1e-3));
    float nX   = (r <= rO) ? 1.0 : ((c < 0.0 && sin2 < 1.0) ? 2.0 : 0.0);
    vec3  odO  = vec3(0.019, 0.027, 0.0016) * min(sec, 30.0) * nX;
    return exp(-(betaR * odR + betaM * 1.1 * odM + odO));
}
vec3 rlSunColorAt(vec3 p, vec3 sunDir, vec3 betaR, float betaM) {
    vec2 tSE = raySphere(p, sunDir, R_EARTH);
    if (tSE.x > 0.0 && tSE.y > 0.0) return vec3(0.0);
    return SUN_INTENSITY * rlSunTransmit(p, sunDir, betaR, betaM);
}
vec3 rlSkyZenithAt(vec3 p, vec3 sunDir, vec3 betaR, float betaM) {
    vec3 zen = normalize(p);
    vec2 tSA = raySphere(p, zen, R_ATMOS);
    if (tSA.y <= 0.0) return vec3(0.0);
    const int N_Z = 12;   // as cloud_v2_march.comp (6 was magenta at twilight)
    float seg = tSA.y / float(N_Z);
    float cosUp = dot(zen, sunDir);
    float odR = 0.0, odM = 0.0, accM = 0.0;
    vec3  accR = vec3(0.0);
    for (int i = 0; i < N_Z; ++i) {
        vec3  sp = p + zen * ((float(i) + 0.5) * seg);
        float h  = max(0.0, length(sp) - R_EARTH);
        float dR = exp(-h / H_R) * seg, dM = exp(-h / H_M) * seg;
        odR += dR; odM += dM;
        vec2 tSE = raySphere(sp, sunDir, R_EARTH);
        if (tSE.x > 0.0 && tSE.y > 0.0) continue;
        vec3 att  = exp(-(betaR * odR + betaM * 1.1 * odM)) * rlSunTransmit(sp, sunDir, betaR, betaM);
        accR += att * dR;
        accM += dot(att, vec3(1.0 / 3.0)) * dM;
    }
    return SUN_INTENSITY * (phaseR(cosUp) * betaR * accR + vec3(phaseM(cosUp) * betaM * accM));
}

shared uint sFlashN;
shared float sRainMax[256];
// The Sun transmittance volume's bake (workgroups >= 5): kCv2StvG threads per ray, each marching kCv2StvK / kCv2StvG
// consecutive knots of it, their optical depths joined by a prefix over the ray's threads (sStvOd). It was one thread
// per ray, 2-4 sub-rays x 48 knots x up to 4 field reads one after another on 13 workgroups: ~0.9 ms of latency with
// most of the GPU idle (2026-10-23, perf). The dispatch is 5 + 13 x kCv2StvG (SatelliteSimCloudsV2.cpp: keep in step).
const uint kCv2StvG = 8u;
shared float sStvOd[256];

vec3 cv2UndriftL(vec3 v)
{
    return vec3(v.x * cv2.cover.z + v.y * cv2.cover.w, -v.x * cv2.cover.w + v.y * cv2.cover.z, v.z);
}

void main()
{
    uint li = gl_LocalInvocationIndex;
    // Review 22: workgroups 1-4 fill the rain map around the eye (cloud_lightning.glsl): the rain rate at each
    // cell, from the same field and the same formula as the march's rate at the eye, so the drops in each depth
    // layer (the rain particles, rain_particles.vert) follow the rain volume — walking toward a shaft, its drops appear in
    // the far layers first. They used to come from the rate at the eye alone: none until inside, then all.
    if (gl_WorkGroupID.x > 4u) {
        vec3  enuZ = normalize(pc.obsECEFDir.xyz);
        vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
        mat3  enuToEcef = mat3(enuX, cross(enuZ, enuX), enuZ);
        float eyeH = terrainFrame.x + 2.0;
        vec3  sunENU = transpose(enuToEcef) * cv2.sunE.xyz;
        // The Sun transmittance VOLUME (S3, 2026-10-22; cloud_lightning.glsl cv2Stv): workgroups 5-6 bake level 0 (512
        // rays a frame, all in 32 frames), 7-9 levels 1-3 (256 a frame, all in 64). A ray is marched from the top of the
        // shell DOWN its sunward side (where the Sun is above the local horizon), recording the transmittance beyond the
        // point at each knot height; between knots the steps follow the cell and grow with the distance from the eye
        // (a far blocker's shadow is no sharper than the Sun's disc makes it). Thin layers count as in the light march.
        {
            if (cv2.stvH.z < 0.5) return;
            // The logical bake workgroup (5..17) and ray (0..255) this thread works on, and its share of the ray's knots.
            uint wgL = 5u + (gl_WorkGroupID.x - 5u) / kCv2StvG;
            uint liR = ((gl_WorkGroupID.x - 5u) % kCv2StvG) * (256u / kCv2StvG) + li / kCv2StvG;
            uint gK  = li % kCv2StvG;
            const int  kPer = kCv2StvK / int(kCv2StvG);
            int  kHi = kCv2StvK - 1 - int(gK) * kPer;   // its knots kHi .. kHi - kPer + 1 (from the top down)
            // Workgroups 10-17: levels 0 (10-13) and 1 (14-17) four times more while they catch up (cv2.stvV.z: after a fast
            // move or a refill), all of a level in 16 frames: after a 45-km hop their slots had all changed hands and took a
            // round (32 / 64 frames) to come back, slower than the rings and the cascade (harness_runs/s3/hop).
            bool  boost = wgL >= 10u;
            if (boost && cv2.stvV.z < 1.0) return;   // z = boost (1 or 0) + the running mean's floor (< 1)
            int   lv    = boost ? int((wgL - 10u) >> 2u) : (wgL <= 6u) ? 0 : int(wgL - 6u);
            int   wg    = boost ? int(wgL - 10u) & 3 : int(wgL) - 5;   // 0 / 1 for level 0
            vec4  la    = cv2StvLat(lv);
            float cellM = la.z;
            if (la.w <= 0.0 && la.z <= 0.0) return;
            vec2  vel   = cv2.stvV.xy * (cv2.stvL0.z / cellM);
            vec2  wc0   = vec2(cv2.stvH.w, cv2.stvV.w) / cellM;
            float sp    = max(abs(vel.x), abs(vel.y));
            bool  lead  = !boost && ((lv == 0) ? (sp > 0.02 && wg == 1) : (sp > 0.5));
            int   r;
            if (lead) {
                int   ax  = (abs(vel.x) >= abs(vel.y)) ? 0 : 1;
                float sg  = ((ax == 0) ? vel.x : vel.y) >= 0.0 ? 1.0 : -1.0;
                int   jj  = int(liR >> 7u);
                int   sAx = int(floor(((ax == 0) ? la.x + wc0.x : la.y + wc0.y) + sg * (55.0 - float(jj)) + 4096.0)) & (kCv2StvN - 1);
                int   row = int(liR & 127u);
                r = (ax == 0) ? row * kCv2StvN + sAx : sAx * kCv2StvN + row;
            } else if (boost) {
                r = int(((uint(cv2.frame.x) * 4u + uint(wg) + 32u) & 63u) * 256u + liR);
            } else if (lv == 0) {
                r = (sp > 0.02) ? int((uint(cv2.frame.x) & 63u) * 256u + liR)
                                : int((((uint(cv2.frame.x) & 31u) * 2u) + uint(wg)) * 256u + liR);
            } else {
                r = int(((uint(cv2.frame.x) + uint(lv) * 21u) & 63u) * 256u + liR);
            }
            vec3  ga, gb;
            cv2SunGridAxes(sunENU, ga, gb);
            vec2  wc = vec2(cv2.stvH.w, cv2.stvV.w) / cellM;   // the window's centre from the eye (cells)
            vec2  gc = vec2(float(r % kCv2StvN), float(r / kCv2StvN)) - (la.xy + wc);
            gc -= float(kCv2StvN) * round(gc / float(kCv2StvN));
            gc += wc;
            ivec2 ia  = ivec2(round(la.xy + gc)) + 4096;     // the slot's absolute cell (mod 1024)
            // The field read FINE whatever the level's cells (a coarse read of the thresholded field loses a cloud's optical
            // depth: the storm's shadow came out light and patchy against a brute-force reference, harness_runs/s3/ref1).
            float fpM = max(150.0, 0.25 * cellM);
            float hLo = cv2.stvH.x, dH = (cv2.stvH.y - cv2.stvH.x) / float(kCv2StvK - 1);
            float Tk[kCv2StvK / int(kCv2StvG)];   // this thread's knots: Tk[j] = knot kHi - j
            for (int j = 0; j < kPer; ++j) Tk[j] = 0.0;
            uvec3 jh = cv2Pcg3(uvec3(uint(r), 977u + uint(lv), 11u));
            float jn = float(uint(cv2.frame.x) & 1023u);
            vec2  jo = fract(vec2(jh.xy & 0xFFFFu) / 65536.0 + jn * vec2(0.7548777, 0.5698403));
            float jp = fract(float(jh.z & 0xFFFFu) / 65536.0 + jn * 0.6180340);
            int   nSr = lead ? 4 : 2;
            float wSr = 1.0 / float(nSr);
            vec3  E   = vec3(0.0, 0.0, R_EARTH + eyeH);
            [[dont_unroll]] for (int sr = 0; sr < nSr; ++sr) {
                vec2  gp = (gc + fract(jo + vec2(wSr * float(sr), fract(0.6180340 * float(sr) + 0.5 * float(sr & 1)))) - 0.5) * cellM;
                vec3  o  = ga * gp.x + gb * gp.y;            // the ray's point in the plane through the eye across the Sun
                // The line o + s S; its closest point to the Earth's centre at sC, at radius cL (height hc). The sunward
                // branch reaches height h at s = sC + sqrt((R + h)^2 - cL^2) (written cancellation-free).
                vec3  P  = o + E;
                float sC = -dot(P, sunENU);
                float cL = length(P + sunENU * sC);
                float od = 0.0;   // from this thread's first knot down (the prefix below adds the knots above)
                float odK[kCv2StvK / int(kCv2StvG)];
                // The knot above this thread's first one: where its first interval starts.
                float sPrev = 0.0;
                if (kHi < kCv2StvK - 1) {
                    float rk = R_EARTH + max(hLo + float(kHi + 1) * dH, cL - R_EARTH + 1.0);
                    sPrev = sC + sqrt(max((rk - cL) * (rk + cL), 0.0));
                }
                [[dont_unroll]] for (int j = 0; j < kPer; ++j) {
                    int   k  = kHi - j;
                    float rk = R_EARTH + max(hLo + float(k) * dH, cL - R_EARTH + 1.0);
                    float sk = sC + sqrt(max((rk - cL) * (rk + cL), 0.0));
                    if (k < kCv2StvK - 1) {
                        float len = sPrev - sk;
                        // Steps: about two cells, growing with the distance from the eye (1.2%: a far blocker's shadow is no
                        // sharper than the Sun's disc makes it), at most 4 an interval. (Against a brute-force reference,
                        // harness_runs/s3/ref1-3: finer steps and reads cost up to +1.6 ms in a storm and matched no better.)
                        float tgt = max(max(2.0 * cellM, 600.0), 0.012 * abs(0.5 * (sPrev + sk)));
                        int   n   = clamp(int(ceil(len / tgt)), 1, 4);
                        float st  = len / float(n);
                        [[dont_unroll]] for (int m = 0; m < n; ++m) {
                            float sM = sk + st * (float(m) + fract(jp + wSr * float(sr) + 0.6180340 * float(k * 4 + m)));
                            CV2Pos q = cv2Pos(o + sunENU * sM, eyeH, enuToEcef);
                            if (st > 1.0 && q.h > -300.0 && q.h < cv2.shell.y + 2500.0) {
                                CV2_CNT(13);
                                CV2Field gf = cv2Field(q, 0.0, fpM);
                                // Rain at 15%, as the ground's shadow march took it: a low Sun's path runs tens of km through
                                // the curtains under the bases, and their coarse extinction blacked out the sea under them.
                                od += gf.sigma * max(1.0 - 0.8 * gf.thin - cv2.mid2.z * gf.soft, 0.0)
                                    * mix(1.0, 0.15, clamp(gf.rain, 0.0, 1.0)) * st;
                            }
                        }
                    }
                    odK[j] = od;
                    sPrev = sk;
                }
                // The prefix: the optical depth of the knots above this thread's (the ray's lower-numbered threads).
                // (lead / nSr are uniform in the workgroup: every thread reaches both barriers.)
                sStvOd[li] = od;
                barrier();
                float odAbove = 0.0;
                for (uint g2 = 0u; g2 < gK; ++g2) odAbove += sStvOd[li - gK + g2];
                barrier();
                for (int j = 0; j < kPer; ++j) Tk[j] += wSr * exp(-(odAbove + odK[j]));
            }
            if (r < kCv2StvN * kCv2StvN) {
                float wMean = cv2.stvV.z - floor(cv2.stvV.z);
                int  rb   = ((lv * kCv2StvN * kCv2StvN) + r) * kCv2StvK;
                uint want = cv2ShaftStampOf(ia.x, ia.y, 0);
                for (int j = 0; j < kPer; ++j) {
                    int   k    = kHi - j;
                    uint  bits = floatBitsToUint(cv2Stv[rb + k]);
                    bool  ok   = cv2ShaftStampOk(bits, want);
                    uint  c    = cv2ShaftCount(bits);
                    float T    = ok ? mix(cv2ShaftT(bits), Tk[j], c < 2u ? 1.0 / float(c + 2u) : wMean) : Tk[j];
                    // Rounded to the 10-bit value stochastically: a running mean at 1/32 a bake moves less than half a
                    // step for most bakes, and plain rounding would leave it stuck up to 16 steps off its mean.
                    float dq = float(cv2Pcg3(uvec3(uint(r), uint(k) + 31u * uint(lv), uint(cv2.frame.x))).x & 0xFFFFu) / 65536.0;
                    T = (floor(clamp(T, 0.0, 1.0) * 1023.0 + dq) + 0.25) / 1023.0;
                    cv2Stv[rb + k] = cv2ShaftPack(T, want, ok ? c + 1u : 0u);
                }
            }
            return;
        }
    }
    if (gl_WorkGroupID.x > 0u) {
        uint  cell = (gl_WorkGroupID.x - 1u) * 256u + li;
        float rr = 0.0;
        if (cv2.rain.x > 0.0 && cell < uint(kCv2RainMapN * kCv2RainMapN)) {
            vec3  enuZ = normalize(pc.obsECEFDir.xyz);
            vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
            vec3  enuY = cross(enuZ, enuX);
            float eyeH = terrainFrame.x + 2.0;
            if (eyeH < 6000.0) {
                vec2 en = (vec2(float(cell % uint(kCv2RainMapN)), float(cell / uint(kCv2RainMapN)))
                           - 0.5 * float(kCv2RainMapN) + 0.5) * kCv2RainCellM;
                CV2_CNT(11);
                CV2Field fe = cv2Field(cv2Pos(vec3(en, 0.0), eyeH, mat3(enuX, enuY, enuZ)), -1.0, kCv2RainCellM);
                // The rain's own extinction (2026-10-22: inside a cloud's base the sample is cloud + a rain share).
                rr = clamp(fe.rain * fe.sigma / 0.0012, 0.0, 1.0);
                // Deeper in a raining cloud than its rain floor reaches (cv2FieldLow's kCv2RainIntoM): the rain
                // there is the column's rain under it (issue 20261022_174757: drops up to and into the cloud).
                if (fe.rain < 0.99 && fe.sigma > 0.0 && eyeH > 700.0) {
                    CV2_CNT(11);
                    CV2Field fb = cv2Field(cv2Pos(vec3(en, 0.0), eyeH - 600.0, mat3(enuX, enuY, enuZ)), -1.0, kCv2RainCellM);
                    rr = max(rr, 0.7 * clamp(fb.rain * fb.sigma / 0.0012, 0.0, 1.0));
                }
            }
        }
        if (cell < 1024u) cv2RainMap[cell] = rr;
        sRainMax[li] = rr;
        barrier();
        for (uint s = 128u; s > 0u; s >>= 1u) {
            if (li < s) sRainMax[li] = max(sRainMax[li], sRainMax[li + s]);
            barrier();
        }
        if (li == 0u && gl_WorkGroupID.x <= 4u) cv2RainWgMax[gl_WorkGroupID.x - 1u] = sRainMax[0];
        return;
    }
    if (li == 0u) sFlashN = 0u;
    barrier();

    // Two sources (2026-10-05): the Cb TOWERS (cv2ColumnSigma's dominant, anvil-reaching towers: "Lightning
    // (flashes/min/tower)"), and a STORM-CELL lattice over every deep-convective region of the weather map
    // ("Storm lightning (flashes/min/cell)", cells ~20 km, larger from altitude so the search stays bounded):
    // a whole storm system flashes, not only its towers. Each flash's light, channel and thunder are built
    // from its record (cloud_lightning.glsl: kind, seed, origin, ground point, the cloud's base and top).
    if (cv2.lightning.x > 0.0 || cv2.lightning2.x > 0.0) {
        vec3  enuZ = normalize(pc.obsECEFDir.xyz);
        vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
        vec3  enuY = cross(enuZ, enuX);
        mat3  enuToEcef = mat3(enuX, enuY, enuZ);
        mat3  ecefToEnu = transpose(enuToEcef);
        float eyeH = terrainFrame.x + 2.0;
        vec3  eye  = vec3(0.0, 0.0, R_EARTH + eyeH);
        float reachH = sqrt(2.0 * R_EARTH * max(eyeH, 0.0)) + sqrt(2.0 * R_EARTH * 12000.0);
        float tNow = cv2.lightning.w;
        float sNow = floor(tNow / kCv2FlashSlot);

        vec3  wdO = cv2Drift(enuZ);
        vec3  aw  = abs(wdO);
        int   fc  = (aw.x >= aw.y && aw.x >= aw.z) ? 0 : ((aw.y >= aw.z) ? 1 : 2);
        vec3  ax  = (fc == 0) ? vec3(sign(wdO.x), 0.0, 0.0) : ((fc == 1) ? vec3(0.0, sign(wdO.y), 0.0) : vec3(0.0, 0.0, sign(wdO.z)));
        vec3  e1  = (fc == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
        vec3  e2  = (fc == 2) ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
        uint  faceId = uint(fc * 2);
        float mj  = dot(wdO, ax);
        vec2  aO  = vec2(atan(dot(wdO, e1) / mj), atan(dot(wdO, e2) / mj));

        // Source 0: the storm objects' towers (cv2_storms.glsl, 2026-10-22; was the Cb tower lattice).
        float Rb     = cv2.column.z;
        bool  towersOn = cv2.lightning.x > 0.0 && cv2.column.z > 0.0;
        // Lattice 1: storm REGIONS, a FIXED equal-angle lattice on all six cube faces of the drifted sphere (64 x 64
        // per face, ~156 km), the same whatever the eye's altitude: only how far out it reaches changes. Each region
        // draws candidate flashes at the most active rate (nM tries of probability lambda / nM) at random points
        // inside it, and keeps each with the storm's activity at its point (thinning): the rate per area follows the
        // weather, and only the few candidates live this frame read it. (The first cut's 20-km cells grew with the
        // eye's altitude above 333 km, so descending with time paused reshuffled every flash: user snap 2.)
        const int   kNR = 64;
        const float cR  = 1.5707963 / float(kNR);
        bool  cellsOn  = cv2.lightning2.x > 0.0;
        float cosReach = cos(min(reachH / R_EARTH + cR, PI));
        int   nT = towersOn ? int(min(cv2StormHead.x, kCv2StormMaxTowers)) : 0;
        int   nR = cellsOn ? 6 * kNR * kNR : 0;

        for (int idx = int(li); idx < nT + nR; idx += 256) {
            bool  tower = idx < nT;
            vec3  up, rAx = vec3(0.0), rE1 = vec3(0.0), rE2 = vec3(0.0);
            vec2  rA0 = vec2(0.0);
            float str = 0.0, act = 0.0, spread = 0.0, pSlot;
            uint  cellH;
            int   nM;
            if (tower) {
                CV2Tower tw = cv2Towers[idx];
                if (tw.b.x < 1.0) continue;                         // only a dominant tower reaches the anvil
                up = tw.a.xyz;
                if (acos(clamp(dot(up, wdO), -1.0, 1.0)) * R_EARTH > reachH) continue;
                str   = tw.a.w;
                act   = smoothstep(0.35, 0.75, str);
                if (act <= 0.0) continue;
                pSlot  = cv2.lightning.x / 60.0 * kCv2FlashSlot * act;
                nM     = 3;                                          // a busy tower can flash up to 3 times a slot
                spread = Rb * mix(0.7, 1.3, tw.b.y);
                uint sd = floatBitsToUint(tw.c.y);
                cellH  = cv2StormHash(sd) ^ (sd * 0x9E3779B9u);
            } else {
                int   j  = idx - nT;
                int   f  = j / (kNR * kNR);
                int   r  = j - f * kNR * kNR;
                ivec2 ri = ivec2(r % kNR, r / kNR);
                int   a  = f >> 1;
                float sg = ((f & 1) == 0) ? 1.0 : -1.0;
                rAx = (a == 0) ? vec3(sg, 0.0, 0.0) : ((a == 1) ? vec3(0.0, sg, 0.0) : vec3(0.0, 0.0, sg));
                rE1 = (a == 0) ? vec3(0.0, 1.0, 0.0) : vec3(1.0, 0.0, 0.0);
                rE2 = (a == 2) ? vec3(0.0, 1.0, 0.0) : vec3(0.0, 0.0, 1.0);
                rA0 = (vec2(ri) - 0.5 * float(kNR)) * cR;
                vec2  tc = tan(rA0 + 0.5 * cR);
                up = normalize(rAx + tc.x * rE1 + tc.y * rE2);
                if (dot(up, wdO) < cosReach) continue;
                // The region's area (the equal-angle map's Jacobian) in 20-km cells: the rate is per area.
                float s2  = 1.0 + tc.x * tc.x + tc.y * tc.y;
                float J   = (1.0 + tc.x * tc.x) * (1.0 + tc.y * tc.y) / (s2 * sqrt(s2));
                float lam = cv2.lightning2.x / 60.0 * kCv2FlashSlot * J * (cR * R_EARTH) * (cR * R_EARTH) / (20000.0 * 20000.0);
                nM    = int(clamp(ceil(2.0 * lam + 2.0), 3.0, 48.0));
                pSlot = lam / float(nM);
                uvec3 hv = cv2Pcg3(uvec3(uvec2(ri) + 8192u, uint(f) + 101u));
                cellH = hv.x ^ (hv.y * 0x9E3779B9u) ^ (hv.z * 0x85EBCA6Bu);
            }
            for (int ds = 0; ds <= 1; ++ds) {
                float sl = sNow - float(ds);
                for (int m = 0; m < nM; ++m) {
                    uvec3 fh = cv2Pcg3(uvec3(cellH + uint(m) * 0x632BE5ABu, uint(int(sl) + 1000000), 0x7F4A7C15u));
                    float u  = float(fh.x & 0xFFFFu) / 65535.0;
                    if (u >= (tower ? pSlot - float(m) : pSlot)) continue;
                    float start = (sl + float(fh.x >> 16u) / 65535.0) * kCv2FlashSlot;
                    float age   = tNow - start;
                    if (age < 0.0 || age > 1.45 + kCv2LeaderS) continue;   // past any flash's duration + its 0.3-s tail
                    vec3  fUp = up;
                    float fStr = str, fAct = act;
                    if (!tower) {
                        // The candidate's point in the region, and the storm there: a deep-convective, raining
                        // region of the weather map (the type at ~20 km, its cover, the rain).
                        uvec3 qh = cv2Pcg3(fh ^ uvec3(0x2F6B1C3Du, 0x9A1E5B77u, 0x4C8E2D19u));
                        vec2  tp = tan(rA0 + cR * vec2(qh.xy & 0xFFFFu) / 65535.0);
                        fUp = normalize(rAx + tp.x * rE1 + tp.y * rE2);
                        if (acos(clamp(dot(fUp, wdO), -1.0, 1.0)) * R_EARTH > reachH) continue;
                        vec4  wk = cv2WeatherBilinear(cv2FlowWeatherDir(fUp, cv2FlowDisp(fUp, fUp)), 2.0);
                        float ck = clamp((wk.r * cv2.look.x - cv2.cover.x) / max(cv2.cover.y - cv2.cover.x, 1e-3), 0.0, 1.0);
                        fStr = smoothstep(0.55, 0.8, wk.g) * smoothstep(0.1, 0.4, ck) * (0.3 + 0.7 * smoothstep(0.1, 0.6, wk.b));
                        // Storm lightning needs a storm OBJECT nearby (2026-10-22): the map's deep-convective regions are
                        // hundreds to thousands of km across, and flashes over all of them lit cloud with no storm in it.
                        // The strongest tower within its reach here (its whole reach: an MCS's stratiform region flashes too).
                        uvec2 sb = cv2StormBin(fUp);
                        float nearT = 0.0;
                        for (uint si = 0u; si < sb.y; ++si) {
                            CV2Tower st = cv2Towers[cv2StormList[sb.x + si]];
                            float dT = acos(clamp(dot(fUp, st.a.xyz), -1.0, 1.0)) * R_EARTH;
                            nearT = max(nearT, smoothstep(0.2, 0.6, st.a.w) * (1.0 - smoothstep(0.3 * st.c.x, st.c.x, dT)));
                        }
                        fStr *= nearT;
                        fAct = smoothstep(0.05, 0.5, fStr);
                        if (float(qh.z & 0xFFFFu) / 65535.0 >= fAct) continue;
                    }
                    uvec3 ph = cv2Pcg3(fh ^ uvec3(0x51ED27u, 0xB5297A4Du, 0x68E31DA4u));
                    // The kind: cloud-to-ground ~30% where the storm is strong; the rest in the cloud, a share of them
                    // spreading out just under its base (spider lightning, anvil crawlers), the others hidden in it.
                    float kr   = float(ph.z & 0xFFFFu) / 65535.0;
                    bool  cg   = kr < 0.3 * smoothstep(0.3, 0.6, fStr);
                    bool  low  = !cg && kr > 0.6;
                    float dur  = cg ? 0.25 + 0.6 * float(fh.y & 0xFFFFu) / 65535.0
                                    : 0.35 + 0.8 * float(fh.y & 0xFFFFu) / 65535.0;
                    if (age > dur + kCv2LeaderS + 0.3) continue;
                    float I = cv2FlashIntensity(age, dur, fh, cg) * mix(0.6, 1.0, fAct);
                    if (I < 0.01 && age > kCv2LeaderS) continue;
                    vec3  t1 = normalize(cross(fUp, abs(fUp.z) < 0.9 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0)));
                    vec3  t2 = cross(fUp, t1);
                    vec2  jv = vec2(float(ph.x & 0xFFFFu), float(ph.x >> 16u)) / 65535.0 - 0.5;
                    vec2  jg = vec2(float(ph.y & 0xFFFFu), float((ph.y >> 16u) & 0xFFu) * 257.0) / 65535.0 - 0.5;
                    vec3  oD = normalize(fUp + (t1 * jv.x + t2 * jv.y) * (spread / R_EARTH));
                    vec3  oE = ecefToEnu * cv2UndriftL(oD);
                    // The cloud that is DRAWN there (2026-10-05, user snap 1): the column's lowest and highest cloud
                    // (not rain, not the thin high layer) in 16 samples from the ground to above the tropopause.
                    // The type's base and top put storm-cell flashes kilometres above the cumulus drawn away from the
                    // towers: bolts on top of the weather. No deep cloud there, no flash.
                    float gnd  = cv2Ground(cv2UndriftL(oD));
                    float hHi  = cv2.types[4].alt.x + (cv2.types[4].alt.y - cv2.types[4].alt.x) * cv2Tropo(oD) + 1500.0;
                    float base = -1.0, topC = -1.0;
                    [[dont_unroll]] for (int k = 0; k < 16; ++k) {
                        float h  = mix(gnd + 150.0, hHi, (float(k) + 0.5) / 16.0);
                        CV2_CNT(12);
                        CV2Field cf = cv2Field(cv2Pos(oE * (R_EARTH + h) - eye, eyeH, enuToEcef), -1.0, 400.0);
                        if (cf.sigma * max(1.0 - cf.thin - cf.rain, 0.0) > 4e-4) {
                            if (base < 0.0) base = h;
                            topC = h;
                        }
                    }
                    if (base < 0.0 || topC - base < 1500.0) continue;
                    float oAlt = cg ? base + (topC - base) * (0.25 + 0.2 * (jg.x + 0.5))
                               : low ? base - 150.0
                                     : base + (topC - base) * (0.3 + 0.45 * (jg.y + 0.5));
                    vec3  aPos = oE * (R_EARTH + oAlt);
                    vec3  bPos = aPos;
                    if (cg) {
                        // The ground point: 1.5-9 km aside from the origin: a stroke leaves the cloud's flank and
                        // comes down slanted, sometimes well clear of the rain (a bolt from the blue).
                        vec2  gd = normalize(jg + vec2(1e-3)) * (1500.0 + 7500.0 * pow(float(ph.y >> 24u) / 255.0, 1.5));
                        vec3  gD = normalize(oD + (t1 * gd.x + t2 * gd.y) / R_EARTH);
                        vec3  gE = cv2UndriftL(gD);
                        bPos = (ecefToEnu * gE) * (R_EARTH + cv2Ground(gE));
                    }
                    uint slot = atomicAdd(sFlashN, 1u);
                    if (slot < kCv2FlashMax) {
                        cv2Flashes[slot].a = vec4(aPos, I);
                        cv2Flashes[slot].b = vec4(bPos, cg ? 1.0 : (low ? 3.0 : 0.0));
                        cv2Flashes[slot].c = vec4(uintBitsToFloat(cellH ^ (uint(int(sl) + 1000000) * 0x2545F491u) ^ (uint(m) * 0x9E3779B9u)),
                                                  uintBitsToFloat(ph.z ^ fh.z), age, length(aPos - eye));
                        cv2Flashes[slot].d = vec4(base, topC, fStr, dur);
                    }
                    // Now and then a strong ground stroke sets off a RED SPRITE ~75 km up a few ms later (kind 2; silent).
                    if (cg && cv2.misc2.x > 0.0) {
                        uvec3 sh = cv2Pcg3(fh ^ uvec3(0xA511E9B3u, 0x63D83595u, 0x2C1B3C6Du));
                        float sAge = age - kCv2LeaderS - 0.004;
                        if (float(sh.x & 0xFFFFu) / 65535.0 < cv2.misc2.x && sAge >= 0.0 && sAge < 0.3) {
                            float Is  = smoothstep(0.0, 0.012, sAge) * exp(-sAge / 0.07);
                            vec2  sj  = vec2(float(sh.y & 0xFFFFu), float(sh.y >> 16u)) / 65535.0 - 0.5;
                            vec3  sD  = normalize(fUp + (t1 * sj.x + t2 * sj.y) * (30000.0 / R_EARTH));
                            vec3  sP  = (ecefToEnu * cv2UndriftL(sD)) * (R_EARTH + 75000.0);
                            uint  s2  = atomicAdd(sFlashN, 1u);
                            if (s2 < kCv2FlashMax) {
                                cv2Flashes[s2].a = vec4(sP, Is);
                                cv2Flashes[s2].b = vec4(sP, 2.0);
                                cv2Flashes[s2].c = vec4(uintBitsToFloat(sh.z ^ 0x5B17E5u), uintBitsToFloat(sh.z),
                                                        sAge, length(sP - eye));
                                cv2Flashes[s2].d = vec4(50000.0, 90000.0, 1.0, 0.3);
                            }
                        }
                    }
                }
            }
        }
    }
    memoryBarrierBuffer();   // thread 1 reads the flashes (the light they throw on the rain at the eye)
    barrier();
    if (li == 0u) cv2FlashCount = min(sFlashN, kCv2FlashMax);
    // For the drops and crystals at the eye (review 4): the Sun's transmittance from the eye through the
    // clouds (24 steps, crowded near the eye), and the ice fog's extinction at the eye.
    if (li == 1u) {
        vec3  enuZ = normalize(pc.obsECEFDir.xyz);
        vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
        vec3  enuY = cross(enuZ, enuX);
        mat3  enuToEcef = mat3(enuX, enuY, enuZ);
        float eyeH = terrainFrame.x + 2.0;
        vec3  sunENU = transpose(enuToEcef) * cv2.sunE.xyz;
        // Review 22: out to 400 km (32 steps), and ungated by the horizon for the Sun DISC (cv2FlashPad2: the host
        // reads it back for the disc, its glare and lens flare and the bloom). Those were dimmed only by each pixel's
        // own clouds, and a ray toward a Sun on the horizon from under a storm runs out past the march's clouds: the
        // Sun shone through the overcast (user snap 2). Above the shell the half-res composite handles it (1).
        float sunT = 0.0, discT = 1.0;
        cv2SunProf[0] = 0.0;
        // The lattices' axes across the Sun, EVERY frame (2026-10-21, issue 20261021_002345): the cascade (on while the
        // march draws clouds, i.e. from orbit too), the shaft rings and the sky's god rays all read them. They were
        // written only with the eye inside the shell, so from orbit every lookup used the axes of the last place the
        // eye had been low (another observer's ENU frame, another Sun): the cascade mapped each cloud sample to a
        // wrong ray and knot, and a sharp-edged trapezoid of black, ray-streaked cloud stood under the eye (zero after
        // a fresh load at altitude: the cascade then silently did nothing from orbit).
        {
            vec3 ga, gb;
            cv2SunGridAxes(sunENU, ga, gb);
            cv2SunProf[2] = ga.x; cv2SunProf[3] = ga.y; cv2SunProf[4] = ga.z;
            cv2SunProf[5] = gb.x; cv2SunProf[6] = gb.y; cv2SunProf[7] = gb.z;
        }
        if (sunENU.z > -0.1 && eyeH < cv2.shell.y) {
            float L  = cv2SunGridLen(sunENU, cv2.shell.y);
            float od = 0.0;
            cv2SunProf[0] = L;
            for (int i = 0; i < 32 && od < 8.0; ++i) {
                float u0 = float(i) / 32.0, u1 = float(i + 1) / 32.0;
                float t  = L * (0.5 * (u0 + u1)) * (0.5 * (u0 + u1));
                float dt = L * (u1 * u1 - u0 * u0);
                CV2_CNT(13);
                od += cv2Field(cv2Pos(sunENU * t, eyeH, enuToEcef), 0.0, max(30.0, dt * 0.5)).sigma * dt;
            }
            discT = exp(-od);
        }
        if (sunENU.z > -0.02) sunT = discT * smoothstep(-0.02, 0.03, sunENU.z);
        float dS, fT, fH, dA, iceS = 0.0;
        cv2FogDust(cv2Pos(vec3(0.0), eyeH, enuToEcef), 1.0, dS, fT, fH, dA, iceS);
        cv2EyeSunT = floatBitsToUint(sunT);
        cv2FlashPad2 = floatBitsToUint(discT);
        cv2EyeIceS = floatBitsToUint(iceS);

        // ── The light on a rain drop at the eye (rain_particles.vert, 2026-10-04): the march's rain sample there.
        // Key light: the Sun through the clouds toward it (discT, the 400-km march above) and the Earth's shadow,
        // or the Moon at night (dimmed by the column above, at its slant). Ambient: the zenith sky through the
        // cloud above (two-stream diffuse transmission of the column's optical depth, as the march's ambVis) +
        // the ground and horizon (the march's 0.35) + the key light's bounce off the ground.
        {
            vec3  BETA_R  = BETA_R_BASE * cloud.atmosRayleighGain;   // as the march's
            float BETA_M  = BETA_M_BASE * cloud.atmosMieGain;
            vec3  eyeP    = vec3(0.0, 0.0, R_EARTH + eyeH);
            vec3  moonENU = normalize(pc.moonDirENU.xyz);
            float horizS  = -sqrt(max(1.0 - (R_EARTH / eyeP.z) * (R_EARTH / eyeP.z), 0.0));
            float sunUp   = sunENU.z;
            float sunVis  = smoothstep(horizS - 0.004, horizS + 0.004, sunUp);
            float dayness = clamp((sunUp + 0.2) / 0.5, 0.0, 1.0);
            float nightK  = 1.0 - min(dayness * 3.0, 1.0);
            float tauUp = 0.0;
            if (eyeH < cv2.shell.y) {
                float Lu = cv2.shell.y - eyeH;
                for (int i = 0; i < 12; ++i) {
                    float u0 = float(i) / 12.0, u1 = float(i + 1) / 12.0;
                    float t  = Lu * (0.5 * (u0 + u1)) * (0.5 * (u0 + u1));
                    float dt = Lu * (u1 * u1 - u0 * u0);
                    CV2_CNT(13);
                    tauUp += cv2Field(cv2Pos(vec3(0.0, 0.0, t), eyeH, enuToEcef), 0.0, max(30.0, dt * 0.5)).sigma * dt;
                }
            }
            const vec3 kMoonCol = vec3(0.92, 0.95, 1.0);   // == kMoonColor (cloud_v2_march.comp)
            vec3  moonKey = kMoonCol * pc.moonDirENU.w * cloud.moonGain * cv2.misc.y;
            vec3  key = vec3(0.0), kDir = sunENU;
            float isMoon = 0.0;
            vec3  sc = rlSunColorAt(eyeP, sunENU, BETA_R_BASE * cv2.atmo.x, BETA_M);
            if (sunVis > 0.0 && dot(sc, sc) > 0.0) {
                key = sc * sunVis * cv2.look2.y * discT;
                if (cloud.moonMisc.y > 0.5) key *= cloud.moonMisc.x;   // a solar eclipse: the Sun the eye sees
            } else if (nightK > 0.0) {
                key = moonKey * nightK * smoothstep(-0.05, 0.1, moonENU.z) * exp(-tauUp / max(moonENU.z, 0.2));
                kDir = moonENU; isMoon = 1.0;
            }
            float twi     = smoothstep(horizS - 0.12, horizS, sunUp) * (1.0 - smoothstep(horizS + 0.05, horizS + 0.25, sunUp));
            float skyDusk = smoothstep(horizS - 0.09, horizS + 0.04, sunUp);
            vec3  skyAmb  = rlSkyZenithAt(eyeP, sunENU, BETA_R, BETA_M) * skyDusk * cv2.look.w * (1.0 + cv2.atmo.y * twi)
                          + moonKey * nightK * 0.03 * max(moonENU.z, 0.0)
                          + kMoonCol * cloud.moonGain * cv2.misc.y * (0.2 * cloud.terrainErosion.z);
            if (cloud.moonMisc.y > 0.5) skyAmb *= cloud.moonMisc.x;
            vec3  amb = skyAmb * (0.7 / (1.0 + 0.11 * tauUp) + 0.35)
                      + key * max(kDir.z, 0.0) * 0.15 * cv2.look2.x;
            // City light at night, as the march's nightS on a rain sample (kCityUpwellStrength, cityBrightness: keep
            // in step with cloud_v2_march.comp): the street lights under a shower light its drops.
            if (dayness < 0.9) {
                vec3  dE  = normalize(pc.obsECEFDir.xyz);
                vec2  uv  = vec2((atan(dE.y, dE.x) + PI) / (2.0 * PI), (0.5 * PI - asin(clamp(dE.z, -1.0, 1.0))) / PI);
                vec3  cr  = textureLod(earthNightTex, uv, 3.0).rgb;
                float lum = dot(cr, vec3(0.2126, 0.7152, 0.0722));
                float raw = max(0.0, lum - 0.002);
                amb += (cr / max(lum, 0.001)) * (raw / (raw + 0.08)) * (1.0 - dayness) * 0.004 * cloud.ambientGain;
            }
            // The white balance sat_sky.frag divides the frame by (luminance-preserving, faded below ~11 deg of Sun):
            // the particles are drawn after the tonemap, so they take it here.
            // Lightning lights the drops: each flash's light at the eye (lightning.frag's boltGlow, by distance), x the
            // cloud-glow gain as the glow on the cloud. A close strike in a downpour lights every drop.
            {
                uint nF = min(sFlashN, kCv2FlashMax);
                vec3 eyeL = vec3(0.0, 0.0, R_EARTH + eyeH);
                for (uint k = 0u; k < nF; ++k) {
                    CV2Flash fl = cv2Flashes[k];
                    if (fl.b.w > 1.5 && fl.b.w < 2.5) continue;          // sprites: 75 km up
                    float d  = length(fl.a.xyz - eyeL);
                    float q2 = (d * d + 1.2e7) / 1.6e7;
                    amb += vec3(0.80, 0.86, 1.0) * fl.a.w * (pow(1.0 + q2, -1.5) + 0.04 / (1.0 + d * d / 2.25e8))
                         * cv2.lightning.y * 2.0;
                }
            }
            vec3 wbDiv = vec3(1.0);
            if (cloud.whiteBalance > 0.0) {
                float rW = R_EARTH + max(eyeH - 2.0, 0.0), cW = sunUp;
                vec3  sunW = exp(-(BETA_R * (atmColumnInf(rW, cW, H_R) * H_R) + BETA_M * 1.1 * (atmColumnInf(rW, cW, H_M) * H_M)));
                vec3  wb = sunW / max(dot(sunW, vec3(0.2126, 0.7152, 0.0722)), 1e-4);
                wbDiv = mix(vec3(1.0), clamp(wb, vec3(0.4), vec3(2.5)), cloud.whiteBalance * smoothstep(0.02, 0.2, cW));
            }
            float liq = smoothstep(-1.0, 2.5, cv2.precip.x);
            cv2RainKey    = vec4(key / wbDiv, isMoon);
            cv2RainKeyDir = vec4(kDir, liq);
            cv2RainAmb    = vec4(amb / wbDiv, tauUp);
            cv2RainMisc   = vec4(0.0);   // (the rain map is written by this dispatch's other workgroups: not readable here)
        }
    }
}
