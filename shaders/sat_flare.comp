// ── sat_flare.comp ────────────────────────────────────────────────────────────
// Compute shader: observer-side photometry. Finishes, IN PLACE, the compact list of
// pre-photometry GpuSatVisible records sat_orbit.comp appended this frame into screen-ready
// records for sat_point.vert. Dispatched INDIRECTLY (vkCmdDispatchIndirect on SatListBuf's
// dispatch args), so its cost scales with the number of above-horizon satellites, not the roster.
//
// Lighting overhaul Phase 1 (.plans/SAT_LIGHTING_PLAN.md): the reflectance model (Earth shadow,
// earthshine, specular/mirror/diffuse, eclipse tint) moved into sat_orbit.comp, and GpuSatInput
// (the 80-byte-per-satellite hand-off between the two passes) was deleted. What is left here is
// everything that depends on the observer's SKY rather than on the satellite: daylight/moonlight
// suppression, extinction, the light-pollution and beam-glow domes, the sun-relative ceiling, the
// visibility cull and the sprite size. It stays a separate dispatch because it reads
// beamGlowDome, which sat_orbit.comp builds with atomicMax across ALL satellites.
//
// Dispatch: one invocation per compact-list entry (local_size_x = 64).
//
// Per-invocation work (roughly in pipeline order):
//   1. Bounds         — the indirect dispatch rounds up to 64; entries past listCount exit
//   2. Highlight mode — fixed census dot for highlighted constellations
//   3. Daytime/moonlight suppression, atmospheric extinction, light-pollution + beam-glow domes
//   4. Soft brightness ceiling relative to the sun
//   5. Visibility cull — zero output if effectFlare < visThresh (saves vertex work)
//   6. Point size     — the shared point-source model (point_style.glsl); fainter than its
//                       limiting magnitude → an invisible record
//   7. Sky-glow bins + ocean-glint list
// ─────────────────────────────────────────────────────────────────────────────

#version 450

layout(local_size_x = 64) in;

// ── In/out: compact GpuSatVisible list (32 bytes each, std430), rewritten in place ─────
// Matches GpuSatVisible in SatelliteSim.h. On entry (appended by sat_orbit.comp):
//   highlight: flareIntensity < 0, rangeM = range (m)
//   lit:       flareIntensity = raw flux, rangeM = range (m), color already eclipse-tinted
// On exit every record holds its final meaning (ENU direction, effectFlare, tint, sprite px,
// range — the point draws write their depth from it, include/depth.glsl).
struct SatVisible {
    vec3  skyDir;         // unit vector in local ENU (x=East, y=North, z=Up)
    float flareIntensity; // [0, 1+] — 0 = invisible/clipped, >1 = bright flare
    uint  color;          // tint, packUnorm4x8 (alpha unused)
    float angularSize;    // point sprite size (pixels)
    float rangeM;         // distance to the object, m; 0 = at infinity (stars, planets)
    float meshPx;         // pre-photometry: model mesh diameter on screen (px), 0 = none (Phase 4d)
};
layout(set = 0, binding = 1) buffer SatVisibleBuf {
    SatVisible visible[];
};
// (Binding 0 was SatInputBuf — removed with GpuSatInput in Phase 1.)

// Satellite index of each compact slot — only needed here to spot the selected satellite.
layout(set = 0, binding = 9) readonly buffer SatVisibleIdxBuf {
    uint visibleSatIdx[];
};
// GpuSatListHeader — see sat_orbit.comp. This pass reads listCount and writes `selected` plus
// the selected satellite's raw pre-photometry values: the CPU copies the whole 80-byte header back
// every frame for selection tracking, the real visible-satellite count (compact slots are no
// longer addressable by satellite index) and the GPU-parity readout (benchmarking M2).
const uint  MESH_CAND_MAX = 64u;  // = kMaxMeshCandidates (SatelliteSim.h)
// Phase 4d: satellites the CPU draws as meshes this frame, with their sprite's remaining weight.
layout(set = 0, binding = 12) readonly buffer MeshKeepBuf {
    uint  keepCount;
    uint  keepPad0, keepPad1, keepPad2;
    uvec4 keepEntries[MESH_CAND_MAX + 1u]; // x = satellite, y = keep (float bits)
};
const float MESH_FADE_IN_PX = 1.5; // = SatelliteSim::kMeshFadeInPx / kMeshFullPx
const float MESH_FULL_PX    = 3.0;
layout(set = 0, binding = 10) buffer SatListBuf {
    uint listCount;
    uint dispatchX, dispatchY, dispatchZ;
    uint drawVertexCount, drawInstanceCount, drawFirstVertex, drawFirstInstance;
    SatVisible selected;
    float selectedRawFlux;    // pre-photometry flareIntensity (raw flux; < 0 = highlight mode)
    float selectedRangeM;     // pre-photometry rangeM (m)
    uint  selectedFound;      // 1 = the selection was in this frame's compact list
    uint  selectedPad;
    // Phase 4d mesh candidates (GpuSatListHeader::meshCand): x = satellite, y = fade bits,
    // z = effectFlare bits, w = sprite size bits.
    uint  meshCandCount;
    uint  meshCandPad0, meshCandPad1, meshCandPad2;
    uvec4 meshCand[MESH_CAND_MAX];
};

// ── Glow buffer — matches GpuGlowBuf ──────────────────────────────────────────
//   bins[64] sky glow histogram: floatBitsToUint(max effectFlare) per bin. Unrelated to, and
//   unaffected by, the flare architecture overhaul below.
// Zeroed each frame by vkCmdFillBuffer(sizeof(GpuGlowBuf)).
//
// (flareCount/flareEntries[FLARE_MAX] lived here — a capped atomic-append list of "bright"
// satellites that sat_sky.frag looped over PER SCREEN PIXEL to draw lens-flare coronas. Deleted:
// raising the cap enough to stop flicker with "100s" of simultaneously-bright Reflect-Orbital
// satellites made that per-pixel cost scale with it — measured to tank framerate to 24fps.
// Replaced by actually rendering every visible satellite (plus the sun) as a point into a small
// offscreen texture (flare_source.vert/.frag), blurred/streaked by flare_blur.comp — see
// FlareSourcePC's comment in SatelliteSim.h for the full design. flare_source.vert reads this
// shader's output the exact same way sat_point.vert always has.)
const float GLOW_THRESH  = 1.0;
layout(set = 0, binding = 2) buffer GlowBuf {
    uint  bins[64];
};

// ── Ocean-glint list — matches GpuOceanGlintBuf (flare architecture overhaul) ────────────────
// A small, INDEPENDENT capped atomic-append list — same pattern the old flareEntries used, just
// decoupled from corona rendering and much smaller (128, not 256): ocean specular glint is a minor
// highlight effect, not the primary visibility signal. Zeroed each frame by vkCmdFillBuffer.
// Bumped 32->128 (session): with >32 bright satellites in view the list overflowed every frame,
// and which 32 of the candidates won their atomicAdd race was unstable frame-to-frame (no sort by
// brightness, pure first-come-first-served) — that instability is what read as ocean glint flicker.
const float OCEAN_GLINT_THRESH = 1.0;
const uint  OCEAN_GLINT_MAX    = 512; // must match kMaxOceanGlints in SatelliteSim.h and
                                        // kOceanGlintMax in sat_sky.frag exactly.
layout(set = 0, binding = 8) buffer OceanGlintBuf {
    uint oceanGlintCount;
    uint oceanGlintPad[3];
    vec4 oceanGlintEntries[OCEAN_GLINT_MAX]; // xyz=ENU dir, w=effectFlare
};

// ── Light pollution dome — 16 azimuth sectors (22.5° each), interpolated between sector
// centers below rather than hard-binned. CPU-written each frame in
// SatelliteSim::updateLightPollutionDome() from earthNightCpu samples around the observer;
// host-visible + coherent, no barrier needed (mirrors reflectorTargetsBuf's established pattern).
// Values are intentionally NOT pre-clamped to [0,1] — see the clamp comment at the use site.
layout(set = 0, binding = 3) readonly buffer LightDomeBuf {
    float lightDome[16];
};

// C12 follow-up #31: beam-driven sky-glow suppression dome — parallel to LightDomeBuf above but
// populated by ACTIVE Reflect-Orbital beams (sat_orbit.comp, atomicMax per sector) instead of a
// static night-lights texture. Stored as raw atomicMax'd uint bit-patterns (floatBitsToUint on
// the write side) — reinterpret via uintBitsToFloat here, NOT a direct float read. Deliberately a
// SEPARATE buffer from LightDomeBuf, not merged — two independent phenomena, same consumption
// shape.
layout(set = 0, binding = 4) readonly buffer BeamGlowDomeBuf {
    uint beamGlowDome[16];
};

// ── Push constants ────────────────────────────────────────────────────────────
// GLSL std430 vec3 alignment = 16.  Offsets verified against C++ SatFlarePC.
layout(push_constant) uniform PC {
    vec4  enuX;            // East  basis in ECI (w unused) — offset 0
    vec4  enuY;            // North basis in ECI (w unused) — offset 16
    vec4  enuZ;            // Up    basis in ECI (w unused) — offset 32
    vec3  sunDirECI;       // unit vector from Earth toward Sun — offset 48
    uint  satCount;        // — offset 60
    vec3  obsECI;          // observer ECI position (meters) — offset 64
    uint  selectedSatIdx;  // satellite index to mirror into SatListBuf.selected, 0xFFFFFFFF =
                           // none (was elevCutoff, then pad2) — offset 76
    float meshSatIdx;      // Phase 4c: satellite drawn as a mesh (-1 none) — offset 80
    float daySuppression;  // sky background suppression ratio — offset 84
    float meshSpriteKeep;  // Phase 4c: that satellite's sprite weight (1 - mesh fade) — offset 88
    float visThresh;       // visibility cull threshold — offset 92
    float highlightFlare;  // fixed flare for census highlight mode — offset 96
    float extinctionCoeff; // atmospheric extinction, magnitudes per airmass — offset 100
    float moonSuppression; // sky background suppression ratio from moonlight — offset 104
    float pad0;            // reserved — offset 108
    vec3  moonDirECI;      // unit vector from Earth toward Moon in ECI — offset 112
    float sunRefIntensity; // was pad1 — S3: soft brightness ceiling relative to the sun — offset 124
} pc;

// ── Constants ─────────────────────────────────────────────────────────────────
const float R_EARTH      = 6371000.0;   // Earth radius (meters)

#include "atmosphere.glsl"              // atmExtinctionMag — shared with stars, planets, Milky Way
#define POINT_STYLE_BINDING 11          // pointStyleBuf — the point-source model sat_point.frag draws with
#include "point_style.glsl"

// ── Reflectance model / brightness scale / mirror peak ────────────────────────
// All in sat_orbit.comp now (distance falloff, eclipse cones, earthshine, the two-surface
// specular model, MIRROR_BOOST, BRIGHTNESS_SCALE). BRIGHTNESS_SCALE = 1.0 is still the calibrated
// baseline: a Starlink at 550 km with only its diffuse floor active produces effectFlare ≈ 0.008
// (right at VIS_THRESH) ≈ apparent magnitude 6.0. kBrightnessScale in SatelliteSim.cpp must
// mirror it so the CPU-side magnitude readout stays consistent with the GPU render.

// ── Magnitude calibration ─────────────────────────────────────────────────────
// Apparent magnitude is derived from effectFlare via the photometric scale:
//   magnitude = MAG_REF - 2.5 × log₁₀(effectFlare / MAG_REF_FLARE)
//
// Anchor: Starlink Gen1 at 550 km in steady state (diffuse floor only):
//   effectFlare ≈ 0.008  →  magnitude ≈ 6.0  (at BRIGHTNESS_SCALE = 1)
//
// Selected reference points (BRIGHTNESS_SCALE = 1):
//   effectFlare = 0.008  → mag 6.0   (naked-eye limit, steady-state LEO sat)
//   effectFlare = 0.025  → mag 5.0   (easily naked-eye, mild specular)
//   effectFlare = 0.25   → mag 3.5   (notable flare, easily seen)
//   effectFlare = 1.0    → mag 1.5   (spectacular flare, rivals bright stars)
//   effectFlare = 8.0    → mag -0.3  (Iridium-class extreme flare)
//
// The magnitude is computed on the CPU (updatePositions) using the same
// formula and reported as "peak magnitude" in the UI readout.
const float MAG_REF_FLARE = 0.008;
const float MAG_REF       = 12.0;

// ── Daytime sky suppression ───────────────────────────────────────────────────
// Models sky background glare washing out dim satellites.
//
// dayBright ramp: squared, from sun elevation ≈ −3° to +20°.
//   Squaring means brightness rises slowly near the terminator (gradual twilight)
//   and faster once the sun is well up — matching real sky brightness behaviour.
//   At the terminator itself (sunElev≈0) dayBright ≈ 0.02, so barely any
//   suppression and satellites remain visible as they cross into daylight.
//
// BRIGHTNESS_SCALE is NOT in the denominator.  flare already contains it in the
// numerator; adding it here too would cancel it, making bright flares no more
// survivable than dim ones.  Only the physical sky contrast ratio belongs here.
//
// Calibration at full day (dayBright=1, BRIGHTNESS_SCALE=6):
//   denominator = 151
//   Starlink diffuse floor   (flare ≈ 0.048): effectFlare ≈ 0.0003 → invisible ✓
//   Starlink peak Phong      (flare ≈ 0.6  ): effectFlare ≈ 0.004  → invisible ✓
//   Starlink mirror peak     (flare ≈ 30   ): effectFlare ≈ 0.20   → visible   ✓
//   ISS mirror peak          (flare ≈ 480  ): effectFlare ≈ 3.2    → brilliant ✓
// DAY_SUPPRESSION is now pc.daySuppression

// Final write of one compact entry, plus the selected-satellite mirror.
void emit(uint idx, SatVisible v) {
    visible[idx] = v;
    if (visibleSatIdx[idx] == pc.selectedSatIdx) selected = v;
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= listCount) return;

    SatVisible sat = visible[idx];

    // GPU parity (M2): the selection's values exactly as sat_orbit.comp produced them, before this
    // pass rewrites the record in place.
    if (visibleSatIdx[idx] == pc.selectedSatIdx) {
        selectedRawFlux = sat.flareIntensity;
        selectedRangeM  = sat.rangeM;
        selectedFound   = 1u;
    }

    vec3  skyDir = sat.skyDir;
    float range  = sat.rangeM;      // range to the satellite (meters)

    // ── Highlight mode: fixed-brightness census view ─────────────────────────
    // sat_orbit.comp flags highlighted constellations with a negative flareIntensity. Skip all
    // lighting math and emit a uniform dot so every above-horizon satellite is equally visible
    // regardless of shadow or daytime sky.
    if (sat.flareIntensity < 0.0) {
        float angSize = pointSpriteSizePx(pointPsf(satFlareToMag(pc.highlightFlare)).y);
        emit(idx, SatVisible(skyDir, pc.highlightFlare, sat.color, angSize, range, 0.0));
        return;
    }

    float flare = sat.flareIntensity;

    // ── Daytime sky suppression ───────────────────────────────────────────────
    // sunElev = sin(sun elevation angle above observer's horizon).
    // Ramp: squared linear from −3° (sunElev≈−0.05) to +20° (sunElev≈0.34).
    //   At the terminator (sunElev=0): t=0.13, dayBright≈0.017 → ~2.5% suppression.
    //   At +20° sun elevation:         t=1.0,  dayBright=1.0   → full suppression.
    // Squaring gives a slow start (gentle twilight glow) and faster mid-day ramp.
    // atmFrac: how much of the bright sky is still around the observer — the stars' and Milky
    // Way's gate (updateStars(), sat_sky.frag): full through the flyable atmosphere, fading over
    // 40-100 km. It was exp(-h / 80 km), which kept 29% of the daytime dimming at 100 km and
    // treated satellites differently from the stars around them.
    float sunElev     = dot(pc.sunDirECI, normalize(pc.obsECI));
    float t           = clamp((sunElev + 0.05) / 0.39, 0.0, 1.0);
    float dayBright   = t * t;
    float obsHeight   = max(0.0, length(pc.obsECI) - R_EARTH);
    float atmFrac     = 1.0 - clamp((obsHeight - 40000.0) / 60000.0, 0.0, 1.0);

    // ── Moonlight sky suppression ───────────────────────────────────────────
    // Same shape as dayBright above (elevation ramp × atmFrac), scaled by moon phase
    // illumination since a crescent moon brightens the sky far less than a full moon.
    // Uniform across the sky (not direction-dependent) — same simplification dayBright
    // already makes; a real light-dome/near-moon-halo model is future scope.
    // moonElev uses the same "dot with observer zenith" trick as sunElev above.
    float moonElev    = dot(pc.moonDirECI, normalize(pc.obsECI));
    float moonIllum   = (1.0 - dot(pc.sunDirECI, pc.moonDirECI)) * 0.5; // 0=new, 1=full
    float tm          = clamp(moonElev / 0.5, 0.0, 1.0); // ramps horizon → ~30° elevation
    float moonBright  = tm * tm * moonIllum;

    float effectFlare = flare / (1.0 + (dayBright * pc.daySuppression
                                       + moonBright * pc.moonSuppression) * atmFrac);

    // ── Atmospheric extinction ────────────────────────────────────────────────
    // The air on THIS sightline, observer to satellite (atmosphere.glsl): from sea level the full
    // zenith extinction plus the long low-elevation path, from a mountain or an aircraft
    // correspondingly less, from orbit only what a limb-grazing sightline crosses — and a
    // satellite silhouetted in front of Earth from orbit gets only the segment that reaches it.
    // Also the light-pollution dome's smooth baseline (without it the dome's sector transitions
    // read as pops). The ECI line of sight is rebuilt from the ENU sky direction (the ENU basis
    // rows are an orthonormal ECI frame) — the relative position no longer reaches this pass.
    vec3  losECI = skyDir.x * pc.enuX.xyz + skyDir.y * pc.enuY.xyz + skyDir.z * pc.enuZ.xyz;
    float extinctMag = atmExtinctionMag(pc.obsECI, losECI, range, pc.extinctionCoeff);
    effectFlare *= pow(10.0, -0.4 * extinctMag);

    // Light pollution: dims (scales down) rather than culls — matches the observation that
    // scaling brightness reads as more convincing than pushing satellites past visThresh.
    // Directional dome: lightDome[] holds unclamped city-brightness values sampled around the
    // observer in 16 compass sectors (computed CPU-side in SatelliteSim::updateLightPollutionDome).
    // Interpolated between the two nearest sector CENTERS (not hard-binned) — 16 discrete wedges
    // still showed visible blocky transitions over wide, fairly uniform bright regions.
    float azLP = mod(atan(skyDir.x, skyDir.y) + 6.283185307, 6.283185307);
    float secF = azLP * (16.0 / 6.283185307) - 0.5;
    int   sec0 = int(floor(secF));
    float secFrac = secF - float(sec0);
    int   sec0w = ((sec0 % 16) + 16) % 16;
    int   sec1w = (sec0w + 1) % 16;
    float domeAz = mix(lightDome[sec0w], lightDome[sec1w], secFrac);
    // 0.35 (not 0.15): the steeper curve crushed the effect to near-zero above ~20° elevation —
    // most satellites/stars a user actually looks at aren't sitting right on the horizon.
    float elevFalloff = 0.35 / (max(skyDir.z, 0.0) + 0.35); // 1.0 at horizon, ~0.26 at zenith
    // domeAz is intentionally unclamped upstream — the clamp only happens here, after elevFalloff,
    // so high lightPollutionGain can compensate for elevFalloff's reduction at non-horizon angles
    // instead of saturating uselessly before elevFalloff is even applied (session 26 bug).
    // S2c (RELEASE_v1_1_PLAN.md): elevFalloff alone bottoms out at ~0.26 at zenith, so a satellite
    // straight overhead could never be dimmed by more than ~26% no matter how bright the city —
    // wrong, since real urban skyglow raises zenith brightness enormously (isotropic scattered
    // component, not just the horizon-hugging direct-view glow elevFalloff models). kIsotropicFrac
    // gives the dome a real floor at zenith while leaving horizon behaviour unchanged. Same
    // constant/formula in sat_sky.frag (Milky Way + ground stars) and cloud_march.comp (aurora) —
    // keep them coherent, this IS the "same array, coherent by construction" property.
    const float kIsotropicFrac = 0.4;
    float domeVal = clamp(domeAz * (kIsotropicFrac + (1.0 - kIsotropicFrac) * elevFalloff), 0.0, 1.0);
    // kSatPollutionMaxDim caps how dark it can go so the brightest flares/mirrors still peek
    // through even in a maximally lit city.
    const float kSatPollutionMaxDim = 0.85;
    effectFlare *= 1.0 - domeVal * kSatPollutionMaxDim;

    // C12 follow-up #31: same suppression shape, second independent source — a nearby
    // Reflect-Orbital beam should wash out this satellite the same way real light pollution does.
    // beamGlowDome[] holds raw atomicMax'd uint bit-patterns (floatBitsToUint on the write side in
    // sat_orbit.comp) — reinterpret via uintBitsToFloat before using, unlike lightDome[] which is
    // a plain float buffer.
    float beamDomeAz = mix(uintBitsToFloat(beamGlowDome[sec0w]), uintBitsToFloat(beamGlowDome[sec1w]), secFrac);
    float beamDomeVal = clamp(beamDomeAz * elevFalloff, 0.0, 1.0);
    const float kBeamPollutionMaxDim = 0.85;
    effectFlare *= 1.0 - beamDomeVal * kBeamPollutionMaxDim;

    // ── Soft brightness ceiling relative to the sun (S3, RELEASE_v1_1_PLAN.md) ───────────────
    // Root cause of "reflector out-shines the sun": the flare-source pass (flare_source.vert)
    // injects the sun as a virtual point at a FIXED pc.sunRefIntensity, while effectFlare above is
    // otherwise unbounded — a favourably-angled mirror can exceed it outright. Reinhard-style
    // rolloff: nothing can ever render brighter than the sun, ordering between satellites is fully
    // preserved (monotonic in effectFlare), and the low end is untouched — at effectFlare ≪
    // sunRefIntensity, effectFlare' ≈ effectFlare, so ordinary Starlink-class flares are unaffected.
    effectFlare = pc.sunRefIntensity * effectFlare / (effectFlare + pc.sunRefIntensity);

    // ── Cull if below visibility threshold ────────────────────────────────────
    // The entry stays in the list as an invisible record — sat_point.vert discards it.
    if (effectFlare < pc.visThresh) {
        emit(idx, SatVisible(vec3(0.0, 0.0, 1.0), 0.0, 0u, 0.0, 0.0, 0.0));
        return;
    }

    // ── Point size ───────────────────────────────────────────────────────────
    // From the apparent magnitude, through the point-source model the fragment shader draws with
    // (point_style.glsl) — the same one stars and planets use, so equal magnitudes look equal.
    // (Until 2026-09-23 this was its own log-of-effectFlare curve with a range-dependent base.)
    // ── Phase 4c/4d: sprite → mesh hand-off ─────────────────────────────────
    // A model satellite whose mesh spans MESH_FADE_IN_PX..MESH_FULL_PX fades out of every
    // sprite-side effect — its point, its sprite bloom, the sky-glow bins, the ocean-glint list — as
    // its mesh fades in, and is listed for the CPU to draw (next frame, in double). Its final flux and
    // sprite size are recorded first: the mesh's glints seed exactly the bloom this sprite would have
    // (SatMeshRenderer::recordBloom), so a flare keeps its punch across the hand-off. The followed
    // satellite is the CPU's own (always drawn, even in Earth's shadow): SatFlarePC carries its fade.
    // Nominated (sat.meshPx over the threshold, with a margin) → listed for NEXT frame's draw; the
    // sprite's weight THIS frame is whatever the CPU drew it with this frame (MeshKeepBuf), so the two
    // always agree. The followed satellite comes through the same list.
    if (sat.meshPx > MESH_FADE_IN_PX * 0.8) {
        uint satI = visibleSatIdx[idx];
        uint slot = atomicAdd(meshCandCount, 1u);
        if (slot < MESH_CAND_MAX) {
            float fullSize = pointSpriteSizePx(pointPsf(satFlareToMag(effectFlare)).y);
            meshCand[slot] = uvec4(satI, floatBitsToUint(sat.meshPx), floatBitsToUint(effectFlare),
                                   floatBitsToUint(fullSize));
        }
        uint n = min(keepCount, MESH_CAND_MAX + 1u);
        for (uint k = 0u; k < n; ++k)
            if (keepEntries[k].x == satI) {
                effectFlare *= uintBitsToFloat(keepEntries[k].y);
                // Its remaining sprite overlaps its own mesh, whose surface is nearer than the centre by
                // up to the model's radius (< 1% of the range while any sprite is left at 10 px) — draw
                // it at 98% of the range so the depth test keeps it in front of its own model.
                range *= 0.98;
                break;
            }
    }

    vec2  psf     = pointPsf(satFlareToMag(effectFlare));
    float angSize = pointSpriteSizePx(psf.y);

    // ── Sky glow: bin this satellite (stable, no flicker) ────────────────────
    if (effectFlare >= GLOW_THRESH) {
        const float TWO_PI = 6.28318530718;
        float az   = mod(atan(skyDir.x, skyDir.y) + TWO_PI, TWO_PI);
        uint azBin = uint(az * (8.0 / TWO_PI)) & 7u;
        uint elBin = min(uint(max(skyDir.z, 0.0) * 8.0), 7u);
        atomicMax(bins[azBin * 8u + elBin], floatBitsToUint(effectFlare));
    }

    // ── Ocean-glint list: capped atomic-append, no arbitration ──────────────
    // Every satellite above OCEAN_GLINT_THRESH claims its OWN slot — same pattern the deleted
    // flareEntries list used, just scoped to this one small, independent consumer now.
    if (effectFlare >= OCEAN_GLINT_THRESH) {
        uint slot = atomicAdd(oceanGlintCount, 1u);
        if (slot < OCEAN_GLINT_MAX) {
            oceanGlintEntries[slot] = vec4(skyDir, effectFlare);
        }
    }

    // ── Output ───────────────────────────────────────────────────────────────
    // Fainter than the point model's limiting magnitude: nothing to draw (the sky glow and ocean
    // glint above have their own, brighter thresholds). An invisible record costs no fill.
    if (psf.x <= 0.0) {
        emit(idx, SatVisible(vec3(0.0, 0.0, 1.0), 0.0, 0u, 0.0, 0.0, 0.0));
        return;
    }
    // baseColor was already eclipse-tinted by sat_orbit.comp.
    emit(idx, SatVisible(skyDir, effectFlare, sat.color, angSize, range, 0.0));
}
