#version 450
#extension GL_EXT_control_flow_attributes : enable
// ── The beam light volume's bake (2026-11-24; include/beam_vol.glsl) ──────────────────────────────────────────────────
// Five dispatches a frame, after the lightning pass, before the march (same descriptor set and push constants):
//   kMode 0  DENSITY: the cloud's extinction at each cell of each site's box (the field at the cell's footprint: the
//            cloud's mean over the cell, what a shadow that coarse needs), a quarter of the boxes' z slabs a frame, into
//            plane 1's z.
//   kMode 1  RAY MAPS: each beam's own shadow. kBvRays x kBvRays rays parallel to the beam across its disk, each marched
//            DOWN the beam (from the box's top toward the ground) through the density, keeping the optical depth above
//            each of the box's z levels. A beam from 30 deg elevation and one from 70 deg see different cloud.
//   kMode 2  GATHER: each cell sums the beams whose disk covers it (a workgroup culls the site's beams to its block
//            first): the disk's irradiance x e^-(that beam's optical depth at the cell), the irradiance-weighted direction
//            toward the satellites, and (plane 1) the in-scatter toward the EYE with each beam at its own angle (the air's
//            Mie lobe, the clouds' two HG lobes). Written to the light volume the march (clouds), the shafts and the sky
//            pass (ground, sea) read.
//   kMode 4  GROUND: the volume at the terrain's height, per box column, for the sky pass (flash buffer).
//   kMode 3  SHAFTS: the beams' air along the view, a screen-tile x log-depth volume the march reads.
layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(constant_id = 2) const uint kMode = 0u;

layout(push_constant) uniform PC {        // == CloudMarchPC (cloud_v2_march.comp)
    mat4  skyView;
    float fovYRad;
    float aspect;
    float waveTime;
    float obsEffH;
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;
} pc;

#define CLOUD_PARAMS_BINDING 0
#include "cloud_params.glsl"
#include "common.glsl"
#define CV2_PARAMS_BINDING  1
#define CV2_MORPH_BINDING   20
#define CV2_WEATHER_BINDING 2
#define CV2_SHAPE_BINDING   3
#define CV2_DETAIL_BINDING  4
#define CV2_MESO_BINDING    5
#define CV2_ELEV_BINDING    25
#define CV2_STORM_BINDING   26
#include "clouds_v2.glsl"
layout(std430, set = 0, binding = 8) buffer TerrainFrame { vec4 terrainFrame; };
#define BEAM_CLOUD_LIGHTS_BINDING 9
#include "beam_cloud_lights.glsl"
#include "beam_vol.glsl"
#define CV2_FLASH_BINDING 12
#define CV2_FLASH_WRITE
#include "cloud_lightning.glsl"   // cv2BvGround / cv2BvHdr (kMode 4)
#include "atmosphere.glsl"        // atmColumn (kMode 3)
#include "cv2_optics.glsl"        // cv2HG (kMode 2)

// The light volume: 2 x kBvNX wide (plane 0 | plane 1, beam_vol.glsl), kBvNY, kBvNZ x kBvSites deep.
layout(set = 0, binding = 29, rgba16f) uniform image3D bvLightImg;
layout(set = 0, binding = 30) uniform sampler3D bvLightTex;
layout(std430, set = 0, binding = 31) buffer BvMapBuf { uint bvMap[]; };   // [beam][kBvNZ / 2][ray] packHalf2x16
layout(set = 0, binding = 32, rgba16f) uniform writeonly image3D bvShaftImg;

const uint kBvRayN = uint(kBvRays * kBvRays);   // rays a beam (a knot pair's rays are adjacent: coalesced writes, and
                                                // the gather's bilinear reads share lines)

// The terrain's height (m above sea level) under an observer-relative point: the elevation map (terrain.glsl's encoding:
// 15/255 of 9000 m is sea level), ~2.7 km pixels: the ranges, not single peaks.
float bvTerrainH(vec3 rel, float eyeH, mat3 enuToEcef)
{
    vec3  d   = cv2Pos(rel, eyeH, enuToEcef).dirE;
    float lat = asin(clamp(d.z, -1.0, 1.0)), lon = atan(d.y, d.x);
    vec2  uv  = vec2((lon + PI) / (2.0 * PI), (0.5 * PI - lat) / PI);
    return max(textureLod(cv2ElevTex, uv, 0.0).r * 9000.0 - 15.0 / 255.0 * 9000.0, 0.0);
}

// The site a beam belongs to (the sites' beam ranges are contiguous).
uint bvSiteOfBeam(uint b)
{
    for (uint s = 0u; s < kBvSites; ++s)
        if (b >= uint(bvSites[s].ax.w) && b < uint(bvSites[s].ax.w) + uint(bvSites[s].ay.w)) return s;
    return 0u;
}

// A 4 x 4 block of columns (block index bxy): its centre and half diagonal in the box's x / y (the columns are warped).
void bvBlockXY(uvec2 bxy, out vec2 cen, out float rad)
{
    vec2 lo = vec2(bvUnwarp(float(bxy.x * 4u) / float(kBvNX)), bvUnwarp(float(bxy.y * 4u) / float(kBvNY)));
    vec2 hi = vec2(bvUnwarp(float(bxy.x * 4u + 4u) / float(kBvNX)), bvUnwarp(float(bxy.y * 4u + 4u) / float(kBvNY)));
    cen = 0.5 * (lo + hi);
    rad = 0.5 * length(hi - lo);
}

const uint kBvListMax = 256u;   // beams a 4 x 4 x 4 block keeps (past it, the rest are dropped; 12 KB of shared memory)
shared uint sBeamN;
shared vec4 sBg[kBvListMax];    // xyz ground point, w irradiance
shared vec4 sBd[kBvListMax];    // xyz direction, w R
shared vec4 sBe1[kBvListMax];   // xyz across-beam basis 1, w the beam's index

// The site's beams whose disk can reach this block (centre Lb, radius rb) into shared memory; returns their count.
uint bvCullBlock(uint s, vec3 Lb, float rb)
{
    uint b0 = uint(bvSites[s].ax.w), nb = min(uint(bvSites[s].ay.w), kBvMaxBeams);
    if (gl_LocalInvocationIndex == 0u) sBeamN = 0u;
    barrier();
    for (uint i = gl_LocalInvocationIndex; i < nb; i += 64u) {
        uint  b = b0 + i;
        vec3  g = bvBeams[b].g.xyz, d = bvBeams[b].d.xyz;
        vec3  rel = Lb - g;
        vec3  perp = rel - d * dot(rel, d);
        float R = max(bvBeams[b].d.w, 100.0);
        float cut = kBvDiskCut * R + rb;
        if (dot(perp, perp) < cut * cut && bvBeams[b].g.w > 0.0) {
            uint slot = atomicAdd(sBeamN, 1u);
            if (slot < kBvListMax) {
                vec3 e1, e2;
                bvBasis(d, e1, e2);
                sBg[slot] = bvBeams[b].g; sBd[slot] = vec4(d, R); sBe1[slot] = vec4(e1, float(b));
            }
        }
    }
    barrier();
    return min(sBeamN, kBvListMax);
}

// The beams' air along a stretch [t0, t1] of a view ray in closed form (per unit irradiance): Rayleigh + aerosol, each
// integrated over the height along the stretch (exact for a height linear in t), at the beam's angle to the view
// (cosine b), x the night share and the air's extinction to the stretch's middle (tq, returned).
vec3 bvColumnLight(vec3 eye, vec3 dir, float t0, float t1, float b, vec3 BETA_R, float BETA_M, out float tq)
{
    float h0 = length(eye + dir * t0) - R_EARTH, h1 = length(eye + dir * t1) - R_EARTH;
    float len = t1 - t0;
    tq = 0.5 * (t0 + t1);
    vec3  X  = eye + dir * tq;
    float dayP = clamp((dot(normalize(X), pc.sunDirENU.xyz) + 0.2) / 0.5, 0.0, 1.0);
    float ca = exp(-max(h0, 0.0) / H_R), cb = exp(-max(h1, 0.0) / H_R), dh = (h1 - h0) / H_R;
    float colR = abs(dh) < 1e-3 ? len * 0.5 * (ca + cb) : len * (ca - cb) / dh;
    ca = exp(-max(h0, 0.0) / H_M); cb = exp(-max(h1, 0.0) / H_M); dh = (h1 - h0) / H_M;
    float colM = abs(dh) < 1e-3 ? len * 0.5 * (ca + cb) : len * (ca - cb) / dh;
    vec3  sc = BETA_R * colR * phaseR(b) + vec3(BETA_M * cv2.beam.y * colM * phaseM(b));
    vec3  tau = BETA_R * (H_R * atmColumn(eye, dir, tq, H_R)) + vec3(BETA_M * 1.1 * H_M * atmColumn(eye, dir, tq, H_M));
    return sc * (1.0 - dayP) * exp(-tau);
}

// The clouds' reference phase for plane 1's y (the march's two HG lobes, cv2.phase; beamFinish scales its own phase at
// the mean direction by this sum over the beams / this at the mean direction).
float bvCloudPhase(float c) { return cv2.phase.y * cv2HG(c, cv2.phase.x) + cv2.phase.w * cv2HG(c, cv2.phase.z); }

void main()
{
    vec3  enuZ = normalize(pc.obsECEFDir.xyz);
    vec3  enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    mat3  enuToEcef = mat3(enuX, cross(enuZ, enuX), enuZ);
    float eyeH = terrainFrame.x + 2.0;

    if (kMode == 4u) {   // (runs with no site too: the frame after the last one clears the headers)
        // ── GROUND ── (one thread a column of a slot: the light volume at the terrain's height there, for the sky pass)
        uint id = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
        uint s = id / uint(kBvNX * kBvNY), cI = id - s * uint(kBvNX * kBvNY);
        if (s >= kBvSites) return;
        if (cI == 0u) {
            bool ok = s < bvSiteCount && bvSites[s].o.w > 0.5;
            cv2BvHdr[s * 4u]      = vec4(bvSites[s].o.xyz, ok ? 1.0 : 0.0);
            cv2BvHdr[s * 4u + 1u] = vec4(bvSites[s].ax.xyz, 0.0);
            cv2BvHdr[s * 4u + 2u] = vec4(bvSites[s].ay.xyz, 0.0);
            cv2BvHdr[s * 4u + 3u] = vec4(bvSites[s].az.xyz, 0.0);
        }
        if (s >= bvSiteCount || bvSites[s].o.w < 0.5) { cv2BvGround[id] = uvec2(0u); return; }
        vec2  xy  = bvColCentre(vec2(float(cI % uint(kBvNX)), float(cI / uint(kBvNX))));
        vec3  rel = bvSites[s].o.xyz + bvSites[s].ax.xyz * xy.x + bvSites[s].ay.xyz * xy.y;
        float h0  = length(rel + vec3(0.0, 0.0, R_EARTH + eyeH)) - R_EARTH;   // the box's z = 0 here, above sea level
        float gH  = bvTerrainH(rel, eyeH, enuToEcef);   // the terrain (the sea: 0)
        vec4  v   = textureLod(bvLightTex, bvUVW(s, vec3(xy, gH - h0 + 30.0)), 0.0);
        // (y's high half: the terrain's height in the box's z, for the next frame's ray maps: kMode 1 reads it, no trig)
        cv2BvGround[id] = uvec2(packHalf2x16(vec2(v.y, v.z)), packHalf2x16(vec2(v.w, gH - h0)));
        return;
    }

    if (bvSiteCount == 0u) return;
    if (kMode == 3u) {
        // ── SHAFTS ── (one thread a screen tile's column: front to back over the depth slices, sampling only where the view
        // ray is inside a site's box (slab test per box), up to 8 steps of >= 750 m a slice and box; the cloud along the VIEW
        // is the march's, which reads this at its transmittance checkpoints)
        uint col = gl_WorkGroupID.x * 64u + gl_LocalInvocationIndex;
        if (col >= uint(kBvShX * kBvShY)) return;
        ivec2 g = ivec2(int(col) % kBvShX, int(col) / kBvShX);
        vec2  ndc = (vec2(g) + 0.5) / vec2(kBvShX, kBvShY) * 2.0 - 1.0;
        float th  = tan(pc.fovYRad * 0.5);
        vec3  dir = normalize(mat3(transpose(pc.skyView)) * vec3(ndc.x * th * pc.aspect, -ndc.y * th, -1.0));
        vec3  eye = vec3(0.0, 0.0, R_EARTH + eyeH);
        vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
        float BETA_M = BETA_M_BASE * cloud.atmosMieGain;
        float pixAng = 2.0 * th / float(kBvShY);
        // Each box's interval along the ray (its walls a column in: where the volume's light ends).
        vec2 iv[kBvSites];
        for (uint q = 0u; q < kBvSites; ++q) {
            iv[q] = vec2(1e30, -1e30);
            if (q >= bvSiteCount || bvSites[q].o.w < 0.5) continue;
            vec3 v  = -bvSites[q].o.xyz;
            vec3 r0 = vec3(dot(v, bvSites[q].ax.xyz), dot(v, bvSites[q].ay.xyz), dot(v, bvSites[q].az.xyz));
            vec3 rd = vec3(dot(dir, bvSites[q].ax.xyz), dot(dir, bvSites[q].ay.xyz), dot(dir, bvSites[q].az.xyz));
            vec3 inv = 1.0 / (rd + vec3(1e-9));
            vec3 ta = (vec3(-kBvInner, -kBvInner, kBvZ0) - r0) * inv, tb = (vec3(kBvInner, kBvInner, kBvZ1) - r0) * inv;
            vec3 tn = min(ta, tb), tf = max(ta, tb);
            float t0 = max(max(tn.x, tn.y), max(tn.z, 0.0)), t1 = min(min(tf.x, tf.y), tf.z);
            if (t1 > t0) iv[q] = vec2(t0, t1);
        }
        // PAST the boxes (no cloud there, or none the volume holds): each beam's column wherever the view ray is outside
        // its box (above the top, past a wall), up to 60 km, in closed form, deposited at the light-weighted mean depth. Seen
        // from orbit the beams' air above 15 km is most of their streak. (Until round 2 this was the merged cluster lights
        // from the box's TOP: a low beam's air between a wall and the top was nobody's, and the clusters' sum was not the
        // volume's: the box's outline in the sky, issue_20261124_085028.)
        vec3  U = vec3(0.0);
        float tU = 0.0, wU = 0.0;
        for (uint q = 0u; q < kBvSites; ++q) {
            if (q >= bvSiteCount || bvSites[q].o.w < 0.5) continue;
            uint b0 = uint(bvSites[q].ax.w), nb = uint(bvSites[q].ay.w);
            for (uint bi = b0; bi < min(b0 + nb, kBvMaxBeams); ++bi) {
                vec4  bg = bvBeams[bi].g, bd = bvBeams[bi].d;
                if (bg.w <= 0.0) continue;
                vec3  lp = bvSites[q].o.xyz + bvSites[q].ax.xyz * bg.x + bvSites[q].ay.xyz * bg.y + bvSites[q].az.xyz * bg.z;
                vec3  S  = bvSites[q].ax.xyz * bd.x + bvSites[q].ay.xyz * bd.y + bvSites[q].az.xyz * bd.z;
                float R  = max(bd.w, 100.0);
                float b  = dot(dir, S), eL = dot(lp, S);
                vec3  a  = dir - S * b, c0 = -lp + S * eL;
                float A = dot(a, a), B = dot(a, c0), C = dot(c0, c0);
                float tC = (A > 1e-8) ? max(-B / A, 0.0) : 0.0;
                float d2 = (A > 1e-8) ? max(C - B * B / A, 0.0) : C;
                float Ro = R + max(max(0.02 * R, 40.0), 1.5 * tC * pixAng);
                if (d2 > Ro * Ro) continue;
                float t0 = 0.0, t1 = 1e9;
                if (A > 1e-8) { float hw = sqrt((Ro * Ro - d2) / A); t0 = max(-B / A - hw, 0.0); t1 = -B / A + hw; }
                // The beam from its ground point (s >= 0) to 60 km up, and only where the VIEW RAY is outside the box: the
                // volume holds the rest. (Until 2026-11-24 the column started where the beam's AXIS left the box: a low
                // beam's slanted cylinder is ~10 km thick vertically, so just above the box top half of it was nobody's and
                // just below half was counted twice: a step along the top, issue_20261124_085028's upper edge.)
                float sTop = (60000.0 - bg.z) / max(bd.z, 1e-3);
                if (b > 1e-6)       { t0 = max(t0, eL / b); t1 = min(t1, (sTop + eL) / b); }
                else if (b < -1e-6) { t1 = min(t1, eL / b); t0 = max(t0, (sTop + eL) / b); }
                else continue;
                vec2  segA = vec2(t0, min(t1, iv[q].x)), segB = vec2(max(t0, iv[q].y), t1);
                if (iv[q].y <= iv[q].x) { segA = vec2(t0, t1); segB = vec2(0.0); }
                vec3  add = vec3(0.0);
                for (int sgI = 0; sgI < 2; ++sgI) {
                    vec2 sgT = (sgI == 0) ? segA : segB;
                    sgT.y = min(sgT.y, sgT.x + 80000.0);
                    if (sgT.y <= sgT.x) continue;
                    float tqS;
                    vec3  aS = bvColumnLight(eye, dir, sgT.x, sgT.y, b, BETA_R, BETA_M, tqS) * (bg.w * (R * R) / (Ro * Ro) * kBvScale);
                    float wS = dot(aS, vec3(0.33));
                    tU += wS * tqS; wU += wS;
                    add += aS;
                }
                U += add;
            }
        }
        // Busy sites without a box (past kBvSites): their merged cluster lights from 15.5 km up, as before round 2.
        for (uint li = 0u; li < min(beamLightCount, kMaxCloudBeamLights); ++li) {
            if (beamLights[li].intensity <= 0.0) continue;
            vec3  lp = beamLights[li].posENU, S = beamLights[li].dirToSource;
            vec3  Lq;
            if (bvSiteAt(lp + S * 500.0, Lq) >= 0) continue;   // a boxed site's light: its beams are above
            float R  = max(beamLights[li].footprintRadM, 100.0);
            float b  = dot(dir, S), eL = dot(lp, S);
            vec3  a  = dir - S * b, c0 = -lp + S * eL;
            float A = dot(a, a), B = dot(a, c0), C = dot(c0, c0);
            float tC = (A > 1e-8) ? max(-B / A, 0.0) : 0.0;
            float d2 = (A > 1e-8) ? max(C - B * B / A, 0.0) : C;
            float Ro = R + max(max(0.02 * R, 40.0), 1.5 * tC * pixAng);
            if (d2 > Ro * Ro) continue;
            float t0 = 0.0, t1 = 1e9;
            if (A > 1e-8) { float hw = sqrt((Ro * Ro - d2) / A); t0 = max(-B / A - hw, 0.0); t1 = -B / A + hw; }
            float sinE = max(dot(S, normalize(eye + lp)), 0.1);
            float sLo = kBvZ1 / sinE, sTop = 60000.0 / sinE;
            if (b > 1e-6)       { t0 = max(t0, (sLo + eL) / b); t1 = min(t1, (sTop + eL) / b); }
            else if (b < -1e-6) { t1 = min(t1, (sLo + eL) / b); t0 = max(t0, (sTop + eL) / b); }
            else continue;
            t1 = min(t1, t0 + 80000.0);
            if (t1 <= t0) continue;
            float h0 = length(eye + dir * t0) - R_EARTH, h1 = length(eye + dir * t1) - R_EARTH;
            float tq = 0.5 * (t0 + t1), len = t1 - t0;
            vec3  X  = eye + dir * tq;
            float dayP = clamp((dot(normalize(X), pc.sunDirENU.xyz) + 0.2) / 0.5, 0.0, 1.0);
            float ca = exp(-max(h0, 0.0) / H_R), cb = exp(-max(h1, 0.0) / H_R), dh = (h1 - h0) / H_R;
            float colR = abs(dh) < 1e-3 ? len * 0.5 * (ca + cb) : len * (ca - cb) / dh;
            ca = exp(-max(h0, 0.0) / H_M); cb = exp(-max(h1, 0.0) / H_M); dh = (h1 - h0) / H_M;
            float colM = abs(dh) < 1e-3 ? len * 0.5 * (ca + cb) : len * (ca - cb) / dh;
            vec3  sc = BETA_R * colR * phaseR(b) + vec3(BETA_M * cv2.beam.y * colM * phaseM(b));
            vec3  tau = BETA_R * (H_R * atmColumn(eye, dir, tq, H_R)) + vec3(BETA_M * 1.1 * H_M * atmColumn(eye, dir, tq, H_M));
            vec3  add = (beamLights[li].intensity * cv2.beam.w / (PI * R * R)) * (R * R) / (Ro * Ro) * sc * (1.0 - dayP) * exp(-tau) * kBvScale;
            U += add;
            float wl = dot(add, vec3(0.33));
            tU += wl * tq; wU += wl;
        }
        tU = (wU > 0.0) ? min(tU / wU, 0.999 * bvShT1()) : -1.0;

        vec3  acc = vec3(0.0);
        float tP = 0.0, shT0 = bvShT0(), shC = bvShC();
        for (int k = 0; k < kBvShZ; ++k) {
            float t1 = shT0 * exp(float(k + 1) * shC), tm = shT0 * exp((float(k) + 0.5) * shC);
            vec3  mid = acc;
            if (tU >= tP && tU < t1) { acc += U; if (tU < tm) mid += U; }
            for (uint q = 0u; q < kBvSites; ++q) {
                float a0 = max(tP, iv[q].x), a1 = min(t1, iv[q].y);
                if (a1 <= a0) continue;
                int   n = clamp(int(ceil((a1 - a0) / 750.0)), 1, 8);
                float len = (a1 - a0) / float(n);
                for (int j = 0; j < n; ++j) {
                    float ta = a0 + (float(j) + 0.5) * len;
                    vec3  X = eye + dir * ta;
                    float h = length(X) - R_EARTH;
                    if (h < -500.0) continue;
                    float rR = exp(-max(h, 0.0) / H_R), rM = exp(-max(h, 0.0) / H_M);
                    vec3  v = X - eye - bvSites[q].o.xyz;
                    vec3  L = vec3(dot(v, bvSites[q].ax.xyz), dot(v, bvSites[q].ay.xyz), dot(v, bvSites[q].az.xyz));
                    vec4  w = textureLod(bvLightTex, bvUVWp(q, L, 0), 0.0);
                    if (w.y <= 0.0) continue;
                    float pM = textureLod(bvLightTex, bvUVWp(q, L, 1), 0.0).x;   // each beam's Mie at its own angle
                    vec3  dB = bvOctDec(w.zw);
                    vec3  dS = bvSites[q].ax.xyz * dB.x + bvSites[q].ay.xyz * dB.y + bvSites[q].az.xyz * dB.z;
                    float c  = dot(dir, dS);
                    float dayP = clamp((dot(normalize(X), pc.sunDirENU.xyz) + 0.2) / 0.5, 0.0, 1.0);
                    vec3  sc = (BETA_R * (rR * phaseR(c) * w.y) + vec3(BETA_M * cv2.beam.y * rM * pM)) * len;
                    // The air between the eye and the sample (straight, as the march's estimate: atmColumn's curved column
                    // matters only past the limb, where these boxes are not).
                    vec3  tau = BETA_R * (H_R * atmColumn(eye, dir, ta, H_R)) + vec3(BETA_M * 1.1 * H_M * atmColumn(eye, dir, ta, H_M));
                    vec3  add = (1.0 - dayP) * sc * exp(-tau);
                    acc += add;
                    if (ta < tm) mid += add;
                }
            }
            tP = t1;
            imageStore(bvShaftImg, ivec3(g, k), vec4(mid, 0.0));
        }
        return;
    }

    if (kMode == 0u) {
        // ── DENSITY ── (z slabs of 16, one of four a frame per site: the whole box every 4 frames; plane 1's z)
        // (bvPad0 1: a slot changed hands, the whole box this frame: kBvNZ levels a slot, not 16)
        ivec3 c = ivec3(gl_GlobalInvocationID);
        uint  per = (bvPad0 != 0u) ? uint(kBvNZ) : 16u;
        uint  s = uint(c.z) / per;
        if (s >= min(bvSiteCount, kBvSites)) return;
        int   z = (bvPad0 != 0u) ? (c.z - int(s * per)) : int((bvFrame & 3u) * 16u) + (c.z & 15);
        vec2  xy = bvColCentre(vec2(c.xy));
        vec3  L = vec3(xy, kBvZ0 + (float(z) + 0.5) * kBvCellZ);
        ivec3 tx = ivec3(c.x + kBvNX, c.y, z + int(s) * kBvNZ);
        vec4  old = imageLoad(bvLightImg, tx);
        // Only where a beam passes (most of the box is outside every beam: the field is not read there).
        vec2  bc; float br;
        bvBlockXY(gl_WorkGroupID.xy, bc, br);
        vec3  Lb = vec3(bc, kBvZ0 + (float(uint(z) & ~3u) + 2.0) * kBvCellZ);
        if (bvCullBlock(s, Lb, length(vec2(br, 2.0 * kBvCellZ))) == 0u) { imageStore(bvLightImg, tx, vec4(old.xy, 0.0, old.w)); return; }
        vec3  rel = bvSites[s].o.xyz + bvSites[s].ax.xyz * L.x + bvSites[s].ay.xyz * L.y + bvSites[s].az.xyz * L.z;
        float h = length(rel + vec3(0.0, 0.0, R_EARTH + eyeH)) - R_EARTH;
        float sg = 0.0;
        if (h > 0.0 && h < 20000.0) {
            // (The cell's footprint, the mean erosion; gCv2NoFar as the ground shadow's read: a coarse cell takes the small
            // cells' sub-pixel average, not the far field's km-scale blobs.)
            gCv2NoFar = true;
            CV2Field f = cv2Field(cv2Pos(rel, eyeH, enuToEcef), 0.0, min(max(bvCellW(abs(xy.x)), bvCellW(abs(xy.y))), 4000.0));
            sg = f.sigma * (1.0 - 0.8 * f.thin);   // thin layers as the light march counts them
        }
        imageStore(bvLightImg, tx, vec4(old.xy, sg * 1000.0, old.w));
        return;
    }

    if (kMode == 1u) {
        // ── RAY MAPS ── (one thread a ray: gl_GlobalInvocationID flattened)
        uint gid = gl_GlobalInvocationID.x + gl_GlobalInvocationID.y * 4u * gl_NumWorkGroups.x
                 + gl_GlobalInvocationID.z * 16u * gl_NumWorkGroups.x * gl_NumWorkGroups.y;
        uint b = gid / uint(kBvRays * kBvRays), r = gid - b * uint(kBvRays * kBvRays);
        if (b >= min(bvBeamCount, kBvMaxBeams)) return;
        uint  s = bvSiteOfBeam(b);
        vec3  g = bvBeams[b].g.xyz, d = bvBeams[b].d.xyz;
        float R = max(bvBeams[b].d.w, 100.0);
        vec3  e1, e2;
        bvBasis(d, e1, e2);
        vec2  uv = ((vec2(float(r % uint(kBvRays)), float(r / uint(kBvRays))) + 0.5) / float(kBvRays) * 2.0 - 1.0) * (kBvDiskCut * R);
        vec3  r0 = g + e1 * uv.x + e2 * uv.y;
        float dzs = max(d.z, 0.05);
        float len = kBvCellZ / dzs;   // the ray's length through one z level
        float od = 0.0, odPrev = 0.0;
        uint  base = b * kBvRayN * uint(kBvNZ / 2) + r;
        bool  rock = false;   // the ray has gone into the terrain: everything below is in its shadow (2026-11-24)
        for (int k = kBvNZ - 1; k >= 0; --k) {
            float zk = kBvZ0 + (float(k) + 0.5) * kBvCellZ;
            vec3  P  = r0 + d * ((zk - r0.z) / dzs);
            float sg = 0.0;
            if (abs(P.x) < kBvHalf && abs(P.y) < kBvHalf)
                sg = textureLod(bvLightTex, bvUVWp(s, P, 1), 0.0).z * 0.001;
            if (!rock && zk < 9000.0 && abs(P.x) < kBvInner && abs(P.y) < kBvInner) {
                // The terrain's height in the box's z at P (the ground pass's last frame, bilinear): a level under it is
                // rock (the ground does not shade itself).
                vec2  fT = clamp(bvColF(P.xy) - 0.5, vec2(0.0), vec2(float(kBvNX) - 2.001));
                ivec2 iT = ivec2(floor(fT));
                vec2  wT = fT - vec2(iT);
                int   bT = int(s) * kBvNX * kBvNY + iT.y * kBvNX + iT.x;
                float z00 = unpackHalf2x16(cv2BvGround[bT].y).y, z10 = unpackHalf2x16(cv2BvGround[bT + 1].y).y;
                float z01 = unpackHalf2x16(cv2BvGround[bT + kBvNX].y).y, z11 = unpackHalf2x16(cv2BvGround[bT + kBvNX + 1].y).y;
                rock = P.z < mix(mix(z00, z10, wT.x), mix(z01, z11, wT.x), wT.y) - 350.0;
            }
            if (rock) sg = max(sg, 0.05);   // ~opaque: 14 per 281 m level
            float odHere = od + 0.5 * sg * len;   // to the level's middle
            od += sg * len;
            if ((k & 1) == 1) odPrev = odHere;    // (k odd is read first: pack (even, odd) once k is even)
            else bvMap[base + uint(k >> 1) * kBvRayN] = packHalf2x16(vec2(min(odHere, 60000.0), min(odPrev, 60000.0)));
        }
        return;
    }

    // ── GATHER ── (a 4 x 4 x 4 block per workgroup: its beams culled into shared memory; half the blocks a frame,
    // alternate z blocks: each cell's light is at most a frame old, ~0.25 ms saved)
    uint  s = gl_WorkGroupID.z / uint(kBvNZ / 8);
    if (s >= min(bvSiteCount, kBvSites)) return;
    uint  bz = (gl_WorkGroupID.z - s * uint(kBvNZ / 8)) * 2u + (bvFrame & 1u);   // the block's z index in the site
    ivec3 c = ivec3(gl_GlobalInvocationID.xy, int(bz * 4u + gl_LocalInvocationID.z));
    vec3  L = vec3(bvColCentre(vec2(c.xy)), kBvZ0 + (float(c.z) + 0.5) * kBvCellZ);
    vec2  bc; float br;
    bvBlockXY(gl_WorkGroupID.xy, bc, br);
    vec3  Lb = vec3(bc, kBvZ0 + (float(bz * 4u) + 2.0) * kBvCellZ);
    uint  n = bvCullBlock(s, Lb, length(vec2(br, 2.0 * kBvCellZ)));
    // The eye's line to the cell (box frame): each beam's phase toward the eye at its own angle (plane 1).
    vec3  vO = -bvSites[s].o.xyz;
    vec3  V  = normalize(L - vec3(dot(vO, bvSites[s].ax.xyz), dot(vO, bvSites[s].ay.xyz), dot(vO, bvSites[s].az.xyz)));
    float E = 0.0, Ef = 0.0, PM = 0.0, PC = 0.0;
    vec3  D = vec3(0.0);
    uint  kw = uint(c.z) >> 1;
    bool  hi = (c.z & 1) == 1;
    for (uint i = 0u; i < n; ++i) {
        vec3  d = sBd[i].xyz;
        float R = sBd[i].w;
        vec3  rel = L - sBg[i].xyz;
        vec3  perp = rel - d * dot(rel, d);
        float d2 = dot(perp, perp);
        if (d2 > R * R * (kBvDiskCut * kBvDiskCut)) continue;
        // The ray map at this cell: the rays through the cell's projection across the beam, at the cell's z level.
        vec2  f  = (vec2(dot(perp, sBe1[i].xyz), dot(perp, cross(d, sBe1[i].xyz))) / (kBvDiskCut * R) * 0.5 + 0.5) * float(kBvRays) - 0.5;
        f = clamp(f, vec2(0.0), vec2(float(kBvRays) - 1.001));
        ivec2 i0 = ivec2(floor(f));
        vec2  w  = f - vec2(i0);
        uint  rb0 = uint(sBe1[i].w) * kBvRayN * uint(kBvNZ / 2) + uint(i0.y * kBvRays + i0.x);
        uint  base = rb0 + kw * kBvRayN;
        vec2  a  = unpackHalf2x16(bvMap[base]);
        vec2  bq = unpackHalf2x16(bvMap[base + 1u]);
        vec2  cq = unpackHalf2x16(bvMap[base + uint(kBvRays)]);
        vec2  dq = unpackHalf2x16(bvMap[base + uint(kBvRays) + 1u]);
        float od = hi ? mix(mix(a.y, bq.y, w.x), mix(cq.y, dq.y, w.x), w.y)
                      : mix(mix(a.x, bq.x, w.x), mix(cq.x, dq.x, w.x), w.y);
        // The same ray kBvNearM further up (the ray is parallel to the beam: the same map column, a higher level).
        int   kf = c.z + int(kBvNearM * d.z / kBvCellZ + 0.5);
        float odF = 0.0;
        if (kf < kBvNZ) {
            uint  bf = rb0 + uint(kf >> 1) * kBvRayN;
            bool  hf = (kf & 1) == 1;
            vec2  fa = unpackHalf2x16(bvMap[bf]), fb = unpackHalf2x16(bvMap[bf + 1u]);
            vec2  fc = unpackHalf2x16(bvMap[bf + uint(kBvRays)]), fd = unpackHalf2x16(bvMap[bf + uint(kBvRays) + 1u]);
            odF = hf ? mix(mix(fa.y, fb.y, w.x), mix(fc.y, fd.y, w.x), w.y)
                     : mix(mix(fa.x, fb.x, w.x), mix(fc.x, fd.x, w.x), w.y);
        }
        float e0 = sBg[i].w * bvDisk(d2, R);
        float e = e0 * exp(-od), eF = e0 * exp(-odF);
        float cV = dot(V, d);
        E  += e;
        Ef += eF;
        PM += e * phaseM(cV);
        PC += eF * bvCloudPhase(cV);
        D  += e0 * d;
    }
    imageStore(bvLightImg, ivec3(c.xy, c.z + int(s) * kBvNZ), vec4(Ef * kBvScale, E * kBvScale, bvOctEnc(D)));
    ivec3 t1 = ivec3(c.x + kBvNX, c.y, c.z + int(s) * kBvNZ);
    float dens = imageLoad(bvLightImg, t1).z;
    imageStore(bvLightImg, t1, vec4(PM * kBvScale, PC * kBvScale, dens, 0.0));
}
