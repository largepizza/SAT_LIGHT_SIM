    float aspect;
    float waveTime;    // wall-clock seconds — used by cloudWarpOffset/cirrusWindAngleAt/cirrusDomainWarp
    float obsEffH;      // observer altitude above local terrain (m) — CPU-computed, see recordCompute
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;   // xyz = observer ECEF unit vector
    uint  debugDisableMask; // perf knockout toggles — mirrors SatDrawPC's; bit 32 (aurora curtain
                            // march) and bit 64 (cloud self-shadow light cone) are the ones
                            // meaningful here — both live only in this shader now
    float beamMaxRangeM; // C12 follow-up #6 — settings-tunable Reflect-Orbital beam render range
    uint  showBeamDebugRays; // C12 follow-up #12 — debug pointing-ray visualization toggle
    float beamSkyGlowGain; // C12 follow-up #17 — settings-tunable brightness for the simple
                           // atmospheric-scattering beam glow
    float daySuppression;  // C12 follow-up #28 — same ratio sat_flare.comp applies to satellites/stars
    float beamExtinctionMult; // C12 follow-up #29 — settings-tunable extra extinction for the beam glow
    float beamNearFieldFadeM; // C12 follow-up #40 — settings-tunable crossfade blend radius (m) around
                              // a beam's own 3D line; was a hardcoded kNearFieldCrossoverM constant.
                              // (beamGlowBleedGain, previously the last field here, moved to
                              // SatDrawPC/sat_sky.frag in follow-up #39 — this struct's C++ side
                              // shrank then regrew for this field, reusing the freed offset.)
} pc;

layout(set = 0, binding = 0) uniform sampler2D earthCloudsTex;
layout(set = 0, binding = 1) uniform sampler3D cloudNoiseTex;
layout(set = 0, binding = 2) uniform sampler2D earthNightTex;
layout(set = 0, binding = 3) uniform sampler2D noiseTex;

