// Target A: rgb = combined additive radiance (B_total), a = tCloudOcclude (m, -1 = none)
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D targetA;
// Target B: rgb = combined multiplicative attenuation (A_total), a = cloudBlock (sun-dimming scalar)
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D targetB;
// S9 (2026-10-22, "Full-resolution clouds"): the composite's derivatives with respect to the volumetric cloud
// (cloud_v2_combine.comp puts the full-res clouds back in to first order). Written only in that mode; 1x1 otherwise.
// dB: rgb dB/dA_cloud, a dB/dB_cloud (a scalar times the identity); dA: rgb dA/dA_cloud, a the nearest emissive /
// plume distance in km (-1 = none: the combine rebuilds the alpha's signed distance at full res).
layout(set = 0, binding = 24, rgba16f) uniform writeonly image2D targetDB;
layout(set = 0, binding = 25, rgba16f) uniform writeonly image2D targetDA;

