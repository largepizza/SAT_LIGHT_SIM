const vec3  kNightSkyAmbientColor = vec3(0.015, 0.02, 0.035);

// (BETA_R/H_R, BETA_M/H_M/G_MIE and SUN_INTENSITY come from common.glsl.)

// NOTE — this is a REAL drift against sat_sky.frag, kept deliberately for now.
// sat_sky.frag's optDepth reads `cloud.lightSamples` (the "Light samples" settings slider); this
// one is hardcoded, so the slider has never affected cloud/cirrus/aurora sun lighting at all.
// Step 6 of the unification pass gives the shared optDepth an explicit nLight parameter with each
// caller passing what it passes today, so the drift becomes visible and unifying the VALUE stays
// a separate, opt-in decision rather than a silent side effect of de-duplication.
const int N_LIGHT = 12;

const float kCirrusWindWarpFreq  = 1.5;
const float kCirrusWindWarpAmp   = 1.2;
const float kCirrusWindDriftRate = 0.05;

const float kCirrusThicknessM = 700.0;
const float kCirrusFreqScale  = 0.4;

// (phaseM / phaseCloud are in common.glsl. The "── Duplicated shared helpers, keep in sync ──"
// section that used to live here is gone along with the duplication it was warning about.)

// (raySphere is in common.glsl — one copy now, so the "keep both copies in sync" note this
// comment used to carry no longer applies.)

// DELIBERATELY NOT the shared optDepthN(), despite being the same integral.
//
// This is a specialization, and the specialization is the point: N_LIGHT is a compile-time
// constant here, so this loop can be fully unrolled. Routing it through the shared function makes
// the trip count a runtime parameter — which is unavoidable for a function that also has to serve
// sat_sky.frag's settings-tunable count — and that measurably hurt, because optDepth is called
// from five sites in this shader including inside the march.
//
// The de-duplication attempt and its revert are recorded here rather than deleted, because the
// tension is real and someone will be tempted again: what made these two copies look like
// "drift" (12 vs cloud.lightSamples) is exactly what let each one be compiled well. Sharing the
// body costs more than the duplication does. If you unify them, measure cloud_march before and
// after, at altitude and near the surface.
vec2 optDepth(vec3 p, vec3 d, float segTotal) {
    float sLen = segTotal / float(N_LIGHT);
    float odR = 0.0, odM = 0.0;
    for (int i = 0; i < N_LIGHT; ++i) {
        float h = max(0.0, length(p + d * (float(i) + 0.5) * sLen) - R_EARTH);
        odR += exp(-h / H_R);
        odM += exp(-h / H_M);
    }
    return vec2(odR, odM) * sLen;
}

// (rotateZ and remap are in common.glsl.)

uvec3 warpHashU(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 warpGradHash(ivec3 c) {
    return normalize(-1.0 + 2.0 * (vec3(warpHashU(uvec3(c))) * (1.0 / 4294967296.0)));
}
float warpPerlin3(vec3 p) {
    ivec3 i = ivec3(floor(p));
    vec3  f = fract(p);
    vec3  u = f * f * (3.0 - 2.0 * f);
    float v000 = dot(warpGradHash(i),                   f              );
    float v100 = dot(warpGradHash(i + ivec3(1,0,0)), f - vec3(1,0,0));
    float v010 = dot(warpGradHash(i + ivec3(0,1,0)), f - vec3(0,1,0));
    float v110 = dot(warpGradHash(i + ivec3(1,1,0)), f - vec3(1,1,0));
    float v001 = dot(warpGradHash(i + ivec3(0,0,1)), f - vec3(0,0,1));
    float v101 = dot(warpGradHash(i + ivec3(1,0,1)), f - vec3(1,0,1));
    float v011 = dot(warpGradHash(i + ivec3(0,1,1)), f - vec3(0,1,1));
    float v111 = dot(warpGradHash(i + ivec3(1,1,1)), f - vec3(1,1,1));
    return mix(mix(mix(v000, v100, u.x), mix(v010, v110, u.x), u.y),
               mix(mix(v001, v101, u.x), mix(v011, v111, u.x), u.y), u.z);
}

float auroraOvalMaskLocal(vec3 posDirECEF, float t, float storm) {
    vec3  poleDir   = (dot(posDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
    float colatDeg  = degrees(acos(clamp(dot(posDirECEF, poleDir), -1.0, 1.0)));
    float centerDeg = kAuroraOvalColatDeg + storm * 8.0;
    float widthDeg  = kAuroraOvalWidthDeg * (1.0 + storm * 1.5);
    float band = clamp(1.0 - abs(colatDeg - centerDeg) / widthDeg, 0.0, 1.0);
    if (band <= 0.001) return 0.0;

    vec3  ref      = abs(poleDir.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3  tangentT = normalize(cross(poleDir, ref));
    vec3  radialT  = normalize(cross(tangentT, poleDir));
    vec3  localDir = posDirECEF - poleDir * dot(posDirECEF, poleDir);
    float az       = atan(dot(localDir, tangentT), dot(localDir, radialT));

    // Time is mixed into the azimuthal embedding (x,y), NOT the colatitude axis (z) — see
    // sat_sky.frag's auroraCoverage for why: adding t to colat directly made the pattern visibly
    // slide toward/away from the pole over time instead of evolving in place.
    vec2  azWarp = vec2(cos(az), sin(az)) * cloud.auroraCoverageAzFreq + t * cloud.auroraCoverageDriftRate;
    float n = warpPerlin3(vec3(azWarp, colatDeg * cloud.auroraCoverageFreq));
    float threshold = mix(0.2, -0.6, clamp(storm, 0.0, 1.0));
    float coverage  = smoothstep(threshold, threshold + kAuroraCoverageSoftness, n);
    return band * coverage;
}

// ── Aurora sky curtain (moved here from sat_sky.frag this session — perf) ──────────────────────
// Full-featured versions (ripple warp, smoothstep fade zone) of the oval mask, distinct from
// auroraOvalMaskLocal above (that stripped-down version stays sat_sky.frag-only-style, used just
// for cloud-top upwelling here). These four are a near-verbatim duplicate of sat_sky.frag's own
// auroraFrame/auroraCoverage/auroraOvalMask/auroraCurtainNoise — keep both copies in sync, same
// convention this file already documents at the top for cloudMarch/cirrusMarch's shared helpers.
// sat_sky.frag still needs its own copies too: auroraGlowAt (terrain/ocean ambient lighting) and
// the ocean sky-reflection's aurora sample both stay full-resolution and keep calling them there.
const float kAuroraShellInnerM  = 95000.0;
const float kAuroraShellOuterM  = 300000.0;
const float kAuroraRingWarpFreq = 3.0;
const float kAuroraOvalWarpDeg  = 4.0;
const float kAuroraOvalDriftRate = 0.003;
const float kAuroraTangentFreq  = 40.0;
const float kAuroraRadialFreq   = 70.0;
const float kAuroraAltFreq      = 0.000006;
const float kAuroraScale        = 0.000001;
const vec3  kAuroraTopColor     = vec3(0.65, 0.15, 0.45);
// kAuroraGroundColor (already declared above) is numerically identical to sat_sky.frag's
// kAuroraBaseColor — reused directly below rather than redeclaring under a second name.
const vec3  kAirglowGreenColor  = vec3(0.35, 1.0, 0.25);
const vec3  kAirglowSodiumColor = vec3(1.0, 0.65, 0.15);
const vec3  kAirglowRedColor    = vec3(1.0, 0.12, 0.05);

void auroraFrame(vec3 dirECEF, vec3 poleDir, out float colat, out float az,
                  out vec3 radialT, out vec3 tangentT) {
    colat = acos(clamp(dot(dirECEF, poleDir), -1.0, 1.0));
    vec3 ref = abs(poleDir.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    tangentT = normalize(cross(poleDir, ref));
    radialT  = normalize(cross(tangentT, poleDir));
    vec3 localDir = dirECEF - poleDir * dot(dirECEF, poleDir);
    az = atan(dot(localDir, tangentT), dot(localDir, radialT));
}

float auroraCoverage(float colat, float az, float t, float storm) {
    vec2  azWarp = vec2(cos(az), sin(az)) * cloud.auroraCoverageAzFreq + t * cloud.auroraCoverageDriftRate;
    float n = warpPerlin3(vec3(azWarp, degrees(colat) * cloud.auroraCoverageFreq));
    float threshold = mix(0.2, -0.6, clamp(storm, 0.0, 1.0));
    return smoothstep(threshold, threshold + kAuroraCoverageSoftness, n);
}

float auroraOvalMask(float colat, float az, float t, float storm) {
    // Same conservative 70deg pre-filter as sat_sky.frag's copy — see that file for the full
    // worst-case-reach derivation.
    if (degrees(colat) > 70.0)
        return 0.0;
    vec2  ringP  = vec2(cos(az), sin(az)) * kAuroraRingWarpFreq;
    float ripple = warpPerlin3(vec3(ringP, t * kAuroraOvalDriftRate)) * kAuroraOvalWarpDeg;
    float centerDeg = kAuroraOvalColatDeg + ripple + storm * 8.0;
    float widthDeg  = kAuroraOvalWidthDeg * (1.0 + storm * 1.5);
    float distDeg = abs(degrees(colat) - centerDeg);
    float band = smoothstep(widthDeg * 2.0, widthDeg * 0.5, distDeg);
    return band * auroraCoverage(colat, az, t, storm);
}

// "base" is a texture read against auroraNoiseTex's R channel (baked by aurora_noise.comp)
// instead of a live warpPerlin3 call — see that file's header and sat_sky.frag's own copy of this
// function for the full derivation of the UVW mapping and the storm/frequency approximation.
float auroraCurtainNoise(float colat, float az, float altM, float t, float storm) {
    float shimmerPhase = warpPerlin3(vec3(colat * kAuroraRadialFreq * 0.3,
                                           altM * kAuroraAltFreq * 0.3,
                                           t * cloud.auroraShimmerRate)) * 2.5;
    vec3 p = vec3(az * kAuroraTangentFreq * (1.0 + storm * 0.8) + shimmerPhase,
                  altM * kAuroraAltFreq,
                  colat * kAuroraRadialFreq);
    const float kAuroraCurtainPeriod = kAuroraTangentFreq * 2.0 * PI;
    float texU = fract(p.x / kAuroraCurtainPeriod);
    float texV = clamp((p.y - 0.24) / (2.46 - 0.24), 0.0, 1.0);
    float texW = clamp(p.z / 91.6, 0.0, 1.0);
    float base = texture(auroraNoiseTex, vec3(texU, texV, texW)).r * 2.0 - 1.0;
    return remap(base, -0.3, 0.9, 0.0, 1.0);
}

// Per-sample curtain color/intensity — near-verbatim port of sat_sky.frag's auroraSampleAt, minus
// the (unused here) enuX/enuY/enuZ basis-rebuild since the caller already works in ECEF-relative
// terms consistent with the rest of this file.
vec3 auroraCurtainSample(vec3 rp, vec3 enuX, vec3 enuY, vec3 enuZ, vec3 sunDirECEF, float t, float storm) {
    vec3 pDirECEF = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
    float dayness = clamp((dot(pDirECEF, sunDirECEF) + 0.15) / 0.3, 0.0, 1.0);
    float night   = 1.0 - dayness;
    if (night <= 0.001) return vec3(0.0);
    vec3 poleDir  = (dot(pDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
    float colat, az; vec3 radialT, tangentT;
    auroraFrame(pDirECEF, poleDir, colat, az, radialT, tangentT);
    float oval = auroraOvalMask(colat, az, t, storm);
    if (oval <= 0.001) return vec3(0.0);
    float altM = length(rp) - R_EARTH;
    const float kAuroraInnerFalloffM = 7500.0;
    const float kAuroraOuterFalloffM = 15000.0;
    float innerVert = 1.0 / (1.0 + exp(-(altM - kAuroraShellInnerM) / kAuroraInnerFalloffM));
    float outerVert = 1.0 / (1.0 + exp((altM - kAuroraShellOuterM) / kAuroraOuterFalloffM));
    float vert = innerVert * outerVert;
    if (vert <= 0.001) return vec3(0.0);

    // Column window colA/colB — same baked-texture read as sat_sky.frag's copy (G/B channels).
    float colTexU = fract(az / (2.0 * PI));
    float colTexW = clamp(colat / radians(75.0), 0.0, 1.0);
    vec2  colSample = texture(auroraNoiseTex, vec3(colTexU, 0.5, colTexW)).gb;
    float colA = colSample.x;
    float colB = colSample.y;
    float colLoFrac = clamp(min(colA, colB) - 0.08, 0.0, 1.0);
    float colHiFrac = clamp(max(colA, colB) + 0.08, 0.0, 1.0);
    float colLoM = mix(kAuroraShellInnerM, kAuroraShellOuterM, colLoFrac);
    float colHiM = mix(kAuroraShellInnerM, kAuroraShellOuterM, colHiFrac);
    const float kAuroraColumnFalloffM = 12000.0;
    float columnWindow = (1.0 / (1.0 + exp(-(altM - colLoM) / kAuroraColumnFalloffM)))
                        * (1.0 / (1.0 + exp((altM - colHiM) / kAuroraColumnFalloffM)));
    if (columnWindow <= 0.001) return vec3(0.0);

    float fold = mix(1.0, auroraCurtainNoise(colat, az, altM, t, storm), vert);
    vec3  col  = mix(kAuroraGroundColor, kAuroraTopColor,
                      clamp(remap(altM, kAuroraShellInnerM, kAuroraShellOuterM, 0.0, 1.0), 0.0, 1.0));
    vec3 innerAirglowCol = mix(kAirglowSodiumColor, kAirglowGreenColor, 0.5);
    col = mix(innerAirglowCol, col, innerVert);
    col = mix(kAirglowRedColor, col, outerVert);
    return col * (oval * fold * vert * columnWindow * night);
}

// Full sky curtain march: whole-ray bounding pre-check + adaptive-step march + light-pollution/
// moonlight suppression + atmospheric extinction. Returns the raw contribution BEFORE cloud
// suppression — main() applies that using the ALREADY-COMPUTED local cloud transmittance (A_total)
// from this same pixel/frame, more accurate than sat_sky.frag's old "early" texture pre-sample
// (which existed only because sat_sky.frag runs at full-res and needed a cheap same-frame proxy;
// this compute shader already has the real value on hand).
vec3 auroraMarchCS(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                    vec3 sunDir, vec3 sunDirECEF, float obsEffH, vec4 moonDirENU,
                    float tScene)  // shared scene depth — see cloudMarchCS
{
    const float kAuroraMarchInnerM = kAuroraShellInnerM - 55000.0;
    const float kAuroraMarchOuterM = kAuroraShellOuterM + 110000.0;
    vec2 tAuroraFar = raySphere(obsPos, dir, R_EARTH + kAuroraMarchOuterM);
    vec2 tAuroraIn  = raySphere(obsPos, dir, R_EARTH + kAuroraMarchInnerM);

    float atEnter, atExit;
    if (obsEffH < kAuroraMarchInnerM) {
        atEnter = tAuroraIn.y;
        atExit  = tAuroraFar.y;
    } else if (obsEffH <= kAuroraMarchOuterM) {
        atEnter = 0.0;
        atExit  = tAuroraFar.y;
        if (tAuroraIn.x > 0.0 && tAuroraIn.x < atExit) atExit = tAuroraIn.x;
    } else {
        atEnter = tAuroraFar.x;
        atExit  = (tAuroraIn.x > 0.0) ? tAuroraIn.x : tAuroraFar.y;
    }
    // Terrain occlusion. Clamp the PADDED bounds used by the step loop, but test entry against
    // the REAL shell below — the padding (55/110km) exists to catch the emission falloff tail
    // smoothly and is not itself emissive, so gating on it would re-introduce exactly the
    // "aurora pops in at ~38-40km" bug that motivated the padded/real split in the first place.
    atExit = min(atExit, tScene);
    if (atEnter >= atExit || atExit <= 0.0) return vec3(0.0);

    // Whole-ray bounding pre-check (ported from sat_sky.frag this session) — same 80deg
    // conservative bound (70deg worst-case oval reach + margin for 5-sample undersampling).
    const int kAuroraBoundSamples = 5;
    float minBoundColatDeg = 1e6;
    for (int bi = 0; bi < kAuroraBoundSamples; ++bi) {
        vec3 bp       = obsPos + dir * mix(atEnter, atExit, float(bi) / float(kAuroraBoundSamples - 1));
        vec3 bDirECEF = normalize(bp.x * enuX + bp.y * enuY + bp.z * enuZ);
        vec3 bPole    = (dot(bDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
        minBoundColatDeg = min(minBoundColatDeg, degrees(acos(clamp(dot(bDirECEF, bPole), -1.0, 1.0))));
    }
    if (minBoundColatDeg > 80.0) return vec3(0.0);

    // Past this point the march genuinely runs — record the entry distance for terrain
    // suppression. Unlike cloudMarchCS/cirrusMarchCS, this canNOT just reuse atEnter: the march
    // bounds above (kAuroraMarchInnerM/OuterM) are deliberately padded 55/110km beyond the REAL
    // shell (kAuroraShellInnerM/OuterM) to catch the falloff/oval-mask tail smoothly, so "inside
    // the padded march range" (atEnter==0 in the branch above) does NOT mean "inside the real
    // emissive shell." Using atEnter directly told the terrain gate aurora content starts at
    // distance 0 — i.e. nothing can ever occlude it — for the entire padding band (~40-95km
    // altitude), well below where the aurora is actually bright. That's the real cause of a
    // reported "pops in over terrain at ~38-40km" (matches kAuroraMarchInnerM = 95000-55000 =
    // 40000 almost exactly) — a hard gate failure over that whole band, not a smooth fade. Fixed
    // by computing the entry distance against the REAL (unpadded) shell bounds instead, fully
    // decoupled from the padded range used for the step loop below.
    float realEnter;
    if (obsEffH < kAuroraShellInnerM) {
        vec2 tRealIn = raySphere(obsPos, dir, R_EARTH + kAuroraShellInnerM);
        realEnter = max(tRealIn.y, 0.0);
    } else if (obsEffH <= kAuroraShellOuterM) {
        realEnter = 0.0; // genuinely inside the real shell — content starts at the camera
    } else {
        vec2 tRealOut = raySphere(obsPos, dir, R_EARTH + kAuroraShellOuterM);
        realEnter = max(tRealOut.x, 0.0);
    }
    // The real (unpadded) shell starts behind terrain — nothing emissive is visible on this ray.
    if (realEnter >= tScene) return vec3(0.0);

    const float kAuroraMaxStepM = 15000.0;
    const int   kAuroraStepsMin = 4;
    const int   kAuroraStepsMax = 64;
    float aPathLen = atExit - atEnter;
    int   N_AURORA = clamp(int(aPathLen / kAuroraMaxStepM), kAuroraStepsMin, kAuroraStepsMax);
    float aSegLen = aPathLen / float(N_AURORA);
    vec3  accumAurora = vec3(0.0);
    for (int i = 0; i < N_AURORA; ++i) {
        vec3 ap = obsPos + dir * (atEnter + (float(i) + 0.5) * aSegLen);
        accumAurora += auroraCurtainSample(ap, enuX, enuY, enuZ, sunDirECEF, pc.waveTime, cloud.stormStrength);
    }

    // Light pollution + moonlight suppression — identical formula to sat_sky.frag's copy.
    float azLPAurora    = mod(atan(dir.x, dir.y) + 6.283185307, 6.283185307);
    float secFAurora    = azLPAurora * (16.0 / 6.283185307) - 0.5;
    int   sec0Aurora    = int(floor(secFAurora));
    float secFracAurora = secFAurora - float(sec0Aurora);
    int   sec0wAurora   = ((sec0Aurora % 16) + 16) % 16;
    int   sec1wAurora   = (sec0wAurora + 1) % 16;
    float domeAzAurora  = mix(lightDome[sec0wAurora], lightDome[sec1wAurora], secFracAurora);
    float elevFalloffAurora = 0.35 / (max(dir.z, 0.0) + 0.35);
    // S2c (RELEASE_v1_1_PLAN.md): same isotropic-floor fix as sat_flare.comp/sat_sky.frag/
    // updateStars() — elevFalloffAurora alone bottoms out at ~0.26 at zenith, wrong for real
    // (isotropically-scattered) urban skyglow. Keep this constant identical across all copies.
    const float kIsotropicFrac = 0.4;
    float domeValAurora  = clamp(domeAzAurora * (kIsotropicFrac + (1.0 - kIsotropicFrac) * elevFalloffAurora), 0.0, 1.0);
    const float kAuroraPollutionMaxDim = 0.9;

    float tmAurora         = clamp(moonDirENU.z / 0.5, 0.0, 1.0);
    float moonBrightAurora = tmAurora * tmAurora * moonDirENU.w;
    const float kAuroraMoonMaxDim = 0.85;

    float auroraVisSuppress = (1.0 - domeValAurora * kAuroraPollutionMaxDim)
                             * (1.0 - moonBrightAurora * kAuroraMoonMaxDim);

    // Atmospheric extinction — same Kasten & Young 1989 approximation as sat_sky.frag's copy.
    float atmFracAurora = clamp(exp(-obsEffH / 20000.0), 0.0, 1.0);
    float sinElAurora    = clamp(dir.z, 0.0, 1.0);
    float elDegAurora    = degrees(asin(sinElAurora));
    float airmassAurora  = 1.0 / (sinElAurora + 0.50572 * pow(elDegAurora + 6.07995, -1.6364));
    float extinctMagAurora = cloud.extinctionCoeff * (airmassAurora - 1.0) * atmFracAurora;
    float extinctionAurora = pow(10.0, -0.4 * extinctMagAurora);

    return accumAurora * aSegLen * kAuroraScale * cloud.auroraGain * auroraVisSuppress * extinctionAurora;
}

// Airglow red band (630nm) supplemental march — moved here from sat_sky.frag this session (perf:
// half-res instead of full-res, same rationale as aurora above, though the win is smaller — this
// march only ever cost ~1ms full-res: fixed 16 steps, 1 noise call per sample, nowhere near
// aurora's old worst case). Green/sodium bands still ride sat_sky.frag's main atmosphere loop "for
// free" and stay there — moving just them would mean duplicating a chunk of that loop here for
// near-zero marginal win, since they already cost almost nothing riding samples that loop takes
// anyway for other reasons (see the "does the atmosphere need full-res" discussion this session).
// No cloud-suppression term — the original never had one (unlike aurora), just a plain additive
// term, so this folds straight into B_total below with no extra logic.
const float kAirglowRedPeakM      = 275000.0;
const float kAirglowRedHalfWidthM = 75000.0;
const float kAirglowNoiseFreq     = 4.0;
const float kAirglowDriftRate     = 0.015;
const float kAirglowScale         = 0.0000005;

vec3 airglowRedMarchCS(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                        vec3 sunDirECEF, float obsEffH, float tScene) {
    const float kAirglowInnerM = 100000.0; // = R_ATMOS - R_EARTH
    const float kAirglowFarM   = 500000.0;
    vec2 tAtmos  = raySphere(obsPos, dir, R_ATMOS);
    vec2 tAirFar = raySphere(obsPos, dir, R_EARTH + kAirglowFarM);

    float rtEnter, rtExit;
    if (obsEffH < kAirglowInnerM) {
        rtEnter = tAtmos.y;
        rtExit  = tAirFar.y;
    } else if (obsEffH <= kAirglowFarM) {
        rtEnter = 0.0;
        rtExit  = tAirFar.y;
        if (tAtmos.x > 0.0 && tAtmos.x < rtExit) rtExit = tAtmos.x;
    } else {
        rtEnter = tAirFar.x;
        rtExit  = (tAtmos.x > 0.0) ? tAtmos.x : tAirFar.y;
    }
    // Terrain occlusion. NOTE this is a genuine BUG FIX, not just a refactor: the red band never
    // contributed to the old shared tEnterCombined scalar at all, so until now it rendered
    // straight through terrain unconditionally, at every observer altitude.
    if (rtEnter >= tScene) return vec3(0.0);
    rtExit = min(rtExit, tScene);
    if (rtEnter >= rtExit || rtExit <= 0.0) return vec3(0.0);

    const int N_AIRGLOW_RED = 16;
    float rSegLen = (rtExit - rtEnter) / float(N_AIRGLOW_RED);
    vec3  accumAirglowRed = vec3(0.0);
    for (int i = 0; i < N_AIRGLOW_RED; ++i) {
        vec3  rp       = obsPos + dir * (rtEnter + (float(i) + 0.5) * rSegLen);
        float rh       = length(rp) - R_EARTH;
        vec3  rDirECEF = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
        float rDayness = clamp((dot(rDirECEF, sunDirECEF) + 0.15) / 0.3, 0.0, 1.0);
        float rNight   = 1.0 - rDayness;
        if (rNight > 0.001) {
            float rPatch = 0.6 + 0.4 * warpPerlin3(rDirECEF * kAirglowNoiseFreq
                                + vec3(pc.waveTime * kAirglowDriftRate, 17.0, -5.0));
            float dzR      = (rh - kAirglowRedPeakM) / kAirglowRedHalfWidthM;
            float densAirR = exp(-dzR * dzR) * rSegLen;
            accumAirglowRed += kAirglowRedColor * cloud.airglowRedGain * densAirR * rNight * rPatch;
        }
    }
    return accumAirglowRed * kAirglowScale * cloud.airglowGain;
}

// Perf (this session): was 3 live warpPerlin3 evaluations (24 gradient-hash lookups) per call —
// the dominant live-procedural cost in the cloud march, since this runs once per in-cloud march
// sample. Baked into cloud_warp_noise.comp's field (R/G/B = the same three offset channels this
// used to compute live). kWarpBakeN MUST match the bake shader's own constant — see that file's
// header for the tiling-period / repeat-distance trade-off this bake accepted (the live version
// never repeated; the baked one tiles at a period chosen to stay unnoticeable in normal play).
const float kWarpBakeN = 16.0;
const int   kWarpBakeRes = 192; // MUST match cloud_warp_noise.comp's own bake resolution (kSz)

// Wraps a texel index into [0,N) — same explicit pattern as gradHash's cell wrap in
// cloud_warp_noise.comp (not GLSL's `%`, whose sign behavior for negative operands isn't
// something to rely on across drivers).
int wrapTexel(int x, int n) { int r = x % n; return r < 0 ? r + n : r; }
ivec3 wrapTexel3(ivec3 c, int n) { return ivec3(wrapTexel(c.x, n), wrapTexel(c.y, n), wrapTexel(c.z, n)); }

// Manual smoothstep-weighted trilinear blend of the baked warp texels — NOT a plain texture()
// call. Hardware trilinear filtering interpolates LINEARLY (straight-edged) between texels; the
// live analytic version this replaced was smoothstep-interpolated (curved) between its gradient
// corners. At this bake's texel density that mismatch was geometrically legible as visible
// "tessellating triangle" faceting once the value is used as a raw coordinate displacement (see
// cloud_warp_noise.comp's header — a 192³/2-octave resolution bump alone reduced but didn't
// eliminate it). Using texelFetch + a manual smoothstep weight reproduces the same curved
// interpolation shape the analytic Perlin evaluation had, regardless of texel density — the
// sampler's REPEAT/LINEAR settings go unused here (texelFetch bypasses both address mode and
// filtering; wrapping is done by hand via wrapTexel3 instead).
vec3 cloudWarpNoiseSample(vec3 uvw) {
    vec3  tc = fract(uvw) * float(kWarpBakeRes) - 0.5; // texel-centered, wrapped into [0,texSize)
    ivec3 i0 = ivec3(floor(tc));
    vec3  f  = tc - vec3(i0);
    vec3  u  = f * f * (3.0 - 2.0 * f); // same smoothstep curve the analytic Perlin interpolant used

    vec3 c000 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,0,0), kWarpBakeRes), 0).rgb;
    vec3 c100 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,0,0), kWarpBakeRes), 0).rgb;
    vec3 c010 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,1,0), kWarpBakeRes), 0).rgb;
    vec3 c110 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,1,0), kWarpBakeRes), 0).rgb;
    vec3 c001 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,0,1), kWarpBakeRes), 0).rgb;
    vec3 c101 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,0,1), kWarpBakeRes), 0).rgb;
    vec3 c011 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,1,1), kWarpBakeRes), 0).rgb;
    vec3 c111 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,1,1), kWarpBakeRes), 0).rgb;

    return mix(mix(mix(c000, c100, u.x), mix(c010, c110, u.x), u.y),
               mix(mix(c001, c101, u.x), mix(c011, c111, u.x), u.y), u.z);
}

vec3 cloudWarpOffset(vec3 dirECEF) {
    vec3 windOfs = vec3(cloud.cloudPhase * kWarpDriftRate + pc.waveTime * kWarpEvolveRate,
                         pc.waveTime * kWarpEvolveRate * 0.6,
                         cloud.cloudPhase * kWarpDriftRate * 0.7 + pc.waveTime * kWarpEvolveRate * 0.8);
    vec3 uvw = (dirECEF * kWarpFreq + windOfs) / kWarpBakeN;
    vec3 n   = cloudWarpNoiseSample(uvw) * 2.0 - 1.0;
    return n * kWarpStrength;
}

float cityBrightness(float lum) {
    float raw = max(0.0, lum - kNightFloor);
    return raw / (raw + kCityCompressK);
}

float cloudDensity(vec3 uvwXY, vec3 uvwDetail, float hNorm, float coverage, float density, float heightProfile) {
    // Vertical presence: THREE fixed Z-slices, not a continuous Z lookup — see
    // project_cloud_march_steps memory: sampling Z continuously at this codebase's typical
    // march-step counts reintroduces altitude-slab banding, which is why the original design
    // pinned this to constant slices in the first place. The problem with only two slices is that
    // a straight lerp between them makes every cloud's silhouette a geometric cone (wide at
    // kPresenceZBase, monotonically narrowing to kPresenceZTop) — a third anchor at the midpoint
    // breaks that monotonic taper into an actual bulge/waist shape without reintroducing
    // per-march-step Z sensitivity (still just 3 discrete lookups, blended smoothly by hNorm).
    const float kPresenceZBase = 0.0;
    const float kPresenceZMid  = 0.28;
    const float kPresenceZTop  = 0.56;
    float nsBaseR = texture(cloudNoiseTex, uvwXY + vec3(0.0, 0.0, kPresenceZBase)).r;
    float nsMidR  = texture(cloudNoiseTex, uvwXY + vec3(0.0, 0.0, kPresenceZMid)).r;
    float nsTopR  = texture(cloudNoiseTex, uvwXY + vec3(0.0, 0.0, kPresenceZTop)).r;
    float baseA   = remap(nsBaseR, 1.0 - coverage, 1.0, 0.0, 1.0);
    float midA    = remap(nsMidR,  1.0 - coverage, 1.0, 0.0, 1.0);
    float topA    = remap(nsTopR,  1.0 - coverage, 1.0, 0.0, 1.0);
    float hc      = clamp(hNorm, 0.0, 1.0);
    float base    = (hc < 0.5) ? mix(baseA, midA, hc * 2.0)
                                : mix(midA, topA, (hc - 0.5) * 2.0);
    if (base <= 0.0) return 0.0;

    vec4  nsF     = texture(cloudNoiseTex, uvwDetail * 1.5 + vec3(0.37, 0.53, 0.71));
    float erosion = nsF.g * 0.625 + nsF.b * 0.25 + nsF.a * 0.125;

    // Edge-biased erosion: `base` doubles as a proxy for how deep inside the cloud's own presence
    // threshold this point sits (near 0 at the silhouette edge, toward 1 at the core). Biting
    // harder near the edge than at the core carves cauliflower/wisp detail into the boundary while
    // leaving dense cores comparatively solid — the previous single uniform erosion strength just
    // scaled the whole shape down evenly, which reads as smooth/rounded rather than fluffy.
    float erosionAmt = mix(cloud.cloudErosionEdge, cloud.cloudErosionCore, base);
    float eroded  = remap(base, erosionAmt * erosion, 1.0, 0.0, 1.0);

    return clamp(eroded * heightProfile * density, 0.0, 1.0);
}

// ── Moved (exclusive to cirrusMarch) ──────────────────────────────────────────

float cirrusWindAngleAt(vec3 dirECEF) {
    vec3 p = dirECEF * kCirrusWindWarpFreq
           + vec3(pc.waveTime * kWarpEvolveRate * 1.7,
                   cloud.cloudPhase * kCirrusWindDriftRate,
                   91.0);
    return warpPerlin3(p) * kCirrusWindWarpAmp;
}

vec3 cirrusDomainWarp(vec3 dirECEF) {
    vec3 w1 = cloudWarpOffset(dirECEF);
    vec3 p2 = dirECEF * (kWarpFreq * 0.35) + vec3(19.0, -7.0, 41.0)
            + vec3(pc.waveTime * kWarpEvolveRate * 0.5);
    vec3 w2 = vec3(warpPerlin3(p2),
                    warpPerlin3(p2 + vec3(5.2, 1.1, 9.3)),
                    warpPerlin3(p2 + vec3(3.3, 8.8, 2.2))) * (kWarpStrength * 1.5);
    return w1 + w2;
}

// ── Reflect-Orbital beam volumetric lighting (C12 follow-up #44/#46/#47) ─────────────────────
// Shared by cloudMarchCS and fogMarchCS (follow-up #47) — the per-target lookup is IDENTICAL for
// both volumes: a per-TARGET Gaussian lateral falloff (beamLights[], the CPU-aggregated per-target
// buffer built in SatelliteSim.cpp), the beam_cloud_block.comp-derived blockAltM/blockOpacity
// height cutoff, and the phaseCloud() view-angle term. Unlike the sun self-shadow cone (which
// legitimately differs per volume — colH/baseH cloud-shape sculpting has no fog equivalent — kept
// duplicated on purpose, see fogMarchCS's own comment), this body has no per-volume tuning at all,
// so sharing it is a plain, low-risk deduplication rather than the codegen-risking kind
// [[feedback_shared_ubo_duplication]]/CLAUDE.md's optDepth cautionary tale warns about:
// beamLightCount was already a runtime (not compile-time-unrolled) trip count in the original
// cloud-only version, so factoring it out loses no unrolling that existed before.
//
// Takes the evaluation point (`p`/`h`, works for a cloud OR fog sample) and `sampleDayness`
// (each caller's own per-sample geographic day/night gate, computed the same way both places).
// Height-cutoff note: fog's own `h` is always far below any target's `blockAltM` (a quantity
// derived from a march through the 2-11km CLOUD shell), so whenever `blockOpacity>0` the
// smoothstep already reads as "fully blocked" for a fog-altitude sample — a beam blocked by
// opaque cloud above therefore also doesn't light fog below it, with no extra code.
vec3 beamCloudLighting(vec3 p, float h, vec3 dir, vec3 obsPos, float sampleDayness) {
    vec3 beamLit = vec3(0.0);
    if ((pc.debugDisableMask & 128u) != 0u || pc.beamSkyGlowGain <= 0.0) return beamLit;

    // First-pass guess — matches the deleted tube's kBeamScale order of magnitude, since it
    // multiplies the same groundIrradiance-scale intensity value. Expect retuning once seen
    // in-app, same as every other C12 constant on first landing.
    const float kBeamCloudGlowScale = 1e-6;
    const float kCloudFeatherM = 500.0; // soft edge width for the height cutoff below
    // Perf (C11/C12 follow-up #48): fixed-sigma cutoff BEFORE the exp() call, not an absolute-
    // magnitude threshold — comparing raw magnitude against a fixed value (as follow-up #45's
    // live-march gate mistakenly did) extends the "relevant" radius further for a brighter target,
    // exactly backwards from what a rejection test should do. A Gaussian is already ~1.5e-6 of its
    // OWN peak at 5 sigma regardless of amplitude, so a fixed sigma multiple on `radius` bounds the
    // truly-negligible tail the same way for every target, dim or bright. This is what actually
    // bounds the measured "halved near any active site" cost: targets are kept in beamLights[] out
    // to beamMaxRangeM (can be >1000km) for range-check purposes, but their visual footprint is
    // only a few km — so most in-cloud/in-fog samples anywhere in view were paying for a full
    // exp() every time despite being nowhere near that target's actual few-km-wide glow.
    const float kBeamCutoffSigma = 4.0;
    float beamMag = 0.0;
    for (uint bli = 0u; bli < beamLightCount; ++bli) {
        vec3  targetWorldPos = obsPos + beamLights[bli].targetENU;
        vec2  delta  = p.xy - targetWorldPos.xy;
        float distSq = dot(delta, delta);
        float radius = max(beamLights[bli].footprintRadM, 100.0);
        float cutoff = radius * kBeamCutoffSigma;
        if (distSq > cutoff * cutoff) continue;
        float g = beamLights[bli].aggIntensity * exp(-distSq / (2.0 * radius * radius));
        float hCut = smoothstep(beamLights[bli].blockAltM - kCloudFeatherM,
                                  beamLights[bli].blockAltM, h);
        float hFadeBeam = mix(1.0, hCut, beamLights[bli].blockOpacity);
        beamMag += g * hFadeBeam;
    }

    // View-angle directional shading (see this function's header comment): a beam is a
    // near-vertical light column, so the direction FROM this sample TOWARD its source is
    // approximately local zenith — `normalize(p)` gives that exactly in this file's local
    // ENU-ish frame. Reuses the same phaseCloud() Henyey-Greenstein lobe the sun/moon terms
    // already use, so looking up along a beam reads as a brighter forward-scattered shaft.
    vec3  beamUpDir = normalize(p);
    float beamPh    = phaseCloud(dot(dir, beamUpDir));
    beamLit = vec3(1.0, 0.97, 0.92) * beamMag * beamPh * pc.beamSkyGlowGain
            * (1.0 - sampleDayness) * kBeamCloudGlowScale;
    return beamLit;
}

// ── cloudMarchCS / cirrusMarchCS ───────────────────────────────────────────────
// Restructured from sat_sky.frag's cloudMarch/cirrusMarch: instead of mutating an inout `color`,
// each returns the (A, B) pair of its affine composite (`color_out = color_in*A + B`) directly,
// so the caller can combine cirrus-then-cloud into one (A_total, B_total) pair algebraically —
// see the plan's "Why two RGBA16F targets" section. No terrain clipping here (no tSurface param;
// the `if (tSurface > 0.0) tExit = min(tExit, tSurface);` lines from the original are removed).
// CLOUD_DEBUG diagnostic overlays from the original are not ported — always CLOUD_DEBUG==0 here.

void cloudMarchCS(
    vec3  obsPos,  vec3  dir,
    vec3  enuX,    vec3  enuY,        vec3  enuZ,
    vec3  sunDir,  vec3  sunDirECEF,  float obsEffH,
    vec4  moonDirENU,
    out   vec3  A_cloud, out vec3 B_cloud,
    out   vec3  cloudTOut,
    out   float tCloudOcclude,
    float tScene)  // shared scene depth (metres to the first surface, or kNoSurfaceT)
{
    // Runtime-tunable scattering strength — see cloud_params.glsl's atmosRayleighGain/
    // atmosMieGain comment and common.glsl's BETA_R_BASE/BETA_M_BASE.
    vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
    float BETA_M = BETA_M_BASE * cloud.atmosMieGain;

    A_cloud = vec3(1.0);
    B_cloud = vec3(0.0);
    cloudTOut = vec3(1.0);
    tCloudOcclude = -1.0;
    if (cloud.layers[0].enabled < 0.5) return;

    float cloudAltFade = 1.0 - smoothstep(kCloud3DFadeStart, kCloud3DFadeEnd, obsEffH);
    if (cloudAltFade < 0.001) return;

    float cloudBaseAlt = cloud.layers[0].shellAltM;
    float cloudTopAlt  = cloud.layers[1].shellAltM;
    float shellThick   = cloudTopAlt - cloudBaseAlt;
    float cloudBase    = R_EARTH + cloudBaseAlt;
    float cloudTop     = R_EARTH + cloudTopAlt;

    vec2 shellB = raySphere(obsPos, dir, cloudBase);
    vec2 shellT = raySphere(obsPos, dir, cloudTop);

    float tEnter, tExit;
    bool  obsInsideShell = (obsEffH >= cloudBaseAlt && obsEffH <= cloudTopAlt);

    if (obsEffH < cloudBaseAlt) {
        tEnter = shellB.y;
        tExit  = shellT.y;
    } else if (obsEffH <= cloudTopAlt) {
        tEnter = 0.001;
        tExit  = shellT.y;
        if (shellB.x > 0.001 && shellB.x < tExit) tExit = shellB.x;
    } else {
        if (shellT.x < 0.0) return;
        tEnter = shellT.x;
        tExit  = (shellB.x > 0.0) ? shellB.x : shellT.y;
    }

    // Terrain occlusion, applied to THIS layer's own bounds. Terrain nearer than the shell entry
    // means the ray never reaches cloud at all; terrain inside the shell truncates the march part
    // way — a ridge poking into the deck now correctly cuts the cloud behind it, which the old
    // shared post-hoc gate explicitly could not do (it could only suppress all layers or none).
    if (tEnter >= tScene) return;
    tExit = min(tExit, tScene);

    // Distance-based 3D->2D crossfade. This, not maxRenderDistM, is what actually bounds the
    // march: maxRenderDistM caps the span from tEnter, which from orbit is only the ~9 km shell
    // crossing and therefore never binds no matter how low it is set. Keying on tEnter — how far
    // away the clouds on this ray are — makes the fade cheap where it matters, because a fully
    // faded ray returns here before the coverage lookup, the step-count setup or the march.
    // It also gives a horizon transition from the ground, which an altitude-only fade cannot.
    //
    // NOTE: tEnter is pinned to ~0 when the observer is inside the shell, so this fade never
    // engages there (see [[project_cloud_inside_shell_rejection_bug]] for the full analysis). A
    // fix keying this off tExit instead when inside the shell was tried and REVERTED — it produced
    // a large gap/hole through the middle of the cloud layer and broke rendering outright. Root
    // cause not yet understood; likely tExit's own behaviour is far less well-behaved near the
    // shell's tangent/grazing angles than assumed. Do not retry the same approach without figuring
    // out why first.
    float cloudDistFade = 1.0 - smoothstep(cloud.cloudDistFadeStartM, cloud.cloudDistFadeEndM, tEnter);
    cloudAltFade = min(cloudAltFade, cloudDistFade);
    if (cloudAltFade < 0.001) return;

    tExit = min(tExit, tEnter + cloud.maxRenderDistM);
    if (tEnter >= tExit || tExit <= 0.0) return;

    {
        // The rejection point normally IS the shell entry (tEnter) — a real, direction-dependent
        // position when the observer is below or above the shell. When the observer is INSIDE the
        // shell, tEnter is pinned to ~0 (the march starts immediately, right where the camera is),
        // so `obsPos + tEnter*dir` collapses to the observer's OWN geographic column regardless of
        // `dir` — the coarse mip-4 sample then just re-reads whatever's directly overhead/underfoot
        // and rejects the ENTIRE march for every ray on the screen whenever that one column happens
        // to be clear, even while genuinely looking at cloud elsewhere. Reported as clouds cutting
        // out and deforming near the horizon starting around the low shell altitude, and vanishing
        // outright (every cloud on screen) while flying inside the shell away from directly-overhead
        // cloud. Use a forward point along THIS ray instead when inside the shell — clamped so a
        // near-horizontal ray doesn't sample absurdly far away, and a near-vertical ray (small
        // tExit already) isn't pushed past its own real shell crossing.
        float covT  = obsInsideShell ? clamp(tExit, 2000.0, 40000.0) : tEnter;
        vec3  ePt   = obsPos + covT * dir;
        vec3  eECEF = ePt.x * enuX + ePt.y * enuY + ePt.z * enuZ;
        float eLen  = length(eECEF);
        float eLon  = atan(eECEF.y, eECEF.x);
        float eLat  = asin(clamp(eECEF.z / eLen, -1.0, 1.0));
        vec2  eUV   = vec2(fract((eLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                           (0.5*PI - eLat) / PI);
        // DELIBERATELY coarser than cloud.coverageMipLod, and deliberately not tunable.
        // This is a whole-column rejection test taken from a SINGLE point (the shell entry, or the
        // forward point above when inside the shell), used to skip the march entirely. A blurry
        // read is what makes that single sample representative of the column's neighbourhood.
        // Sampling it sharply would let a ray reject because its entry point happened to land in a
        // gap between two cloud cells even though it passes through plenty of cloud further along —
        // holes and popping, not detail. A rejection test wants to be conservative; only the
        // per-sample lookups want to be sharp.
        const float kCoverageRejectMipLod = 4.0;
        float cMap  = textureLod(earthCloudsTex, eUV, kCoverageRejectMipLod).r;
        if (cloud.coverage * cMap < 0.02) return;
    }

    vec3 sunColorCloud = vec3(0.0);
    {
        vec3 p0  = obsPos + tEnter * dir;
        vec2 tSE = raySphere(p0, sunDir, R_EARTH);
        if (!(tSE.x > 0.0 && tSE.y > 0.0)) {
            vec2 tSA = raySphere(p0, sunDir, R_ATMOS);
            if (tSA.y > 0.0) {
                vec2 sOD = optDepth(p0, sunDir, tSA.y);
                sunColorCloud = SUN_INTENSITY * exp(-(BETA_R * sOD.x + BETA_M * 1.1 * sOD.y));
            }
        }
    }

    vec3 skyAmbientBase = vec3(0.0);
    {
        // Anchored at the CLOUD, not at the observer: p0 is the march's shell entry point. This
        // term is "how bright is the sky lighting this cloud", so it has to be sampled where the
        // cloud is.
        //
        // It was previously anchored at obsPos, which is only equivalent when the observer is
        // essentially co-located with the clouds — true from the surface, badly false from orbit.
        // From LEO you can be over the night side looking at clouds on the terminator: the
        // per-sample twilight bell (cloudSunDotRaw) correctly says "full twilight", while
        // skyAmbientBase sampled at your own position says "night, ~0". Zero times any gain is
        // still zero, which is why cranking the twilight gain did nothing from orbit while working
        // fine from the ground.
        //
        // An earlier round tried to fix that by clamping the obsPos anchor into the atmosphere
        // (above R_ATMOS the outward zenith ray never re-enters, so tSA.y <= 0 and the whole term
        // was EXACTLY zero). That was a real bug and the clamp was necessary, but it was not
        // sufficient — it fixed "the anchor is in vacuum" without fixing "the anchor is in the
        // wrong place".
        //
        // Why the original obsPos switch is safe to undo: it was made because a distant entry
        // point on a grazing ray could smear unrepresentative conditions across the horizon band.
        // The twilight bell did not exist yet at that point. It does now, and it gates per-sample
        // on the sample's OWN sun angle, so a daylit distant column can no longer leak onto night
        // clouds regardless of what the anchor reads. If the horizon artifact returns, that gate
        // is the thing to look at, not this anchor.
        //
        // The entry point is on the cloud shell by construction, so it is always at 2-11 km — well
        // inside the atmosphere. The clamp is kept purely as a guard.
        const float kAmbientAnchorMaxAltM = 60000.0;   // safely inside R_ATMOS (= R_EARTH + 100km)
        vec3  pEntry     = obsPos + tEnter * dir;
        float anchorAltM = min(length(pEntry) - R_EARTH, kAmbientAnchorMaxAltM);
        vec3 p0     = normalize(pEntry) * (R_EARTH + max(anchorAltM, 0.0));
        vec3 zenith = normalize(p0);
        vec2 tSA    = raySphere(p0, zenith, R_ATMOS);
        if (tSA.y > 0.0) {
            const int N_Z = 6;
            float zSeg    = tSA.y / float(N_Z);
            float cosAUp  = dot(zenith, sunDir);
            float pR_up   = 0.75 * (1.0 + cosAUp * cosAUp);
            float odR_z = 0.0, odM_z = 0.0;
            float skyAmbientBaseM = 0.0;
            for (int zi = 0; zi < N_Z; ++zi) {
                vec3  sp = p0 + zenith * ((float(zi) + 0.5) * zSeg);
                float h  = max(0.0, length(sp) - R_EARTH);
                float dR = exp(-h / H_R) * zSeg;
                float dM = exp(-h / H_M) * zSeg;
                odR_z += dR;  odM_z += dM;
                vec2 tSE = raySphere(sp, sunDir, R_EARTH);
                if (tSE.x > 0.0 && tSE.y > 0.0) continue;
                vec2 tSun = raySphere(sp, sunDir, R_ATMOS);
                vec2 sunOD = (tSun.y > 0.0) ? optDepth(sp, sunDir, tSun.y) : vec2(0.0);
                vec3 tau      = BETA_R * (odR_z + sunOD.x) + BETA_M * 1.1 * (odM_z + sunOD.y);
                vec3 attnStep = exp(-tau);
                skyAmbientBase  += attnStep * dR;
                skyAmbientBaseM += dot(attnStep, vec3(1.0 / 3.0)) * dM;
            }
            float pM_up = phaseM(cosAUp);
            skyAmbientBase = SUN_INTENSITY * (pR_up * BETA_R * skyAmbientBase
                                            + vec3(pM_up * BETA_M * skyAmbientBaseM));
        }
    }

    vec3  cloudTransmittance = vec3(1.0);
    vec3  cloudScatter       = vec3(0.0);
    // Transmittance-weighted mean sample distance — see its use below at odAtmCloud/cloudAttn for
    // why this exists instead of just using tEnter.
    float cloudDistAccum   = 0.0;
    float cloudWeightAccum = 0.0;
    float groundSteps = max(2.0, cloud.marchSteps);
    float stepAltT    = smoothstep(kMarchStepsAltStart, kMarchStepsAltEnd, obsEffH);
    int   N           = max(8, int(mix(groundSteps, kMarchStepsFloor, stepAltT)));
    float dh_dt       = max(abs(dir.z), 0.02);
    const float kCloudMaxStepM = 250.0;
    float stepLen = min((shellThick / float(N)) / dh_dt, kCloudMaxStepM);
    bool  insideShell = (obsEffH >= cloudBaseAlt && obsEffH <= cloudTopAlt);
    float bigStep = insideShell ? stepLen : stepLen * 2.0;
    float t       = tEnter;
    bool  inCloud = false;
    float cosA    = dot(dir, sunDir);
    float ph      = phaseCloud(cosA);
    vec3  moonDir3 = normalize(moonDirENU.xyz);
    float cosAMoon = dot(dir, moonDir3);
    float phMoon   = phaseCloud(cosAMoon);

    // Raised 2048->4096 (session 28 follow-up #10): with maxRenderDistM pushed out to actually
    // reach the cloud shell's own horizon (see that field's comment), the old 2048 ceiling could
    // itself become the binding cutoff before maxRenderDistM did. Margin raised again (follow-up
    // #14): at the 400km default, covering the full distance at kCloudMaxStepM=250m needs exactly
    // 1600 steps — the flat "+32" margin left only 32 steps of slack, uncomfortably close to the
    // exact requirement for a ray that's "in cloud" (the finer stepLen, not the coarser bigStep)
    // continuously the whole way, which is precisely the dense-horizon-cloud case this exists to
    // handle. A 15% multiplicative margin plus a larger flat floor scales proportionally instead of
    // staying fixed as maxRenderDistM grows.
    int hardCap = min(8192, int(cloud.maxRenderDistM / kCloudMaxStepM * 1.15) + 64);
    for (int i = 0; i < hardCap && t < tExit; ++i) {
        float step = inCloud ? stepLen : bigStep;
        step = min(step, tExit - t);
        vec3  p = obsPos + (t + step * 0.5) * dir;
        float h = length(p) - R_EARTH;
        if (h < cloudBaseAlt || h > cloudTopAlt) { inCloud = false; t += step; continue; }

        float hNorm = (h - cloudBaseAlt) / shellThick;
        vec3  pECEF = p.x * enuX + p.y * enuY + p.z * enuZ;

        // Hoisted up from its old spot further below (next to sunElev/selfShadow) so the self-
        // shadow cone's grazing-angle compensation can use it too — same value, computed once.
        float cloudSunDotRaw = dot(normalize(pECEF), sunDirECEF);

        float pLen  = length(pECEF);
        float pLon  = atan(pECEF.y, pECEF.x);
        float pLat  = asin(clamp(pECEF.z / pLen, -1.0, 1.0));
        vec2  pUV   = vec2(fract((pLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                           (0.5*PI - pLat) / PI);
        vec2  pUVGeo = vec2(fract((pLon + PI) / (2.0*PI)), (0.5*PI - pLat) / PI);
        // Per-sample coverage — this is the lookup that decides cloud SHAPE, so it takes the
        // tunable mip. Aliasing risk from the march itself is low: even mip 0 is ~4.9 km/texel
        // against a <=250 m step (kCloudMaxStepM), so the march oversamples it heavily.
        float localCov = cloud.coverage * textureLod(earthCloudsTex, pUV, cloud.coverageMipLod).r;

        vec3  dirECEF      = pECEF / pLen;
        vec3  dirECEFDrift = rotateZ(dirECEF, cloud.cloudPhase * cloud.layers[0].driftMult);
        vec3  warpUVW      = cloudWarpOffset(dirECEFDrift);

        float colNoise = texture(cloudNoiseTex,
                                 dirECEFDrift * kCloudColFreq + warpUVW + vec3(0.0, 0.0, 0.25)).r;
        float colH = remap(colNoise, 1.0 - localCov, 1.0, 0.0, 1.0);

        // Variable base height: was a hardcoded 0.0 for every column, so every cloud in the shell
        // shared exactly the same base altitude — a perfectly flat deck. baseNoise reuses the same
        // warped horizontal coordinate as colH (so the undulation follows the same drifting cloud
        // field) but a decorrelated fixed Z offset, scaled by cloud.cloudBaseVariance (settings
        // "Base variance"; 0 reproduces the old flat-base behavior exactly).
        float baseNoise = texture(cloudNoiseTex,
                                  dirECEFDrift * kCloudColFreq + warpUVW + vec3(0.0, 0.0, 0.85)).r;
        float baseH = (baseNoise - 0.5) * cloud.cloudBaseVariance;

        float topFade = 1.0 - smoothstep(colH - 0.05, colH + 0.05, hNorm);
        float hFade = smoothstep(baseH, baseH + 0.05, hNorm) * topFade;
        if (hFade < 0.001) { inCloud = false; t += step; continue; }

        const float kVertTiles = 1.5;
        float posZ    = sin(pUV.x * 21.3 + pUV.y * 17.7) * 0.5 + 0.5;
        vec3  uvwXY   = dirECEFDrift * kCloudHorizFreq + warpUVW;
        vec3  uvwDetail = uvwXY
                               + vec3(0.0, 0.0, hNorm * kVertTiles + posZ * 2.0);
        float d = cloudDensity(uvwXY, uvwDetail, hNorm, localCov, cloud.density, hFade);

        if (d > 0.001) {
            inCloud = true;
            // cloud.cloudOpacityScale (default 1.0, settings "Opacity scale"): d is clamped to
            // [0,1] above, so `density` alone cannot push a saturated column past whatever
            // opacity this fixed extinction-per-metre constant gives.
            //
            // A flat multiplier on extinction (the first attempt) scaled EVERY sample equally,
            // including the thin erosion-carved wisps at a cloud's own silhouette — those need
            // only a little accumulated depth to fully extinguish once boosted, so raising the
            // scale to fix opaque cores also flattened soft edges into a hard silhouette,
            // reported as clouds losing their fluffy look.
            //
            // Fix: ramp the boost in from 1.0 (no change) using how much transmittance THIS RAY
            // has already lost before this sample, not a flat constant. A ray still near
            // cloudTransmittance≈1 is, by definition, still in the thin entry/edge region — it
            // gets none of the extra boost, so edges keep their original unscaled softness
            // exactly. Only once a column has already proven itself genuinely thick (transmittance
            // dropping) does the boost ramp toward the full scale, accelerating an
            // already-committed thick core the rest of the way to true opacity. Self-reinforcing:
            // the boost grows because the column is getting thicker, not because of raw density
            // alone, so a moderately dense but genuine cloud deck (not just its silhouette wisps)
            // reliably converges to opaque instead of only the mathematical d=1 extreme.
            float coreBoost  = 1.0 + (cloud.cloudOpacityScale - 1.0) * (1.0 - cloudTransmittance.r);
            float extinction = d * step * 3e-3 * coreBoost;
            vec3  stepT      = exp(-vec3(extinction));
            float powder     = 1.0 - exp(-extinction * 2.0);

            float sampleDist = t + step * 0.5;
            float shadowFade = 1.0 - smoothstep(cloud.shadowMaxDistM * 0.6, cloud.shadowMaxDistM, sampleDist);
            float sunOptDepth = 0.0;
            if (shadowFade > 0.01 && (pc.debugDisableMask & 64u) == 0u) {
                int   N_CONE    = max(1, int(cloud.lightSteps));
                vec2  tConeExit = raySphere(p, sunDir, cloudTop);
                float coneLen   = min((tConeExit.y > 0.0) ? tConeExit.y : shellThick, shellThick * 2.0);
                float coneSeg   = coneLen / float(N_CONE);
                // Per-invocation jitter on the cone's sample phase: a FIXED (ci+0.5) offset means
                // every in-cloud sample's shadow cone is phase-locked to the same lattice through
                // structured (Worley) noise sampled along one constant global direction (sunDir) —
                // that's a textbook aliasing setup, and it read as coherent parallel-line banding
                // in cloud shadows. Same noiseTex dither pattern cirrusMarchCS already uses.
                float coneJitter = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).g;
                for (int ci = 0; ci < N_CONE; ++ci) {
                    vec3  cp    = p + sunDir * (float(ci) + coneJitter) * coneSeg;
                    float ch    = length(cp) - R_EARTH;
                    if (ch < cloudBaseAlt || ch > cloudTopAlt) continue;
                    float chN   = (ch - cloudBaseAlt) / shellThick;
                    vec3  cpE   = cp.x * enuX + cp.y * enuY + cp.z * enuZ;
                    float cpL   = length(cpE);
                    float cpLon = atan(cpE.y, cpE.x);
                    float cpLat = asin(clamp(cpE.z / cpL, -1.0, 1.0));
                    vec2  cpUV  = vec2(fract((cpLon + PI) / (2.0*PI)
                                       + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                                      (0.5*PI - cpLat) / PI);
                    // One mip coarser than the view march, preserving the previous relationship
                    // (was a fixed 5.0 against the view march's 4.0). Self-shadowing does not need
                    // the fine detail, and this is the hottest lookup in the shader — it runs per
                    // cone step per in-cloud sample.
                    float cLoc  = cloud.coverage * textureLod(earthCloudsTex, cpUV, cloud.coverageMipLod + 1.0).r;
                    if (cLoc < 0.02) continue;
                    float cPosZ      = sin(cpUV.x * 21.3 + cpUV.y * 17.7) * 0.5 + 0.5;
                    vec3  cDir       = cpE / cpL;
                    vec3  cDirDrift  = rotateZ(cDir, cloud.cloudPhase * cloud.layers[0].driftMult);
                    // Reuse the PARENT sample's already-computed warp offset instead of calling
                    // cloudWarpOffset (3 warpPerlin3 evaluations) again per cone step — perf
                    // (this session): cone samples sit within ~2*shellThick of p along sunDir,
                    // a few km at most, which is a negligible angular displacement against
                    // kWarpFreq=6's basis over the full unit sphere. This was the single biggest
                    // new cost from making the shadow cone warp-consistent with the visible cloud.
                    vec3  cWarpUVW   = warpUVW;
                    vec3  cUVWXY = cDirDrift * kCloudHorizFreq + cWarpUVW;
                    vec3  cUVWD  = cUVWXY + vec3(0.0, 0.0, chN * kVertTiles + cPosZ * 2.0);

                    // Match the cone's own vertical coverage limit and base variance to the SAME
                    // per-column noise the visible march uses (colH/baseH above) — without this the
                    // cone treated the whole 5%-95% of the shell as potential cloud regardless of
                    // how little of that column the visible march actually filled in, so a nearly-
                    // clear column (or one whose visible cloud is only a single-step sliver) could
                    // still cast a full-height shadow with no corresponding visible cloud.
                    float cColNoise  = texture(cloudNoiseTex, cDirDrift * kCloudColFreq + cWarpUVW + vec3(0.0, 0.0, 0.25)).r;
                    float cColH      = remap(cColNoise, 1.0 - cLoc, 1.0, 0.0, 1.0);
                    float cBaseNoise = texture(cloudNoiseTex, cDirDrift * kCloudColFreq + cWarpUVW + vec3(0.0, 0.0, 0.85)).r;
                    float cBaseH     = (cBaseNoise - 0.5) * cloud.cloudBaseVariance;
                    float chFade = smoothstep(cBaseH, cBaseH + 0.05, chN) * (1.0 - smoothstep(cColH - 0.05, cColH + 0.05, chN));
                    sunOptDepth += cloudDensity(cUVWXY, cUVWD, chN, cLoc, cloud.density, chFade) * coneSeg * 3.75e-4;
                }
                sunOptDepth *= shadowFade;

                // Grazing-sun attenuation: at sunset the light-march cone above (only ~N_CONE
                // samples, a handful by default) traverses the shell almost tangentially, so with
                // this coverage map reading fairly uniform at the cone's short fixed reach, most
                // samples land in cloud and sunOptDepth comes out uniformly high — reported as the
                // whole visible cloud field going into flat shadow at sunset, well before the sun
                // is actually at a shallow enough angle for that much mutual occlusion. (An earlier
                // attempt fixed this by extending coneLen itself at grazing angles instead, but
                // with a low, GPU-cost-bound N_CONE that just undersampled a longer path — visible
                // as banding, and shadow no longer tied to actual cloud shape. Reverted above.)
                // This instead directly damps the RESULT at low sun elevation, leaving the cone's
                // sampling geometry untouched (so it stays fully correlated with cloud shape) —
                // less physically rigorous, but matches the existing shadowFloor/selfShadow
                // heuristic below, which already fudges the same sunset transition for the same
                // reason.
                float sunElevSin = clamp(abs(cloudSunDotRaw), 0.0, 1.0);
                float grazeAtten = mix(kGrazeShadowFloor, 1.0, smoothstep(0.0, kGrazeShadowFullSin, sunElevSin));
                sunOptDepth *= grazeAtten;
            }

            float ms1 = exp(-sunOptDepth);
            float ms2 = exp(-sunOptDepth * 0.5) * 0.5;
            float ms3 = exp(-sunOptDepth * 0.25) * 0.25;
            float sunTransmittance = max((ms1 + ms2 + ms3) / 1.75, 0.05);

            float sunElev     = smoothstep(-0.04, 0.12, cloudSunDotRaw);
            float sunElevSoft = sunElev;
            float shadowFloor = mix(0.1, 0.5, clamp(1.0 - sunElev * 4.0, 0.0, 1.0));
            float selfShadow  = mix(shadowFloor, 1.0, hNorm);
            float sunLit      = sunElevSoft * sunTransmittance * selfShadow;

            float sampleDayness = clamp((cloudSunDotRaw + 0.2) / 0.5, 0.0, 1.0);

            // skyAmbientBase (the analytic single-scattering zenith Rayleigh/Mie integral, sampled
            // once per frame at the observer) represents zenith-scattered SUNLIGHT and genuinely
            // decays toward true night — but not fast enough on its own: it only zeroes out once
            // the sun ray to every sample along the zenith column is Earth-blocked, which can
            // still be a while (and depends on the OBSERVER's own position, not this cloud
            // sample's) after this particular sample has visually gone dark. Originally this term
            // was left completely ungated (read as a lit sky-colored haze even at true night); a
            // first fix gated it by (1-sampleDayness), which only ramps IN toward night and never
            // back out, so it stayed at full strength indefinitely once past the terminator —
            // reported as overbright at night. twilightWeight is instead a proper bell: it rises
            // approaching dusk and falls again deeper into night, so this term is twilight-only,
            // as intended, and skyAmbientBase's own slow decay no longer has to do all the work.
            //
            // Both edges of the bell are tunable, because where it STARTS turned out to matter as
            // much as its height. The original hardcoded rise band (-0.05..0.15) did not reach
            // full strength until the sun was already ~3 degrees below the horizon, while the
            // direct-sun term (sunElev, smoothstep(-0.04, 0.12, ...)) had died at ~2 degrees
            // below. Between those two lay a band where clouds had lost the sun and not yet
            // gained the sky — reported as white -> orange -> BLACK -> blue -> black through a
            // single sunset. Raising twilightBandHi slides the whole rise earlier so the sky term
            // is already contributing while the last direct light is fading, closing the gap.
            //
            // Widths are fixed; only the edges move. kTwilightRiseWidth matches the original band
            // (0.15 - -0.05) and kTwilightFallWidth the original (-0.15 - -0.45), so setting
            // Hi = 0.15 / Lo = -0.45 reproduces the previous behaviour exactly.
            const float kTwilightRiseWidth = 0.2;
            const float kTwilightFallWidth = 0.3;
            float twiHi = cloud.twilightBandHi;
            float twiLo = cloud.twilightBandLo;
            float twilightRise = 1.0 - smoothstep(twiHi - kTwilightRiseWidth, twiHi, cloudSunDotRaw);
            float twilightFall = smoothstep(twiLo, twiLo + kTwilightFallWidth, cloudSunDotRaw);
            float twilightWeight = twilightRise * twilightFall;
            // cloud.cloudTwilightAmbientGain is the manual control over this: sky-lit cloud at
            // dusk/dawn, so clouds read consistently against the sky-lit TERRAIN beside them
            // instead of dropping dark while the ground is still visibly blue. Twilight-only by
            // construction — twilightWeight is a bell, not a step, so this contributes nothing in
            // full daylight and nothing in full night.
            vec3 twilightAmbient = skyAmbientBase * mix(0.3, 0.9, hNorm) * twilightWeight
                                 * cloud.cloudTwilightAmbientGain;

            // (a non-decaying nightFloorAmbient term lived here, gated by (1-sampleDayness) so it
            //  ramped up through twilight and then HELD through the night. It was dead code —
            //  computed and discarded — and briefly enabled before being removed outright: a floor
            //  that persists into full night is the wrong effect. What was actually wanted is a
            //  twilight-only term, which twilightAmbient above already is by construction, since
            //  twilightWeight is a bell that falls back to zero deeper into night.)
            vec3 skyAmbient = twilightAmbient;

            vec3  moonECEF_c    = moonDir3.x * enuX + moonDir3.y * enuY + moonDir3.z * enuZ;
            float moonElevGeog  = max(0.0, dot(normalize(pECEF), moonECEF_c));
            float moonLit       = moonElevGeog * moonDirENU.w * selfShadow * (1.0 + powder);
            float nightFac      = 1.0 - min(sampleDayness * 3.0, 1.0);
            vec3  moonContrib   = vec3(0.92, 0.95, 1.0) * moonLit * phMoon * cloud.moonGain * nightFac;

            vec3 cityUp = vec3(0.0);
            if (sampleDayness < 0.9 && hNorm < 0.45) {
                vec3  cityRgb  = textureLod(earthNightTex, pUVGeo, 3.0).rgb;
                float cityLum  = dot(cityRgb, vec3(0.2126, 0.7152, 0.0722));
                vec3  cityTint = cityRgb / max(cityLum, 0.001);
                float heightFalloff = smoothstep(0.45, 0.0, hNorm);
                cityUp = cityTint * cityBrightness(cityLum) * heightFalloff * (1.0 - sampleDayness)
                       * kCityUpwellStrength * cloud.ambientGain;
            }

            // Aurora ground-glow: the curtain sits far above the cloud shell (95-300km vs. 2-11km),
            // so unlike cityUp (which washes the cloud BASE from below), this lights cloud TOPS
            // more than bases — opposite height falloff. Evaluated LOCALLY at this sample's own
            // dirECEF (auroraOvalMaskLocal above), not a CPU-computed observer-position proxy.
            float auroraLocalMask = auroraOvalMaskLocal(dirECEF, pc.waveTime, cloud.stormStrength);
            vec3  auroraUp        = kAuroraGroundColor * auroraLocalMask * cloud.auroraCloudGain
                                   * (1.0 - sampleDayness) * mix(0.2, 1.0, hNorm);

            // Reflect-Orbital beam->cloud illumination (C12 follow-up #44, factored into the
            // shared beamCloudLighting() in follow-up #47 so fogMarchCS can reuse it verbatim) —
            // replaces the deleted analytic sky tube outright. Naturally invisible in clear air
            // (this whole branch only runs where d>0.001, i.e. real cloud density already exists
            // here) and naturally respects terrain/cloud depth ordering (p/tExit are already
            // clipped to tScene and composited through cloudTransmittance like every other term in
            // this loop) — no separate occlusion march or cloud-cutoff fade needed, unlike the
            // deleted tube. See beamCloudLighting()'s own header comment for the height-cutoff/
            // view-angle design.
            vec3 beamLit = beamCloudLighting(p, h, dir, obsPos, sampleDayness);

            // Sun gain blended by sun elevation: cloud.sunGain (near-horizon/sunset) tuned high
            // reads as an amazing sunset, but the SAME flat gain applied at midday (sun near
            // zenith) overexposes the whole cloud deck — cloudSunDotRaw is already ~sin(sun
            // elevation) at this point on Earth, so 0=horizon/sunset, 1=overhead/midday.
            // Blend band is now cloud.sunGainElevBand rather than a hardcoded [0,1]. At [0,1]
            // the sunset gain was still half-strength at 30 degrees of sun elevation, so it hung
            // over most of the morning; the default 0.25 hands over to the zenith gain by ~14.5
            // degrees. Same curve shape, just reaches the top far sooner.
            float sunGainCurve = mix(cloud.sunGain, cloud.sunGainZenith,
                                      smoothstep(0.0, max(cloud.sunGainElevBand, 0.02),
                                                 clamp(cloudSunDotRaw, 0.0, 1.0)));
            vec3  inScatter  = sunColorCloud * sunLit * ph * (1.0 + powder) * sunGainCurve
                             + moonContrib
                             + skyAmbient
                             + cityUp
                             + auroraUp
                             + beamLit;

            cloudScatter       += cloudTransmittance * (1.0 - stepT) * inScatter;
            // Same weight cloudScatter itself uses (.r stands in for the scalar, per stepT's own
            // exp(-vec3(extinction)) broadcast — all three channels are identical here), applied to
            // this step's own distance instead of its inScatter color.
            float wStep = cloudTransmittance.r * (1.0 - stepT.r);
            cloudDistAccum   += wStep * (t + step * 0.5);
            cloudWeightAccum += wStep;
            cloudTransmittance *= stepT;

            if (cloudTransmittance.r < 0.01) break;
        } else {
            inCloud = false;
        }
        t += step;
    }

    cloudTOut = mix(vec3(1.0), cloudTransmittance, cloudAltFade);
    if (dot(cloudTOut, vec3(1.0/3.0)) < 0.1 && cloudAltFade > 0.1) tCloudOcclude = tEnter;

    // Camera-to-cloud atmospheric extinction. Distance used here MUST be where the visible cloud
    // material actually is, not tEnter — tEnter is only that when the observer is BELOW the shell
    // (tEnter = the real distance light travels through atmosphere before reaching cloud). When
    // the observer is INSIDE the shell (obsEffH between the base and top altitude), tEnter is
    // pinned to 0.001 (the march starts immediately, since cloud may be right where you are) — but
    // a horizon-ward ray from inside the shell can still travel tens of km through the shell before
    // meeting real density. Using tEnter there collapses odAtmCloud to ~0, i.e. zero extinction
    // regardless of how far away the visible cloud on that ray actually is — reported as clouds on
    // the horizon suddenly rendering with no atmospheric fade at all only while the observer's own
    // altitude sits inside the cloud layer, correct again both below and above it (where tEnter is
    // meaningful again). cloudDistAccum/cloudWeightAccum give the transmittance-weighted mean
    // sample distance instead — where the accumulated scattering in cloudScatter actually came
    // from — which reduces to ~tEnter in the below/above cases (the march starts hitting density
    // right at shell entry there) and correctly picks up the real horizon-ward travel distance in
    // the inside-shell case, with no special-casing needed for any of the three observer positions.
    float cloudMeanT = (cloudWeightAccum > 1e-4) ? (cloudDistAccum / cloudWeightAccum) : tEnter;
    vec2 odAtmCloud = optDepth(obsPos, dir, max(cloudMeanT, 0.001));
    vec3 cloudAttn  = exp(-(BETA_R * odAtmCloud.x + BETA_M * 1.1 * odAtmCloud.y));

    // A_cloud is the multiplicative term applied to `color` in sat_sky.frag — and `color` at that
    // point already carries FULL camera-to-surface atmospheric transmittance (odR_cam/odM_cam,
    // truncated at tSurface — see sat_sky.frag's surfAttn comment). cloudAttn here is only the
    // camera-to-cloud SUBSET of that same path, so folding it into A_cloud (as `1 - cloudAttn*(1-
    // cloudTOut)` used to) double-counts that segment's extinction AND, worse, leaks a constant
    // `1-cloudAttn` fraction of background through even a perfectly opaque cloud (cloudTOut=0) —
    // it never converges to true occlusion. That read as "even the densest clouds are semi-
    // transparent to city lights," worst from altitude/distance where cloudAttn is furthest below
    // 1. A_cloud must depend on cloudTOut alone; cloudAttn still legitimately dims the cloud's OWN
    // scattered light in B_cloud below, which has no other atmospheric attenuation applied to it.
    A_cloud = cloudTOut;

    // Aerial perspective / airlight. cloudAttn above only extinguishes the cloud's OWN scattered
    // light (cloudScatter) — it has no compensating term for the sunlight the SAME stretch of
    // atmosphere scatters INTO the camera-to-cloud path, which is what makes real distant clouds
    // fade pale/blue-hazy rather than just dim. Missing that made a distant, fully-opaque cloud
    // (cloudAttn well below 1) render as near-black and skewed red/orange — BETA_R/BETA_M
    // extinguish blue harder than red over a long low-altitude path — instead of fading into the
    // sky. Only visible once cloudDistFadeEndM/maxRenderDistM are pushed far enough (Ultra preset,
    // or a manually-raised render distance) for a ray to stay substantially volumetric at a
    // distance where this extinction is severe; short/default ranges crossfade to the flat 2D
    // layer (evalCloudLayer in sat_sky.frag, which already has its own version of this fix) first.
    //
    // skyAmbientBase (a 6-step analytic single-scattering ZENITH Rayleigh/Mie integral anchored at
    // the cloud) was the original stand-in for the in-scattered light along this path — reasoned
    // as "the same general slab of atmosphere, not a second march." That reasoning missed that
    // the GEOMETRY matters, not just the slab: skyAmbientBase integrates a short (~100km) VERTICAL
    // path, while the real quantity needed here is inscatter along the camera-to-cloud path, which
    // at the horizon is a much longer, near-HORIZONTAL path (150km+ for a 2-11km shell viewed from
    // ground level — Earth's curvature alone puts the shell entry that far out). A horizontal path
    // accumulates far more total inscattered sunlight than a vertical one of similar altitude
    // range (the same reason a real sky is hazier/brighter near the horizon than at the zenith,
    // even at local noon with the sun high). Reusing the dim zenith value under-lit this term, so
    // as cloudAttn crushed toward 0 for a genuinely distant/grazing cloud, the airlight it faded
    // into was dimmer than the real sky around it — reported as horizon clouds darkening to grey
    // at any time of day, not just fading paler into the haze the way real aerial perspective does.
    //
    // camPathInscatter is a dedicated short march (kAirCamSteps, same step budget as
    // skyAmbientBase) along the ACTUAL obsPos->dir segment out to cloudMeanT — the same physics as
    // sat_sky.frag's own N_VIEW atmosphere loop (see main()'s `color` there), just truncated to
    // this shorter camera-to-cloud distance instead of the full ray. skyAmbientBase itself is left
    // untouched (still correct for twilightAmbient's "ambient sky light falling ON the cloud from
    // above" purpose, a genuinely different, legitimately-vertical quantity).
    vec3 camPathInscatter = vec3(0.0);
    {
        const int kAirCamSteps = 6;
        float segAC  = max(cloudMeanT, 0.001) / float(kAirCamSteps);
        float cosAAC = dot(dir, sunDir);
        float pR_ac  = phaseR(cosAAC);
        float pM_ac  = phaseM(cosAAC);
        float odR_ac = 0.0, odM_ac = 0.0;
        vec3  accumR_ac = vec3(0.0);
        float accumM_ac = 0.0;
        for (int ai = 0; ai < kAirCamSteps; ++ai) {
            vec3  ap = obsPos + dir * ((float(ai) + 0.5) * segAC);
            float ah = max(0.0, length(ap) - R_EARTH);
            float dRA = exp(-ah / H_R) * segAC;
            float dMA = exp(-ah / H_M) * segAC;
            odR_ac += dRA;
            odM_ac += dMA;
            vec2 tSE_ac = raySphere(ap, sunDir, R_EARTH);
            if (tSE_ac.x > 0.0 && tSE_ac.y > 0.0) continue;
            vec2 tSun_ac  = raySphere(ap, sunDir, R_ATMOS);
            vec2 sunOD_ac = (tSun_ac.y > 0.0) ? optDepth(ap, sunDir, tSun_ac.y) : vec2(0.0);
            vec3 tauAC  = BETA_R * (odR_ac + sunOD_ac.x) + BETA_M * 1.1 * (odM_ac + sunOD_ac.y);
            vec3 attnAC = exp(-tauAC);
            accumR_ac += attnAC * dRA;
            accumM_ac += dot(attnAC, vec3(1.0 / 3.0)) * dMA;
        }
        camPathInscatter = SUN_INTENSITY * (pR_ac * BETA_R * accumR_ac + vec3(pM_ac * BETA_M * accumM_ac));
    }
    // Weighted by (1-cloudAttn) (the fraction of light actually extinguished — negligible for near
    // clouds, so this only engages at real distance) and by (1-cloudTOut.r) (the SAME continuous
    // per-ray opacity that already softens the cloud's visual edge, so the fix fades in/out exactly
    // where the cloud material itself does — no separate threshold, no seam, unlike an earlier
    // attempt gated on the ≥90%-opacity tCloudOcclude flag, which produced a hard-edged brightening
    // confined to fully opaque cores).
    vec3 airlight = camPathInscatter * (1.0 - cloudAttn) * (1.0 - cloudTOut.r);

    B_cloud = cloudAttn * cloudScatter * cloudAltFade + airlight * cloudAltFade;
}

// ── Per-pixel cloud shadow on terrain/ocean ───────────────────────────────────────────────────
// Marches sunward from a point ON THE GROUND through the main cloud shell and returns the
// transmittance — "how much direct sunlight reaches this spot".
//
// This replaces cloud_shadow.comp's 128x128 observer-centred tangent-plane grid outright. That
// grid had three structural problems, all of which this form avoids by construction rather than
// by mitigation:
//   * Resolution. 128 texels over the default +/-80 km range is 1250 m per texel, EVERYWHERE.
//     Here the sampling grid is screen space, so it is metres-per-texel near the camera and
//     coarsens naturally with distance — the opposite of what you want to fix, and it fixes
//     itself.
//   * Altitude. The grid was centred on the observer at a fixed world extent, so climbing made it
//     cover a steadily smaller fraction of the visible ground. Following the view ray has no such
//     failure mode.
//   * Swimming. Because the grid re-centred on a continuously moving observer every frame, it
//     needed texel-snapping machinery (computeCloudShadowSnap + a residual subtracted by every
//     consumer) to stop shadows drifting sub-texel. This value is a pure function of the world
//     position being shaded, so there is nothing to snap and that whole subsystem is deleted.
//
// The march itself is deliberately the same 12 steps and the same density->optical-depth constant
// the grid used, so brightness is comparable; only the sampling geometry changed.
float cloudGroundShadow(vec3 groundECEF, vec3 sunDirECEF, float jitter) {
    if (cloud.layers[0].enabled < 0.5) return 1.0;

    float cloudBaseAlt = cloud.layers[0].shellAltM;
    float cloudTopAlt  = cloud.layers[1].shellAltM;
    float shellThick   = cloudTopAlt - cloudBaseAlt;

    // The shaded point is always below the cloud base by construction (it is on the ground), so
    // only the "below the shell, looking up" root is needed — no 3-way observer classification.
    vec2 shellB = raySphere(groundECEF, sunDirECEF, R_EARTH + cloudBaseAlt);
    vec2 shellT = raySphere(groundECEF, sunDirECEF, R_EARTH + cloudTopAlt);
    if (!(shellT.y > 0.0 && shellB.y < shellT.y)) return 1.0;

    float tEnter = max(shellB.y, 0.0);
    float tExit  = shellT.y;
    const int kShadowSteps = 12;
    float segLen = (tExit - tEnter) / float(kShadowSteps);

    float T = 1.0;
    for (int i = 0; i < kShadowSteps; ++i) {
        // Jittered sample phase. Neighbouring screen texels can map to ground points kilometres
        // apart at grazing angles, so a fixed (i+0.5) phase through structured noise is an
        // aliasing setup — the same one the sun self-shadow cone above already dithers away.
        vec3  p = groundECEF + sunDirECEF * (tEnter + (float(i) + jitter) * segLen);
        float h = length(p) - R_EARTH;
        if (h < cloudBaseAlt || h > cloudTopAlt) continue;
        float hNorm = (h - cloudBaseAlt) / shellThick;

        float pLen = length(p);
        vec3  dirECEF = p / pLen;
        float pLon = atan(p.y, p.x);
        float pLat = asin(clamp(p.z / pLen, -1.0, 1.0));
        vec2  pUV  = vec2(fract((pLon + PI) / (2.0*PI)
                                + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                          (0.5*PI - pLat) / PI);
        // Matches the view march's mip so the shadow is cast by the same cloud shape that is
        // actually drawn — a coarser read here would shadow blobs that are no longer visible.
        float localCov = cloud.coverage * textureLod(earthCloudsTex, pUV, cloud.coverageMipLod).r;
        if (localCov < 0.02) continue;

        vec3 dirECEFDrift = rotateZ(dirECEF, cloud.cloudPhase * cloud.layers[0].driftMult);
        vec3 warpUVW      = cloudWarpOffset(dirECEFDrift);

        float colNoise = texture(cloudNoiseTex,
                                 dirECEFDrift * kCloudColFreq + warpUVW + vec3(0.0, 0.0, 0.25)).r;
        float colH = remap(colNoise, 1.0 - localCov, 1.0, 0.0, 1.0);

        float baseNoise = texture(cloudNoiseTex,
                                  dirECEFDrift * kCloudColFreq + warpUVW + vec3(0.0, 0.0, 0.85)).r;
        float baseH = (baseNoise - 0.5) * cloud.cloudBaseVariance;

        float topFade = 1.0 - smoothstep(colH - 0.05, colH + 0.05, hNorm);
        float hFade   = smoothstep(baseH, baseH + 0.05, hNorm) * topFade;
        if (hFade < 0.001) continue;

        const float kVertTiles = 1.5;
        float posZ      = sin(pUV.x * 21.3 + pUV.y * 17.7) * 0.5 + 0.5;
        vec3  uvwXY     = dirECEFDrift * kCloudHorizFreq + warpUVW;
        vec3  uvwDetail = uvwXY + vec3(0.0, 0.0, hNorm * kVertTiles + posZ * 2.0);
        float d = cloudDensity(uvwXY, uvwDetail, hNorm, localCov, cloud.density, hFade);

        if (d > 0.001) {
            T *= exp(-d * segLen * 3e-3); // same density->optical-depth mapping as the view march
            if (T < 0.02) break;
        }
    }

    // Max 85% darkening — same cap the grid applied, so this drops in at matched brightness.
    return mix(1.0, T, 0.85);
}

void cirrusMarchCS(
    vec3  obsPos,  vec3  dir,
    vec3  enuX,    vec3  enuY,        vec3  enuZ,
    vec3  sunDir,  vec3  sunDirECEF,  float obsEffH,
    out   vec3  A_cirrus, out vec3 B_cirrus,
    float tScene)  // shared scene depth — see cloudMarchCS
{
    // Runtime-tunable scattering strength — see cloudMarchCS's matching declaration.
    vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
    float BETA_M = BETA_M_BASE * cloud.atmosMieGain;

    A_cirrus = vec3(1.0);
    B_cirrus = vec3(0.0);
    if (cloud.layers[1].enabled < 0.5) return;
    float cirrusAltFade = 1.0 - smoothstep(kCloud3DFadeStart, kCloud3DFadeEnd, obsEffH);
    if (cirrusAltFade < 0.001) return;

    float cirrusAlt  = cloud.layers[1].shellAltM;
    float shellBAlt  = cirrusAlt - kCirrusThicknessM * 0.5;
    float shellTAlt  = cirrusAlt + kCirrusThicknessM * 0.5;
    vec2  shellB     = raySphere(obsPos, dir, R_EARTH + shellBAlt);
    vec2  shellT     = raySphere(obsPos, dir, R_EARTH + shellTAlt);

    float tEnter, tExit;
    if (obsEffH < shellBAlt) {
        tEnter = shellB.y;
        tExit  = shellT.y;
    } else if (obsEffH <= shellTAlt) {
        tEnter = 0.001;
        tExit  = shellT.y;
        if (shellB.x > 0.001 && shellB.x < tExit) tExit = shellB.x;
    } else {
        if (shellT.x < 0.0) return;
        tEnter = shellT.x;
        tExit  = (shellB.x > 0.0) ? shellB.x : shellT.y;
    }
    // Render-distance cap raised 200km->450km (session 28 follow-up #10): cirrus sits at ~15km
    // altitude by default, whose own geometric horizon distance is ~sqrt(2*R_EARTH*15000)≈437km —
    // the old 200km cap cut the march off well short of that, letting stars/aurora/Milky Way show
    // straight through cirrus near the horizon instead of the cirrus layer thinning out naturally.
    tExit = min(tExit, tEnter + 450000.0);
    // Terrain occlusion on this layer's own bounds — see cloudMarchCS.
    if (tEnter >= tScene) return;
    tExit = min(tExit, tScene);

    // Distance-based crossfade, same as cloudMarchCS — see there for why this and not
    // maxRenderDistM is what bounds the march.
    float cirrusDistFade = 1.0 - smoothstep(cloud.cloudDistFadeStartM, cloud.cloudDistFadeEndM, tEnter);
    cirrusAltFade = min(cirrusAltFade, cirrusDistFade);
    if (cirrusAltFade < 0.001) return;
    if (tEnter >= tExit || tExit <= 0.0) return;

    // Adaptive step count (same fix as the aurora march, session 28 follow-up #9): a FIXED
    // N_CIRRUS badly serves a path length that now legitimately ranges from ~10km (steep look-down)
    // to 450km (grazing/horizon) — a fixed 14 steps across the extended cap would badly undersample
    // exactly the far, grazing case the render-distance increase above was meant to fix.
    // kCirrusStepsMax must cover the full 450km cap above at kCirrusMaxStepM resolution
    // (450000/3000=150) — the original value here (128) was computed before the render-distance
    // cap was raised in the same edit and never rechecked against it, so it silently forced
    // grazing/horizon rays into a COARSER-than-intended step size (450000/128≈3516m) right where
    // the render-distance fix mattered most. Margin added on top for the same reason the low-cloud
    // hardCap below now has more headroom too.
    const float kCirrusMaxStepM = 3000.0;
    const int   kCirrusStepsMin = 14;
    const int   kCirrusStepsMax = 200;
    float cirrusPathLen = tExit - tEnter;
    int   N_CIRRUS = clamp(int(cirrusPathLen / kCirrusMaxStepM), kCirrusStepsMin, kCirrusStepsMax);
    float segLen = cirrusPathLen / float(N_CIRRUS);
    float jitter  = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).r;

    float invStretch   = 1.0 / max(cloud.cirrusStretch, 1.0);

    vec3  cirrusTransmittance = vec3(1.0);
    vec3  cirrusScatter       = vec3(0.0);
    float cosA = dot(dir, sunDir);
    float ph   = phaseCloud(cosA);

    for (int i = 0; i < N_CIRRUS; ++i) {
        float t = tEnter + (float(i) + jitter) * segLen;
        vec3  p = obsPos + t * dir;
        float h = length(p) - R_EARTH;
        if (h < shellBAlt || h > shellTAlt) continue;
        float hNorm = (h - shellBAlt) / kCirrusThicknessM;

        vec3  pECEF = p.x * enuX + p.y * enuY + p.z * enuZ;
        float pLen  = length(pECEF);
        float pLon  = atan(pECEF.y, pECEF.x);
        float pLat  = asin(clamp(pECEF.z / pLen, -1.0, 1.0));
        vec2  pUV   = vec2(fract((pLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[1].driftMult / (2.0*PI)),
                           (0.5*PI - pLat) / PI);
        float localCov = cloud.coverage * cloud.layers[1].coverageMult
                        * textureLod(earthCloudsTex, pUV, cloud.layers[1].mipLod).r;
        if (localCov < 0.02) continue;

        vec3 dirECEF      = pECEF / pLen;
        vec3 dirECEFDrift = rotateZ(dirECEF, cloud.cloudPhase * cloud.layers[1].driftMult);
        float wa       = cloud.cirrusWindAngle + cirrusWindAngleAt(dirECEFDrift);
        vec3  windAxis = vec3(cos(wa), sin(wa), 0.0);
        vec3 dirStretched = dirECEFDrift
                           + windAxis * dot(dirECEFDrift, windAxis) * (invStretch - 1.0);

        float hFade = smoothstep(0.0, 0.15, hNorm) * (1.0 - smoothstep(0.85, 1.0, hNorm));
        vec3  uvwXY     = dirStretched * kCloudHorizFreq * kCirrusFreqScale
                        + cirrusDomainWarp(dirECEFDrift);
        vec3  uvwDetail = uvwXY + vec3(0.0, 0.0, hNorm * 1.5);
        float d = cloudDensity(uvwXY, uvwDetail, hNorm, localCov,
                                cloud.density * cloud.layers[1].densityMult, hFade);
        if (d < 0.001) continue;

        float extinction = d * segLen * 8e-5;
        vec3  stepT = exp(-vec3(extinction));

        float cloudSunDot  = dot(normalize(pECEF), sunDirECEF);
        float cloudDayFrac = smoothstep(-0.1, 0.15, cloudSunDot);
        // See cloudMarchCS's sunGainCurve comment — same horizon/zenith blend, same rationale.
        float sunGainCurveCirrus = mix(cloud.sunGain, cloud.sunGainZenith,
                                        smoothstep(0.0, 1.0, clamp(cloudSunDot, 0.0, 1.0)));
        vec3  inScatter     = vec3(max(0.0, cloudSunDot + 0.1) * sunGainCurveCirrus) * cloudDayFrac * ph * 2.0;

        cirrusScatter       += cirrusTransmittance * (1.0 - stepT) * inScatter;
        cirrusTransmittance *= stepT;
        if (cirrusTransmittance.r < 0.02) break;
    }

    vec2 odAtmCirrus = optDepth(obsPos, dir, tEnter);
    vec3 cirrusAttn  = exp(-(BETA_R * odAtmCirrus.x + BETA_M * 1.1 * odAtmCirrus.y));
    vec3 cirrusT     = mix(vec3(1.0), cirrusTransmittance, cirrusAltFade);
    // See cloudMarchCS's A_cloud comment — same fix, same reason: A_cirrus must be the layer's own
    // transmittance alone, not blended with cirrusAttn (which belongs to B_cirrus only).
    A_cirrus = cirrusT;
    B_cirrus = cirrusAttn * cirrusScatter * cirrusAltFade;
}

// ── Ground fog/dust layer (C11 follow-up #47) — real per-sample volumetric march ──────────────
// Sea level to cloud.fogTopAltM (a thin shell, typically a few hundred metres — unlike the
// multi-km cloud shell, which is why the old analytic beam tube existed at all and a real march
// through THIS layer is affordable). A fixed-altitude shell already gives the classic "fog fills
// the valleys, peaks poke through" look for free via the same tScene terrain clipping every other
// layer here uses — no terrain-relative height-above-ground tracking needed.
//
// Patchiness reuses the existing baked cloudNoiseTex (no new noise-bake pass) at a much lower
// frequency than cloud cells — broad mist-bank features, not cumulus shapes. Deliberately does
// NOT use earthCloudsTex (that's cloud geography, not appropriate for ground fog) or the cloud's
// colH/baseH/topFade cumulus sculpting (fog doesn't need puffy tops, just a simple vertical
// density falloff).
//
// Plain ambient sun/beam lighting (C11 follow-up #50) — a self-shadow cone through fog's own
// density, plus a per-ray cloudGroundShadow lookup toward the sun, were both tried (follow-ups
// #47/#48) and removed: neither produced a visible godray effect, and the cloudGroundShadow
// lookup specifically introduced new visible noise (a second independently-jittered march
// compounding with this one's own jitter). Sun godrays are being pursued separately, if at all, as
// a screen-space technique instead of a real march through this layer.
//
// Beam godrays reuse beamCloudLighting() (follow-up #44/#46/#47) completely unmodified — see that
// function's header comment for why fog's own altitude already makes it respect cloud occlusion
// with no extra code.
const float kFogHorizFreq  = kCloudHorizFreq * 0.12; // much broader features than cloud cells
const float kFogMaxRangeM  = 12000.0; // real fog has short visibility; also bounds march cost

void fogMarchCS(
    vec3  obsPos,  vec3  dir,
    vec3  enuX,    vec3  enuY,        vec3  enuZ,
    vec3  sunDir,  vec3  sunDirECEF,  float obsEffH,
    out   vec3  A_fog, out vec3 B_fog,
    float tScene)
{
    // Runtime-tunable scattering strength — see cloudMarchCS's matching declaration.
    vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
    float BETA_M = BETA_M_BASE * cloud.atmosMieGain;

    A_fog = vec3(1.0);
    B_fog = vec3(0.0);
    if ((pc.debugDisableMask & 2048u) != 0u) return;
    if (cloud.fogCoverage <= 0.0 || cloud.fogTopAltM <= 0.0) return;

    float fogTopAlt = cloud.fogTopAltM;
    float fogTop    = R_EARTH + fogTopAlt;

    // Altitude fade — anchored to how far ABOVE THE FOG'S OWN CEILING the observer is (C11
    // follow-up #49), not a fixed absolute altitude. The original fixed 3-12km range assumed a
    // ~300m ground-mist shell and silently zeroed the ENTIRE fog contribution for any observer
    // above ~12km regardless of fogTopAltM — so raising fogTopAltM to try a much taller haze
    // column (for persistent beam visibility from a distance) did nothing once the observer was
    // already above that fixed ceiling: this is the reported "the fog layer disappeared" at a
    // 200km top altitude. Scaling the margin by fogTopAlt reproduces the original ground-mist
    // behavior unchanged at the default (~300m) ceiling while letting a deliberately taller shell
    // stay visible from proportionately higher up.
    float fogFadeStartM = fogTopAlt + 3000.0;
    float fogFadeEndM   = fogTopAlt + 12000.0;
    float fogAltFade = 1.0 - smoothstep(fogFadeStartM, fogFadeEndM, obsEffH);
    if (fogAltFade < 0.001) return;

    vec2  shellT = raySphere(obsPos, dir, fogTop);
    float tEnter, tExit;
    if (obsEffH <= fogTopAlt) {
        // Observer inside (or below — e.g. below sea level over ocean) the shell: the common case.
        tEnter = 0.001;
        tExit  = shellT.y;
    } else {
        if (shellT.x < 0.0) return; // ray never reaches the shell
        tEnter = shellT.x;
        tExit  = shellT.y;
    }
    if (tEnter < 0.0 || tExit <= tEnter) return;

    // Terrain occlusion — same clipping every other layer in this file applies.
    if (tEnter >= tScene) return;
    tExit = min(tExit, tScene);
    // Render-distance cap also scales with fogTopAlt (C11 follow-up #49) — kFogMaxRangeM alone
    // (12km) was tuned for ground-mist visibility and would have truncated a deliberately taller
    // haze column's own visible range to a fraction of its height.
    tExit = min(tExit, tEnter + max(kFogMaxRangeM, fogTopAlt * 2.0));
    if (tEnter >= tExit) return;

    int   N      = clamp(int((tExit - tEnter) / 200.0), 8, 64);
    float segLen = (tExit - tEnter) / float(N);
    float jitter = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).b;

    vec3  fogTransmittance = vec3(1.0);
    vec3  fogScatter       = vec3(0.0);
    float cosA = dot(dir, sunDir);
    float ph   = phaseCloud(cosA);

    for (int i = 0; i < N; ++i) {
        float t = tEnter + (float(i) + jitter) * segLen;
        vec3  p = obsPos + t * dir;
        float h = length(p) - R_EARTH;
        if (h < 0.0 || h > fogTopAlt) continue;
        float hNorm = h / fogTopAlt;

        vec3  pECEF = p.x * enuX + p.y * enuY + p.z * enuZ;
        float pLen  = length(pECEF);
        vec3  dirECEF = pECEF / pLen;

        // Patchiness: same baked 3D noise clouds use, sampled at a much coarser frequency — broad
        // mist-bank features, no cumulus shape sculpting.
        float patchNoise = texture(cloudNoiseTex, dirECEF * kFogHorizFreq).r;
        float localCov   = cloud.fogCoverage * patchNoise;
        if (localCov < 0.05) continue;

        // Vertical profile: denser near the ground, thinning toward the top.
        float vFade = 1.0 - smoothstep(0.3, 1.0, hNorm);
        float d = cloud.fogDensity * localCov * vFade;
        if (d < 0.02) continue;

        float extinction = d * segLen * 2e-4;
        vec3  stepT      = exp(-vec3(extinction));

        // Fog is now a plain ambient term (C11 follow-up #50) — the godray-chasing machinery
        // (a self-shadow cone through fog's own density, plus a per-ray cloudGroundShadow lookup
        // toward the sun) was removed outright, per explicit user decision: it never produced a
        // visible godray effect worth the cost, and the cloudGroundShadow addition specifically
        // introduced new visible noise in the fog itself (a second independently-jittered march
        // compounding with this one). Fog still looks correct as ambient haze/mist; it just no
        // longer tries to carry directional light-shaft detail. Sun (and beam, terrain, ocean)
        // godrays are being pursued separately as a screen-space technique instead, if at all.
        float cloudSunDotRaw = dot(dirECEF, sunDirECEF);
        float sampleDayness  = clamp((cloudSunDotRaw + 0.2) / 0.5, 0.0, 1.0);
        float sunElev        = smoothstep(-0.04, 0.12, cloudSunDotRaw);
        vec3  sunInScatter    = vec3(1.0) * sunElev * ph * cloud.fogSunGain;

        // Beam godrays — see beamCloudLighting()'s header comment for why this needs no separate
        // occlusion handling: fog's h is always far below any target's (cloud-shell) blockAltM.
        vec3 beamLit = beamCloudLighting(p, h, dir, obsPos, sampleDayness);

        vec3 inScatter = sunInScatter + beamLit;
        fogScatter       += fogTransmittance * (1.0 - stepT) * inScatter;
        fogTransmittance *= stepT;
        if (fogTransmittance.r < 0.02) break;
    }

    vec2 odAtmFog = optDepth(obsPos, dir, tEnter);
    vec3 fogAttn  = exp(-(BETA_R * odAtmFog.x + BETA_M * 1.1 * odAtmFog.y));
    vec3 fogT     = mix(vec3(1.0), fogTransmittance, fogAltFade);
    // See cloudMarchCS's A_cloud comment — same fix, same reason.
    A_fog = fogT;
    B_fog = fogAttn * fogScatter * fogAltFade;
}

void main() {
    ivec2 size  = imageSize(targetA);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    // Reconstruct the same view ray sat_sky.vert/sat_sky.frag build, evaluated directly at this
    // half-res texel instead of via vertex interpolation — identical affine transform, just
    // sampled at a coarser grid.
    vec2 uv  = (vec2(coord) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    float tanHalfFov = tan(pc.fovYRad * 0.5);
    vec3  camDir = vec3(ndc.x * tanHalfFov * pc.aspect, -ndc.y * tanHalfFov, -1.0);
    vec3  dir    = normalize(mat3(transpose(pc.skyView)) * camDir);
    vec3  sunDir = normalize(pc.sunDirENU.xyz);

    vec3 enuZ = normalize(pc.obsECEFDir.xyz);
    vec3 enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    vec3 enuY = cross(enuZ, enuX);
    vec3 sunDirECEF = sunDir.x * enuX + sunDir.y * enuY + sunDir.z * enuZ;

    // Observer height resolved on the GPU via the SAME shared helper sat_sky.frag and
    // scene_depth.comp use. This shader previously took a CPU-computed value straight off
    // pc.obsEffH while sat_sky.frag did its own texture lookup, so the two disagreed about where
    // the observer was. That was harmless while each only compared distances against itself, but
    // it is not once one pass produces a depth buffer the other consumes — a few metres of
    // disagreement at the observer becomes a visible occlusion mismatch along grazing rays.
    // pc.obsEffH is still the CPU's value and is deliberately no longer read here.
    float obsEffH = observerEffHeight(earthElevTex, earthSpecTex, pc.obsECEFDir);
    vec3  obsPos  = observerPos(obsEffH);

    // Shared scene depth for this exact texel. Read ONCE here, not per beam: the beam loop below
    // runs up to 2048 iterations and every one of them needs the same value. texelFetch rather
    // than texture() because this dispatch grid and sceneDepthTex are the same size — an exact
    // 1:1 mapping with no filtering, so the value read is exactly the value written.
    float tScene = texelFetch(sceneDepthTex, coord, 0).r;

    vec3 A_cirrus, B_cirrus;
    cirrusMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, obsEffH,
                  A_cirrus, B_cirrus, tScene);

    vec3  A_cloud, B_cloud, cloudTOut;
    float tCloudOcclude;
    cloudMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, obsEffH, pc.moonDirENU,
                 A_cloud, B_cloud, cloudTOut, tCloudOcclude, tScene);

    vec3  A_total = A_cirrus * A_cloud;
    vec3  B_total = B_cirrus * A_cloud + B_cloud;

    // Ground fog (C11 follow-up #47) — nearest volumetric layer to a ground-level observer, so it
    // composites LAST against the already-combined cirrus+cloud result, one tier closer to the
    // camera than cloud is to cirrus (same algebraic pattern as the line above, just applied
    // again): stuff behind fog (cloud+cirrus) gets dimmed by A_fog, fog's own emission adds
    // unattenuated. Placed before aurora/airglow below so a thick ground fog also dims those
    // through the same (now fog-inclusive) A_total those already read — a reasonable, if
    // approximate, side effect rather than a deliberate design point.
    vec3 A_fog, B_fog;
    fogMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, obsEffH, A_fog, B_fog, tScene);
    A_total = A_total * A_fog;
    B_total = B_total * A_fog + B_fog;

    // Aurora sky curtain (moved here this session — perf: half-res instead of full-res).
    // Cloud suppression uses the LOCAL A_total already computed above — more accurate than
    // sat_sky.frag's old "early" texture pre-sample, which only existed because that shader runs
    // at full-res and needed a cheap same-frame proxy; this compute shader has the real value on
    // hand already. Folding the result directly into B_total means it inherits the same terrain-
    // occlusion handling sat_sky.frag already applies to the whole composite (a behavior change
    // from before, when aurora ignored terrain occlusion entirely — this is more physically
    // correct: terrain that blocks the view of the much-closer cloud layer necessarily blocks the
    // far higher aurora shell along that same ray too).
    vec3 auroraContrib = vec3(0.0);
    if ((pc.debugDisableMask & 32u) == 0u) {
        auroraContrib = auroraMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF,
                                       obsEffH, pc.moonDirENU, tScene);
    }
    if (dot(auroraContrib, auroraContrib) > 0.0) {
        bool  auroraBehindClouds = (obsEffH < kAuroraShellInnerM);
        float cloudBlockLocal    = dot(A_total, vec3(1.0 / 3.0));
        const float kAuroraCloudSuppressPower = 3.0;
        float auroraCloudSuppress = auroraBehindClouds
            ? pow(clamp(cloudBlockLocal, 0.0, 1.0), kAuroraCloudSuppressPower)
            : 1.0;
        B_total += auroraContrib * auroraCloudSuppress;
    }

    // Airglow red band (moved here this session — perf). No cloud-suppression term — the
    // original never had one either, just a plain additive contribution.
    if ((pc.debugDisableMask & 16u) == 0u) {
        B_total += airglowRedMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDirECEF, obsEffH, tScene);
    }

    // ── Reflect-Orbital beam DEBUG pointing rays (C12 follow-up #12) ─────────────────────────
    // Draws each active beam's mirror's ACTUAL current reflected-sunlight direction
    // (reflectDirENU) as a long, bright, deliberately-oversized line extending from the
    // satellite — independent of the physically-shaped glow above (no phase function, no cloud
    // gating, no altitude restriction), purely so convergence at a busy site — and any satellite
    // still mid-slew and not yet aimed at its target — can be seen directly, for profiling/
    // debugging rather than production rendering. Opt-in and off by default.
    //
    // Multi-sample instead of a single-reference-point trick: a multi-hundred-km debug ray needs
    // to look continuous from many different viewing angles, so it's sampled at several points
    // along its length. Each sample point is found via a safe fixed-point projection (never
    // solving a closest-approach system built from obsPos/satWorldPos's large-magnitude
    // difference — that cancellation risk is why beam-adjacent math elsewhere in this codebase
    // works from ENU-relative vectors directly rather than re-deriving world-space differences).
    if (pc.showBeamDebugRays != 0u) {
        // Thinned + dimmed (C12 follow-up #13, 2026-07-21 — user report: rays were "too thick and
        // bright... difficult to tell when they blend into one another"). Radius 15000->2500,
        // scale 0.12->0.03 — dense convergence at a busy site should now read as many distinct
        // thin lines rather than one blown-out mass.
        const float kDebugRayRadiusM = 2500.0;
        const float kDebugRayScale   = 0.03;
        const int   kDebugRaySamples = 40;
        // Trace to the ACTUAL ground intersection instead of a fixed length (C12 follow-up #13 —
        // user report: rays "terminate once they get enough into the atmosphere" instead of
        // tracing back to the ground). A fixed 1000km length could stop well short of the
        // surface for a satellite aimed even slightly off nadir at the higher end of this
        // constellation's altitude range; raySphere() against R_EARTH finds the true distance
        // whatever the satellite's altitude or aim. kDebugRayMaxLenM is just a safety fallback
        // for the (should-be-rare) case where the ray points away from Earth entirely.
        const float kDebugRayMaxLenM = 3000000.0;
        int debugActiveBeamCount = int(min(beamCount, BEAM_MAX_ACTIVE)); // own scope — the main
                                                                          // beam block's activeBeamCount is local to its own `if`
        for (int bi = 0; bi < debugActiveBeamCount; ++bi) {
            if (beams[bi].intensity <= 0.0) continue;
            if (length(beams[bi].targetENU) > pc.beamMaxRangeM) continue;

            vec3 satWorldPos = obsPos + beams[bi].satENU;
            vec3 rayDir      = beams[bi].reflectDirENU;

            vec2  groundHit = raySphere(satWorldPos, rayDir, R_EARTH);
            float rayLen    = (groundHit.x > 0.0) ? min(groundHit.x, kDebugRayMaxLenM) : kDebugRayMaxLenM;
            float sampleLen = rayLen / float(kDebugRaySamples);

            for (int si = 0; si < kDebugRaySamples; ++si) {
                vec3  refPt        = satWorldPos + rayDir * ((float(si) + 0.5) * sampleLen);
                float tRay         = dot(refPt - obsPos, dir);
                if (tRay < 0.0) continue;
                vec3  closestRayPt = obsPos + tRay * dir;
                float perpDist     = length(refPt - closestRayPt);
                if (perpDist > kDebugRayRadiusM * 3.0) continue;
                float proximity = exp(-(perpDist * perpDist) / (2.0 * kDebugRayRadiusM * kDebugRayRadiusM));
                B_total += vec3(0.2, 1.0, 0.35) * (kDebugRayScale * proximity); // green — visually distinct from the natural glow's warm/white tint
            }
        }
    }

    // tEnterCombined is GONE. It fused cirrus + cloud + beam + aurora entry distances into one
    // scalar that sat_sky.frag compared against its own terrain distance, suppressing the WHOLE
    // composite when terrain won — so the four could never be occluded independently (a beam
    // behind a hill still drew if some unrelated nearer cloud won the min()), partial truncation
    // was impossible, and the half-res scalar was being compared against a full-res silhouette.
    //
    // It was also a latent correctness bug in its own right: this is an RGBA16F target, whose
    // alpha saturates at 65504, and near-horizon cloud entry distances routinely exceed 100 km.
    // Those overflowed to +inf, making `tSurface < tEnterCombined` unconditionally true and
    // suppressing the entire composite on any ray that also hit the sea-level sphere.
    //
    // Every layer above now clamps to tScene at march time instead, which is strictly more
    // correct — and it freed this alpha channel for the per-pixel cloud shadow below.
    //
    // Only ground pixels pay for it: sky rays have tScene == kNoSurfaceT and skip out entirely.
    // The shadow is evaluated at the terrain hit point the depth pass already found, so this
    // needs no new bindings, no new pass, and no spatial grid — the whole of cloud_shadow.comp
    // and its texel-snapping subsystem is deleted in exchange.
    //
    // DISTANCE GATE — load-bearing for performance, not just a quality knob.
    //
    // The gate below is "does this ray hit ground, and is that ground near enough for its shadow
    // to be resolvable". Without the distance half, this ran on every ground-hitting pixel: from
    // orbit that is essentially the WHOLE screen, ~485k half-res pixels each doing a 12-step
    // sunward march, for shadow detail far below one pixel at that range. Near the surface the
    // same thing happened to every horizon-ward ray hitting ocean hundreds of km out.
    //
    // The 128x128 grid this replaced was accidentally immune: being observer-centred with a fixed
    // ~80 km extent, it covered a vanishing patch of the visible ground from altitude and cost
    // almost nothing there. Removing the grid removed that accidental gating along with it.
    //
    // Fading rather than hard-cutting matters — a hard edge is exactly the artifact the old grid
    // had. Cost scales with how much of the screen is BOTH ground and within range, which from
    // orbit is now approximately none.
    float terrainSunT = 1.0;
    if (tScene < kNoSurfaceT && (pc.debugDisableMask & 256u) == 0u) {
        float shadowFade = 1.0 - smoothstep(pc.cloudShadowRangeM * 0.6, pc.cloudShadowRangeM, tScene);
        if (shadowFade > 0.001) {
            vec3  hitENU  = obsPos + tScene * dir;
            vec3  hitECEF = hitENU.x * enuX + hitENU.y * enuY + hitENU.z * enuZ;
            float jitter  = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).b;
            terrainSunT = mix(1.0, cloudGroundShadow(hitECEF, sunDirECEF, jitter), shadowFade);
        }
    }

    imageStore(targetA, coord, vec4(B_total, tCloudOcclude));
    imageStore(targetB, coord, vec4(A_total, terrainSunT));
}
