// ── Kessler dust clouds (round 2, 2026-10-16) ───────────────────────────────────────────────────────
// Each recent breakup's dust and small fragments as a few Gaussian ellipsoids (SatelliteSim::kesslerFillDust: the
// cloud follows its parent's orbit, expands and shears along-track; split along the arc once it curves). The optical
// depth along a ray through a Gaussian is closed form (erf), so a cloud is exact at any size and costs a few dozen
// flops per pixel. Sunlit by single scattering (forward-peaked dust), shadowed by the Earth at the ray's closest
// approach to the cloud's centre.
struct DustCloud
{
    vec4 c;   // centre relative to the eye (m, ENU); w = cross-section x albedo x gain (m^2)
    vec4 ia;  // inverse covariance xx, yy, zz; w = 1 / ((2 pi)^1.5 sqrt(det))
    vec4 ib;  // inverse covariance xy, xz, yz; w = (plumes) the sky light on it, relative to the Sun's
    vec4 col; // tint; w = 1: emissive (a re-entry fireball's trail, a rocket's flame); 2: a rocket's plume
    vec4 cone; // the directions it can reach (xyz unit, w = cos of the half-angle; all 0 = everywhere): one dot to skip
};
// dustPad0 = the engine lights after the 1024 entries; dustPad1 = floatBits(the frame's sky exposure: display per unit of
// the sky's radiance, SatelliteSim::skyExposure()), for the faint plumes' skip in dustCloudsCS.
layout(set = 0, binding = 23) readonly buffer DustBuf { uint dustCount; uint dustPad0, dustPad1, dustPad2; DustCloud dust[]; };

// Per-tile cull of the dust / plume / flame list (2026-10-21, Forward+ like cullBeamsForTile below): one workgroup owns
// a 16x16-texel tile, its 256 threads test every Gaussian's view cone once against the tile's bounding cone and set a
// bit; each texel then walks only the set bits. Conservative: a texel's ray is inside the tile's cone, so if the
// Gaussian's cone and the tile's do not overlap no texel of the tile passes the per-texel cone test either (it is kept,
// so the result is exactly the full scan's). The busy-launch and droneship views had ~400 Gaussians, every texel paying
// all of them. Knockout bit 16777216 forces the full list (the A/B).
shared uint sDustMask[32];
shared uint sDustLM[1024];   // per Gaussian: the engine lights (dust[1024 + k]) whose reach touches it
void cullDustForTile(vec3 cAxis, float tileHalfAngle)
{
    uint lid = gl_LocalInvocationIndex;
    if (lid < 32u) sDustMask[lid] = 0u;
    barrier();
    uint n = min(dustCount, 1024u);
    bool all = (cloud.dbgDisableMask & 16777216u) != 0u;
    uint nEL = min(dustPad0, 32u);
    float cosTile = cos(tileHalfAngle), sinTile = sin(tileHalfAngle);
    for (uint i = lid; i < n; i += gl_WorkGroupSize.x * gl_WorkGroupSize.y) {
        vec4 cn = dust[i].cone;
        bool hit = all || cn.w <= -1.0 || dot(cn.xyz, cn.xyz) < 0.5;   // -2 or all zero: everywhere
        if (!hit) {
            // angle(tile axis, cone axis) <= cone half-angle + tile half-angle, with a little slack for rounding:
            // cos(a) >= cos(hc + ht) = cos hc cos ht - sin hc sin ht.
            float cw = clamp(cn.w, -1.0, 1.0);
            float sw = sqrt(max(1.0 - cw * cw, 0.0));
            float cSum = cw * cosTile - sw * sinTile;
            hit = (cw <= 0.0 && cosTile <= 0.0) || dot(cAxis, cn.xyz) >= cSum - 2e-3;
        }
        if (hit) {
            atomicOr(sDustMask[i >> 5u], 1u << (i & 31u));
            // The lights that can reach any point dustCloudsCS lights it at (the ray's closest approach to its centre,
            // within Mahalanobis 8 where anything at all is drawn: within 8 sigma_max, sigma_max^2 <= trace of the
            // covariance; the inverse of a matrix scaled to O(1): the entries go to 1e-12 for a bell 1000 km wide).
            uint lm = 0u;
            if (nEL > 0u && dust[i].col.w > 1.5) {
                vec4 ia = dust[i].ia, ib = dust[i].ib;
                float sc = 1.0 / max(max(ia.x, ia.y), max(ia.z, 1e-30));
                float a11 = ia.x * sc, a22 = ia.y * sc, a33 = ia.z * sc, a12 = ib.x * sc, a13 = ib.y * sc, a23 = ib.z * sc;
                float c11 = a22 * a33 - a23 * a23, c22 = a11 * a33 - a13 * a13, c33 = a11 * a22 - a12 * a12;
                float det = a11 * c11 - a12 * (a12 * a33 - a23 * a13) + a13 * (a12 * a23 - a22 * a13);
                float tr = det > 0.0 ? (c11 + c22 + c33) / det * sc : 1e30;   // trace of the covariance
                float R = 8.0 * sqrt(tr);
                vec3 cg = dust[i].c.xyz;
                for (uint k = 0u; k < nEL; ++k) {
                    vec4 ec = dust[1024u + k].c;
                    float reach = dust[1024u + k].col.z;
                    if (length(ec.xyz - cg) <= reach + R) lm |= 1u << k;
                }
            }
            sDustLM[i] = lm;
        }
    }
    barrier();
}

// The mean of cloudNoiseTex.r (Perlin-Worley), so the plumes' billows keep their mean optical depth.
const float kPlumeNoiseMean = 0.70; // ~ inverted Worley (0.45) + Perlin (0.5) x the rest

float dustErf(float x)
{
    float x2 = x * x;
    const float a = 0.147;
    float t = 1.0 - exp(-x2 * (1.2732395 + a * x2) / (1.0 + a * x2));
    return sign(x) * sqrt(max(t, 0.0));
}

vec3 dustMul(DustCloud d, vec3 v)
{
    return vec3(d.ia.x * v.x + d.ib.x * v.y + d.ib.y * v.z,
                d.ib.x * v.x + d.ia.y * v.y + d.ib.z * v.z,
                d.ib.y * v.x + d.ib.z * v.y + d.ia.z * v.z);
}

// Returns the scattered light (extinguished by the caller to tScat, its brightness-weighted distance) and, in Le,
// the emissive trails' light (already extinguished on the CPU, along the eye-to-fireball path).
// Rocket plumes (launches, 2026-10-18: SatelliteSimLaunches.cpp) are real clouds: their optical depth is summed
// (tauP), their light per unit optical depth averaged (Lp / tauP), so a thick trail saturates and hides what is
// behind it (the caller composites 1 - exp(-tauP)); tP = the distance their light comes from (light-weighted).
vec3 dustCloudsCS(vec3 obsPos, vec3 dir, vec3 sunDir, float tScene, out vec3 Le, out float tScat,
                  out vec3 Lp, out float tauP, out float tP, out float aP, out float tE)
{
    Le = vec3(0.0);
    tE = 0.0;   // the emissive light's brightness-weighted distance (a rocket's flame in front of its own mesh)
    float wE = 0.0;
    float wPL = 0.0, tPL = 0.0;   // plumes: their LIGHT-weighted distance (below)
    tScat = 0.0;
    Lp = vec3(0.0);
    tauP = 0.0;
    tP = 0.0;
    aP = 0.0;
    uint n = min(dustCount, 1024u);
    if (n == 0u)
        return vec3(0.0);
    float cosT = dot(dir, sunDir);
    const float g = 0.7;
    float hg = (1.0 - g * g) / pow(max(1.0 + g * g - 2.0 * g * cosT, 1e-4), 1.5);
    float phase = (0.6 * hg + 0.4) * (1.0 / (4.0 * PI)); // per steradian, integrates to 1
    // Water / ice exhaust: forward-peaked, with a broad part (multiple scattering in a thick trail).
    const float gP = 0.8;
    float hgP = (1.0 - gP * gP) / pow(max(1.0 + gP * gP - 2.0 * gP * cosT, 1e-4), 1.5);
    float phaseP = (0.45 * hgP + 0.55) * (1.0 / (4.0 * PI));
    float T = min(tScene, 2.0e7);
    vec3 L = vec3(0.0);
    float wT = 0.0;
    float Ls = 0.0;
    vec3 Lf = vec3(0.0);   // plumes: the sky's light (isotropic, unshadowed: launchFillVisuals)
    // The engine lights (2026-10-20, SatelliteSim::engineLightAdd: the dust list's tail, count in dustPad0): the
    // burning engines and the pads' floodlights light the plumes (and the exhaust round the pad) at night.
    uint nEL = min(dustPad0, 32u);
    vec3 LpE = vec3(0.0);
    vec3 plEnuX, plEnuY, plEnuZ;   // the eye's ENU axes in ECEF (the plumes' Earth-fixed billow field, below)
    enuBasis(pc.obsECEFDir.xyz, plEnuX, plEnuY, plEnuZ);
    vec3 plSunE = sunDir.x * plEnuX + sunDir.y * plEnuY + sunDir.z * plEnuZ;
    // The workgroup's list (cullDustForTile: a 1024-bit mask in list order, so the sums keep their order and the
    // image is the full scan's exactly). Uniform across the workgroup: no divergence in the iteration itself.
    uint nW = (n + 31u) >> 5u;
    float expo = uintBitsToFloat(dustPad1);
    bool keepAll = (cloud.dbgDisableMask & 16777216u) != 0u || !(expo > 0.0);
    for (uint w = 0u; w < nW; ++w) {
      uint bits = sDustMask[w];
      while (bits != 0u) {
        uint i = (w << 5u) + uint(findLSB(bits));
        bits &= bits - 1u;
        if (dot(dir, dust[i].cone.xyz) < dust[i].cone.w)
            continue;
        DustCloud d = dust[i];
        vec3 o = -d.c.xyz;
        float q = dot(dir, dustMul(d, dir));
        if (q <= 0.0)
            continue;
        float tc = -dot(dir, dustMul(d, o)) / q;   // closest approach (Mahalanobis) along the ray
        vec3  r  = o + tc * dir;
        float e  = dot(r, dustMul(d, r));
        if (e > 60.0)
            continue;
        float sq = sqrt(0.5 * q);
        float I  = exp(-0.5 * e) * sqrt(PI / (2.0 * q)) * (dustErf(sq * (T - tc)) - dustErf(-sq * tc));
        float tau = d.ia.w * d.c.w * max(I, 0.0);
        // A plume that adds nothing to THIS texel is skipped before its lighting (2026-10-21): its optical depth here
        // under 1e-5 of dimming, and its light (the Sun / sky colour at the phase's peak with multiple scattering, x the
        // billows' and self-shadow's largest gains: 2.6 per unit optical depth, + the engine lights) under 2e-7 of
        // white on screen. Summed over the whole list (<= 1024) that is <= 1% dimming and <= 2e-4 of white
        // (~0.7 of a display level at black), worst case; in the benchmark views ~0.1%. Wide old exhaust (a bell
        // hundreds of km across, the trails in the Earth's shadow) covers the sky at ~1e-6 a texel: in the droneship
        // view 160 of 390 Gaussians were in every texel, their lighting ~1.2 ms. Knockout 16777216 keeps them.
        if (d.col.w > 1.5 && !keepAll && tau < 1e-5) {
            // its light per unit optical depth, bounded: the Sun / sky colour, and each engine light that reaches the
            // point it is lit at (the loop below's own test) at that point (x the lumps' 1.3 and the isotropic +
            // multiple-scattering factor <= 0.16, x its albedo <= 1)
            float lb = max(max(d.col.r, d.col.g), d.col.b) * 2.6;
            uint lm = sDustLM[i];
            while (lm != 0u) {
                uint k = uint(findLSB(lm));
                lm &= lm - 1u;
                DustCloud el = dust[1024u + k];
                vec3  rl = clamp(tc, 0.0, T) * dir - el.c.xyz;
                float r2 = dot(rl, rl);
                if (r2 <= el.col.z * el.col.z)
                    lb += 0.21 * max(max(el.ia.r, el.ia.g), el.ia.b) * el.c.w / (r2 + el.ia.w * el.ia.w);
            }
            if (tau * lb * expo < 2e-7) continue;
        }
        if (d.col.w > 0.5 && d.col.w < 1.5) {   // emissive (a re-entry fireball's trail): no phase, no shadow
            Le += d.col.rgb * tau;
            float we = tau * dot(d.col.rgb, vec3(0.3333));
            wE += we;
            tE += we * clamp(tc, 0.0, T);
            continue;
        }
        vec3  P  = obsPos + clamp(tc, 0.0, T) * dir;
        if (d.col.w > 1.5) {   // a plume: sunlit by its tint (the Sun's colour there x albedo)
            // A Gaussian the EYE is inside thins out (2026-10-20, as the flames' do on the CPU: Mahalanobis radius
            // 3 -> 1.5 sigma, to 10%). Following a burning stage 300 m off, the young exhaust Gaussians beside it are
            // hundreds of metres wide and the eye sat in several: summed along every ray they were one bright ball
            // ~300 m across round the camera, hiding the vehicle and the trail's structure (close-up launch footage
            // shows the plume as the structure in front, not a fog the camera is in). Far views: unchanged.
            float eM = e + tc * tc * q;   // = o.M.o (e = o.M.o - q tc^2: both terms >= 0, so far views stay large)
            tau *= mix(0.1, 1.0, smoothstep(2.25, 9.0, eM));
            // Billows (2026-10-19): the optical depth through each Gaussian is modulated by two octaves of the
            // baked cloud noise at the ray's closest approach, in the Gaussian's own sigma units (so the structure
            // rides with its parcel and stretches as it spreads and shears), seeded per parcel (ib.w = 4 x seed +
            // the sky light, which nothing reads). Mean ~1: the trail's brightness is unchanged on average.
            // ib.w = 4 x seed + f: f >= 2 = the CPU lit it (its Sun part already Earth-shadowed) and f - 2 is the
            // sky light's share of col (launchFillVisuals, 2026-10-20: low down); else f is unread.
            float sk = floor(d.ib.w * 0.25);
            float fs = d.ib.w - 4.0 * sk;
            float flS = fs >= 2.0 ? clamp(fs - 2.0, 0.0, 1.0) : 0.0;
            float shade = 1.0;
            float lumpL = 1.0;
            float lumpA = 1.0;   // the billows' occlusion of light from inside the mass (the engine lights)
            float tLit  = -1.0;  // where its light comes from along the ray (>= 0: self-shadow the engine lights from there)
            if (tau <= 0.01) {
                // (the faint tails of the low puffs are cut as below: left whole here they drew a thin halo outside a
                // dark gap round every flame-lit ground cloud at night, rings)
                float lowK0 = 1.0 - smoothstep(3000.0, 12000.0, length(P) - R_EARTH);
                tau *= 1.0 - lowK0;
            }
            if (tau > 0.01) {   // (fainter: unmodulated; on every faint tail it cost up to 7 ms)
                // Low down (2026-10-20: the lift-off cloud, landing dust, the first km of the trail) a turbulent
                // volume: the billows are read in a field SHARED by every Gaussian there (world-fixed, ~150 m and
                // ~55 m cells), so the overlapping puffs of a ground cloud are modulated together into one lumpy
                // cauliflower instead of averaging their own noise away into a smooth haze; stronger, and floored
                // lower. Higher up each Gaussian keeps its own noise (it rides with its parcel as it spreads).
                float hP  = length(P) - R_EARTH;
                float lowK = 1.0 - smoothstep(3000.0, 12000.0, hP);
                float mN = 1.0;
                if (lowK < 1.0) {
                    // In the parcel's own frame (2026-10-21): the offset from its centre in Earth-fixed axes, in units of
                    // its width (sqrt(2 / trace M) ~ the Gaussian's smallest sigma: view-independent). It was the offset
                    // in the eye's ENU axes x sqrt(q), the inverse sigma ALONG THE VIEW: looking along an elongated
                    // trail segment vs across it scaled the billows by its length-to-width ratio, so the texture swam
                    // and rescaled as the camera moved round a high plume.
                    vec3  r0 = tc * dir - d.c.xyz;
                    float sW = sqrt(2.0 / max(d.ia.x + d.ia.y + d.ia.z, 1e-30));
                    vec3  rl = (r0.x * plEnuX + r0.y * plEnuY + r0.z * plEnuZ) / sW;
                    vec3  sd = fract(sk * vec3(0.6180339, 0.3819660, 0.1372341)) * 7.0;
                    // R = the baked Perlin-Worley (three octaves: billows of ~1 sigma down to a quarter of it).
                    float nz = textureLod(cloudNoiseTex, rl * 0.25 + sd, 0.0).r;
                    mN += (1.0 - lowK) * 1.3 * (nz - kPlumeNoiseMean);
                }
                if (lowK > 0.0) {
                    // EARTH-FIXED (2026-10-20, issue 20261020_214200 "noise evolves with position"): the point in ECEF
                    // relative to the terrain detail's integer-anchored 2048-m cell (CPU double: terrainAnchorRel), so
                    // the field stays with the air. It was P itself, Earth-centred in the EYE's ENU axes: those axes
                    // turn with the eye's position (R x the angle = the distance moved), so the whole field slid with
                    // the camera — at the reporter's 2 km/s a billow moved 2 km a second. The cells are 2048/3 and
                    // 2048/9 m (were 600 / 220): whole numbers of texture periods per anchor cell, so the cell's own
                    // integer index drops out of the repeating texture and nothing large is formed in float.
                    vec3  qE  = clamp(tc, 0.0, T) * dir + vec3(0.0, 0.0, obsPos.z - R_EARTH);   // from the sea-level point
                    vec3  pw  = cloud.terrainAnchorRel.xyz + qE.x * plEnuX + qE.y * plEnuY + qE.z * plEnuZ;
                    float nW  = textureLod(cloudNoiseTex, pw * (3.0 / 2048.0), 0.0).r;
                    float nW2 = textureLod(cloudNoiseTex, pw * (9.0 / 2048.0) + vec3(0.37, 0.71, 0.13), 0.0).r;
                    mN += lowK * (2.4 * (nW - kPlumeNoiseMean) + 1.1 * (nW2 - kPlumeNoiseMean));
                    // The billows' own light and shade: the field's change toward the Sun (one more fetch, ~70 m
                    // sunward): denser toward the Sun = in a lobe's shadow, thinner = its lit face. Shared by every
                    // Gaussian here, so the lumps of the whole mass are lit as one surface.
                    float nWs = textureLod(cloudNoiseTex, (pw + plSunE * 70.0) * (3.0 / 2048.0), 0.0).r;
                    lumpL = mix(1.0, clamp(1.0 - 3.5 * (nWs - nW), 0.3, 1.35), lowK);
                    lumpA = mix(1.0, clamp(1.0 - 2.2 * (nW - kPlumeNoiseMean) - 1.0 * (nW2 - kPlumeNoiseMean), 0.3, 1.3), lowK);
                }
                tau *= max(mN, mix(0.2, 0.05, lowK));
                // ...and its faint tails cut where the billows thin it (low down): each puff gets a crisp, lumpy edge
                // (a Gaussian's tail is a soft halo hundreds of metres wide: the ground cloud read as a glowing ball).
                tau *= mix(1.0, smoothstep(0.02, 0.35, tau), lowK);
                // Self-shadow: the Gaussian's own optical depth toward the Sun (closed form, as the view's) from where
                // its light comes from — the closest approach, moved toward the eye by up to ~1.5 sigma as the ray's
                // optical depth through it grows (a thick cloud is seen by its near surface): the sunward side bright,
                // the far side and the core dark. A floor for the light multiple scattering carries round.
                float sv  = inversesqrt(q);
                float tEf = tc - 1.5 * sv * (1.0 - exp(-0.7 * tau));
                tLit = clamp(tEf, 0.0, T);
                vec3  rE  = o + tEf * dir;
                vec3  Ms  = dustMul(d, sunDir);
                float qS  = dot(sunDir, Ms);
                if (qS > 0.0) {
                    float tcS = -dot(rE, Ms) / qS;
                    vec3  rS  = rE + tcS * sunDir;
                    float eS  = dot(rS, dustMul(d, rS));
                    float IS  = exp(-0.5 * eS) * sqrt(PI / (2.0 * qS)) * (1.0 - dustErf(sqrt(0.5 * qS) * (-tcS)));
                    float tauS = d.ia.w * d.c.w * max(IS, 0.0) * max(mN, 0.2);
                    shade = mix(exp(-tauS), 1.0, mix(0.4, 0.25, lowK));
                }
                shade *= lumpL;
            }
            // (a sharper shadow edge than the dust's: the bell's lit edge is where the Earth's shadow cuts it)
            float litP = 1.0;
            if (fs < 2.0) {
                float sp = dot(P, sunDir);
                if (sp <= 0.0) litP = smoothstep(R_EARTH * 0.9995, R_EARTH * 1.003, length(P - sp * sunDir));
            }
            Lp   += tau * d.col.rgb * (litP * shade * (1.0 - flS));   // the sunlight it scatters (phase below)
            Lf   += tau * d.col.rgb * (flS * mix(shade, 1.0, 0.5));   // the sky's light
            // (2026-10-20, QA: a burning stage seen from 300 m sat in a white ball hundreds of metres across: its
            // newest exhaust Gaussians are wide, and each was lit as if all its mass sat at the ray's closest
            // approach, next to the flame. The mass along the ray spreads over ~1 / sqrt(q): the mean inverse square
            // over it is ~1 / (r^2 + 1 / q).)
            float sAl2 = 1.0 / q;
            vec3  lpe0 = LpE;
            // Only the lights that can reach this Gaussian at all (cullDustForTile's per-Gaussian mask; view-independent).
            uint lm = sDustLM[i];
            while (lm != 0u) {
                uint k = uint(findLSB(lm));
                lm &= lm - 1u;
                DustCloud el = dust[1024u + k];
                vec3  rl = clamp(tc, 0.0, T) * dir - el.c.xyz;
                float r2 = dot(rl, rl);
                if (r2 > el.col.z * el.col.z) continue;
                // Self-shadowed (2026-10-20), as the Sun's light is: the light has to reach the parcel's lit surface
                // through the parcel's own mass between it and the engine (closed form along that segment). The young
                // exhaust round a burning stage is a thick column; lit everywhere from inside, every Gaussian's whole
                // 2-3 sigma footprint glowed at the light's full strength - a smooth bright ellipse ~6 sigma across
                // (the "ball round the camera", following at 300 m). Now its side toward the flame glows and the rest
                // takes a floor (multiple scattering carries some light round).
                float shL = 1.0;
                if (tLit >= 0.0) {
                    vec3  x0 = tLit * dir - d.c.xyz;
                    vec3  uL = el.c.xyz - tLit * dir;
                    float lL = length(uL);
                    uL /= max(lL, 1e-3);
                    vec3  Mu = dustMul(d, uL);
                    float qL = max(dot(uL, Mu), 1e-12);
                    float bL = dot(x0, Mu) / qL;
                    float sL = sqrt(0.5 * qL);
                    float IL = exp(-0.5 * max(dot(x0, dustMul(d, x0)) - bL * bL * qL, 0.0)) * sqrt(PI / (2.0 * qL)) *
                               (dustErf(sL * (lL + bL)) - dustErf(sL * bL));
                    shL = mix(exp(-d.ia.w * d.c.w * max(IL, 0.0)), 1.0, 0.25);
                }
                LpE += el.ia.rgb * (tau * lumpA * shL * (d.col.w - 2.0) * el.c.w / (r2 + sAl2 + el.ia.w * el.ia.w));
            }
            Ls   += tau * (d.col.w - 2.0);            // its albedo (col.w = 2 + albedo)
            tauP += tau;
            tP   += tau * clamp(tc, 0.0, T);
            // (2026-10-20, QA) where the plumes' LIGHT comes from: the caller puts it in front of or behind the
            // clouds by this. Weighted by optical depth alone, a dim, thick ground cloud km away outweighed the bright
            // exhaust beside a burning stage 300 m off, and the glow vanished wherever a far cloud stood behind it
            // (dark half-res blocks along the horizon).
            float wl = tau * dot(d.col.rgb, vec3(1.0 / 3.0)) * (litP * shade * (1.0 - flS) + flS) +
                       dot(LpE - lpe0, vec3(1.0 / 3.0)) + 1e-9 * tau;
            wPL += wl;
            tPL += wl * clamp(tc, 0.0, T);
            continue;
        }
        float sp = dot(P, sunDir);
        float lit = sp > 0.0 ? 1.0 : smoothstep(R_EARTH * 0.995, R_EARTH * 1.01, length(P - sp * sunDir));
        L += d.col.rgb * (tau * lit);
        wT += tau * lit;
        tScat += tau * lit * clamp(tc, 0.0, T);
      }
    }
    tScat = wT > 0.0 ? tScat / wT : 0.0;
    tE = wE > 0.0 ? tE / wE : 0.0;
    if (tauP > 0.0) {
        tP = wPL > 0.0 ? tPL / wPL : tP / tauP;
        // Per unit optical depth: single scattering by the phase, and as the trail thickens multiple scattering
        // takes over (a thick sunlit trail is a white cloud: ~albedo / pi, not the phase's 0.05); the sky light on
        // it diffusely. Then the trail's opacity.
        // (2026-10-20: + a second term for optically THICK exhaust, tau >~ 2: the low trail and the ground clouds, a
        // white cumulus of steam in sunlight, reach ~albedo / pi as the comment says; at 0.075 alone they were as dim
        // as the horizon haze behind them, invisible from a few km by day. Thin trails (the twilight bells) unchanged.)
        float ms0 = 0.075 * (1.0 - exp(-0.6 * tauP));
        float ms  = ms0 + 0.17 * (1.0 - exp(-0.25 * tauP * tauP));
        // (the engine lights keep the multiple scattering they were tuned with: with the thick term the steam round a
        // night launch saturated into a featureless orange-white ball)
        Lp = (Lp * (phaseP + ms) + Lf * (1.0 / (4.0 * PI) + ms) + LpE * (1.0 / (4.0 * PI) + ms0)) / tauP *
             (1.0 - exp(-tauP));
        aP = Ls / tauP;
    }
    return L * phase;
}

// Lightning (channels, the cloud lit around each flash, red sprites) is drawn after the sky TAA at full resolution
// (lightning.vert/.frag, SatelliteSimLightning.cpp, 2026-10-05); it was lightningCS / spriteCS here, per pixel in
// the half-res composite.

// Terrain height (m above sea level) at an ECEF-frame direction. Thin wrapper binding this
// shader's own earthElevTex/earthSpecTex to the shared decode, so the caller below is unchanged.
//
// Was a full local copy until the unification pass, carrying its own kElevRangeBeam/
// kElevOffsetBeam re-declarations of kElevRange/kElevOffset. It also fract()'d the U coordinate,
// which the shared dirToUV does not — a no-op in practice, since atan2 returns [-PI,PI] so
// (lon+PI)/(2*PI) is already in [0,1] and only the exact-1.0 endpoint differs.
//
// Mip 0.0 is deliberate (C12 follow-up #42): this used to sample mip 2.0 while sat_sky.frag's
// terrain march/bisection/normals all sampled mip 0.0 — an undocumented precision mismatch that
// let beams clip through hills the occlusion test could not "see". Sharing the decode is what
// stops that class of mismatch recurring.
// (the local terrainHeightAtDir wrapper lived here — its only caller was beamTerrainVisibility,
//  removed just below. terrain.glsl's own terrainHeightAtDir(elevTex, specTex, dir) is still
//  available if anything here needs a DEM height again.)

// (beamTerrainVisibility lived here — an up-to-32-sample line-of-sight terrain march run PER
//  BEAM PER PIXEL, i.e. up to ~1e9 DEM fetches per frame, and by a wide margin the most
//  expensive thing in this shader. It existed only because this pass had no depth buffer to
//  ask. Replaced in the pipeline-unification pass by a single comparison against sceneDepthTex;
//  see the call site in the beam loop for exactly what the substitution preserves and what it
//  deliberately changes.)

// (kCloudHorizFreq / kCloudColFreq come from common.glsl.)

// kWarpFreq/kWarpStrength moved to CloudParams (cloud.cloudWarpFreq/cloudWarpStrength) so the
// warp's shear can be balanced without a rebuild — see cloud_params.glsl for the folding
// threshold their product has to stay under.
const float kWarpDriftRate  = 0.08;
const float kWarpEvolveRate = 0.00002;


// Aurora colour + pole for the airglow polar boost; the oval itself is include/aurora_oval.glsl.
const vec3  kAuroraGroundColor  = vec3(0.15, 1.0, 0.35);
const vec3  kGeomagPoleECEF     = vec3(0.0481, -0.1543, 0.9868);
// Large-scale coverage gate — mirrors sat_sky.frag's auroraCoverage (see that file's comment for
// the full "why patches, not a solid ring" reasoning, and why it varies primarily with COLATITUDE
// rather than azimuth — a colat-constant/az-varying field's threshold crossings fall on
// constant-azimuth contours, i.e. meridians pointing straight at the pole, which is backwards from
// the intended "tracks parallel to latitude lines" look). Kept here despite the perf-sensitive
// loop because dropping it would make cloud-underside lighting look like a uniform ring while the
// sky curtain right above it is visibly patchy — worse than the extra warpPerlin3 call costs.
// Frequency/az-frequency/drift-rate are now user-tunable (cloud.auroraCoverageFreq/AzFreq/
// DriftRate, settings window "Coverage freq"/"Coverage az freq"/"Coverage drift") — only the edge
// softness stays a fixed constant here.
const float kAuroraCoverageSoftness  = 0.45;
// auroraOvalMaskLocal itself is defined further down, right after warpPerlin3 (which it calls) —
// GLSL has no forward declarations, and warpPerlin3 lives below the noise-warp block.

const float kCloud3DFadeStart = 800000.0;
const float kCloud3DFadeEnd   = 3000000.0;

const float kMarchStepsAltStart = 2000.0;
const float kMarchStepsAltEnd   = 200000.0;
const float kMarchStepsFloor    = 12.0;

// Self-shadow light-march cone grazing-angle attenuation (see cloudMarchCS): damps sunOptDepth
// directly at low sun elevation rather than extending the cone's reach (which undersamples badly
// at this codebase's low default light-step counts — see the comment at the call site).
// kGrazeShadowFloor: sunOptDepth multiplier right at the horizon (sun elevation sin == 0).
// kGrazeShadowFullSin: sin(elevation) above which no attenuation is applied — full cone-computed
// shadow strength. sin(0.3) is roughly a 17.5 degree solar elevation.
const float kGrazeShadowFloor   = 0.35;
const float kGrazeShadowFullSin = 0.3;

// Sun elevation (sin) at which the analytic vertical shading ramp reaches full strength. A
// top-bright/bottom-dark gradient is only physically meaningful when the light actually comes from
// above; at a horizontal sun it is simply wrong, and it fights the real cone-derived shadow.
const float kVertShadeSunBand = 0.35;

// UNUSED. Was the colour of a non-decaying night-sky floor for cloud tops (starlight + multiple-
// scattered air) intended to hold cloud tops above black after skyAmbientBase collapses post-
// sunset. That term persisted through full night, which is the wrong effect — what was wanted is
// twilight-only sky lighting, and twilightAmbient already provides it. Kept only because the
// colour is a reasonable starting point if a genuine night floor is ever wanted; nothing reads it.

// (BETA_R/H_R, BETA_M/H_M/G_MIE and SUN_INTENSITY come from common.glsl.)

// NOTE — this is a REAL drift against sat_sky.frag, kept deliberately for now.
// sat_sky.frag's optDepth reads `cloud.lightSamples` (the "Light samples" settings slider); this
// one is hardcoded, so the slider has never affected cloud/cirrus/aurora sun lighting at all.
// Step 6 of the unification pass gives the shared optDepth an explicit nLight parameter with each
// caller passing what it passes today, so the drift becomes visible and unifying the VALUE stays
// a separate, opt-in decision rather than a silent side effect of de-duplication.
const int N_LIGHT = 12;

const float kCirrusWindWarpFreq  = 1.5;
const float kCirrusWindWarpAmp   = 1.2;
const float kCirrusWindDriftRate = 0.05;

const float kCirrusThicknessM = 700.0;
const float kCirrusFreqScale  = 0.4;

// (phaseM / phaseCloud are in common.glsl. The "── Duplicated shared helpers, keep in sync ──"
// section that used to live here is gone along with the duplication it was warning about.)

// (raySphere is in common.glsl — one copy now, so the "keep both copies in sync" note this
// comment used to carry no longer applies.)

// DELIBERATELY NOT the shared optDepthN(), despite being the same integral.
//
// This is a specialization, and the specialization is the point: N_LIGHT is a compile-time
// constant here, so this loop can be fully unrolled. Routing it through the shared function makes
// the trip count a runtime parameter — which is unavoidable for a function that also has to serve
// sat_sky.frag's settings-tunable count — and that measurably hurt, because optDepth is called
// from five sites in this shader including inside the march.
//
// The de-duplication attempt and its revert are recorded here rather than deleted, because the
// tension is real and someone will be tempted again: what made these two copies look like
// "drift" (12 vs cloud.lightSamples) is exactly what let each one be compiled well. Sharing the
// body costs more than the duplication does. If you unify them, measure cloud_march before and
// after, at altitude and near the surface.
vec2 optDepth(vec3 p, vec3 d, float segTotal) {
    float sLen = segTotal / float(N_LIGHT);
    float odR = 0.0, odM = 0.0;
    for (int i = 0; i < N_LIGHT; ++i) {
        float h = max(0.0, length(p + d * (float(i) + 0.5) * sLen) - R_EARTH);
        odR += exp(-h / H_R);
        odM += exp(-h / H_M);
    }
    return vec2(odR, odM) * sLen;
}

// (rotateZ and remap are in common.glsl.)

uvec3 warpHashU(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 warpGradHash(ivec3 c) {
    return normalize(-1.0 + 2.0 * (vec3(warpHashU(uvec3(c))) * (1.0 / 4294967296.0)));
}
float warpPerlin3(vec3 p) {
    ivec3 i = ivec3(floor(p));
    vec3  f = fract(p);
    vec3  u = f * f * (3.0 - 2.0 * f);
    float v000 = dot(warpGradHash(i),                   f              );
    float v100 = dot(warpGradHash(i + ivec3(1,0,0)), f - vec3(1,0,0));
    float v010 = dot(warpGradHash(i + ivec3(0,1,0)), f - vec3(0,1,0));
    float v110 = dot(warpGradHash(i + ivec3(1,1,0)), f - vec3(1,1,0));
    float v001 = dot(warpGradHash(i + ivec3(0,0,1)), f - vec3(0,0,1));
    float v101 = dot(warpGradHash(i + ivec3(1,0,1)), f - vec3(1,0,1));
    float v011 = dot(warpGradHash(i + ivec3(0,1,1)), f - vec3(0,1,1));
    float v111 = dot(warpGradHash(i + ivec3(1,1,1)), f - vec3(1,1,1));
    return mix(mix(mix(v000, v100, u.x), mix(v010, v110, u.x), u.y),
               mix(mix(v001, v101, u.x), mix(v011, v111, u.x), u.y), u.z);
}


// ── Aurora sky curtain (moved here from sat_sky.frag this session — perf) ──────────────────────
// Full-featured versions (ripple warp, smoothstep fade zone) of the oval mask, distinct from
// auroraOvalMaskLocal above (that stripped-down version stays sat_sky.frag-only-style, used just
// for cloud-top upwelling here). These four are a near-verbatim duplicate of sat_sky.frag's own
// auroraFrame/auroraCoverage/auroraOvalMask/auroraCurtainNoise — keep both copies in sync, same
// convention this file already documents at the top for cloudMarch/cirrusMarch's shared helpers.
// sat_sky.frag still needs its own copies too: auroraGlowAt (terrain/ocean ambient lighting) and
// the ocean sky-reflection's aurora sample both stay full-resolution and keep calling them there.
const float kAuroraShellInnerM  = 95000.0;
const float kAuroraShellOuterM  = 300000.0;
const float kAuroraRingWarpFreq = 3.0;
const float kAuroraOvalDriftRate = 0.003;
const float kAuroraTangentFreq  = 40.0;
const float kAuroraRadialFreq   = 70.0;
const float kAuroraAltFreq      = 0.000006;
const float kAuroraScale        = 0.000001;
const vec3  kAuroraTopColor     = vec3(0.65, 0.15, 0.45);
// kAuroraGroundColor (already declared above) is numerically identical to sat_sky.frag's
// kAuroraBaseColor — reused directly below rather than redeclaring under a second name.
const vec3  kAirglowGreenColor  = vec3(0.35, 1.0, 0.25);
const vec3  kAirglowSodiumColor = vec3(1.0, 0.65, 0.15);
const vec3  kAirglowRedColor    = vec3(1.0, 0.12, 0.05);

void auroraFrame(vec3 dirECEF, vec3 poleDir, out float colat, out float az,
                  out vec3 radialT, out vec3 tangentT) {
    colat = acos(clamp(dot(dirECEF, poleDir), -1.0, 1.0));
    vec3 ref = abs(poleDir.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    tangentT = normalize(cross(poleDir, ref));
    radialT  = normalize(cross(tangentT, poleDir));
    vec3 localDir = dirECEF - poleDir * dot(dirECEF, poleDir);
    az = atan(dot(localDir, tangentT), dot(localDir, radialT));
}

float auroraCoverage(float colat, float az, float t, float storm) {
    vec2  azWarp = vec2(cos(az), sin(az)) * cloud.auroraCoverageAzFreq + t * cloud.auroraCoverageDriftRate;
    float n = warpPerlin3(vec3(azWarp, degrees(colat) * cloud.auroraCoverageFreq));
    // With arc systems on (auroraStorm.z) a storm no longer fills the whole oval (-0.6: a uniform donut from
    // orbit, issue 20261014_193231); it keeps gaps. Same in sat_sky.frag's copy. (2026-10-21: the setting is 0..1;
    // its old default 2 extrapolated mix(-0.6, -0.35) to -0.1, which is now the value at 1.)
    float threshold = mix(0.2, mix(-0.6, -0.1, clamp(cloud.auroraStorm.z, 0.0, 1.0)), clamp(storm, 0.0, 1.0));
    return smoothstep(threshold, threshold + kAuroraCoverageSoftness, n);
}

// The oval (include/aurora_oval.glsl): a ring fixed relative to the Sun whose edges follow the activity,
// with a dark polar cap inside it. Same as sat_sky.frag's copy.
float auroraOvalMask(AuroraGeom g, float colat, float az, float t, float storm) {
    float cd = degrees(colat);
    float rip = 1.5 * cloud.auroraOval2.z;  // the ripple's reach (warpPerlin3 stays well inside +-1.5)
    if (cd > cloud.auroraOval2.y || cd < g.polDeg - 0.8 - rip || cd > g.eqDeg + 3.5 + rip)
        return 0.0;
    vec2  ringP  = vec2(cos(az), sin(az)) * kAuroraRingWarpFreq;
    float ripple = warpPerlin3(vec3(ringP, t * kAuroraOvalDriftRate)) * cloud.auroraOval2.z;
    float band = auroraOvalBand(g, cd, ripple);
    if (band <= 0.0) return 0.0;
    // A substorm fills its bulge in (the coverage gate's threshold falls with the local storm).
    return band * auroraCoverage(colat, az, t, clamp(storm + 0.6 * g.boost, 0.0, 1.0));
}

// "base" is a texture read against auroraNoiseTex's R channel (baked by aurora_noise.comp)
// instead of a live warpPerlin3 call — see that file's header and sat_sky.frag's own copy of this
// function for the full derivation of the UVW mapping and the storm/frequency approximation.
float auroraCurtainNoise(float colat, float az, float altM, float t, float storm) {
    float shimmerPhase = warpPerlin3(vec3(colat * kAuroraRadialFreq * 0.3,
                                           altM * kAuroraAltFreq * 0.3,
                                           t * cloud.auroraShimmerRate)) * 2.5;
    vec3 p = vec3(az * kAuroraTangentFreq * (1.0 + storm * 0.8) + shimmerPhase,
                  altM * kAuroraAltFreq,
                  colat * kAuroraRadialFreq);
    const float kAuroraCurtainPeriod = kAuroraTangentFreq * 2.0 * PI;
    float texU = fract(p.x / kAuroraCurtainPeriod);
    float texV = clamp((p.y - 0.24) / (2.46 - 0.24), 0.0, 1.0);
    float texW = clamp(p.z / 91.6, 0.0, 1.0);
    float base = textureLod(auroraNoiseTex, vec3(texU, texV, texW), 0.0).r * 2.0 - 1.0;
    return remap(base, -0.3, 0.9, 0.0, 1.0);
}

// Per-sample curtain color/intensity — near-verbatim port of sat_sky.frag's auroraSampleAt, minus
// the (unused here) enuX/enuY/enuZ basis-rebuild since the caller already works in ECEF-relative
// terms consistent with the rest of this file.
// Outputs for the sheets (auroraSheetsAdd): the point's frame (colat, az), altitude, and the oval mask x
// night side (0 where this sample returned early).
float gAurColat = 0.0, gAurAz = 0.0, gAurAlt = 0.0, gAurOvalN = 0.0, gAurCentre = 20.0;
// The storm-time red light of this sample (auroraStormRed), kept apart from the return so the march does not
// weight it by the arc systems.
vec3 gAurRed = vec3(0.0);
// The march's top this frame (auroraMarchCS: 410 km, up to 700 km in storms); emission fades out below it.
float gAurTopM = 410000.0;

// How far into a big storm the activity is (2026-10-14): 0 below Kp 5, 1 from Kp 8.5. Drives the storm look
// (red tops, magenta borders, the red glow equatorward, blue rays) and how high the march reaches.
float auroraStormHi() { return smoothstep(5.0, 8.5, cloud.auroraMidnight.w); }

// Storm-time red aurora equatorward of the oval (2026-10-14, issue 20261014_193231 shot 6): in a great storm
// the oval's equatorward edge is a broad 630-nm glow at 250-450 km (low-energy electrons, long-lived O(1D)),
// reaching several degrees past the green aurora; from mid latitudes it is the red glow low in the north
// (May 2024, Kp 9: seen from Arizona and Mexico). Dim per unit length (a few kR), visible because a ray
// toward the horizon crosses hundreds of km of it.
vec3 auroraStormRed(AuroraGeom g, float cd, float az, float altM) {
    float k = auroraStormHi() * cloud.auroraStorm.w;
    if (k <= 0.0) return vec3(0.0);
    float ext = 7.0 * auroraStormHi();                         // reach past the equatorward edge (deg)
    float x   = (cd - g.eqDeg) / max(ext, 0.5);                // 0 at the green edge, 1 at the red edge
    if (x < -1.5 || x > 1.2) return vec3(0.0);
    float lat = smoothstep(-1.5, -0.2, x) * (1.0 - smoothstep(0.55, 1.15, x));
    // Higher toward its equatorward end (the electrons are softer there).
    float hc  = mix(290000.0, 380000.0, clamp(x, 0.0, 1.0));
    float dh  = (altM - hc) / 75000.0;
    float alt = exp(-dh * dh);
    float mlt = mix(0.25, 1.0, smoothstep(-0.4, 0.7, g.cosMlt));
    // Patchy along the oval (~1000-km structure), from the baked noise's column channel: no extra noise call.
    float p   = textureLod(auroraNoiseTex, vec3(fract(az * 0.31831 + 0.17 * x), 0.5, 0.35), 0.0).g;
    // 0.12: from orbit (looking down through ~150 km of it) a faint red skirt; from 41 deg magnetic latitude
    // at Kp 9 a dim red glow across the northern sky. 0.45 drew a solid red donut from orbit.
    return kAirglowRedColor * (0.12 * k * lat * alt * mlt * (0.15 + 1.7 * p * p) * cloud.auroraOval2.x);
}

vec3 auroraCurtainSample(vec3 rp, vec3 enuX, vec3 enuY, vec3 enuZ, vec3 sunDirECEF, float t, float storm) {
    gAurOvalN = 0.0;
    gAurRed = vec3(0.0);
    vec3 pDirECEF = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
    float altM = length(rp) - R_EARTH;
    gAurAlt = altM;
    // The frame first (the sheets carry their index across every sample, masked or not).
    vec3 poleDir  = (dot(pDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
    float colat, az; vec3 radialT, tangentT;
    auroraFrame(pDirECEF, poleDir, colat, az, radialT, tangentT);
    gAurColat = colat; gAurAz = az;
    AuroraGeom ag = auroraOvalGeom(pDirECEF);
    gAurCentre = 0.5 * (ag.eqDeg + ag.polDeg);
    float dayness = clamp((dot(pDirECEF, sunDirECEF) + 0.15) / 0.3, 0.0, 1.0);
    float night   = 1.0 - dayness;
    if (night <= 0.001) return vec3(0.0);
    gAurRed = auroraStormRed(ag, degrees(colat), az, altM) * night;
    float oval = auroraOvalMask(ag, colat, az, t, storm);
    gAurOvalN = oval * night * auroraDiscreteShare(ag, degrees(colat));
    if (oval <= 0.001) return vec3(0.0);
    const float kAuroraInnerFalloffM = 7500.0;
    const float kAuroraOuterFalloffM = 15000.0;
    float innerVert = 1.0 / (1.0 + exp(-(altM - kAuroraShellInnerM) / kAuroraInnerFalloffM));
    float outerVert = 1.0 / (1.0 + exp((altM - kAuroraShellOuterM) / kAuroraOuterFalloffM));
    float vert = innerVert * outerVert;
    if (vert <= 0.001) return vec3(0.0);

    // Column window colA/colB — same baked-texture read as sat_sky.frag's copy (G/B channels).
    float colTexU = fract(az / (2.0 * PI));
    float colTexW = clamp(colat / radians(75.0), 0.0, 1.0);
    vec2  colSample = textureLod(auroraNoiseTex, vec3(colTexU, 0.5, colTexW), 0.0).gb;
    float colA = colSample.x;
    float colB = colSample.y;
    float colLoFrac = clamp(min(colA, colB) - 0.08, 0.0, 1.0);
    float colHiFrac = clamp(max(colA, colB) + 0.08, 0.0, 1.0);
    float colLoM = mix(kAuroraShellInnerM, kAuroraShellOuterM, colLoFrac);
    float colHiM = mix(kAuroraShellInnerM, kAuroraShellOuterM, colHiFrac);
    const float kAuroraColumnFalloffM = 12000.0;
    float columnWindow = (1.0 / (1.0 + exp(-(altM - colLoM) / kAuroraColumnFalloffM)))
                        * (1.0 / (1.0 + exp((altM - colHiM) / kAuroraColumnFalloffM)));
    if (columnWindow <= 0.001) return vec3(0.0);

    float fold = mix(1.0, auroraCurtainNoise(colat, az, altM, t, storm), vert);
    vec3  col  = mix(kAuroraGroundColor, kAuroraTopColor,
                      clamp(remap(altM, kAuroraShellInnerM, kAuroraShellOuterM, 0.0, 1.0), 0.0, 1.0));
    vec3 innerAirglowCol = mix(kAirglowSodiumColor, kAirglowGreenColor, 0.5);
    col = mix(innerAirglowCol, col, innerVert);
    col = mix(kAirglowRedColor, col, outerVert);
    return col * (oval * fold * vert * columnWindow * night);
}

// One adaptive-step march over [segEnter, segExit], returning the INTEGRATED (not raw-summed)
// contribution — i.e. already multiplied by its own step length. Factored out of auroraMarchCS so
// the "ray dips below the inner shell and re-emerges on the far side" case (see that function's
// comment) can march both legs with the same step-density logic instead of duplicating the loop.
// ── Aurora SHEETS (2026-09-30, the user: sharp folded curtains in some displays, large fuzzy ones in
// others, at the same cost) ──────────────────────────────────────────────────────────────────────────
// A real curtain is a thin sheet (hundreds of metres thick) of emission hanging along the oval, folded
// into curls and spirals; it is bright where the eye sees it edge-on. The volume above (a noise field
// sampled every ~15 km) cannot be sharper than its steps. Here the sheets are the level sets S = n of an
// index field S(colat, az, t) = (colat - the oval's centre) / spacing + W, W a sum of travelling waves;
// where W's gradient across the oval passes 1 the level sets fold over (S-curls, spirals).
// Each crossing of the ray through a sheet is integrated EXACTLY: a Gaussian sheet of width sigma (in S
// units) contributes emission x sigma sqrt(2 pi) / |dS/dt| — the path length through it — so an edge-on
// sheet is a crisp bright ribbon at any resolution, with no sampling noise (clouds v2's lesson: analytic
// geometry and exact per-ray integrals, not step luck). Crossings are found between the volume march's
// own samples (a few sines each), so the cost is almost nothing.
// Hash of a sheet index (a float integer): three values in [-1, 1].
vec3 tdRandCM(float n) { return tdRand3(ivec3(int(n), 7121, 3343)); }
// centreDeg: the oval's middle at this MLT (aurora_oval.glsl), so the sheets run along the oval's shape.
float auroraSheetIndex(float colat, float az, float t, float centreDeg) {
    float sp = max(cloud.auroraSheets.y, 0.02);
    float y  = (degrees(colat) - centreDeg) / sp;
    float T  = t * (0.02 + 0.5 * cloud.auroraShimmerRate);
    float fo = cloud.auroraSheets.w;
    float W  = 0.9  * sin(3.0 * az + 0.25 * y + 0.05 * T)
             + 0.5  * sin(11.0 * az - 1.3 * y + 0.11 * T + 1.7) * fo
             + 0.45 * sin(29.0 * az + 2.1 * y - 0.23 * T + 0.4) * fo
             + 0.08 * sin(71.0 * az + 0.6 * y + 0.5 * T + 2.9);   // not x fo: finer folds than the steps alias
    return y + W;
}
// ARC SYSTEMS (2026-10-14, issue 20261014_193231: "less bands of larger, intense aurora"; from orbit the oval
// was ~50 even rings of equal strength). Sheets come in groups of kAurArcGroup; a group is an arc system or
// nothing, and a system is bright over a stretch of the oval thousands of km long and fades out along it. The
// weight at sheet index s is the two nearest groups' weights blended (continuous in s, so the diffuse volume
// can take it too). Mean ~1, so the total light is about what it was; the bright stretches are ~3-6x.
const float kAurArcGroup = 5.0;
float auroraArcGroupW(float g, float az, float t) {
    vec3  h = tdRandCM(g * 13.0 + 5003.0);
    // A first cut (55% of groups, 1-3 stretches, along-oval duty ~35%) left a Kp 9 sky over Coldfoot nearly
    // empty: fewer bands, but not that few.
    float present = smoothstep(0.0, 0.3, 0.5 * h.x + 0.5 - 0.3);            // ~70% of groups are systems
    float k  = 1.0 + floor(1.99 * (0.5 * h.y + 0.5));                       // 1-2 bright stretches round the oval
    float along = smoothstep(-0.6, 0.6, sin(az * k + 6.2832 * h.z + 0.004 * t * h.y));
    float str = 0.4 + 1.6 * (0.5 * h.z + 0.5) * (0.5 * h.z + 0.5);
    return present * along * str * 3.0;
}
float auroraArcWeight(float s, float az, float t) {
    float gs = s / kAurArcGroup - 0.5;
    float g0 = floor(gs);
    float w  = mix(auroraArcGroupW(g0, az, t), auroraArcGroupW(g0 + 1.0, az, t), smoothstep(0.15, 0.85, gs - g0));
    return mix(1.0, w, clamp(cloud.auroraStorm.z, 0.0, 1.0));
}

// The light of sheet n at a crossing (altitude h, az), per unit path length, x the oval/night mask.
// sunlit: the crossing point is out of the Earth's shadow (1) or in it (0); stormK: auroraStormHi x "Storm
// features".
vec3 auroraSheetLight(float n, float h, float az, float t, float ovalN, float sunlit, float stormK) {
    vec3  hs = tdRandCM(n);
    // Storms (2026-10-14): a share of the sheets, rising with the storm, are TALL (red-topped rayed curtains
    // reaching 300-500 km: the "red pillars" of May 2024), and the bright ones get a deep magenta lower border
    // (harder electrons reach ~90 km: N2 first positive + N2+ first negative, red + violet).
    float tall = stormK * smoothstep(0.55, 0.15, 0.5 * hs.y + 0.5 - 0.25 * stormK);
    float mag  = min(stormK, 1.0) * smoothstep(-0.2, 0.6, hs.x);
    // A sharp lower border (the green line's bottom, ~100 km, bumpy along the sheet), then a decay with
    // height; the top reddens (630 nm) past ~180 km (lower and stronger in tall sheets).
    float hb  = 100000.0 + 8000.0 * hs.x + 6000.0 * sin(az * 23.0 + n * 1.7) - 9000.0 * mag;
    float up  = h - hb;
    float sc  = mix(mix(35000.0, 70000.0, hs.y * 0.5 + 0.5), 190000.0, clamp(tall, 0.0, 1.0));
    float prof = (up < 0.0) ? exp(up / 2500.0) : exp(-up / sc);
    // Rays: vertical striations along the sheet (~2-5 km apart), drifting; brighter sheets more rayed, tall
    // sheets the most (pillars).
    float rz  = az * (170.0 + 90.0 * hs.z) + 2.5 * sin(az * 37.0 + t * 0.07 + n);
    float ray = mix(0.35, 0.12, clamp(tall, 0.0, 1.0)) + 0.65 * pow(0.5 + 0.5 * sin(rz), mix(3.0, 5.0, clamp(tall, 0.0, 1.0)));
    vec3  pink = mix(vec3(0.9, 0.25, 0.55), vec3(0.95, 0.18, 0.8), mag);
    vec3  col = mix(pink, kAuroraGroundColor, smoothstep(-1500.0, mix(3000.0, 11000.0, mag), up));
    float redLo = mix(80000.0, 35000.0, clamp(tall, 0.0, 1.0));
    col = mix(col, kAirglowRedColor * (1.4 + 0.8 * clamp(tall, 0.0, 1.0)), smoothstep(redLo, redLo + 70000.0, up));
    // Between the green and the red of a storm curtain, magenta (630 red over N2+ violet).
    col = mix(col, vec3(0.9, 0.2, 0.75), 0.55 * mag * smoothstep(8000.0, 45000.0, up) * (1.0 - smoothstep(90000.0, 180000.0, up)));
    // Sunlit tops: N2+ resonant scattering of sunlight (427.8 / 391.4 nm) turns them blue-violet.
    col += vec3(0.25, 0.35, 1.0) * (0.6 * sunlit * stormK * smoothstep(150000.0, 300000.0, h));
    float bright = (0.25 + 1.5 * (0.5 + 0.5 * hs.x) * (0.5 + 0.5 * hs.x)) * (1.0 + 0.4 * mag);
    vec3 L = col * (prof * ray * bright);
    // GIANT BLUE RAYS (rare, like the red sprites): a ~100-km stretch of one sheet whose own rays stand to
    // 350-650 km, soft at both ends and fading at the top; where the Sun reaches them (dusk / dawn, above the
    // Earth's shadow) the N2+ glow turns them blue, below it they are the sheet's dim red. The first cut was ONE
    // ~10-km ray with a flat profile, magenta when unlit: from orbit an isolated straight line (issue
    // 20261014_193231 shots 7, 9).
    float pr = cloud.auroraStorm.y * smoothstep(4.0, 7.0, cloud.auroraMidnight.w);
    if (pr > 0.0) {
        float ca = az * 10.0 + 7.0 * hs.z;                    // ~220-km cells along the sheet at the oval
        vec3  hr = tdRand3(ivec3(int(n), int(floor(ca)), 9907));
        if (0.5 * hr.x + 0.5 < pr) {
            float u    = fract(ca);
            float env  = smoothstep(0.05, 0.4, u) * (1.0 - smoothstep(0.6, 0.95, u));
            float rays = 0.15 + 0.85 * pow(0.5 + 0.5 * sin(rz), 6.0);
            float top  = mix(350000.0, 650000.0, 0.5 * hr.z + 0.5);
            float rp   = smoothstep(-4000.0, 25000.0, up) * exp(-up / (0.45 * top)) * (1.0 - smoothstep(0.5 * top, top, up));
            vec3  rc   = mix(kAirglowRedColor * 0.3, vec3(0.3, 0.42, 1.0) * 2.0, sunlit);
            L += rc * (env * rays * rp * (1.2 + 1.2 * (0.5 * hr.y + 0.5)));
        }
    }
    // Faded out below the march's top (gAurTopM): a tall storm curtain seen from orbit ended on a hard ceiling where
    // the lines of sight left the 700-km shell (shot 8).
    return L * (ovalN * (1.0 - smoothstep(gAurTopM - 0.35 * (gAurTopM - 100000.0), gAurTopM - 10000.0, h)));
}

// The sheet index at a point (ray-relative position rp), with its altitude and azimuth.
float auroraSheetIndexAt(vec3 rp, vec3 enuX, vec3 enuY, vec3 enuZ, out float altM, out float az) {
    vec3 pD = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
    altM = length(rp) - R_EARTH;
    vec3 pole = (dot(pD, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
    float colat; vec3 rT, tT;
    auroraFrame(pD, pole, colat, az, rT, tT);
    AuroraGeom ag = auroraOvalGeom(pD);
    return auroraSheetIndex(colat, az, pc.waveTime, 0.5 * (ag.eqDeg + ag.polDeg));
}

// erf, |error| < 1.3e-4 (Winitzki).
float auroraErf(float x) {
    float x2 = x * x;
    float a  = 0.147;
    return sign(x) * sqrt(1.0 - exp(-x2 * (1.2732395 + a * x2) / (1.0 + a * x2)));
}
// The per-ray march offset in [0, 1) (review 11): every ray at one elevation stepped the same positions, so
// the sheets' folds (and the volume's steps) drew HORIZONTAL bands; a per-pixel, per-frame offset turns them
// into noise the sky TAA averages away. Interleaved gradient noise, stepped by the TAA's Halton phase.
float gAurJitter = 0.5;

vec3 auroraMarchSegment(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                         vec3 sunDirECEF, float segEnter, float segExit) {
    const float kAuroraMaxStepM = 15000.0;
    const int   kAuroraStepsMin = 4;
    const int   kAuroraStepsMax = 64;
    float segLen = segExit - segEnter;
    int   N      = clamp(int(segLen / kAuroraMaxStepM), kAuroraStepsMin, kAuroraStepsMax);
    float step   = segLen / float(N);
    vec3  accum  = vec3(0.0);
    vec3  sheets = vec3(0.0);
    bool  wantS  = cloud.auroraSheets.x > 0.0;
    float sPrev = 0.0, azPrev = 0.0, hPrev = 0.0, oPrev = 0.0;
    bool  havePrev = false;
    float stormK = auroraStormHi() * cloud.auroraStorm.x;
    bool  wantArc = cloud.auroraStorm.z > 0.0;
    for (int i = 0; i < N; ++i) {
        vec3 ap = obsPos + dir * (segEnter + (float(i) + gAurJitter) * step);
        vec3 v  = auroraCurtainSample(ap, enuX, enuY, enuZ, sunDirECEF, pc.waveTime, cloud.stormStrength);
        accum += gAurRed;
        if (!wantS && !wantArc) { accum += v; continue; }
        // The index is carried across every sample (dropping it where the mask is 0 cut the sheets in
        // whole-step chunks along the oval's edge: a staircase); the mask fades linearly across a crossing.
        float S = auroraSheetIndex(gAurColat, gAurAz, pc.waveTime, gAurCentre);
        // The diffuse volume follows the arc systems too, half as strongly (it is the diffuse aurora around them).
        accum += (wantArc && v.r + v.g + v.b > 0.0) ? v * mix(1.0, auroraArcWeight(S, gAurAz, pc.waveTime), 0.6) : v;
        if (!wantS) continue;
        if (havePrev && max(oPrev, gAurOvalN) > 0.001) {
            // Each sheet n is integrated EXACTLY over this step with S linear in t (review 11): the path length
            // through a Gaussian sheet over [S0, S1] is step / |dS| x sigma sqrt(pi/2) |erf(b) - erf(a)|, which
            // tends to step x G(S - n) where the ray runs along the sheet. The first cut credited a whole
            // Gaussian (sigma sqrt(2 pi) / rate, capped at TWO STEPS) to the step holding a crossing and nothing
            // otherwise: where a ray grazed a fold, whether a sample landed past it flipped with the elevation,
            // and the fold drew as stacked bright zigzags (the user's horizontal banding).
            float dS  = S - sPrev;
            float lo = min(sPrev, S), hi = max(sPrev, S);
            const float kSigMax = 0.28;
            // Candidates within 1.2 sigma of the fuzziest width of this step's S range, faded out from 0.6 of that
            // (continuous; a fuzzy sheet's far tail is dropped, a little narrower. 3 sigma cost +0.7 ms in a storm).
            const float kReach = 1.2 * kSigMax;
            float n0 = ceil(lo - kReach);
            float n1 = floor(hi + kReach);
            float dAz = gAurAz - azPrev;
            dAz -= 6.2831853 * floor(dAz / 6.2831853 + 0.5);
            // Up to 4 sheets per step (a far, oblique ray); more is a haze of sheets, counted as such.
            int   nc = int(clamp(n1 - n0 + 1.0, 0.0, 4.0));
            float extra = max(n1 - n0 + 1.0 - 4.0, 0.0);
            float tPrevS = segEnter + (float(i) - 1.0 + gAurJitter) * step;
            for (int k = 0; k < nc; ++k) {
                float n  = n0 + float(k);
                bool  cross = (n >= lo && n <= hi && abs(dS) > 1e-6);
                float dOut  = max(lo - n, n - hi);                          // > 0: the sheet lies outside this step
                // Where along the step the sheet sits: its crossing, else the nearer end (a sheet whose Gaussian
                // tail reaches into this step, or a fold the ray grazes).
                float f  = cross ? (n - sPrev) / dS : (abs(n - sPrev) < abs(n - S) ? 0.0 : 1.0);
                float h  = mix(hPrev, gAurAlt, f);
                float az = azPrev + dAz * f;
                if (cross) {
                    // Two regula-falsi steps on the exact index: linear interpolation over a 15-km step drew each
                    // sheet's lower border as a chain of straight segments (a staircase along the edge).
                    float fa = 0.0, fb = 1.0, ga = sPrev - n, gb = S - n;
                    for (int it = 0; it < 2; ++it) {
                        float Si = auroraSheetIndexAt(obsPos + dir * (tPrevS + f * step), enuX, enuY, enuZ, h, az);
                        float gi = Si - n;
                        if ((gi < 0.0) == (ga < 0.0)) { fa = f; ga = gi; } else { fb = f; gb = gi; }
                        f = (abs(gb - ga) > 1e-6) ? fa - ga * (fb - fa) / (gb - ga) : 0.5 * (fa + fb);
                    }
                    auroraSheetIndexAt(obsPos + dir * (tPrevS + f * step), enuX, enuY, enuZ, h, az);
                }
                float oN = mix(oPrev, gAurOvalN, f);
                // The sheet's width: crisp or fuzzy per sheet and per ~500-km stretch of the oval.
                vec3  hs = tdRandCM(n);
                float crispF = smoothstep(-0.3, 0.3, sin(az * 5.0 + hs.y * 3.0 + 0.3 * n) + 2.0 * cloud.auroraSheets.z - 1.0);
                float sig = mix(kSigMax, 0.03, crispF);
                float a = (sPrev - n) / (sig * 1.4142136), b = (S - n) / (sig * 1.4142136);
                float Lp;
                if (abs(b - a) > 1e-3)
                    Lp = step * sig * 1.2533141 * abs(auroraErf(b) - auroraErf(a)) / abs(dS);
                else
                    Lp = step * exp(-a * a);
                Lp *= 1.0 - smoothstep(0.6 * kReach, kReach, dOut);
                if (Lp < 1e-4 * step) continue;
                float aw = wantArc ? auroraArcWeight(n, az, pc.waveTime) : 1.0;
                if (aw < 0.01) continue;
                // Out of the Earth's shadow? (Sunlit tops glow blue; the shadow's edge is softened over the
                // dense lower atmosphere, 60-140 km above the surface.)
                vec3  pc3 = obsPos + dir * (tPrevS + f * step);
                vec3  pE  = pc3.x * enuX + pc3.y * enuY + pc3.z * enuZ;
                float sA  = dot(pE, sunDirECEF);
                float lit = (sA > 0.0) ? 1.0 : smoothstep(R_EARTH + 60000.0, R_EARTH + 140000.0, length(pE - sA * sunDirECEF));
                sheets += auroraSheetLight(n, h, az, pc.waveTime, oN, lit, stormK) * (Lp * aw * (1.0 + extra / 4.0));
            }
        }
        sPrev = S; azPrev = gAurAz; hPrev = gAurAlt; oPrev = gAurOvalN;
        havePrev = true;
    }
    return accum * step + sheets * (3.0 * cloud.auroraSheets.x);
}

// Full sky curtain march: whole-ray bounding pre-check + adaptive-step march + light-pollution/
// moonlight suppression + atmospheric extinction. Returns the raw contribution BEFORE cloud
// suppression — main() applies that using the ALREADY-COMPUTED local cloud transmittance (A_total)
// from this same pixel/frame, more accurate than sat_sky.frag's old "early" texture pre-sample
// (which existed only because sat_sky.frag runs at full-res and needed a cheap same-frame proxy;
// this compute shader already has the real value on hand).
vec3 auroraMarchCS(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                    vec3 sunDir, vec3 sunDirECEF, float obsEffH, vec4 moonDirENU,
                    float tScene)  // shared scene depth — see cloudMarchCS
{
    const float kAuroraMarchInnerM = kAuroraShellInnerM - 55000.0;
    // Storms reach higher (2026-10-14): tall red-topped curtains and the red glow equatorward reach 450 km, a
    // blue ray 700 km. Only while the storm features are on; quiet nights march exactly as before.
    float stormReach = auroraStormHi() * step(0.001, max(cloud.auroraStorm.x, max(cloud.auroraStorm.y, cloud.auroraStorm.w)));
    float kAuroraMarchOuterM = kAuroraShellOuterM + 110000.0 + 290000.0 * stormReach;
    gAurTopM = kAuroraMarchOuterM;
    vec2 tAuroraFar = raySphere(obsPos, dir, R_EARTH + kAuroraMarchOuterM);
    vec2 tAuroraIn  = raySphere(obsPos, dir, R_EARTH + kAuroraMarchInnerM);

    // Near leg [atEnter, atExit] always. From orbit/space looking toward the horizon, a ray whose
    // closest approach dips below the padded inner sphere ALSO has a far leg [farEnter, farExit] —
    // it re-emerges from the inner sphere on the opposite side of that dip and keeps climbing back
    // out through the real (95-300km) shell before finally leaving the padded outer sphere. The
    // inner sphere's near/far crossings (tAuroraIn.x/.y) straddle the ray's closest-approach point
    // almost symmetrically (both are on the same concentric-sphere line as the outer crossings), so
    // stopping at tAuroraIn.x alone discards that entire far leg — real, un-occluded aurora most of
    // the time, since 40km (the padded inner radius) sits below all real terrain (~8.8km max) and
    // the ray only needs to graze that low, not hit ground, to reach it.
    //
    // Before this fix, atExit jumped from tAuroraFar.y (far exit of the WHOLE outer sphere) straight
    // down to tAuroraIn.x (roughly the MIDPOINT of that same chord — the two near-inner-sphere and
    // near-outer-sphere crossings are colinear with the same closest-approach foot) the instant the
    // closest-approach altitude crossed 40km — a hard ~50% drop in integrated path length at a fixed
    // world altitude, independent of camera position. Panned continuously toward the horizon from
    // space, that reads exactly as "the aurora cuts off below a fixed altitude": the curtain that
    // should dip toward the horizon and curve back up on the far side instead just stops at the dip.
    float atEnter, atExit;
    float farEnter = 0.0, farExit = 0.0;
    bool  hasFarLeg = false;
    if (obsEffH < kAuroraMarchInnerM) {
        atEnter = tAuroraIn.y;
        atExit  = tAuroraFar.y;
    } else if (obsEffH <= kAuroraMarchOuterM) {
        atEnter = 0.0;
        atExit  = tAuroraFar.y;
        if (tAuroraIn.x > 0.0 && tAuroraIn.x < atExit) {
            atExit    = tAuroraIn.x;
            farEnter  = tAuroraIn.y;
            farExit   = tAuroraFar.y;
            hasFarLeg = true;
        }
    } else {
        atEnter = tAuroraFar.x;
        if (tAuroraIn.x > 0.0) {
            atExit    = tAuroraIn.x;
            farEnter  = tAuroraIn.y;
            farExit   = tAuroraFar.y;
            hasFarLeg = true;
        } else {
            atExit = tAuroraFar.y;
        }
    }
    // Terrain occlusion. Clamp the PADDED bounds used by the step loop, but test entry against
    // the REAL shell below — the padding (55/110km) exists to catch the emission falloff tail
    // smoothly and is not itself emissive, so gating on it would re-introduce exactly the
    // "aurora pops in at ~38-40km" bug that motivated the padded/real split in the first place.
    // tScene is the FIRST terrain hit along the whole ray, so it clamps whichever leg it falls in
    // and (correctly) everything beyond — a far leg whose start is already past tScene is occluded.
    atExit = min(atExit, tScene);
    if (hasFarLeg) farExit = min(farExit, tScene);
    bool nearValid = atEnter < atExit && atExit > 0.0;
    bool farValid  = hasFarLeg && farEnter < farExit && farExit > 0.0;
    if (!nearValid && !farValid) return vec3(0.0);

    // Whole-ray bounding pre-check (ported from sat_sky.frag this session) — same 80deg
    // conservative bound (70deg worst-case oval reach + margin for 5-sample undersampling).
    // Spans the full [enter, exit] envelope (near leg's start through the far leg's end, when a far
    // leg survives) so a far-only ray can't be rejected for having sampled just the near leg.
    float boundLo = nearValid ? atEnter : farEnter;
    float boundHi = farValid ? farExit : atExit;
    const int kAuroraBoundSamples = 5;
    float minBoundColatDeg = 1e6;
    for (int bi = 0; bi < kAuroraBoundSamples; ++bi) {
        vec3 bp       = obsPos + dir * mix(boundLo, boundHi, float(bi) / float(kAuroraBoundSamples - 1));
        vec3 bDirECEF = normalize(bp.x * enuX + bp.y * enuY + bp.z * enuZ);
        vec3 bPole    = (dot(bDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
        minBoundColatDeg = min(minBoundColatDeg, degrees(acos(clamp(dot(bDirECEF, bPole), -1.0, 1.0))));
    }
    // The largest colatitude the oval can light now (auroraOval2.y) + 10 deg for the 5-sample spacing.
    if (minBoundColatDeg > cloud.auroraOval2.y + 10.0) return vec3(0.0);

    // Past this point the march genuinely runs — record the entry distance for terrain
    // suppression. Unlike cloudMarchCS/cirrusMarchCS, this canNOT just reuse atEnter: the march
    // bounds above (kAuroraMarchInnerM/OuterM) are deliberately padded 55/110km beyond the REAL
    // shell (kAuroraShellInnerM/OuterM) to catch the falloff/oval-mask tail smoothly, so "inside
    // the padded march range" (atEnter==0 in the branch above) does NOT mean "inside the real
    // emissive shell." Using atEnter directly told the terrain gate aurora content starts at
    // distance 0 — i.e. nothing can ever occlude it — for the entire padding band (~40-95km
    // altitude), well below where the aurora is actually bright. That's the real cause of a
    // reported "pops in over terrain at ~38-40km" (matches kAuroraMarchInnerM = 95000-55000 =
    // 40000 almost exactly) — a hard gate failure over that whole band, not a smooth fade. Fixed
    // by computing the entry distance against the REAL (unpadded) shell bounds instead, fully
    // decoupled from the padded range used for the step loop below.
    float realEnter;
    if (obsEffH < kAuroraShellInnerM) {
        vec2 tRealIn = raySphere(obsPos, dir, R_EARTH + kAuroraShellInnerM);
        realEnter = max(tRealIn.y, 0.0);
    } else if (obsEffH <= kAuroraShellOuterM) {
        realEnter = 0.0; // genuinely inside the real shell — content starts at the camera
    } else {
        vec2 tRealOut = raySphere(obsPos, dir, R_EARTH + kAuroraShellOuterM);
        realEnter = max(tRealOut.x, 0.0);
    }
    // The real (unpadded) shell starts behind terrain — nothing emissive is visible on this ray.
    if (realEnter >= tScene) return vec3(0.0);

    {
        float ign = fract(52.9829189 * fract(dot(vec2(gl_GlobalInvocationID.xy), vec2(0.06711056, 0.00583715))));
        gAurJitter = fract(ign + 1.6180340 * (cloud.taaJitter.x + 0.5) + 2.4142136 * (cloud.taaJitter.y + 0.5));
    }
    vec3 accumAurora = vec3(0.0);
    if (nearValid) accumAurora += auroraMarchSegment(obsPos, dir, enuX, enuY, enuZ, sunDirECEF, atEnter, atExit);
    if (farValid)  accumAurora += auroraMarchSegment(obsPos, dir, enuX, enuY, enuZ, sunDirECEF, farEnter, farExit);

    // Light pollution: the shared dark-sky exposure gate (darksky.glsl), same model and same eased
    // dome half the Milky Way and zodiacal light use in sat_sky.frag — replacing the old
    // (1 - domeValAurora * 0.9) linear dim with its own hand-tuned ceiling. The isotropic-floor
    // shape it used to apply here now lives inside darkSkySkyMag().
    //
    // Per-sample like the other two, and the gain is real: a bright active curtain and a faint
    // diffuse arc are wildly different surface brightnesses, so the strong display correctly
    // punches through suburban skyglow while the faint one washes out — where a single multiplier
    // dimmed both by the same fraction and neither ever quite disappeared.
    //
    // Anchor: accumAurora at this point is already scaled by kAuroraScale * cloud.auroraGain, so
    // it is the radiance actually composited into the sky. 0.02 -> 19.5 mag/arcsec^2 places a
    // bright curtain well above the Milky Way's core, which is right — aurora is the one feature
    // here that a city dweller genuinely can see. THIS IS THE ONE CONSTANT IN THIS CHANGE NOT
    // CALIBRATED AGAINST MEASURED DATA (the Milky Way's came from the panorama's own histogram,
    // zodiacal's from its known peak gain); accumAurora's typical magnitude can only be read off
    // in-app. If aurora reads too faint under light pollution, lower kAuroraRefLum; too strong,
    // raise it.
    //
    // 2026-10-14 (issue 20261014_193231: a Kp 9 storm invisible from an Iowa farm and from Arizona, and cut off
    // by a hard edge toward a town): the aurora takes a PHYSICAL sky model, not the Milky Way's artistic one.
    // (1) The dome's bright end is a real inner-city zenith (~18 mag/arcsec^2, Bortle 8-9), not the 13 the
    // Milky Way is tuned to wash out at: with 13 and the dome's log ramp from 1e-6, a farm's sky read ~16.5,
    // brighter than a real city, and only remote sites showed an aurora. (2) The aurora's brightness scale is the
    // physical 2.5 mag per decade (the IBC scale: 1 kR at the limit of sight, 100 kR a storm's bright arcs), so a
    // bright storm arc is several magnitudes brighter than its faint parts and survives a suburban sky, as the
    // May 2024 storm did; with 0.85 every part of it sat within a magnitude of every other and all of it went
    // at once (the hard edge where the dome stepped up toward a town). The gate is still 1 under a pristine sky.
    // (3) The pollution itself is LINEAR in the dome's city brightness (darkSkySkyMagLinear), not the log ramp
    // the Milky Way fades on: that ramp made a faint glow 83% "city" beside a 0% sector (the hard edge).
    float auroraSkyBgMag = darkSkySkyMagLinear(dir, pc.sunDirENU);

    const float kAuroraRefLum    = 0.02;
    const float kAuroraRefMag    = 19.5;
    const float kAuroraMagSpread = 2.5;
    vec3  auroraScaled = accumAurora * kAuroraScale * cloud.auroraGain;
    float auroraLum    = dot(auroraScaled, vec3(0.2126, 0.7152, 0.0722));
    float auroraObjMag = darkSkySurfMag(auroraLum, kAuroraRefLum, kAuroraRefMag, kAuroraMagSpread);

    float tmAurora         = clamp(moonDirENU.z / 0.5, 0.0, 1.0);
    float moonBrightAurora = tmAurora * tmAurora * moonDirENU.w;
    const float kAuroraMoonMaxDim = 0.85;

    float auroraVisSuppress = darkSkyVis(auroraObjMag, auroraSkyBgMag)
                             * (1.0 - moonBrightAurora * kAuroraMoonMaxDim);
    // Review 12: the gate judges the aurora against the GROUND observer's sky along the ray; from above
    // the atmosphere the background behind it is the dark Earth or space. Faded out over 40-100 km of eye
    // altitude (looking down, the ray's "sky" was below the horizon and the gate hid the aurora over land).
    auroraVisSuppress = mix(auroraVisSuppress, 1.0, smoothstep(40000.0, 100000.0, obsEffH));

    // Atmospheric extinction along THIS ray (atmosphere.glsl), to infinity — the aurora sits above
    // the air. From orbit a horizon-grazing ray still crosses a long real column; from the ground
    // or an aircraft the column above the observer is what counts. Same function as the stars,
    // satellites and Milky Way.
    // Review 12: only the air IN FRONT of the aurora. From above the shell that is the stretch to its lower
    // edge (95 km: almost no air); "to infinity" ran a downward ray through the whole atmosphere into the
    // ground, and the aurora over land from orbit was extinguished by air behind it.
    float extL = 0.0;
    if (obsEffH > kAuroraShellInnerM) {
        vec2 tIx = raySphere(obsPos, dir, R_EARTH + kAuroraShellInnerM);
        extL = (tIx.x > 0.0) ? tIx.x : 0.0;
    }
    float extinctionAurora = pow(10.0, -0.4 * atmExtinctionMag(obsPos, dir, extL, cloud.extinctionCoeff));

    // accumAurora is already integrated (each auroraMarchSegment call scales by its own step
    // length) — do not multiply by a step length again here. auroraScaled is that same
    // kAuroraScale * auroraGain product, computed above because the exposure gate needs the
    // composited radiance to judge the curtain's surface brightness.
    return auroraScaled * auroraVisSuppress * extinctionAurora;
}

// Airglow red band (630nm) supplemental march — moved here from sat_sky.frag this session (perf:
// half-res instead of full-res, same rationale as aurora above, though the win is smaller — this
// march only ever cost ~1ms full-res: fixed 16 steps, 1 noise call per sample, nowhere near
// aurora's old worst case). Green/sodium bands still ride sat_sky.frag's main atmosphere loop "for
// free" and stay there — moving just them would mean duplicating a chunk of that loop here for
// near-zero marginal win, since they already cost almost nothing riding samples that loop takes
// anyway for other reasons (see the "does the atmosphere need full-res" discussion this session).
// No cloud-suppression term — the original never had one (unlike aurora), just a plain additive
// term, so this folds straight into B_total below with no extra logic.
const float kAirglowRedPeakM      = 275000.0;
const float kAirglowRedHalfWidthM = 75000.0;
const float kAirglowNoiseFreq     = 4.0;
const float kAirglowDriftRate     = 0.015;
const float kAirglowScale         = 0.0000005;

// Coverage patchiness (cloud.airglowCoverageGain) — a lower-frequency companion to rPatch/
// airPatch above, which only wobbles the band +-40% and reads as nearly flat on screen. This
// remaps a warped noise field through a threshold, same idiom as auroraCoverage/cloud coverage
// (see auroraOvalMaskLocal above), so there are real dim/dark gaps between brighter patches
// rather than a gentle shimmer. gain=0 reproduces the old uniform-minus-shimmer look exactly;
// gain=1 is full patchiness. Takes a seed offset so different callers (coverage vs. the polar
// boost's own patch below) don't sample identical noise and end up perfectly correlated.
float airglowCoverageMask(vec3 dirECEF, float t, vec3 seedOffset) {
    float n = warpPerlin3(dirECEF * (kAirglowNoiseFreq * 0.5)
                          + vec3(t * kAirglowDriftRate * 0.6, 0.0, 0.0) + seedOffset);
    return smoothstep(-0.2, 0.5, n);
}

// Auroral-zone polar boost (cloud.airglowPolarGain, RED band only). Real 630nm redline
// nightglow brightens toward the geomagnetic pole from diffuse particle precipitation, a much
// broader effect than the discrete aurora curtain itself (kGeomagPoleECEF/auroraOvalMaskLocal
// above), so this is a wide smooth colatitude ramp rather than the tight oval band, further
// broken up by its own coverage patch so it doesn't read as a uniform bright ring.
const float kAirglowPolarInnerDeg = 12.0; // full boost within this colatitude of the pole
const float kAirglowPolarOuterDeg = 45.0; // boost fades to zero by this colatitude

vec3 airglowRedMarchCS(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                        vec3 sunDirECEF, float obsEffH, float tScene) {
    const float kAirglowInnerM = 100000.0; // = R_ATMOS - R_EARTH
    const float kAirglowFarM   = 500000.0;
    vec2 tAtmos  = raySphere(obsPos, dir, R_ATMOS);
    vec2 tAirFar = raySphere(obsPos, dir, R_EARTH + kAirglowFarM);

    float rtEnter, rtExit;
    if (obsEffH < kAirglowInnerM) {
        rtEnter = tAtmos.y;
        rtExit  = tAirFar.y;
    } else if (obsEffH <= kAirglowFarM) {
        rtEnter = 0.0;
        rtExit  = tAirFar.y;
        if (tAtmos.x > 0.0 && tAtmos.x < rtExit) rtExit = tAtmos.x;
    } else {
        rtEnter = tAirFar.x;
        rtExit  = (tAtmos.x > 0.0) ? tAtmos.x : tAirFar.y;
    }
    // Terrain occlusion. NOTE this is a genuine BUG FIX, not just a refactor: the red band never
    // contributed to the old shared tEnterCombined scalar at all, so until now it rendered
    // straight through terrain unconditionally, at every observer altitude.
    if (rtEnter >= tScene) return vec3(0.0);
    rtExit = min(rtExit, tScene);
    if (rtEnter >= rtExit || rtExit <= 0.0) return vec3(0.0);

    const int N_AIRGLOW_RED = 16;
    float rSegLen = (rtExit - rtEnter) / float(N_AIRGLOW_RED);
    vec3  accumAirglowRed = vec3(0.0);
    for (int i = 0; i < N_AIRGLOW_RED; ++i) {
        vec3  rp       = obsPos + dir * (rtEnter + (float(i) + 0.5) * rSegLen);
        float rh       = length(rp) - R_EARTH;
        vec3  rDirECEF = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
        float rDayness = clamp((dot(rDirECEF, sunDirECEF) + 0.15) / 0.3, 0.0, 1.0);
        float rNight   = 1.0 - rDayness;
        if (rNight > 0.001) {
            float rPatch = 0.6 + 0.4 * warpPerlin3(rDirECEF * kAirglowNoiseFreq
                                + vec3(pc.waveTime * kAirglowDriftRate, 17.0, -5.0));

            float coverage = airglowCoverageMask(rDirECEF, pc.waveTime, vec3(41.0, -7.0, 12.0));
            float coverageFactor = mix(1.0, coverage, clamp(cloud.airglowCoverageGain, 0.0, 1.0));

            vec3  polePos   = (dot(rDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
            float colatDeg  = degrees(acos(clamp(dot(rDirECEF, polePos), -1.0, 1.0)));
            float polarRamp = smoothstep(kAirglowPolarOuterDeg, kAirglowPolarInnerDeg, colatDeg);
            float polarPatch = airglowCoverageMask(rDirECEF, pc.waveTime, vec3(-19.0, 53.0, 8.0));
            float polarBoost = 1.0 + cloud.airglowPolarGain * polarRamp * polarPatch;

            float dzR      = (rh - kAirglowRedPeakM) / kAirglowRedHalfWidthM;
            float densAirR = exp(-dzR * dzR) * rSegLen;
            accumAirglowRed += kAirglowRedColor * cloud.airglowRedGain * densAirR * rNight * rPatch
                                * coverageFactor * polarBoost;
        }
    }
    return accumAirglowRed * kAirglowScale * cloud.airglowGain;
}

// Perf (this session): was 3 live warpPerlin3 evaluations (24 gradient-hash lookups) per call —
// the dominant live-procedural cost in the cloud march, since this runs once per in-cloud march
// sample. Baked into cloud_warp_noise.comp's field (R/G/B = the same three offset channels this
// used to compute live). kWarpBakeN MUST match the bake shader's own constant — see that file's
// header for the tiling-period / repeat-distance trade-off this bake accepted (the live version
// never repeated; the baked one tiles at a period chosen to stay unnoticeable in normal play).
const float kWarpBakeN = 16.0;
// kWarpBakeRes, wrapTexel/wrapTexel3 and cloudWarpNoiseSample now live in common.glsl —
// see that file for why the 8-tap manual blend is load-bearing and must not be collapsed into a
// single filtered fetch (tried 2026-08-04, reverted: the faceting came straight back).

vec3 cloudWarpOffset(vec3 dirECEF) {
    vec3 windOfs = vec3(cloud.cloudPhase * kWarpDriftRate + pc.waveTime * kWarpEvolveRate,
                         pc.waveTime * kWarpEvolveRate * 0.6,
                         cloud.cloudPhase * kWarpDriftRate * 0.7 + pc.waveTime * kWarpEvolveRate * 0.8);
    vec3 uvw = (dirECEF * cloud.cloudWarpFreq + windOfs) / kWarpBakeN;
    vec3 n   = cloudWarpNoiseSample(cloudWarpNoiseTex, uvw) * 2.0 - 1.0;
    return n * cloud.cloudWarpStrength;
}

// Ratio by which the warp must be scaled down for the per-COLUMN lookup.
//
// The warp is one absolute offset, but it is added to two lookups whose base frequencies differ
// by 6x: the detail/presence field at kCloudHorizFreq (480) and the per-column colH/baseH field
// at kCloudColFreq (80). An offset tuned as a sensible FRACTION of the 480 domain is therefore
// 6x too large as a fraction of the 80 domain.
//
// Measured, 2026-08-04: at the then-current strength/frequency the shear ratio (see
// cloud_params.glsl for the folding threshold) was 0.8 for the detail lookup — already at the
// edge — and 4.8 for the column lookup, i.e. folded over itself several times. Since colH sets
// each column's cloud TOP height and baseH its base, a folded field there makes tops and bottoms
// undulate with repeated, mirrored structure: the reported "wavy chips" and horizontal banding.
//
// Scaling by the frequency ratio makes the warp a constant fraction of whichever domain it is
// applied to, which is what "advect both fields together" actually means — the two now land at
// the same shear ratio instead of 6x apart.
const float kWarpColScale = kCloudColFreq / kCloudHorizFreq;   // 80/480 = 1/6



// Mean of the baked erosion field (cloudNoiseTex.g). See `useMeanErosion` below.
//
// The field is (1-worleyF1) at three frequencies with weights summing to exactly 1. For Worley F1
// at one feature point per unit cell in 3D, E[F1] = gamma(4/3) / (4*PI/3)^(1/3) ~= 0.554, so
// E[1-F1] ~= 0.446; the clamp at 1.0 truncates a small tail and nudges it up slightly. Being
// mean-preserving is the property that matters — it is what stops shadows darkening or lightening
// when the sampled term is swapped for a constant.
//
// THIS IS THE KNOB if cone shadows come out too dark (raise it) or too light (lower it).
const float kConeErosionMean = 0.45;

// `useMeanErosion` — when true, the erosion FBM is replaced by kConeErosionMean instead of being
// sampled, and `uvwDetail` goes unused. Only the sun self-shadow cone passes true.
//
// This is the fix for the "blob is a slice of the noise at the first layer of the raymarch"
// artifact, and it is the SAME remedy this function already applies to vertical presence three
// lines below — pin the altitude axis instead of sampling it.
//
// `uvwDetail`'s Z is `hNorm * kVertTiles + posZ * 2.0`, i.e. it varies CONTINUOUSLY with altitude.
// That is exactly what the presence comment below warns about, and the view march only gets away
// with it because it runs ~215 steps at <=250 m — above the documented 150-step minimum. The cone
// evaluates the same lookup at ~13 steps across the same 9.4 km shell, 16x under that minimum, and
// T3.1's geometric growth pushed its late steps to ~5 km. So the cone reads one thin Z-slab of the
// erosion volume per step and holds it across kilometres of altitude: a slice of the noise.
//
// It is aliased horizontally too — the erosion octaves are Worley at 8/16/32 cells sampled at
// kCloudHorizFreq scale, so a km-scale step samples them essentially at random. There is no
// sampling rate the cone can afford at which this term carries real information, which is why the
// mean is the honest answer rather than a cheaper lookup.
//
// If shadow erosion detail is wanted back, the middle option is to keep the fetch but drop only
// the `hNorm * kVertTiles` term from cUVWD — that removes the vertical slicing while preserving
// horizontal structure, at no perf saving.
float cloudDensity(vec3 uvwXY, vec3 uvwDetail, float hNorm, float coverage, float density,
                   float heightProfile, bool useMeanErosion) {
    // Vertical presence: THREE fixed Z-slices, not a continuous Z lookup — see
    // project_cloud_march_steps memory: sampling Z continuously at this codebase's typical
    // march-step counts reintroduces altitude-slab banding, which is why the original design
    // pinned this to constant slices in the first place. The problem with only two slices is that
    // a straight lerp between them makes every cloud's silhouette a geometric cone (wide at the
    // base slice, monotonically narrowing to the top) — a third anchor at the midpoint breaks
    // that monotonic taper into an actual bulge/waist shape without reintroducing per-march-step
    // Z sensitivity (still just 3 discrete lookups, blended smoothly by hNorm).
    //
    // T2.1 (CLOUD_PERF_PLAN.md): all three now come from ONE fetch. cloud_noise.comp bakes the
    // two offset slices into B and A at integer texel shifts (+54, +108), and a whole-texel shift
    // commutes with trilinear filtering, so .rba here returns bit-identical values to what three
    // separate .r reads at those Z offsets would. See common.glsl's channel-layout block.
    vec3  ns    = textureLod(cloudNoiseTex, uvwXY, 0.0).rba;
    float baseA = remap(ns.x, 1.0 - coverage, 1.0, 0.0, 1.0);
    float midA  = remap(ns.y, 1.0 - coverage, 1.0, 0.0, 1.0);
    float topA  = remap(ns.z, 1.0 - coverage, 1.0, 0.0, 1.0);
    float hc    = clamp(hNorm, 0.0, 1.0);
    float base  = (hc < 0.5) ? mix(baseA, midA, hc * 2.0)
                             : mix(midA, topA, (hc - 0.5) * 2.0);
    if (base <= 0.0) return 0.0;

    // G is the erosion FBM with the three Worley octaves already summed at their fixed
    // 0.625/0.25/0.125 weights — was a fourth fetch plus that sum done here per sample.
    // The *1.5 coordinate scale is now cloud.cloudErosionFreq (default 1.5 = unchanged).
    // Kept BELOW the `base <= 0.0` early-out on purpose: hoisting the sample into a thin wrapper
    // would have cost the view march that rejection on every cleared-threshold sample.
    float erosionRaw = useMeanErosion
                     ? kConeErosionMean
                     : textureLod(cloudNoiseTex,
                                  uvwDetail * cloud.cloudErosionFreq + vec3(0.37, 0.53, 0.71),
                                  0.0).g;

    // ── Erosion POLARITY (cloud.cloudErosionBillow) ──────────────────────────────────────────
    // erosionRaw is an INVERTED-Worley FBM: it peaks AT the Worley feature points. Since it is
    // used below as the threshold `base` must exceed, density is removed in round blobs centred
    // on those points and what SURVIVES is the connected Voronoi web between them. That is a
    // sponge — round holes bored through a lattice — which is why the old erosion read as "pokey
    // and speckled" rather than puffy, and why its holes all had the same blobby character.
    //
    // Cauliflower is the exact dual: survive in the lumps, remove the thin cracks between them.
    // That is what (1.0 - erosionRaw) gives. The bake's three octave weights sum to exactly 1.0,
    // so (1 - G) IS the non-inverted Worley FBM — the flip is algebraically exact and free.
    //
    // The blend is ramped by height (cloud.cloudErosionBillowH) rather than applied flat, which
    // is Schneider/Nubis's height-varying erosion character: web-polarity near the base gives
    // wispy, streaky, torn edges; lump-polarity toward the top gives billowy cauliflower. A
    // single polarity everywhere is part of why bases and tops looked like the same material.
    float billowAmt = cloud.cloudErosionBillow
                    * smoothstep(0.0, max(cloud.cloudErosionBillowH, 1e-4), hc);
    float erosion   = mix(erosionRaw, 1.0 - erosionRaw, billowAmt);

    // Edge-biased erosion: `base` doubles as a proxy for how deep inside the cloud's own presence
    // threshold this point sits (near 0 at the silhouette edge, toward 1 at the core). Biting
    // harder near the edge than at the core carves cauliflower/wisp detail into the boundary while
    // leaving dense cores comparatively solid — the previous single uniform erosion strength just
    // scaled the whole shape down evenly, which reads as smooth/rounded rather than fluffy.
    //
    // Deliberately still keyed on `base` (the purely horizontal presence depth) and NOT on the
    // height-profiled value below: keying it on the latter drives erosionAmt to full strength
    // everywhere heightProfile is small, which does not carve the top and bottom bands, it
    // DELETES them — the bases end up flat again, just higher up.
    float erosionAmt = mix(cloud.cloudErosionEdge, cloud.cloudErosionCore, base);
    float carve      = erosionAmt * erosion;
    float denom      = max(1.0 - carve, 1e-3);

    // ── How the vertical profile enters (cloud.cloudSurfaceCarve) ────────────────────────────
    // heightProfile is a smooth analytic per-column window: smoothstep up from baseH, smoothstep
    // down at colH, both with a fixed 0.05 normalised width. Multiplying the eroded field by it —
    // the original form, reproduced exactly at cloudSurfaceCarve == 0 — scales the erosion noise
    // toward ZERO precisely at the two surfaces the noise is supposed to be sculpting. So the
    // silhouette is set by the smooth ramp and the noise survives only as interior speckle: flat
    // tops, flat bases, and (with no shape detail at the base) nothing for low-sun self-shadowing
    // to pick out.
    //
    // Subtracting instead DISPLACES the surface by the erosion field, which is the standard way
    // to make an isosurface bumpy: the boundary moves to wherever base - carve - (1 - p) crosses
    // zero, so a Worley lump pushes the surface outward and a crack pulls it in. Same erosion
    // texture, same cost, structurally different silhouette.
    //
    // Containment is safe at any blend value: as heightProfile -> 0 the subtractive form's
    // numerator goes to base - carve - 1 <= 0 (base is already clamped to [0,1]), so cloud cannot
    // leak past colH/baseH no matter how the knob is set.
    float erodedMul = clamp((base - carve) / denom, 0.0, 1.0) * heightProfile;
    float erodedSub = clamp((base - carve - (1.0 - heightProfile)) / denom, 0.0, 1.0);
    float eroded    = mix(erodedMul, erodedSub, cloud.cloudSurfaceCarve);

    // NOT clamped to [0,1] any more — only to >= 0. The upper clamp was the direct cause of two
    // separate reported problems:
    //
    // 1. Hard-edged flat-coloured blobs, worst looking straight UP at cloud bases and straight
    //    DOWN at cloud tops, absent toward the horizon. A near-radial ray holds dirECEF (and so
    //    uvwXY, localCov, colH, baseH) essentially CONSTANT along its whole length, so `eroded`
    //    varies only through hNorm — a smooth, slowly-varying function. Wherever that pushed
    //    `eroded * density` past 1.0 the clamp made `d` exactly 1.0 over a large contiguous
    //    region, and with cloudOpacityScale's coreBoost a single d=1 step at 250 m is already
    //    ~exp(-5) opaque, so the ray terminated on its first sample and every pixel in that region
    //    resolved to the SAME inScatter value. Flat colour, and a hard edge exactly on the clamp
    //    boundary. Toward the horizon the ray sweeps horizontally through the noise fast enough to
    //    break the region up, which is why it did not show there. (Surface carve = 1 masked it by
    //    subtracting (1 - heightProfile), pulling the boundary bands back under the ceiling —
    //    which is precisely why that slider "fixed" it.)
    //
    // 2. "Even with the highest density setting, clouds pass a lot of light." Once a column
    //    saturated at d = 1, RAISING `density` did nothing at all — the slider was a no-op above
    //    its saturation point. That limitation is what cloudOpacityScale was added to work around;
    //    with the ceiling gone, `density` is a real control again across its whole range.
    //
    // Nothing downstream needs d <= 1: extinction feeds exp(-extinction), which is monotone and
    // already bounded, and the sun-cone accumulator is a plain weighted sum. Expect to re-tune
    // `density` / `Opacity scale` DOWNWARD — clouds are genuinely more opaque now.
    return max(eroded * density, 0.0);
}

// ── Moved (exclusive to cirrusMarch) ──────────────────────────────────────────

float cirrusWindAngleAt(vec3 dirECEF) {
    vec3 p = dirECEF * kCirrusWindWarpFreq
           + vec3(pc.waveTime * kWarpEvolveRate * 1.7,
                   cloud.cloudPhase * kCirrusWindDriftRate,
                   91.0);
    return warpPerlin3(p) * kCirrusWindWarpAmp;
}

vec3 cirrusDomainWarp(vec3 dirECEF) {
    vec3 w1 = cloudWarpOffset(dirECEF);
    vec3 p2 = dirECEF * (cloud.cloudWarpFreq * 0.35) + vec3(19.0, -7.0, 41.0)
            + vec3(pc.waveTime * kWarpEvolveRate * 0.5);
    vec3 w2 = vec3(warpPerlin3(p2),
                    warpPerlin3(p2 + vec3(5.2, 1.1, 9.3)),
                    warpPerlin3(p2 + vec3(3.3, 8.8, 2.2))) * (cloud.cloudWarpStrength * 1.5);
    return w1 + w2;
}


// ── cirrusMarchCS ───────────────────────────────────────────────
// Restructured from sat_sky.frag's cloudMarch/cirrusMarch: instead of mutating an inout `color`,
// each returns the (A, B) pair of its affine composite (`color_out = color_in*A + B`) directly,
// so the caller can combine cirrus-then-cloud into one (A_total, B_total) pair algebraically —
// see the plan's "Why two RGBA16F targets" section. No terrain clipping here (no tSurface param;
// the `if (tSurface > 0.0) tExit = min(tExit, tSurface);` lines from the original are removed).
// CLOUD_DEBUG diagnostic overlays from the original are not ported — always CLOUD_DEBUG==0 here.

void cirrusMarchCS(
    vec3  obsPos,  vec3  dir,
    vec3  enuX,    vec3  enuY,        vec3  enuZ,
    vec3  sunDir,  vec3  sunDirECEF,  float obsEffH,
    out   vec3  A_cirrus, out vec3 B_cirrus,
    out   float tCirrusEnter,  // shell entry distance for THIS ray, kNoSurfaceT if none — see
                               // cloudMarchCS's tCloudEnter, same purpose
    float tScene)  // shared scene depth — see cloudMarchCS
{
    // Runtime-tunable scattering strength — see cloudMarchCS's matching declaration.
    vec3  BETA_R = BETA_R_BASE * cloud.atmosRayleighGain;
    float BETA_M = BETA_M_BASE * cloud.atmosMieGain;

    A_cirrus = vec3(1.0);
    B_cirrus = vec3(0.0);
    tCirrusEnter = kNoSurfaceT;
    // Knockout bit 16384 (2026-08-10) — see cloudMarchCS's bit-32768 comment; same no-op fallback,
    // same reason. Cirrus had no knockout at all before this, so its cost was permanently invisible
    // inside the cloud_march bucket AND unreachable by the preset system (no preset can turn it
    // off — the tiers only scale cloudDistFadeStartM/EndM, which it happens to share with cloud).
    if ((cloud.dbgDisableMask & 16384u) != 0u) return;
    if (cloud.layers[1].enabled < 0.5) return;
    float cirrusAltFade = 1.0 - smoothstep(kCloud3DFadeStart, kCloud3DFadeEnd, obsEffH);
    if (cirrusAltFade < 0.001) return;

    float cirrusAlt  = cloud.layers[1].shellAltM;
    float shellBAlt  = cirrusAlt - kCirrusThicknessM * 0.5;
    float shellTAlt  = cirrusAlt + kCirrusThicknessM * 0.5;
    vec2  shellB     = raySphere(obsPos, dir, R_EARTH + shellBAlt);
    vec2  shellT     = raySphere(obsPos, dir, R_EARTH + shellTAlt);

    float tEnter, tExit;
    if (obsEffH < shellBAlt) {
        tEnter = shellB.y;
        tExit  = shellT.y;
    } else if (obsEffH <= shellTAlt) {
        tEnter = 0.001;
        tExit  = shellT.y;
        if (shellB.x > 0.001 && shellB.x < tExit) tExit = shellB.x;
    } else {
        if (shellT.x < 0.0) return;
        tEnter = shellT.x;
        tExit  = (shellB.x > 0.0) ? shellB.x : shellT.y;
    }
    // Render-distance cap raised 200km->450km (session 28 follow-up #10): cirrus sits at ~15km
    // altitude by default, whose own geometric horizon distance is ~sqrt(2*R_EARTH*15000)≈437km —
    // the old 200km cap cut the march off well short of that, letting stars/aurora/Milky Way show
    // straight through cirrus near the horizon instead of the cirrus layer thinning out naturally.
    tExit = min(tExit, tEnter + 450000.0);
    // Terrain occlusion on this layer's own bounds — see cloudMarchCS.
    if (tEnter >= tScene) return;
    tExit = min(tExit, tScene);
    tCirrusEnter = tEnter; // see param comment above

    // Distance-based crossfade, same as cloudMarchCS — see there for why this and not
    // maxRenderDistM is what bounds the march.
    float cirrusDistFade = 1.0 - smoothstep(cloud.cloudDistFadeStartM, cloud.cloudDistFadeEndM, tEnter);
    cirrusAltFade = min(cirrusAltFade, cirrusDistFade);
    if (cirrusAltFade < 0.001) return;
    if (tEnter >= tExit || tExit <= 0.0) return;

    // Adaptive step count (same fix as the aurora march, session 28 follow-up #9): a FIXED
    // N_CIRRUS badly serves a path length that now legitimately ranges from ~10km (steep look-down)
    // to 450km (grazing/horizon) — a fixed 14 steps across the extended cap would badly undersample
    // exactly the far, grazing case the render-distance increase above was meant to fix.
    // kCirrusStepsMax must cover the full 450km cap above at kCirrusMaxStepM resolution
    // (450000/3000=150) — the original value here (128) was computed before the render-distance
    // cap was raised in the same edit and never rechecked against it, so it silently forced
    // grazing/horizon rays into a COARSER-than-intended step size (450000/128≈3516m) right where
    // the render-distance fix mattered most. Margin added on top for the same reason the low-cloud
    // hardCap below now has more headroom too.
    const float kCirrusMaxStepM = 3000.0;
    const int   kCirrusStepsMin = 14;
    const int   kCirrusStepsMax = 200;
    float cirrusPathLen = tExit - tEnter;
    int   N_CIRRUS = clamp(int(cirrusPathLen / kCirrusMaxStepM), kCirrusStepsMin, kCirrusStepsMax);
    float segLen = cirrusPathLen / float(N_CIRRUS);
    float jitter  = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).r;

    float invStretch   = 1.0 / max(cloud.cirrusStretch, 1.0);

    vec3  cirrusTransmittance = vec3(1.0);
    vec3  cirrusScatter       = vec3(0.0);
    float cosA = dot(dir, sunDir);
    float ph   = phaseCloud(cosA);

    for (int i = 0; i < N_CIRRUS; ++i) {
        float t = tEnter + (float(i) + jitter) * segLen;
        vec3  p = obsPos + t * dir;
        float h = length(p) - R_EARTH;
        if (h < shellBAlt || h > shellTAlt) continue;
        float hNorm = (h - shellBAlt) / kCirrusThicknessM;

        vec3  pECEF = p.x * enuX + p.y * enuY + p.z * enuZ;
        // T1.3 (CLOUD_PERF_PLAN.md): pLen from h, and dirECEF hoisted above pLat so the one
        // divide serves both — bit-identical, see cloudMarchCS's copy for the Sterbenz argument.
        float pLen  = h + R_EARTH;
        vec3  dirECEF = pECEF / pLen;
        float pLon  = atan(pECEF.y, pECEF.x);
        float pLat  = asin(clamp(dirECEF.z, -1.0, 1.0));
        vec2  pUV   = vec2(fract((pLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[1].driftMult / (2.0*PI)),
                           (0.5*PI - pLat) / PI);
        float localCov = cloud.coverage * cloud.layers[1].coverageMult
                        * textureLod(earthCloudsTex, pUV, cloud.layers[1].mipLod).r;
        if (localCov < 0.02) continue;

        vec3 dirECEFDrift = rotateZ(dirECEF, cloud.cloudPhase * cloud.layers[1].driftMult);
        float wa       = cloud.cirrusWindAngle + cirrusWindAngleAt(dirECEFDrift);
        vec3  windAxis = vec3(cos(wa), sin(wa), 0.0);
        vec3 dirStretched = dirECEFDrift
                           + windAxis * dot(dirECEFDrift, windAxis) * (invStretch - 1.0);

        float hFade = smoothstep(0.0, 0.15, hNorm) * (1.0 - smoothstep(0.85, 1.0, hNorm));
        vec3  uvwXY     = dirStretched * kCloudHorizFreq * kCirrusFreqScale
                        + cirrusDomainWarp(dirECEFDrift);
        vec3  uvwDetail = uvwXY + vec3(0.0, 0.0, hNorm * 1.5);
        float d = cloudDensity(uvwXY, uvwDetail, hNorm, localCov,
                                cloud.density * cloud.layers[1].densityMult, hFade, false);
        if (d < 0.001) continue;

        float extinction = d * segLen * 8e-5;
        vec3  stepT = exp(-vec3(extinction));

        float cloudSunDot  = dot(dirECEF, sunDirECEF); // T1.3: dirECEF == normalize(pECEF)
        float cloudDayFrac = smoothstep(-0.1, 0.15, cloudSunDot);
        // See cloudMarchCS's sunGainCurve comment — same horizon/zenith blend, same rationale.
        float sunGainCurveCirrus = mix(cloud.sunGain, cloud.sunGainZenith,
                                        smoothstep(0.0, 1.0, clamp(cloudSunDot, 0.0, 1.0)));
        vec3  inScatter     = vec3(max(0.0, cloudSunDot + 0.1) * sunGainCurveCirrus) * cloudDayFrac * ph * 2.0;

        cirrusScatter       += cirrusTransmittance * (1.0 - stepT) * inScatter;
        cirrusTransmittance *= stepT;
        if (cirrusTransmittance.r < 0.02) break;
    }

    vec2 odAtmCirrus = optDepth(obsPos, dir, tEnter);
    vec3 cirrusAttn  = exp(-(BETA_R * odAtmCirrus.x + BETA_M * 1.1 * odAtmCirrus.y));
    vec3 cirrusT     = mix(vec3(1.0), cirrusTransmittance, cirrusAltFade);
    // See cloudMarchCS's A_cloud comment — same fix, same reason: A_cirrus must be the layer's own
    // transmittance alone, not blended with cirrusAttn (which belongs to B_cirrus only).
    A_cirrus = cirrusT;
    B_cirrus = cirrusAttn * cirrusScatter * cirrusAltFade;
}


// ── Per-tile beam culling (2026-08-10) ───────────────────────────────────────────────────────────
// The beam pointing-ray loop in main() measured 7.54 ms at Medium in the Anchorage worst case —
// 28% of the whole frame, and 43% of Planetarium's — because it ran min(beamCount, 2048) iterations
// on EVERY half-res texel (571 beams x 484,800 texels = 277M iterations/frame) and only rejected on
// distance at the very END, after ~7 SSBO loads, a raySphere with a sqrt and the full
// closest-approach solve.
//
// This is the standard Forward+ light-culling answer, and it fits here for free because this shader
// is already dispatched at local_size 16x16: one workgroup owns a 16x16-texel screen tile, so the
// workgroup's 256 threads can cooperatively test every beam ONCE against the tile's bounding view
// cone and leave a short shared-memory list that each thread then walks. Beams nowhere near this
// tile are rejected 256x more cheaply than before, and the per-thread iteration count becomes "how
// many beams actually cross this tile" instead of "how many beams exist anywhere" — which also
// means cost stops scaling with the observer's location (Anchorage concentrating beams was the
// whole problem).
//
// The cull ALSO hoists the loop's view-independent work. rayLen (a raySphere against R_EARTH),
// targetDistM/rangeFade and aimFade are per-beam constants that the old loop recomputed once per
// texel, 484,800 times each. They are computed here once per workgroup and passed through shared
// memory. Doing the hoist this way needs no new ReflectBeam fields and no producer-side plumbing —
// notably it does NOT depend on beam_self_march.comp, whose dispatch knockout (bit 512) would
// otherwise have been left with an unsafe fallback.
//
// CONSERVATISM ARGUMENT — this must never reject a beam that any texel in the tile would have
// drawn, or beams pop at tile boundaries. The per-texel test is
// perpDist <= max(kDebugRayRadiusM, t*kDebugRayMinAngRad) * 4. Two rays sharing an origin and
// diverging by at most the tile's half-angle are separated by at most tFar*tileHalfAngle anywhere
// within range tFar; the closest point on the view ray to any point of the beam segment lies within
// tFar of the origin (tFar bounds the segment's own distance), so the per-texel perpDist differs
// from the tile-centre one by at most that. Using tFar rather than the centre ray's own t for the
// radius term bounds the threshold the same way. Hence tile-centre perpDist <= radiusMax*4 + slack
// is implied by the per-texel test passing — the cull is a strict superset.
//
// Overflow falls back to scanning the whole buffer rather than dropping beams, so a pathological
// tile is slow, never wrong.
const uint kTileBeamMax = 384u;
shared uint  sTileBeamCount;
shared uint  sTileOverflow;
shared uint  sTileBeamIdx[kTileBeamMax];
shared float sTileBeamRayLen[kTileBeamMax];
shared float sTileBeamFade[kTileBeamMax];   // rangeFade * aimFade, both view-independent

// Shared by the cull and by main()'s own per-texel loop — they must agree exactly on the accept
// radius or the cull stops being conservative.
const float kDebugRayRadiusM   = 700.0;
const float kDebugRayMinAngRad = 0.0015; // ~1.2 half-res pixels at the default FOV
const float kDebugRayMaxLenM   = 3000000.0;
const float kDebugRayAimMaxRad = radians(10.0);
const float kSkyBeamFadeM      = 200000.0;

vec3 tileRayDir(vec2 texel, ivec2 size, float tanHalfFov, mat3 camToENU) {
    vec2 ndc = (texel / vec2(size)) * 2.0 - 1.0;
    return normalize(camToENU * vec3(ndc.x * tanHalfFov * pc.aspect, -ndc.y * tanHalfFov, -1.0));
}

// The workgroup's bounding view cone: axis plus half-angle covering every texel it owns. Shared by
// both per-tile culls (beam pointing rays and cloud lights) so they cannot disagree about what
// "this tile" means. Edge workgroups extend past the image, giving a slightly wider cone — the
// conservative direction.
void tileViewCone(ivec2 size, float tanHalfFov, mat3 camToENU, out vec3 cAxis, out float halfAngle) {
    vec2 tileMin = vec2(gl_WorkGroupID.xy) * vec2(gl_WorkGroupSize.xy);
    vec2 tileMax = tileMin + vec2(gl_WorkGroupSize.xy);
    vec3 d00 = tileRayDir(vec2(tileMin.x, tileMin.y), size, tanHalfFov, camToENU);
    vec3 d10 = tileRayDir(vec2(tileMax.x, tileMin.y), size, tanHalfFov, camToENU);
    vec3 d01 = tileRayDir(vec2(tileMin.x, tileMax.y), size, tanHalfFov, camToENU);
    vec3 d11 = tileRayDir(vec2(tileMax.x, tileMax.y), size, tanHalfFov, camToENU);
    cAxis = normalize(d00 + d10 + d01 + d11);
    float cosHalf = min(min(dot(cAxis, d00), dot(cAxis, d10)),
                        min(dot(cAxis, d01), dot(cAxis, d11)));
    halfAngle = acos(clamp(cosHalf, -1.0, 1.0));
}

void cullBeamsForTile(vec3 cAxis, float tileHalfAngle, vec3 obsPos) {
    if (gl_LocalInvocationIndex == 0u) {
        sTileBeamCount = 0u;
        // Knockout bit 131072 forces the overflow path, i.e. the exact pre-cull full-buffer scan.
        // This is the cull's correctness A/B: toggle it and the rendered image must be pixel-
        // identical, because the fallback recomputes precisely what the cull would have supplied.
        // If beams instead appear/disappear on a 16x16-texel grid with the cull ON, the
        // conservatism bound in this function's header is wrong and the slack term needs widening
        // — that is the one failure mode this design can have, and it is unmistakable on screen.
        sTileOverflow  = ((cloud.dbgDisableMask & 131072u) != 0u) ? 1u : 0u;
    }
    barrier();

    // Uniform across the workgroup (push constants only), so the barriers above and below stay in
    // uniform control flow while the scan itself is skipped when beams aren't drawn at all.
    if (cloud.showBeamDebugRays != 0u && (cloud.dbgDisableMask & 8192u) == 0u && (cv2.beam.x <= 0.0 || cv2.atmo.w > 0.0)
        && (cloud.dbgDisableMask & 131072u) == 0u) {
        uint activeCount = min(beamCount, BEAM_MAX_ACTIVE);
        for (uint bi = gl_LocalInvocationIndex; bi < activeCount; bi += gl_WorkGroupSize.x * gl_WorkGroupSize.y) {
            if (beams[bi].intensity <= 0.0) continue;

            // View-independent fades, hoisted out of the per-texel loop.
            float targetDistM = length(beams[bi].targetENU);
            if (targetDistM > cloud.beamMaxRangeM + kSkyBeamFadeM) continue;
            float rangeX    = clamp((targetDistM - (cloud.beamMaxRangeM - kSkyBeamFadeM)) / kSkyBeamFadeM, 0.0, 1.0);
            float rangeFade = 1.0 - (rangeX * rangeX * (3.0 - 2.0 * rangeX));
            float aimFade   = 1.0 - smoothstep(0.0, kDebugRayAimMaxRad, beams[bi].aimErrorRad);
            float fade      = rangeFade * aimFade;
            if (fade <= 0.0) continue;

            vec3  satENU = beams[bi].satENU;
            vec3  rayDir = beams[bi].reflectDirENU;
            vec2  groundHit = raySphere(obsPos + satENU, rayDir, R_EARTH);
            float rayLen = (groundHit.x > 0.0) ? min(groundHit.x, kDebugRayMaxLenM) : kDebugRayMaxLenM;

            // Closest approach of the TILE CENTRE ray to this beam segment — the same solve main()
            // does per texel, run once per workgroup here.
            vec3  w0 = -satENU;
            float b = dot(cAxis, rayDir);
            float d = dot(cAxis, w0);
            float e = dot(rayDir, w0);
            float den = 1.0 - b * b;
            float s = (den > 1e-6) ? (e - b * d) / den : e;
            s = clamp(s, 0.0, rayLen);
            float t = s * b - d;
            if (t < 0.0) { t = 0.0; s = clamp(e, 0.0, rayLen); }
            float perpDist = length(satENU + rayDir * s - cAxis * t);

            float tFar      = max(length(satENU), length(satENU + rayDir * rayLen));
            float radiusMax = max(kDebugRayRadiusM, tFar * kDebugRayMinAngRad);
            if (perpDist > radiusMax * 4.0 + tFar * tileHalfAngle) continue;

            uint slot = atomicAdd(sTileBeamCount, 1u);
            if (slot < kTileBeamMax) {
                sTileBeamIdx[slot]    = bi;
                sTileBeamRayLen[slot] = rayLen;
                sTileBeamFade[slot]   = fade;
            } else {
                sTileOverflow = 1u;
            }
        }
    }
    barrier();
}

// Rain, snow and diamond dust at the eye are drawn as PARTICLES after the sky TAA (rain_particles.vert,
// 2026-10-04). They were drawn here (rainDrops: a per-pixel lattice search, review 3-22) into the half-res
// composite, where the TAA smeared them; the rain map and its bursts are in cloud_lightning.glsl.

void main() {
    ivec2 size  = imageSize(targetA);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);

    // Reconstruct the same view ray sat_sky.vert/sat_sky.frag build, evaluated directly at this
    // half-res texel instead of via vertex interpolation — identical affine transform, just
    // sampled at a coarser grid.
    float tanHalfFov = tan(pc.fovYRad * 0.5);
    mat3  camToENU   = mat3(transpose(pc.skyView));
    vec3  dir        = tileRayDir(vec2(coord) + 0.5, size, tanHalfFov, camToENU);

    vec3  sunDir = normalize(pc.sunDirENU.xyz);

    vec3 enuZ = normalize(pc.obsECEFDir.xyz);
    vec3 enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    vec3 enuY = cross(enuZ, enuX);
    vec3 sunDirECEF = sunDir.x * enuX + sunDir.y * enuY + sunDir.z * enuZ;

    // Observer height resolved on the GPU via the SAME shared helper sat_sky.frag and
    // scene_depth.comp use. This shader previously took a CPU-computed value straight off
    // pc.obsEffH while sat_sky.frag did its own texture lookup, so the two disagreed about where
    // the observer was. That was harmless while each only compared distances against itself, but
    // it is not once one pass produces a depth buffer the other consumes — a few metres of
    // disagreement at the observer becomes a visible occlusion mismatch along grazing rays.
    // pc.obsEffH is still the CPU's value and is deliberately no longer read here.
    //
    // Resolved here, ABOVE the out-of-bounds return, because the beam cull below needs it. Safe for
    // the out-of-range threads of an edge workgroup: it depends only on pc.obsECEFDir, not on
    // coord, so it is workgroup-uniform and reads nothing out of range.
    float obsEffH = observerEffHeightDetailed(earthElevTex, earthSpecTex, pc.obsECEFDir);
    vec3  obsPos  = observerPos(obsEffH);

    // Both per-tile culls run BEFORE the out-of-bounds return: they contain barriers, which every
    // thread in the workgroup must reach.
    vec3  tileAxis;
    float tileHalfAngle;
    tileViewCone(size, tanHalfFov, camToENU, tileAxis, tileHalfAngle);
    cullBeamsForTile(tileAxis, tileHalfAngle, obsPos);
    if (dustCount > 0u) cullDustForTile(tileAxis, tileHalfAngle);   // dustCount: uniform, so the barriers are too

    if (coord.x >= size.x || coord.y >= size.y) return;

    // Shared scene depth for this exact texel. Read ONCE here, not per beam: the beam loop below
    // runs up to 2048 iterations and every one of them needs the same value. texelFetch rather
    // than texture() because this dispatch grid and sceneDepthTex are the same size — an exact
    // 1:1 mapping with no filtering, so the value read is exactly the value written.
    float tScene = texelFetch(sceneDepthTex, coord, 0).r;

    vec3  A_cirrus, B_cirrus;
    float tCirrusEnter;
    cirrusMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, obsEffH,
                  A_cirrus, B_cirrus, tCirrusEnter, tScene);

    // The volumetric clouds: cloud_v2_march.comp + cloud_v2_resolve.comp, already resolved to this
    // grid (radiance, transmittance; mean distance, occlusion distance).
    // Knockout 32768 (Planetarium, Potato): the v2 passes are not dispatched and their images are stale.
    const bool cv2Off = (cloud.dbgDisableMask & 32768u) != 0u;
    // S9: with full-res clouds the resolved images are twice this grid; this texel composites their 2x2 box (the
    // bilinear tap at its centre, exactly what cloud_v2_combine.comp subtracts again) with the effects at half res.
    const bool fullRes = cv2.grid.w > 0.5 && !cv2Off && textureSize(cv2ResolvedTex, 0) == size * 2;
    vec4  rc = cv2Off ? vec4(0.0, 0.0, 0.0, 1.0)
             : fullRes ? textureLod(cv2ResolvedTex, (vec2(coord) + 0.5) / vec2(size), 0.0)
                       : texelFetch(cv2ResolvedTex, coord, 0);
    vec2  rd = cv2Off ? vec2(0.0, -1.0) : texelFetch(cv2ResolvedDepthTex, coord, 0).xy;
    if (fullRes) {
        // The box's distances: the mean of the four opacity-weighted, the occlusion distance the nearest.
        float dS = 0.0, wS = 0.0, dOcc = kNoSurfaceT;
        for (int k = 0; k < 4; ++k) {
            ivec2 q  = min(coord * 2 + ivec2(k & 1, k >> 1), size * 2 - 1);
            vec2  dk = texelFetch(cv2ResolvedDepthTex, q, 0).xy;
            float ok = 1.0 - texelFetch(cv2ResolvedTex, q, 0).a + 1e-3;
            if (dk.x > 0.0) { dS += ok * dk.x; wS += ok; }
            if (dk.y >= 0.0) dOcc = min(dOcc, dk.y);
        }
        rd = vec2(wS > 0.0 ? dS / wS : 0.0, dOcc < kNoSurfaceT ? dOcc : -1.0);
    }
    // Review 9: an ISOLATED cloud texel (at most one of its 8 neighbours holds comparable cloud) is a
    // sub-pixel wisp or a shaded cloud side the sparse march catches on some frames: along far cloud edges
    // over the sea they were dark 2x2 specks that flickered (user snapshot). Replaced by its 3x3 tent — a
    // soft, faint dot. Cloud bodies and continuous edges have neighbours and are untouched.
    if (!fullRes) {   // S9: done at full res by cloud_v2_combine.comp
        float oc = 1.0 - rc.a;
        if (oc > 0.02) {
            ivec2 rs = textureSize(cv2ResolvedTex, 0);
            vec4  tent = rc * 4.0;
            float cnt = 0.0, oLo = oc;
            for (int k = 0; k < 9; ++k) {
                ivec2 o = ivec2(k % 3 - 1, k / 3 - 1);
                if (o == ivec2(0)) continue;
                vec4 nb = texelFetch(cv2ResolvedTex, clamp(coord + o, ivec2(0), rs - 1), 0);
                tent += float((2 - abs(o.x)) * (2 - abs(o.y))) * nb;
                cnt  += step(0.5 * oc, 1.0 - nb.a);
                oLo   = min(oLo, 1.0 - nb.a);
            }
            // ... and an EDGE texel (the opacity drops sharply across it) leans 60% on the tent: the
            // half-res silhouette's lone dark (shaded-wisp) texels flickered as the sparse march caught them.
            float kE = max(1.0 - smoothstep(1.0, 3.0, cnt), 0.6 * smoothstep(0.3, 0.8, oc - oLo));
            rc = mix(rc, tent * (1.0 / 16.0), kE);
        }
    }
    // Review 10 (2026-09-30): a texel with cloud but NO distance (the resolve blended history's cloud into a
    // texel whose own sample found none: rd.x = 0) takes its neighbours' opacity-weighted cloud distance.
    // The sky pass skipped it and split the air at the gap texels' distance beside it (the thin cirrus, a
    // few km): the cloud edge got a fraction of the haze in front of it and drew as a dark speck. Seen from
    // inside the cirrus at 9 km (user snapshot, 62 N): specks all along the cumulus edges, flickering.
    if (!fullRes && 1.0 - rc.a > 0.02 && rd.x <= 1.0) {
        ivec2 rs = textureSize(cv2ResolvedDepthTex, 0);
        float dS = 0.0, wS = 0.0;
        for (int k = 0; k < 9; ++k) {
            ivec2 o = ivec2(k % 3 - 1, k / 3 - 1);
            if (o == ivec2(0)) continue;
            ivec2 q  = clamp(coord + o, ivec2(0), rs - 1);
            float dn = texelFetch(cv2ResolvedDepthTex, q, 0).x;
            float on = 1.0 - texelFetch(cv2ResolvedTex, q, 0).a;
            if (dn > 1.0) { dS += on * dn; wS += on; }
        }
        if (wS > 1e-4) rd.x = dS / wS;
    }
    // Review 18: the far cloud layer (cloud_v2_far.comp, composited by sat_sky.frag) takes over the volumetric
    // clouds by its share (CloudParams.farBlend); at 1 the march is not even dispatched (stale image).
    rc.rgb *= 1.0 - cloud.farBlend;
    rc.a    = mix(rc.a, 1.0, cloud.farBlend);
    if (cloud.farBlend >= 0.999) rd = vec2(0.0, -1.0);
    else if (rc.a >= 0.1) rd.y = -1.0;   // no longer opaque (the march writes y only where T < 0.1)
    vec3  A_cloud       = vec3(rc.a);
    vec3  B_cloud       = rc.rgb;
    float tCloudOcclude = rd.y;
    float tCloudMeanT   = (rd.x > 0.0) ? rd.x : kNoSurfaceT;

    vec3  A_total = A_cirrus * A_cloud;
    vec3  B_total = B_cirrus * A_cloud + B_cloud;
    // S9: the composite's derivatives with respect to the cloud's transmittance a (A_cloud = vec3(a)) and radiance b,
    // carried through every step below (exact for the affine steps, first order for the pow() suppressions).
    vec3  gAA = A_cirrus;      // dA_total / da
    vec3  gBA = B_cirrus;      // dB_total / da
    float gBB = 1.0;           // dB_total / db (times the identity)

    // Debug view 6: red = the rain rate at the eye (the rain map, bursts included), green = any rain within the map.
    if (int(cv2.shell.z + 0.5) == 6 && cv2.rain.x > 0.0) {
        float rainNear = max(max(cv2RainWgMax[0], cv2RainWgMax[1]), max(cv2RainWgMax[2], cv2RainWgMax[3]));
        B_total = vec3(cv2RainMapAt(vec2(0.0)) * cv2RainBurst(cv2.precip.y), rainNear, 0.0) * 0.05;
    }

    // Aurora sky curtain (moved here this session — perf: half-res instead of full-res).
    // Cloud suppression uses the LOCAL A_total already computed above — more accurate than
    // sat_sky.frag's old "early" texture pre-sample, which only existed because that shader runs
    // at full-res and needed a cheap same-frame proxy; this compute shader has the real value on
    // hand already. Folding the result directly into B_total means it inherits the same terrain-
    // occlusion handling sat_sky.frag already applies to the whole composite (a behavior change
    // from before, when aurora ignored terrain occlusion entirely — this is more physically
    // correct: terrain that blocks the view of the much-closer cloud layer necessarily blocks the
    // far higher aurora shell along that same ray too).
    vec3 auroraContrib = vec3(0.0);
    if ((cloud.dbgDisableMask & 32u) == 0u) {
        auroraContrib = auroraMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF,
                                       obsEffH, pc.moonDirENU, tScene);
    }
    if (dot(auroraContrib, auroraContrib) > 0.0) {
        bool  auroraBehindClouds = (obsEffH < kAuroraShellInnerM);
        float cloudBlockLocal    = dot(A_total, vec3(1.0 / 3.0));
        const float kAuroraCloudSuppressPower = 3.0;
        float auroraCloudSuppress = auroraBehindClouds
            ? pow(clamp(cloudBlockLocal, 0.0, 1.0), kAuroraCloudSuppressPower)
            : 1.0;
        B_total += auroraContrib * auroraCloudSuppress;
        if (auroraBehindClouds && cloudBlockLocal > 0.0 && cloudBlockLocal < 1.0)
            gBA += auroraContrib * (3.0 * cloudBlockLocal * cloudBlockLocal * dot(gAA, vec3(1.0 / 3.0)));
    }

    // Kessler dust clouds: above the weather, so seen from below the clouds hide them as they hide the aurora.
    float tEmitNear = kNoSurfaceT;
    if (dustCount > 0u) {
        // Extinction to the cloud, not to infinity: looking down from above the air, the path to infinity ends in
        // the ground through the whole atmosphere, and every cloud and fireball trail below the eye went dark.
        vec3  dLe, pL;
        float dT, pTau, pT, pA, eT;
        vec3  dc = dustCloudsCS(obsPos, dir, sunDir, tScene, dLe, dT, pL, pTau, pT, pA, eT);
        // Where the nearest emissive / plume light is, for a texel with no cloud of its own (alpha below): sat_sky.frag
        // composites this texel over a satellite / rocket MESH only when its distance is nearer than the mesh, and
        // the no-cloud marker (60000 km) hid a burning stage's flame behind the stage's own hull (2026-10-20).
        if (dot(dLe, dLe) > 0.0) tEmitNear = min(tEmitNear, max(eT, 1.0));
        if (pTau > 1e-3) tEmitNear = min(tEmitNear, max(pT, 1.0));
        // Rocket plumes: in front of the clouds (nearer than their mean distance) they cover them, behind they are
        // seen through them; either way they dim what lies behind them (the sky, the stars) by exp(-tau).
        if (pTau > 1e-6) {
            float pExt = pow(10.0, -0.4 * atmExtinctionMag(obsPos, dir, max(pT, 1.0), cloud.extinctionCoeff));
            // What it hides behind it, less the sky's light it scatters back toward the eye (lit by the same sky as
            // the background: a bright plume barely dims the sky, a sooty one silhouettes against it).
            float pTr  = exp(-pTau) + 0.85 * pA * (1.0 - exp(-pTau));
            if (pT < tCloudMeanT) {
                B_total = B_total * pTr + pL * pExt;
                gBA *= pTr;
                gBB *= pTr;
            } else {
                B_total += pL * pExt * A_total;
                gBA += pL * pExt * gAA;
            }
            A_total *= pTr;
            gAA *= pTr;
        }
        if (dot(dc, dc) + dot(dLe, dLe) > 0.0) {
            float ext = dot(dc, dc) > 0.0 ? pow(10.0, -0.4 * atmExtinctionMag(obsPos, dir, max(dT, 1.0), cloud.extinctionCoeff)) : 0.0;
            // Clouds hide them only from below the weather (they are all above 45 km): the aurora's 95-km test hid
            // fireball trails behind the clouds UNDER them when looking down from 60-95 km.
            float sup = obsEffH < 20000.0 ? pow(clamp(dot(A_total, vec3(1.0 / 3.0)), 0.0, 1.0), 3.0) : 1.0;
            // The emissive light (a rocket's flame and its lit exhaust, a fireball's trail) only where the clouds are
            // NOT behind it (2026-10-20, issue 20261019_222829): a launch's glow seen from 3.7 km over a cumulus far
            // below it was cut out by that cloud, a black hole in the glow.
            bool  eFront = dot(dLe, dLe) > 0.0 && eT < tCloudMeanT;
            float supE = eFront ? 1.0 : sup;
            B_total += dc * ext * sup + dLe * supE;
            float mA = dot(A_total, vec3(1.0 / 3.0));
            if (obsEffH < 20000.0 && mA > 0.0 && mA < 1.0)
                gBA += (dc * ext + (eFront ? vec3(0.0) : dLe)) * (3.0 * mA * mA * dot(gAA, vec3(1.0 / 3.0)));
        }
    }

    // Airglow red band (moved here this session — perf). No cloud-suppression term — the
    // original never had one either, just a plain additive contribution.
    if ((cloud.dbgDisableMask & 16u) == 0u) {
        B_total += airglowRedMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDirECEF, obsEffH, tScene);
    }

    // ── Reflect-Orbital beam pointing ray — NAME IS STALE, THIS IS THE REAL BEAM (C12 follow-up
    // #12, reworked into production visual in a later session — see showBeamDebugRays' own comment
    // in SatelliteSim.h, and BEAM_CLOUD_PLAN.md 2026-08-09) ───────────────────────────────────────
    // Draws each active beam's mirror's ACTUAL current reflected-sunlight direction
    // (reflectDirENU) as a line extending from the satellite to its ground intersection — this IS
    // the beam a player sees, not a diagnostic overlay, on by default. Independent of the
    // physically-shaped glow above (no phase function, no altitude restriction) and — this is the
    // real, currently-open bug, not a design choice — **no cloud gating at all**, occluded by
    // terrain only. Since this ray is what's actually visible, its lack of cloud awareness is why
    // beams read as passing straight through cloud regardless of the ground-spot/glow fixes
    // elsewhere in this file. Being replaced by the per-beam march project (BEAM_CLOUD_PLAN.md).
    //
    // Analytic closest approach, NOT point sampling. The original version walked 40 discrete
    // points along each ray and splatted a Gaussian at each — which reads as a dotted line
    // whenever the spacing exceeds the tube radius, and it always does: a ray traced from LEO to
    // the ground is 500-2000 km long, so 40 samples sit 12-50 km apart against a tube a couple of
    // km wide. Adding samples only pushes the threshold around; solving for the single nearest
    // point on the beam SEGMENT makes the line exactly continuous at any length and any viewing
    // angle, and costs one closed-form solve per beam instead of 40 splats.
    //
    // The cancellation hazard that motivated the old sampling approach is avoided the same way
    // the rest of the beam code avoids it: the system is set up from beams[bi].satENU (the small
    // observer-relative offset) rather than from an obsPos/satWorldPos difference, so no
    // large-magnitude subtraction is ever formed. Both direction vectors are unit length, which
    // is what collapses the usual 2x2 solve to the 1 - b*b denominator below.
    // Knockout bit 8192 (2026-08-10). This loop is per-PIXEL over up to BEAM_MAX_ACTIVE (2048)
    // beams and, until now, was gated ONLY by showBeamDebugRays — knockout bit 128
    // ("Reflect-Orbital beams") gates sat_sky.frag's ground spot and the per-sample volumetric
    // glow but has never reached this loop, a gap CLAUDE.md already flagged as "left as-is;
    // flagged here so a future profiling session doesn't assume bit 128 isolates the full beam
    // rendering cost." This IS that session. Its cost is therefore invisible in every capture
    // taken so far AND unreachable by every graphics preset (Planetarium sets bit 128 and still
    // pays for this in full), which makes it the prime suspect for the several-ms floor the
    // cloud_march bucket keeps even at Planetarium with cloudCoverage=0.
    // The drawn pointing ray: the beam itself while the volumetric shafts are off (cv2.beam.x, "Beam
    // shafts"), and each beam's own faint streak beside them ("Beam lines", cv2.atmo.w; 2026-09-28).
    if (cloud.showBeamDebugRays != 0u && (cloud.dbgDisableMask & 8192u) == 0u && (cv2.beam.x <= 0.0 || cv2.atmo.w > 0.0)) {
        // Thin off-white/yellow line (2026-08-06 user request; previously a 2500 m green tube,
        // itself already thinned from 15000 m in C12 follow-up #13). kDebugRayMinAngRad keeps a
        // distant ray from thinning below roughly one half-res pixel and breaking up into an
        // aliased dashed line — the exact artifact this rewrite exists to remove, just spatial
        // rather than along-ray. Beyond ~470 km the angular floor is what sets the width.
        // (kDebugRayRadiusM/kDebugRayMinAngRad/kDebugRayMaxLenM/kDebugRayAimMaxRad/kSkyBeamFadeM
        // moved to file scope 2026-08-10 — cullBeamsForTile must use the identical values or its
        // conservatism argument breaks.)
        // One evaluation now, not a 40-sample accumulation. Kept low deliberately: rays are
        // additive, so a site with dozens of satellites converging on it stacks them into a solid
        // wash unless each individual line is faint enough to still read through its neighbours.
        const float kDebugRayScale    = 0.05;
        const vec3  kDebugRayColor    = vec3(1.0, 0.95, 0.72) * 0.004; // off-white leaning yellow
        // "Beam gain" (pc.beamGain in sat_orbit.comp, folded into beams[bi].intensity =
        // groundIrradiance * beamGain there) previously only gated this ray on/off (see the
        // `intensity <= 0.0` rejects below) — the visible line itself was a flat kDebugRayColor *
        // kDebugRayScale regardless of the slider, which is why turning "Beam gain" up or down had
        // no visible effect on the ray players actually see. beamCloudLighting() and sat_sky.frag's
        // ground spot already scale off this same `intensity` field (kBeamCloudGlowScale=1e-6,
        // kBeamGroundScale=4e-8 respectively) — kDebugRayIntensityScale joins that precedent rather
        // than plumbing a separate pc.beamGain field through, and is picked so a Reflect Mirror at
        // the default beamGain (0.001711) and a representative ~0.7 sun-incidence angle reproduces
        // roughly the old fixed brightness.
        const float kDebugRayIntensityScale = 2.7e-4;
        // Atmospheric extinction (2026-08-10): a beam whose ground site sits far around the curve
        // of the Earth is seen along a long, near-tangent sightline, and had no extinction at all
        // before then. The line-of-sight column of atmosphere.glsl, as for the aurora above —
        // constant for this whole pixel, so hoisted out of the per-beam loop.
        float beamRayExtinction = pow(10.0, -0.4 * atmExtinctionMag(obsPos, dir, 0.0, cloud.extinctionCoeff));
        // Altitude fade (2026-08-06 experiment): invisible in vacuum, brightening as the beam
        // descends — the cheap stand-in for the deleted tube's scattering falloff, which really
        // was an air-density effect. Free here: the closest-approach solve below already yields
        // the exact point on the beam this pixel is looking at, so its altitude is the honest one
        // to fade on (no extra sampling, no second march). kDebugRayFadeTopM is the top of the
        // modelled atmosphere (R_ATMOS - R_EARTH); kDebugRayFadeBotM is where it reaches full
        // strength. kDebugRayFadeExp > 1 keeps the brightening weighted toward the low end
        // instead of ramping linearly across the whole 100 km.
        // With the volumetric shafts on (cv2.beam.x > 0) the lines are their companion, not the beam:
        // each beam's own streak (the shafts cluster converged beams into one light), faint ("Beam
        // lines", cv2.atmo.w), Rayleigh-blue like the shafts' air scattering, and confined low in the
        // air where there is air to scatter (1-20 km, not 8-50 km).
        bool  shaftsOn          = cv2.beam.x > 0.0;
        float kDebugRayFadeTopM = shaftsOn ? 20000.0 : 50000.0;
        float kDebugRayFadeBotM = shaftsOn ? 1000.0 : 8000.0;
        float lineGain          = shaftsOn ? cv2.atmo.w : 1.0;
        vec3  lineColor         = shaftsOn ? vec3(0.29, 0.55, 1.0) * (0.004 * 0.93 / 0.55) : kDebugRayColor;
        const float kDebugRayFadeExp  = 2.0;
        // Trace to the ACTUAL ground intersection instead of a fixed length (C12 follow-up #13 —
        // user report: rays "terminate once they get enough into the atmosphere" instead of
        // tracing back to the ground). A fixed 1000km length could stop well short of the
        // surface for a satellite aimed even slightly off nadir at the higher end of this
        // constellation's altitude range; raySphere() against R_EARTH finds the true distance
        // whatever the satellite's altitude or aim. kDebugRayMaxLenM is just a safety fallback
        // for the (should-be-rare) case where the ray points away from Earth entirely.
        // 2026-08-10: that raySphere is view-independent, so it now runs once per workgroup in
        // cullBeamsForTile and arrives here through sTileBeamRayLen.
        // Aim fade (2026-08-06 user request): mirrors slew toward a NEW target at a fixed rate
        // (kMirrorRotRateDegPerSec in SatelliteSim.h), but target ACQUISITION is a hard lock
        // switch (see the reflector-target-selection doc in CLAUDE.md) — the instant a satellite's
        // argmax/lock flips to a different site, its beam direction jumps immediately and only
        // then eases toward the new target over the slew. That jump-then-ease is what read as
        // "pop-in"/glitchy, not the slew itself. beams[bi].aimErrorRad (written in sat_orbit.comp,
        // radians still remaining in THIS frame's rate-limited step) is 0 once converged and large
        // right after a fresh acquisition, so it fades the WHOLE ray in as one unit rather than
        // per-point along it — the satellite's convergence state, not a property of where along
        // the beam this pixel happens to be looking. kDebugRayAimMaxRad is the error at which the
        // ray is fully dark; ~30 deg covers a full antipodal-ish target swap without over-fading
        // routine small slew corrections.
        // 2026-08-10: iterate the workgroup's CULLED list, not the whole buffer — see
        // cullBeamsForTile above for the design and the conservatism argument. sTileOverflow means
        // more beams crossed this tile than kTileBeamMax could hold, in which case we fall back to
        // scanning everything: pathological tiles get slow, never wrong. The per-beam view-
        // independent work (rangeFade, aimFade, the rayLen raySphere) has already been done once
        // per workgroup and arrives via shared memory, so the loop body below starts at the
        // geometry that genuinely varies per texel.
        bool tileOverflow = (sTileOverflow != 0u);
        int  beamIterCount = tileOverflow ? int(min(beamCount, BEAM_MAX_ACTIVE))
                                          : int(min(sTileBeamCount, kTileBeamMax));
        for (int k = 0; k < beamIterCount; ++k) {
            int   bi;
            float rayLen;
            float preFade; // rangeFade * aimFade
            if (tileOverflow) {
                // Full-scan fallback: recompute what the cull would have supplied.
                bi = k;
                if (beams[bi].intensity <= 0.0) continue;
                // 2026-08-07 user report: the sky beam ray popped in at full brightness the instant
                // a target crossed beamMaxRangeM (was a hard cutoff here, no fade). Widened cutoff
                // by kSkyBeamFadeM so the fade band itself still renders, with rangeFade ramping
                // the ray's contribution smoothly across it — same smoothstep shape as aimFade/fade
                // below, just keyed on range instead of slew/altitude. Kept in sync with
                // kGroundBeamFadeM in SatelliteSim.cpp/sat_sky.frag (same visual beam, same feel).
                float targetDistM = length(beams[bi].targetENU);
                if (targetDistM > cloud.beamMaxRangeM + kSkyBeamFadeM) continue;
                float rangeX = clamp((targetDistM - (cloud.beamMaxRangeM - kSkyBeamFadeM)) / kSkyBeamFadeM, 0.0, 1.0);
                float rangeFade = 1.0 - (rangeX * rangeX * (3.0 - 2.0 * rangeX));
                float aimFade = 1.0 - smoothstep(0.0, kDebugRayAimMaxRad, beams[bi].aimErrorRad);
                preFade = rangeFade * aimFade;
                vec2 groundHit = raySphere(obsPos + beams[bi].satENU, beams[bi].reflectDirENU, R_EARTH);
                rayLen = (groundHit.x > 0.0) ? min(groundHit.x, kDebugRayMaxLenM) : kDebugRayMaxLenM;
            } else {
                bi      = int(sTileBeamIdx[k]);
                rayLen  = sTileBeamRayLen[k];
                preFade = sTileBeamFade[k];
            }
            if (preFade <= 0.0) continue; // out of range, or still swinging onto a fresh target

            vec3 satWorldPos = obsPos + beams[bi].satENU;
            vec3 rayDir      = beams[bi].reflectDirENU;

            // View ray P(t) = obsPos + t*dir, beam segment Q(s) = satWorldPos + s*rayDir,
            // s in [0, rayLen]. w0 = obsPos - satWorldPos = -satENU, formed directly.
            vec3  w0  = -beams[bi].satENU;
            float b   = dot(dir, rayDir);
            float d   = dot(dir, w0);
            float e   = dot(rayDir, w0);
            float den = 1.0 - b * b; // both unit length, so this is the full ac - b^2
            // Near-parallel (den -> 0) has no unique solution; fall back to the point on the beam
            // closest to the observer, which is the right answer for a ray seen end-on.
            float s = (den > 1e-6) ? (e - b * d) / den : e;
            s = clamp(s, 0.0, rayLen);
            float t = s * b - d; // dot(Q(s) - obsPos, dir)
            if (t < 0.0) {
                // Nearest point is behind the camera. Re-clamp against t = 0 (the standard
                // segment-segment clamp step) so a beam that crosses behind the viewer still
                // draws the part of it that is in front.
                t = 0.0;
                s = clamp(e, 0.0, rayLen);
            }
            // Terrain occlusion (2026-08-06 fix): t is the distance along THIS pixel's view ray
            // to the nearest point on the beam, in the same units/frame as tScene — the exact
            // comparison every other layer in this shader uses to clamp to the shared depth
            // buffer. Without it a beam whose sampled point sits behind a ridge or mountain, as
            // seen from the camera (not from the beam's own path), drew straight through solid
            // ground — the one occlusion form this debug overlay never actually got despite the
            // "every beam is clamped to tScene" claim above, written when the whole composite
            // still funneled through the now-deleted tEnterCombined and never updated when this
            // ray-drawing block was added afterward.
            if (tScene < kNoSurfaceT && t > tScene) continue;

            // Kept in observer-relative terms — never (satWorldPos + rayDir*s) - (obsPos + t*dir).
            float perpDist = length(beams[bi].satENU + rayDir * s - dir * t);

            float radiusM = max(kDebugRayRadiusM, t * kDebugRayMinAngRad);
            if (perpDist > radiusM * 4.0) continue;

            // Altitude of the point on the beam this pixel is actually looking at. Same
            // length()-R_EARTH idiom every other altitude in this shader uses.
            float qAltM = length(satWorldPos + rayDir * s) - R_EARTH;
            float fade  = 1.0 - smoothstep(kDebugRayFadeBotM, kDebugRayFadeTopM, qAltM);
            if (fade <= 0.0) continue; // whole visible span is in vacuum — skip the exp
            fade = pow(fade, kDebugRayFadeExp);

            // Beam-physics occlusion (2026-08-09): does the beam's OWN sunlight actually reach
            // this point before being absorbed by cloud somewhere above it along its real path?
            // This ray previously had NO cloud awareness at all — only the cloudGate term below,
            // which answers a DIFFERENT question (is the CAMERA's own line of sight to this point
            // blocked by unrelated cloud). Both signals are needed, neither substitutes for the
            // other — see beam_self_march.comp's header and BEAM_CLOUD_PLAN.md finding 1 for why.
            // blockAltM/blockOpacity come from a real per-beam slant march along this exact
            // satellite-to-ground segment, so qAltM (already computed above, same segment) is
            // directly comparable — the directional glow block below reuses this same
            // beamPhysicsFade value directly, so both terms agree on where the beam goes dark.
            const float kRayCloudFeatherM = 500.0;
            float rayHCut = smoothstep(beams[bi].blockAltM - kRayCloudFeatherM, beams[bi].blockAltM, qAltM);
            float beamPhysicsFade = mix(1.0, rayHCut, beams[bi].blockOpacity);
            if (beamPhysicsFade <= 0.001) continue; // beam's own light already absorbed above this point

            // Cloud/cirrus occlusion: only dim the beam if the point it's actually looking at
            // (distance t along the view ray) is FARTHER than the cloud/cirrus shell this same
            // ray enters — tCloudEnter/tCirrusEnter are the real geometric entry distances
            // cloudMarchCS/cirrusMarchCS already solved for above, in the same units as t. A
            // first version of this used A_total (this ray's combined transmittance) unconditionally,
            // which occluded beams no matter how close they were to the camera — anything in
            // front of a distant cloud bank read as behind it, since A_total has no notion of
            // WHERE along the ray the opacity sits. Comparing against the entry distance is what
            // lets a beam segment nearer than the cloud render fully lit in front of it.
            //
            // 2026-08-09 fix: tCloudEnter/tCirrusEnter are GEOMETRIC — the distance where the ray
            // crosses the idealized shell sphere, true for every ray that passes through the
            // shell's altitude band at all, independent of whether there is any actual cloud
            // density along that specific line of sight. Gating on it unconditionally meant any
            // beam point below the shell's nominal ceiling got multiplied by A_total the instant
            // it crossed that fixed sphere — a hard wall at the shell's geometric top, not at the
            // real (noise-shaped, often lower/patchier) cloud surface. Symptom: beams appeared to
            // terminate at a fixed altitude "on top of" the cloud layer rather than fading out at
            // the actual cloud tops. Fixed by only engaging the gate where the ray's OWN march
            // found real, substantially-opaque cloud (mirrors tCloudOcclude's own ≥90%-opacity
            // threshold, computed the same way here for cirrus since cirrusMarchCS has no
            // equivalent out-param) — an empty/thin column along this sightline now leaves the
            // beam fully visible no matter how deep past the idealized shell sphere it sits.
            //
            // 2026-08-09 follow-up (in-app finding: still a hard edge, exactly at the shell's
            // geometric ceiling, with a visible gap down to where the cloud actually renders): the
            // fix above only changed WHETHER to gate, not WHERE the gate starts — that was still
            // tCloudOcclude, which cloudMarchCS sets to tEnter, the SAME idealized shell-boundary
            // sphere as before. For any ordinarily-cloudy sky (the normal case, not the edge case
            // the previous fix targeted) the whole column easily reads ≥90% opaque, so the gate
            // kept firing right at the shell's geometric top regardless. tCloudMeanT is the
            // transmittance-weighted mean distance to where this ray's density actually
            // accumulated (cloudMarchCS already derived it for its own atmospheric-extinction term
            // as cloudMeanT) — anchored to the real, noise-shaped cloud surface instead of the
            // abstract sphere, matching how the 2D fallback cloud layer (which samples real
            // coverage directly) already occludes beams correctly.
            float cirrusOccludeT = (dot(A_cirrus, vec3(1.0 / 3.0)) < 0.1) ? tCirrusEnter : kNoSurfaceT;
            float cloudOccludeT  = (tCloudOcclude >= 0.0) ? tCloudMeanT : kNoSurfaceT;
            float cloudEntryT = min(cloudOccludeT, cirrusOccludeT);
            // Feathered, not a hard t<=cloudEntryT step: the step made a beam crossing into cloud
            // read as a sharp bright/dark seam right at the crossing point (in-app finding — the
            // WHERE was already fixed above via tCloudMeanT, but the transition itself was still a
            // wall). Same kCloudFeatherM/kRayCloudFeatherM convention (500m) used elsewhere in this
            // loop. cloudEntryT == kNoSurfaceT degrades to the same always-1.0 result as before.
            const float kCloudGateFeatherM = 500.0;
            float gateBlend = smoothstep(cloudEntryT - kCloudGateFeatherM, cloudEntryT + kCloudGateFeatherM, t);
            float cloudGate = mix(1.0, dot(A_total, vec3(1.0 / 3.0)), gateBlend);
            if (cloudGate <= 0.001) continue; // fully opaque along this ray — nothing to draw

            float proximity = exp(-(perpDist * perpDist) / (2.0 * radiusM * radiusM));
            float intensityScale = beams[bi].intensity * kDebugRayIntensityScale;
            // preFade is aimFade * rangeFade, both computed once per workgroup in cullBeamsForTile
            // (2026-08-10) — same product, same order of multiplication as before.
            vec3  lineAdd = lineColor * (lineGain * kDebugRayScale * intensityScale * proximity * fade
                                         * beamPhysicsFade * preFade * beamRayExtinction);
            B_total += lineAdd * cloudGate;
            gBA += lineAdd * (gateBlend * dot(gAA, vec3(1.0 / 3.0)));
        }
    }

    // tEnterCombined is GONE. It fused cirrus + cloud + beam + aurora entry distances into one
    // scalar that sat_sky.frag compared against its own terrain distance, suppressing the WHOLE
    // composite when terrain won — so the four could never be occluded independently (a beam
    // behind a hill still drew if some unrelated nearer cloud won the min()), partial truncation
    // was impossible, and the half-res scalar was being compared against a full-res silhouette.
    //
    // It was also a latent correctness bug in its own right: this is an RGBA16F target, whose
    // alpha saturates at 65504, and near-horizon cloud entry distances routinely exceed 100 km.
    // Those overflowed to +inf, making `tSurface < tEnterCombined` unconditionally true and
    // suppressing the entire composite on any ray that also hit the sea-level sphere.
    //
    // Every layer above now clamps to tScene at march time instead, which is strictly more
    // correct — and it freed this alpha channel for the per-pixel cloud shadow below.
    //
    // Only ground pixels pay for it: sky rays have tScene == kNoSurfaceT and skip out entirely.
    // The shadow is evaluated at the terrain hit point the depth pass already found, so this
    // needs no new bindings, no new pass, and no spatial grid — the whole of cloud_shadow.comp
    // and its texel-snapping subsystem is deleted in exchange.
    //
    // DISTANCE GATE — load-bearing for performance, not just a quality knob.
    //
    // The gate below is "does this ray hit ground, and is that ground near enough for its shadow
    // to be resolvable". Without the distance half, this ran on every ground-hitting pixel: from
    // orbit that is essentially the WHOLE screen, ~485k half-res pixels each doing a 12-step
    // sunward march, for shadow detail far below one pixel at that range. Near the surface the
    // same thing happened to every horizon-ward ray hitting ocean hundreds of km out.
    //
    // The 128x128 grid this replaced was accidentally immune: being observer-centred with a fixed
    // ~80 km extent, it covered a vanishing patch of the visible ground from altitude and cost
    // almost nothing there. Removing the grid removed that accidental gating along with it.
    //
    // Fading rather than hard-cutting matters — a hard edge is exactly the artifact the old grid
    // had. Cost scales with how much of the screen is BOTH ground and within range, which from
    // orbit is now approximately none.
    float terrainSunT = 1.0;
    if (tScene < kNoSurfaceT && (cloud.dbgDisableMask & 256u) == 0u) {
        float shadowFade = 1.0 - smoothstep(cloud.cloudShadowRangeM * 0.6, cloud.cloudShadowRangeM, tScene);
        // Ground the clouds hide needs no shadow (2026-10-13): where this texel and its eight neighbours (the reach
        // of sat_sky.frag's shadow tent and its bilinear read) are all behind cloud that passes under 1%, the
        // 32-72 field samples below bought nothing. Flying over a cloud field that is most of the ground in view,
        // and the march runs for EVERY half-res pixel every frame (the view march is one in four): 2-2.8 ms of
        // the cloud bucket at 1920x1009 before the gate.
        if (shadowFade > 0.001 && !cv2Off && rc.a < 0.01) {
            ivec2 rsz = textureSize(cv2ResolvedTex, 0);
            float tMaxN = 0.0;
            [[dont_unroll]] for (int k = 0; k < 9; ++k) {
                if (k == 4) continue;
                ivec2 qn = coord + ivec2(k % 3 - 1, k / 3 - 1);
                tMaxN = max(tMaxN, fullRes ? textureLod(cv2ResolvedTex, (vec2(qn) + 0.5) / vec2(size), 0.0).a
                                           : texelFetch(cv2ResolvedTex, clamp(qn, ivec2(0), rsz - 1), 0).a);
            }
            if (tMaxN < 0.01) shadowFade = 0.0;
        }
        if (shadowFade > 0.001) {
            vec3  hitENU  = obsPos + tScene * dir;
            // The Sun transmittance volume at the ground point (S3: the same shadow the clouds and the air take; it
            // replaced a 32-72-sample march through the field from every ground pixel, cloudGroundShadowV2).
            float gs = (cv2.stvH.z > 0.5) ? cv2StvT(tScene * dir, length(hitENU) - R_EARTH) : 1.0;
            terrainSunT = mix(1.0, gs, shadowFade);
        }
    }

    // Alpha: a signed distance in KILOMETRES (include/cloud_occlusion.glsl) — this is RGBA16F, and
    // in metres every cloud past 65.5 km was +inf.
    // Opaque: the later of the half-opacity point and the mean distance (review 10). Along a grazing path
    // through a cirrus veil the half point landed IN the veil (~20 km) in front of a cumulus at ~55 km, and the
    // sky pass split the air there: a dark speck in every such texel. Every point source is 100+ km away, so
    // their occlusion is unchanged.
    float occKm = (tCloudOcclude >= 0.0) ? ((tCloudMeanT < kNoSurfaceT && tCloudMeanT > 0.0) ? tCloudMeanT : tCloudOcclude) * 0.001
                : -((tCloudMeanT < kNoSurfaceT) ? tCloudMeanT * 0.001 : (tEmitNear < kNoSurfaceT ? tEmitNear * 0.001 : 60000.0));
    // A texel whose distance is the emissive / plume distance (no cloud of its own) carries a FLAG: the lowest
    // mantissa bit of the half float (include/cloud_occlusion.glsl cloudAlphaIsEmit; 1/1024 of the distance). Its
    // opacity is the plume's, which cloud_march already lit by the engine lights: the engine-light pass
    // (lightning.frag mode 2) took it for a cloud at the plume's distance and lit it a second time — the bright
    // ball round a burning stage seen from 300 m, and darker half-res blocks wherever a far cloud's texel (lit
    // only by its own, far distance) sat inside that glow (2026-10-20).
    occKm = cloudAlphaFlag(occKm, tCloudMeanT >= kNoSurfaceT && tCloudOcclude < 0.0 && tEmitNear < kNoSurfaceT);
    imageStore(targetA, coord, vec4(B_total, occKm));
    imageStore(targetB, coord, vec4(A_total, terrainSunT));
    if (fullRes) {
        imageStore(targetDB, coord, vec4(gBA, gBB));
        imageStore(targetDA, coord, vec4(gAA, tEmitNear < kNoSurfaceT ? tEmitNear * 0.001 : -1.0));
    }
}
