#version 450

// ── Half-resolution cloud/cirrus compute march ────────────────────────────────
// Moved out of sat_sky.frag's per-pixel fragment shader (where cloudMarch/cirrusMarch used to
// live) into its own compute dispatch, run once per frame in recordCompute() at half the swap
// extent in each dimension (1/4 the pixels). sat_sky.frag now just samples the two output
// images below and composites the precomputed result — see TERRAIN_PLAN.md session 23 log and
// the "velvet-rolling-squirrel" plan for the full design rationale (why two RGBA16F targets,
// the combined-attenuation algebra, and the accepted terrain-occlusion approximation).
//
// This shader has NO terrain data (no earthElevTex/earthSpecTex, no terrain march) — it always
// marches the cloud shell's full potential extent. sat_sky.frag does a post-hoc terrain-
// occlusion correction using its own accurate tSurface against the tCloudOcclude distance
// stored here (Target A alpha). See the "Known limitation" note in the plan: this is exact for
// "terrain fully blocks the cloud" but does not replicate a mid-shell partial truncation.
//
// Everything below down to `cirrusMarchCS`/`cloudMarchCS` is a DUPLICATE of code that also still
// exists in sat_sky.frag (this codebase has no #include mechanism — every shader file is self-
// contained by convention). Keep both copies in sync if the shared math changes. Verified via
// grep before duplicating: every one of these helpers has call sites in sat_sky.frag OTHER than
// cloudMarch/cirrusMarch (cloudShadowFactor, the main atmosphere loop, or airglow), so none of
// them could simply be deleted from sat_sky.frag.
layout(local_size_x = 16, local_size_y = 16) in;

// ── Push constants (132 bytes, matches C++ CloudMarchPC) ──────────────────────
layout(push_constant) uniform PC {
    mat4  skyView;     // ENU -> camera space (rotation, no translation) — same as SatDrawPC
    float fovYRad;
    float aspect;
    float waveTime;    // wall-clock seconds — used by cloudWarpOffset/cirrusWindAngleAt/cirrusDomainWarp
    float obsEffH;      // observer altitude above local terrain (m) — CPU-computed, see recordCompute
    vec4  sunDirENU;
    vec4  moonDirENU;
    vec4  obsECEFDir;   // xyz = observer ECEF unit vector
    uint  debugDisableMask; // perf knockout toggles — mirrors SatDrawPC's; bit 32 (aurora curtain
                            // march) and bit 64 (cloud self-shadow light cone) are the ones
                            // meaningful here — both live only in this shader now
} pc;

layout(set = 0, binding = 0) uniform sampler2D earthCloudsTex;
layout(set = 0, binding = 1) uniform sampler3D cloudNoiseTex;
layout(set = 0, binding = 2) uniform sampler2D earthNightTex;
layout(set = 0, binding = 3) uniform sampler2D noiseTex;

// Same CloudParams UBO layout as sat_sky.frag binding 9 — duplicated struct, same underlying
// VkBuffer bound into this separate descriptor set.
struct CloudLayer {
    float shellAltM;
    float driftMult;
    float alphaMax;
    float mipLod;
    float coverageMult;
    float densityMult;
    float enabled;
    float pad;
};
layout(set = 0, binding = 4) uniform CloudParams {
    float coverage;
    float density;
    float driftRate;
    float sunGain;
    float ambientGain;
    float hgG;
    float marchSteps;
    float lightSteps;
    float cloudPhase;
    float extinctionCoeff; // unused here (atmospheric extinction is sat_sky.frag-only) — was pad0,
                           // now genuinely occupied there; kept named/positioned for layout parity
    float cirrusWindAngle;
    float cirrusStretch;
    float airglowGain;
    float airglowGreenGain;
    float airglowRedGain;
    float airglowSodiumGain;
    float shadowMaxDistM;
    float maxRenderDistM;
    float viewSamplesMin;     // unused here (N_VIEW belongs to the main atmosphere loop in
                              // sat_sky.frag) — kept for layout parity, was pad2
    float lightSamples;       // unused here — was pad3
    float oceanSeaOctaves;    // unused here (ocean shading is in sat_sky.frag, not this compute
                              // shader) — kept for layout parity
    float oceanDetailOctaves; // unused here — layout parity
    float oceanReflSamples;   // unused here — layout parity
    float viewSamplesMax;     // unused here — layout parity, was pad4
    float sunGainZenith;      // USED here (was pad3) — sun-gain multiplier applied when the sun is
                               // near zenith, blended against `sunGain` (now effectively the
                               // near-horizon/sunset value) by sun elevation. Was a single flat
                               // gain for all elevations, which meant a value tuned to look good
                               // at sunset (high) overexposed clouds at midday, or vice versa.
    float moonGain;           // shared moonlight brightness master — replaces this file's old
                              // hardcoded 0.015 moonContrib scalar; sat_sky.frag's terrain
                              // moonlight term reads the same field
    float pad1;               // reserved
    float pad2;               // reserved
    vec4 mwBasisRow0;         // unused here (Milky Way skybox is sat_sky.frag-only) — layout parity
    vec4 mwBasisRow1;         // unused here — layout parity
    vec4 mwBasisRow2;         // unused here — layout parity
    CloudLayer layers[4];
    float stormStrength;      // USED here — drives auroraOvalMaskLocal's oval expansion (mirrors
                               // sat_sky.frag's storm-driven widening/equatorward shift)
    float auroraGain;         // unused here (sky curtain brightness is sat_sky.frag-only) — layout parity
    float auroraCloudGain;    // USED here — master gain for the local per-sample cloud upwelling
    float auroraGroundGain;   // unused here (terrain/ocean lighting is sat_sky.frag-only) — layout parity
    float auroraCoverageFreq;      // USED here — coverage patch size (per-degree colat frequency)
    float auroraCoverageAzFreq;    // USED here — coverage azimuthal wobble frequency
    float auroraCoverageDriftRate; // USED here — coverage evolution speed (wall-clock rad/s)
    float auroraShimmerRate;       // unused here (curtain fold noise is sat_sky.frag-only) — layout parity
    // Struct grew 320->336 (session 30, see GpuCloudParams in SatelliteSim.h for why this was
    // appended here instead of reusing pad1/pad2 above).
    float cloudNightAmbientGain; // USED here — gain on kNightSkyAmbientColor, the decoupled night
                                  // floor added to skyAmbient in cloudMarchCS
    float cloudBaseVariance;  // USED here (was pad4) — noise-driven cloud base height undulation,
                               // in hNorm units (0 = old perfectly flat base); see cloudMarchCS
    float cloudErosionEdge;   // USED here (was pad5) — cloudDensity() erosion strength at the
                               // silhouette edge (base near 0)
    float cloudErosionCore;   // USED here (was pad6) — cloudDensity() erosion strength at the
                               // dense core (base near 1); kept lower than cloudErosionEdge so
                               // cores stay comparatively solid while edges fray
} cloud;

// Target A: rgb = combined additive radiance (B_total), a = tCloudOcclude (m, -1 = none)
layout(set = 0, binding = 5, rgba16f) uniform writeonly image2D targetA;
// Target B: rgb = combined multiplicative attenuation (A_total), a = cloudBlock (sun-dimming scalar)
layout(set = 0, binding = 6, rgba16f) uniform writeonly image2D targetB;

// Perf (this session): the aurora sky curtain march moved here from sat_sky.frag, alongside
// clouds/cirrus, so it runs at this pass's half resolution instead of full-res — one of the two
// remaining big levers identified from "why is aurora so much more expensive than clouds" (the
// other, baking its noise, is already done — see aurora_noise.comp). Needs its own read of
// lightDomeBuf (light-pollution suppression, same buffer sat_flare.comp/sat_sky.frag consume) and
// auroraNoiseTex (binding 16 in sat_sky.frag's descriptor set, binding 8 here — separate
// descriptor sets, same underlying resources).
layout(std430, set = 0, binding = 7) readonly buffer LightDomeBuf {
    float lightDome[16];
};
layout(set = 0, binding = 8) uniform sampler3D auroraNoiseTex;
// Baked cloud/cirrus domain-warp field (see cloud_warp_noise.comp) — replaces the 3 live
// warpPerlin3 evaluations cloudWarpOffset used to do per call. R/G/B = the three offset warp
// channels, [0,1]-normalized (decode via *2-1 at the call site).
layout(set = 0, binding = 9) uniform sampler3D cloudWarpNoiseTex;

const float PI = 3.14159265359;
const float R_EARTH = 6371000.0;
const float R_ATMOS = 6471000.0;

const float kCloudHorizFreq = 480.0;
const float kCloudColFreq   = 80.0;

const float kWarpFreq       = 6.0;
const float kWarpStrength   = 32.0;
const float kWarpDriftRate  = 0.08;
const float kWarpEvolveRate = 0.00002;

const float kCityUpwellStrength = 0.004;
const float kNightFloor    = 0.002;
const float kCityCompressK = 0.08;

// Aurora ground-glow (C16 follow-up, redo — session 28 follow-up #5). Duplicates sat_sky.frag's
// kGeomagPoleECEF/kAuroraOvalColatDeg/kAuroraOvalWidthDeg and a stripped-down oval mask (no
// ripple warp, no fold noise — this evaluates once per IN-CLOUD march sample, the hottest loop in
// the renderer, so kept as cheap as possible) rather than sharing code with the full curtain
// primitive there. Evaluated LOCALLY using each sample's own dirECEF (already computed in the
// march loop below), NOT a CPU-computed observer-position scalar — the first version lit the
// whole visible cloud deck uniformly whenever the OBSERVER was under the oval and went dark
// the instant they left it, regardless of what was actually under the curtain.
const vec3  kAuroraGroundColor  = vec3(0.15, 1.0, 0.35);
const vec3  kGeomagPoleECEF     = vec3(0.0481, -0.1543, 0.9868);
const float kAuroraOvalColatDeg = 20.0;
const float kAuroraOvalWidthDeg = 6.0;
// Large-scale coverage gate — mirrors sat_sky.frag's auroraCoverage (see that file's comment for
// the full "why patches, not a solid ring" reasoning, and why it varies primarily with COLATITUDE
// rather than azimuth — a colat-constant/az-varying field's threshold crossings fall on
// constant-azimuth contours, i.e. meridians pointing straight at the pole, which is backwards from
// the intended "tracks parallel to latitude lines" look). Kept here despite the perf-sensitive
// loop because dropping it would make cloud-underside lighting look like a uniform ring while the
// sky curtain right above it is visibly patchy — worse than the extra warpPerlin3 call costs.
// Frequency/az-frequency/drift-rate are now user-tunable (cloud.auroraCoverageFreq/AzFreq/
// DriftRate, settings window "Coverage freq"/"Coverage az freq"/"Coverage drift") — only the edge
// softness stays a fixed constant here.
const float kAuroraCoverageSoftness  = 0.45;
// auroraOvalMaskLocal itself is defined further down, right after warpPerlin3 (which it calls) —
// GLSL has no forward declarations, and warpPerlin3 lives below the noise-warp block.

const float kCloud3DFadeStart = 800000.0;
const float kCloud3DFadeEnd   = 3000000.0;

const float kMarchStepsAltStart = 2000.0;
const float kMarchStepsAltEnd   = 200000.0;
const float kMarchStepsFloor    = 12.0;

// Self-shadow light-march cone grazing-angle attenuation (see cloudMarchCS): damps sunOptDepth
// directly at low sun elevation rather than extending the cone's reach (which undersamples badly
// at this codebase's low default light-step counts — see the comment at the call site).
// kGrazeShadowFloor: sunOptDepth multiplier right at the horizon (sun elevation sin == 0).
// kGrazeShadowFullSin: sin(elevation) above which no attenuation is applied — full cone-computed
// shadow strength. sin(0.3) is roughly a 17.5 degree solar elevation.
const float kGrazeShadowFloor   = 0.35;
const float kGrazeShadowFullSin = 0.3;

// Night-sky ambient floor for cloud tops: skyAmbientBase (the analytic single-scattering zenith
// Rayleigh/Mie integral) decays to ~0 well before real civil twilight actually goes dark, because
// it only counts direct sunlight reaching the zenith column — it has no multiple-scattering term
// to carry any glow past that point. This constant is a decoupled, non-decaying "residual sky
// glow" (starlight + multiple-scattered air), scaled by its own cloud.cloudNightAmbientGain slider
// (deliberately NOT cloud.ambientGain, which also drives city-light upwelling — see nightFloorAmbient
// below) so it stays controllable after skyAmbientBase itself has collapsed near zero post-sunset.
const vec3  kNightSkyAmbientColor = vec3(0.015, 0.02, 0.035);

const vec3  BETA_R = vec3(5.8e-6, 13.5e-6, 33.1e-6);
const float H_R    = 7994.0;
const float BETA_M = 2.1e-5;
const float H_M    = 12.0;
const float G_MIE  = 0.26;

const float SUN_INTENSITY = 1.0;

const int N_LIGHT = 12;

const float kCirrusWindWarpFreq  = 1.5;
const float kCirrusWindWarpAmp   = 1.2;
const float kCirrusWindDriftRate = 0.05;

const float kCirrusThicknessM = 700.0;
const float kCirrusFreqScale  = 0.4;

// ── Duplicated shared helpers (also present in sat_sky.frag — keep in sync) ───

float phaseM(float cosA) {
    float g2  = G_MIE * G_MIE;
    float den = pow(max(1e-4, 1.0 + g2 - 2.0 * G_MIE * cosA), 1.5);
    return 1.5 * ((1.0 - g2) / (2.0 + g2)) * (1.0 + cosA * cosA) / den;
}

float phaseCloud(float cosA) {
    const float gF = 0.3, gB = -0.1;
    float g2f = gF * gF, g2b = gB * gB;
    float fwd = 1.5 * ((1.0 - g2f) / (2.0 + g2f)) * (1.0 + cosA * cosA)
                / pow(max(1e-4, 1.0 + g2f - 2.0 * gF * cosA), 1.5);
    float bwd = 1.5 * ((1.0 - g2b) / (2.0 + g2b)) * (1.0 + cosA * cosA)
                / pow(max(1e-4, 1.0 + g2b - 2.0 * gB * cosA), 1.5);
    return mix(fwd, bwd, 0.3);
}

// c computed as (|ro|-r)*(|ro|+r), not dot(ro,ro)-r*r — see sat_sky.frag's raySphere comment
// for why (catastrophic cancellation at R_EARTH scale). Keep both copies in sync.
vec2 raySphere(vec3 ro, vec3 rd, float r) {
    float b     = dot(ro, rd);
    float roLen = length(ro);
    float c     = (roLen - r) * (roLen + r);
    float d     = b * b - c;
    if (d < 0.0) return vec2(-1.0);
    float sq = sqrt(d);
    return vec2(-b - sq, -b + sq);
}

vec2 optDepth(vec3 p, vec3 d, float segTotal) {
    float sLen = segTotal / float(N_LIGHT);
    float odR = 0.0, odM = 0.0;
    for (int i = 0; i < N_LIGHT; ++i) {
        float h = max(0.0, length(p + d * (float(i) + 0.5) * sLen) - R_EARTH);
        odR += exp(-h / H_R);
        odM += exp(-h / H_M);
    }
    return vec2(odR, odM) * sLen;
}

vec3 rotateZ(vec3 v, float theta) {
    float c = cos(theta), s = sin(theta);
    return vec3(v.x * c - v.y * s, v.x * s + v.y * c, v.z);
}

float remap(float v, float lo, float hi, float newLo, float newHi) {
    return newLo + clamp((v - lo) / (hi - lo), 0.0, 1.0) * (newHi - newLo);
}

uvec3 warpHashU(uvec3 v) {
    v = v * 1664525u + 1013904223u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    v ^= v >> 16u;
    v.x += v.y * v.z; v.y += v.z * v.x; v.z += v.x * v.y;
    return v;
}
vec3 warpGradHash(ivec3 c) {
    return normalize(-1.0 + 2.0 * (vec3(warpHashU(uvec3(c))) * (1.0 / 4294967296.0)));
}
float warpPerlin3(vec3 p) {
    ivec3 i = ivec3(floor(p));
    vec3  f = fract(p);
    vec3  u = f * f * (3.0 - 2.0 * f);
    float v000 = dot(warpGradHash(i),                   f              );
    float v100 = dot(warpGradHash(i + ivec3(1,0,0)), f - vec3(1,0,0));
    float v010 = dot(warpGradHash(i + ivec3(0,1,0)), f - vec3(0,1,0));
    float v110 = dot(warpGradHash(i + ivec3(1,1,0)), f - vec3(1,1,0));
    float v001 = dot(warpGradHash(i + ivec3(0,0,1)), f - vec3(0,0,1));
    float v101 = dot(warpGradHash(i + ivec3(1,0,1)), f - vec3(1,0,1));
    float v011 = dot(warpGradHash(i + ivec3(0,1,1)), f - vec3(0,1,1));
    float v111 = dot(warpGradHash(i + ivec3(1,1,1)), f - vec3(1,1,1));
    return mix(mix(mix(v000, v100, u.x), mix(v010, v110, u.x), u.y),
               mix(mix(v001, v101, u.x), mix(v011, v111, u.x), u.y), u.z);
}

float auroraOvalMaskLocal(vec3 posDirECEF, float t, float storm) {
    vec3  poleDir   = (dot(posDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
    float colatDeg  = degrees(acos(clamp(dot(posDirECEF, poleDir), -1.0, 1.0)));
    float centerDeg = kAuroraOvalColatDeg + storm * 8.0;
    float widthDeg  = kAuroraOvalWidthDeg * (1.0 + storm * 1.5);
    float band = clamp(1.0 - abs(colatDeg - centerDeg) / widthDeg, 0.0, 1.0);
    if (band <= 0.001) return 0.0;

    vec3  ref      = abs(poleDir.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    vec3  tangentT = normalize(cross(poleDir, ref));
    vec3  radialT  = normalize(cross(tangentT, poleDir));
    vec3  localDir = posDirECEF - poleDir * dot(posDirECEF, poleDir);
    float az       = atan(dot(localDir, tangentT), dot(localDir, radialT));

    // Time is mixed into the azimuthal embedding (x,y), NOT the colatitude axis (z) — see
    // sat_sky.frag's auroraCoverage for why: adding t to colat directly made the pattern visibly
    // slide toward/away from the pole over time instead of evolving in place.
    vec2  azWarp = vec2(cos(az), sin(az)) * cloud.auroraCoverageAzFreq + t * cloud.auroraCoverageDriftRate;
    float n = warpPerlin3(vec3(azWarp, colatDeg * cloud.auroraCoverageFreq));
    float threshold = mix(0.2, -0.6, clamp(storm, 0.0, 1.0));
    float coverage  = smoothstep(threshold, threshold + kAuroraCoverageSoftness, n);
    return band * coverage;
}

// ── Aurora sky curtain (moved here from sat_sky.frag this session — perf) ──────────────────────
// Full-featured versions (ripple warp, smoothstep fade zone) of the oval mask, distinct from
// auroraOvalMaskLocal above (that stripped-down version stays sat_sky.frag-only-style, used just
// for cloud-top upwelling here). These four are a near-verbatim duplicate of sat_sky.frag's own
// auroraFrame/auroraCoverage/auroraOvalMask/auroraCurtainNoise — keep both copies in sync, same
// convention this file already documents at the top for cloudMarch/cirrusMarch's shared helpers.
// sat_sky.frag still needs its own copies too: auroraGlowAt (terrain/ocean ambient lighting) and
// the ocean sky-reflection's aurora sample both stay full-resolution and keep calling them there.
const float kAuroraShellInnerM  = 95000.0;
const float kAuroraShellOuterM  = 300000.0;
const float kAuroraRingWarpFreq = 3.0;
const float kAuroraOvalWarpDeg  = 4.0;
const float kAuroraOvalDriftRate = 0.003;
const float kAuroraTangentFreq  = 40.0;
const float kAuroraRadialFreq   = 70.0;
const float kAuroraAltFreq      = 0.000006;
const float kAuroraScale        = 0.000001;
const vec3  kAuroraTopColor     = vec3(0.65, 0.15, 0.45);
// kAuroraGroundColor (already declared above) is numerically identical to sat_sky.frag's
// kAuroraBaseColor — reused directly below rather than redeclaring under a second name.
const vec3  kAirglowGreenColor  = vec3(0.35, 1.0, 0.25);
const vec3  kAirglowSodiumColor = vec3(1.0, 0.65, 0.15);
const vec3  kAirglowRedColor    = vec3(1.0, 0.12, 0.05);

void auroraFrame(vec3 dirECEF, vec3 poleDir, out float colat, out float az,
                  out vec3 radialT, out vec3 tangentT) {
    colat = acos(clamp(dot(dirECEF, poleDir), -1.0, 1.0));
    vec3 ref = abs(poleDir.z) < 0.99 ? vec3(0.0, 0.0, 1.0) : vec3(1.0, 0.0, 0.0);
    tangentT = normalize(cross(poleDir, ref));
    radialT  = normalize(cross(tangentT, poleDir));
    vec3 localDir = dirECEF - poleDir * dot(dirECEF, poleDir);
    az = atan(dot(localDir, tangentT), dot(localDir, radialT));
}

float auroraCoverage(float colat, float az, float t, float storm) {
    vec2  azWarp = vec2(cos(az), sin(az)) * cloud.auroraCoverageAzFreq + t * cloud.auroraCoverageDriftRate;
    float n = warpPerlin3(vec3(azWarp, degrees(colat) * cloud.auroraCoverageFreq));
    float threshold = mix(0.2, -0.6, clamp(storm, 0.0, 1.0));
    return smoothstep(threshold, threshold + kAuroraCoverageSoftness, n);
}

float auroraOvalMask(float colat, float az, float t, float storm) {
    // Same conservative 70deg pre-filter as sat_sky.frag's copy — see that file for the full
    // worst-case-reach derivation.
    if (degrees(colat) > 70.0)
        return 0.0;
    vec2  ringP  = vec2(cos(az), sin(az)) * kAuroraRingWarpFreq;
    float ripple = warpPerlin3(vec3(ringP, t * kAuroraOvalDriftRate)) * kAuroraOvalWarpDeg;
    float centerDeg = kAuroraOvalColatDeg + ripple + storm * 8.0;
    float widthDeg  = kAuroraOvalWidthDeg * (1.0 + storm * 1.5);
    float distDeg = abs(degrees(colat) - centerDeg);
    float band = smoothstep(widthDeg * 2.0, widthDeg * 0.5, distDeg);
    return band * auroraCoverage(colat, az, t, storm);
}

// "base" is a texture read against auroraNoiseTex's R channel (baked by aurora_noise.comp)
// instead of a live warpPerlin3 call — see that file's header and sat_sky.frag's own copy of this
// function for the full derivation of the UVW mapping and the storm/frequency approximation.
float auroraCurtainNoise(float colat, float az, float altM, float t, float storm) {
    float shimmerPhase = warpPerlin3(vec3(colat * kAuroraRadialFreq * 0.3,
                                           altM * kAuroraAltFreq * 0.3,
                                           t * cloud.auroraShimmerRate)) * 2.5;
    vec3 p = vec3(az * kAuroraTangentFreq * (1.0 + storm * 0.8) + shimmerPhase,
                  altM * kAuroraAltFreq,
                  colat * kAuroraRadialFreq);
    const float kAuroraCurtainPeriod = kAuroraTangentFreq * 2.0 * PI;
    float texU = fract(p.x / kAuroraCurtainPeriod);
    float texV = clamp((p.y - 0.24) / (2.46 - 0.24), 0.0, 1.0);
    float texW = clamp(p.z / 91.6, 0.0, 1.0);
    float base = texture(auroraNoiseTex, vec3(texU, texV, texW)).r * 2.0 - 1.0;
    return remap(base, -0.3, 0.9, 0.0, 1.0);
}

// Per-sample curtain color/intensity — near-verbatim port of sat_sky.frag's auroraSampleAt, minus
// the (unused here) enuX/enuY/enuZ basis-rebuild since the caller already works in ECEF-relative
// terms consistent with the rest of this file.
vec3 auroraCurtainSample(vec3 rp, vec3 enuX, vec3 enuY, vec3 enuZ, vec3 sunDirECEF, float t, float storm) {
    vec3 pDirECEF = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
    float dayness = clamp((dot(pDirECEF, sunDirECEF) + 0.15) / 0.3, 0.0, 1.0);
    float night   = 1.0 - dayness;
    if (night <= 0.001) return vec3(0.0);
    vec3 poleDir  = (dot(pDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
    float colat, az; vec3 radialT, tangentT;
    auroraFrame(pDirECEF, poleDir, colat, az, radialT, tangentT);
    float oval = auroraOvalMask(colat, az, t, storm);
    if (oval <= 0.001) return vec3(0.0);
    float altM = length(rp) - R_EARTH;
    const float kAuroraInnerFalloffM = 7500.0;
    const float kAuroraOuterFalloffM = 15000.0;
    float innerVert = 1.0 / (1.0 + exp(-(altM - kAuroraShellInnerM) / kAuroraInnerFalloffM));
    float outerVert = 1.0 / (1.0 + exp((altM - kAuroraShellOuterM) / kAuroraOuterFalloffM));
    float vert = innerVert * outerVert;
    if (vert <= 0.001) return vec3(0.0);

    // Column window colA/colB — same baked-texture read as sat_sky.frag's copy (G/B channels).
    float colTexU = fract(az / (2.0 * PI));
    float colTexW = clamp(colat / radians(75.0), 0.0, 1.0);
    vec2  colSample = texture(auroraNoiseTex, vec3(colTexU, 0.5, colTexW)).gb;
    float colA = colSample.x;
    float colB = colSample.y;
    float colLoFrac = clamp(min(colA, colB) - 0.08, 0.0, 1.0);
    float colHiFrac = clamp(max(colA, colB) + 0.08, 0.0, 1.0);
    float colLoM = mix(kAuroraShellInnerM, kAuroraShellOuterM, colLoFrac);
    float colHiM = mix(kAuroraShellInnerM, kAuroraShellOuterM, colHiFrac);
    const float kAuroraColumnFalloffM = 12000.0;
    float columnWindow = (1.0 / (1.0 + exp(-(altM - colLoM) / kAuroraColumnFalloffM)))
                        * (1.0 / (1.0 + exp((altM - colHiM) / kAuroraColumnFalloffM)));
    if (columnWindow <= 0.001) return vec3(0.0);

    float fold = mix(1.0, auroraCurtainNoise(colat, az, altM, t, storm), vert);
    vec3  col  = mix(kAuroraGroundColor, kAuroraTopColor,
                      clamp(remap(altM, kAuroraShellInnerM, kAuroraShellOuterM, 0.0, 1.0), 0.0, 1.0));
    vec3 innerAirglowCol = mix(kAirglowSodiumColor, kAirglowGreenColor, 0.5);
    col = mix(innerAirglowCol, col, innerVert);
    col = mix(kAirglowRedColor, col, outerVert);
    return col * (oval * fold * vert * columnWindow * night);
}

// Full sky curtain march: whole-ray bounding pre-check + adaptive-step march + light-pollution/
// moonlight suppression + atmospheric extinction. Returns the raw contribution BEFORE cloud
// suppression — main() applies that using the ALREADY-COMPUTED local cloud transmittance (A_total)
// from this same pixel/frame, more accurate than sat_sky.frag's old "early" texture pre-sample
// (which existed only because sat_sky.frag runs at full-res and needed a cheap same-frame proxy;
// this compute shader already has the real value on hand).
vec3 auroraMarchCS(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                    vec3 sunDir, vec3 sunDirECEF, float obsEffH, vec4 moonDirENU) {
    const float kAuroraMarchInnerM = kAuroraShellInnerM - 55000.0;
    const float kAuroraMarchOuterM = kAuroraShellOuterM + 110000.0;
    vec2 tAuroraFar = raySphere(obsPos, dir, R_EARTH + kAuroraMarchOuterM);
    vec2 tAuroraIn  = raySphere(obsPos, dir, R_EARTH + kAuroraMarchInnerM);

    float atEnter, atExit;
    if (obsEffH < kAuroraMarchInnerM) {
        atEnter = tAuroraIn.y;
        atExit  = tAuroraFar.y;
    } else if (obsEffH <= kAuroraMarchOuterM) {
        atEnter = 0.0;
        atExit  = tAuroraFar.y;
        if (tAuroraIn.x > 0.0 && tAuroraIn.x < atExit) atExit = tAuroraIn.x;
    } else {
        atEnter = tAuroraFar.x;
        atExit  = (tAuroraIn.x > 0.0) ? tAuroraIn.x : tAuroraFar.y;
    }
    // No terrain clip here (no tSurface in this shader) — same accepted approximation
    // cloudMarchCS/cirrusMarchCS already make; sat_sky.frag's post-hoc terrain-occlusion
    // correction on the composited result covers gross occlusion for all three now.
    if (atEnter >= atExit || atExit <= 0.0) return vec3(0.0);

    // Whole-ray bounding pre-check (ported from sat_sky.frag this session) — same 80deg
    // conservative bound (70deg worst-case oval reach + margin for 5-sample undersampling).
    const int kAuroraBoundSamples = 5;
    float minBoundColatDeg = 1e6;
    for (int bi = 0; bi < kAuroraBoundSamples; ++bi) {
        vec3 bp       = obsPos + dir * mix(atEnter, atExit, float(bi) / float(kAuroraBoundSamples - 1));
        vec3 bDirECEF = normalize(bp.x * enuX + bp.y * enuY + bp.z * enuZ);
        vec3 bPole    = (dot(bDirECEF, kGeomagPoleECEF) > 0.0) ? kGeomagPoleECEF : -kGeomagPoleECEF;
        minBoundColatDeg = min(minBoundColatDeg, degrees(acos(clamp(dot(bDirECEF, bPole), -1.0, 1.0))));
    }
    if (minBoundColatDeg > 80.0) return vec3(0.0);

    const float kAuroraMaxStepM = 15000.0;
    const int   kAuroraStepsMin = 4;
    const int   kAuroraStepsMax = 64;
    float aPathLen = atExit - atEnter;
    int   N_AURORA = clamp(int(aPathLen / kAuroraMaxStepM), kAuroraStepsMin, kAuroraStepsMax);
    float aSegLen = aPathLen / float(N_AURORA);
    vec3  accumAurora = vec3(0.0);
    for (int i = 0; i < N_AURORA; ++i) {
        vec3 ap = obsPos + dir * (atEnter + (float(i) + 0.5) * aSegLen);
        accumAurora += auroraCurtainSample(ap, enuX, enuY, enuZ, sunDirECEF, pc.waveTime, cloud.stormStrength);
    }

    // Light pollution + moonlight suppression — identical formula to sat_sky.frag's copy.
    float azLPAurora    = mod(atan(dir.x, dir.y) + 6.283185307, 6.283185307);
    float secFAurora    = azLPAurora * (16.0 / 6.283185307) - 0.5;
    int   sec0Aurora    = int(floor(secFAurora));
    float secFracAurora = secFAurora - float(sec0Aurora);
    int   sec0wAurora   = ((sec0Aurora % 16) + 16) % 16;
    int   sec1wAurora   = (sec0wAurora + 1) % 16;
    float domeAzAurora  = mix(lightDome[sec0wAurora], lightDome[sec1wAurora], secFracAurora);
    float elevFalloffAurora = 0.35 / (max(dir.z, 0.0) + 0.35);
    float domeValAurora  = clamp(domeAzAurora * elevFalloffAurora, 0.0, 1.0);
    const float kAuroraPollutionMaxDim = 0.9;

    float tmAurora         = clamp(moonDirENU.z / 0.5, 0.0, 1.0);
    float moonBrightAurora = tmAurora * tmAurora * moonDirENU.w;
    const float kAuroraMoonMaxDim = 0.85;

    float auroraVisSuppress = (1.0 - domeValAurora * kAuroraPollutionMaxDim)
                             * (1.0 - moonBrightAurora * kAuroraMoonMaxDim);

    // Atmospheric extinction — same Kasten & Young 1989 approximation as sat_sky.frag's copy.
    float atmFracAurora = clamp(exp(-obsEffH / 20000.0), 0.0, 1.0);
    float sinElAurora    = clamp(dir.z, 0.0, 1.0);
    float elDegAurora    = degrees(asin(sinElAurora));
    float airmassAurora  = 1.0 / (sinElAurora + 0.50572 * pow(elDegAurora + 6.07995, -1.6364));
    float extinctMagAurora = cloud.extinctionCoeff * (airmassAurora - 1.0) * atmFracAurora;
    float extinctionAurora = pow(10.0, -0.4 * extinctMagAurora);

    return accumAurora * aSegLen * kAuroraScale * cloud.auroraGain * auroraVisSuppress * extinctionAurora;
}

// Airglow red band (630nm) supplemental march — moved here from sat_sky.frag this session (perf:
// half-res instead of full-res, same rationale as aurora above, though the win is smaller — this
// march only ever cost ~1ms full-res: fixed 16 steps, 1 noise call per sample, nowhere near
// aurora's old worst case). Green/sodium bands still ride sat_sky.frag's main atmosphere loop "for
// free" and stay there — moving just them would mean duplicating a chunk of that loop here for
// near-zero marginal win, since they already cost almost nothing riding samples that loop takes
// anyway for other reasons (see the "does the atmosphere need full-res" discussion this session).
// No cloud-suppression term — the original never had one (unlike aurora), just a plain additive
// term, so this folds straight into B_total below with no extra logic.
const float kAirglowRedPeakM      = 275000.0;
const float kAirglowRedHalfWidthM = 75000.0;
const float kAirglowNoiseFreq     = 4.0;
const float kAirglowDriftRate     = 0.015;
const float kAirglowScale         = 0.0000005;

vec3 airglowRedMarchCS(vec3 obsPos, vec3 dir, vec3 enuX, vec3 enuY, vec3 enuZ,
                        vec3 sunDirECEF, float obsEffH) {
    const float kAirglowInnerM = 100000.0; // = R_ATMOS - R_EARTH
    const float kAirglowFarM   = 500000.0;
    vec2 tAtmos  = raySphere(obsPos, dir, R_ATMOS);
    vec2 tAirFar = raySphere(obsPos, dir, R_EARTH + kAirglowFarM);

    float rtEnter, rtExit;
    if (obsEffH < kAirglowInnerM) {
        rtEnter = tAtmos.y;
        rtExit  = tAirFar.y;
    } else if (obsEffH <= kAirglowFarM) {
        rtEnter = 0.0;
        rtExit  = tAirFar.y;
        if (tAtmos.x > 0.0 && tAtmos.x < rtExit) rtExit = tAtmos.x;
    } else {
        rtEnter = tAirFar.x;
        rtExit  = (tAtmos.x > 0.0) ? tAtmos.x : tAirFar.y;
    }
    // No terrain clip here (no tSurface in this shader) — same accepted approximation
    // cloudMarchCS/cirrusMarchCS/auroraMarchCS already make.
    if (rtEnter >= rtExit || rtExit <= 0.0) return vec3(0.0);

    const int N_AIRGLOW_RED = 16;
    float rSegLen = (rtExit - rtEnter) / float(N_AIRGLOW_RED);
    vec3  accumAirglowRed = vec3(0.0);
    for (int i = 0; i < N_AIRGLOW_RED; ++i) {
        vec3  rp       = obsPos + dir * (rtEnter + (float(i) + 0.5) * rSegLen);
        float rh       = length(rp) - R_EARTH;
        vec3  rDirECEF = normalize(rp.x * enuX + rp.y * enuY + rp.z * enuZ);
        float rDayness = clamp((dot(rDirECEF, sunDirECEF) + 0.15) / 0.3, 0.0, 1.0);
        float rNight   = 1.0 - rDayness;
        if (rNight > 0.001) {
            float rPatch = 0.6 + 0.4 * warpPerlin3(rDirECEF * kAirglowNoiseFreq
                                + vec3(pc.waveTime * kAirglowDriftRate, 17.0, -5.0));
            float dzR      = (rh - kAirglowRedPeakM) / kAirglowRedHalfWidthM;
            float densAirR = exp(-dzR * dzR) * rSegLen;
            accumAirglowRed += kAirglowRedColor * cloud.airglowRedGain * densAirR * rNight * rPatch;
        }
    }
    return accumAirglowRed * kAirglowScale * cloud.airglowGain;
}

// Perf (this session): was 3 live warpPerlin3 evaluations (24 gradient-hash lookups) per call —
// the dominant live-procedural cost in the cloud march, since this runs once per in-cloud march
// sample. Baked into cloud_warp_noise.comp's field (R/G/B = the same three offset channels this
// used to compute live). kWarpBakeN MUST match the bake shader's own constant — see that file's
// header for the tiling-period / repeat-distance trade-off this bake accepted (the live version
// never repeated; the baked one tiles at a period chosen to stay unnoticeable in normal play).
const float kWarpBakeN = 16.0;
const int   kWarpBakeRes = 192; // MUST match cloud_warp_noise.comp's own bake resolution (kSz)

// Wraps a texel index into [0,N) — same explicit pattern as gradHash's cell wrap in
// cloud_warp_noise.comp (not GLSL's `%`, whose sign behavior for negative operands isn't
// something to rely on across drivers).
int wrapTexel(int x, int n) { int r = x % n; return r < 0 ? r + n : r; }
ivec3 wrapTexel3(ivec3 c, int n) { return ivec3(wrapTexel(c.x, n), wrapTexel(c.y, n), wrapTexel(c.z, n)); }

// Manual smoothstep-weighted trilinear blend of the baked warp texels — NOT a plain texture()
// call. Hardware trilinear filtering interpolates LINEARLY (straight-edged) between texels; the
// live analytic version this replaced was smoothstep-interpolated (curved) between its gradient
// corners. At this bake's texel density that mismatch was geometrically legible as visible
// "tessellating triangle" faceting once the value is used as a raw coordinate displacement (see
// cloud_warp_noise.comp's header — a 192³/2-octave resolution bump alone reduced but didn't
// eliminate it). Using texelFetch + a manual smoothstep weight reproduces the same curved
// interpolation shape the analytic Perlin evaluation had, regardless of texel density — the
// sampler's REPEAT/LINEAR settings go unused here (texelFetch bypasses both address mode and
// filtering; wrapping is done by hand via wrapTexel3 instead).
vec3 cloudWarpNoiseSample(vec3 uvw) {
    vec3  tc = fract(uvw) * float(kWarpBakeRes) - 0.5; // texel-centered, wrapped into [0,texSize)
    ivec3 i0 = ivec3(floor(tc));
    vec3  f  = tc - vec3(i0);
    vec3  u  = f * f * (3.0 - 2.0 * f); // same smoothstep curve the analytic Perlin interpolant used

    vec3 c000 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,0,0), kWarpBakeRes), 0).rgb;
    vec3 c100 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,0,0), kWarpBakeRes), 0).rgb;
    vec3 c010 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,1,0), kWarpBakeRes), 0).rgb;
    vec3 c110 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,1,0), kWarpBakeRes), 0).rgb;
    vec3 c001 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,0,1), kWarpBakeRes), 0).rgb;
    vec3 c101 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,0,1), kWarpBakeRes), 0).rgb;
    vec3 c011 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(0,1,1), kWarpBakeRes), 0).rgb;
    vec3 c111 = texelFetch(cloudWarpNoiseTex, wrapTexel3(i0 + ivec3(1,1,1), kWarpBakeRes), 0).rgb;

    return mix(mix(mix(c000, c100, u.x), mix(c010, c110, u.x), u.y),
               mix(mix(c001, c101, u.x), mix(c011, c111, u.x), u.y), u.z);
}

vec3 cloudWarpOffset(vec3 dirECEF) {
    vec3 windOfs = vec3(cloud.cloudPhase * kWarpDriftRate + pc.waveTime * kWarpEvolveRate,
                         pc.waveTime * kWarpEvolveRate * 0.6,
                         cloud.cloudPhase * kWarpDriftRate * 0.7 + pc.waveTime * kWarpEvolveRate * 0.8);
    vec3 uvw = (dirECEF * kWarpFreq + windOfs) / kWarpBakeN;
    vec3 n   = cloudWarpNoiseSample(uvw) * 2.0 - 1.0;
    return n * kWarpStrength;
}

float cityBrightness(float lum) {
    float raw = max(0.0, lum - kNightFloor);
    return raw / (raw + kCityCompressK);
}

float cloudDensity(vec3 uvwXY, vec3 uvwDetail, float hNorm, float coverage, float density, float heightProfile) {
    // Vertical presence: THREE fixed Z-slices, not a continuous Z lookup — see
    // project_cloud_march_steps memory: sampling Z continuously at this codebase's typical
    // march-step counts reintroduces altitude-slab banding, which is why the original design
    // pinned this to constant slices in the first place. The problem with only two slices is that
    // a straight lerp between them makes every cloud's silhouette a geometric cone (wide at
    // kPresenceZBase, monotonically narrowing to kPresenceZTop) — a third anchor at the midpoint
    // breaks that monotonic taper into an actual bulge/waist shape without reintroducing
    // per-march-step Z sensitivity (still just 3 discrete lookups, blended smoothly by hNorm).
    const float kPresenceZBase = 0.0;
    const float kPresenceZMid  = 0.28;
    const float kPresenceZTop  = 0.56;
    float nsBaseR = texture(cloudNoiseTex, uvwXY + vec3(0.0, 0.0, kPresenceZBase)).r;
    float nsMidR  = texture(cloudNoiseTex, uvwXY + vec3(0.0, 0.0, kPresenceZMid)).r;
    float nsTopR  = texture(cloudNoiseTex, uvwXY + vec3(0.0, 0.0, kPresenceZTop)).r;
    float baseA   = remap(nsBaseR, 1.0 - coverage, 1.0, 0.0, 1.0);
    float midA    = remap(nsMidR,  1.0 - coverage, 1.0, 0.0, 1.0);
    float topA    = remap(nsTopR,  1.0 - coverage, 1.0, 0.0, 1.0);
    float hc      = clamp(hNorm, 0.0, 1.0);
    float base    = (hc < 0.5) ? mix(baseA, midA, hc * 2.0)
                                : mix(midA, topA, (hc - 0.5) * 2.0);
    if (base <= 0.0) return 0.0;

    vec4  nsF     = texture(cloudNoiseTex, uvwDetail * 1.5 + vec3(0.37, 0.53, 0.71));
    float erosion = nsF.g * 0.625 + nsF.b * 0.25 + nsF.a * 0.125;

    // Edge-biased erosion: `base` doubles as a proxy for how deep inside the cloud's own presence
    // threshold this point sits (near 0 at the silhouette edge, toward 1 at the core). Biting
    // harder near the edge than at the core carves cauliflower/wisp detail into the boundary while
    // leaving dense cores comparatively solid — the previous single uniform erosion strength just
    // scaled the whole shape down evenly, which reads as smooth/rounded rather than fluffy.
    float erosionAmt = mix(cloud.cloudErosionEdge, cloud.cloudErosionCore, base);
    float eroded  = remap(base, erosionAmt * erosion, 1.0, 0.0, 1.0);

    return clamp(eroded * heightProfile * density, 0.0, 1.0);
}

// ── Moved (exclusive to cirrusMarch) ──────────────────────────────────────────

float cirrusWindAngleAt(vec3 dirECEF) {
    vec3 p = dirECEF * kCirrusWindWarpFreq
           + vec3(pc.waveTime * kWarpEvolveRate * 1.7,
                   cloud.cloudPhase * kCirrusWindDriftRate,
                   91.0);
    return warpPerlin3(p) * kCirrusWindWarpAmp;
}

vec3 cirrusDomainWarp(vec3 dirECEF) {
    vec3 w1 = cloudWarpOffset(dirECEF);
    vec3 p2 = dirECEF * (kWarpFreq * 0.35) + vec3(19.0, -7.0, 41.0)
            + vec3(pc.waveTime * kWarpEvolveRate * 0.5);
    vec3 w2 = vec3(warpPerlin3(p2),
                    warpPerlin3(p2 + vec3(5.2, 1.1, 9.3)),
                    warpPerlin3(p2 + vec3(3.3, 8.8, 2.2))) * (kWarpStrength * 1.5);
    return w1 + w2;
}

// ── cloudMarchCS / cirrusMarchCS ───────────────────────────────────────────────
// Restructured from sat_sky.frag's cloudMarch/cirrusMarch: instead of mutating an inout `color`,
// each returns the (A, B) pair of its affine composite (`color_out = color_in*A + B`) directly,
// so the caller can combine cirrus-then-cloud into one (A_total, B_total) pair algebraically —
// see the plan's "Why two RGBA16F targets" section. No terrain clipping here (no tSurface param;
// the `if (tSurface > 0.0) tExit = min(tExit, tSurface);` lines from the original are removed).
// CLOUD_DEBUG diagnostic overlays from the original are not ported — always CLOUD_DEBUG==0 here.

void cloudMarchCS(
    vec3  obsPos,  vec3  dir,
    vec3  enuX,    vec3  enuY,        vec3  enuZ,
    vec3  sunDir,  vec3  sunDirECEF,  float obsEffH,
    vec4  moonDirENU,
    out   vec3  A_cloud, out vec3 B_cloud,
    out   vec3  cloudTOut,
    out   float tCloudOcclude,
    out   float tEnterOut) // always valid whenever the march actually runs, unlike tCloudOcclude
                            // (which only sets once ≥90% opaque) — see sat_sky.frag's terrain-
                            // suppression comment for why both are needed.
{
    A_cloud = vec3(1.0);
    B_cloud = vec3(0.0);
    cloudTOut = vec3(1.0);
    tCloudOcclude = -1.0;
    tEnterOut = -1.0;
    if (cloud.layers[0].enabled < 0.5) return;

    float cloudAltFade = 1.0 - smoothstep(kCloud3DFadeStart, kCloud3DFadeEnd, obsEffH);
    if (cloudAltFade < 0.001) return;

    float cloudBaseAlt = cloud.layers[0].shellAltM;
    float cloudTopAlt  = cloud.layers[1].shellAltM;
    float shellThick   = cloudTopAlt - cloudBaseAlt;
    float cloudBase    = R_EARTH + cloudBaseAlt;
    float cloudTop     = R_EARTH + cloudTopAlt;

    vec2 shellB = raySphere(obsPos, dir, cloudBase);
    vec2 shellT = raySphere(obsPos, dir, cloudTop);

    float tEnter, tExit;

    if (obsEffH < cloudBaseAlt) {
        tEnter = shellB.y;
        tExit  = shellT.y;
    } else if (obsEffH <= cloudTopAlt) {
        tEnter = 0.001;
        tExit  = shellT.y;
        if (shellB.x > 0.001 && shellB.x < tExit) tExit = shellB.x;
    } else {
        if (shellT.x < 0.0) return;
        tEnter = shellT.x;
        tExit  = (shellB.x > 0.0) ? shellB.x : shellT.y;
    }

    tExit = min(tExit, tEnter + cloud.maxRenderDistM);
    if (tEnter >= tExit || tExit <= 0.0) return;

    {
        vec3  ePt   = obsPos + tEnter * dir;
        vec3  eECEF = ePt.x * enuX + ePt.y * enuY + ePt.z * enuZ;
        float eLen  = length(eECEF);
        float eLon  = atan(eECEF.y, eECEF.x);
        float eLat  = asin(clamp(eECEF.z / eLen, -1.0, 1.0));
        vec2  eUV   = vec2(fract((eLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                           (0.5*PI - eLat) / PI);
        float cMap  = textureLod(earthCloudsTex, eUV, 4.0).r;
        if (cloud.coverage * cMap < 0.02) return;
    }

    // Past this point the march genuinely runs — record the entry distance for terrain
    // suppression regardless of how opaque the result turns out to be (tCloudOcclude, set later,
    // stays gated at ≥90% opacity for the separate satellite-occlusion use case).
    tEnterOut = tEnter;

    vec3 sunColorCloud = vec3(0.0);
    {
        vec3 p0  = obsPos + tEnter * dir;
        vec2 tSE = raySphere(p0, sunDir, R_EARTH);
        if (!(tSE.x > 0.0 && tSE.y > 0.0)) {
            vec2 tSA = raySphere(p0, sunDir, R_ATMOS);
            if (tSA.y > 0.0) {
                vec2 sOD = optDepth(p0, sunDir, tSA.y);
                sunColorCloud = SUN_INTENSITY * exp(-(BETA_R * sOD.x + BETA_M * 1.1 * sOD.y));
            }
        }
    }

    vec3 skyAmbientBase = vec3(0.0);
    {
        // Sampled at the OBSERVER's own position, NOT the cloud march's entry point (obsPos +
        // tEnter*dir) — a first version used the entry point, which is fine for a steep/near-
        // vertical ray (tEnter small, close to the observer) but for a GRAZING/near-horizontal ray
        // tEnter can be hundreds of km out, putting p0 near the observer's own visual horizon.
        // Earth's curvature means conditions THERE (day/night, twilight angle) can genuinely differ
        // from the observer's own — and since skyAmbientBase is computed ONCE per pixel and then
        // applied UNIFORMLY across the entire march (every in-cloud step from tEnter to tExit, now
        // as far as ~400km after the render-distance extension), one potentially-unrepresentative
        // sample from a single far point was getting smeared across the whole visible horizon
        // band — reported as "aurora glow / sky Mie scattering dramatically overlays clouds at the
        // horizon." Anchoring to obsPos instead makes this a stable read of the observer's own
        // actual local conditions (the thing that's actually dark during an aurora-visible night),
        // consistent across the whole march instead of picking up whatever a distant point sees.
        vec3 p0     = obsPos;
        vec3 zenith = normalize(p0);
        vec2 tSA    = raySphere(p0, zenith, R_ATMOS);
        if (tSA.y > 0.0) {
            const int N_Z = 6;
            float zSeg    = tSA.y / float(N_Z);
            float cosAUp  = dot(zenith, sunDir);
            float pR_up   = 0.75 * (1.0 + cosAUp * cosAUp);
            float odR_z = 0.0, odM_z = 0.0;
            float skyAmbientBaseM = 0.0;
            for (int zi = 0; zi < N_Z; ++zi) {
                vec3  sp = p0 + zenith * ((float(zi) + 0.5) * zSeg);
                float h  = max(0.0, length(sp) - R_EARTH);
                float dR = exp(-h / H_R) * zSeg;
                float dM = exp(-h / H_M) * zSeg;
                odR_z += dR;  odM_z += dM;
                vec2 tSE = raySphere(sp, sunDir, R_EARTH);
                if (tSE.x > 0.0 && tSE.y > 0.0) continue;
                vec2 tSun = raySphere(sp, sunDir, R_ATMOS);
                vec2 sunOD = (tSun.y > 0.0) ? optDepth(sp, sunDir, tSun.y) : vec2(0.0);
                vec3 tau      = BETA_R * (odR_z + sunOD.x) + BETA_M * 1.1 * (odM_z + sunOD.y);
                vec3 attnStep = exp(-tau);
                skyAmbientBase  += attnStep * dR;
                skyAmbientBaseM += dot(attnStep, vec3(1.0 / 3.0)) * dM;
            }
            float pM_up = phaseM(cosAUp);
            skyAmbientBase = SUN_INTENSITY * (pR_up * BETA_R * skyAmbientBase
                                            + vec3(pM_up * BETA_M * skyAmbientBaseM));
        }
    }

    vec3  cloudTransmittance = vec3(1.0);
    vec3  cloudScatter       = vec3(0.0);
    float groundSteps = max(2.0, cloud.marchSteps);
    float stepAltT    = smoothstep(kMarchStepsAltStart, kMarchStepsAltEnd, obsEffH);
    int   N           = max(8, int(mix(groundSteps, kMarchStepsFloor, stepAltT)));
    float dh_dt       = max(abs(dir.z), 0.02);
    const float kCloudMaxStepM = 250.0;
    float stepLen = min((shellThick / float(N)) / dh_dt, kCloudMaxStepM);
    bool  insideShell = (obsEffH >= cloudBaseAlt && obsEffH <= cloudTopAlt);
    float bigStep = insideShell ? stepLen : stepLen * 2.0;
    float t       = tEnter;
    bool  inCloud = false;
    float cosA    = dot(dir, sunDir);
    float ph      = phaseCloud(cosA);
    vec3  moonDir3 = normalize(moonDirENU.xyz);
    float cosAMoon = dot(dir, moonDir3);
    float phMoon   = phaseCloud(cosAMoon);

    // Raised 2048->4096 (session 28 follow-up #10): with maxRenderDistM pushed out to actually
    // reach the cloud shell's own horizon (see that field's comment), the old 2048 ceiling could
    // itself become the binding cutoff before maxRenderDistM did. Margin raised again (follow-up
    // #14): at the 400km default, covering the full distance at kCloudMaxStepM=250m needs exactly
    // 1600 steps — the flat "+32" margin left only 32 steps of slack, uncomfortably close to the
    // exact requirement for a ray that's "in cloud" (the finer stepLen, not the coarser bigStep)
    // continuously the whole way, which is precisely the dense-horizon-cloud case this exists to
    // handle. A 15% multiplicative margin plus a larger flat floor scales proportionally instead of
    // staying fixed as maxRenderDistM grows.
    int hardCap = min(8192, int(cloud.maxRenderDistM / kCloudMaxStepM * 1.15) + 64);
    for (int i = 0; i < hardCap && t < tExit; ++i) {
        float step = inCloud ? stepLen : bigStep;
        step = min(step, tExit - t);
        vec3  p = obsPos + (t + step * 0.5) * dir;
        float h = length(p) - R_EARTH;
        if (h < cloudBaseAlt || h > cloudTopAlt) { inCloud = false; t += step; continue; }

        float hNorm = (h - cloudBaseAlt) / shellThick;
        vec3  pECEF = p.x * enuX + p.y * enuY + p.z * enuZ;

        // Hoisted up from its old spot further below (next to sunElev/selfShadow) so the self-
        // shadow cone's grazing-angle compensation can use it too — same value, computed once.
        float cloudSunDotRaw = dot(normalize(pECEF), sunDirECEF);

        float pLen  = length(pECEF);
        float pLon  = atan(pECEF.y, pECEF.x);
        float pLat  = asin(clamp(pECEF.z / pLen, -1.0, 1.0));
        vec2  pUV   = vec2(fract((pLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                           (0.5*PI - pLat) / PI);
        vec2  pUVGeo = vec2(fract((pLon + PI) / (2.0*PI)), (0.5*PI - pLat) / PI);
        float localCov = cloud.coverage * textureLod(earthCloudsTex, pUV, 4.0).r;

        vec3  dirECEF      = pECEF / pLen;
        vec3  dirECEFDrift = rotateZ(dirECEF, cloud.cloudPhase * cloud.layers[0].driftMult);
        vec3  warpUVW      = cloudWarpOffset(dirECEFDrift);

        float colNoise = texture(cloudNoiseTex,
                                 dirECEFDrift * kCloudColFreq + warpUVW + vec3(0.0, 0.0, 0.25)).r;
        float colH = remap(colNoise, 1.0 - localCov, 1.0, 0.0, 1.0);

        // Variable base height: was a hardcoded 0.0 for every column, so every cloud in the shell
        // shared exactly the same base altitude — a perfectly flat deck. baseNoise reuses the same
        // warped horizontal coordinate as colH (so the undulation follows the same drifting cloud
        // field) but a decorrelated fixed Z offset, scaled by cloud.cloudBaseVariance (settings
        // "Base variance"; 0 reproduces the old flat-base behavior exactly).
        float baseNoise = texture(cloudNoiseTex,
                                  dirECEFDrift * kCloudColFreq + warpUVW + vec3(0.0, 0.0, 0.85)).r;
        float baseH = (baseNoise - 0.5) * cloud.cloudBaseVariance;

        float topFade = 1.0 - smoothstep(colH - 0.05, colH + 0.05, hNorm);
        float hFade = smoothstep(baseH, baseH + 0.05, hNorm) * topFade;
        if (hFade < 0.001) { inCloud = false; t += step; continue; }

        const float kVertTiles = 1.5;
        float posZ    = sin(pUV.x * 21.3 + pUV.y * 17.7) * 0.5 + 0.5;
        vec3  uvwXY   = dirECEFDrift * kCloudHorizFreq + warpUVW;
        vec3  uvwDetail = uvwXY
                               + vec3(0.0, 0.0, hNorm * kVertTiles + posZ * 2.0);
        float d = cloudDensity(uvwXY, uvwDetail, hNorm, localCov, cloud.density, hFade);

        if (d > 0.001) {
            inCloud = true;
            float extinction = d * step * 3e-3;
            vec3  stepT      = exp(-vec3(extinction));
            float powder     = 1.0 - exp(-extinction * 2.0);

            float sampleDist = t + step * 0.5;
            float shadowFade = 1.0 - smoothstep(cloud.shadowMaxDistM * 0.6, cloud.shadowMaxDistM, sampleDist);
            float sunOptDepth = 0.0;
            if (shadowFade > 0.01 && (pc.debugDisableMask & 64u) == 0u) {
                int   N_CONE    = max(1, int(cloud.lightSteps));
                vec2  tConeExit = raySphere(p, sunDir, cloudTop);
                float coneLen   = min((tConeExit.y > 0.0) ? tConeExit.y : shellThick, shellThick * 2.0);
                float coneSeg   = coneLen / float(N_CONE);
                // Per-invocation jitter on the cone's sample phase: a FIXED (ci+0.5) offset means
                // every in-cloud sample's shadow cone is phase-locked to the same lattice through
                // structured (Worley) noise sampled along one constant global direction (sunDir) —
                // that's a textbook aliasing setup, and it read as coherent parallel-line banding
                // in cloud shadows. Same noiseTex dither pattern cirrusMarchCS already uses.
                float coneJitter = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).g;
                for (int ci = 0; ci < N_CONE; ++ci) {
                    vec3  cp    = p + sunDir * (float(ci) + coneJitter) * coneSeg;
                    float ch    = length(cp) - R_EARTH;
                    if (ch < cloudBaseAlt || ch > cloudTopAlt) continue;
                    float chN   = (ch - cloudBaseAlt) / shellThick;
                    vec3  cpE   = cp.x * enuX + cp.y * enuY + cp.z * enuZ;
                    float cpL   = length(cpE);
                    float cpLon = atan(cpE.y, cpE.x);
                    float cpLat = asin(clamp(cpE.z / cpL, -1.0, 1.0));
                    vec2  cpUV  = vec2(fract((cpLon + PI) / (2.0*PI)
                                       + cloud.cloudPhase * cloud.layers[0].driftMult / (2.0*PI)),
                                      (0.5*PI - cpLat) / PI);
                    float cLoc  = cloud.coverage * textureLod(earthCloudsTex, cpUV, 5.0).r;
                    if (cLoc < 0.02) continue;
                    float cPosZ      = sin(cpUV.x * 21.3 + cpUV.y * 17.7) * 0.5 + 0.5;
                    vec3  cDir       = cpE / cpL;
                    vec3  cDirDrift  = rotateZ(cDir, cloud.cloudPhase * cloud.layers[0].driftMult);
                    // Reuse the PARENT sample's already-computed warp offset instead of calling
                    // cloudWarpOffset (3 warpPerlin3 evaluations) again per cone step — perf
                    // (this session): cone samples sit within ~2*shellThick of p along sunDir,
                    // a few km at most, which is a negligible angular displacement against
                    // kWarpFreq=6's basis over the full unit sphere. This was the single biggest
                    // new cost from making the shadow cone warp-consistent with the visible cloud.
                    vec3  cWarpUVW   = warpUVW;
                    vec3  cUVWXY = cDirDrift * kCloudHorizFreq + cWarpUVW;
                    vec3  cUVWD  = cUVWXY + vec3(0.0, 0.0, chN * kVertTiles + cPosZ * 2.0);

                    // Match the cone's own vertical coverage limit and base variance to the SAME
                    // per-column noise the visible march uses (colH/baseH above) — without this the
                    // cone treated the whole 5%-95% of the shell as potential cloud regardless of
                    // how little of that column the visible march actually filled in, so a nearly-
                    // clear column (or one whose visible cloud is only a single-step sliver) could
                    // still cast a full-height shadow with no corresponding visible cloud.
                    float cColNoise  = texture(cloudNoiseTex, cDirDrift * kCloudColFreq + cWarpUVW + vec3(0.0, 0.0, 0.25)).r;
                    float cColH      = remap(cColNoise, 1.0 - cLoc, 1.0, 0.0, 1.0);
                    float cBaseNoise = texture(cloudNoiseTex, cDirDrift * kCloudColFreq + cWarpUVW + vec3(0.0, 0.0, 0.85)).r;
                    float cBaseH     = (cBaseNoise - 0.5) * cloud.cloudBaseVariance;
                    float chFade = smoothstep(cBaseH, cBaseH + 0.05, chN) * (1.0 - smoothstep(cColH - 0.05, cColH + 0.05, chN));
                    sunOptDepth += cloudDensity(cUVWXY, cUVWD, chN, cLoc, cloud.density, chFade) * coneSeg * 3.75e-4;
                }
                sunOptDepth *= shadowFade;

                // Grazing-sun attenuation: at sunset the light-march cone above (only ~N_CONE
                // samples, a handful by default) traverses the shell almost tangentially, so with
                // this coverage map reading fairly uniform at the cone's short fixed reach, most
                // samples land in cloud and sunOptDepth comes out uniformly high — reported as the
                // whole visible cloud field going into flat shadow at sunset, well before the sun
                // is actually at a shallow enough angle for that much mutual occlusion. (An earlier
                // attempt fixed this by extending coneLen itself at grazing angles instead, but
                // with a low, GPU-cost-bound N_CONE that just undersampled a longer path — visible
                // as banding, and shadow no longer tied to actual cloud shape. Reverted above.)
                // This instead directly damps the RESULT at low sun elevation, leaving the cone's
                // sampling geometry untouched (so it stays fully correlated with cloud shape) —
                // less physically rigorous, but matches the existing shadowFloor/selfShadow
                // heuristic below, which already fudges the same sunset transition for the same
                // reason.
                float sunElevSin = clamp(abs(cloudSunDotRaw), 0.0, 1.0);
                float grazeAtten = mix(kGrazeShadowFloor, 1.0, smoothstep(0.0, kGrazeShadowFullSin, sunElevSin));
                sunOptDepth *= grazeAtten;
            }

            float ms1 = exp(-sunOptDepth);
            float ms2 = exp(-sunOptDepth * 0.5) * 0.5;
            float ms3 = exp(-sunOptDepth * 0.25) * 0.25;
            float sunTransmittance = max((ms1 + ms2 + ms3) / 1.75, 0.05);

            float sunElev     = smoothstep(-0.04, 0.12, cloudSunDotRaw);
            float sunElevSoft = sunElev;
            float shadowFloor = mix(0.1, 0.5, clamp(1.0 - sunElev * 4.0, 0.0, 1.0));
            float selfShadow  = mix(shadowFloor, 1.0, hNorm);
            float sunLit      = sunElevSoft * sunTransmittance * selfShadow;

            float sampleDayness = clamp((cloudSunDotRaw + 0.2) / 0.5, 0.0, 1.0);

            // skyAmbientBase (the analytic single-scattering zenith Rayleigh/Mie integral, sampled
            // once per frame at the observer) represents zenith-scattered SUNLIGHT and genuinely
            // decays toward true night — but not fast enough on its own: it only zeroes out once
            // the sun ray to every sample along the zenith column is Earth-blocked, which can
            // still be a while (and depends on the OBSERVER's own position, not this cloud
            // sample's) after this particular sample has visually gone dark. Originally this term
            // was left completely ungated (read as a lit sky-colored haze even at true night); a
            // first fix gated it by (1-sampleDayness), which only ramps IN toward night and never
            // back out, so it stayed at full strength indefinitely once past the terminator —
            // reported as overbright at night. twilightWeight is instead a proper bell: it rises
            // approaching dusk and falls again deeper into night, so this term is twilight-only,
            // as intended, and skyAmbientBase's own slow decay no longer has to do all the work.
            float twilightRise = 1.0 - smoothstep(-0.05, 0.15, cloudSunDotRaw);
            float twilightFall = smoothstep(-0.45, -0.15, cloudSunDotRaw);
            float twilightWeight = twilightRise * twilightFall;
            vec3 twilightAmbient = skyAmbientBase * mix(0.3, 0.9, hNorm) * twilightWeight;

            // Separate, non-decaying night-sky floor (stand-in for starlight + multiple-scattered
            // air) so cloud tops aren't fully dark once twilightAmbient above has faded out. Kept
            // on its own cloud.cloudNightAmbientGain slider rather than cloud.ambientGain, which
            // also drives cityUp below — sharing one gain forced a tradeoff between good city-light
            // cloud illumination and blown-out night ambient. Still gated by (1-sampleDayness) —
            // ramps up through twilight and holds through night, unlike twilightAmbient above.
            vec3 nightFloorAmbient = kNightSkyAmbientColor * mix(0.1, 0.3, hNorm)
                                    * cloud.cloudNightAmbientGain * (1.0 - sampleDayness);

            vec3 skyAmbient = twilightAmbient + nightFloorAmbient;

            vec3  moonECEF_c    = moonDir3.x * enuX + moonDir3.y * enuY + moonDir3.z * enuZ;
            float moonElevGeog  = max(0.0, dot(normalize(pECEF), moonECEF_c));
            float moonLit       = moonElevGeog * moonDirENU.w * selfShadow * (1.0 + powder);
            float nightFac      = 1.0 - min(sampleDayness * 3.0, 1.0);
            vec3  moonContrib   = vec3(0.92, 0.95, 1.0) * moonLit * phMoon * cloud.moonGain * nightFac;

            vec3 cityUp = vec3(0.0);
            if (sampleDayness < 0.9 && hNorm < 0.45) {
                vec3  cityRgb  = textureLod(earthNightTex, pUVGeo, 3.0).rgb;
                float cityLum  = dot(cityRgb, vec3(0.2126, 0.7152, 0.0722));
                vec3  cityTint = cityRgb / max(cityLum, 0.001);
                float heightFalloff = smoothstep(0.45, 0.0, hNorm);
                cityUp = cityTint * cityBrightness(cityLum) * heightFalloff * (1.0 - sampleDayness)
                       * kCityUpwellStrength * cloud.ambientGain;
            }

            // Aurora ground-glow: the curtain sits far above the cloud shell (95-300km vs. 2-11km),
            // so unlike cityUp (which washes the cloud BASE from below), this lights cloud TOPS
            // more than bases — opposite height falloff. Evaluated LOCALLY at this sample's own
            // dirECEF (auroraOvalMaskLocal above), not a CPU-computed observer-position proxy.
            float auroraLocalMask = auroraOvalMaskLocal(dirECEF, pc.waveTime, cloud.stormStrength);
            vec3  auroraUp        = kAuroraGroundColor * auroraLocalMask * cloud.auroraCloudGain
                                   * (1.0 - sampleDayness) * mix(0.2, 1.0, hNorm);

            // Sun gain blended by sun elevation: cloud.sunGain (near-horizon/sunset) tuned high
            // reads as an amazing sunset, but the SAME flat gain applied at midday (sun near
            // zenith) overexposes the whole cloud deck — cloudSunDotRaw is already ~sin(sun
            // elevation) at this point on Earth, so 0=horizon/sunset, 1=overhead/midday.
            float sunGainCurve = mix(cloud.sunGain, cloud.sunGainZenith,
                                      smoothstep(0.0, 1.0, clamp(cloudSunDotRaw, 0.0, 1.0)));
            vec3  inScatter  = sunColorCloud * sunLit * ph * (1.0 + powder) * sunGainCurve
                             + moonContrib
                             + skyAmbient
                             + cityUp
                             + auroraUp;

            cloudScatter       += cloudTransmittance * (1.0 - stepT) * inScatter;
            cloudTransmittance *= stepT;

            if (cloudTransmittance.r < 0.01) break;
        } else {
            inCloud = false;
        }
        t += step;
    }

    cloudTOut = mix(vec3(1.0), cloudTransmittance, cloudAltFade);
    if (dot(cloudTOut, vec3(1.0/3.0)) < 0.1 && cloudAltFade > 0.1) tCloudOcclude = tEnter;

    vec2 odAtmCloud = optDepth(obsPos, dir, tEnter);
    vec3 cloudAttn  = exp(-(BETA_R * odAtmCloud.x + BETA_M * 1.1 * odAtmCloud.y));

    A_cloud = vec3(1.0) - cloudAttn * (1.0 - cloudTOut);
    B_cloud = cloudAttn * cloudScatter * cloudAltFade;
}

void cirrusMarchCS(
    vec3  obsPos,  vec3  dir,
    vec3  enuX,    vec3  enuY,        vec3  enuZ,
    vec3  sunDir,  vec3  sunDirECEF,  float obsEffH,
    out   vec3  A_cirrus, out vec3 B_cirrus,
    out   float tEnterOut) // always valid whenever the march runs — see cloudMarchCS's tEnterOut
{
    A_cirrus = vec3(1.0);
    B_cirrus = vec3(0.0);
    tEnterOut = -1.0;
    if (cloud.layers[1].enabled < 0.5) return;
    float cirrusAltFade = 1.0 - smoothstep(kCloud3DFadeStart, kCloud3DFadeEnd, obsEffH);
    if (cirrusAltFade < 0.001) return;

    float cirrusAlt  = cloud.layers[1].shellAltM;
    float shellBAlt  = cirrusAlt - kCirrusThicknessM * 0.5;
    float shellTAlt  = cirrusAlt + kCirrusThicknessM * 0.5;
    vec2  shellB     = raySphere(obsPos, dir, R_EARTH + shellBAlt);
    vec2  shellT     = raySphere(obsPos, dir, R_EARTH + shellTAlt);

    float tEnter, tExit;
    if (obsEffH < shellBAlt) {
        tEnter = shellB.y;
        tExit  = shellT.y;
    } else if (obsEffH <= shellTAlt) {
        tEnter = 0.001;
        tExit  = shellT.y;
        if (shellB.x > 0.001 && shellB.x < tExit) tExit = shellB.x;
    } else {
        if (shellT.x < 0.0) return;
        tEnter = shellT.x;
        tExit  = (shellB.x > 0.0) ? shellB.x : shellT.y;
    }
    // Render-distance cap raised 200km->450km (session 28 follow-up #10): cirrus sits at ~15km
    // altitude by default, whose own geometric horizon distance is ~sqrt(2*R_EARTH*15000)≈437km —
    // the old 200km cap cut the march off well short of that, letting stars/aurora/Milky Way show
    // straight through cirrus near the horizon instead of the cirrus layer thinning out naturally.
    tExit = min(tExit, tEnter + 450000.0);
    if (tEnter >= tExit || tExit <= 0.0) return;
    tEnterOut = tEnter;

    // Adaptive step count (same fix as the aurora march, session 28 follow-up #9): a FIXED
    // N_CIRRUS badly serves a path length that now legitimately ranges from ~10km (steep look-down)
    // to 450km (grazing/horizon) — a fixed 14 steps across the extended cap would badly undersample
    // exactly the far, grazing case the render-distance increase above was meant to fix.
    // kCirrusStepsMax must cover the full 450km cap above at kCirrusMaxStepM resolution
    // (450000/3000=150) — the original value here (128) was computed before the render-distance
    // cap was raised in the same edit and never rechecked against it, so it silently forced
    // grazing/horizon rays into a COARSER-than-intended step size (450000/128≈3516m) right where
    // the render-distance fix mattered most. Margin added on top for the same reason the low-cloud
    // hardCap below now has more headroom too.
    const float kCirrusMaxStepM = 3000.0;
    const int   kCirrusStepsMin = 14;
    const int   kCirrusStepsMax = 200;
    float cirrusPathLen = tExit - tEnter;
    int   N_CIRRUS = clamp(int(cirrusPathLen / kCirrusMaxStepM), kCirrusStepsMin, kCirrusStepsMax);
    float segLen = cirrusPathLen / float(N_CIRRUS);
    float jitter  = textureLod(noiseTex, vec2(gl_GlobalInvocationID.xy) * (1.0/128.0), 0.0).r;

    float invStretch   = 1.0 / max(cloud.cirrusStretch, 1.0);

    vec3  cirrusTransmittance = vec3(1.0);
    vec3  cirrusScatter       = vec3(0.0);
    float cosA = dot(dir, sunDir);
    float ph   = phaseCloud(cosA);

    for (int i = 0; i < N_CIRRUS; ++i) {
        float t = tEnter + (float(i) + jitter) * segLen;
        vec3  p = obsPos + t * dir;
        float h = length(p) - R_EARTH;
        if (h < shellBAlt || h > shellTAlt) continue;
        float hNorm = (h - shellBAlt) / kCirrusThicknessM;

        vec3  pECEF = p.x * enuX + p.y * enuY + p.z * enuZ;
        float pLen  = length(pECEF);
        float pLon  = atan(pECEF.y, pECEF.x);
        float pLat  = asin(clamp(pECEF.z / pLen, -1.0, 1.0));
        vec2  pUV   = vec2(fract((pLon + PI) / (2.0*PI)
                                 + cloud.cloudPhase * cloud.layers[1].driftMult / (2.0*PI)),
                           (0.5*PI - pLat) / PI);
        float localCov = cloud.coverage * cloud.layers[1].coverageMult
                        * textureLod(earthCloudsTex, pUV, cloud.layers[1].mipLod).r;
        if (localCov < 0.02) continue;

        vec3 dirECEF      = pECEF / pLen;
        vec3 dirECEFDrift = rotateZ(dirECEF, cloud.cloudPhase * cloud.layers[1].driftMult);
        float wa       = cloud.cirrusWindAngle + cirrusWindAngleAt(dirECEFDrift);
        vec3  windAxis = vec3(cos(wa), sin(wa), 0.0);
        vec3 dirStretched = dirECEFDrift
                           + windAxis * dot(dirECEFDrift, windAxis) * (invStretch - 1.0);

        float hFade = smoothstep(0.0, 0.15, hNorm) * (1.0 - smoothstep(0.85, 1.0, hNorm));
        vec3  uvwXY     = dirStretched * kCloudHorizFreq * kCirrusFreqScale
                        + cirrusDomainWarp(dirECEFDrift);
        vec3  uvwDetail = uvwXY + vec3(0.0, 0.0, hNorm * 1.5);
        float d = cloudDensity(uvwXY, uvwDetail, hNorm, localCov,
                                cloud.density * cloud.layers[1].densityMult, hFade);
        if (d < 0.001) continue;

        float extinction = d * segLen * 8e-5;
        vec3  stepT = exp(-vec3(extinction));

        float cloudSunDot  = dot(normalize(pECEF), sunDirECEF);
        float cloudDayFrac = smoothstep(-0.1, 0.15, cloudSunDot);
        // See cloudMarchCS's sunGainCurve comment — same horizon/zenith blend, same rationale.
        float sunGainCurveCirrus = mix(cloud.sunGain, cloud.sunGainZenith,
                                        smoothstep(0.0, 1.0, clamp(cloudSunDot, 0.0, 1.0)));
        vec3  inScatter     = vec3(max(0.0, cloudSunDot + 0.1) * sunGainCurveCirrus) * cloudDayFrac * ph * 2.0;

        cirrusScatter       += cirrusTransmittance * (1.0 - stepT) * inScatter;
        cirrusTransmittance *= stepT;
        if (cirrusTransmittance.r < 0.02) break;
    }

    vec2 odAtmCirrus = optDepth(obsPos, dir, tEnter);
    vec3 cirrusAttn  = exp(-(BETA_R * odAtmCirrus.x + BETA_M * 1.1 * odAtmCirrus.y));
    vec3 cirrusT     = mix(vec3(1.0), cirrusTransmittance, cirrusAltFade);
    A_cirrus = vec3(1.0) - cirrusAttn * (1.0 - cirrusT);
    B_cirrus = cirrusAttn * cirrusScatter * cirrusAltFade;
}

void main() {
    ivec2 size  = imageSize(targetA);
    ivec2 coord = ivec2(gl_GlobalInvocationID.xy);
    if (coord.x >= size.x || coord.y >= size.y) return;

    // Reconstruct the same view ray sat_sky.vert/sat_sky.frag build, evaluated directly at this
    // half-res texel instead of via vertex interpolation — identical affine transform, just
    // sampled at a coarser grid.
    vec2 uv  = (vec2(coord) + 0.5) / vec2(size);
    vec2 ndc = uv * 2.0 - 1.0;
    float tanHalfFov = tan(pc.fovYRad * 0.5);
    vec3  camDir = vec3(ndc.x * tanHalfFov * pc.aspect, -ndc.y * tanHalfFov, -1.0);
    vec3  dir    = normalize(mat3(transpose(pc.skyView)) * camDir);
    vec3  sunDir = normalize(pc.sunDirENU.xyz);

    vec3 enuZ = normalize(pc.obsECEFDir.xyz);
    vec3 enuX = normalize(cross(vec3(0.0, 0.0, 1.0), enuZ));
    vec3 enuY = cross(enuZ, enuX);
    vec3 sunDirECEF = sunDir.x * enuX + sunDir.y * enuY + sunDir.z * enuZ;

    vec3 obsPos = vec3(0.0, 0.0, R_EARTH + pc.obsEffH + 2.0);

    vec3  A_cirrus, B_cirrus;
    float tEnterCirrus;
    cirrusMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, pc.obsEffH,
                  A_cirrus, B_cirrus, tEnterCirrus);

    vec3  A_cloud, B_cloud, cloudTOut;
    float tCloudOcclude, tEnterCloud;
    cloudMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, pc.obsEffH, pc.moonDirENU,
                 A_cloud, B_cloud, cloudTOut, tCloudOcclude, tEnterCloud);

    vec3  A_total = A_cirrus * A_cloud;
    vec3  B_total = B_cirrus * A_cloud + B_cloud;

    // Aurora sky curtain (moved here this session — perf: half-res instead of full-res).
    // Cloud suppression uses the LOCAL A_total already computed above — more accurate than
    // sat_sky.frag's old "early" texture pre-sample, which only existed because that shader runs
    // at full-res and needed a cheap same-frame proxy; this compute shader has the real value on
    // hand already. Folding the result directly into B_total means it inherits the same terrain-
    // occlusion handling sat_sky.frag already applies to the whole composite (a behavior change
    // from before, when aurora ignored terrain occlusion entirely — this is more physically
    // correct: terrain that blocks the view of the much-closer cloud layer necessarily blocks the
    // far higher aurora shell along that same ray too).
    vec3 auroraContrib = ((pc.debugDisableMask & 32u) != 0u)
        ? vec3(0.0)
        : auroraMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDir, sunDirECEF, pc.obsEffH, pc.moonDirENU);
    if (dot(auroraContrib, auroraContrib) > 0.0) {
        bool  auroraBehindClouds = (pc.obsEffH < kAuroraShellInnerM);
        float cloudBlockLocal    = dot(A_total, vec3(1.0 / 3.0));
        const float kAuroraCloudSuppressPower = 3.0;
        float auroraCloudSuppress = auroraBehindClouds
            ? pow(clamp(cloudBlockLocal, 0.0, 1.0), kAuroraCloudSuppressPower)
            : 1.0;
        B_total += auroraContrib * auroraCloudSuppress;
    }

    // Airglow red band (moved here this session — perf). No cloud-suppression term — the
    // original never had one either, just a plain additive contribution.
    if ((pc.debugDisableMask & 16u) == 0u) {
        B_total += airglowRedMarchCS(obsPos, dir, enuX, enuY, enuZ, sunDirECEF, pc.obsEffH);
    }

    // Nearer of the two layers' entry distances — always valid whenever either layer actually
    // rendered something, unlike tCloudOcclude (opacity-gated). Used by sat_sky.frag for terrain
    // suppression: if terrain sits closer than this, the WHOLE combined contribution is hidden
    // (both layers can't be independently suppressed once merged into one target — an accepted
    // approximation for the rarer case where terrain sits geometrically between the two shells).
    float tEnterCombined;
    if (tEnterCirrus < 0.0) tEnterCombined = tEnterCloud;
    else if (tEnterCloud < 0.0) tEnterCombined = tEnterCirrus;
    else tEnterCombined = min(tEnterCirrus, tEnterCloud);

    imageStore(targetA, coord, vec4(B_total, tCloudOcclude));
    imageStore(targetB, coord, vec4(A_total, tEnterCombined));
}
