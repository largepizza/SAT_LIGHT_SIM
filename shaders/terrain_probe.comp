#version 450
#extension GL_EXT_control_flow_attributes : require // [[dont_unroll]] in terrain_detail.glsl

// ── Harness terrain probe (docs/HARNESS.md `probe`) ───────────────────────────────────────────────
// One thread. Re-runs the terrain algorithm for ONE full-resolution pixel's view ray with the very
// functions sat_sky.frag and scene_depth.comp use (terrain_detail.glsl) and writes what happened:
// the seed from the shared depth, the seeded and unseeded march results and step counts, the DEM /
// detail at the hit, and a 64-sample height profile along the ray. Dispatched only on request, after
// scene_depth.comp. The point is to answer "why does this pixel look like that" with numbers.

layout(local_size_x = 1) in;

layout(push_constant) uniform PC {
    mat4 skyView;      // ENU -> camera space (the sky pass's)
    vec4 cam;          // x = fovY (rad), y = aspect, zw = probe pixel (full-res, top-left origin)
    vec4 screen;       // xy = full-res screen size
    vec4 obsECEFDir;   // as everywhere
} pc;

layout(set = 0, binding = 0) uniform sampler2D earthElevTex;
layout(set = 0, binding = 1) uniform sampler2D earthSpecTex;
#define CLOUD_PARAMS_BINDING 2
#include "cloud_params.glsl"
layout(set = 0, binding = 3) uniform sampler2D sceneDepthTex;
layout(set = 0, binding = 4, std430) writeonly buffer ProbeOut {
    vec4 a[8];
    vec4 profile[64];
} outp;

#include "common.glsl"
#include "terrain.glsl"
#include "terrain_detail.glsl"

void main() {
    vec2  px  = pc.cam.zw + 0.5;
    vec2  ndc = px / pc.screen.xy * 2.0 - 1.0;
    float tanHalfFov = tan(pc.cam.x * 0.5);
    vec3  camDir = vec3(ndc.x * tanHalfFov * pc.cam.y, -ndc.y * tanHalfFov, -1.0);
    vec3  dir    = normalize(mat3(transpose(pc.skyView)) * camDir);

    vec3 enuX, enuY, enuZ;
    enuBasis(pc.obsECEFDir.xyz, enuX, enuY, enuZ);
    float obsEffH = observerEffHeightDetailed(earthElevTex, earthSpecTex, pc.obsECEFDir);
    vec3  obsPos  = observerPos(obsEffH);
    vec2  tBase   = raySphere(obsPos, dir, R_EARTH);
    vec2  tShell  = raySphere(obsPos, dir, R_EARTH + kMaxTerrain);
    float tExit   = (tBase.x > 0.0) ? tBase.x : (tShell.y > 0.0 ? tShell.y : 0.0);
    float tCap    = mix(250000.0, 3600000.0, clamp(obsEffH / 400000.0, 0.0, 1.0));
    tExit = min(tExit, tCap);
    float pixAngle = pc.cam.x / pc.screen.y;
    float hEye = obsEffH + 2.0;

    // The seed exactly as sat_sky.frag forms it (2x2 half-res texels around the pixel).
    ivec2 dSize = textureSize(sceneDepthTex, 0);
    vec2  dp    = px / pc.screen.xy * vec2(dSize) - 0.5;
    ivec2 d0    = ivec2(floor(dp));
    float dMin  = kNoSurfaceT;
    for (int sy = 0; sy <= 1; ++sy)
        for (int sx = 0; sx <= 1; ++sx)
            dMin = min(dMin, texelFetch(sceneDepthTex, clamp(d0 + ivec2(sx, sy), ivec2(0), dSize - 1), 0).r);
    bool  seedSky = dMin >= kNoSurfaceT * 0.5;
    float tSeed   = max(2.0, dMin * 0.995 - 0.5); // as sat_sky.frag

    bool gate = dir.z < 0.7 && tShell.y > 0.0 && tExit < cloud.terrainDistFadeEndM;
    int stepsSeed = 0, stepsEye = 0;
    float tHitSeed = -1.0, tHitEye = -1.0;
    if (gate) {
        if (!seedSky)
            tHitSeed = terrainMarchDetailed(earthElevTex, earthSpecTex, hEye, dir, enuX, enuY, enuZ,
                                            tSeed, tExit, pixAngle, 224, 1.0, false, kTdCoarseOctaves, stepsSeed);
        tHitEye = terrainMarchDetailed(earthElevTex, earthSpecTex, hEye, dir, enuX, enuY, enuZ,
                                       2.0, tExit, pixAngle, 224, 1.0, false, kTdCoarseOctaves, stepsEye);
    }

    outp.a[0] = vec4(obsEffH, tExit, dMin, seedSky ? 1.0 : 0.0);
    outp.a[1] = vec4(tHitSeed, float(stepsSeed), tHitEye, float(stepsEye));
    outp.a[2] = vec4(dir, pixAngle);
    outp.a[5] = vec4(tBase, tShell);
    float tH = tHitSeed > 0.0 ? tHitSeed : tHitEye;
    if (tH > 0.0) {
        vec3  q = vec3(0.0, 0.0, hEye) + tH * dir;
        float h0, hMip3;
        vec2  uv = tdUV(q, enuX, enuY, enuZ);
        tdDemAt(earthElevTex, earthSpecTex, q, enuX, enuY, enuZ, h0, hMip3);
        TdSample d = terrainDetail(earthElevTex, q, enuX, enuY, enuZ, tdGeomLodM(tH, pixAngle), h0, hMip3, kTdOctaves);
        outp.a[3] = vec4(h0, hMip3, d.h, d.amp);
        outp.a[4] = vec4(d.rough, tdAltitude(q), 90.0 - uv.y * 180.0, uv.x * 360.0 - 180.0);
    } else {
        outp.a[3] = vec4(0.0);
        outp.a[4] = vec4(0.0);
    }
    outp.a[6] = vec4(gate ? 1.0 : 0.0, tSeed, 0.0, 0.0);
    outp.a[7] = vec4(0.0);

    // Height profile along the ray, geometric in t from 2 m to tExit (or 250 km if the gate failed).
    float tEnd = max(tExit, 10.0);
    for (int i = 0; i < 64; ++i) {
        float t = 2.0 * pow(tEnd / 2.0, float(i) / 63.0);
        vec3  q = vec3(0.0, 0.0, hEye) + t * dir;
        float h0, hMip3;
        tdDemAt(earthElevTex, earthSpecTex, q, enuX, enuY, enuZ, h0, hMip3);
        float H = tdEnabled() ? h0 + terrainDetail(earthElevTex, q, enuX, enuY, enuZ, tdGeomLodM(t, pixAngle), h0, hMip3, kTdOctaves).h : h0;
        outp.profile[i] = vec4(t, tdAltitude(q), h0, H);
    }
}
