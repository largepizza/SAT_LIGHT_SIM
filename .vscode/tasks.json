{
    "version": "2.0.0",
    "tasks": [
        {
            // Default build (Ctrl+Shift+B). Uses the CMake Tools-managed build/ directory,
            // so it matches whatever configuration the status bar shows.
            "label": "CMake: Build Release",
            "type": "shell",
            "command": "cmake --build build --config Release",
            "group": { "kind": "build", "isDefault": true },
            "presentation": { "reveal": "always" }
        },
        {
            // Start the exe already in build/Release (the tree the harness builds), no build.
            // Every dev tree shares user_data/, so the settings are the same either way.
            "label": "Run build/Release (no build)",
            "type": "shell",
            "command": "python tools/run_latest.py",
            "problemMatcher": [],
            "presentation": { "reveal": "silent" }
        },
        {
            // Build build/Release, then start it.
            "label": "Build Release + run",
            "dependsOn": ["CMake: Build Release", "Run build/Release (no build)"],
            "dependsOrder": "sequence",
            "problemMatcher": []
        },
        {
            // Fresh-settings variant: same binary compiled with SAT_FRESH_SETTINGS, so it never
            // reads or writes settings.json. EXCLUDE_FROM_ALL, so it is only built by this task
            // (or by launching the "FRESH" debug configs, which run it as their preLaunchTask).
            "label": "CMake: Build Fresh (no settings.json)",
            "type": "shell",
            "command": "cmake --build build --target SatLightSimFresh",
            "problemMatcher": ["$msCompile"],
            "presentation": { "reveal": "always" }
        },
        {
            // Full release build + dist/ archive, via the presets in CMakePresets.json.
            // Same target CI runs, so a local archive matches a tagged one byte-for-byte
            // in layout. Windows preset shown; swap for linux-* / macos-* on those hosts.
            "label": "CMake: Package Release (Windows)",
            "type": "shell",
            "command": "cmake --preset windows-release && cmake --build --preset windows-package",
            "problemMatcher": [],
            "presentation": { "reveal": "always" }
        }
    ]
}
