    "sources": [
        {
            "status": "estimate",
            "value": "core 7 m wide, 9 m tall (height an estimate), a zenith airlock",
            "source": "Wikipedia 'Haven-2': first module stretched from Haven-1's 10.1 m to 16 m (4.4 m wide), more modules 2029-30, a 7 m core module (Starship) with a fifth port and an airlock, complete 2032; each module two 1.1 m Earth-facing windows; vastspace.com Haven-2 concept art (May 2025): modules docked radially to the core in a cross, each with its own pair of wings, radiators on the core",
            "subjects": [
                "haven2_core",
                "core_airlock",
                "haven2_core_seg0",
                "haven2_core_seg1",
                "haven2_core_seg3",
                "haven2_core_seg4"
            ]
        },
        {
            "status": "sourced",
            "value": "four 16 x 4.4 m modules docked radially to the core",
            "source": "Wikipedia 'Haven-2': first module stretched from Haven-1's 10.1 m to 16 m (4.4 m wide), more modules 2029-30, a 7 m core module (Starship) with a fifth port and an airlock, complete 2032; each module two 1.1 m Earth-facing windows; vastspace.com Haven-2 concept art (May 2025): modules docked radially to the core in a cross, each with its own pair of wings, radiators on the core",
            "subjects": [
