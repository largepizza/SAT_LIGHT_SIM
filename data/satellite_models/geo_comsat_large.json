  {
   "subject": "bus",
   "status": "derived",
   "value": "2.8 x 2.6 x 4.2 m box (E-W x N-S x nadir), gold MLI",
   "source": "SSL-1300 (Maxar): 'body 2.4 x 2.6 x 5.4 m stowed'-class figures; Eurostar E3000: 2.4 x 2.9 x 5.8 m launch configuration; Boeing 702HP similar (manufacturers' brochures as summarised by Gunter's Space Page). The on-orbit box (stowed reflectors and the launch adapter excluded) derived from those."
  },
  {
   "subjects": [
    "radiator_south",
    "radiator_north"
   ],
   "status": "sourced",
   "value": "OSR radiator panels over the whole north and south faces (5 cm off them: a full cover keeps the MLI face under it from being a sliver lobe)",
   "source": "Standard three-axis GEO comsat thermal design: the N/S faces, which see the Sun only at a grazing angle all year, carry the optical solar reflector radiators (e.g. Gilmore, Spacecraft Thermal Control Handbook, ch. on communications satellites)."
  },
  {
   "subjects": [
    "wing_south",
    "wing_north"
   ],
   "status": "estimate",
   "value": "two wings of 5 panels 2.6 x 3.4 m on 2.5 m yokes: 41.6 m tip to tip",
   "source": "Large GEO comsats of 15-20 kW span ~40-48 m tip to tip (e.g. Intelsat 29e 37.5 m, ViaSat-2 ~45 m, Astra 2E ~40 m: Gunter's Space Page); 5 panels per wing an estimate."
  },
  {
   "subject": "wings",
   "status": "sourced",
   "value": "wings turn about the N-S axis to face the Sun (one turn a day)",
   "source": "The universal GEO comsat solar array drive (SADA) arrangement: arrays on the north and south faces rotating once per day about the pitch (orbit-normal) axis."
  },
  {
   "subject": "bus",
   "status": "sourced",
   "value": "three-axis stabilised, Earth deck to nadir, yaw along velocity",
   "source": "Standard GEO comsat attitude (Earth-pointing, zero-momentum or momentum-bias)."
  },
  {
   "subjects": [
    "reflector_east",
    "reflector_west",
    "reflector_deck"
   ],
   "status": "estimate",
   "value": "deployed reflectors 2.8 m on the E/W faces (22 deg off nadir), a 1.2 m dish on the Earth deck",
   "source": "Most large comsats carry two 2.3-3 m deployed reflectors on the east/west faces plus an Earth-deck antenna (factory photographs); exact counts and sizes vary by satellite - estimates."
  },
