 "sources": [
  {
   "subject": "bus",
   "status": "derived",
   "value": "2.0 x 1.9 x 3.2 m box (E-W x N-S x nadir), gold MLI",
   "source": "Orbital ATK GEOStar-2: 1.7 x 1.7 x 3.0 m bus; Lockheed A2100A: ~2 x 2 x 3 m; CAST DFH-4: 2.36 x 2.1 x 3.6 m (manufacturers' figures via Gunter's Space Page). The box is their middle."
  },
  {
   "subjects": [
    "radiator_south",
    "radiator_north"
   ],
   "status": "sourced",
   "value": "OSR radiator panels over the whole north and south faces (5 cm off them: a full cover keeps the MLI face under it from being a sliver lobe)",
   "source": "Standard three-axis GEO comsat thermal design: the N/S faces, which see the Sun only at a grazing angle all year, carry the optical solar reflector radiators (e.g. Gilmore, Spacecraft Thermal Control Handbook, ch. on communications satellites)."
  },
  {
   "subjects": [
    "wing_south",
    "wing_north"
   ],
   "status": "estimate",
   "value": "two wings of 3 panels 2.0 x 2.6 m on 1.6 m yokes: 20.7 m tip to tip",
   "source": "Mid-size GEO comsats span ~20-30 m (Star-2 ~20 m, A2100 ~26 m); 3 panels per wing an estimate."
  },
  {
   "subject": "wings",
   "status": "sourced",
   "value": "wings turn about the N-S axis to face the Sun (one turn a day)",
   "source": "The universal GEO comsat solar array drive (SADA) arrangement: arrays on the north and south faces rotating once per day about the pitch (orbit-normal) axis."
  },
  {
   "subject": "bus",
   "status": "sourced",
   "value": "three-axis stabilised, Earth deck to nadir, yaw along velocity",
   "source": "Standard GEO comsat attitude (Earth-pointing, zero-momentum or momentum-bias)."
  },
  {
   "subjects": [
    "reflector_east",
    "reflector_west",
    "reflector_deck"
   ],
   "status": "estimate",
   "value": "deployed reflectors 2.2 m on the E/W faces (22 deg off nadir), a 0.9 m dish on the Earth deck",
   "source": "Two ~2.2 m deployed reflectors on the E/W faces (factory photographs of the class); estimates."
  },
  {
   "subjects": [
    "bus_mli",
    "radiator",
    "reflector",
    "cells",
    "cells_back",
    "metal",
    "dark"
   ],
   "status": "estimate",
   "value": "class liveries and the presets' reflectance",
   "source": "Liveries from published on-orbit / factory photographs of the classes (gold or amber MLI on the bus, silver OSR radiator panels on the north and south faces, white-painted reflectors, blue-black cells under cover glass); reflectance from the presets."
  }
