    "sources": [
        {
            "subject": "bus",
            "status": "sourced",
            "value": "3 x 1 x 1 m box, nadir-pointing along velocity",
            "source": "China in Space, 'How Large Are GuoWang's Mega-Constellation Satellites?' and KeepTrack, 'Guowang's First Ten': a box body 'roughly 3 meters long by 1 meter wide with a 10-meter wingspan', two deployable solar panels, ~700-800 kg. Height and yaw: estimates."
        },
        {
            "subject": "phased_array",
            "status": "estimate",
            "value": "a 2.8 x 0.9 m phased-array panel under a light radome on the nadir face (white paint, albedo 0.55: a dark panel there read 0.85 mag fainter than the MLI face it covers, and the model is already 1.6 mag too faint)",
            "source": "Broadband user links; not published (as the Qianfan and Starlink flat panels)."
        },
        {
            "subjects": [
                "array_left",
                "array_right"
            ],
            "status": "derived",
            "value": "two wings of two 2.8 x 2.1 m panels (2.8 x 4.2 m each), 0.3 m yokes, 10.6 m tip to tip, on the zenith side of the bus's flanks",
            "source": "China in Space, 'How Large Are GuoWang's Mega-Constellation Satellites?' and KeepTrack, 'Guowang's First Ten': a box body 'roughly 3 meters long by 1 meter wide with a 10-meter wingspan', two deployable solar panels, ~700-800 kg. Length DERIVED from the span; width ~ the 3 m body; two panels per wing an estimate."
        },
        {
            "subject": "wings",
