 "sources": [
  {
   "subject": "bus",
   "status": "derived",
   "value": "2.6 x 2.5 x 3.6 m box, MLI",
   "source": "GOES-R series (Lockheed Martin A2100A): 6.1 x 5.6 x 3.9 m including instruments, dry mass 2857 kg (NOAA/NASA GOES-R Data Book, 2019); the bus box derived from that envelope."
  },
  {
   "subject": "wing",
   "status": "estimate",
   "value": "one wing 3.6 x 10.0 m (5 panels) on a 1.5 m yoke",
   "source": "GOES-R, Himawari-8/9 (DS2000) and MTG carry ONE solar wing (Data Books / JMA and EUMETSAT fact sheets); GOES-R's array ~4 kW EOL - the panel size is an estimate from that."
  },
  {
   "subject": "wings",
   "status": "sourced",
   "value": "the wing turns about the N-S axis to face the Sun",
   "source": "GOES-R Data Book: solar array drive rotating once per day."
  },
  {
   "subjects": [
    "radiator_north",
    "imager"
   ],
   "status": "estimate",
   "value": "OSR radiator on the north face; the imager (1.6 x 1.2 x 1.0 m, radiator-white) on the Earth deck",
   "source": "GOES-R Data Book (ABI on the Earth-pointing platform, radiators on the anti-Sun side); sizes estimated from the ABI's published 2 x 1.2 x 1 m envelope."
  },
  {
   "subject": "dish",
   "status": "estimate",
   "value": "a 1.2 m data-relay dish on the Earth deck",
   "source": "GOES-R GRB / DCS antennas on the Earth deck; size an estimate."
  },
  {
   "subject": "bus",
   "status": "sourced",
   "value": "three-axis, Earth deck to nadir",
   "source": "GOES-R Data Book."
