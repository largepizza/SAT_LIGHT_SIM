# Defaults A/B (2026-10-20): run fresh (first-run preset seed) and with --settings <the user's settings>.
get display
state preset_check
time pause
observer lat=8.5 lon=-63.5 agl=1500
time set 2036-11-22T15:00:00Z
time pause
camera az=90 el=8 fov=70
wait settle
wait 60
capture cumulus_day
observer lat=36.27 lon=-121.81 alt=40
time sun 1 setting
time pause
camera az=255 el=1 fov=70
wait settle
wait 60
capture sunset_ocean
observer lat=30 lon=-90 alt=420000
time sun 25 rising
time pause
camera az=0 el=-55 fov=70
wait settle
wait 120
capture orbit
observer lat=34.05 lon=-118.25 agl=2500
time sun -25 setting
time pause
camera az=200 el=-12 fov=70
wait settle
wait 60
capture night_city
quit
