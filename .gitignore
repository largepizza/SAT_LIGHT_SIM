# ── Build output ──────────────────────────────────────────────────────────────
build/
build-linux/
out/
dist/
build-win-release/
build-win-ci/
build-linux-release/
build-macos-release/
.logs/

# Per-developer CMake configuration (SDK paths, generator choice, toolchain overrides).
# This is where machine-specific values belong — CMakePresets.json is committed and must
# stay path-free; CMakeUserPresets.json is not and can hold anything local.
CMakeUserPresets.json


# ── Compiled shaders (generated at build time from shaders/) ─────────────────
*.spv

# ── VS Code local state (workspace config is kept, local state is not) ────────
.vscode/*.log

# ── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Compiler artifacts ────────────────────────────────────────────────────────
*.obj
*.ilk
*.pdb
*.exe
*.lib
*.dll

# - Debug
.renderDoc_captures/
.claude
.plans

# ── GPU capture / benchmark scratch (kept in-repo, never committed) ───────────
# Anchored to the repo root: data/benchmarks/ (published photometry datasets) IS tracked.
/benchmarks/
# SatModelTool --run-benchmark reports (default --report-dir); results worth keeping go in the design page log.
/benchmark_runs/

# ── Python tooling (tools/perf_analysis, etc.) ─────────────────────────────────
.venv/
__pycache__/
*.pyc
# Stray run logs from manual launches
ft_slow.log
satlight_log.txt

# ── Automation harness output (docs/HARNESS.md) ───────────────────────────────
/harness_runs/
/harness_live/
/tools/harness/iclg/
