# The FPS camera mode (2026-11-16, SatelliteSimFps.cpp). Run with the old key layout's settings:
#   python tools/harness/run.py tools/harness/scripts/fps_mode.satcmd --settings tools/harness/scripts/fps_mode_old_keys.json
# Read: python tools/harness/res.py <run> -c fps -g fps.mode -g fps.last_change ...; res.py <run> -c mouse
#   0  key layout 3 -> 4: Tab on Toggle UI moves to U, Toggle Cursor gets Tab (get controls)
#   1  a harness run starts in menu mode; Tab toggles; `mouse move` turns 0.12 deg/px in FPS mode, nothing in menu mode
#   2  a right click leaves FPS mode without turning the camera or holding a right-drag
#   3  Tab with a text field focused commits the field and leaves the mode alone
#   4  a window hotkey (M, Missions) from FPS mode lands in menu mode
#   5  sensitivity 2 doubles the turn
#   6  the centre click: aimed at a satellite it selects it and stays FPS; empty sky selects nothing
#   7  the ring: 0.6 s + 1 s per click, at most 4 s, then a 0.3 s fade; a ui=on crop of it
time set 2036-11-22T02:06:22Z
time pause
camera az=0 el=30 fov=70
wait 5
get controls
expect state.camera.fps_mode false
fps state
# 1
mouse move dx=10 dy=0 frames=10
ui key tab
fps state
wait 3
mouse move dx=10 dy=0 frames=10
mouse move dx=0 dy=-5 frames=10
# 2
mouse click right
fps state
mouse move dx=10 dy=0 frames=10
# 3
ui open settings tab=Controls
wait 3
ui click SettingsSearch
ui key tab
fps state
ui close all
wait 3
# 4
ui key tab
wait 3
ui key m
fps state
ui close all
wait 3
# 5
set controls.mouse_sensitivity 2
ui key tab
wait 3
mouse move dx=10 dy=0 frames=10
set controls.mouse_sensitivity 1
# 6 (a sunlit Starlink: Los Angeles, the Sun 10 deg below the horizon)
observer lat=34 lon=-118 agl=10
time sun -10 setting
time pause
wait 5
select const "Starlink Gen1"
camera look sel
wait 5
select none
mouse click left
fps state
camera az=123 el=60 fov=2
wait 5
mouse click left
fps state
# 7
camera az=0 el=30 fov=70
wait 300 maxs=0
fps state
mouse click left
fps state
capture ring ui=on crop=720,370,160,160 scale=2
mouse click left
mouse click left
mouse click left
mouse click left
fps state
wait 120 maxs=0
fps state
wait 120 maxs=0
fps state
wait 10 maxs=0
fps state
wait 20 maxs=0
fps state
fps off
state
