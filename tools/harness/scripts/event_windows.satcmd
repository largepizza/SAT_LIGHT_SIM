# The event windows and the explode warning (2026-11-17, SatelliteSimEventWindows.cpp; docs/subsystems/sky-events.md
# "Event windows", kessler.md "The explode warning"). One launch, 20 sim steps / s:
#   python tools/harness/run.py tools/harness/scripts/event_windows.satcmd --fixed-dt 0.05 --quiet --timeout 600
# (~5 min with a current prebake, 2026-11-18: about half of it the 1100-day prebake replay in section 7)
# Read: res.py <run> --errors (the expects); res.py <run> -c events -g events_state.log -g events_state.id
#       res.py <run> -c "events list" -g events; tools/harness/ui_lowres.py check <run> (the ev_* dumps)
#   1  off in a harness run until `events on`; `events list` = the table with every moment
#   2  the running clock crosses the comet's perihelion + 6 h FORWARD at 1 h/s: its window, the clock paused at the
#      moment; `events ack` = 1x, running
#   3  the same moment crossed BACKWARD (reverse, 1 h/s): nothing, the clock runs on back at 1 h/s; forward again
#      through it: its window once (2026-11-18, issue_20261118_181440: a backward card resumed forward, so a rewind
#      could never get past the moment)
#   4  the clock SET past it (running and paused): nothing
#   5  a Watch (the 2037-01-31 total lunar eclipse): its window
#   6  every window fired at 1024x768 and 1600x900: dumps (ui_lowres check) and captures (the contact sheet)
#   7  the Sun's Fury crossed forward at 1 d/s (30 min after a `time set`: the first frame after a set counts); then
#      1 w/s on: the first collision, then every window acknowledged as it comes (10%: read the log); the share
#      destroyed sampled at later dates (`events state` -> destroyed_share)
#   8  Explode before the Fury: the warning; No leaves the satellite; PRAISE BE TO THE SUN lands at the Fury (its
#      window); Yes breaks it up; a second Explode after it: no warning
# Waits are frames at 0.05 s each.
time set 2037-01-10T00:00:00Z
time pause
observer lat=-31 lon=24 agl=2
camera az=90 el=20 fov=70
wait 5
expect state.events.live false
events on
expect state.events.live true
wait 10
events list

# -- 2 forward --
time set 2037-02-17T22:00:00Z
time scale 1h
time play
wait 30 maxs=0
expect state.events.open true
expect state.events.id comet_perihelion
expect state.events.time_paused true
expect state.events.time_scale 1x
events state
capture ev_cross_fwd ui=on scale=0.5
events ack
expect state.events.open false
expect state.events.time_scale 1x
expect state.events.time_paused false

# -- 3 backward --
# (2 h back at 1 h/s = 40 frames, from 1 h 40 min past the moment: ends 20 min before it)
time pause
time set 2037-02-17T23:40:00Z
time scale 1h
time reverse on
time play
wait 40 maxs=0
expect state.events.open false
expect state.events.time_reverse true
expect state.events.time_scale 1h
expect state.events.time_paused false
events state
# (forward again from there, without a set: the running clock meets it, once)
time reverse off
wait 30 maxs=0
expect state.events.open true
expect state.events.id comet_perihelion
expect state.events.how "crossed forward"
expect state.events.clock_from_moment_s 0 tol=0.01
events state
events ack
expect state.events.time_scale 1x
expect state.events.time_reverse false
wait 20 maxs=0
expect state.events.open false

# -- 4 set past --
time set 2037-02-17T22:00:00Z
wait 2
time set 2037-02-18T03:00:00Z
wait 10
expect state.events.open false
time pause
time set 2037-02-17T20:00:00Z
time set 2037-02-18T03:00:00Z
time play
wait 10
expect state.events.open false
events state

# -- 5 a Watch --
time pause
time set 2037-01-25T00:00:00Z
skyevents events
skyevents watch lunar
expect state.events.open true
expect state.events.id lunar_eclipse
events state
capture ev_watch_lunar ui=on scale=0.5
events ack
time pause

# -- 6 every window at 1024x768 --
window 1024x768
wait 10
events fire lunar_eclipse total=1
wait 3
ui dump 1024x768_ev_lunar_eclipse
capture 1024x768_ev_lunar_eclipse ui=on
events ack
time pause
events fire comet_inner_planets
wait 3
ui dump 1024x768_ev_comet_inner_planets
capture 1024x768_ev_comet_inner_planets ui=on
events ack
time pause
events fire comet_perihelion
wait 3
ui dump 1024x768_ev_comet_perihelion
capture 1024x768_ev_comet_perihelion ui=on
events ack
time pause
events fire comet_passes_earth
wait 3
ui dump 1024x768_ev_comet_passes_earth
capture 1024x768_ev_comet_passes_earth ui=on
events ack
time pause
events fire comet_meteor_storm
wait 3
ui dump 1024x768_ev_comet_meteor_storm
capture 1024x768_ev_comet_meteor_storm ui=on
events ack
time pause
events fire australasian_eclipse
wait 3
ui dump 1024x768_ev_australasian_eclipse
capture 1024x768_ev_australasian_eclipse ui=on
events ack
time pause
events fire suns_fury
wait 3
ui dump 1024x768_ev_suns_fury
capture 1024x768_ev_suns_fury ui=on
events ack
time pause
events fire first_collision
wait 3
ui dump 1024x768_ev_first_collision
capture 1024x768_ev_first_collision ui=on
events ack
time pause
events fire destroyed_10
wait 3
ui dump 1024x768_ev_destroyed_10
capture 1024x768_ev_destroyed_10 ui=on
events ack
time pause
events fire destroyed_50
wait 3
ui dump 1024x768_ev_destroyed_50
capture 1024x768_ev_destroyed_50 ui=on
events ack
time pause
events fire betelgeuse_explodes
wait 3
ui dump 1024x768_ev_betelgeuse_explodes
capture 1024x768_ev_betelgeuse_explodes ui=on
events ack
time pause
events fire betelgeuse_fades
wait 3
ui dump 1024x768_ev_betelgeuse_fades
capture 1024x768_ev_betelgeuse_fades ui=on
events ack
time pause
events fire explode_warning
wait 3
ui dump 1024x768_ev_explode_warning
capture 1024x768_ev_explode_warning ui=on
events ack choice=2
time pause

# -- 6 every window at 1600x900 --
window 1600x900
wait 10
events fire lunar_eclipse total=1
wait 3
ui dump 1600x900_ev_lunar_eclipse
capture 1600x900_ev_lunar_eclipse ui=on
events ack
time pause
events fire comet_inner_planets
wait 3
ui dump 1600x900_ev_comet_inner_planets
capture 1600x900_ev_comet_inner_planets ui=on
events ack
time pause
events fire comet_perihelion
wait 3
ui dump 1600x900_ev_comet_perihelion
capture 1600x900_ev_comet_perihelion ui=on
events ack
time pause
events fire comet_passes_earth
wait 3
ui dump 1600x900_ev_comet_passes_earth
capture 1600x900_ev_comet_passes_earth ui=on
events ack
time pause
events fire comet_meteor_storm
wait 3
ui dump 1600x900_ev_comet_meteor_storm
capture 1600x900_ev_comet_meteor_storm ui=on
events ack
time pause
events fire australasian_eclipse
wait 3
ui dump 1600x900_ev_australasian_eclipse
capture 1600x900_ev_australasian_eclipse ui=on
events ack
time pause
events fire suns_fury
wait 3
ui dump 1600x900_ev_suns_fury
capture 1600x900_ev_suns_fury ui=on
events ack
time pause
events fire first_collision
wait 3
ui dump 1600x900_ev_first_collision
capture 1600x900_ev_first_collision ui=on
events ack
time pause
events fire destroyed_10
wait 3
ui dump 1600x900_ev_destroyed_10
capture 1600x900_ev_destroyed_10 ui=on
events ack
time pause
events fire destroyed_50
wait 3
ui dump 1600x900_ev_destroyed_50
capture 1600x900_ev_destroyed_50 ui=on
events ack
time pause
events fire betelgeuse_explodes
wait 3
ui dump 1600x900_ev_betelgeuse_explodes
capture 1600x900_ev_betelgeuse_explodes ui=on
events ack
time pause
events fire betelgeuse_fades
wait 3
ui dump 1600x900_ev_betelgeuse_fades
capture 1600x900_ev_betelgeuse_fades ui=on
events ack
time pause
events fire explode_warning
wait 3
ui dump 1600x900_ev_explode_warning
capture 1600x900_ev_explode_warning ui=on
events ack choice=2
time pause

# -- 9 the card sets 1x; the clock at the event (2026-11-18) --
# The comet's perihelion + 6 h crossed forward at 1d / 1w / 1mo / 1yr: the window opens with the clock at the moment
# (+-1 ms) and the time bar at 1x forward; acknowledged by the real button (or `events ack`), 60 frames (3 s) later the
# clock is 3 s past the moment at 1x, and no second window has opened. A speed-up / reverse key while the card is up
# does not stick. Crossed BACKWARD at 1d / 1w / 1mo / 1yr: no window, the clock runs on back at the same rate (read
# `events state` -> clock_from_moment_s, well below 0; issue_20261118_181440). Then a queued pair (the comet passes the
# Earth, its meteor storm 1 s later), a Watch, and the Watch's landing rewound and run forward again (its window again).
time set 2037-02-17T18:00:00Z
time scale 1d
time reverse off
time play
wait 10 maxs=0
expect state.events.id comet_perihelion
expect state.events.clock_from_moment_s 0 tol=0.01
expect state.events.time_scale 1x
events state
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
expect state.events.clock_from_moment_s 3.05 tol=0.05
expect state.events.time_scale 1x
events state
time pause
time set 2037-02-17T00:00:00Z
time scale 1w
time play
wait 10 maxs=0
expect state.events.id comet_perihelion
expect state.events.clock_from_moment_s 0 tol=0.01
events state
events ack
wait 60 maxs=0
expect state.events.open false
expect state.events.clock_from_moment_s 3 tol=0.05
events state
time pause
time set 2037-02-10T00:00:00Z
time scale 1mo
time play
wait 10 maxs=0
expect state.events.id comet_perihelion
expect state.events.clock_from_moment_s 0 tol=0.01
ui key .
ui key .
ui key r
wait 2
expect state.events.open true
expect state.events.time_scale 1x
expect state.events.time_reverse false
events state
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
expect state.events.clock_from_moment_s 3.05 tol=0.05
expect state.events.time_scale 1x
expect state.events.time_reverse false
events state
time pause
time set 2037-02-01T00:00:00Z
time scale 1yr
time play
wait 10 maxs=0
expect state.events.id comet_perihelion
expect state.events.clock_from_moment_s 0 tol=0.01
events state
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
expect state.events.clock_from_moment_s 3.05 tol=0.05
events state
time pause
time set 2037-02-18T03:00:00Z
time scale 1d
time reverse on
time play
wait 40 maxs=0
expect state.events.open false
expect state.events.time_reverse true
expect state.events.time_scale 1d
expect state.events.time_paused false
events state
time pause
time set 2037-02-18T22:00:00Z
time scale 1w
time reverse on
time play
wait 20 maxs=0
expect state.events.open false
expect state.events.time_reverse true
expect state.events.time_scale 1w
events state
time pause
time set 2037-02-25T00:00:00Z
time scale 1mo
time reverse on
time play
wait 10 maxs=0
expect state.events.open false
expect state.events.time_reverse true
expect state.events.time_scale 1mo
events state
time pause
time set 2037-03-15T00:00:00Z
time scale 1yr
time reverse on
time play
wait 3 maxs=0
expect state.events.open false
expect state.events.time_reverse true
expect state.events.time_scale 1yr
events state
time pause
time reverse off
time set 2037-03-16T00:00:00Z
time scale 1w
time play
wait 10 maxs=0
expect state.events.id comet_passes_earth
expect state.events.queued 1
ui click EventWinBtn:0
wait 2
expect state.events.id comet_meteor_storm
expect state.events.how queued
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
events state
# (the pair again, the second rewound before its moment: shown with the clock 1 s before it, then rewound an hour
# and run forward through both: both windows again, the queued one too)
time pause
time set 2037-03-16T00:00:00Z
time scale 1w
time play
wait 10 maxs=0
expect state.events.id comet_passes_earth
ui click EventWinBtn:0
wait 2
expect state.events.id comet_meteor_storm
ui click EventWinBtn:0
time scale 1h
time reverse on
wait 20 maxs=0
expect state.events.open false
expect state.events.time_reverse true
# (forward at 1 d/s: at 1 h/s a whole number of frames from 1 s before the storm ends each frame between the two)
time scale 1d
time reverse off
wait 10 maxs=0
expect state.events.id comet_passes_earth
expect state.events.how "crossed forward"
expect state.events.queued 1
ui click EventWinBtn:0
wait 2
expect state.events.id comet_meteor_storm
ui click EventWinBtn:0
wait 30 maxs=0
expect state.events.open false
events state
time pause
time set 2037-01-25T00:00:00Z
time scale 1yr
skyevents events
skyevents watch lunar
expect state.events.id lunar_eclipse
expect state.events.time_scale 1x
wait 2
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
expect state.events.clock_from_moment_s 3.06 tol=0.05
events state
time pause

# -- 7 the Sun's Fury and the cascade (the prebake) --
# The shipped prebake must be this world's (2026-11-18, h01): a stale one computes the cascade live (~1 s a simulated
# day) and the 1100-day wait below sat 16 min. These fail in seconds instead (rebuild: tools/make_kessler_prebake.py).
kessler prebake require=1
expect state.kessler.cache_source prebake
kessler wait days=60
time pause
time set 2037-07-15T02:30:00Z
time scale 1d
time play
wait 20 maxs=0
expect state.events.open true
expect state.events.id suns_fury
events state
events ack
time scale 1w
wait 3
expect state.events.open true
expect state.events.id first_collision
events ack
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
time scale 1w
wait 40
events ack soft=1
events state
events list
time pause
# the share destroyed at later dates (the cascade replayed from the prebake: ~2 min for 1100 days, applies-bound,
# measured 2026-11-18; a stale prebake fails at the top of section 7 in seconds instead of computing it live for 16 min)
kessler wait days=1100 maxs=240
time set 2037-12-01T00:00:00Z
wait 20
events state
time set 2038-03-01T00:00:00Z
wait 20
events state
time set 2038-07-01T00:00:00Z
wait 20
events state
time set 2038-12-01T00:00:00Z
wait 20
events state
time set 2039-06-01T00:00:00Z
wait 20
events state
time set 2040-01-01T00:00:00Z
wait 20
events state
time set 2040-07-01T00:00:00Z
wait 20
events state

# -- 10 the shares at fast rates: the clock back to the share's own second (2026-11-18) --
# 1 mo/s from 2037-08-20: 10% opens with the clock at its second (the walk lags ~7 frames = ~10 days; it used to open
# there, 2037-09-22). Then 1 yr/s on from there (the baseline: 10%): the walk is still
# running when the clock meets Betelgeuse (12-25: its window first); the walk that ends under that window keeps its
# baseline (it used to take 68% as the new baseline: the 50% window never opened), so after it the next walk finds 50%
# passed and the clock goes back to its second; then at 1 mo/s through 12-25 again: Betelgeuse is not shown again.
time pause
time set 2037-08-20T00:00:00Z
# (back from 2040: the cascade is replayed from the prebake, from the next frame on, and the clock is held at its
# frontier: wait until it is past 10%)
wait 5 maxs=0
kessler wait days=70
time scale 1mo
time play
wait 40 maxs=0
expect state.events.id destroyed_10
expect state.events.how "share crossed"
expect state.events.clock_from_moment_s 0 tol=0.01
expect state.events.time_scale 1x
events state
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
expect state.events.time_scale 1x
events state
# (a step back past the Kessler mirror's kept history replays the cascade from the prebake, ~3 s, and the clock is held
# at the replay's frontier meanwhile: wait for it before running fast)
kessler wait days=170
time scale 1yr
wait 40 maxs=0
expect state.events.id betelgeuse_explodes
events state
ui click EventWinBtn:0
wait 30 maxs=0
expect state.events.id destroyed_50
expect state.events.how "share crossed"
expect state.events.clock_from_moment_s 0 tol=0.01
events state
ui click EventWinBtn:0
wait 60 maxs=0
expect state.events.open false
expect state.events.time_scale 1x
events state
kessler wait days=200
time scale 1mo
wait 60 maxs=0
expect state.events.open false
events state
events ack soft=1
time pause

# -- 8 the explode warning --
window 1600x900
time set 2037-07-01T06:00:00Z
wait 5
select const "Starlink Gen1"
ui open info
wait 10
expect state.events.warn_needed true
ui click InfoBreakBtn:0
wait 2
expect state.events.open true
expect state.events.id explode_warning
capture ev_warn ui=on scale=0.5
events ack choice=2
wait 2
expect state.events.open false
expect state.events.warn_needed true
kessler state
ui click InfoBreakBtn:0
wait 2
expect state.events.id explode_warning
events ack choice=3
wait 5
expect state.events.open true
expect state.events.id suns_fury
events state
events ack
time pause
time set 2037-07-01T06:00:00Z
wait 5
select const "Starlink Gen1"
wait 5
ui click InfoBreakBtn:0
wait 2
expect state.events.id explode_warning
events ack choice=1
wait 10
expect state.events.warn_needed false
kessler state
select const "Starlink Gen1" n=7
wait 5
ui click InfoBreakBtn:0
wait 10
expect state.events.open false
kessler state
events state
