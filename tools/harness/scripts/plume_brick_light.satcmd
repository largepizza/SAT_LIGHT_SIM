# Plume brick lighting (2026-11-15): issue_20261115_165031's view and a fresh twilight staging seen close (10 deg, 12 km,
# no weather clouds), bricks on / off, with timings. Variants: tools/harness/shader_variant.py custom --src
# shaders/plume_brick.comp --tag <v> -s 'const float kCarve  = 1.0;=>...', then 'shaders reload brick=shaders/v_<v>_plume_brick_comp.spv'.
report load "C:/Code/Shader_Fun/user_data/reports/issue_20261115_165031" shot=1 trail=off
time pause
wait 240 maxs=0
capture after_crop crop=330,220,700,340 scale=2
perf frames=120 name=v_on_r1
set launches.plume_bricks false
wait 240 maxs=0
perf frames=120 name=v_off_r1
set launches.plume_bricks true
wait 240 maxs=0
perf frames=120 name=v_on_r2
set launches.plume_bricks false
wait 240 maxs=0
perf frames=120 name=v_off_r2
set launches.plume_bricks true
launch next vehicle=starship when=twilight
set clouds_v2.coverage 0
observer lat=30.03 lon=-91.74 agl=12000
time add 230
time pause
launch look stage=1
camera fov=10
wait 240 maxs=0
capture close_after crop=400,150,800,600
perf frames=120 name=close_on_r1
set launches.plume_bricks false
wait 240 maxs=0
capture close_off crop=400,150,800,600
perf frames=120 name=close_off_r1
