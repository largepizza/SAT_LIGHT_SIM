# 2026-09-30 review 11: the night side from orbit (city lights vs the orbit grade / exposure) and the aurora's
# horizontal banding (sheets off = the volume alone, on, and a telephoto of the lower border).
preset High
set clouds_v2.fog_amount 0
# The night side at the sim's start (a thin Moon), Europe from 400 km and 2000 km.
time set 2036-06-21T00:00:00Z
time pause
observer lat=48 lon=6 alt=400000
time sun midnight
camera az=0 el=-55 fov=80
wait settle
state
capture n400_grade
set clouds.orbit_grade 0
wait settle
capture n400_nograde
set clouds.orbit_grade 1
camera az=0 el=-10 fov=90
wait settle
capture n400_limb
observer lat=48 lon=6 alt=2000000
camera az=0 el=-60 fov=70
wait settle
state
capture n2000_grade
set clouds.orbit_grade 0
wait settle
capture n2000_nograde
set clouds.orbit_grade 1
# Aurora from a dark site (Coldfoot), December midnight, storm.
set clouds_v2.coverage 0
set clouds.storm_strength 1
time set 2036-12-21T12:00:00Z
observer lat=67.25 lon=-150.18 agl=2
time sun midnight
camera az=0 el=20 fov=80
set clouds.aurora_sheets 0
wait settle
capture ab_volume
set clouds.aurora_sheets 1
wait settle
capture ab_sheets
camera az=0 el=12 fov=30
wait settle
capture ab_tele
set display.sky_taa false
wait settle
capture ab_tele_notaa
quit
