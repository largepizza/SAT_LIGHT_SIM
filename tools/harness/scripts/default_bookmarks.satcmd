# The default bookmarks that ship with the sim (data/bookmarks -> <exe dir>/default_bookmarks), rebuilt from scratch.
#   python tools/harness/run.py tools/harness/scripts/default_bookmarks.satcmd --out harness_runs/default_bookmarks
#   then copy harness_runs/default_bookmarks/bookmarks/* over data/bookmarks/ (bookmarks.json + one <id>.png each)
# A harness run starts from the compiled-in defaults (the shipped look), in its own user-data folder, so the list
# begins as the current defaults: `bookmark add ... id=` replaces each one. scale= / paused= are the bookmark's
# optional "look" (the clock a Go sets: 0 = 1x). Each view is settled before it is added; the thumbnail is the
# next clean frame (wait 5). Every bookmark stores the cloud map's drift: the Venezuela storm and the Antarctic
# snow need a set phase; the rest are framed with the compiled-in offset (`drift default`).
# The list (2026-10-06, the user's picks after playing the release candidate): six bookmarks, in this order.
window 1600x900
time pause

# 1. The 2037-07-13 total solar eclipse at greatest eclipse (the shadow axis, 21.75 S 138.31 E): the corona
#    and the darkened sky, at a 15-degree field.
time set 2037-07-10T00:00:00Z
eclipse solar
camera look sun
camera fov=15
wait settle
wait 30
bookmark add Great Australian Eclipse id=default_eclipse_solar_2037 scale=0 paused=0
wait 5

# 2. The 2037-01-31 total lunar eclipse (greatest ~13:59:48 UTC; totality ends ~14:32) from Anchorage, 60 m over
#    the city at 05:10 local time: the red Moon ~29 degrees up in the west-southwest over the city lights (the
#    user's framing: their "Blood Moon" bookmark from Fairbanks, az -116 el 21).
drift default
time set 2037-01-31T14:10:00Z
observer lat=61.22 lon=-149.9 agl=60
camera look moon
camera el=17 fov=45
wait settle
wait 30
bookmark add Blood Moon from Anchorage id=default_blood_moon_anchorage scale=0 paused=0
wait 5

# 3. Solar Storm: a G2 storm (Kp 6.8, `aurora next 6` from 2036-12-01) seen from 420 km over Siberia: the oval and
#    its red tops.
time set 2037-01-12T18:00:00Z
observer lat=62 lon=90 alt=420000
camera az=0 el=-18 fov=80
wait settle
wait 90
bookmark add Solar Storm id=default_aurora_orbit scale=0 paused=0
wait 5

# 4. McMurdo Station in mid-April twilight (the user's "Satbow over Antartica", 2026-10-06), standing in the Reflect
#    Orbital beams converging on the station under a snow shower at -23 C: the flakes glitter in the beams' light
#    around the line of mirrors. (The user saw a "satbow" behind the camera: the beams lit the snow shafts as RAIN,
#    fixed the same day - snow gives no bow.) Needs the snow's drift phase. Paused: the shower moves on.
time j2000 1176665048.767463
drift phase=1.5633554565141452 rate=0.000006499999926745659
observer lat=-77.8455147244164 lon=166.6428994442907 alt=383.67
camera az=22.38 el=10.86 fov=83.48
wait settle
wait 40
bookmark add Beam-lit Snow over Antarctica id=default_beam_snow_antarctica scale=0 paused=1
wait 5

# 5. The rainbow (the user's snapshot, profile_log record 40, 2026-10-04): sunrise behind a storm near
#    Valencia, Venezuela. Needs the storm's drift phase. Paused: the storm moves on within minutes.
time j2000 1164408248.06
drift phase=5.2360808643282795 rate=0.0000065
observer lat=9.9665 lon=-68.2745 alt=865
camera az=-61.25 el=15.5 fov=54
wait settle
wait 30
bookmark add Rainbow over Venezuela id=default_rainbow_venezuela scale=0 paused=1
wait 5
drift default

# 6. Inside the Starmind shells beside an 8-satellite formation ring (follow mode; the bookmark keeps the camera's
#    place, paused so the ring is still there). Since the Clohessy-Wiltshire formations (350 m rings tilted 60 deg,
#    2026-10-06) the camera sits 1.1 km from the ring's centroid along its normal, below it, looking up at the
#    whole ring against the stars (`cluster` gives the centroid: 269, 194, 112 m from member 0 at this time).
time set 2037-03-20T00:00:00Z
observer lat=35 lon=-100 agl=2
select const "SpaceX Starmind - sun-synchronous X-ring" n=0
follow offset=484.8,732.8,-822.2 aimat=269.2,193.8,111.8
camera fov=48
wait settle
wait 20
bookmark add Starmind Formation Rings id=default_starmind_rings scale=0 paused=1
wait 5
follow off
select none

# 7. The Sun's Fury (2026-10-16, branch kessler): the scripted Carrington-class storm's first night, 3.5 h after the
#    CME's arrival (2037-07-15 03:00 UTC; Kp ~11 from ~06:00) over Monument Valley: red aurora to the zenith at
#    37 N while the satellites it kills start to tumble. 1x, so they go on dying while you watch. The cascade's
#    first two days are simulated at launch (`kessler wait`), so the bookmark lands on a computed sky.
time set 2037-07-15T06:30:00Z
observer lat=37.0 lon=-110.1 agl=2
camera az=0 el=32 fov=80
kessler wait days=0.5
time set 2037-07-15T06:30:00Z
wait settle
wait 30
bookmark add The Sun's Fury id=default_suns_fury scale=0 paused=0
wait 5

bookmark list
quit

# 8. A twilight Starship launch (2026-10-18, launches; from Kennedy LC-39A since the Louisiana pads, 2026-10-19 — it
#    was Vandenberg, and any change to launches.json can move it: re-run and check `launch state` shows a rocket):
#    the Sun ~9 degrees down at the pad, the upper stage's exhaust lit high over the dark sea (the "jellyfish").
drift default
launch next twilight=1
time add 330
launch look stage=1
camera fov=75
camera el=24
time add -40
wait settle
wait 30
bookmark add Twilight Starship Launch id=default_launch_twilight scale=0 paused=0
wait 5

