preset High
set display.render_scale 1
set clouds_v2.auto_exposure 0
set clouds_v2.exposure_ev 0
set clouds_v2.light_steps 8
set clouds_v2.coverage 0.84
time pause
follow off
const all on
const "Gen2 shell - legacy (comparison)" off
set clouds_v2.coverage 0
cine new short4_mirrors
time set 2036-11-22T02:06:22Z
observer lat=35.38 lon=-120.05 agl=2
wait 5
# 1. Midnight. Daylight. The solar park under the beams
beams go rank=1 dist_km=1.5 bearing=110 agl=400 look=site
camera fov=70
wait settle 40
cine shot simnow
cine shot look
cine key t=0
camera az=-74 el=6 fov=66
cine key t=4
# 2. Inside the spot: the mirrors overhead
beams go rank=1 dist_km=5 bearing=90 agl=2 look=up
wait settle 40
cine shot add spot
cine shot simnow
cine shot look
camera az=-89 el=6 fov=88
cine key t=0
camera az=-86 el=14 fov=80
cine key t=4
# 3. One mirror, catching the Sun
time set 2036-11-22T02:06:22Z
observer lat=35.869 lon=-121.402 agl=2
select const "Reflect Orbital"
follow
cine shot add mirror
cine shot simnow
cine shot follow sel
follow offset=-60,-120,-40
camera look sel
wait settle 30
cine shot look
cine key t=0
follow offset=-58,-122,-38
camera look sel
cine key t=6
follow off
# 4. The beams fanning into the park, from 25 km
observer lat=35.38 lon=-120.05 agl=2
wait 5
beams go rank=1 dist_km=25 bearing=160 agl=2 look=site
wait settle 40
cine shot add fan
cine shot simnow
cine shot look
camera az=-34 el=11 fov=62
cine key t=0
camera az=-27 el=9 fov=50
cine key t=5
# 5. A beacon from 50 km
beams go rank=1 dist_km=50 bearing=200 agl=3000 look=site
wait settle 40
cine shot add beacon
cine shot simnow
cine shot look
camera az=12 el=6 fov=60
cine key t=0
camera az=18 el=3 fov=48
cine key t=5
# 6. Time-lapse: mirrors hand the beam on as they pass
beams go rank=1 dist_km=25 bearing=160 agl=2 look=site
wait settle 40
cine shot add timelapse
cine shot simnow
cine shot simrate 120
cine shot look
camera az=-30 el=10 fov=58
cine key t=0
camera az=-28 el=10 fov=56
cine key t=6
# 7. End over the park
beams go rank=1 dist_km=1.5 bearing=110 agl=400 look=site
camera fov=70
wait settle 40
cine shot add end
cine shot simnow
cine shot look
cine key t=0
camera az=-72 el=10 fov=70
cine key t=4
cine shot 1
cine save short4_mirrors
cine export preview fps=30
