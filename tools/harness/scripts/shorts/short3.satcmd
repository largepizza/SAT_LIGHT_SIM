preset High
set display.render_scale 1
set clouds_v2.auto_exposure 0
set clouds_v2.exposure_ev 0
set clouds_v2.light_steps 8
set clouds_v2.coverage 0.84
time pause
follow off
const all on
const "Gen2 shell - legacy (comparison)" off
cine new short3_why_they_flash
# 1. Flares, tight
time set 2036-11-22T02:06:22Z
observer lat=35.869 lon=-121.402 agl=2
camera az=-52 el=18 fov=26
wait settle 60
cine shot simnow
cine shot look
cine key t=0
camera az=-45 el=17 fov=20
cine key t=4
# 2. Tilt up from the dark ground to the lit sky
cine shot add dusk
cine shot simnow
cine shot look
camera az=-61 el=8 fov=90
cine key t=0
camera az=-61 el=42 fov=90
cine key t=5
# 3. Still in sunlight: from 300 km, the Sun on the limb
observer lat=35.869 lon=-121.402 alt=300000
camera az=-106 el=20 fov=110
wait settle 30
wait 60
cine shot add sunlit
cine shot simnow
cine shot look
cine key t=0
camera az=-106 el=16 fov=100
cine key t=5
# 4. A Starlink over the night side
observer lat=35.869 lon=-121.402 agl=2
select const "Starlink Gen3 Broadband"
follow
cine shot add starlink
cine shot simnow
cine shot follow sel
follow offset=-25,8,6
camera look sel
wait settle 30
cine shot look
cine key t=0
follow offset=-19,13,9
camera look sel
cine key t=5
follow off
# 5. A flat mirror catching the Sun
observer lat=35.869 lon=-121.402 agl=2
select const "Reflect Orbital"
follow
cine shot add glint
cine shot simnow
cine shot follow sel
follow offset=-60,-120,-40
camera look sel
wait settle 30
cine shot look
cine key t=0
follow offset=-58,-122,-38
camera look sel
cine key t=5
follow off
# 6. Three hours later: Earth's shadow has them
observer lat=35.869 lon=-121.402 agl=2
time set 2036-11-22T05:06:22Z
camera az=-61 el=30 fov=90
wait settle 30
cine shot add shadow
cine shot simnow
cine shot look
cine key t=0
camera az=-58 el=36 fov=90
cine key t=4
# 7. End: back at dusk
time set 2036-11-22T02:06:22Z
camera az=-61 el=25 fov=72
wait settle 30
cine shot add end
cine shot simnow
cine shot look
cine key t=0
camera az=-60 el=27 fov=70
cine key t=4
cine shot 1
cine save short3_why_they_flash
cine export preview fps=30
