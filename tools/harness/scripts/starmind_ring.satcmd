# Starmind formations: 8 satellites on a passive Clohessy-Wiltshire relative orbit about the cluster
# centre (cluster_shape "ring", circular, rho 350 m; 2026-10-06). The full one-orbit sequence is
# starmind_formation.satcmd.
# r10: from 900 m cross-track of member 0: the orbit plane face-on (a 2:1 ellipse).
# r20: the same 120 s later — the formation has turned ~7.5 deg (once per orbit).
# r30: from 1.5 km below the cluster.
preset High
time set 2037-03-20T00:00:00Z
time pause
observer lat=35 lon=-100 agl=2
select const "SpaceX Starmind - sun-synchronous X-ring" n=0
follow offset=200,900,0
camera look sel
camera fov=60
wait settle
capture r10_faceon scale=0.5
state r10
time add 120
follow offset=200,900,0
camera look sel
camera fov=60
wait settle
capture r20_later scale=0.5
follow offset=200,0,-1500
camera look sel
camera fov=40
wait settle
capture r30_below scale=0.5
