# Frame hitches across the time-scale ladder (CLAUDE.md "Frame profile and hitches"): each rate 180 frames from the
# default start, then `hitches` (wall p50 / p99 / max and the hitch frames with their sections). Variants used on
# 2026-10-20: --settings <a copy of the user's settings.json>; `time set 2031-06-15T12:00:00Z` first; `kessler wait
# days=32; time set 2037-08-15T12:00:00Z` first (after the CME).
hitches threshold 50
# right after load
time scale 1x; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1x
time scale 10x; time play; hitches clear; wait 180; hitches top=10 list=12  # load 10x
time scale 1m; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1m
time scale 5m; time play; hitches clear; wait 180; hitches top=10 list=12  # load 5m
time scale 1h; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1h
time scale 1d; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1d
time scale 1w; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1w
time scale 1mo; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1mo
time scale 1yr; time play; hitches clear; wait 180; hitches top=10 list=12  # load 1yr
time scale 1x
perf frames=60
