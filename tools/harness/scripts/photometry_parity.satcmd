# GPU vs CPU photometry parity: the selection's magnitude as sat_orbit.comp drew it vs evalSatPhotometry
set launches.era_benchmark_shells true
observer lat=34.0 lon=-110.0 agl=2
time sun -10 setting
time pause
wait settle
select const "Starlink Gen1"
wait 4
state p0_00
select const "Starlink Gen2"
wait 4
state p0_01
select const "Starlink Gen3 Broadband"
wait 4
state p0_02
select const "Starlink Gen3 Direct-to-Cell"
wait 4
state p0_03
select const "OneWeb"
wait 4
state p0_04
select const "Amazon Leo Shell 1"
wait 4
state p0_05
select const "Guowang-2 Polar"
wait 4
state p0_06
select const "Qianfan (Spacesail)"
wait 4
state p0_07
select const "International Space Station"
wait 4
state p0_08
select const "Tiangong"
wait 4
state p0_09
select const "SpaceX Starmind - sun-synchronous X-ring"
wait 4
state p0_10
select const "Reflect Orbital"
wait 4
state p0_11
select const "Space Junk"
wait 4
state p0_12
select const "Hubble - geometry model"
wait 4
state p0_13
select const "GEO belt"
wait 4
state p0_14
