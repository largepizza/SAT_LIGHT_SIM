# Gamepad navigation (pad layout 2), without a controller: `pad <button>` runs pollGamepad's handling. n1: focus ring + hint on Trace pass; n2: A opened the trace
# window; B closes it, then (after A on Info) closes the info window and deselects; n5: up/X/Y = faster/
# pause/reverse.
preset High
observer lat=35.869 lon=-121.402 agl=50
time sun -6 setting
time pause
wait settle
camera az=-106 el=20 fov=70
select const "Starlink Gen1"
camera look sel
wait 3
pad right
wait 2
pad right
wait 2
ui dump n1_focus
capture n1_focus ui=on scale=0.5
capture n1_crop ui=on crop=700,380,400,200
pad a
wait 3
state n2_trace
capture n2_trace ui=on scale=0.5
pad b
wait 2
pad left
pad left
wait 2
pad a
wait 5
capture n3_info ui=on scale=0.5
pad b
wait 2
pad b
wait 2
state n4_deselected
pad up
pad x
pad y
wait 2
state n5_time
